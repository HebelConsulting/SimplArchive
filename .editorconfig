# EditorConfig — the whitespace contract enforced by the CI `dotnet format whitespace --verify-no-changes`
# gate (ADR "dotnet format whitespace gate"). Deliberately scoped to *formatting* keys only: analyzer/code-style
# rules are already enforced at build time by `TreatWarningsAsErrors` (ADR 0402), which stays their single owner —
# so no `dotnet_diagnostic.*`/`dotnet_style_*`/`csharp_style_*` severities live here (adding one could turn a
# style preference into a build-breaking error under warnings-as-errors, or fight the existing conventions).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Markdown: trailing spaces are a hard line break, so don't strip them.
[*.md]
trim_trailing_whitespace = false

# Data/markup files that conventionally use 2-space indentation.
[*.{json,yml,yaml,csproj,props,targets,slnx}]
indent_size = 2

# EF Core migrations are generated by `dotnet-ef` (with a UTF-8 BOM + its own layout). Mark them generated so
# `dotnet format` skips them — otherwise every `migrations add` would re-break the gate. The coverage report
# (ADR 0438) already excludes this namespace for the same reason.
[**/Migrations/*.cs]
generated_code = true
