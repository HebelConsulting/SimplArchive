<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Desktop UI end-to-end tests: exercise the real DesktopClient SimplArchiveApiClient against the self-hosted
       API over HTTP. No browser (Playwright) — split out from the web UI tests so the two run as parallel CI jobs
       and the desktop suite doesn't launch Chrome. -->
  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Npgsql" Version="9.0.4" />
    <!-- Compute a TOTP in the desktop MFA api-client test (ADR "MFA (interactive login, TOTP)"). -->
    <PackageReference Include="Otp.NET" Version="1.4.0" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.0.0" />
    <PackageReference Include="AWSSDK.S3" Version="4.0.100.3" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- The real API is built (not linked) so the fixture can launch it as a subprocess. The DesktopClient is
       linked so the tests drive its real SimplArchiveApiClient/NativeFileOpener/WithExtension. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\SimplArchive.Api\SimplArchive.Api.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="..\..\src\SimplArchive.DesktopClient\SimplArchive.DesktopClient.csproj" />
  </ItemGroup>

</Project>
