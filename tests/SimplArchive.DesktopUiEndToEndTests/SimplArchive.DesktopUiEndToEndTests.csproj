<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Desktop UI end-to-end tests: exercise the real DesktopClient SimplArchiveApiClient against the self-hosted
       API over HTTP. No browser (Playwright) — split out from the web UI tests so the two run as parallel CI jobs
       and the desktop suite doesn't launch Chrome. -->
  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Npgsql" Version="9.0.4" />
    <!-- Compute a TOTP in the desktop MFA api-client test (ADR "MFA (interactive login, TOTP)"). -->
    <PackageReference Include="Otp.NET" Version="1.4.0" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.0.0" />
    <!-- Security-driven transitive pin (ADR 0379 "Security and dependency scanning"): Testcontainers pulls
         SSH.NET, and every version up to and including 2025.1.0 carries GHSA-q939-rpr3-3284 (High — ScpClient
         recursive download allows arbitrary file write via server-controlled filenames), fixed in 2026.0.0.
         Bumping Testcontainers does NOT help: even 4.13.0 asks only for [2025.1.0, ). Re-check on the next
         Testcontainers bump; remove once its own floor moves past 2026.0.0. -->
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <PackageReference Include="AWSSDK.S3" Version="4.0.100.3" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- The real API is built (not linked) so the fixture can launch it as a subprocess. The DesktopClient is
       linked so the tests drive its real SimplArchiveApiClient/NativeFileOpener/WithExtension. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\SimplArchive.Api\SimplArchive.Api.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="..\..\src\SimplArchive.DesktopClient\SimplArchive.DesktopClient.csproj" />
    <!-- The TEST project reads WellKnownMaskIds to check the icon vocabulary against the client's glyph map.
         The desktop CLIENT still does not reference Domain and must not (ADR 0236: it is an Api client, not a
         second copy of the model) — a test asserting the two agree is exactly the thing that needs both. -->
    <ProjectReference Include="..\..\src\SimplArchive.Domain\SimplArchive.Domain.csproj" />
    <!-- The shared self-host boot engine (ADR 0502) — one source of truth for standing up the real app. -->
    <ProjectReference Include="..\SimplArchive.SelfHosting\SimplArchive.SelfHosting.csproj" />
  </ItemGroup>

</Project>
