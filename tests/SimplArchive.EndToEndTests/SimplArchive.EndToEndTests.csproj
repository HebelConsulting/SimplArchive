<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The native libvips for the platforms TESTS run on, version-matched to the NetVips managed package.
         NOT a product dependency: the Api image is Alpine and carries the linux-musl natives, and these are
         referenced only by test projects, so nothing ships with them.

         This replaces installing libvips from the distro, which was wrong in a way local runs could never
         show: `apt-get install libvips42t64` on Ubuntu 24.04 gives 8.15.1, while NetVips 3.2.0 is paired with
         8.18.4 — so the test host CRASHED on CI (a native fault, not a test failure) while passing locally on
         Homebrew's 8.18. Pinning the native to the managed package is the only version-matched answer, and it
         removes the `brew install vips` prerequisite and the DYLD path fix-up with it. -->
    <PackageReference Include="NetVips.Native.linux-x64" Version="8.18.4" />
    <PackageReference Include="NetVips.Native.linux-arm64" Version="8.18.4" />
    <PackageReference Include="NetVips.Native.osx-arm64" Version="8.18.4" />
    <PackageReference Include="NetVips.Native.osx-x64" Version="8.18.4" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.9" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.9" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.0.0" />
    <!-- Security-driven transitive pin (ADR 0379 "Security and dependency scanning"): Testcontainers pulls
         SSH.NET, and every version up to and including 2025.1.0 carries GHSA-q939-rpr3-3284 (High — ScpClient
         recursive download allows arbitrary file write via server-controlled filenames), fixed in 2026.0.0.
         Bumping Testcontainers does NOT help: even 4.13.0 asks only for [2025.1.0, ). Re-check on the next
         Testcontainers bump; remove once its own floor moves past 2026.0.0. -->
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <PackageReference Include="AWSSDK.S3" Version="4.0.100.3" />
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SimplArchive.SelfHosting\SimplArchive.SelfHosting.csproj" />
    <!-- The module fixture (ADR 0737): staged into a Modules/ dir by E2EApiFactory so the real loader
         serves its controller; referencing it also lands the dll in this test bin to stage FROM. -->
    <ProjectReference Include="..\SimplArchive.TestModule\SimplArchive.TestModule.csproj" />
    <ProjectReference Include="..\..\src\SimplArchive.Api\SimplArchive.Api.csproj" />
    <ProjectReference Include="..\..\src\SimplArchive.Infrastructure\SimplArchive.Infrastructure.csproj" />
  </ItemGroup>

</Project>
