<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- The single source of truth for booting the real app out-of-process for E2E/manual-capture use (ADR 0502).
       Browser-agnostic: no Playwright reference, so the desktop suite that wraps this stays light. -->
  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" Version="4.0.100.3" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.0.0" />
    <!-- Security-driven transitive pin (ADR 0379 "Security and dependency scanning"): Testcontainers pulls
         SSH.NET, and every version up to and including 2025.1.0 carries GHSA-q939-rpr3-3284 (High — ScpClient
         recursive download allows arbitrary file write via server-controlled filenames), fixed in 2026.0.0.
         Bumping Testcontainers does NOT help: even 4.13.0 asks only for [2025.1.0, ). Re-check on the next
         Testcontainers bump; remove once its own floor moves past 2026.0.0. -->
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>

</Project>
