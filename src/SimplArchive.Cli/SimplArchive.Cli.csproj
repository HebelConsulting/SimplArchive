<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <AssemblyName>saconsole</AssemblyName>
        <RootNamespace>SimplArchive.Cli</RootNamespace>
        <!-- Administering an installation from a terminal (ADR 0822). Shipped as a .NET tool like caconsole,
             so an administrator installs it rather than building this repository. It talks to the Api over
             HTTP and references no project here on purpose: it is a CLIENT of the deployed application, not
             a part of it, and a project reference would quietly make it one. -->
        <IsPackable>true</IsPackable>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>saconsole</ToolCommandName>
        <PackageId>HebelConsulting.SimplArchive.Cli</PackageId>
        <!-- The description is what a reader sees on the package feed before they install anything, so it lists
             what the tool DOES rather than what it is meant to grow into. It claimed service accounts and user
             certificates while having neither; certificates arrived with #1353 and service accounts have not,
             so they come out until they do. A package description is a promise made to strangers. -->
        <Description>saconsole — administrative CLI for a SimplArchive installation: sign in, provision tenants, and register the certificate your content is enveloped to, over the HTTP API.</Description>
        <!-- Where a reader of the package page goes next. The PUBLIC repository, because that is the one a stranger
             can open — and the one this package is packed from (saconsole-publish.yml runs only there), so the
             commit SourceLink records is a public commit too. Without these the page linked nowhere, and without
             the licence expression it said "license not specified" for an Apache-2.0 project. -->
        <PackageProjectUrl>https://github.com/HebelConsulting/SimplArchive</PackageProjectUrl>
        <RepositoryUrl>https://github.com/HebelConsulting/SimplArchive.git</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <!-- The package page's README: what SimplArchive IS, before what this tool does. The one-line description
             above assumed the reader already knew. -->
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="/" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Spectre.Console.Cli" Version="0.55.0" />
        <!-- Output through a logger to stderr (ADR 0906, #1661); commands get their logger by constructor. -->
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
        <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.9" />
    </ItemGroup>

    <ItemGroup>
        <!-- The message-shaping helpers are internal: they are how the tool TALKS, not API for anyone to call.
             The unit tests assert on them because a refusal message is the part of a CLI people actually read. -->
        <InternalsVisibleTo Include="SimplArchive.UnitTests" />
    </ItemGroup>

</Project>
