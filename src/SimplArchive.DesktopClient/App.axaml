<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="using:Projektanker.Icons.Avalonia"
             x:Class="SimplArchive.DesktopClient.App"
             RequestedThemeVariant="Default">
    <Application.Resources>
        <!-- Theme-adaptive workbench colours (light/dark), shared by MainWindow and the dialogs. The VALUES
             now come from the design tokens (ADR 0578) rather than being written here; what stays here is why
             they exist. WbChrome: sunken surfaces; WbBorder: pane separators; WbMuted/WbFaint:
             secondary/hint text; WbAccent and friends: the accent, in the only roles it may hold. See also
             ADR "Desktop dark-mode colour pass".

             WbFolder/WbFolderEmpty are the tree's folder glyphs (ADR "Folder icon scheme"). Gold means "a place
             documents live" — folders, the personal root, a referenced folder — so the launchers and the
             synthetic admin nodes deliberately take WbMuted instead: colouring everything gold made it
             decorative. An EMPTY folder is the SAME gold at reduced alpha, not a second colour: the earlier pale
             yellow was a fixed mid-tone, which recedes on light but on dark is LIGHTER than the gold, making
             empty folders the most eye-catching thing in the tree — the opposite of what "nothing here" should
             do. Alpha composites toward whatever is behind it, so one value (0x8c ≈ 55%) recedes in BOTH themes
             and needs no per-theme tuning; the web client states the same rule as a color-mix toward its surface
             variable. The glyph also changes to the outline variant, so the distinction survives without colour
             vision. -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- GENERATED from src/SimplArchive.Theming/tokens.json (ADR 0578). Every brush the workbench
                     uses is in there, for both themes; run scripts/generate-theme.sh after changing a token. -->
                <ResourceInclude Source="avares://SimplArchive.DesktopClient/Themes/Tokens.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme />
        <!-- The redesign's SHAPE — ghost ribbon buttons, tinted selection with an accent edge
             (ADR 0578). After FluentTheme, so it overrides rather than is overridden. -->
        <StyleInclude Source="avares://SimplArchive.DesktopClient/Themes/Workbench.axaml" />
        <!-- The app icon on EVERY window's title bar and taskbar entry (#421). Set once here rather than on 44
             windows: only MainWindow carried Icon=, so the logon window — the first thing a user sees — and
             every dialog showed the platform default.

             `:is(Window)` says "this type or anything derived from it", which is what is meant, since every
             window here is a subclass. A bare `Window` selector was measured to work too (Avalonia 11.3), so
             this is about saying it unambiguously rather than repairing a bug. Verified by the icon-test hook, which
             asserts a window that never sets Icon= itself ends up with one — the title bar is not in a headless
             screenshot, so nothing else would notice this silently reverting to the platform default. -->
        <Style Selector=":is(Window)">
            <Setter Property="Icon" Value="/Assets/cabinet.png" />
        </Style>
        <!-- The folder-glyph colours, application-wide so every pane that draws a folder uses the SAME rules
             (ADR 0547): the tree, the contents list and the detail-pane header. Defined once here rather than
             inside one view's styles, because "a folder looks like a folder wherever it appears" is precisely
             what a per-view definition cannot guarantee.

             DynamicResource, not a brush a view model resolved: the colour has to come from the ACTIVE theme
             dictionary, or it keeps the startup theme after the OS switches. Avalonia cannot bind a resource
             KEY, hence one class per brush. -->
        <Style Selector="i|Icon.wbFolder">
            <Setter Property="Foreground" Value="{DynamicResource WbFolder}" />
        </Style>
        <Style Selector="i|Icon.wbFolderEmpty">
            <Setter Property="Foreground" Value="{DynamicResource WbFolderEmpty}" />
        </Style>
        <Style Selector="i|Icon.wbMutedGlyph">
            <Setter Property="Foreground" Value="{DynamicResource WbMuted}" />
        </Style>
    </Application.Styles>
</Application>
