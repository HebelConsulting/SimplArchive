<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:SimplArchive.DesktopClient.Localization"
        xmlns:vm="clr-namespace:SimplArchive.DesktopClient.ViewModels"
        x:Class="SimplArchive.DesktopClient.Views.ShareSavedSearchDialog"
        x:DataType="vm:ShareSavedSearchViewModel"
        Title="{loc:Tr SssTitle}" Width="420" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="18" Spacing="10">
        <TextBlock Text="{Binding Name, StringFormat='Share \'{0}\' with:'}" TextWrapping="Wrap" FontWeight="SemiBold" />

        <StackPanel Spacing="4">
            <RadioButton x:Name="PrivateRadio" GroupName="scope" Content="{loc:Tr SssPrivate}" Checked="OnScopeChecked" Tag="0" />
            <RadioButton x:Name="SpecificRadio" GroupName="scope" Content="{loc:Tr SssSpecific}" Checked="OnScopeChecked" Tag="2" />
            <RadioButton x:Name="EveryoneRadio" GroupName="scope" Content="{loc:Tr SssEveryone}" Checked="OnScopeChecked" Tag="1" />
        </StackPanel>

        <Border IsVisible="{Binding ShowPrincipals}" BorderBrush="{DynamicResource WbBorder}" BorderThickness="1" CornerRadius="4" Padding="8" MaxHeight="240">
            <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Principals}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ShareSavedSearchViewModel+PrincipalOption">
                            <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="{loc:Tr Cancel}" Click="OnCancel" IsCancel="True" />
            <Button Content="{loc:Tr Save}" Click="OnConfirm" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
