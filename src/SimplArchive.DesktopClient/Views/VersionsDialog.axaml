<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:SimplArchive.DesktopClient.Localization"
        xmlns:vm="using:SimplArchive.DesktopClient.ViewModels"
        xmlns:i="using:Projektanker.Icons.Avalonia"
        x:Class="SimplArchive.DesktopClient.Views.VersionsDialog"
        x:DataType="vm:VersionsViewModel"
        Title="{loc:Tr VersionsTitle}" Width="680" Height="440"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16" LastChildFill="True">
        <TextBlock DockPanel.Dock="Top" Text="{Binding DocumentName}" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10" />

        <!-- Footer: Compare launcher + Make current (on the selected row, confirmed) + status + Close. -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Click="OnCompare" IsEnabled="{Binding HasMultiple}">
                <StackPanel Orientation="Horizontal" Spacing="5"><i:Icon Value="mdi-compare" /><TextBlock Text="{loc:Tr CompareEllipsis}" /></StackPanel>
            </Button>
            <Button Click="OnMakeCurrent" IsEnabled="{Binding CanMakeCurrentSelected}" Margin="8,0,0,0" Classes="makecurrent">
                <StackPanel Orientation="Horizontal" Spacing="5"><i:Icon Value="mdi-history" /><TextBlock Text="{loc:Tr MakeCurrent}" /></StackPanel>
            </Button>
            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource WbMuted}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />
            <Button Content="{loc:Tr Close}" Click="OnClose" HorizontalAlignment="Right" Margin="0" DockPanel.Dock="Right" />
        </StackPanel>

        <!-- Header row -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="90,120,150,*,2*,110" Margin="4,0,4,4">
            <TextBlock Grid.Column="0" Text="{loc:Tr VerColVersion}" FontWeight="SemiBold" FontSize="11" />
            <TextBlock Grid.Column="1" Text="{loc:Tr VerColDocDate}" FontWeight="SemiBold" FontSize="11" />
            <TextBlock Grid.Column="2" Text="{loc:Tr VerColFiled}" FontWeight="SemiBold" FontSize="11" />
            <TextBlock Grid.Column="3" Text="{loc:Tr VerColBy}" FontWeight="SemiBold" FontSize="11" />
            <TextBlock Grid.Column="4" Text="{loc:Tr VerColComment}" FontWeight="SemiBold" FontSize="11" />
            <TextBlock Grid.Column="5" Text="{loc:Tr RetColActions}" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right" />
        </Grid>

        <!-- Single-select list: pick a version, then act on it via the footer (ADR "Deliberate make-current in
             the Versions dialog"). -->
        <ListBox ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}" x:Name="VersionsList"
                 SelectionMode="Single" BorderBrush="{DynamicResource WbBorder}" BorderThickness="1" CornerRadius="4">
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:VersionRowViewModel">
                    <!-- Must match the header grid's columns exactly (including the comment's wider 2* share),
                         or the headers stop lining up with the values under them. -->
                    <Grid ColumnDefinitions="90,120,150,*,2*,110" Margin="4,3">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                            <Border IsVisible="{Binding IsCurrent}" Background="#5b4ee5" CornerRadius="3" Padding="4,0" VerticalAlignment="Center">
                                <TextBlock Text="{loc:Tr VerCurrent}" Foreground="White" FontSize="9" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding DocumentDate}" VerticalAlignment="Center" Foreground="{DynamicResource WbMuted}" FontSize="12" />
                        <TextBlock Grid.Column="2" Text="{Binding Filed}" VerticalAlignment="Center" Foreground="{DynamicResource WbMuted}" FontSize="12" />
                        <TextBlock Grid.Column="3" Text="{Binding By}" VerticalAlignment="Center" Foreground="{DynamicResource WbMuted}" FontSize="12" TextTrimming="CharacterEllipsis" />
                        <!-- The comment WRAPS rather than being clipped to one line (#474): it is the only column
                             that answers *why*, and it was the only one truncated, with a hover tooltip as the
                             sole way to read the rest. Two lines before it clamps, so one long comment cannot
                             stretch every row. -->
                        <TextBlock Grid.Column="4" Text="{Binding Comment}" ToolTip.Tip="{Binding Comment}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource WbMuted}" FontSize="12" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                        <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                            <Button Click="OnOpen" ToolTip.Tip="{loc:Tr MwOpen}" Padding="6,2"><i:Icon Value="mdi-open-in-app" /></Button>
                            <Button Click="OnSaveAs" ToolTip.Tip="{loc:Tr RibbonSaveAs}" Padding="6,2"><i:Icon Value="mdi-content-save-outline" /></Button>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
