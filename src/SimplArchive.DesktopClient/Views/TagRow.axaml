<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SimplArchive.DesktopClient.ViewModels"
             xmlns:i="using:Projektanker.Icons.Avalonia"
             xmlns:loc="using:SimplArchive.DesktopClient.Localization"
             x:Class="SimplArchive.DesktopClient.Views.TagRow"
             x:DataType="vm:TagCatalogRow">
    <!-- One catalog tag (#530, tranche 6): what it IS — swatch, name, colour — read-only by decision; the
         always-editable per-row TextBoxes are gone. The context menu carries what can be done to it,
         addressed from THIS row via its Tag (ADR 0559); retire keeps its distance below a separator. -->
    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2" Background="Transparent">
        <Border Width="14" Height="14" CornerRadius="3" VerticalAlignment="Center"
                Background="{Binding SwatchBrush}" BorderBrush="{DynamicResource WbBorder}" BorderThickness="1" />
        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding Color}" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource WbMuted}" />
        <StackPanel.ContextMenu>
            <ContextMenu>
                <MenuItem Header="{loc:Tr RibbonRename}" Click="OnRename">
                    <MenuItem.Icon><i:Icon Value="mdi-form-textbox" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{loc:Tr TagsSetColour}" Click="OnRecolour">
                    <MenuItem.Icon><i:Icon Value="mdi-palette-outline" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{loc:Tr TagsMergeInto}" Click="OnMerge">
                    <MenuItem.Icon><i:Icon Value="mdi-merge" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="{loc:Tr TagsRetire}" Click="OnRetire">
                    <MenuItem.Icon><i:Icon Value="mdi-tag-off-outline" /></MenuItem.Icon>
                </MenuItem>
            </ContextMenu>
        </StackPanel.ContextMenu>
    </StackPanel>
</UserControl>
