<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:SimplArchive.DesktopClient.Localization"
        x:Class="SimplArchive.DesktopClient.Views.GeneratedPasswordDialog"
        Title="{loc:Tr GenPwTitle}" Width="420" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="18" Spacing="10">
        <TextBlock x:Name="Intro" TextWrapping="Wrap"
                   Text="{loc:Tr GenPwHint}" />
        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox x:Name="PasswordBox" IsReadOnly="True" Width="300" FontFamily="Menlo,Consolas,monospace" />
            <Button Content="{loc:Tr Copy}" Click="OnCopy" />
        </StackPanel>
        <Button Content="{loc:Tr Done}" Click="OnDone" IsDefault="True" HorizontalAlignment="Right" />
    </StackPanel>
</Window>
