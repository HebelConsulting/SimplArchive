<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:SimplArchive.DesktopClient.Localization"
        x:Class="SimplArchive.DesktopClient.Views.NewFolderDialog"
        Title="{loc:Tr NewFolder}" Width="380" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="18" Spacing="12">
        <TextBlock x:Name="LabelText" Text="{loc:Tr NewFolderName}" />
        <TextBox x:Name="NameBox" Watermark="{loc:Tr Name}" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="{loc:Tr Cancel}" Click="OnCancel" IsCancel="True" />
            <Button Content="{loc:Tr Create}" Click="OnCreate" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
