<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SimplArchive.DesktopClient.ViewModels"
        xmlns:v="using:SimplArchive.DesktopClient.Views"
        xmlns:conv="using:Avalonia.Data.Converters"
        xmlns:svc="using:SimplArchive.DesktopClient.Services"
        xmlns:i="using:Projektanker.Icons.Avalonia"
        xmlns:loc="using:SimplArchive.DesktopClient.Localization"
        x:Class="SimplArchive.DesktopClient.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1180" Height="760"
        Icon="/Assets/cabinet.png"
        Title="SimplArchive">

    <Window.KeyBindings>
        <!-- Esc exits the preview full-screen (no-op otherwise). See ADR "Desktop preview full-screen toggle". -->
        <KeyBinding Gesture="Escape" Command="{Binding ExitPreviewFullscreenCommand}" />
        <!-- Esc cancels an edit, Ctrl/Cmd+S saves it (ADR 0550) — no visual cost, and they serve the person deep
             in a long field list. Both commands no-op unless the pane is editing, so they do not shadow anything.
             Esc is bound twice on purpose: the two commands are mutually exclusive in practice (you cannot be in
             a full-screen preview and editing the pane), and each ignores the state it does not own. -->
        <KeyBinding Gesture="Escape" Command="{Binding CancelEditCommand}" />
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveDetailCommand}" />
        <KeyBinding Gesture="Cmd+S" Command="{Binding SaveDetailCommand}" />
    </Window.KeyBindings>

    <DockPanel LastChildFill="True">

        <!-- The app chrome is its own control (ADR 0578): brand, notifications, theme and the account menu
             are a responsibility, not a region, and this file has no room left for another one. -->
        <v:TitleBar DockPanel.Dock="Top" />
        <v:EnvironmentBanner DockPanel.Dock="Top" />

        <!-- Impersonation banner (ADR "User impersonation") -->
        <Border DockPanel.Dock="Top" Background="#b26a00" Padding="12,5" IsVisible="{Binding IsImpersonating}">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <i:Icon Value="mdi-account-supervisor" Foreground="White" />
                <TextBlock Foreground="White" VerticalAlignment="Center">
                    <Run Text="{loc:Tr MwImpersonating}" />
                    <Run Text="{Binding ImpersonatedName}" FontWeight="Bold" />
                </TextBlock>
                <Button Content="{loc:Tr StopImpersonating}" Command="{Binding StopImpersonatingCommand}" Margin="8,0,0,0" />
            </StackPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource WbChrome}" Padding="12,6" BorderBrush="{DynamicResource WbBorder}" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource WbMuted}" />
        </Border>

        <!-- Logged-out prompt -->
        <TextBlock Text="{loc:Tr MwLoginToBrowse}" Foreground="{DynamicResource WbFaint}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !IsLoggedIn}" />

        <!-- Bottom tabs -->
        <TabControl AutomationProperties.AutomationId="tour:tab-bar" TabStripPlacement="Bottom" IsVisible="{Binding IsLoggedIn}" SelectedIndex="{Binding SelectedTab}">

            <TabItem ToolTip.Tip="{loc:Tr TabRepositories}">
                <TabItem.Header><i:Icon Value="mdi-folder-multiple" FontSize="20" /></TabItem.Header>
                <!-- The preview full-screen overlay (at the end of this Grid) covers the ribbon + panes but not
                     the bottom tab strip, which stays reachable — mirrors the web (ADR "Desktop preview
                     full-screen toggle"). -->
                <Grid>
                <DockPanel LastChildFill="True">

                    <!-- Ribbon — buttons grouped by concern (tree / documents / general) with vertical separators
                         between the groups (ADR "Desktop Repositories-tab UI polish"). "Convert scans" moved to
                         the Tenant tab. The vertical separators are thin theme-coloured Borders. -->
                    <Border Classes="ribbon" DockPanel.Dock="Top" Padding="8,6" BorderBrush="{DynamicResource WbBorder}" BorderThickness="0,0,0,1">
                        <!-- WrapPanel so whole button-groups reflow onto a new row when the ribbon is too narrow to
                             fit them all, instead of clipping — matching the preview-pane toolbar (both clients). Each
                             concern-group is a cluster (a horizontal StackPanel) with a right/bottom margin; the margin
                             replaces the old vertical separators and delineates the groups. -->
                        <WrapPanel Orientation="Horizontal">
                            <!-- Tree group: folder/structure + repository export/import (act on the selected folder/repository subtree). -->
                            <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,12,4">
                                <Button AutomationProperties.AutomationId="tour:action-new-folder" IsEnabled="{Binding CanCreateFolder}" Click="OnNewFolder" ToolTip.Tip="{loc:Tr NewFolder}"><i:Icon Value="mdi-folder-plus" FontSize="18" /></Button>
                                <!-- Requires CanExport (ADR "Dedicated CanExport/CanImport rights"); enabled once a folder is open. -->
                                <Button IsVisible="{Binding HasExportRight}" IsEnabled="{Binding CanExport}" Click="OnExport" ToolTip.Tip="{loc:Tr RibbonExport}"><i:Icon Value="mdi-archive-arrow-down-outline" FontSize="18" /></Button>
                                <!-- Requires CanImport (ADR "Dedicated CanExport/CanImport rights"): import an archive under the current folder, or as a new repository. -->
                                <Button IsVisible="{Binding HasImportRight}" Click="OnImport" ToolTip.Tip="{loc:Tr RibbonImport}"><i:Icon Value="mdi-archive-arrow-up-outline" FontSize="18" /></Button>
                            </StackPanel>

                            <!-- Documents group: operations on the selected document/item (order: Open · Save · Rename · Delete · Upload · Check-out · Workflow). -->
                            <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,12,4">
                                <Button Command="{Binding OpenCommand}" ToolTip.Tip="{x:Static vm:MainWindowViewModel.RibbonOpenTip}"><i:Icon Value="mdi-open-in-app" FontSize="18" /></Button>
                                <Button IsEnabled="{Binding CanSaveAs}" Click="OnSaveAs" ToolTip.Tip="{loc:Tr RibbonSaveAs}"><i:Icon Value="mdi-content-save-outline" FontSize="18" /></Button>
                                <Button IsEnabled="{Binding HasSelectedItem}" Click="OnRename" ToolTip.Tip="{loc:Tr RibbonRename}"><i:Icon Value="mdi-rename-box" FontSize="18" /></Button>
                                <Button IsEnabled="{Binding HasSelectedItem}" Click="OnDelete" ToolTip.Tip="{loc:Tr RibbonDelete}"><i:Icon Value="mdi-delete" FontSize="18" /></Button>
                                <Button IsEnabled="False" ToolTip.Tip="{loc:Tr RibbonUpload}"><i:Icon Value="mdi-upload" FontSize="18" /></Button>
                                <Button IsEnabled="{Binding CanCheckOut}" Command="{Binding CheckOutSelectedCommand}" ToolTip.Tip="{loc:Tr RibbonCheckOut}"><i:Icon Value="mdi-lock-outline" FontSize="18" /></Button>
                                <Button IsEnabled="{Binding CanSaveAs}" Click="OnVersions" ToolTip.Tip="{loc:Tr RibbonVersions}"><i:Icon Value="mdi-history" FontSize="18" /></Button>
                                <Button IsEnabled="{Binding CanStartWorkflow}" Click="OnStartWorkflow" ToolTip.Tip="{Binding WorkflowButtonLabel}"><i:Icon Value="mdi-sitemap-outline" FontSize="18" /></Button>
                            </StackPanel>

                            <!-- General group: view actions. -->
                            <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,12,4">
                                <Button Command="{Binding RefreshCommand}" ToolTip.Tip="{loc:Tr RibbonRefresh}"><i:Icon Value="mdi-refresh" FontSize="18" /></Button>
                                <Button Command="{Binding ResetLayoutCommand}" ToolTip.Tip="{loc:Tr RibbonResetLayout}"><i:Icon Value="mdi-view-grid-outline" FontSize="18" /></Button>
                                <!-- WebDAV (#461): ONE button that does the next useful thing — set up credentials,
                                     mount, or open what is already mounted. The tooltip says which, because an icon
                                     that changes meaning silently is worse than three buttons. -->
                                <Button Click="OnWebDavRibbon" AutomationProperties.AutomationId="ribbon-webdav"
                                        ToolTip.Tip="{Binding WebDav.Tooltip}"><i:Icon Value="mdi-folder-network-outline" FontSize="18" /></Button>
                                <!-- "My external links" — everything the caller has shared, across documents (ADR 0546).
                                     A cross-document review surface, so it belongs to the general group rather than to the
                                     selected document. Hidden until the API root advertises the rel. -->
                                <Button Command="{Binding ShowMyExternalLinksCommand}" IsVisible="{Binding HasMyExternalLinks}"
                                        ToolTip.Tip="{loc:Tr ExtLinkMyLinks}"><i:Icon Value="mdi-link-box-variant-outline" FontSize="18" /></Button>
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding Breadcrumbs}" VerticalAlignment="Center" Margin="0,0,0,4">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:BreadcrumbViewModel">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="/" Foreground="{DynamicResource WbFaint}" Margin="4,0" VerticalAlignment="Center" IsVisible="{Binding ShowSeparator}" />
                                            <Button Content="{Binding Name}" CommandParameter="{Binding}"
                                                    Command="{ReflectionBinding $parent[ItemsControl].DataContext.NavigateToBreadcrumbCommand}"
                                                    Background="Transparent" BorderThickness="0" Padding="3,1" Foreground="{DynamicResource WbAccentText}" Cursor="Hand" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </WrapPanel>
                    </Border>

                    <!-- tree | contents | detail (resizable via gutters, each side pane collapsible) -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding TreeWidth, Mode=TwoWay}" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="{Binding ListWidth, Mode=TwoWay}" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="4.2*" />
                        </Grid.ColumnDefinitions>

                        <!-- Tree (folders only, lazy) -->
                        <TreeView Grid.Column="0" x:Name="FolderTree" AutomationProperties.AutomationId="tour:pane-tree" DragDrop.AllowDrop="True" IsVisible="{Binding !TreeCollapsed}" ItemsSource="{Binding Tree}" SelectedItem="{Binding SelectedTreeNode}"
                                  ContextRequested="OnTreeContextRequested">
                            <!-- Folder actions on the right-clicked tree node (ADR "Desktop tree-pane folder context menu"). -->
                            <TreeView.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{loc:Tr MwNewSubfolder}" Click="OnTreeNewFolder">
                                        <MenuItem.Icon><i:Icon Value="mdi-folder-plus-outline" /></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{loc:Tr Upload}" Click="OnTreeUpload">
                                        <MenuItem.Icon><i:Icon Value="mdi-upload-outline" /></MenuItem.Icon>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="{loc:Tr CtxRename}" Click="OnTreeRename">
                                        <MenuItem.Icon><i:Icon Value="mdi-rename-box" /></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{loc:Tr CtxMoveTo}" Click="OnTreeMove">
                                        <MenuItem.Icon><i:Icon Value="mdi-file-move-outline" /></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{loc:Tr FolderSortLabel}" Click="OnTreeFolderSort">
                                        <MenuItem.Icon><i:Icon Value="mdi-sort" /></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{loc:Tr UgDelete}" Click="OnTreeDelete">
                                        <MenuItem.Icon><i:Icon Value="mdi-delete" /></MenuItem.Icon>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="{loc:Tr MaManageAccess}" Click="OnTreeManageAccess">
                                        <MenuItem.Icon><i:Icon Value="mdi-shield-account-outline" /></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{loc:Tr CtxPlaceLegalHold}" Click="OnTreePlaceLegalHold" IsVisible="{Binding CanLegalHold}">
                                        <MenuItem.Icon><i:Icon Value="mdi-gavel" /></MenuItem.Icon>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="{loc:Tr CtxPlaceReference}" Click="OnTreePlaceReference">
                                        <MenuItem.Icon><i:Icon Value="mdi-link-variant" /></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{loc:Tr MwReferences}" Click="OnTreeReferences" IsVisible="{Binding TreeContextHasReferences}">
                                        <MenuItem.Icon><i:Icon Value="mdi-share-variant-outline" /></MenuItem.Icon>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="{loc:Tr MwFollowFolder}" Click="OnTreeToggleFollow">
                                        <MenuItem.Icon><i:Icon Value="mdi-bell-outline" /></MenuItem.Icon>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="{loc:Tr HomeExport}" Click="OnExport" IsVisible="{Binding CanExport}">
                                        <MenuItem.Icon><i:Icon Value="mdi-archive-arrow-down-outline" /></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{loc:Tr RibbonRefresh}" Click="OnTreeRefresh">
                                        <MenuItem.Icon><i:Icon Value="mdi-refresh" /></MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </TreeView.ContextMenu>
                            <TreeView.Styles>
                                <Style Selector="TreeViewItem">
                                    <Setter Property="IsExpanded" Value="{ReflectionBinding IsExpanded, Mode=TwoWay}" />
                                </Style>
                                <!-- The folder-glyph classes are APPLICATION-wide (App.axaml), not defined here:
                                     the tree, the contents list and the detail pane draw the same object and must
                                     use the same rules (ADR 0547). -->
                            </TreeView.Styles>
                            <TreeView.DataTemplates>
                                <TreeDataTemplate DataType="vm:TreeNodeViewModel" ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <i:Icon Value="{Binding IconValue}"
                                                Classes.wbFolder="{Binding UsesFolderBrush}"
                                                Classes.wbFolderEmpty="{Binding UsesEmptyFolderBrush}"
                                                Classes.wbMutedGlyph="{Binding UsesMutedBrush}" />
                                        <TextBlock Text="{Binding Name}" />
                                    </StackPanel>
                                </TreeDataTemplate>
                            </TreeView.DataTemplates>
                        </TreeView>

                        <!-- gutter: resize + collapse the tree. The GridSplitter must be a DIRECT child of the
                             resizable Grid (nesting it caused an NRE in Grid.ArrangeOverride); the caret Button
                             is a second child overlaid in the same cell. -->
                        <GridSplitter Grid.Column="1" Background="{DynamicResource WbBorder}" ResizeDirection="Columns" IsEnabled="{Binding !TreeCollapsed}" />
                        <Button Grid.Column="1" Command="{Binding ToggleTreeCommand}" Width="10" Height="24" Padding="0" MinWidth="0" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip.Tip="{loc:Tr MwCollapseExpand}">
                            <i:Icon Value="{Binding TreeCaret}" FontSize="11" />
                        </Button>

                        <!-- Contents list (drop OS files here to upload into the current folder) -->
                        <DockPanel Grid.Column="2" IsVisible="{Binding !ListCollapsed}">
                        <!-- Bulk-action bar (ADR "Bulk actions on selected documents") — shows when ≥2 rows are selected. -->
                        <Border DockPanel.Dock="Top" IsVisible="{Binding HasBulkSelection}" Background="{DynamicResource WbChrome}"
                                BorderBrush="{DynamicResource WbBorder}" BorderThickness="0,0,0,1" Padding="6,3">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="{Binding BulkSelectionCount, StringFormat='{}{0} selected'}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="2,0,6,0" />
                                <Button Click="OnBulkMove" Padding="6,2" ToolTip.Tip="{loc:Tr MwMoveSelected}"><StackPanel Orientation="Horizontal" Spacing="3"><i:Icon Value="mdi-file-move-outline" FontSize="13" /><TextBlock Text="{loc:Tr BulkMove}" FontSize="12" /></StackPanel></Button>
                                <Button Click="OnBulkAddTags" Padding="6,2" ToolTip.Tip="{loc:Tr MwAddTagsSelected}"><StackPanel Orientation="Horizontal" Spacing="3"><i:Icon Value="mdi-label-outline" FontSize="13" /><TextBlock Text="{loc:Tr TagsColTag}" FontSize="12" /></StackPanel></Button>
                                <Button Click="OnBulkSensitivity" Padding="6,2" ToolTip.Tip="{loc:Tr MwSetSensSelected}"><StackPanel Orientation="Horizontal" Spacing="3"><i:Icon Value="mdi-shield-outline" FontSize="13" /><TextBlock Text="{loc:Tr BulkSensLabel}" FontSize="12" /></StackPanel></Button>
                                <Button Click="OnBulkDelete" Padding="6,2" ToolTip.Tip="{loc:Tr MwDeleteSelected}"><StackPanel Orientation="Horizontal" Spacing="3"><i:Icon Value="mdi-delete-outline" FontSize="13" Foreground="#c0392b" /><TextBlock Text="{loc:Tr UgDelete}" FontSize="12" /></StackPanel></Button>
                            </StackPanel>
                        </Border>
                        <!-- Resizable, horizontally-scrollable columns (ADR "Desktop list-pane resizable columns"):
                             the header + the ListBox live in one horizontal ScrollViewer with a fixed total width
                             (ContentsTotalWidth), so they stay aligned when scrolled and a scrollbar appears once the
                             columns don't fit the pane. Each header cell carries a drag Thumb at its right edge. -->
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <DockPanel Width="{Binding ContentsTotalWidth}">
                        <!-- Sortable column header (ADR "List-row columns and sorting") — click a header to sort the loaded rows. -->
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,2,0,0" Background="{DynamicResource WbChrome}">
                            <Grid Width="{Binding ColNameWidth}">
                                <Button Content="{Binding NameHeader}" Command="{Binding SortContentsCommand}" CommandParameter="name" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="4,1" Background="Transparent" BorderThickness="0" FontSize="11" FontWeight="SemiBold" />
                                <Thumb Tag="0" DragDelta="OnColumnResize" DragCompleted="OnColumnResizeDone" Width="6" HorizontalAlignment="Right" Background="Transparent" Cursor="SizeWestEast" />
                            </Grid>
                            <Grid Width="{Binding ColTypeWidth}">
                                <Button Content="{Binding TypeHeader}" Command="{Binding SortContentsCommand}" CommandParameter="type" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="4,1" Background="Transparent" BorderThickness="0" FontSize="11" FontWeight="SemiBold" />
                                <Thumb Tag="1" DragDelta="OnColumnResize" DragCompleted="OnColumnResizeDone" Width="6" HorizontalAlignment="Right" Background="Transparent" Cursor="SizeWestEast" />
                            </Grid>
                            <Grid Width="{Binding ColDateWidth}">
                                <Button Content="{Binding DateHeader}" Command="{Binding SortContentsCommand}" CommandParameter="date" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="4,1" Background="Transparent" BorderThickness="0" FontSize="11" FontWeight="SemiBold" />
                                <Thumb Tag="2" DragDelta="OnColumnResize" DragCompleted="OnColumnResizeDone" Width="6" HorizontalAlignment="Right" Background="Transparent" Cursor="SizeWestEast" />
                            </Grid>
                            <Grid Width="{Binding ColSizeWidth}">
                                <Button Content="{Binding SizeHeader}" Command="{Binding SortContentsCommand}" CommandParameter="size" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="4,1" Background="Transparent" BorderThickness="0" FontSize="11" FontWeight="SemiBold" />
                                <Thumb Tag="3" DragDelta="OnColumnResize" DragCompleted="OnColumnResizeDone" Width="6" HorizontalAlignment="Right" Background="Transparent" Cursor="SizeWestEast" />
                            </Grid>
                            <Grid Width="{Binding ColTagsWidth}">
                                <Button Content="{Binding TagsHeader}" Command="{Binding SortContentsCommand}" CommandParameter="tags" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="4,1" Background="Transparent" BorderThickness="0" FontSize="11" FontWeight="SemiBold" />
                                <Thumb Tag="4" DragDelta="OnColumnResize" DragCompleted="OnColumnResizeDone" Width="6" HorizontalAlignment="Right" Background="Transparent" Cursor="SizeWestEast" />
                            </Grid>
                        </StackPanel>
                        <ListBox x:Name="ContentsList" AutomationProperties.AutomationId="tour:pane-list" DragDrop.AllowDrop="True" SelectionMode="Multiple"
                                 ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" DoubleTapped="OnListDoubleTapped"
                                 SelectionChanged="OnContentsSelectionChanged"
                                 ContextRequested="OnContentsContextRequested" KeyDown="OnListKeyDown">
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <!-- InputGesture is set in code-behind, not here: the chord is ⌘ on macOS and
                                         Ctrl elsewhere, which XAML cannot express (#482). -->
                                    <MenuItem x:Name="OpenMenuItem" Header="{loc:Tr MwOpen}" Click="OnOpen">
                                        <MenuItem.Icon><i:Icon Value="mdi-open-in-app" /></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{loc:Tr RibbonSaveAs}" Click="OnSaveAs">
                                        <MenuItem.Icon><i:Icon Value="mdi-content-save-outline" /></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{loc:Tr CtxVersions}" Click="OnVersions" IsEnabled="{Binding CanCompareVersions}">
                                        <MenuItem.Icon><i:Icon Value="mdi-history" /></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{loc:Tr MwCompareVersions}" Click="OnCompareVersions" IsEnabled="{Binding CanCompareVersions}">
                                        <MenuItem.Icon><i:Icon Value="mdi-compare" /></MenuItem.Icon>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="{loc:Tr CtxRename}" Click="OnRename">
                                        <MenuItem.Icon><i:Icon Value="mdi-rename-box" /></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{loc:Tr UgDelete}" Click="OnDelete">
                                        <MenuItem.Icon><i:Icon Value="mdi-delete" /></MenuItem.Icon>
                                    </MenuItem>
                                    <Separator IsVisible="{Binding CanManageAccess}" />
                                    <MenuItem AutomationProperties.AutomationId="tour:action-manage-access" Header="{loc:Tr MaManageAccess}" Click="OnManageAccess" IsVisible="{Binding CanManageAccess}">
                                        <MenuItem.Icon><i:Icon Value="mdi-shield-account-outline" /></MenuItem.Icon>
                                    </MenuItem>
                                    <Separator IsVisible="{Binding CanLegalHold}" />
                                    <MenuItem Header="{loc:Tr CtxPlaceLegalHold}" Click="OnPlaceLegalHold" IsVisible="{Binding CanLegalHold}">
                                        <MenuItem.Icon><i:Icon Value="mdi-gavel" /></MenuItem.Icon>
                                    </MenuItem>
                                    <Separator IsVisible="{Binding CanStartWorkflow}" />
                                    <MenuItem Header="{loc:Tr CtxWorkflow}" Click="OnStartWorkflow" IsVisible="{Binding CanStartWorkflow}">
                                        <MenuItem.Icon><i:Icon Value="mdi-sitemap-outline" /></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{loc:Tr MwRemind}" Command="{Binding RemindCommand}" IsVisible="{Binding CanRemind}">
                                        <MenuItem.Icon><i:Icon Value="mdi-alarm" /></MenuItem.Icon>
                                    </MenuItem>
                                    <Separator IsVisible="{Binding CanCheckOut}" />
                                    <MenuItem Header="{loc:Tr CtxCheckOut}" Command="{Binding CheckOutSelectedCommand}" IsVisible="{Binding CanCheckOut}">
                                        <MenuItem.Icon><i:Icon Value="mdi-lock-outline" /></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{loc:Tr CtxOverrideCheckout}" Command="{Binding OverrideCheckoutSelectedCommand}" IsVisible="{Binding CanOverrideSelected}">
                                        <MenuItem.Icon><i:Icon Value="mdi-lock-open-variant-outline" /></MenuItem.Icon>
                                    </MenuItem>
                                    <Separator IsVisible="{Binding SelectedHasReferences}" />
                                    <MenuItem Header="{loc:Tr MwReferences}" Click="OnReferences" IsVisible="{Binding SelectedHasReferences}">
                                        <MenuItem.Icon><i:Icon Value="mdi-link-variant" /></MenuItem.Icon>
                                    </MenuItem>
                                    <Separator IsVisible="{Binding SelectedIsReference}" />
                                    <MenuItem Header="{loc:Tr MwGoTo}" Click="OnGoTo" IsVisible="{Binding SelectedIsReference}">
                                        <MenuItem.Icon><i:Icon Value="mdi-arrow-right-thin-circle-outline" /></MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="6,2" />
                                </Style>
                            </ListBox.Styles>
                            <!-- List-row columns (ADRs "List-row columns and sorting" / "Desktop list-pane resizable
                                 columns"): each cell's width is bound to the same VM column width the header uses, so
                                 the header and rows stay aligned and resize together. -->
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:NodeViewModel">
                                    <StackPanel Orientation="Horizontal">
                                        <Grid Width="{Binding $parent[ListBox].DataContext.ColNameWidth}" ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto">
                                            <!-- Folders follow the tree's glyph rules (ADR 0547) so the same object looks
                                                 the same in both panes; documents keep the list's accent. -->
                                            <i:Icon Grid.Column="0" Value="{Binding IconValue}" Foreground="{DynamicResource WbMuted}"
                                                    Classes.wbFolder="{Binding UsesFolderBrush}"
                                                    Classes.wbFolderEmpty="{Binding UsesEmptyFolderBrush}"
                                                    VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBlock Grid.Column="1" Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <i:Icon Grid.Column="2" Value="mdi-lock" Foreground="#d9a400" VerticalAlignment="Center" Margin="6,0,0,0" IsVisible="{Binding OnLegalHold}" ToolTip.Tip="{loc:Tr LhUnderHold}" />
                                            <!-- Check-out lock (ADR "Document check-out / check-in"): green when mine, red when someone else's. -->
                                            <i:Icon Grid.Column="3" Value="mdi-lock-open-check" Foreground="#2e7d32" VerticalAlignment="Center" Margin="6,0,0,0" IsVisible="{Binding CheckedOutByMe}" ToolTip.Tip="{loc:Tr CoLockedMine}" />
                                            <i:Icon Grid.Column="4" Value="mdi-lock" Foreground="#e53935" VerticalAlignment="Center" Margin="6,0,0,0" IsVisible="{Binding CheckedOutByOther}" ToolTip.Tip="{loc:Tr CoLockedOther}" />
                                            <!-- Sensitivity badge (ADR "Sensitivity-label list badge + search facet"). -->
                                            <Border Grid.Column="5" IsVisible="{Binding HasSensitivity}" Background="{Binding SensitivityBrush}" CornerRadius="3" Padding="4,0" Margin="6,0,0,0" VerticalAlignment="Center"
                                                    ToolTip.Tip="{Binding SensitivityText, StringFormat='Sensitivity: {0}'}">
                                                <TextBlock Text="{Binding SensitivityText}" Foreground="White" FontSize="9" FontWeight="SemiBold" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Width="{Binding $parent[ListBox].DataContext.ColTypeWidth}" Text="{Binding TypeText}" VerticalAlignment="Center" Foreground="{DynamicResource WbMuted}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Width="{Binding $parent[ListBox].DataContext.ColDateWidth}" Text="{Binding DocumentDateText}" VerticalAlignment="Center" Foreground="{DynamicResource WbMuted}" FontSize="12" />
                                        <TextBlock Width="{Binding $parent[ListBox].DataContext.ColSizeWidth}" Text="{Binding SizeText}" VerticalAlignment="Center" Foreground="{DynamicResource WbMuted}" FontSize="12" />
                                        <TextBlock Width="{Binding $parent[ListBox].DataContext.ColTagsWidth}" Text="{Binding TagsText}" VerticalAlignment="Center" Foreground="{DynamicResource WbMuted}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding TagsText}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        </DockPanel>
                        </ScrollViewer>
                        </DockPanel>

                        <!-- gutter: resize + collapse the contents list -->
                        <GridSplitter Grid.Column="3" Background="{DynamicResource WbBorder}" ResizeDirection="Columns" IsEnabled="{Binding !ListCollapsed}" />
                        <Button Grid.Column="3" Command="{Binding ToggleListCommand}" Width="10" Height="24" Padding="0" MinWidth="0" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip.Tip="{loc:Tr MwCollapseExpand}">
                            <i:Icon Value="{Binding ListCaret}" FontSize="11" />
                        </Button>

                        <!-- Detail: index-data over (preview | chat) -->
                        <Grid Grid.Column="4">
                            <Grid.RowDefinitions>
                                <!-- Auto by default so the pane fits its content and the preview keeps the rest
                                     (ADR 0550); a GridSplitter drag writes a pixel height into the same property,
                                     which the next selection resets back to Auto. MaxHeight caps a long mask so
                                     it cannot push the preview off the bottom. -->
                                <RowDefinition Height="{Binding IndexHeight, Mode=TwoWay}" MaxHeight="280" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="3*" />
                            </Grid.RowDefinitions>

                            <!-- Index-data -->
                            <ScrollViewer Grid.Row="0" AutomationProperties.AutomationId="tour:pane-index" IsVisible="{Binding !IndexCollapsed}">
                                <StackPanel Margin="12,10" Spacing="4">
                                    <!-- The row that owns this object's actions. While EDITING it swaps to Save + Cancel
                                         in the SAME slots (ADR 0550): the pencil taught the user where this pane's
                                         controls are, so the commit belongs there and not at the far end of the pane;
                                         and the actions that can do nothing mid-edit (share, follow) go away rather than
                                         sit inert. Declaration order matters — Dock=Right stacks right-to-left, so first
                                         means rightmost, matching where the web row ends (ADR 0511). -->
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" AutomationProperties.AutomationId="tour:action-save-index" Command="{Binding SaveDetailCommand}"
                                                ToolTip.Tip="{loc:Tr Save}" IsVisible="{Binding IsEditing}"
                                                Height="26" Padding="6,0" Background="Transparent" BorderThickness="0">
                                            <i:Icon Value="mdi-content-save-outline" FontSize="16" />
                                        </Button>
                                        <Button DockPanel.Dock="Right" Command="{Binding CancelEditCommand}"
                                                ToolTip.Tip="{loc:Tr Cancel}" IsVisible="{Binding IsEditing}"
                                                Height="26" Padding="6,0" Background="Transparent" BorderThickness="0">
                                            <i:Icon Value="mdi-close" FontSize="16" />
                                        </Button>
                                        <Button DockPanel.Dock="Right" AutomationProperties.AutomationId="tour:action-edit-index" Command="{Binding BeginEditCommand}"
                                                ToolTip.Tip="{loc:Tr Edit}" IsVisible="{Binding CanBeginEdit}"
                                                Height="26" Padding="6,0" Background="Transparent" BorderThickness="0">
                                            <i:Icon Value="mdi-pencil-outline" FontSize="16" />
                                        </Button>
                                        <!-- Follow / unfollow this document (ADR "Document subscriptions"). -->
                                        <Button DockPanel.Dock="Right" Command="{Binding ToggleSubscriptionCommand}" ToolTip.Tip="{Binding SubscriptionTip}"
                                                IsVisible="{Binding !IsEditing}"
                                                Height="26" Padding="6,0" Background="Transparent" BorderThickness="0">
                                            <i:Icon Value="{Binding SubscriptionIcon}" FontSize="16" />
                                        </Button>
                                        <!-- Share this document by external link (ADR 0546, issue #385). Shown only when the
                                             server advertised the rel — with the tenant switch off, without the right, or on a
                                             FOLDER, there is no link to offer and the button is simply absent. -->
                                        <Button DockPanel.Dock="Right" Command="{Binding ShowDocumentExternalLinksCommand}"
                                                ToolTip.Tip="{loc:Tr ExtLinkShare}" IsVisible="{Binding CanShareDocument}"
                                                Height="26" Padding="6,0" Background="Transparent" BorderThickness="0">
                                            <i:Icon Value="mdi-link-variant" FontSize="16" />
                                        </Button>
                                        <!-- The SAME glyph the tree draws for this object (ADR 0547): a folder looks like a
                                             folder — and an empty one like an empty one — in every pane. -->
                                        <i:Icon DockPanel.Dock="Left" Value="{Binding DetailGlyph}" FontSize="16"
                                                Classes.wbFolder="{Binding DetailGlyphBrushKey, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter=WbFolder}"
                                                Classes.wbFolderEmpty="{Binding DetailGlyphBrushKey, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter=WbFolderEmpty}"
                                                VerticalAlignment="Center" Margin="0,0,6,0"
                                                IsVisible="{Binding DetailTitle, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                                        <TextBlock Text="{Binding DetailTitle}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </DockPanel>


                                    <!-- System fields: always shown, separate from the mask (ADR "System fields + OCR-language mask
                                         field"). Read-only until the pane enters edit mode (ADR "Single pane-level edit toggle on
                                         the detail pane"); Name/Document date/OCR languages then become editable, File extension/
                                         Created/Created by stay read-only. -->
                                    <Grid ColumnDefinitions="110,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" Margin="0,8,0,0"
                                          IsVisible="{Binding SysCreated, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Tr Name}" Foreground="{DynamicResource WbMuted}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SysName}" VerticalAlignment="Center" Margin="0,2" IsVisible="{Binding !IsEditing}" />
                                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SysName}" Height="28" Padding="4,2" VerticalContentAlignment="Center" Margin="0,2" IsVisible="{Binding IsEditing}" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Tr SysFileExtension}" Foreground="{DynamicResource WbMuted}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SysFileExtension}" Foreground="{DynamicResource WbMuted}" VerticalAlignment="Center" Margin="0,2" />

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Tr VerColDocDate}" Foreground="{DynamicResource WbMuted}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SysDocumentDateText}" VerticalAlignment="Center" Margin="0,2" IsVisible="{Binding !IsEditing}" />
                                        <DatePicker Grid.Row="2" Grid.Column="1" SelectedDate="{Binding SysDocumentDate}" HorizontalAlignment="Left" Margin="0,2" IsVisible="{Binding IsEditing}" />

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Tr SysOcrLanguages}" Foreground="{DynamicResource WbMuted}" VerticalAlignment="Center" IsVisible="{Binding SysHasTiff}" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SysOcrLanguages}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,2" IsVisible="{Binding SysHasTiff}" />
                                        <Button Grid.Row="3" Grid.Column="2" Click="OnEditOcrLanguages" Margin="6,2,0,2" ToolTip.Tip="{loc:Tr MwEditOcr}" IsVisible="{Binding CanEditOcr}"><i:Icon Value="mdi-pencil-outline" /></Button>

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="{loc:Tr SysCreated}" Foreground="{DynamicResource WbMuted}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SysCreated}" VerticalAlignment="Center" Margin="0,2" />

                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="{loc:Tr SysCreatedBy}" Foreground="{DynamicResource WbMuted}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SysCreatedBy}" VerticalAlignment="Center" Margin="0,2" />

                                        <!-- The document's current (latest confirmed) version number, directly below Created by
                                             (ADR "Mask-pane current-version line"). -->
                                        <TextBlock Grid.Row="6" Grid.Column="0" Text="{loc:Tr SysCurrentVersion}" Foreground="{DynamicResource WbMuted}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SysCurrentVersion}" Foreground="{DynamicResource WbMuted}" VerticalAlignment="Center" Margin="0,2" />

                                        <!-- The workflow's state, readable at a glance, with the state-labelled
                                             affordance beside it (review decision: Start / Manage / View). -->
                                        <TextBlock Grid.Row="7" Grid.Column="0" Text="{loc:Tr WorkflowStatus}" Foreground="{DynamicResource WbMuted}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding WorkflowStateDisplay}" VerticalAlignment="Center" Margin="0,2" />
                                            <Button Content="{Binding WorkflowButtonLabel}" Click="OnStartWorkflow" Padding="8,2" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Folder-only: the order this folder lists its contents in (ADR "Per-folder contents
                                         sort order"). A row in the ONE detail pane since issue #408, committed by the same
                                         Save as the mask beside it rather than by an Edit toggle of its own. -->
                                    <Grid ColumnDefinitions="130,*" Margin="0,6,0,0" IsVisible="{Binding DetailIsFolder}">
                                        <TextBlock Grid.Column="0" Text="{loc:Tr FolderSortLabel}" Foreground="{DynamicResource WbMuted}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding DetailSortText}" VerticalAlignment="Center" IsVisible="{Binding !IsEditing}" />
                                        <ComboBox Grid.Column="1" SelectedIndex="{Binding EditSortOrder}" IsVisible="{Binding IsEditing}" HorizontalAlignment="Left" MinWidth="180">
                                            <ComboBoxItem Content="{loc:Tr FolderSortName}" />
                                            <ComboBoxItem Content="{loc:Tr FolderSortDocDate}" />
                                            <ComboBoxItem Content="{loc:Tr FolderSortCreated}" />
                                        </ComboBox>
                                    </Grid>

                                    <!-- Mask (additional metadata) — read-only when the pane isn't editing. -->
                                    <StackPanel IsVisible="{Binding !IsEditing}" Margin="0,10,0,0">
                                        <TextBlock Text="{Binding MaskLine}" Foreground="{DynamicResource WbMuted}" FontSize="12" VerticalAlignment="Center" />
                                        <!-- Sensitivity badge (ADR "Configurable sensitivity labels + upload defaults"). -->
                                        <Border IsVisible="{Binding HasSensitivity}" Background="{Binding DetailSensitivityBrush}" CornerRadius="3" Padding="6,1" HorizontalAlignment="Left" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding DetailSensitivityText}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                        <ItemsControl ItemsSource="{Binding IndexFields}" Margin="0,2,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:IndexFieldViewModel">
                                                    <Grid ColumnDefinitions="180,*" Margin="0,2">
                                                        <TextBlock Grid.Column="0" Text="{Binding FieldName}" Foreground="{DynamicResource WbMuted}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Values}" TextWrapping="Wrap" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <!-- Free-form tags (ADR "Document tags") — clickable chips → search by that tag. -->
                                        <ItemsControl IsVisible="{Binding HasDetailTags}" ItemsSource="{Binding DetailTags}" Margin="0,6,0,0">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:CompileBindings="False">
                                                    <Button Margin="0,0,4,4" Padding="7,1" Background="{DynamicResource WbChrome}" CornerRadius="3"
                                                            CommandParameter="{Binding}"
                                                            Command="{Binding DataContext.SearchByTagCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                                            <i:Icon Value="mdi-label-outline" FontSize="11" />
                                                            <TextBlock Text="{Binding}" FontSize="11" />
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- Mask edit mode: choose the mask + type-aware field editors. -->
                                    <StackPanel IsVisible="{Binding IsEditing}" Spacing="6" Margin="0,10,0,0">
                                        <Grid ColumnDefinitions="180,*">
                                            <TextBlock Grid.Column="0" Text="{loc:Tr MaskLabel}" Foreground="{DynamicResource WbMuted}" VerticalAlignment="Center" />
                                            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding AvailableMasks}" SelectedItem="{Binding SelectedMaskChoice}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:MaskChoiceViewModel"><TextBlock Text="{Binding Name}" /></DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </Grid>
                                        <!-- Sensitivity label (ADR "Data classification / sensitivity labels"). -->
                                        <Grid ColumnDefinitions="180,*">
                                            <TextBlock Grid.Column="0" Text="{loc:Tr BulkSensLabel}" Foreground="{DynamicResource WbMuted}" VerticalAlignment="Center" />
                                            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding SensitivityPickerItems}" SelectedItem="{Binding SelectedSensitivityItem}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:MainWindowViewModel+SensitivityPickerItem"><TextBlock Text="{Binding Name}" /></DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding MaskEditFields}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:MaskFieldEditViewModel">
                                                    <Grid ColumnDefinitions="180,*" Margin="0,3">
                                                        <TextBlock Grid.Column="0" Text="{Binding Label}" Foreground="{DynamicResource WbMuted}" VerticalAlignment="Center" />
                                                        <Panel Grid.Column="1">
                                                            <DatePicker IsVisible="{Binding IsDate}" HorizontalAlignment="Left" SelectedDate="{Binding DateValue}" />
                                                            <CheckBox IsVisible="{Binding IsBoolean}" IsChecked="{Binding BoolValue}" />
                                                            <TextBox IsVisible="{Binding IsMultiSelect}" Text="{Binding TextValue}" AcceptsReturn="True" Height="60" Watermark="{loc:Tr OneValuePerLine}" />
                                                            <TextBox IsVisible="{Binding IsSingleLine}" Text="{Binding TextValue}" Height="28" Padding="4,2" VerticalContentAlignment="Center" />
                                                        </Panel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <!-- Free-form tags (ADR "Document tags") — removable chips + a catalog-autocomplete add box. -->
                                        <Grid ColumnDefinitions="180,*">
                                            <TextBlock Grid.Column="0" Text="{loc:Tr TabTags}" Foreground="{DynamicResource WbMuted}" VerticalAlignment="Top" Margin="0,4,0,0" />
                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <ItemsControl ItemsSource="{Binding EditTags}">
                                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:CompileBindings="False">
                                                            <Border Margin="0,0,4,4" Padding="7,1" Background="{DynamicResource WbChrome}" CornerRadius="3">
                                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                                    <TextBlock Text="{Binding}" FontSize="11" VerticalAlignment="Center" />
                                                                    <Button Content="✕" Padding="3,0" MinWidth="0" MinHeight="0" FontSize="10" Background="Transparent"
                                                                            CommandParameter="{Binding}"
                                                                            Command="{Binding DataContext.RemoveTagCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <AutoCompleteBox Text="{Binding NewTag, Mode=TwoWay}" ItemsSource="{Binding TagCatalog}"
                                                                     Watermark="{loc:Tr BulkTagsPlaceholder}" FilterMode="ContainsOrdinal" MinimumPrefixLength="0" Width="220" />
                                                    <Button Content="{loc:Tr Add}" Command="{Binding AddTagCommand}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>

                                    <!-- No commit row here: Save and Cancel live in the header, where the pencil that
                                         started the edit is (ADR 0550). -->
                                </StackPanel>
                            </ScrollViewer>

                            <!-- gutter: resize + collapse the index-data pane -->
                            <GridSplitter Grid.Row="1" Background="{DynamicResource WbBorder}" ResizeDirection="Rows" HorizontalAlignment="Stretch" IsEnabled="{Binding !IndexCollapsed}" />
                            <Button Grid.Row="1" Command="{Binding ToggleIndexCommand}" Width="24" Height="10" Padding="0" MinHeight="0" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip.Tip="{loc:Tr MwCollapseExpand}">
                                <i:Icon Value="{Binding IndexCaret}" FontSize="11" />
                            </Button>

                            <!-- preview | chat -->
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="{Binding ChatWidth, Mode=TwoWay}" />
                                </Grid.ColumnDefinitions>

                                <!-- Preview (docked). The surface is a reusable UserControl — see the full-screen
                                     overlay below and ADR "Desktop preview full-screen toggle". -->
                                <Border Grid.Column="0" AutomationProperties.AutomationId="tour:pane-preview" BorderBrush="{DynamicResource WbBorder}" BorderThickness="0,1,0,0"
                                        IsVisible="{Binding !Preview.PreviewFullscreen}">
                                    <v:PreviewPane DataContext="{Binding Preview}" />
                                </Border>

                                <!-- gutter: resize + collapse the chat -->
                                <GridSplitter Grid.Column="1" Background="{DynamicResource WbBorder}" ResizeDirection="Columns" IsEnabled="{Binding !ChatCollapsed}" />
                                <Button Grid.Column="1" Command="{Binding ToggleChatCommand}" Width="10" Height="24" Padding="0" MinWidth="0" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip.Tip="{loc:Tr MwCollapseExpand}">
                                    <i:Icon Value="{Binding ChatCaret}" FontSize="11" />
                                </Button>

                                <!-- Chat -->
                                <Border Grid.Column="2" AutomationProperties.AutomationId="tour:pane-chat" IsVisible="{Binding !ChatCollapsed}" BorderBrush="{DynamicResource WbBorder}" BorderThickness="1,1,0,0">
                                    <DockPanel LastChildFill="True">
                                        <TextBlock DockPanel.Dock="Top" Text="{loc:Tr CommentsHeader}" FontWeight="SemiBold" Margin="10,8" />
                                        <Border DockPanel.Dock="Bottom" Padding="8" BorderBrush="{DynamicResource WbBorder}" BorderThickness="0,1,0,0">
                                            <StackPanel Spacing="4">
                                                <!-- The @-mention picker (issue #383), ABOVE the box: it opens while typing at the
                                                     bottom of the pane, so opening downwards would push it out of view. -->
                                                <ItemsControl ItemsSource="{Binding MentionCandidates}"
                                                              IsVisible="{Binding HasMentionCandidates}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="svc:SimplArchiveApiClient+MentionableUser">
                                                            <Button Classes="mention" HorizontalAlignment="Stretch" Padding="6,3" FontSize="12"
                                                                    Background="Transparent" BorderThickness="0"
                                                                    HorizontalContentAlignment="Left" Content="{Binding DisplayName}"
                                                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).PickMentionCommand}"
                                                                    CommandParameter="{Binding}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBox Text="{Binding NewComment}" Watermark="{loc:Tr CommentPlaceholder}" AcceptsReturn="True" MinHeight="46" />
                                                <Button Command="{Binding PostCommentCommand}" HorizontalAlignment="Right" ToolTip.Tip="{loc:Tr MwPostComment}">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <i:Icon Value="mdi-send" FontSize="16" />
                                                        <TextBlock Text="{loc:Tr CommentBtn}" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                        <ScrollViewer>
                                            <ItemsControl ItemsSource="{Binding Comments}" Margin="10,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:ChatMessageViewModel">
                                                        <StackPanel Margin="0,6">
                                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                                <Button Classes="link" IsVisible="{Binding ShowAuthorLink}" Padding="0" FontSize="11"
                                                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ShowAuthorCardCommand}"
                                                                        CommandParameter="{Binding}" Content="{Binding AuthorName}">
                                                                    <!-- The identity card (ADR 0544). Clicking runs the command (which follows the
                                                                         advertised card href) and opens this flyout; it binds to the window VM, since
                                                                         only one card is open at a time. -->
                                                                    <Button.Flyout>
                                                                        <Flyout Placement="Bottom">
                                                                            <StackPanel MinWidth="220" Margin="4" Orientation="Horizontal" Spacing="12"
                                                                                        DataContext="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext)}">
                                                                                <Border IsVisible="{Binding AuthorCard, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                                                        Width="56" Height="56" CornerRadius="28" ClipToBounds="True"
                                                                                        Background="{DynamicResource WbChrome}">
                                                                                    <Panel>
                                                                                        <TextBlock Text="{Binding AuthorCard.Initials}" HorizontalAlignment="Center"
                                                                                                   VerticalAlignment="Center" FontSize="20"
                                                                                                   IsVisible="{Binding !AuthorCard.HasPhoto}" />
                                                                                        <Image Source="{Binding AuthorCard.PhotoImage}" Stretch="UniformToFill"
                                                                                               IsVisible="{Binding AuthorCard.HasPhoto}" />
                                                                                    </Panel>
                                                                                </Border>
                                                                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                                                                    <TextBlock Text="{Binding AuthorCard.DisplayName}" FontWeight="SemiBold" FontSize="13" />
                                                                                    <TextBlock Text="{Binding AuthorCard.Email}" Foreground="{DynamicResource WbMuted}" FontSize="12" />
                                                                                    <TextBlock Text="{loc:Tr UserCardDeactivated}" Foreground="{DynamicResource WbMuted}"
                                                                                               FontSize="11" IsVisible="{Binding !AuthorCard.IsActive}" />
                                                                                    <TextBlock Text="{loc:Tr UserCardLoadFailed}" Foreground="{DynamicResource WbMuted}"
                                                                                               FontSize="11" TextWrapping="Wrap" MaxWidth="200"
                                                                                               IsVisible="{Binding AuthorCardFailed}" />
                                                                                </StackPanel>
                                                                            </StackPanel>
                                                                        </Flyout>
                                                                    </Button.Flyout>
                                                                </Button>
                                                                <TextBlock IsVisible="{Binding ShowAuthorPlainName}" Text="{Binding AuthorName}"
                                                                           Foreground="{DynamicResource WbFaint}" FontSize="11" />
                                                                <TextBlock Text="{Binding Timestamp}" Foreground="{DynamicResource WbFaint}" FontSize="11" />
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding DisplayBody}" TextWrapping="Wrap" FontSize="13" IsVisible="{Binding IsUserPost}" />
                                                            <!-- Reply affordance: a top-level typed message only (ADR 0511 parity with the web
                                                                 thread). It binds to the window view-model, since the command has to close
                                                                 whichever other reply box is open.
                                                                 Deliberately NOT Classes="link" — no such style is defined in this app, so that
                                                                 class is a no-op and the button would render with full default chrome next to
                                                                 the message text. The flat look is set here instead, matching the web's link. -->
                                                            <Button IsVisible="{Binding ShowReplyLink}" Padding="0" FontSize="11"
                                                                    HorizontalAlignment="Left" Content="{loc:Tr ReplyBtn}"
                                                                    Background="Transparent" BorderThickness="0"
                                                                    Foreground="{DynamicResource WbMuted}"
                                                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ToggleReplyCommand}"
                                                                    CommandParameter="{Binding}" />
                                                            <!-- An automatic entry (ADR 0545): the sentence, then the
                                                                 version block with its icon and optional comment. -->
                                                            <TextBlock Text="{Binding SystemSentence}" TextWrapping="Wrap" FontSize="13"
                                                                       FontStyle="Italic" Foreground="{DynamicResource WbMuted}"
                                                                       IsVisible="{Binding IsSystemEntry}" />
                                                            <Border IsVisible="{Binding HasVersionEntry}" Margin="0,3,0,0" Padding="6,3"
                                                                    BorderBrush="{DynamicResource WbBorder}" BorderThickness="2,0,0,0">
                                                                <StackPanel Orientation="Horizontal" Spacing="6">

                                                                    <StackPanel Spacing="1">
                                                                        <TextBlock Text="{Binding VersionLabel}" FontSize="11" />
                                                                        <TextBlock Text="{Binding VersionCommentText}" FontSize="11" TextWrapping="Wrap"
                                                                                   Foreground="{DynamicResource WbMuted}"
                                                                                   IsVisible="{Binding HasVersionComment}" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </Border>
                                                            <ItemsControl ItemsSource="{Binding Replies}" Margin="16,4,0,0">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="vm:ChatMessageViewModel">
                                                                        <Border BorderBrush="{DynamicResource WbBorder}" BorderThickness="2,0,0,0" Padding="8,2" Margin="0,3">
                                                                            <StackPanel>
                                                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                                <Button Classes="link" IsVisible="{Binding ShowAuthorLink}" Padding="0" FontSize="11"
                                                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ShowAuthorCardCommand}"
                                                                        CommandParameter="{Binding}" Content="{Binding AuthorName}">
                                                                    <!-- The identity card (ADR 0544). Clicking runs the command (which follows the
                                                                         advertised card href) and opens this flyout; it binds to the window VM, since
                                                                         only one card is open at a time. -->
                                                                    <Button.Flyout>
                                                                        <Flyout Placement="Bottom">
                                                                            <StackPanel MinWidth="220" Margin="4" Orientation="Horizontal" Spacing="12"
                                                                                        DataContext="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext)}">
                                                                                <Border IsVisible="{Binding AuthorCard, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                                                        Width="56" Height="56" CornerRadius="28" ClipToBounds="True"
                                                                                        Background="{DynamicResource WbChrome}">
                                                                                    <Panel>
                                                                                        <TextBlock Text="{Binding AuthorCard.Initials}" HorizontalAlignment="Center"
                                                                                                   VerticalAlignment="Center" FontSize="20"
                                                                                                   IsVisible="{Binding !AuthorCard.HasPhoto}" />
                                                                                        <Image Source="{Binding AuthorCard.PhotoImage}" Stretch="UniformToFill"
                                                                                               IsVisible="{Binding AuthorCard.HasPhoto}" />
                                                                                    </Panel>
                                                                                </Border>
                                                                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                                                                    <TextBlock Text="{Binding AuthorCard.DisplayName}" FontWeight="SemiBold" FontSize="13" />
                                                                                    <TextBlock Text="{Binding AuthorCard.Email}" Foreground="{DynamicResource WbMuted}" FontSize="12" />
                                                                                    <TextBlock Text="{loc:Tr UserCardDeactivated}" Foreground="{DynamicResource WbMuted}"
                                                                                               FontSize="11" IsVisible="{Binding !AuthorCard.IsActive}" />
                                                                                    <TextBlock Text="{loc:Tr UserCardLoadFailed}" Foreground="{DynamicResource WbMuted}"
                                                                                               FontSize="11" TextWrapping="Wrap" MaxWidth="200"
                                                                                               IsVisible="{Binding AuthorCardFailed}" />
                                                                                </StackPanel>
                                                                            </StackPanel>
                                                                        </Flyout>
                                                                    </Button.Flyout>
                                                                </Button>
                                                                <TextBlock IsVisible="{Binding ShowAuthorPlainName}" Text="{Binding AuthorName}"
                                                                           Foreground="{DynamicResource WbFaint}" FontSize="11" />
                                                                <TextBlock Text="{Binding Timestamp}" Foreground="{DynamicResource WbFaint}" FontSize="11" />
                                                            </StackPanel>
                                                                                <TextBlock Text="{Binding DisplayBody}" TextWrapping="Wrap" FontSize="13" IsVisible="{Binding IsUserPost}" />
                                                            <!-- An automatic entry (ADR 0545): the sentence, then the
                                                                 version block with its icon and optional comment. -->
                                                            <TextBlock Text="{Binding SystemSentence}" TextWrapping="Wrap" FontSize="13"
                                                                       FontStyle="Italic" Foreground="{DynamicResource WbMuted}"
                                                                       IsVisible="{Binding IsSystemEntry}" />
                                                            <Border IsVisible="{Binding HasVersionEntry}" Margin="0,3,0,0" Padding="6,3"
                                                                    BorderBrush="{DynamicResource WbBorder}" BorderThickness="2,0,0,0">
                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                    
                                                                    <StackPanel Spacing="1">
                                                                        <TextBlock Text="{Binding VersionLabel}" FontSize="11" />
                                                                        <TextBlock Text="{Binding VersionCommentText}" FontSize="11" TextWrapping="Wrap"
                                                                                   Foreground="{DynamicResource WbMuted}"
                                                                                   IsVisible="{Binding HasVersionComment}" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </Border>
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <!-- The reply box sits BELOW the existing replies, where the new one will
                                                                 appear — so the thread reads in the order it was written. -->
                                                            <StackPanel IsVisible="{Binding IsReplying}" Margin="16,4,0,0" Spacing="4">
                                                                <TextBox Text="{Binding ReplyText}" Watermark="{loc:Tr ReplyPlaceholder}"
                                                                         AcceptsReturn="True" MinHeight="40" FontSize="13" />
                                                                <Button HorizontalAlignment="Right" FontSize="11" Content="{loc:Tr ReplyBtn}"
                                                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).PostReplyCommand}"
                                                                        CommandParameter="{Binding}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>

                            </Grid>
                        </Grid>
                    </Grid>
                </DockPanel>

                    <!-- Full-screen preview overlay (in-app maximize): covers the ribbon + panes; the bottom tab
                         strip stays reachable, so switching tabs exits full screen. Esc also exits (Window key
                         binding). See ADR "Desktop preview full-screen toggle". -->
                    <Border IsVisible="{Binding Preview.PreviewFullscreen}" ZIndex="100" Background="{DynamicResource WbChrome}">
                        <v:PreviewPane DataContext="{Binding Preview}" />
                    </Border>
                </Grid>
            </TabItem>

            <TabItem ToolTip.Tip="{loc:Tr TabInbox}">
                <TabItem.Header><i:Icon Value="mdi-inbox" FontSize="20" /></TabItem.Header>
                <!-- Outer grid so the preview full-screen overlay can cover the inbox (tab strip stays reachable). -->
                <Grid>
                <DockPanel LastChildFill="True">

                <!-- The inbox ribbon is its own control (ADR 0577): it grew a group per feature — pages,
                     straightening, separator sheets — and each one arrived as more lines in this file. -->
                <v:InboxRibbon DockPanel.Dock="Top" />

                <Grid Margin="14" ColumnDefinitions="*,10,1.15*">

                    <!-- Left column: the server inbox (the S3-backed staging area) + actions. The old local-inbox
                         sync is replaced by opening the Inbox as a WebDAV folder (ADR "Desktop inbox via WebDAV"). -->
                    <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*,Auto">
                        <!-- Inbox header -->
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{loc:Tr TabInbox}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding InboxStatus}" Foreground="{DynamicResource WbFaint}" FontSize="11" />
                            </StackPanel>
                        </Grid>
                        <!-- View filter (ADR 0532): a CanManageInboxes holder gets a user-picker to open another
                             user's inbox. Its companion — "show group inboxes" — is an on/off, so it went to the
                             ribbon as a toggle beside the other sticky toggles (#521, promoted from the web per
                             ADR 0511); a picker cannot follow it, because it chooses a value out of a list as
                             long as the tenant has users. -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Margin="0,0,0,6" VerticalAlignment="Center"
                                    IsVisible="{Binding CanManageInboxes}">
                            <ComboBox MinWidth="180"
                                      ItemsSource="{Binding InboxUsers}" SelectedItem="{Binding SelectedInboxUser}"
                                      PlaceholderText="{loc:Tr InboxUserPicker}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:InboxUserPickerItem">
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <ListBox Grid.Row="2" x:Name="ServerInboxList" ItemsSource="{Binding ServerInbox}" SelectedItem="{Binding SelectedServerInboxItem}"
                                 DragDrop.AllowDrop="True"
                                 SelectionMode="Multiple" SelectionChanged="OnServerInboxSelectionChanged" DoubleTapped="OnInboxItemDoubleTapped">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:InboxItemViewModel">
                                    <!-- The row, its indicators and its context menu are their own control
                                         (#521, #519): this file has no headroom, and a row is a thing. -->
                                    <v:InboxRow />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <GridSplitter Grid.Column="1" Background="{DynamicResource WbBorder}" ResizeDirection="Columns" HorizontalAlignment="Stretch" />

                    <!-- Right column: mask/index-data pane (top) │ preview pane (bottom). Each is resizable
                         (the row splitter) + collapsible (its header caret) + persisted. -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="{Binding InboxMaskHeight, Mode=TwoWay}" />
                            <RowDefinition Height="6" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="{Binding InboxPreviewHeight, Mode=TwoWay}" />
                        </Grid.RowDefinitions>

                        <!-- Mask / index-data header -->
                        <Border Grid.Row="0" BorderBrush="{DynamicResource WbBorder}" BorderThickness="1,0,0,0">
                            <Grid ColumnDefinitions="*,Auto" Margin="12,6">
                                <TextBlock Grid.Column="0" Text="{Binding InboxDetailTitle}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Command="{Binding ToggleInboxMaskCommand}" ToolTip.Tip="{loc:Tr MwCollapseExpand}"><i:Icon Value="{Binding InboxMaskCaret}" /></Button>
                            </Grid>
                        </Border>

                        <!-- Mask / index-data body (staged to the item's sidecar) — editable only for a focused server item -->
                        <Border Grid.Row="1" BorderBrush="{DynamicResource WbBorder}" BorderThickness="1,0,0,0" IsVisible="{Binding !InboxMaskCollapsed}">
                            <ScrollViewer>
                                <StackPanel Margin="12,4" Spacing="6">
                                    <TextBlock Text="{loc:Tr MwSelectInboxItem}" Foreground="{DynamicResource WbFaint}"
                                               TextWrapping="Wrap" IsVisible="{Binding !InboxItemFocused}" />

                                    <!-- Emails (.eml/.msg) are classified automatically when filed — no mask offered. -->
                                    <StackPanel IsVisible="{Binding InboxIsEmail}" Orientation="Horizontal" Spacing="8" Margin="0,4">
                                        <i:Icon Value="mdi-email-check-outline" Foreground="{DynamicResource WbMuted}" VerticalAlignment="Center" />
                                        <TextBlock Text="{loc:Tr InboxEmailAutoMask}" Foreground="{DynamicResource WbMuted}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <StackPanel Spacing="6">
                                        <StackPanel.IsVisible>
                                            <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
                                                <Binding Path="InboxItemFocused" />
                                                <Binding Path="!InboxIsEmail" />
                                            </MultiBinding>
                                        </StackPanel.IsVisible>
                                        <Grid ColumnDefinitions="180,*">
                                            <TextBlock Grid.Column="0" Text="{loc:Tr Name}" Foreground="{DynamicResource WbMuted}" VerticalAlignment="Center" />
                                            <TextBox Grid.Column="1" Text="{Binding InboxName}" Height="28" Padding="4,2" VerticalContentAlignment="Center" />
                                        </Grid>
                                        <Grid ColumnDefinitions="180,*">
                                            <TextBlock Grid.Column="0" Text="{loc:Tr VerColDocDate}" Foreground="{DynamicResource WbMuted}" VerticalAlignment="Center" />
                                            <!-- Free-text date entry with an optional calendar picker (ADR "Intray refinements"). -->
                                            <CalendarDatePicker Grid.Column="1" SelectedDate="{Binding InboxDocumentDate}" Watermark="yyyy-MM-dd" HorizontalAlignment="Stretch" />
                                        </Grid>
                                        <Grid ColumnDefinitions="180,*">
                                            <TextBlock Grid.Column="0" Text="{loc:Tr MaskLabel}" Foreground="{DynamicResource WbMuted}" VerticalAlignment="Center" />
                                            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding InboxAvailableMasks}" SelectedItem="{Binding InboxSelectedMaskChoice}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:MaskChoiceViewModel"><TextBlock Text="{Binding Name}" /></DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </Grid>
                                        <!-- OCR languages for a scannable item — staged, applied to the searchable-PDF conversion at filing (ADR "Inbox OCR-language staging"). -->
                                        <Grid ColumnDefinitions="180,*,Auto" IsVisible="{Binding InboxStgScannable}">
                                            <TextBlock Grid.Column="0" Text="{loc:Tr SysOcrLanguages}" Foreground="{DynamicResource WbMuted}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding InboxOcrDisplay}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            <Button Grid.Column="2" Click="OnEditInboxOcrLanguages" Margin="6,2,0,2" ToolTip.Tip="{loc:Tr MwEditOcr}"><i:Icon Value="mdi-pencil-outline" /></Button>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding InboxMaskEditFields}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:MaskFieldEditViewModel">
                                                    <Grid ColumnDefinitions="180,*" Margin="0,3">
                                                        <TextBlock Grid.Column="0" Text="{Binding Label}" Foreground="{DynamicResource WbMuted}" VerticalAlignment="Center" />
                                                        <Panel Grid.Column="1">
                                                            <DatePicker IsVisible="{Binding IsDate}" HorizontalAlignment="Left" SelectedDate="{Binding DateValue}" />
                                                            <CheckBox IsVisible="{Binding IsBoolean}" IsChecked="{Binding BoolValue}" />
                                                            <TextBox IsVisible="{Binding IsMultiSelect}" Text="{Binding TextValue}" AcceptsReturn="True" Height="60" Watermark="{loc:Tr OneValuePerLine}" />
                                                            <TextBox IsVisible="{Binding IsSingleLine}" Text="{Binding TextValue}" Height="28" Padding="4,2" VerticalContentAlignment="Center" />
                                                        </Panel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Content="{loc:Tr Save}" Command="{Binding SaveInboxMaskCommand}" HorizontalAlignment="Right" Margin="0,4,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <GridSplitter Grid.Row="2" Background="{DynamicResource WbBorder}" ResizeDirection="Rows" HorizontalAlignment="Stretch"
                                      IsEnabled="{Binding !InboxMaskCollapsed}" />

                        <!-- Preview header -->
                        <Border Grid.Row="3" BorderBrush="{DynamicResource WbBorder}" BorderThickness="1,1,0,0">
                            <Grid ColumnDefinitions="*,Auto" Margin="12,6">
                                <TextBlock Grid.Column="0" Text="{loc:Tr MwPreview}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Command="{Binding ToggleInboxPreviewCommand}" ToolTip.Tip="{loc:Tr MwCollapseExpand}"><i:Icon Value="{Binding InboxPreviewCaret}" /></Button>
                            </Grid>
                        </Border>

                        <!-- Preview body (full parity: renditions, hit-overlay, find-in-document, click-to-copy) -->
                        <!-- Inbox preview — the same reusable surface as the Repositories pane; full-screen shows
                             the overlay below (ADR "Desktop preview full-screen toggle"). -->
                        <Border Grid.Row="4" BorderBrush="{DynamicResource WbBorder}" BorderThickness="1,0,0,0" IsVisible="{Binding !InboxPreviewCollapsed}">
                            <v:PreviewPane DataContext="{Binding InboxPreview}" />
                        </Border>
                    </Grid>
                </Grid>
                </DockPanel>

                    <!-- Full-screen preview overlay for the Inbox tab (its own InboxPreview, disconnected from Repositories). -->
                    <Border IsVisible="{Binding InboxPreview.PreviewFullscreen}" ZIndex="100" Background="{DynamicResource WbChrome}">
                        <v:PreviewPane DataContext="{Binding InboxPreview}" />
                    </Border>
                </Grid>
            </TabItem>

            <!-- Check-out (ADR "Document check-out / check-in"): the caller's checked-out documents + their
                 local working-copy status (repo SHA-256 vs the local file). Modified → Check in / Discard;
                 unchanged/missing → Unlock. Working copies live in the local `checkout` folder. -->
            <TabItem ToolTip.Tip="{loc:Tr TabCheckout}">
                <TabItem.Header>
                    <Panel>
                        <i:Icon Value="mdi-lock-outline" FontSize="20" />
                        <Border IsVisible="{Binding HasCheckouts}" Background="{DynamicResource WbAccent}" CornerRadius="8" MinWidth="16" Height="16"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-5,-9,0" Padding="4,0">
                            <TextBlock Text="{Binding CheckoutCount}" Foreground="{DynamicResource WbOnAccent}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Panel>
                </TabItem.Header>
                <!-- Outer grid so the preview full-screen overlay can cover the tab (tab strip stays reachable). -->
                <Grid>
                <DockPanel LastChildFill="True">

                <!-- The tab's own actions, in one place and in the same place the Inbox keeps its own (#500).
                     Refresh used to sit beside the heading and WebDAV in the bottom-left corner. -->
                <v:CheckoutRibbon DockPanel.Dock="Top" />

                <Grid Margin="14" ColumnDefinitions="*,10,1.15*">

                    <!-- Left column: what you hold locked, and what can be done with each. Same shape as the
                         Inbox tab, because it is the same kind of place — a staging area you also reach from
                         your file manager (ADR "The Check-out tab shows what you are about to check in"). -->
                    <Grid Grid.Column="0" RowDefinitions="Auto,*">
                        <!-- Heading over its own count, at the Inbox's type scale (#500). The count used to sit
                             at the bottom of the list, which is the one place the eye reaches last — and on a
                             long list, only after scrolling past everything it is counting. -->
                        <StackPanel Grid.Row="0" VerticalAlignment="Center" Margin="0,0,0,6">
                            <TextBlock Text="{loc:Tr CoHeader}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Checkout.Status}" Foreground="{DynamicResource WbFaint}" FontSize="11" />
                        </StackPanel>

                        <DockPanel Grid.Row="1" LastChildFill="True">
                        <TextBlock DockPanel.Dock="Top" IsVisible="{Binding !Checkout.HasItems}" TextWrapping="Wrap"
                                   Text="{loc:Tr MwCheckoutEmpty}"
                                   Foreground="{DynamicResource WbFaint}" />
                        <!-- No column headers, and icon buttons rather than labelled ones: the list is half the
                             window now, and the wide table this replaced pushed the document NAME off the left
                             edge — the one column nobody can do without. Path and expiry ride under the name;
                             everything else is a tooltip. Same shape as the Inbox list, for the same reason. -->
                        <ListBox x:Name="CheckoutList" ItemsSource="{Binding Checkout.Items}" SelectedItem="{Binding Checkout.SelectedRow}"
                                 SelectionMode="Multiple" SelectionChanged="OnCheckoutSelectionChanged"
                                 Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:CheckoutRowViewModel">
                                    <!-- The row, its indicators and its context menu are their own control
                                         (#521, #519): seven buttons per row were squeezing the document name
                                         off the left edge, and a row is a thing rather than a region. -->
                                    <v:CheckoutRow />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        </DockPanel>
                    </Grid>

                    <GridSplitter Grid.Column="1" Background="{DynamicResource WbBorder}" ResizeDirection="Columns" HorizontalAlignment="Stretch" />

                    <!-- Right column: index data (top) over the WORKING COPY's preview (bottom). Each is
                         resizable + collapsible, as on the Inbox tab. -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="{Binding Checkout.MaskHeight, Mode=TwoWay}" />
                            <RowDefinition Height="6" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="{Binding Checkout.PreviewHeight, Mode=TwoWay}" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" BorderBrush="{DynamicResource WbBorder}" BorderThickness="1,0,0,0">
                            <Grid ColumnDefinitions="*,Auto" Margin="12,6">
                                <TextBlock Grid.Column="0" Text="{Binding Checkout.DetailTitle}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Command="{Binding Checkout.ToggleMaskCommand}" ToolTip.Tip="{loc:Tr MwCollapseExpand}"><i:Icon Value="{Binding Checkout.MaskCaret}" /></Button>
                            </Grid>
                        </Border>

                        <!-- Index data is READ-ONLY here: it belongs to the archived document and is the same
                             either side of an edit. Editing it is the Repositories tab's job. -->
                        <Border Grid.Row="1" BorderBrush="{DynamicResource WbBorder}" BorderThickness="1,0,0,0" IsVisible="{Binding !Checkout.MaskCollapsed}">
                            <ScrollViewer>
                                <StackPanel Margin="12,4" Spacing="6">
                                    <TextBlock Text="{loc:Tr SelectDocDetail}" Foreground="{DynamicResource WbFaint}"
                                               TextWrapping="Wrap" IsVisible="{Binding !Checkout.SelectedRow}" />
                                    <ItemsControl ItemsSource="{Binding Checkout.IndexFields}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:IndexFieldViewModel">
                                                <Grid ColumnDefinitions="180,*" Margin="0,3">
                                                    <TextBlock Grid.Column="0" Text="{Binding FieldName}" Foreground="{DynamicResource WbMuted}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Values}" TextWrapping="Wrap" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <GridSplitter Grid.Row="2" Background="{DynamicResource WbBorder}" ResizeDirection="Rows" HorizontalAlignment="Stretch"
                                      IsEnabled="{Binding !Checkout.MaskCollapsed}" />

                        <Border Grid.Row="3" BorderBrush="{DynamicResource WbBorder}" BorderThickness="1,1,0,0">
                            <Grid ColumnDefinitions="*,Auto" Margin="12,6">
                                <TextBlock Grid.Column="0" Text="{loc:Tr CoWorkingCopyPreview}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Command="{Binding Checkout.TogglePreviewCommand}" ToolTip.Tip="{loc:Tr MwCollapseExpand}"><i:Icon Value="{Binding Checkout.PreviewCaret}" /></Button>
                            </Grid>
                        </Border>

                        <!-- The WORKING COPY, not the archived version. Showing the archived side here would
                             answer the opposite of the question this tab exists to answer. -->
                        <Border Grid.Row="4" BorderBrush="{DynamicResource WbBorder}" BorderThickness="1,0,0,0" IsVisible="{Binding !Checkout.PreviewCollapsed}">
                            <v:PreviewPane DataContext="{Binding Checkout.Preview}" />
                        </Border>
                    </Grid>
                </Grid>
                </DockPanel>

                    <Border IsVisible="{Binding Checkout.Preview.PreviewFullscreen}" ZIndex="100" Background="{DynamicResource WbChrome}">
                        <v:PreviewPane DataContext="{Binding Checkout.Preview}" />
                    </Border>
                </Grid>
            </TabItem>

            <TabItem AutomationProperties.AutomationId="tour:tab-search" ToolTip.Tip="{loc:Tr TabSearch}">
                <TabItem.Header><i:Icon Value="mdi-magnify" FontSize="20" /></TabItem.Header>
                <DockPanel LastChildFill="True">
                    <!-- The ribbon is its own control (review round after #530, superseding tranche 8's
                         buttons-beside-the-field): [search, save] | [go to], like every other tab. -->
                    <v:SearchRibbon DockPanel.Dock="Top" />
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="14,10,14,8">
                        <!-- The × clears the TEXT only, leaving filters and facets alone; "Reset search criteria"
                             below is the one that clears everything (#462). It hides itself when the box is
                             empty rather than sitting there inert. This used to be eleven lines of inline markup
                             here and nowhere else; it is now the shared behaviour every filter field gets (#503),
                             which is also what gave it the focus it never restored. -->
                        <TextBox Grid.Column="0" x:Name="SearchBox" Text="{Binding SearchQuery}" v:SearchField.Clearable="True"
                                 Watermark="{loc:Tr SearchPlaceholder}" KeyDown="OnSearchKeyDown" />
                        <ComboBox Grid.Column="1" Margin="8,0,0,0" Width="160" ItemsSource="{Binding SearchRepositories}"
                                  SelectedItem="{Binding SelectedSearchRepository}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:CompileBindings="False"><TextBlock Text="{Binding Name}" /></DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>

                    <!-- Saved searches (ADR "Saved searches"/"Scoped saved-search sharing") — click to restore + re-run.
                         Mine: the share button opens the scope dialog, ✕ removes. Others' shared searches are run-only. -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="4" Margin="14,0,14,8"
                                IsVisible="{Binding !!SavedSearches.Count}">
                        <TextBlock Text="{loc:Tr SearchSavedLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource WbMuted}" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <ItemsControl ItemsSource="{Binding SavedSearches}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:CompileBindings="False">
                                    <Border BorderBrush="{DynamicResource WbBorder}" BorderThickness="1" CornerRadius="10" Margin="0,0,4,4" Padding="2,0">
                                        <StackPanel Orientation="Horizontal">
                                            <i:Icon Value="mdi-earth" FontSize="11" Margin="4,0,0,0" VerticalAlignment="Center"
                                                    Foreground="{DynamicResource WbMuted}" IsVisible="{Binding IsEveryone}" ToolTip.Tip="{loc:Tr MwSharedEveryone}" />
                                            <i:Icon Value="mdi-account-group" FontSize="11" Margin="4,0,0,0" VerticalAlignment="Center"
                                                    Foreground="{DynamicResource WbMuted}" IsVisible="{Binding IsSpecific}" ToolTip.Tip="{loc:Tr MwSharedSpecific}" />
                                            <Button Content="{Binding Name}" Background="Transparent" BorderThickness="0" Padding="6,1" FontSize="12"
                                                    ToolTip.Tip="{Binding OwnerName, StringFormat='Shared by {0}'}"
                                                    Command="{ReflectionBinding $parent[ItemsControl].DataContext.RunSavedSearchCommand}" CommandParameter="{Binding}" />
                                            <Button Background="Transparent" BorderThickness="0" Padding="4,1" FontSize="11" Foreground="{DynamicResource WbMuted}"
                                                    IsVisible="{Binding IsMine}" ToolTip.Tip="{loc:Tr MwShare}"
                                                    Command="{ReflectionBinding $parent[ItemsControl].DataContext.ShareSavedSearchCommand}" CommandParameter="{Binding}">
                                                <i:Icon Value="mdi-share-variant" FontSize="11" />
                                            </Button>
                                            <Button Content="✕" Background="Transparent" BorderThickness="0" Padding="4,1" FontSize="11" Foreground="{DynamicResource WbMuted}"
                                                    IsVisible="{Binding IsMine}"
                                                    Command="{ReflectionBinding $parent[ItemsControl].DataContext.DeleteSavedSearchCommand}" CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <Expander DockPanel.Dock="Top" Header="{loc:Tr SearchFilters}" IsExpanded="{Binding FiltersExpanded}" Margin="14,0,14,8">
                        <StackPanel Spacing="6" Margin="0,6,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{loc:Tr VerColDocDate}" Width="100" VerticalAlignment="Center" Foreground="{DynamicResource WbMuted}" />
                                <DatePicker SelectedDate="{Binding DocDateFrom}" />
                                <DatePicker SelectedDate="{Binding DocDateTo}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{loc:Tr SysCreated}" Width="100" VerticalAlignment="Center" Foreground="{DynamicResource WbMuted}" />
                                <DatePicker SelectedDate="{Binding CreatedFrom}" />
                                <DatePicker SelectedDate="{Binding CreatedTo}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{loc:Tr SysCreatedBy}" Width="100" VerticalAlignment="Center" Foreground="{DynamicResource WbMuted}" />
                                <TextBox Width="220" Watermark="{loc:Tr FilterNameContains}" Text="{Binding CreatedByFilter}"
                                         v:SearchField.Clearable="True" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding FieldFilters}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:CompileBindings="False">
                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                                            <TextBlock Text="{loc:Tr FilterIndexField}" Width="100" VerticalAlignment="Center" Foreground="{DynamicResource WbMuted}" />
                                            <ComboBox Width="150" ItemsSource="{Binding FieldNames}" SelectedItem="{Binding FieldName}" />
                                            <ComboBox Width="120" ItemsSource="{Binding Operators}" SelectedItem="{Binding SelectedOperator}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:CompileBindings="False"><TextBlock Text="{Binding Label}" /></DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <DatePicker IsVisible="{Binding IsDate}" SelectedDate="{Binding DateValue}" />
                                            <CheckBox IsVisible="{Binding IsBoolean}" IsChecked="{Binding BooleanValue}" Content="true" VerticalAlignment="Center" />
                                            <TextBox IsVisible="{Binding IsTextLike}" Width="180" Watermark="{loc:Tr FilterValue}" Text="{Binding Value}"
                                                     v:SearchField.Clearable="True" />
                                            <!-- Not mdi-close: it now sits beside the in-field × that CLEARS the
                                                 value, and two identical glyphs an inch apart meaning "empty this"
                                                 and "delete this row" is a choice the user has to make twice. -->
                                            <Button ToolTip.Tip="{loc:Tr UgRemove}" VerticalAlignment="Center"
                                                    Command="{Binding DataContext.RemoveFieldFilterCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"><i:Icon Value="mdi-minus-circle-outline" /></Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="{loc:Tr AddIndexFilter}" Command="{Binding AddFieldFilterCommand}" IsEnabled="{Binding CanAddFieldFilter}" />
                                <!-- Clears everything entered — text, refinement filters and facet drill-downs.
                                     The old "Clear filters" left the facets applied, so results stayed narrowed
                                     by drill-downs no longer shown anywhere in the form (#462). -->

                            </StackPanel>
                        </StackPanel>
                    </Expander>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding SearchStatus}" Foreground="{DynamicResource WbFaint}" FontSize="12" Margin="0,0,0,8" />

                    <!-- Search facets (ADR "Search facets") — click a value to drill the results down. -->
                    <StackPanel DockPanel.Dock="Top" Spacing="3" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasFacetTypes}">
                            <TextBlock Text="{loc:Tr FacetType}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource WbMuted}" VerticalAlignment="Center" Width="70" />
                            <ItemsControl ItemsSource="{Binding FacetTypes}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FacetBucketViewModel">
                                        <Button Content="{Binding Display}" Padding="6,1" Margin="0,0,4,4" FontSize="12"
                                                FontWeight="{Binding IsSelected, Converter={x:Static vm:BoolToWeightConverter.Instance}}"
                                                Command="{ReflectionBinding $parent[ItemsControl].DataContext.ToggleFacetTypeCommand}" CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasFacetFileTypes}">
                            <TextBlock Text="{loc:Tr FacetFileType}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource WbMuted}" VerticalAlignment="Center" Width="70" />
                            <ItemsControl ItemsSource="{Binding FacetFileTypes}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FacetBucketViewModel">
                                        <Button Content="{Binding Display}" Padding="6,1" Margin="0,0,4,4" FontSize="12"
                                                FontWeight="{Binding IsSelected, Converter={x:Static vm:BoolToWeightConverter.Instance}}"
                                                Command="{ReflectionBinding $parent[ItemsControl].DataContext.ToggleFacetFileTypeCommand}" CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasFacetCreatedBy}">
                            <TextBlock Text="{loc:Tr SysCreatedBy}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource WbMuted}" VerticalAlignment="Center" Width="70" />
                            <ItemsControl ItemsSource="{Binding FacetCreatedBy}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FacetBucketViewModel">
                                        <Button Content="{Binding Display}" Padding="6,1" Margin="0,0,4,4" FontSize="12"
                                                FontWeight="{Binding IsSelected, Converter={x:Static vm:BoolToWeightConverter.Instance}}"
                                                Command="{ReflectionBinding $parent[ItemsControl].DataContext.ToggleFacetCreatedByCommand}" CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasFacetYears}">
                            <TextBlock Text="{loc:Tr FacetYear}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource WbMuted}" VerticalAlignment="Center" Width="70" />
                            <ItemsControl ItemsSource="{Binding FacetYears}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FacetBucketViewModel">
                                        <Button Content="{Binding Display}" Padding="6,1" Margin="0,0,4,4" FontSize="12"
                                                FontWeight="{Binding IsSelected, Converter={x:Static vm:BoolToWeightConverter.Instance}}"
                                                Command="{ReflectionBinding $parent[ItemsControl].DataContext.ToggleFacetYearCommand}" CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasFacetTags}">
                            <TextBlock Text="{loc:Tr TabTags}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource WbMuted}" VerticalAlignment="Center" Width="70" />
                            <ItemsControl ItemsSource="{Binding FacetTags}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FacetBucketViewModel">
                                        <Button Content="{Binding Display}" Padding="6,1" Margin="0,0,4,4" FontSize="12"
                                                FontWeight="{Binding IsSelected, Converter={x:Static vm:BoolToWeightConverter.Instance}}"
                                                Command="{ReflectionBinding $parent[ItemsControl].DataContext.ToggleFacetTagCommand}" CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <!-- Sensitivity facet (ADR "Sensitivity-label list badge + search facet"). -->
                        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasFacetSensitivity}">
                            <TextBlock Text="{loc:Tr BulkSensLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource WbMuted}" VerticalAlignment="Center" Width="70" />
                            <ItemsControl ItemsSource="{Binding FacetSensitivity}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FacetBucketViewModel">
                                        <Button Content="{Binding Display}" Padding="6,1" Margin="0,0,4,4" FontSize="12"
                                                FontWeight="{Binding IsSelected, Converter={x:Static vm:BoolToWeightConverter.Instance}}"
                                                Command="{ReflectionBinding $parent[ItemsControl].DataContext.ToggleFacetSensitivityCommand}" CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <!-- Per-Select-index-field facets (ADR "Search facet refinements"): one group per field. -->
                        <ItemsControl ItemsSource="{Binding FieldFacets}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:FieldFacetGroupViewModel">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource WbMuted}" VerticalAlignment="Center" Width="70" TextTrimming="CharacterEllipsis" />
                                        <ItemsControl ItemsSource="{Binding Buckets}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:FacetBucketViewModel">
                                                    <Button Content="{Binding Display}" Padding="6,1" Margin="0,0,4,4" FontSize="12"
                                                            FontWeight="{Binding IsSelected, Converter={x:Static vm:BoolToWeightConverter.Instance}}"
                                                            Command="{ReflectionBinding $parent[ItemsControl].DataContext.ToggleCommand}" CommandParameter="{Binding}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Results beside their preview (#462): selecting a result shows it, with the search terms
                         seeded so the hit overlay marks WHY it matched. The splitter is the same GridSplitter
                         the other tabs use, so the proportions behave the way the rest of the app does. -->
                    <Grid ColumnDefinitions="2*,Auto,3*" Margin="14,0,14,14">
                    <ListBox Grid.Column="0" ItemsSource="{Binding SearchResults}" SelectedItem="{Binding SelectedSearchResult}"
                             DoubleTapped="OnSearchResultDoubleTapped">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:SearchResultViewModel">
                                <!-- The per-row Go to button moved to the toolbar's document group (#530
                                     tranche 8, by decision) — #462's "a gesture cannot be the only route"
                                     still holds, the visible route is just the toolbar now. The context menu
                                     mirrors it per row. -->
                                <Grid ColumnDefinitions="Auto,*" Margin="0,3" Background="Transparent">
                                    <i:Icon Grid.Column="0" Value="{Binding IconValue}" Foreground="{DynamicResource WbMuted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" />
                                        <!-- Highlight snippet: <em> match tags → bold runs (ADR "Search result highlighting"). -->
                                        <TextBlock v:InlineHighlighter.Html="{Binding Highlight}" Foreground="{DynamicResource WbMuted}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                   IsVisible="{Binding Highlight, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                                        <TextBlock Text="{Binding Path}" Foreground="{DynamicResource WbFaint}" FontSize="11" />
                                    </StackPanel>
                                    <Grid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{loc:Tr MwPreview}" Click="OnSearchResultPreview">
                                                <MenuItem.Icon><i:Icon Value="mdi-eye-outline" /></MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="{loc:Tr SearchGoToDocument}" Click="OnSearchResultGoTo">
                                                <MenuItem.Icon><i:Icon Value="mdi-open-in-new" /></MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Grid.ContextMenu>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <GridSplitter Grid.Column="1" Width="6" Background="Transparent" ResizeDirection="Columns" />

                    <!-- Its OWN preview instance (SearchPreview), never the Repositories one: sharing a
                         JS/PDF-owning pane between tabs is the hazard ADR 0558 called out on the web side, and
                         the same reasoning applies here — the Inbox and Recycle bin each have their own too. -->
                    <v:PreviewPane Grid.Column="2" DataContext="{Binding SearchPreview}" />
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- Recycle bin (ADR "Desktop recycle bin parity", mirroring the web ADR 0329): a tenant-wide
                 master-detail — the list of soft-deleted documents on the left, and the same read-only detail
                 + preview + chat as the Repositories tab on the right (its own RecycleBin.Preview, never shared). -->
            <TabItem ToolTip.Tip="{loc:Tr TabRecycleBin}">
                <TabItem.Header><i:Icon Value="mdi-delete-outline" FontSize="20" /></TabItem.Header>
                <Grid>
                    <DockPanel LastChildFill="True">
                        <!-- The ribbon is its own control (#530 tranche 1), replacing the labeled header bar:
                             the tab strip already names the tab, and the actions take the Repositories shape. -->
                        <v:RecycleBinRibbon DockPanel.Dock="Top" />
                        <Grid Margin="12" ColumnDefinitions="1.6*,10,2.4*">
                            <!-- Master list: Name / Path / DeletedAt / DeletedBy + per-row Restore / Hard-delete. -->
                            <DockPanel Grid.Column="0" LastChildFill="True">
                                <TextBlock DockPanel.Dock="Bottom" Text="{Binding RecycleBin.Status}" Foreground="{DynamicResource WbFaint}" FontSize="12" Margin="2,6,0,0" />
                                <!-- No select-all and no checkbox column (#530 tranche 1): the list
                                     multi-selects natively, like every other tab. Header columns match
                                     RecycleBinRow's grid. -->
                                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,*,130,120" Margin="4,0,4,4">
                                    <TextBlock Grid.Column="0" Text="{loc:Tr Name}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource WbMuted}" />
                                    <TextBlock Grid.Column="1" Text="{loc:Tr RbColPath}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource WbMuted}" />
                                    <TextBlock Grid.Column="2" Text="{loc:Tr RbColDeleted}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource WbMuted}" />
                                    <TextBlock Grid.Column="3" Text="{loc:Tr VerColBy}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource WbMuted}" />
                                </Grid>
                                <ListBox x:Name="RecycleBinList" ItemsSource="{Binding RecycleBin.Items}" SelectedItem="{Binding RecycleBin.SelectedItem}"
                                         SelectionMode="Multiple" SelectionChanged="OnRecycleBinSelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:RecycleBinRowViewModel">
                                            <!-- The row, its columns and its context menu are their own control
                                                 (#530 tranche 1): the per-row buttons and their ReflectionBinding
                                                 reach-around are gone, and MainWindow.axaml may only shrink. -->
                                            <v:RecycleBinRow />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>

                            <GridSplitter Grid.Column="1" Background="{DynamicResource WbBorder}" ResizeDirection="Columns" />

                            <!-- Read-only detail: system fields + mask + index over (preview | chat). -->
                            <Panel Grid.Column="2">
                                <TextBlock Text="{loc:Tr MwSelectDeleted}" Foreground="{DynamicResource WbFaint}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !RecycleBin.HasSelection}" />
                                <Grid RowDefinitions="Auto,*" IsVisible="{Binding RecycleBin.HasSelection}">
                                    <ScrollViewer Grid.Row="0" MaxHeight="210" Padding="10,6">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{Binding RecycleBin.DetailTitle}" FontWeight="SemiBold" FontSize="15" />
                                            <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Tr Name}" Foreground="{DynamicResource WbMuted}" FontSize="12" />
                                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding RecycleBin.SysName}" FontSize="12" TextWrapping="Wrap" />
                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Tr SysFileExtension}" Foreground="{DynamicResource WbMuted}" FontSize="12" />
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RecycleBin.SysFileExtension}" FontSize="12" />
                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Tr VerColDocDate}" Foreground="{DynamicResource WbMuted}" FontSize="12" />
                                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RecycleBin.SysDocumentDate}" FontSize="12" />
                                                <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Tr SysCreated}" Foreground="{DynamicResource WbMuted}" FontSize="12" />
                                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding RecycleBin.SysCreated}" FontSize="12" />
                                                <TextBlock Grid.Row="4" Grid.Column="0" Text="{loc:Tr SysCreatedBy}" Foreground="{DynamicResource WbMuted}" FontSize="12" />
                                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding RecycleBin.SysCreatedBy}" FontSize="12" />
                                                <TextBlock Grid.Row="5" Grid.Column="0" Text="{loc:Tr SysOcrLanguages}" Foreground="{DynamicResource WbMuted}" FontSize="12"
                                                           IsVisible="{Binding RecycleBin.SysOcrLanguages, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding RecycleBin.SysOcrLanguages}" FontSize="12"
                                                           IsVisible="{Binding RecycleBin.SysOcrLanguages, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                                            </Grid>
                                            <TextBlock Text="{Binding RecycleBin.MaskLine}" Foreground="{DynamicResource WbMuted}" FontSize="12" Margin="0,4,0,0" />
                                            <ItemsControl ItemsSource="{Binding RecycleBin.IndexFields}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:IndexFieldViewModel">
                                                        <Grid ColumnDefinitions="110,*" Margin="0,1">
                                                            <TextBlock Grid.Column="0" Text="{Binding FieldName}" Foreground="{DynamicResource WbMuted}" FontSize="12" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Values}" FontSize="12" TextWrapping="Wrap" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </ScrollViewer>

                                    <Grid Grid.Row="1" ColumnDefinitions="3*,10,2*">
                                        <Border Grid.Column="0" BorderBrush="{DynamicResource WbBorder}" BorderThickness="0,1,0,0"
                                                IsVisible="{Binding !RecycleBin.Preview.PreviewFullscreen}">
                                            <v:PreviewPane DataContext="{Binding RecycleBin.Preview}" />
                                        </Border>
                                        <GridSplitter Grid.Column="1" Background="{DynamicResource WbBorder}" ResizeDirection="Columns" />
                                        <Border Grid.Column="2" BorderBrush="{DynamicResource WbBorder}" BorderThickness="1,1,0,0">
                                            <DockPanel LastChildFill="True">
                                                <TextBlock DockPanel.Dock="Top" Text="{loc:Tr CommentsHeader}" FontWeight="SemiBold" Margin="10,8" />
                                                <ScrollViewer>
                                                    <ItemsControl ItemsSource="{Binding RecycleBin.Comments}" Margin="10,0">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:ChatMessageViewModel">
                                                                <StackPanel Margin="0,6">
                                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                                <Button Classes="link" IsVisible="{Binding ShowAuthorLink}" Padding="0" FontSize="11"
                                                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ShowAuthorCardCommand}"
                                                                        CommandParameter="{Binding}" Content="{Binding AuthorName}">
                                                                    <!-- The identity card (ADR 0544). Clicking runs the command (which follows the
                                                                         advertised card href) and opens this flyout; it binds to the window VM, since
                                                                         only one card is open at a time. -->
                                                                    <Button.Flyout>
                                                                        <Flyout Placement="Bottom">
                                                                            <StackPanel MinWidth="220" Margin="4" Orientation="Horizontal" Spacing="12"
                                                                                        DataContext="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext)}">
                                                                                <Border IsVisible="{Binding AuthorCard, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                                                        Width="56" Height="56" CornerRadius="28" ClipToBounds="True"
                                                                                        Background="{DynamicResource WbChrome}">
                                                                                    <Panel>
                                                                                        <TextBlock Text="{Binding AuthorCard.Initials}" HorizontalAlignment="Center"
                                                                                                   VerticalAlignment="Center" FontSize="20"
                                                                                                   IsVisible="{Binding !AuthorCard.HasPhoto}" />
                                                                                        <Image Source="{Binding AuthorCard.PhotoImage}" Stretch="UniformToFill"
                                                                                               IsVisible="{Binding AuthorCard.HasPhoto}" />
                                                                                    </Panel>
                                                                                </Border>
                                                                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                                                                    <TextBlock Text="{Binding AuthorCard.DisplayName}" FontWeight="SemiBold" FontSize="13" />
                                                                                    <TextBlock Text="{Binding AuthorCard.Email}" Foreground="{DynamicResource WbMuted}" FontSize="12" />
                                                                                    <TextBlock Text="{loc:Tr UserCardDeactivated}" Foreground="{DynamicResource WbMuted}"
                                                                                               FontSize="11" IsVisible="{Binding !AuthorCard.IsActive}" />
                                                                                    <TextBlock Text="{loc:Tr UserCardLoadFailed}" Foreground="{DynamicResource WbMuted}"
                                                                                               FontSize="11" TextWrapping="Wrap" MaxWidth="200"
                                                                                               IsVisible="{Binding AuthorCardFailed}" />
                                                                                </StackPanel>
                                                                            </StackPanel>
                                                                        </Flyout>
                                                                    </Button.Flyout>
                                                                </Button>
                                                                <TextBlock IsVisible="{Binding ShowAuthorPlainName}" Text="{Binding AuthorName}"
                                                                           Foreground="{DynamicResource WbFaint}" FontSize="11" />
                                                                <TextBlock Text="{Binding Timestamp}" Foreground="{DynamicResource WbFaint}" FontSize="11" />
                                                            </StackPanel>
                                                                    <TextBlock Text="{Binding DisplayBody}" TextWrapping="Wrap" FontSize="13" IsVisible="{Binding IsUserPost}" />
                                                            <!-- An automatic entry (ADR 0545): the sentence, then the
                                                                 version block with its icon and optional comment. -->
                                                            <TextBlock Text="{Binding SystemSentence}" TextWrapping="Wrap" FontSize="13"
                                                                       FontStyle="Italic" Foreground="{DynamicResource WbMuted}"
                                                                       IsVisible="{Binding IsSystemEntry}" />
                                                            <Border IsVisible="{Binding HasVersionEntry}" Margin="0,3,0,0" Padding="6,3"
                                                                    BorderBrush="{DynamicResource WbBorder}" BorderThickness="2,0,0,0">
                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                    
                                                                    <StackPanel Spacing="1">
                                                                        <TextBlock Text="{Binding VersionLabel}" FontSize="11" />
                                                                        <TextBlock Text="{Binding VersionCommentText}" FontSize="11" TextWrapping="Wrap"
                                                                                   Foreground="{DynamicResource WbMuted}"
                                                                                   IsVisible="{Binding HasVersionComment}" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </Border>
                                                                    <ItemsControl ItemsSource="{Binding Replies}" Margin="16,4,0,0">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate x:DataType="vm:ChatMessageViewModel">
                                                                                <Border BorderBrush="{DynamicResource WbBorder}" BorderThickness="2,0,0,0" Padding="8,2" Margin="0,3">
                                                                                    <StackPanel>
                                                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                                <Button Classes="link" IsVisible="{Binding ShowAuthorLink}" Padding="0" FontSize="11"
                                                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ShowAuthorCardCommand}"
                                                                        CommandParameter="{Binding}" Content="{Binding AuthorName}">
                                                                    <!-- The identity card (ADR 0544). Clicking runs the command (which follows the
                                                                         advertised card href) and opens this flyout; it binds to the window VM, since
                                                                         only one card is open at a time. -->
                                                                    <Button.Flyout>
                                                                        <Flyout Placement="Bottom">
                                                                            <StackPanel MinWidth="220" Margin="4" Orientation="Horizontal" Spacing="12"
                                                                                        DataContext="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext)}">
                                                                                <Border IsVisible="{Binding AuthorCard, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                                                        Width="56" Height="56" CornerRadius="28" ClipToBounds="True"
                                                                                        Background="{DynamicResource WbChrome}">
                                                                                    <Panel>
                                                                                        <TextBlock Text="{Binding AuthorCard.Initials}" HorizontalAlignment="Center"
                                                                                                   VerticalAlignment="Center" FontSize="20"
                                                                                                   IsVisible="{Binding !AuthorCard.HasPhoto}" />
                                                                                        <Image Source="{Binding AuthorCard.PhotoImage}" Stretch="UniformToFill"
                                                                                               IsVisible="{Binding AuthorCard.HasPhoto}" />
                                                                                    </Panel>
                                                                                </Border>
                                                                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                                                                    <TextBlock Text="{Binding AuthorCard.DisplayName}" FontWeight="SemiBold" FontSize="13" />
                                                                                    <TextBlock Text="{Binding AuthorCard.Email}" Foreground="{DynamicResource WbMuted}" FontSize="12" />
                                                                                    <TextBlock Text="{loc:Tr UserCardDeactivated}" Foreground="{DynamicResource WbMuted}"
                                                                                               FontSize="11" IsVisible="{Binding !AuthorCard.IsActive}" />
                                                                                    <TextBlock Text="{loc:Tr UserCardLoadFailed}" Foreground="{DynamicResource WbMuted}"
                                                                                               FontSize="11" TextWrapping="Wrap" MaxWidth="200"
                                                                                               IsVisible="{Binding AuthorCardFailed}" />
                                                                                </StackPanel>
                                                                            </StackPanel>
                                                                        </Flyout>
                                                                    </Button.Flyout>
                                                                </Button>
                                                                <TextBlock IsVisible="{Binding ShowAuthorPlainName}" Text="{Binding AuthorName}"
                                                                           Foreground="{DynamicResource WbFaint}" FontSize="11" />
                                                                <TextBlock Text="{Binding Timestamp}" Foreground="{DynamicResource WbFaint}" FontSize="11" />
                                                            </StackPanel>
                                                                                        <TextBlock Text="{Binding DisplayBody}" TextWrapping="Wrap" FontSize="13" IsVisible="{Binding IsUserPost}" />
                                                            <!-- An automatic entry (ADR 0545): the sentence, then the
                                                                 version block with its icon and optional comment. -->
                                                            <TextBlock Text="{Binding SystemSentence}" TextWrapping="Wrap" FontSize="13"
                                                                       FontStyle="Italic" Foreground="{DynamicResource WbMuted}"
                                                                       IsVisible="{Binding IsSystemEntry}" />
                                                            <Border IsVisible="{Binding HasVersionEntry}" Margin="0,3,0,0" Padding="6,3"
                                                                    BorderBrush="{DynamicResource WbBorder}" BorderThickness="2,0,0,0">
                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                    
                                                                    <StackPanel Spacing="1">
                                                                        <TextBlock Text="{Binding VersionLabel}" FontSize="11" />
                                                                        <TextBlock Text="{Binding VersionCommentText}" FontSize="11" TextWrapping="Wrap"
                                                                                   Foreground="{DynamicResource WbMuted}"
                                                                                   IsVisible="{Binding HasVersionComment}" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </Border>
                                                                                    </StackPanel>
                                                                                </Border>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </DockPanel>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Panel>
                        </Grid>
                    </DockPanel>

                    <!-- Full-screen preview overlay for the Recycle bin tab (its own preview surface). -->
                    <Border IsVisible="{Binding RecycleBin.Preview.PreviewFullscreen}" ZIndex="100" Background="{DynamicResource WbChrome}">
                        <v:PreviewPane DataContext="{Binding RecycleBin.Preview}" />
                    </Border>
                </Grid>
            </TabItem>

            <TabItem ToolTip.Tip="{loc:Tr TabTasks}">
                <TabItem.Header>
                    <Panel>
                        <i:Icon Value="mdi-clipboard-check-outline" FontSize="20" />
                        <!-- Pending-task count badge (ADR "Workflow / document state model", 0009). -->
                        <Border IsVisible="{Binding HasTasks}" Background="#e53935" CornerRadius="8" MinWidth="16" Height="16"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-5,-9,0" Padding="4,0">
                            <TextBlock Text="{Binding TaskCount}" Foreground="White" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Panel>
                </TabItem.Header>
                <DockPanel LastChildFill="True" Margin="8">
                    <!-- The ribbon in the Repositories shape (#530 tranche 3); the "My review tasks" text
                         header it replaces said what the tab strip already says. -->
                    <v:TaskRibbon DockPanel.Dock="Top" />
                    <TextBlock DockPanel.Dock="Top" Text="{loc:Tr TasksEmpty}" Margin="0,8"
                               Foreground="{DynamicResource WbFaint}" IsVisible="{Binding !HasTasks}" />
                    <Border BorderBrush="{DynamicResource WbBorder}" BorderThickness="1" Margin="0,8,0,0"
                            MaxWidth="820" HorizontalAlignment="Left" VerticalAlignment="Top" IsVisible="{Binding HasTasks}">
                        <DockPanel LastChildFill="True">
                            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,110,90,150" Background="{DynamicResource WbChrome}">
                                <TextBlock Grid.Column="0" Text="{loc:Tr ColDocument}" FontWeight="SemiBold" Margin="6,4" />
                                <TextBlock Grid.Column="1" Text="{loc:Tr WorkflowStatus}" FontWeight="SemiBold" Margin="6,4" />
                                <TextBlock Grid.Column="2" Text="{loc:Tr VerColVersion}" FontWeight="SemiBold" Margin="6,4" />
                                <TextBlock Grid.Column="3" Text="{loc:Tr ColAssigned}" FontWeight="SemiBold" Margin="6,4" />
                            </Grid>
                            <ScrollViewer>
                                <ListBox ItemsSource="{Binding Tasks}" SelectedItem="{Binding SelectedTaskRow}"
                                         Background="Transparent" BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:TaskItemViewModel">
                                            <!-- The row and its menu are their own control (#530 tranche 3). -->
                                            <v:TaskRow />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </DockPanel>
            </TabItem>

            <!-- Users & groups administration (ADR "Users & groups administration tab"). Shown only to a
                 CanManageUsers holder (whoami). Combined principal list | assignable rights matrix. -->
            <TabItem ToolTip.Tip="{loc:Tr TabUsersGroups}" IsVisible="{Binding CanManageUsers}">
                <TabItem.Header><i:Icon Value="mdi-account-cog" FontSize="20" /></TabItem.Header>
                <DockPanel LastChildFill="True">
                    <!-- The ribbon is its own control, spanning the tab like every converted tab's
                         (#530 tranche 4) — it replaces the mini-toolbar that sat inside the list column. -->
                    <v:PrincipalRibbon DockPanel.Dock="Top" />
                    <Grid ColumnDefinitions="300,*">
                        <ListBox Grid.Column="0" ItemsSource="{Binding Principals}" SelectedItem="{Binding SelectedPrincipal}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:PrincipalRowViewModel">
                                    <!-- The row and its menu are their own control (#530 tranche 4). -->
                                    <v:PrincipalRow />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    <Border Grid.Column="1" BorderBrush="{DynamicResource WbBorder}" BorderThickness="1,0,0,0">
                        <Panel>
                            <TextBlock IsVisible="{Binding !HasSelectedPrincipal}" Text="{loc:Tr UgSelectPrincipal}"
                                       Foreground="{DynamicResource WbFaint}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <DockPanel Margin="16" IsVisible="{Binding HasSelectedPrincipal}" LastChildFill="True">
                                <!-- Edit lives ribbon-style in the pane's upper-right; Save/Cancel take its slot
                                     while editing (ADR 0550 — the commit controls sit where the pencil was). -->
                                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                                    <TextBlock Grid.Column="0" Text="{Binding PrincipalRightsHeader}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                        <Button Command="{Binding BeginRightsEditCommand}" ToolTip.Tip="{loc:Tr Edit}"
                                                IsVisible="{Binding !UgEditingRights}" IsEnabled="{Binding !UgBusy}"><i:Icon Value="mdi-pencil" FontSize="18" /></Button>
                                        <Button Command="{Binding SaveRightsCommand}" ToolTip.Tip="{loc:Tr Save}"
                                                IsVisible="{Binding UgEditingRights}" IsEnabled="{Binding !UgBusy}"><i:Icon Value="mdi-content-save" FontSize="18" /></Button>
                                        <Button Command="{Binding CancelRightsEditCommand}" ToolTip.Tip="{loc:Tr Cancel}"
                                                IsVisible="{Binding UgEditingRights}" IsEnabled="{Binding !UgBusy}"><i:Icon Value="mdi-close" FontSize="18" /></Button>
                                    </StackPanel>
                                </Grid>
                                <TextBlock DockPanel.Dock="Top" IsVisible="{Binding SelectedPrincipalIsGroup}" TextWrapping="Wrap"
                                           Text="{loc:Tr UgGroupRightsNote}"
                                           Foreground="{DynamicResource WbFaint}" FontSize="11" Margin="0,0,0,8" />
                                <!-- Group membership (ADR "Group membership editing") — direct members with a
                                     searchable add-picker. -->
                                <StackPanel DockPanel.Dock="Top" IsVisible="{Binding SelectedPrincipalIsGroup}" Spacing="6" Margin="0,0,0,10">
                                    <TextBlock Text="{loc:Tr UgMembers}" FontWeight="SemiBold" />
                                    <AutoCompleteBox ItemsSource="{Binding MemberCandidates}" SelectedItem="{Binding SelectedMemberToAdd}"
                                                     Watermark="{loc:Tr UgAddMember}" FilterMode="ContainsOrdinal" MinimumPrefixLength="0"
                                                     ValueMemberBinding="{Binding DisplayName}" Width="320" HorizontalAlignment="Left">
                                        <AutoCompleteBox.ItemTemplate>
                                            <DataTemplate x:CompileBindings="False"><TextBlock Text="{Binding DisplayName}" /></DataTemplate>
                                        </AutoCompleteBox.ItemTemplate>
                                    </AutoCompleteBox>
                                    <TextBlock Text="{loc:Tr UgNoMembers}" Foreground="{DynamicResource WbFaint}" FontSize="11"
                                               IsVisible="{Binding !HasGroupMembers}" />
                                    <ItemsControl ItemsSource="{Binding GroupMembers}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:CompileBindings="False">
                                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,1">
                                                    <i:Icon Value="mdi-account" Foreground="{DynamicResource WbMuted}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" Width="240" TextTrimming="CharacterEllipsis" />
                                                    <Button Padding="4,0" ToolTip.Tip="{loc:Tr UgRemoveMember}"
                                                            Command="{Binding DataContext.RemoveMemberCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"><i:Icon Value="mdi-close" Foreground="#e53935" /></Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <!-- Profile photo (users only) — ADR "User profile photo". -->
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="0,0,0,12"
                                            IsVisible="{Binding SelectedPrincipalIsUser}">
                                    <Border Width="56" Height="56" CornerRadius="28" ClipToBounds="True" Background="{DynamicResource WbAccentTint}">
                                        <Panel>
                                            <TextBlock Text="{Binding SelectedPrincipalInitials}" Foreground="{DynamicResource WbAccentText}" FontSize="20" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasSelectedPrincipalPhoto}" />
                                            <Image Source="{Binding SelectedPrincipalPhoto}" Stretch="UniformToFill" IsVisible="{Binding HasSelectedPrincipalPhoto}" />
                                        </Panel>
                                    </Border>
                                    <StackPanel Orientation="Vertical" Spacing="6" VerticalAlignment="Center">
                                        <Button Content="{loc:Tr AccountChangePhoto}" Click="OnChangePrincipalPhoto" />
                                        <Button Content="{loc:Tr UgRemove}" Click="OnRemovePrincipalPhoto" IsVisible="{Binding HasSelectedPrincipalPhoto}" />
                                        <!-- Admin password reset — ADR "User password management". -->
                                        <Button Content="{loc:Tr UgResetPassword}" Click="OnResetPrincipalPassword" />
                                        <!-- Two-factor status + admin reset — ADR "MFA (interactive login, TOTP)". -->
                                        <TextBlock Text="{Binding SelectedPrincipalMfaStatus}" Foreground="{DynamicResource WbMuted}" VerticalAlignment="Center" />
                                        <Button Content="{loc:Tr UgResetMfa}" Click="OnResetPrincipalMfa" IsVisible="{Binding CanResetSelectedPrincipalMfa}" />
                                        <!-- Impersonate a non-admin user — ADR "User impersonation". -->
                                        <Button Content="{loc:Tr UgImpersonate}" Click="OnImpersonatePrincipal" IsVisible="{Binding CanImpersonateSelectedPrincipal}" />
                                    </StackPanel>
                                </StackPanel>
                                <ScrollViewer>
                                    <StackPanel>
                                        <ItemsControl ItemsSource="{Binding PrincipalRights}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:PrincipalRightViewModel">
                                                    <CheckBox IsChecked="{Binding IsChecked}" Content="{Binding Label}" Margin="0,1"
                                                              IsEnabled="{ReflectionBinding $parent[ItemsControl].DataContext.UgEditingRights}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <!-- Sensitivity clearance (ADR "Sensitivity clearance enforcement") — the highest label rank this principal may access. -->
                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,10,0,0">
                                            <TextBlock Text="{loc:Tr MwClearanceLabel}" VerticalAlignment="Center" Foreground="{DynamicResource WbMuted}" />
                                            <ComboBox MinWidth="220"
                                                      ItemsSource="{Binding ClearanceOptions}"
                                                      SelectedValue="{Binding SelectedPrincipalClearance}"
                                                      SelectedValueBinding="{ReflectionBinding Rank}"
                                                      IsEnabled="{Binding UgEditingRights}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{ReflectionBinding Label}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </DockPanel>
                        </Panel>
                    </Border>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- Audit log (ADR "Desktop audit viewer") — visible only for a CanViewAuditLog holder. -->
            <TabItem AutomationProperties.AutomationId="tour:tab-audit" ToolTip.Tip="{loc:Tr TabAudit}" IsVisible="{Binding CanViewAuditLog}">
                <TabItem.Header><i:Icon Value="mdi-history" FontSize="20" /></TabItem.Header>
                <DockPanel LastChildFill="True" Margin="8">
                    <!-- The ribbon is its own control (#530 tranche 9, by decision): export, the verify pair,
                         purge — superseding the old text-only bar. Apply/Clear stay with the filter form. -->
                    <v:AuditRibbon DockPanel.Dock="Top" />

                    <!-- Retention first, by decision: read-only with a pencil; Save/Cancel appear in the same
                         row the pencil started the edit in (ADR 0550). Purge moved to the ribbon. -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,8,0,6" VerticalAlignment="Center">
                        <i:Icon Value="mdi-delete-clock-outline" VerticalAlignment="Center" />
                        <TextBlock Text="{loc:Tr AuditRetentionLabel}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding AuditRetentionDays}" VerticalAlignment="Center" IsVisible="{Binding !AuditRetentionEditing}" />
                        <Border Classes="ribbon" IsVisible="{Binding IsTenantAdmin}">
                            <Button AutomationProperties.AutomationId="audit-ret-edit" Command="{Binding BeginAuditRetentionEditCommand}"
                                    IsVisible="{Binding !AuditRetentionEditing}" ToolTip.Tip="{loc:Tr Edit}"><i:Icon Value="mdi-pencil" FontSize="16" /></Button>
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding AuditRetentionEditing}">
                            <TextBox Text="{Binding AuditRetentionDays}" Width="80" />
                            <TextBlock Text="{loc:Tr AuditRetentionDaysHint}" Foreground="{DynamicResource WbMuted}" FontSize="12" VerticalAlignment="Center" />
                            <Button Content="{loc:Tr Save}" Command="{Binding SaveAuditRetentionEditCommand}" />
                            <Button Content="{loc:Tr Cancel}" Command="{Binding CancelAuditRetentionEditCommand}" />
                        </StackPanel>
                        <TextBlock Text="{Binding AuditRetentionNote}" Foreground="{DynamicResource WbMuted}" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- filter bar — the form keeps its shape; Apply/Clear wear the ribbon-button style, by
                         decision (the ghost scope is the Border.ribbon wrapper). -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
                        <TextBox Watermark="{loc:Tr MwAuditActionPh}" Text="{Binding AuditActionFilter}" Width="230"
                                 v:SearchField.Clearable="True" />
                        <DatePicker SelectedDate="{Binding AuditFrom}" />
                        <DatePicker SelectedDate="{Binding AuditTo}" />
                        <Border Classes="ribbon">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Button AutomationProperties.AutomationId="audit-apply" Command="{Binding RunAuditSearchCommand}"
                                        ToolTip.Tip="{loc:Tr Apply}"><i:Icon Value="mdi-filter-check-outline" FontSize="18" /></Button>
                                <Button AutomationProperties.AutomationId="audit-clear" Command="{Binding ClearAuditFiltersCommand}"
                                        ToolTip.Tip="{loc:Tr AuditClear}"><i:Icon Value="mdi-filter-remove-outline" FontSize="18" /></Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- load more -->
                    <Button DockPanel.Dock="Bottom" Content="{loc:Tr LoadMore}" HorizontalAlignment="Center" Margin="0,6,0,0"
                            IsVisible="{Binding AuditHasMore}" Command="{Binding LoadMoreAuditCommand}" />

                    <!-- newest-first table -->
                    <Border BorderBrush="{DynamicResource WbBorder}" BorderThickness="1">
                        <DockPanel LastChildFill="True">
                            <Grid DockPanel.Dock="Top" ColumnDefinitions="170,190,170,2*,3*" Background="{DynamicResource WbChrome}">
                                <TextBlock Grid.Column="0" Text="{loc:Tr AuditColWhen}" FontWeight="SemiBold" Margin="6,4" />
                                <TextBlock Grid.Column="1" Text="{loc:Tr AuditColActor}" FontWeight="SemiBold" Margin="6,4" />
                                <TextBlock Grid.Column="2" Text="{loc:Tr AuditActionLabel}" FontWeight="SemiBold" Margin="6,4" />
                                <TextBlock Grid.Column="3" Text="{loc:Tr AuditColTarget}" FontWeight="SemiBold" Margin="6,4" />
                                <TextBlock Grid.Column="4" Text="{loc:Tr AuditColDetails}" FontWeight="SemiBold" Margin="6,4" />
                            </Grid>
                            <ScrollViewer>
                                <ItemsControl ItemsSource="{Binding AuditEvents}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:AuditEventRowViewModel">
                                            <Border BorderBrush="{DynamicResource WbBorder}" BorderThickness="0,0,0,1">
                                                <Grid ColumnDefinitions="170,190,170,2*,3*">
                                                    <TextBlock Grid.Column="0" Text="{Binding When}" Margin="6,3" FontSize="12" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Actor}" Margin="6,3" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Action}" Margin="6,3" FontSize="12" />
                                                    <TextBlock Grid.Column="3" Text="{Binding Target}" Margin="6,3" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="4" Text="{Binding Details}" Margin="6,3" FontSize="12" Foreground="{DynamicResource WbMuted}" TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </DockPanel>
            </TabItem>

            <!-- Legal holds (ADR "Legal hold & retention enforcement") — visible only for a CanLegalHold holder. -->
            <TabItem ToolTip.Tip="{loc:Tr TabLegalHolds}" IsVisible="{Binding CanLegalHold}">
                <TabItem.Header><i:Icon Value="mdi-gavel" FontSize="20" /></TabItem.Header>
                <DockPanel LastChildFill="True" Margin="8">
                    <!-- The ribbon is its own control (#530 tranche 5); Release moved into it (and each row's
                         context menu) from the detail-pane header, by decision. -->
                    <v:LegalHoldRibbon DockPanel.Dock="Top" />
                    <Grid ColumnDefinitions="300,*" Margin="0,8,0,0">
                        <ListBox Grid.Column="0" ItemsSource="{Binding LegalHolds}" SelectedItem="{Binding SelectedLegalHold}"
                                 BorderBrush="{DynamicResource WbBorder}" BorderThickness="1">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:LegalHoldRowViewModel">
                                    <!-- The row and its menu are their own control (#530 tranche 5). -->
                                    <v:LegalHoldRow />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <DockPanel Grid.Column="1" Margin="10,0,0,0" LastChildFill="True" IsVisible="{Binding HasSelectedHold}">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                                <TextBlock Text="{Binding SelectedLegalHold.Name}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{loc:Tr MwDocuments}" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <ScrollViewer>
                                <ListBox ItemsSource="{Binding SelectedHoldItems}" SelectedItem="{Binding SelectedHoldItem}"
                                         DoubleTapped="OnGoToHoldItem" Background="Transparent" BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:LegalHoldItemRowViewModel">
                                            <!-- The row and its menu are their own control (the #530 recipe). -->
                                            <v:LegalHoldItemRow />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </ScrollViewer>
                        </DockPanel>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- Retention schedule (ADR "Retention policies (auto-disposition)") — visible for a CanManageClassification holder. -->
            <TabItem ToolTip.Tip="{loc:Tr TabRetention}" IsVisible="{Binding CanManageClassification}">
                <TabItem.Header><i:Icon Value="mdi-calendar-remove-outline" FontSize="20" /></TabItem.Header>
                <DockPanel LastChildFill="True" Margin="8">
                    <!-- The ribbon is its own control (#530 tranche 2); the tenant's disposition-mode
                         description is information, not an action, so it stays as a line beneath it. -->
                    <v:RetentionRibbon DockPanel.Dock="Top" />
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,6,0,6">
                        <TextBlock Text="{loc:Tr MwRetDescAuto}"
                                   Foreground="{DynamicResource WbMuted}" VerticalAlignment="Center" TextWrapping="Wrap"
                                   IsVisible="{Binding !RetentionRequiresReview}" />
                        <TextBlock Text="{loc:Tr MwRetDescReview}"
                                   Foreground="{DynamicResource WbMuted}" VerticalAlignment="Center" TextWrapping="Wrap"
                                   IsVisible="{Binding RetentionRequiresReview}" />
                    </StackPanel>
                    <Border BorderBrush="{DynamicResource WbBorder}" BorderThickness="1">
                        <DockPanel LastChildFill="True">
                            <Grid DockPanel.Dock="Top" ColumnDefinitions="3*,110,170,180" Background="{DynamicResource WbChrome}">
                                <TextBlock Grid.Column="0" Text="{loc:Tr ColDocument}" FontWeight="SemiBold" Margin="6,4" />
                                <TextBlock Grid.Column="1" Text="{loc:Tr TabRetention}" FontWeight="SemiBold" Margin="6,4" />
                                <TextBlock Grid.Column="2" Text="{loc:Tr RetColDisposition}" FontWeight="SemiBold" Margin="6,4" />
                                <TextBlock Grid.Column="3" Text="{loc:Tr WorkflowStatus}" FontWeight="SemiBold" Margin="6,4" />
                            </Grid>
                            <ScrollViewer>
                                <ListBox ItemsSource="{Binding RetentionItems}" SelectedItem="{Binding SelectedRetentionRow}"
                                         Background="Transparent" BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:RetentionRowViewModel">
                                            <!-- The row, its columns and its context menu are their own control
                                                 (#530 tranche 2); the ribbon acts on the selection. -->
                                            <v:RetentionRow />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </DockPanel>
            </TabItem>

            <!-- Tenant-admin self-service settings (ADR "Tenant-admin settings tab") — visible for a tenant admin. -->
            <TabItem ToolTip.Tip="{loc:Tr TabTenant}" IsVisible="{Binding IsTenantAdmin}">
                <TabItem.Header><i:Icon Value="mdi-office-building-cog-outline" FontSize="20" /></TabItem.Header>
                <!-- The whole body is its own control (#530 tranche 10): ribbon, reference card first, then
                     the per-group settings with per-group pencils. -->
                <v:TenantSettingsPane />
            </TabItem>

            <!-- My work dashboard (ADR "My work dashboard") — added last to avoid re-indexing the other tabs. -->
            <TabItem ToolTip.Tip="{loc:Tr TabMyWork}">
                <TabItem.Header><i:Icon Value="mdi-view-dashboard-outline" FontSize="20" /></TabItem.Header>
                <ScrollViewer Margin="14">
                    <StackPanel Spacing="6" MaxWidth="640" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{loc:Tr TabMyWork}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <!-- The header stays, by decision (#530 tranche 7) — a dashboard keeps its title;
                                 only refresh takes the ribbon-button look (Border.ribbon scopes the ghost
                                 style), and the desktop GAINS it: the web had one, this tab did not
                                 (ADR 0511 parity). -->
                            <Border Classes="ribbon">
                                <Button Command="{Binding RefreshMyWorkCommand}" ToolTip.Tip="{loc:Tr RibbonRefresh}"><i:Icon Value="mdi-refresh" FontSize="18" /></Button>
                            </Border>
                        </StackPanel>

                        <TextBlock Text="{loc:Tr MyWorkReminders}" FontWeight="SemiBold" Margin="0,8,0,2" />
                        <TextBlock Text="{loc:Tr MyWorkNothingDue}" Foreground="{DynamicResource WbMuted}" IsVisible="{Binding !DashboardReminders.Count}" />
                        <ItemsControl ItemsSource="{Binding DashboardReminders}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="svc:SimplArchiveApiClient+DashReminderInfo">
                                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Padding="2"
                                            Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).OpenDashboardReminderCommand}" CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <i:Icon Value="mdi-alarm" FontSize="16" />
                                            <TextBlock Text="{Binding DocumentName}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding RemindAt, StringFormat='{}{0:g}'}" Foreground="{DynamicResource WbMuted}" />
                                            <TextBlock Text="{loc:Tr MwOverdue}" Foreground="#c62828" IsVisible="{Binding Overdue}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{loc:Tr MyWorkFollowing}" FontWeight="SemiBold" Margin="0,10,0,2" />
                        <TextBlock Text="{loc:Tr MyWorkNotFollowing}" Foreground="{DynamicResource WbMuted}" IsVisible="{Binding !DashboardFollowing.Count}" />
                        <ItemsControl ItemsSource="{Binding DashboardFollowing}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="svc:SimplArchiveApiClient+DashFollowedInfo">
                                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Padding="2"
                                            Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).OpenDashboardFollowedCommand}" CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <i:Icon Value="mdi-bell" FontSize="16" />
                                            <TextBlock Text="{Binding DocumentName}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{loc:Tr MyWorkReviewTasks}" FontWeight="SemiBold" Margin="0,10,0,2" />
                        <TextBlock Text="{loc:Tr MyWorkNoReview}" Foreground="{DynamicResource WbMuted}" IsVisible="{Binding !Tasks.Count}" />
                        <ItemsControl ItemsSource="{Binding Tasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:TaskItemViewModel">
                                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Padding="2"
                                            Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).OpenTaskCommand}" CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <i:Icon Value="mdi-clipboard-check-outline" FontSize="16" />
                                            <TextBlock Text="{Binding DocumentName}" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tag catalog (ADR "Tag controlled vocabulary") — added last to avoid re-indexing the other tabs. -->
            <TabItem ToolTip.Tip="{loc:Tr TabTags}" IsVisible="{Binding IsTenantAdmin}">
                <TabItem.Header><i:Icon Value="mdi-tag-multiple-outline" FontSize="20" /></TabItem.Header>
                <DockPanel LastChildFill="True" Margin="8">
                    <!-- The ribbon is its own control (#530 tranche 6); + replaced the inline create form and
                         the "Tag catalog" header said what the tab strip already says. The catalog
                         description is information, not an action — its own line beneath. -->
                    <v:TagRibbon DockPanel.Dock="Top" />
                    <TextBlock DockPanel.Dock="Top" Text="{loc:Tr MwTagCatalogDesc}" Margin="0,8,0,0"
                               Foreground="{DynamicResource WbMuted}" TextWrapping="Wrap" MaxWidth="720" HorizontalAlignment="Left" />
                    <Border BorderBrush="{DynamicResource WbBorder}" BorderThickness="1" Margin="0,8,0,0"
                            MaxWidth="520" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <ScrollViewer>
                            <ListBox ItemsSource="{Binding TagCatalogAdmin}" SelectedItem="{Binding SelectedTagRow}"
                                     Background="Transparent" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TagCatalogRow">
                                        <!-- The row and its menu are their own control (#530 tranche 6). -->
                                        <v:TagRow />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </ScrollViewer>
                    </Border>
                </DockPanel>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
