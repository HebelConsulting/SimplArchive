<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:SimplArchive.DesktopClient.Localization"
        xmlns:views="using:SimplArchive.DesktopClient.Views"
        x:Class="SimplArchive.DesktopClient.Views.ProfilePhotoDialog"
        Title="{loc:Tr PpTitle}" Width="440" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
    <!-- A window around ProfilePhotoEditor. The crop itself moved into that control so "Edit profile" can host
         it inline (#464); this dialog remains for the admin path that sets another principal's photo. -->
    <StackPanel Margin="16" Spacing="12">
        <views:ProfilePhotoEditor x:Name="Editor" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="{loc:Tr Cancel}" Click="OnCancel" IsCancel="True" />
            <Button x:Name="SaveButton" Content="{loc:Tr Save}" Click="OnSave" IsDefault="True" IsEnabled="False" />
        </StackPanel>
    </StackPanel>
</Window>
