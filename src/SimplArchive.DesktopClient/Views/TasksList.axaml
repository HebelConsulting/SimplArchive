<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SimplArchive.DesktopClient.ViewModels"
             xmlns:v="using:SimplArchive.DesktopClient.Views"
             xmlns:loc="using:SimplArchive.DesktopClient.Localization"
             x:Class="SimplArchive.DesktopClient.Views.TasksList"
             x:DataType="vm:MainWindowViewModel">
    <!-- The Tasks tab's list (#550): sortable headers whose captions carry the direction arrow, a VISIBLE
         filter row (ADR 0550 — document/version text + overdue-only), and the rows over VisibleTasks.
         Extracted from MainWindow.axaml as its own control (the #519 direction). -->
    <Border BorderBrush="{DynamicResource WbBorder}" BorderThickness="1" Margin="0,8,0,0"
            MaxWidth="820" HorizontalAlignment="Left" VerticalAlignment="Top" IsVisible="{Binding HasTasks}">
        <DockPanel LastChildFill="True">
            <!-- Sortable headers (#550): the caption carries the direction arrow, so the sort
                 state is visible where it was set. Status stays plain — the chip is invariant. -->
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,110,70,130,130" Background="{DynamicResource WbChrome}">
                <Button Grid.Column="0" Command="{Binding SortTasksCommand}" CommandParameter="document"
                        Background="Transparent" BorderThickness="0" Padding="6,4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                    <TextBlock Text="{Binding TaskHeaderDocument}" FontWeight="SemiBold" /></Button>
                <TextBlock Grid.Column="1" Text="{loc:Tr WorkflowStatus}" FontWeight="SemiBold" Margin="6,4" />
                <Button Grid.Column="2" Command="{Binding SortTasksCommand}" CommandParameter="version"
                        Background="Transparent" BorderThickness="0" Padding="6,4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                    <TextBlock Text="{Binding TaskHeaderVersion}" FontWeight="SemiBold" /></Button>
                <Button Grid.Column="3" Command="{Binding SortTasksCommand}" CommandParameter="assigned"
                        Background="Transparent" BorderThickness="0" Padding="6,4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                    <TextBlock Text="{Binding TaskHeaderAssigned}" FontWeight="SemiBold" /></Button>
                <Button Grid.Column="4" Command="{Binding SortTasksCommand}" CommandParameter="due"
                        Background="Transparent" BorderThickness="0" Padding="6,4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                    <TextBlock Text="{Binding TaskHeaderDue}" FontWeight="SemiBold" /></Button>
            </Grid>
            <!-- The filter row is VISIBLE, not behind a menu (ADR 0550/#550). -->
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,110,70,130,130">
                <TextBox Grid.Column="0" Text="{Binding TaskFilterDocument}" v:SearchField.Clearable="True" Watermark="{loc:Tr FilterHint}" Margin="4,2" Padding="4,2" />
                <TextBox Grid.Column="2" Text="{Binding TaskFilterVersion}" v:SearchField.Clearable="True" Watermark="{loc:Tr FilterHint}" Margin="4,2" Padding="4,2" />
                <CheckBox Grid.Column="4" IsChecked="{Binding TaskFilterOverdueOnly}" Content="{loc:Tr OverdueOnly}" Margin="6,0" FontSize="12" />
            </Grid>
            <ScrollViewer>
                <ListBox ItemsSource="{Binding VisibleTasks}" SelectedItem="{Binding SelectedTaskRow}"
                         Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:TaskItemViewModel">
                            <!-- The row and its menu are their own control (#530 tranche 3). -->
                            <v:TaskRow />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
