<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:SimplArchive.DesktopClient.Localization"
        x:Class="SimplArchive.DesktopClient.Views.PrincipalDialog"
        Title="{loc:Tr UgNew}" Width="400" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="18" Spacing="10">
        <StackPanel x:Name="EmailPanel" Spacing="4">
            <TextBlock Text="{loc:Tr LoginEmail}" />
            <TextBox x:Name="EmailBox" Watermark="name@example.com" />
        </StackPanel>
        <StackPanel Spacing="4">
            <TextBlock x:Name="NameLabel" Text="{loc:Tr PrincipalDisplayName}" />
            <TextBox x:Name="NameBox" Watermark="{loc:Tr Name}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="{loc:Tr Cancel}" Click="OnCancel" IsCancel="True" />
            <Button Content="{loc:Tr Create}" Click="OnCreate" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
