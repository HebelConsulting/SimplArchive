<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:SimplArchive.DesktopClient.Localization"
        xmlns:vm="using:SimplArchive.DesktopClient.ViewModels"
        xmlns:i="using:Projektanker.Icons.Avalonia"
        x:Class="SimplArchive.DesktopClient.Views.ReferencesDialog"
        x:DataType="vm:ReferencesViewModel"
        Title="{loc:Tr RefDlgTitle}" Width="560" Height="440"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="14" LastChildFill="True">

        <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,8">
            <TextBlock Text="{Binding ItemName, StringFormat='Folders that reference {0}'}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource WbFaint}" FontSize="11" />
        </StackPanel>

        <!-- The item's real home (ADR 0506): a prominent row set apart from the reference rows below. -->
        <Border DockPanel.Dock="Top" IsVisible="{Binding HasPrimary}" Margin="0,0,0,8" Padding="8,6"
                Background="{DynamicResource WbChrome}" CornerRadius="3">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <i:Icon Grid.Column="0" Value="mdi-star" Foreground="#5b4ee6" VerticalAlignment="Center" Margin="0,0,8,0" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="{loc:Tr RefPrimaryLocation}" FontWeight="SemiBold" />
                        <TextBlock Text="—" />
                        <TextBlock Text="{Binding PrimaryLocation.Name}" />
                    </StackPanel>
                    <TextBlock Text="{Binding PrimaryLocation.Path}" Foreground="{DynamicResource WbFaint}" FontSize="11" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="2" Click="OnOpenPrimary" ToolTip.Tip="Open this folder">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <i:Icon Value="mdi-folder-open" />
                        <TextBlock Text="{loc:Tr Open}" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button Content="{loc:Tr Close}" Click="OnClose" IsCancel="True" HorizontalAlignment="Right" />
        </Border>

        <ListBox ItemsSource="{Binding Items}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ReferencingFolderViewModel">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" />
                            <TextBlock Text="{Binding Path}" Foreground="{DynamicResource WbFaint}" FontSize="11" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <!-- Promote this reference to be the item's primary location — only shown when there is
                                 a current primary to demote (ADR 0506). -->
                            <Button Click="OnMakePrimary"
                                    IsVisible="{Binding ((vm:ReferencesViewModel)DataContext).HasPrimary, RelativeSource={RelativeSource AncestorType=Window}}"
                                    ToolTip.Tip="Make this the primary location">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <i:Icon Value="mdi-star" Foreground="#5b4ee6" />
                                    <TextBlock Text="{loc:Tr RefMakePrimary}" />
                                </StackPanel>
                            </Button>
                            <Button Click="OnOpen" ToolTip.Tip="Open this folder">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <i:Icon Value="mdi-folder-open" />
                                    <TextBlock Text="{loc:Tr Open}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
