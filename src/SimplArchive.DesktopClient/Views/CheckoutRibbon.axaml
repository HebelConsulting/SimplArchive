<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SimplArchive.DesktopClient.ViewModels"
             xmlns:i="using:Projektanker.Icons.Avalonia"
             xmlns:loc="using:SimplArchive.DesktopClient.Localization"
             x:Class="SimplArchive.DesktopClient.Views.CheckoutRibbon"
             x:DataType="vm:MainWindowViewModel">
    <!-- Check-out ribbon (#500) — the same shape as the Inbox's, because the two tabs are the same kind of
         place: a staging area you also reach from your file manager. Its two actions already existed; what
         they lacked was a home. Refresh sat beside the heading and WebDAV in the bottom-left corner, so the
         tab's own actions were in two places and neither looked like the Inbox's.

         Deliberately NOT here: split, join and sort. A checked-out document is a version of a FILED document,
         so reshaping its pages is a records question, not a clerical one — which is why ADR 0575 confined the
         page algebra to the Inbox. The route for someone who needs it is to drag the file into the Inbox,
         reshape it there, and check it in as a new version. -->
    <Border Classes="ribbon" Padding="8,6" BorderBrush="{DynamicResource WbBorder}" BorderThickness="0,0,0,1">
        <WrapPanel Orientation="Horizontal">
            <!-- Working copy: what you do WITH the file while you hold it. Both compare affordances sit here
                 (ADR 0518) — the in-app diff, and the user's own Beyond Compare, which shows whether or not
                 the tool is installed because that is how anyone discovers it exists. -->
            <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,12,4">
                <Button AutomationProperties.AutomationId="checkout-edit" IsEnabled="{Binding Checkout.HasSelectedRow}"
                        Command="{Binding Checkout.EditCommand}" CommandParameter="{Binding Checkout.SelectedRow}"
                        ToolTip.Tip="{loc:Tr CoEditTip}"><i:Icon Value="mdi-pencil-outline" FontSize="18" /></Button>
                <!-- Single-subject verbs (one diff has one document), so they gate on a SINGLE modified
                     selection — while check-in and discard below compose across many (#521). -->
                <Button AutomationProperties.AutomationId="checkout-compare" IsEnabled="{Binding Checkout.SelectedIsSingleModified}"
                        Click="OnCheckoutCompare" ToolTip.Tip="{loc:Tr CoCompare}"><i:Icon Value="mdi-compare-horizontal" FontSize="18" /></Button>
                <Button AutomationProperties.AutomationId="checkout-beyondcompare" IsEnabled="{Binding Checkout.SelectedIsSingleModified}"
                        Click="OnCheckoutBeyondCompare" ToolTip.Tip="{loc:Tr CoBeyondCompare}"><i:Icon Value="mdi-compare" FontSize="18" /></Button>
                <!-- Rotate/Sort the WORKING COPY (ADR 0593) — greyed until the selected row's pages resource
                     offered `sort` (a signed or non-paged working copy never does, ADR 0543/0554). -->
                <Button AutomationProperties.AutomationId="checkout-sort" IsEnabled="{Binding Checkout.SelectedCanSortPages}"
                        Click="OnCheckoutSortPages" ToolTip.Tip="{loc:Tr InboxSortTitle}"><i:Icon Value="mdi-sort" FontSize="18" /></Button>
            </StackPanel>
            <!-- Finish: the two ways a check-out ENDS well — commit the work, or release it unchanged.
                 Check in composes across a multi-selection (N check-ins, one summary), so it routes through
                 the window like discard does, instead of binding a single-row command to SelectedRow — which
                 with several rows highlighted would silently commit only one of them (#521). -->
            <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,12,4">
                <Button AutomationProperties.AutomationId="checkout-checkin" IsEnabled="{Binding Checkout.SelectedCanCheckIn}"
                        Click="OnCheckoutCheckIn"
                        ToolTip.Tip="{loc:Tr CoCheckIn}"><i:Icon Value="mdi-check" FontSize="18" /></Button>
                <Button AutomationProperties.AutomationId="checkout-unlock" IsEnabled="{Binding Checkout.SelectedCanUnlock}"
                        Command="{Binding Checkout.UnlockCommand}" CommandParameter="{Binding Checkout.SelectedRow}"
                        ToolTip.Tip="{loc:Tr MwUnlock}"><i:Icon Value="mdi-lock-open-variant-outline" FontSize="18" /></Button>
            </StackPanel>
            <!-- Lease: how long you keep holding it. -->
            <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,12,4">
                <Button AutomationProperties.AutomationId="checkout-extend" IsEnabled="{Binding Checkout.SelectedCanExtend}"
                        Command="{Binding Checkout.ExtendCommand}" CommandParameter="{Binding Checkout.SelectedRow}"
                        ToolTip.Tip="{loc:Tr MwExtendCheckoutTip}"><i:Icon Value="mdi-clock-plus-outline" FontSize="18" /></Button>
            </StackPanel>
            <!-- Discard, ALONE. It ends the check-out too, but by throwing the work away — and it would
                 otherwise sit next to the button that commits it, which is the worst adjacency in this tab. -->
            <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,12,4">
                <Button AutomationProperties.AutomationId="checkout-discard" IsEnabled="{Binding Checkout.SelectedCanDiscard}"
                        Click="OnCheckoutDiscard" ToolTip.Tip="{loc:Tr MwDiscard}"><i:Icon Value="mdi-delete-outline" FontSize="18" /></Button>
            </StackPanel>
            <!-- Item group: what to do with the list as a whole. -->
            <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,12,4">
                <Button AutomationProperties.AutomationId="checkout-refresh" Command="{Binding Checkout.RefreshCommand}"
                        ToolTip.Tip="{loc:Tr RibbonRefresh}"><i:Icon Value="mdi-refresh" FontSize="18" /></Button>
            </StackPanel>
            <!-- General group: one WebDAV button that does the next useful thing — set up, mount, or open this
                 tab's own folder (ADR "One WebDAV button per tab, deep-linked"). -->
            <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,0,4">
                <Button Click="OnWebDavTabButton" Tag="Personal/Check-out" AutomationProperties.AutomationId="checkout-webdav"
                        ToolTip.Tip="{Binding WebDav.Tooltip}"><i:Icon Value="mdi-folder-network-outline" FontSize="18" /></Button>
            </StackPanel>
        </WrapPanel>
    </Border>
</UserControl>
