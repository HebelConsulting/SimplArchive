<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:SimplArchive.DesktopClient.Localization"
        xmlns:vm="using:SimplArchive.DesktopClient.ViewModels"
        xmlns:views="using:SimplArchive.DesktopClient.Views"
        x:Class="SimplArchive.DesktopClient.Views.CompareVersionsDialog"
        x:DataType="vm:CompareVersionsViewModel"
        Title="{loc:Tr CvTitle}" Width="980" Height="600"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16" LastChildFill="True">
        <TextBlock DockPanel.Dock="Top" Text="{Binding DocumentName}" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10" />

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10" VerticalAlignment="Center">
            <TextBlock Text="{loc:Tr AuditFrom}" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding Versions}" SelectedItem="{Binding FromVersion}" MinWidth="90">
                <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:VersionOption"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="→" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding Versions}" SelectedItem="{Binding ToVersion}" MinWidth="90">
                <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:VersionOption"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <Button Content="{loc:Tr CompareButton}" Command="{Binding CompareCommand}" />
            <Button Content="Beyond Compare" Command="{Binding OpenInBeyondCompareCommand}"
                    ToolTip.Tip="{loc:Tr CmpOpenBothVersions}" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Foreground="{DynamicResource WbMuted}" FontSize="12" Margin="0,8,0,0" />
        <Button DockPanel.Dock="Bottom" Content="{loc:Tr Close}" Click="OnClose" HorizontalAlignment="Right" Margin="0,10,0,0" />

        <Border BorderBrush="{DynamicResource WbBorder}" BorderThickness="1" CornerRadius="4">
            <Grid>
                <views:DiffView RowsSource="{Binding Rows}" />

                <!-- Nothing compared yet (or the selection changed since) — say so rather than leaving the panel
                     blank, which would read as "these two versions are identical". -->
                <TextBlock Text="{loc:Tr CompareHint}" IsVisible="{Binding ShowHint}"
                           Foreground="{DynamicResource WbMuted}" FontSize="13" TextWrapping="Wrap" TextAlignment="Center"
                           HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380" Margin="24" />
            </Grid>
        </Border>
    </DockPanel>
</Window>
