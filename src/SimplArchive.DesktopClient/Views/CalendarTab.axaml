<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="using:Projektanker.Icons.Avalonia"
             xmlns:loc="using:SimplArchive.DesktopClient.Localization"
             xmlns:vm="using:SimplArchive.DesktopClient.ViewModels"
             xmlns:p="using:SimplArchive.Presentation"
             xmlns:v="using:SimplArchive.DesktopClient.Views"
             x:Class="SimplArchive.DesktopClient.Views.CalendarTab"
             x:DataType="vm:CalendarTabViewModel">

  <!-- The Calendar tab (#564): calendars │ appointments │ detail — the twin of the Contacts tab, so the two
       read as one surface (ADR 0511). It differs only where a calendar genuinely differs: the middle list is
       ordered by time and leads with it, because that is how anyone reads a calendar. -->
  <DockPanel LastChildFill="True" Margin="8">

    <!-- Ribbon: icons only where a hover can explain them, icon+label on touch (ADR 0491 via .ribbon). -->
    <Border DockPanel.Dock="Top" Classes="ribbon">
      <StackPanel Orientation="Horizontal" Spacing="4">
        <Button Command="{Binding LoadCommand}" ToolTip.Tip="{loc:Tr RibbonRefresh}"
                AutomationProperties.Name="{loc:Tr RibbonRefresh}">
          <i:Icon Value="mdi-refresh" FontSize="18" />
        </Button>
        <!-- Disabled until a ticked calendar ADVERTISES the create (#631), so the affordance never lies
             about what it can do. -->
        <Button Click="OnNew" IsEnabled="{Binding CanCreate}"
                ToolTip.Tip="{loc:Tr CalendarNew}" AutomationProperties.Name="{loc:Tr CalendarNew}">
          <i:Icon Value="mdi-calendar-plus" FontSize="18" />
        </Button>
        <!-- Edit opens the structured editor. Enabled only with a row selected; whether the entry is really
             editable is the server's answer, told by the document's appointment rel (ADR 0543). -->
        <Button Click="OnEdit" IsEnabled="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}"
                ToolTip.Tip="{loc:Tr CalendarEdit}" AutomationProperties.Name="{loc:Tr CalendarEdit}">
          <i:Icon Value="mdi-pencil-outline" FontSize="18" />
        </Button>

        <!-- Month ⇄ List. Two questions, not two skins of one: the list answers "what is coming up" and keeps
             the filter, the month answers "what does this month look like". The active one wears the accent,
             which is the group's vocabulary for STATE (ADR 0581). -->
        <Border Width="1" Background="{DynamicResource WbBorder}" Margin="4,2" />
        <Button Command="{Binding ShowMonthCommand}" ToolTip.Tip="{loc:Tr CalendarViewMonth}"
                AutomationProperties.Name="{loc:Tr CalendarViewMonth}"
                Classes.on="{Binding IsMonthView}">
          <Button.Styles>
            <Style Selector="Button.on i|Icon">
              <Setter Property="Foreground" Value="{DynamicResource SystemAccentColorBrush}" />
            </Style>
          </Button.Styles>
          <i:Icon Value="mdi-calendar-month" FontSize="18" />
        </Button>
        <Button Command="{Binding ShowListCommand}" ToolTip.Tip="{loc:Tr CalendarViewList}"
                AutomationProperties.Name="{loc:Tr CalendarViewList}"
                Classes.on="{Binding !IsMonthView}">
          <Button.Styles>
            <Style Selector="Button.on i|Icon">
              <Setter Property="Foreground" Value="{DynamicResource SystemAccentColorBrush}" />
            </Style>
          </Button.Styles>
          <i:Icon Value="mdi-format-list-bulleted" FontSize="18" />
        </Button>
      </StackPanel>
    </Border>

    <Grid ColumnDefinitions="220,4,*,4,320">

      <!-- Calendars: tick to overlay. The swatch is the calendar's colour (ADR 0620), which is what tells
           overlaid calendars apart once more than one is ticked. -->
      <DockPanel Grid.Column="0" LastChildFill="True">
        <TextBlock DockPanel.Dock="Top" Text="{loc:Tr CalendarCollections}" FontWeight="SemiBold" Margin="2,0,6,6" />
        <ListBox ItemsSource="{Binding Collections}" Background="Transparent" BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:CalendarCollectionViewModel">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" />
                <Border Width="10" Height="10" CornerRadius="5" VerticalAlignment="Center"
                        Background="{Binding Color, TargetNullValue=#8a8a8a}" />
                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="{DynamicResource WbBorder}" />

      <!-- Appointments of the ticked calendars, merged and in time order. -->
      <DockPanel Grid.Column="2" LastChildFill="True">
        <TextBox DockPanel.Dock="Top" Text="{Binding Filter}" Watermark="{loc:Tr FilterHint}" Margin="0,0,0,6"
                 v:SearchField.Clearable="True" />

        <!-- The day handed over by a cell's overflow. It says which day, and it is clearable: a filter the
             user cannot see is one they conclude is a bug (ADR 0550). -->
        <Border DockPanel.Dock="Top" IsVisible="{Binding DayFilter, Converter={x:Static ObjectConverters.IsNotNull}}"
                Background="{DynamicResource WbChrome}" CornerRadius="3" Padding="6,2" Margin="0,0,0,6"
                HorizontalAlignment="Left">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="{Binding DayFilterLabel}" VerticalAlignment="Center" />
            <Button Content="✕" Command="{Binding ClearDayFilterCommand}" Padding="4,0"
                    Background="Transparent" BorderThickness="0" />
          </StackPanel>
        </Border>

        <!-- The month grid. Six week rows always, so paging months does not change the grid's height under
             the cursor and move the cell the user was aiming at. -->
        <!-- Two ROWS, not one cell shared by everything: the empty message used to be a bare child of this
             Grid carrying a stray DockPanel.Dock="Top" — an attached property for a parent it no longer had —
             so it rendered in the same cell as the month selector and the two drew on top of each other. -->
        <Grid RowDefinitions="Auto,*">
        <DockPanel Grid.Row="1" IsVisible="{Binding IsMonthView}" LastChildFill="True">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="4" Margin="0,0,0,4">
            <Button Content="◀" Command="{Binding PreviousMonthCommand}" ToolTip.Tip="{loc:Tr CalendarPrevMonth}" />
            <TextBlock Text="{Binding MonthName}" FontWeight="SemiBold" VerticalAlignment="Center"
                       MinWidth="140" TextAlignment="Center" />
            <Button Content="▶" Command="{Binding NextMonthCommand}" ToolTip.Tip="{loc:Tr CalendarNextMonth}" />
            <Button Content="{loc:Tr CalendarToday}" Command="{Binding GoTodayCommand}" Margin="8,0,0,0" />
          </StackPanel>

          <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding WeekdayHeadings}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><UniformGrid Columns="7" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <TextBlock Text="{Binding}" FontSize="11" Foreground="{DynamicResource WbMuted}" Margin="4,2" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <ItemsControl ItemsSource="{Binding MonthDays}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><UniformGrid Columns="7" Rows="6" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CalendarDayViewModel">
                <!-- Days either side of the month are shown so the weeks stay whole, but they are context:
                     dimmed, never hidden, because a ragged grid reads as broken. A style class rather than a
                     converter — one fewer resource to exist, and a missing StaticResource fails at RUNTIME on
                     a screen no test opens. -->
                <Border BorderBrush="{DynamicResource WbBorder}" BorderThickness="0,0,1,1" Padding="2"
                        Classes.outside="{Binding !InMonth}">
                  <Border.Styles>
                    <Style Selector="Border.outside"><Setter Property="Opacity" Value="0.45" /></Style>
                  </Border.Styles>
                  <StackPanel Spacing="1">
                    <TextBlock Text="{Binding DayNumber}" FontSize="11"
                               Foreground="{DynamicResource WbMuted}" />
                    <ItemsControl ItemsSource="{Binding Entries}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CalendarCellEntryViewModel">
                          <!-- A BUTTON, not a bare Grid: the chips previously had no interaction of any kind, so
                               the detail pane beside the grid stayed empty in month view. A button also makes the
                               chip keyboard-reachable, which a PointerPressed handler would not.
                               Bound from the UserControl rather than $parent[ItemsControl]: the chips sit two
                               ItemsControls deep (days, then entries), so the nearest one is the wrong scope. -->
                          <Button Padding="0" Background="Transparent" BorderThickness="0"
                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                  Command="{Binding $parent[UserControl].((vm:CalendarTabViewModel)DataContext).SelectEntryCommand}"
                                  CommandParameter="{Binding}"
                                  Classes.selected="{Binding IsSelected}">
                            <Button.Styles>
                              <!-- The selected chip takes the same tint + leading edge a selected LIST row takes,
                                   so selection means one thing across the tab (ADR 0578's selection treatment). -->
                              <Style Selector="Button.selected">
                                <Setter Property="Background" Value="{DynamicResource WbSelection}" />
                              </Style>
                            </Button.Styles>
                          <Grid ColumnDefinitions="10,Auto,*,Auto" ToolTip.Tip="{Binding Title}">
                            <Border Grid.Column="0" Width="7" Height="7" CornerRadius="4"
                                    VerticalAlignment="Center" Background="{Binding CollectionColor}" />
                            <!-- The START, not the range: see StartTimeShort — the range leaves the title no room.
                                 On a day the entry only runs THROUGH, LeadText is the continuation mark instead. -->
                            <TextBlock Grid.Column="1" Text="{Binding LeadText}" FontSize="10"
                                       Foreground="{DynamicResource WbMuted}" Margin="0,0,3,0" />
                            <TextBlock Grid.Column="2" Text="{Binding Title}" FontSize="10"
                                       TextTrimming="CharacterEllipsis" />
                            <!-- The rule is never expanded, so this entry is drawn at its first occurrence and
                                 nowhere else. Without the marker the grid silently claims the other weeks are
                                 free. Muted and last: it qualifies the entry rather than identifying it. -->
                            <TextBlock Grid.Column="3" Text="{Binding RepeatMark}" FontSize="9"
                                       IsVisible="{Binding Recurring}" Margin="2,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource WbMuted}" />
                          </Grid>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="{Binding MoreLabel}" IsVisible="{Binding HasHidden}"
                            FontSize="10" Padding="2,0" Background="Transparent" BorderThickness="0"
                            Command="{Binding $parent[ItemsControl].((vm:CalendarTabViewModel)DataContext).ShowDayCommand}"
                            CommandParameter="{Binding}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </DockPanel>

        <TextBlock Grid.Row="0" Text="{Binding EmptyMessage}"
                   Foreground="{DynamicResource WbMuted}" Margin="2,4,0,4" TextWrapping="Wrap"
                   IsVisible="{Binding !Appointments.Count}" />
        <ListBox Grid.Row="1" ItemsSource="{Binding VisibleAppointments}" SelectedItem="{Binding Selected}"
                 IsVisible="{Binding !IsMonthView}"
                 Background="Transparent" BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:AppointmentRowViewModel">
              <Grid ColumnDefinitions="14,110,2*,*" Margin="0,2">
                <Border Grid.Column="0" Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center"
                        Background="{Binding CollectionColor}" ToolTip.Tip="{Binding CollectionName}" />
                <!-- Time leads: a calendar row is read by WHEN before WHAT. -->
                <TextBlock Grid.Column="1" Text="{Binding TimeRange}" FontFamily="monospace"
                           Foreground="{DynamicResource WbMuted}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                  <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                  <!-- Says the entry repeats. The rule is never expanded, so the row is its first occurrence. -->
                  <TextBlock Text="{Binding RepeatMark}" IsVisible="{Binding Recurring}" FontSize="11"
                             VerticalAlignment="Center" ToolTip.Tip="{loc:Tr CalendarRepeatsHint}"
                             Foreground="{DynamicResource WbMuted}" />
                </StackPanel>
                <TextBlock Grid.Column="3" Text="{Binding Location}" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource WbMuted}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        </Grid>
      </DockPanel>

      <GridSplitter Grid.Column="3" ResizeDirection="Columns" Background="{DynamicResource WbBorder}" />

      <!-- Detail. Sized to its content: this pane must not claim space it is not using (ADR 0550). -->
      <ScrollViewer Grid.Column="4">
        <StackPanel Spacing="8" Margin="8,0,0,0" IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}">
          <TextBlock Text="{Binding Selected.Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Selected.CollectionName}" Foreground="{DynamicResource WbMuted}" />
          <!-- One instant, three readings (ADR 0690). UTC first because it is what anything else can be
               compared against; then what the organiser actually wrote, with the zone each endpoint names —
               two lines when they differ, which is a real appointment (a flight) and not an edge case; then
               the reader's own zone, and ONLY when it would say something the recorded block did not.
               Every row draws only when it has a value: this pane must not spend a line reporting an absence
               (ADR 0550). -->
          <StackPanel Spacing="6" IsVisible="{Binding Detail.HasTimes, FallbackValue=False}">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Grid.Column="0" Text="{loc:Tr CalendarUtc}" Foreground="{DynamicResource WbMuted}" Margin="0,0,8,0" />
              <TextBlock Grid.Column="1" Text="{Binding Detail.UtcRange}" TextWrapping="Wrap" />
            </Grid>

            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Grid.Column="0" Text="{loc:Tr CalendarRecorded}" Foreground="{DynamicResource WbMuted}"
                         Margin="0,0,8,0" VerticalAlignment="Top" />
              <ItemsControl Grid.Column="1" ItemsSource="{Binding Detail.RecordedLines}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="p:AppointmentTimeLine">
                    <!-- A WrapPanel, not a horizontal StackPanel: the pane is narrow and resizable, and a zone
                         name that does not fit was CLIPPED mid-word rather than moving to the next line —
                         seen by capturing the pane, not by reading the markup. -->
                    <WrapPanel>
                      <TextBlock Text="{Binding Range}" Margin="0,0,6,0" />
                      <!-- A floating time names no zone, and saying so in words is not the same as leaving the
                           label blank: it means "this time, wherever you are". -->
                      <TextBlock Text="{Binding Zone, TargetNullValue={loc:Tr CalendarNoZone}}"
                                 Foreground="{DynamicResource WbMuted}" FontSize="11" VerticalAlignment="Center" />
                    </WrapPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>

            <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding Detail.HasViewerTime, FallbackValue=False}">
              <TextBlock Grid.Column="0" Text="{loc:Tr CalendarYourZone}" Foreground="{DynamicResource WbMuted}" Margin="0,0,8,0" />
              <WrapPanel Grid.Column="1">
                <TextBlock Text="{Binding Detail.ViewerRange}" Margin="0,0,6,0" />
                <TextBlock Text="{Binding Detail.ViewerZone}" Foreground="{DynamicResource WbMuted}"
                           FontSize="11" VerticalAlignment="Center" />
              </WrapPanel>
            </Grid>
          </StackPanel>

          <!-- An all-day entry has no instant to place and none may be invented (ADR 0647), so it keeps the
               single row it always had. -->
          <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding !Detail.HasTimes, FallbackValue=True}">
            <TextBlock Grid.Column="0" Text="{loc:Tr CalendarWhen}" Foreground="{DynamicResource WbMuted}" Margin="0,0,8,0" />
            <TextBlock Grid.Column="1" Text="{Binding Selected.TimeRange}" TextWrapping="Wrap" />
          </Grid>

          <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding Detail.HasLocation, FallbackValue=False}">
            <TextBlock Grid.Column="0" Text="{loc:Tr CalendarWhere}" Foreground="{DynamicResource WbMuted}" Margin="0,0,8,0" />
            <TextBlock Grid.Column="1" Text="{Binding Detail.Location}" TextWrapping="Wrap" />
          </Grid>

          <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding Detail.HasUrl, FallbackValue=False}">
            <TextBlock Grid.Column="0" Text="{loc:Tr CalendarLink}" Foreground="{DynamicResource WbMuted}" Margin="0,0,8,0" />
            <TextBlock Grid.Column="1" Text="{Binding Detail.Url}" TextWrapping="Wrap" />
          </Grid>

          <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding Detail.HasNotes, FallbackValue=False}">
            <TextBlock Grid.Column="0" Text="{loc:Tr CalendarNotes}" Foreground="{DynamicResource WbMuted}"
                       Margin="0,0,8,0" VerticalAlignment="Top" />
            <TextBlock Grid.Column="1" Text="{Binding Detail.Notes}" TextWrapping="Wrap" />
          </Grid>

          <!-- The rule verbatim, where there is room for it: a mark answers "does this repeat" but not "how",
               which is the next thing a reader asks. Not prettified into prose — inventing wording for a rule
               we deliberately do not interpret would state more than we know. -->
          <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding Selected.Recurring}">
            <TextBlock Grid.Column="0" Text="{loc:Tr CalendarRepeats}" Foreground="{DynamicResource WbMuted}" Margin="0,0,8,0" />
            <TextBlock Grid.Column="1" Text="{Binding Selected.Repeats}" TextWrapping="Wrap" FontFamily="monospace" />
          </Grid>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</UserControl>
