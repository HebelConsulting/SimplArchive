<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SimplArchive.DesktopClient.ViewModels"
             xmlns:v="using:SimplArchive.DesktopClient.Views"
             xmlns:i="using:Projektanker.Icons.Avalonia"
             xmlns:loc="using:SimplArchive.DesktopClient.Localization"
             x:Class="SimplArchive.DesktopClient.Views.InboxRow"
             x:DataType="vm:InboxItemViewModel">
    <!-- One staged item, the way the Repositories tab draws a row (#521): what the item IS, and a context menu
         for what you can do to it. The four action buttons that used to sit on every row are gone — the same
         action drawn N times, growing the row wider with each feature, and nothing distinguishing "acts on this
         item" from "acts on the tab".

         The menu HIDES what is unavailable while the ribbon GREYS it, and that difference is deliberate: a menu
         is built for one row at the moment it opens, so hiding keeps it short and honest, while a ribbon is on
         screen the whole time and hiding would move buttons under the cursor.

         Its own control because MainWindow.axaml has three lines of headroom against its ceiling (#519), and a
         row is a thing rather than a region — the same reason InboxRibbon became a file (ADR 0577). -->
    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="0,2">
        <i:Icon Grid.Column="0" Value="{Binding IconValue}" Foreground="{DynamicResource WbMuted}" VerticalAlignment="Center" Margin="0,0,8,0" />
        <TextBlock Grid.Column="1" Text="{Binding DisplayName}" VerticalAlignment="Center" />

        <!-- Indicators, not actions: they stay on the row (#521). Source chip = whose queue a non-own item came
             from; the signed badge = a version somebody actually examined. -->
        <Border Grid.Column="2" IsVisible="{Binding HasSource}" Background="{DynamicResource WbBorder}" CornerRadius="3" Padding="5,1" Margin="0,0,8,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding SourceLabel}" FontSize="10" Foreground="{DynamicResource WbMuted}" />
        </Border>
        <v:SignedBadge Grid.Column="3" IsVisible="{Binding IsSigned}" />
        <TextBlock Grid.Column="4" Text="{Binding SizeText}" Foreground="{DynamicResource WbFaint}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0" />

        <Grid.ContextMenu>
            <ContextMenu>
                <!-- The tooltip's chord lives on the ribbon button; a menu item shows its gesture instead. -->
                <MenuItem Header="{loc:Tr MwOpen}" Click="OnOpen">
                    <MenuItem.Icon><i:Icon Value="mdi-open-in-new" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <!-- Own item → "Send to…"; a group / other-user item → "Move to my inbox" (ADR 0532). -->
                <MenuItem Header="{loc:Tr InboxSendTitle}" Click="OnSend" IsVisible="{Binding IsOwn}">
                    <MenuItem.Icon><i:Icon Value="mdi-send-outline" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{loc:Tr InboxClaimToMine}" Click="OnMoveToMine" IsVisible="{Binding !IsOwn}">
                    <MenuItem.Icon><i:Icon Value="mdi-inbox-arrow-down-outline" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{loc:Tr MwFileIntoFolder}" Click="OnFile">
                    <MenuItem.Icon><i:Icon Value="mdi-file-move-outline" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="{loc:Tr UgDelete}" Click="OnDelete">
                    <MenuItem.Icon><i:Icon Value="mdi-delete-outline" /></MenuItem.Icon>
                </MenuItem>
            </ContextMenu>
        </Grid.ContextMenu>
    </Grid>
</UserControl>
