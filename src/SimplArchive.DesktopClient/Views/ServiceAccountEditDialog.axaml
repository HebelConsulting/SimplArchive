<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:SimplArchive.DesktopClient.Localization"
        x:Class="SimplArchive.DesktopClient.Views.ServiceAccountEditDialog"
        Title="{loc:Tr SaEditTitle}" Width="420" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="18" Spacing="10">
        <StackPanel Spacing="4">
            <TextBlock Text="{loc:Tr Name}" />
            <TextBox x:Name="NameBox" Watermark="{loc:Tr Name}" />
        </StackPanel>
        <StackPanel Spacing="4">
            <TextBlock Text="{loc:Tr SaRights}" />
            <CheckBox x:Name="ExportBox" Content="{loc:Tr SaRightExport}" />
            <CheckBox x:Name="ImportBox" Content="{loc:Tr SaRightImport}" />
            <CheckBox x:Name="RepositoriesBox" Content="{loc:Tr SaRightRepositories}" />
            <CheckBox x:Name="MasksBox" Content="{loc:Tr SaRightMasks}" />
            <CheckBox x:Name="ServiceAccountsBox" Content="{loc:Tr SaRightServiceAccounts}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="{loc:Tr Cancel}" Click="OnCancel" IsCancel="True" />
            <Button Content="{loc:Tr Save}" Click="OnSave" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
