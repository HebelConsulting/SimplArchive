<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:SimplArchive.DesktopClient.Localization"
        xmlns:vm="using:SimplArchive.DesktopClient.ViewModels"
        xmlns:i="using:Projektanker.Icons.Avalonia"
        x:Class="SimplArchive.DesktopClient.Views.FolderPickerDialog"
        x:DataType="vm:FolderPickerViewModel"
        Title="{loc:Tr FpTitle}" Width="460" Height="540" CanResize="True"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="14">

        <!-- Context options: when a document/folder is selected on the Repositories tab (ADR "Context-aware
             inbox filing dialog"), offer filing as a new version of it / into its folder, else just the picker. -->
        <StackPanel DockPanel.Dock="Top" IsVisible="{Binding HasOptions}" Spacing="8" Margin="0,0,0,12">
            <RadioButton GroupName="filing" IsChecked="{Binding ModeAsVersion}" IsVisible="{Binding ShowAsVersion}">
                <StackPanel>
                    <TextBlock Text="{loc:Tr FpAsVersion}" />
                    <TextBlock Text="{Binding DocumentPath}" FontSize="11" Foreground="{DynamicResource WbMuted}" TextWrapping="Wrap" />
                </StackPanel>
            </RadioButton>
            <RadioButton GroupName="filing" IsChecked="{Binding ModeInFolder}" IsVisible="{Binding ShowInFolder}">
                <StackPanel>
                    <TextBlock Text="{loc:Tr FpInFolder}" />
                    <TextBlock Text="{Binding FolderPath}" FontSize="11" Foreground="{DynamicResource WbMuted}" TextWrapping="Wrap" />
                </StackPanel>
            </RadioButton>
            <RadioButton GroupName="filing" IsChecked="{Binding ModePicked}" Content="{loc:Tr FilingChooseFolder}" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Top" Text="{loc:Tr FilingChooseTarget}" Margin="0,0,0,8" IsEnabled="{Binding ModePicked}" />

        <!-- Optional feed comment on the filed document(s) (ADR "Filing posts a feed comment"). -->
        <StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="0,10,0,0">
            <TextBlock Text="{loc:Tr FilingCommentPrompt}" Foreground="{DynamicResource WbMuted}" FontSize="12" />
            <TextBox Text="{Binding Comment}" Watermark="{loc:Tr FilingCommentBlankHint}" AcceptsReturn="True" MinHeight="46" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,6,0,0">
                <Button Content="{loc:Tr Cancel}" Click="OnCancel" IsCancel="True" />
                <!-- Disabled until the selection is a real target: choosing a personal space's ROOT is not one
                     (ADR 0689), and a File button that closes the dialog doing nothing is worse than one that
                     says so by being unavailable. -->
                <Button Content="{loc:Tr FpFile}" Click="OnOk" IsDefault="True" IsEnabled="{Binding CanCommit}" />
            </StackPanel>
        </StackPanel>
        <TreeView ItemsSource="{Binding Roots}" SelectedItem="{Binding SelectedNode}" IsEnabled="{Binding ModePicked}">
            <TreeView.Styles>
                <Style Selector="TreeViewItem">
                    <Setter Property="IsExpanded" Value="{ReflectionBinding IsExpanded, Mode=TwoWay}" />
                </Style>
            </TreeView.Styles>
            <TreeView.DataTemplates>
                <TreeDataTemplate DataType="vm:TreeNodeViewModel" ItemsSource="{Binding Children}">
                    <!-- The personal space's root is shown and expands, but is not itself a target — dimmed so
                         that reads before the click rather than after it (ADR 0689). -->
                    <StackPanel Orientation="Horizontal" Spacing="6" Classes.notarget="{Binding IsPersonal}">
                        <StackPanel.Styles>
                            <Style Selector="StackPanel.notarget"><Setter Property="Opacity" Value="0.55" /></Style>
                        </StackPanel.Styles>
                        <i:Icon Value="{Binding IconValue}" Foreground="#d9a400" />
                        <TextBlock Text="{Binding Name}" />
                    </StackPanel>
                </TreeDataTemplate>
            </TreeView.DataTemplates>
        </TreeView>
    </DockPanel>
</Window>
