<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:SimplArchive.DesktopClient.Localization"
        xmlns:vm="using:SimplArchive.DesktopClient.ViewModels"
        xmlns:i="using:Projektanker.Icons.Avalonia"
        x:Class="SimplArchive.DesktopClient.Views.ServiceAccountsWindow"
        x:DataType="vm:ServiceAccountsViewModel"
        Title="{loc:Tr SaManage}" Width="680" Height="520"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="14" RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">

        <!-- Intro -->
        <TextBlock Grid.Row="0" TextWrapping="Wrap" Foreground="{DynamicResource WbMuted}"
                   Text="{loc:Tr SaSecretHint}" Margin="0,0,0,10" />

        <!-- Create form -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
            <TextBox Width="240" Watermark="{loc:Tr SaNewName}" Text="{Binding NewName}" />
            <Button Click="OnCreate" IsEnabled="{Binding !Busy}">
                <StackPanel Orientation="Horizontal" Spacing="5"><i:Icon Value="mdi-plus" /><TextBlock Text="{loc:Tr Create}" /></StackPanel>
            </Button>
        </StackPanel>
        <WrapPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <CheckBox Content="{loc:Tr SaRightExport}" IsChecked="{Binding NewCanExport}" Margin="0,0,14,0" />
            <CheckBox Content="{loc:Tr SaRightImport}" IsChecked="{Binding NewCanImport}" Margin="0,0,14,0" />
            <CheckBox Content="{loc:Tr SaRightRepositories}" IsChecked="{Binding NewCanManageRepositories}" Margin="0,0,14,0" />
            <CheckBox Content="{loc:Tr SaRightMasks}" IsChecked="{Binding NewCanManageMasks}" Margin="0,0,14,0" />
            <CheckBox Content="{loc:Tr SaRightServiceAccounts}" IsChecked="{Binding NewCanManageServiceAccounts}" />
        </WrapPanel>

        <!-- List -->
        <Border Grid.Row="3" BorderBrush="{DynamicResource WbBorder}" BorderThickness="1" CornerRadius="4">
            <ListBox ItemsSource="{Binding Accounts}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ServiceAccountRowViewModel">
                        <Grid ColumnDefinitions="*,Auto" Margin="2">
                            <StackPanel Grid.Column="0" Spacing="1">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{loc:Tr SaRevoked}" Foreground="#c0392b" FontSize="11"
                                               VerticalAlignment="Center" IsVisible="{Binding !IsActive}" />
                                </StackPanel>
                                <TextBlock Text="{Binding ClientId}" FontFamily="Menlo,Consolas,monospace" FontSize="11"
                                           Foreground="{DynamicResource WbMuted}" />
                                <TextBlock Text="{Binding RightsSummary}" FontSize="11" Foreground="{DynamicResource WbFaint}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                <Button Tag="{Binding}" Click="OnEdit" IsEnabled="{Binding CanManage}" ToolTip.Tip="{loc:Tr SaEditTitle}" Padding="6,2"><i:Icon Value="mdi-pencil" /></Button>
                                <Button Tag="{Binding}" Click="OnRotate" IsEnabled="{Binding CanManage}" ToolTip.Tip="{loc:Tr SaRotate}" Padding="6,2"><i:Icon Value="mdi-autorenew" /></Button>
                                <Button Tag="{Binding}" Click="OnRevoke" IsEnabled="{Binding CanManage}" ToolTip.Tip="{loc:Tr SaRevoke}" Padding="6,2"><i:Icon Value="mdi-delete-outline" Foreground="#c0392b" /></Button>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Status -->
        <SelectableTextBlock Grid.Row="4" Text="{Binding Status}" Foreground="#c0392b" FontSize="12" TextWrapping="Wrap"
                   Margin="0,8,0,0" IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <Button Grid.Row="5" Content="{loc:Tr Close}" Click="OnClose" HorizontalAlignment="Right" Margin="0,10,0,0" />
    </Grid>
</Window>
