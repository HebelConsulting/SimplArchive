<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:SimplArchive.DesktopClient.Localization"
        x:Class="SimplArchive.DesktopClient.Views.ServiceAccountSecretDialog"
        Title="{loc:Tr SaSecretTitle}" Width="460" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="18" Spacing="10">
        <TextBlock TextWrapping="Wrap" Text="{loc:Tr SaSecretHint}" />
        <StackPanel Spacing="4">
            <TextBlock Text="{loc:Tr SaClientId}" FontSize="11" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox x:Name="ClientIdBox" IsReadOnly="True" Width="340" FontFamily="Menlo,Consolas,monospace" />
                <Button Content="{loc:Tr Copy}" Click="OnCopyClientId" />
            </StackPanel>
        </StackPanel>
        <StackPanel Spacing="4">
            <TextBlock Text="{loc:Tr SaClientSecret}" FontSize="11" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox x:Name="ClientSecretBox" IsReadOnly="True" Width="340" FontFamily="Menlo,Consolas,monospace" />
                <Button Content="{loc:Tr Copy}" Click="OnCopyClientSecret" />
            </StackPanel>
        </StackPanel>
        <Button Content="{loc:Tr Done}" Click="OnDone" IsDefault="True" HorizontalAlignment="Right" />
    </StackPanel>
</Window>
