<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SimplArchive.DesktopClient.ViewModels"
             xmlns:i="using:Projektanker.Icons.Avalonia"
             xmlns:loc="using:SimplArchive.DesktopClient.Localization"
             x:Class="SimplArchive.DesktopClient.Views.RetentionRow"
             x:DataType="vm:RetentionRowViewModel">
    <!-- One scheduled document, the Repositories shape (#530, tranche 2): what it IS — name, retention span,
         disposition date, status — and a context menu for what can be done to it. The Actions column with its
         labeled Dispose/Extend buttons and the ReflectionBinding reach-around are gone; the ribbon's twins act
         on the selection. Dispose appears only when the server offered it (overdue, no hold — ADR 0543/0554);
         the menu HIDES what is unavailable, the ribbon GREYS it. -->
    <Border BorderBrush="{DynamicResource WbBorder}" BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="3*,110,170,180">
            <TextBlock Grid.Column="0" Text="{Binding DocumentName}" Margin="6,3" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="1" Text="{Binding Retention}" Margin="6,3" />
            <TextBlock Grid.Column="2" Text="{Binding DispositionDate}" Margin="6,3" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="3" Text="{Binding Status}" Margin="6,3" Foreground="{DynamicResource WbMuted}" />

            <Grid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{loc:Tr RetDispose}" Click="OnDispose" IsVisible="{Binding CanDispose}">
                        <MenuItem.Icon><i:Icon Value="mdi-delete-clock-outline" /></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{loc:Tr RetExtend}" Click="OnExtend">
                        <MenuItem.Icon><i:Icon Value="mdi-clock-plus-outline" /></MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </Grid.ContextMenu>
        </Grid>
    </Border>
</UserControl>
