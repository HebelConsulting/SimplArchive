<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:SimplArchive.DesktopClient.Localization"
        xmlns:i="using:Projektanker.Icons.Avalonia"
        x:Class="SimplArchive.DesktopClient.Views.JoinItemsDialog"
        Title="{loc:Tr IntrayJoinTitle}" Width="460" Height="400"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="18" RowDefinitions="Auto,*,Auto,Auto">
        <TextBlock Grid.Row="0" x:Name="PromptText" TextWrapping="Wrap" Margin="0,0,0,10" />

        <!-- Order matters and is the caller's: nothing here sorts. -->
        <ListBox Grid.Row="1" x:Name="ItemList" SelectionMode="Single" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
            <Button x:Name="MoveUpButton" Click="OnMoveUp" ToolTip.Tip="{loc:Tr IntrayPageEarlier}"><i:Icon Value="mdi-arrow-up" /></Button>
            <Button x:Name="MoveDownButton" Click="OnMoveDown" ToolTip.Tip="{loc:Tr IntrayPageLater}"><i:Icon Value="mdi-arrow-down" /></Button>
            <TextBlock Text="{loc:Tr IntrayJoinName}" VerticalAlignment="Center" Margin="10,0,0,0" />
            <TextBox x:Name="NameBox" Width="180" />
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{loc:Tr Cancel}" Click="OnCancel" IsCancel="True" />
            <Button x:Name="JoinButton" Content="{loc:Tr IntrayJoin}" Click="OnJoin" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
