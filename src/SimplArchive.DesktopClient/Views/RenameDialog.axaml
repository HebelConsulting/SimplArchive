<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:SimplArchive.DesktopClient.Localization"
        x:Class="SimplArchive.DesktopClient.Views.RenameDialog"
        Title="{loc:Tr RibbonRename}" Width="380" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="18" Spacing="12">
        <TextBlock Text="{loc:Tr RenameNewName}" />
        <TextBox x:Name="NameBox" Watermark="{loc:Tr Name}" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="{loc:Tr Cancel}" Click="OnCancel" IsCancel="True" />
            <Button Content="{loc:Tr RibbonRename}" Click="OnRename" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
