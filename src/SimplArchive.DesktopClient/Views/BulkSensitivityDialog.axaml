<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:SimplArchive.DesktopClient.Localization"
        x:Class="SimplArchive.DesktopClient.Views.BulkSensitivityDialog"
        Title="{loc:Tr BulkSensTitle}" Width="360" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="18" Spacing="14">
        <TextBlock Text="{loc:Tr BulkSensBody}" TextWrapping="Wrap" />
        <ComboBox x:Name="LabelBox" HorizontalAlignment="Stretch" SelectedIndex="0" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="{loc:Tr Cancel}" Click="OnCancel" IsCancel="True" />
            <Button Content="{loc:Tr Apply}" Click="OnApply" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
