<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:SimplArchive.DesktopClient.Localization"
        x:Class="SimplArchive.DesktopClient.Views.LegalHoldDialog"
        Title="{loc:Tr LhDlgTitle}" Width="420" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="18" Spacing="10">
        <TextBlock TextWrapping="Wrap" Foreground="#888"
                   Text="{loc:Tr LhDlgBody}" />
        <StackPanel Spacing="4">
            <TextBlock Text="{loc:Tr LhMatterName}" />
            <TextBox x:Name="NameBox" />
        </StackPanel>
        <StackPanel Spacing="4">
            <TextBlock Text="{loc:Tr LhReason}" />
            <TextBox x:Name="ReasonBox" AcceptsReturn="True" Height="60" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="{loc:Tr Cancel}" Click="OnCancel" IsCancel="True" />
            <Button Content="{loc:Tr LhPlaceHold}" Click="OnOk" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
