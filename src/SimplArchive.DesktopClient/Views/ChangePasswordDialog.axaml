<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:SimplArchive.DesktopClient.Localization"
        x:Class="SimplArchive.DesktopClient.Views.ChangePasswordDialog"
        Title="{loc:Tr CpTitle}" Width="380" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="18" Spacing="10">
        <StackPanel Spacing="4">
            <TextBlock Text="{loc:Tr CpCurrent}" />
            <TextBox x:Name="CurrentBox" PasswordChar="•" />
        </StackPanel>
        <StackPanel Spacing="4">
            <TextBlock Text="{loc:Tr CpNew}" />
            <TextBox x:Name="NewBox" PasswordChar="•" />
        </StackPanel>
        <StackPanel Spacing="4">
            <TextBlock Text="{loc:Tr CpConfirm}" />
            <TextBox x:Name="ConfirmBox" PasswordChar="•" />
        </StackPanel>
        <TextBlock x:Name="Error" Foreground="#e53935" FontSize="12" IsVisible="False" Text="{loc:Tr CpMismatch}" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="{loc:Tr Cancel}" Click="OnCancel" IsCancel="True" />
            <Button Content="{loc:Tr CpTitle}" Click="OnSave" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
