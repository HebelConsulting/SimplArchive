<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe, not Exe: a console-subsystem binary makes Windows attach a console window that OWNS the
         process, so closing it killed the client mid-session with no warning and no chance to save (#421).
         On macOS and Linux this is identical to Exe, so it is set unconditionally rather than per-RID.
         The headless diagnostic flags still print — Program.Main attaches to the parent console for them. -->
    <!-- MULTI-TARGETED, and the only project in the solution that is (#1398). PKCS#11's CK_ULONG is C's
         `unsigned long`: 8 bytes on Unix LP64 and 4 on Windows LLP64, and Windows' pkcs11.h additionally forces
         1-byte struct packing. HebelConsulting.CAManagement.Pkcs11 therefore ships two assemblies, and a
         `net10.0` consumer running on Windows would load the Unix one and marshal every structure wrongly —
         broken interop rather than a subtle bug. Overrides Directory.Build.props' single TargetFramework, which
         every other project still uses. -->
    <TargetFrameworks>net10.0;net10.0-windows</TargetFrameworks>
    <TargetFramework />
    <OutputType>WinExe</OutputType>
    <!-- The Windows executable's icon, in Explorer, the taskbar and the title bar. Multi-resolution
         (16/32/48/64/96/128/256) generated from the same Assets/cabinet-1024.png artwork as the macOS .icns. -->
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- An unstamped build must not claim a version it never had. Without this, .NET defaults to 1.0.0 — which the
         About box shows and the auto-updater compares against the server's. 1.0.0 sorts ABOVE every real release,
         so a development build concluded it was UP TO DATE and would never offer an update. The packaging scripts
         override this with -p:Version from the release tag, so a shipped build still reports its real version. -->
    <Version>0.0.0-dev</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- The UI end-to-end tests exercise the real Open flow (WithExtension + the api client) against a
         self-hosted API — see tests/SimplArchive.UiEndToEndTests. -->
    <InternalsVisibleTo Include="SimplArchive.DesktopUiEndToEndTests" />
  </ItemGroup>

  <ItemGroup>
    <!-- App icon (a filing cabinet on a brand tile) — embedded for Window.Icon and the macOS Dock. The
         1024 source and the .icns (for a future .app bundle) live alongside it. See ADR "Desktop app icon". -->
    <AvaloniaResource Include="Assets/cabinet.png" />
    <!-- The generated theme dictionary (ADR 0578) — merged by App.axaml, so it must be an Avalonia
         resource rather than content. Regenerate with scripts/generate-theme.sh. -->
    <AvaloniaResource Include="Themes/Tokens.axaml" />
    <AvaloniaResource Include="Themes/Workbench.axaml" />
    <!-- Sample scanned invoice used only by the hit-overlay screenshot mode (ADR "Search hit overlay"). -->
    <None Include="Assets/hitoverlay-sample.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.18" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.18" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.18" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.18" />
    <!-- Headless render-to-PNG mode (Program screenshot flag), so the UI can be verified without a display. -->
    <PackageReference Include="Avalonia.Headless" Version="11.3.18" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- Reads the certificates a PKCS#11 device carries, so one can be registered as the caller's own
         (#1398, ADR 0831). The package ships one assembly per ABI, which is why this project multi-targets —
         see the TargetFrameworks comment above. -->
    <PackageReference Include="HebelConsulting.CAManagement.Pkcs11" Version="0.7.0" />
    <!-- The client's own log (ADR 0613): a rolling text file beside its settings, because stderr goes nowhere in
         a packaged build. Same Serilog the server uses, so the levels mean one thing across the product. -->
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <!-- Material Design icons for the ribbon/buttons (matches the web app's Material icons). Both packages
         MIT; the bundled Material Design Icons font is Apache-2.0. See ADR "Desktop client icon buttons". -->
    <PackageReference Include="Projektanker.Icons.Avalonia" Version="9.6.2" />
    <PackageReference Include="Projektanker.Icons.Avalonia.MaterialDesign" Version="9.6.2" />
    <!-- PDF -> raw-pixel rendering for the preview pane (office/email/pdf render to a first-page image).
         Docnet.Core (MIT) bundles PDFium (BSD-3) natives for win/macOS/Linux incl. arm64, and has NO
         SkiaSharp dependency (avoids a conflict with Avalonia's SkiaSharp 2.88). See ADR "Desktop workbench UI". -->
    <PackageReference Include="Docnet.Core" Version="2.6.0" />
    <!-- MimeKit (MIT) — reads the S/MIME envelope a strict-tier read arrives in (#1353, ADR 0828). Same
         version Infrastructure builds those envelopes with, deliberately: two versions of one format is how
         a producer and a consumer come to disagree about it. -->
    <PackageReference Include="MimeKit" Version="4.17.0" />
    <!-- Real-time notifications hub client (ADR "Real-time notifications (SignalR)"). -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SimplArchive.Localization\SimplArchive.Localization.csproj" />
    <!-- The design tokens (ADR 0578): the shipped palette for the icon art, and the loader that
         applies a custom theme at startup. -->
    <ProjectReference Include="..\SimplArchive.Presentation\SimplArchive.Presentation.csproj" />
    <!-- "PDF bytes -> word boxes", shared with the server (#1402): on a strict tenant the text-layout
         endpoint refuses, so find-in-document is computed from the bytes the card decrypted. -->
    <ProjectReference Include="..\SimplArchive.TextLayout\SimplArchive.TextLayout.csproj" />
    <ProjectReference Include="..\SimplArchive.Theming\SimplArchive.Theming.csproj" />
  </ItemGroup>

</Project>
