<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <!-- Demo document PDFs the Demo:* seed uploads (ADR 0214 / 0502). Embedded so they ship inside the API
         assembly and work in the container. Regenerate from the .typ sources with Typst. The invoice is
         "Invoice 2025-001"; the offer's two revisions are versions 1 + 2 of "Offer 2025-014" (for Compare). -->
    <EmbeddedResource Include="DemoData/sample-invoice.pdf" LogicalName="DemoInvoice.pdf" />
    <EmbeddedResource Include="DemoData/sample-offer-v1.pdf" LogicalName="DemoOfferV1.pdf" />
    <EmbeddedResource Include="DemoData/sample-offer-v2.pdf" LogicalName="DemoOfferV2.pdf" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SimplArchive.Application\SimplArchive.Application.csproj" />
    <ProjectReference Include="..\SimplArchive.Infrastructure\SimplArchive.Infrastructure.csproj" />
    <ProjectReference Include="..\SimplArchive.Auth\SimplArchive.Auth.csproj" />
    <ProjectReference Include="..\SimplArchive.Client\SimplArchive.Client.csproj" />
    <ProjectReference Include="..\SimplArchive.Localization\SimplArchive.Localization.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Mvc" Version="10.0.1" />
    <PackageReference Include="Fido2" Version="4.0.1" />
    <PackageReference Include="Fido2.AspNet" Version="4.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.10" />
    <!-- OpenAPI (ADR "OpenAPI definition endpoint"): Microsoft.AspNetCore.OpenApi generates /openapi/v1.json;
         Scalar renders the browsable UI. Both MIT. Microsoft.OpenApi is pinned to 2.0.1 (a transitive of
         Microsoft.AspNetCore.OpenApi, which floors it at the vulnerable 2.0.0) to 2.7.5 — the first patched
         release in the 2.x line (advisory GHSA-v5pm-xwqc-g5wc / NU1903, vulnerable ≤ 2.7.4) — to keep the CVE
         gate green, same transitive-security-pin pattern as System.Security.Cryptography.Xml. -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageReference Include="Microsoft.OpenApi" Version="3.9.0" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.16.17" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="OpenIddict.AspNetCore" Version="7.6.0" />
    <!-- Enterprise structured logging (ADR "Enterprise-grade structured logging with Serilog"). Serilog.AspNetCore
         (Apache-2.0) bundles the Serilog core, the console sink, the compact JSON formatter, request logging, and
         the host integration. Its six levels (Verbose/Debug/Information/Warning/Error/Fatal) are exactly the ones
         the logging principle in CLAUDE.md defines. -->
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <!-- SignalR Valkey/Redis backplane (ADR "SignalR Valkey backplane") so real-time notifications fan out across
         API replicas. Microsoft.AspNetCore.SignalR.StackExchangeRedis + StackExchange.Redis are both MIT and speak
         the Redis protocol, so Valkey works unchanged. Only active when ConnectionStrings:Valkey is configured. -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" Version="10.0.10" />
    <!-- Two-factor auth (ADR "MFA (interactive login, TOTP)"): Otp.NET generates/verifies TOTP codes, QRCoder
         renders the enrollment QR. Both MIT. -->
    <PackageReference Include="Otp.NET" Version="1.4.1" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
