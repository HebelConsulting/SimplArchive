<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- The version reported by GET /api (ADR 0512) when nothing stamps one. A release build overrides it with
         -p:Version=<tag> (the Dockerfile does this from the release tag).

         0.0.0-dev, NOT the SDK's implicit 1.0.0: serverVersion tells the desktop whether it is behind THIS
         deployment, so an unstamped build reporting 1.0.0 claimed to be ahead of every release that exists —
         harmless only because looking up a non-existent v1.0.0 release 404s, and not harmless the day a real
         1.0.0 is tagged. A sentinel that sorts below every release cannot make that mistake, and reads as
         "unstamped" rather than as a version (issue #425). -->
    <Version>0.0.0-dev</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Demo document PDFs the Demo:* seed uploads (ADR 0214 / 0502). Embedded so they ship inside the API
         assembly and work in the container. Regenerate from the .typ sources with Typst. The invoice is
         "Invoice 2025-001"; the offer's two revisions are versions 1 + 2 of "Offer 2026-014" (for Compare). -->
    <EmbeddedResource Include="DemoData/sample-invoice.pdf" LogicalName="DemoInvoice.pdf" />
    <!-- The seed's only MULTI-PAGE document (#492). The patch-code sample batch needs one: with every
         document single-page, "cut at the separator sheets" and "split every page" give the same answer and
         the fixture stops testing the feature. It also fills a real gap — nothing else in the seed had a
         second page for preview paging or page reordering to work with. -->
    <EmbeddedResource Include="DemoData/maintenance-agreement.pdf" LogicalName="DemoMaintenanceAgreement.pdf" />
    <!-- The same batch as a SCAN (#492): seven 200-dpi bilevel G4 pages rasterised from the documents above,
         separators at 2 and 6, page 4 fed in upside-down, page 5 the blank duplex back, page 7 crooked by 3.5
         degrees. G4 because that is what a document scanner emits — and it is 78 KB against 906 KB grayscale.
         Checked in rather than generated per request because building it needs a PDF rasteriser, which is
         precisely what the Api image does not have. Verified against the real detector: patchPages [2, 6].
         Regenerate with scripts/generate-scan-sample.sh. -->
    <EmbeddedResource Include="DemoData/patch-code-sample-batch.tif" LogicalName="DemoPatchCodeSampleBatch.tif" />
    <!-- Two real contacts for the demo user's own addressbook (#648). Both carry an X-ABShowAs the structured
         form does not model, so they double as the demo of the raw disclosure — which has nothing to show on a
         card this product composed itself. Source: samples/. -->
    <EmbeddedResource Include="DemoData/volmet-geneva.vcf" LogicalName="DemoVolmetGeneva.vcf" />
    <EmbeddedResource Include="DemoData/volmet-zurich.vcf" LogicalName="DemoVolmetZurich.vcf" />
    <EmbeddedResource Include="DemoData/sample-offer-v1.pdf" LogicalName="DemoOfferV1.pdf" />
    <EmbeddedResource Include="DemoData/sample-offer-v2.pdf" LogicalName="DemoOfferV2.pdf" />
    <!-- Richer demo tree (ADR 0214, issue #354): Business Years / Contracts / General folders with varied file
         types. PDFs compile from the .typ sources with Typst; the office/email files are checked-in fixtures. -->
    <EmbeddedResource Include="DemoData/choc-invoice-v1.pdf" LogicalName="DemoChocInvoiceV1.pdf" />
    <EmbeddedResource Include="DemoData/choc-invoice-v2.pdf" LogicalName="DemoChocInvoiceV2.pdf" />
    <EmbeddedResource Include="DemoData/telekom-contract.pdf" LogicalName="DemoTelekomContract.pdf" />
    <EmbeddedResource Include="DemoData/telekom-invoice-jan.pdf" LogicalName="DemoTelekomInvoiceJan.pdf" />
    <EmbeddedResource Include="DemoData/telekom-invoice-feb.pdf" LogicalName="DemoTelekomInvoiceFeb.pdf" />
    <EmbeddedResource Include="DemoData/telekom-invoice-mar.pdf" LogicalName="DemoTelekomInvoiceMar.pdf" />
    <EmbeddedResource Include="DemoData/contoso-forecast.xlsx" LogicalName="DemoContosoForecast.xlsx" />
    <EmbeddedResource Include="DemoData/rental-complaint.docx" LogicalName="DemoRentalComplaint.docx" />
    <EmbeddedResource Include="DemoData/letterhead-template.odt" LogicalName="DemoLetterheadTemplate.odt" />
    <EmbeddedResource Include="DemoData/invoice-template.ods" LogicalName="DemoInvoiceTemplate.ods" />
    <EmbeddedResource Include="DemoData/transport-ticket.eml" LogicalName="DemoTransportTicket.eml" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SimplArchive.Application\SimplArchive.Application.csproj" />
    <ProjectReference Include="..\SimplArchive.Infrastructure\SimplArchive.Infrastructure.csproj" />
    <ProjectReference Include="..\SimplArchive.Auth\SimplArchive.Auth.csproj" />
    <ProjectReference Include="..\SimplArchive.Client\SimplArchive.Client.csproj" />
    <ProjectReference Include="..\SimplArchive.Localization\SimplArchive.Localization.csproj" />
    <!-- The design tokens (ADR 0578): the shipped palette, and the loader that reads an
         installation's custom/theme.json over it. -->
    <ProjectReference Include="..\SimplArchive.Theming\SimplArchive.Theming.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Mvc" Version="10.0.0" />
    <PackageReference Include="Fido2" Version="4.0.1" />
    <PackageReference Include="Fido2.AspNet" Version="4.0.1" />
    <PackageReference Include="FolkerKinzel.VCards" Version="8.2.0" />
    <PackageReference Include="Ical.Net" Version="5.2.3" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.9" />
    <!-- OpenAPI (ADR "OpenAPI definition endpoint"): Microsoft.AspNetCore.OpenApi generates /openapi/v1.json;
         Scalar renders the browsable UI. Both MIT. Microsoft.OpenApi is pinned to 2.0.1 (a transitive of
         Microsoft.AspNetCore.OpenApi, which floors it at the vulnerable 2.0.0) to 2.7.5 — the first patched
         release in the 2.x line (advisory GHSA-v5pm-xwqc-g5wc / NU1903, vulnerable ≤ 2.7.4) — to keep the CVE
         gate green, same transitive-security-pin pattern as System.Security.Cryptography.Xml. -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.16.16" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="OpenIddict.AspNetCore" Version="7.5.0" />
    <!-- Enterprise structured logging (ADR "Enterprise-grade structured logging with Serilog"). Serilog.AspNetCore
         (Apache-2.0) bundles the Serilog core, the console sink, the compact JSON formatter, request logging, and
         the host integration. Its six levels (Verbose/Debug/Information/Warning/Error/Fatal) are exactly the ones
         the logging principle in CLAUDE.md defines. -->
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    <!-- SignalR Valkey/Redis backplane (ADR "SignalR Valkey backplane") so real-time notifications fan out across
         API replicas. Microsoft.AspNetCore.SignalR.StackExchangeRedis + StackExchange.Redis are both MIT and speak
         the Redis protocol, so Valkey works unchanged. Only active when ConnectionStrings:Valkey is configured. -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" Version="10.0.9" />
    <!-- Two-factor auth (ADR "MFA (interactive login, TOTP)"): Otp.NET generates/verifies TOTP codes, QRCoder
         renders the enrollment QR. Both MIT. -->
    <PackageReference Include="Otp.NET" Version="1.4.0" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="WebPush" Version="1.0.13" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- The unit suite asserts one security-relevant invariant on the IMAP session: that a credential-bearing
         command's arguments are never returned for logging. That rule is worth a test, and a test needs to see it. -->
    <InternalsVisibleTo Include="SimplArchive.UnitTests" />
  </ItemGroup>
</Project>
