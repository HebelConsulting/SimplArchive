@page "/Account/DeviceResult"
@model SimplArchive.Api.Pages.Account.DeviceResultModel
@using SimplArchive.Localization
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Strings.Get(Model.WasApproved ? "DeviceApprovedTitle" : "DeviceRefusedTitle")</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/api/theme.css" />
    <partial name="_AccountStyles" />
</head>
<body>
    <main>
        @* Deliberately no link onward. The browser was a detour from a terminal, and the useful thing to say
           is that the detour is over — an "open SimplArchive" button here invites the administrator away from
           the command still waiting for them. *@
        <div class="login-card">
            <div class="brand">SimplArchive</div>
            <h1 class="title">@Strings.Get(Model.WasApproved ? "DeviceApprovedTitle" : "DeviceRefusedTitle")</h1>
            <p class="hint">@Strings.Get(Model.WasApproved ? "DeviceApprovedHint" : "DeviceRefusedHint")</p>
        </div>
    </main>
</body>
</html>
