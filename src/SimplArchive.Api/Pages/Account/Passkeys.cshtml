@page
@model SimplArchive.Api.Pages.Account.PasskeysModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Passkeys · SimplArchive</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" rel="stylesheet" />
    @* The installation's colours (ADR 0578) — same reason as the sign-in page: server-rendered, so it never
       runs the Blazor client and cannot pick the theme up the way the app does. *@
    <link rel="stylesheet" href="/api/theme.css" />
    <style>
        /* Aligned with the login page's theme (ADR "Interactive User login"); follows the system light/dark. */
        /* Values from the design tokens (ADR 0578); the names stay because the rules below are written
           against them. Light/dark comes from the tokens' own prefers-color-scheme block. */
        :root {
            --primary: var(--sa-accent, #0F766E);
            --primary-hover: var(--sa-accent-hover, #115E59);
            --error: var(--sa-danger, #B91C1C);
            --page-bg: var(--sa-canvas, #FAFAFC);
            --surface: var(--sa-surface, #FFFFFF);
            --text: var(--sa-text, #14161C);
            --text-secondary: var(--sa-text-secondary, #5A5F6E);
            --border: var(--sa-hairline, #E6E7EC);
            --shadow: 0 3px 5px -1px rgba(0,0,0,.2), 0 6px 10px 0 rgba(0,0,0,.14), 0 1px 18px 0 rgba(0,0,0,.12);
        }

        @@media (prefers-color-scheme: dark) {
            :root {
                --shadow: 0 3px 5px -1px rgba(0,0,0,.4), 0 6px 10px 0 rgba(0,0,0,.28), 0 1px 18px 0 rgba(0,0,0,.24);
            }
        }

        * { box-sizing: border-box; }
        html, body { height: 100%; }

        body {
            margin: 0;
            font-family: 'Roboto', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            background: var(--page-bg);
            color: var(--text);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .card {
            background: var(--surface);
            width: 100%;
            max-width: 460px;
            margin: 24px;
            padding: 32px;
            border-radius: 4px;
            box-shadow: var(--shadow);
        }

        .brand { font-size: 1.5rem; font-weight: 500; color: var(--primary); margin-bottom: 4px; }
        .title { font-size: 1.25rem; font-weight: 400; margin: 0 0 24px; }
        .hint { font-size: 0.875rem; color: var(--text-secondary); margin: 0 0 20px; }

        .error { background: rgba(244, 67, 54, 0.12); color: var(--error); padding: 12px 16px; border-radius: 4px; margin-bottom: 20px; font-size: 0.875rem; }
        .notice { background: rgba(89, 74, 226, 0.10); color: var(--primary); padding: 12px 16px; border-radius: 4px; margin-bottom: 20px; font-size: 0.875rem; }

        .keys { list-style: none; margin: 0 0 20px; padding: 0; }
        .key { display: flex; align-items: center; gap: 12px; padding: 12px 0; border-bottom: 1px solid var(--border); }
        .key:first-child { border-top: 1px solid var(--border); }
        .key-name { flex: 1 1 auto; }
        .key-name .n { font-size: 0.95rem; }
        .key-name .meta { font-size: 0.8125rem; color: var(--text-secondary); }
        .empty { font-size: 0.875rem; color: var(--text-secondary); margin: 0 0 20px; }

        .field { margin-bottom: 20px; }
        .field label { display: block; font-size: 0.875rem; color: var(--text-secondary); margin-bottom: 6px; }
        .field input {
            width: 100%; padding: 12px 14px; font-size: 1rem; font-family: inherit; color: var(--text);
            background: transparent; border: 1px solid var(--border); border-radius: 4px; outline: none;
            transition: border-color .15s, box-shadow .15s;
        }
        .field input:focus { border-color: var(--primary); box-shadow: 0 0 0 1px var(--primary); }

        .btn-primary {
            width: 100%; padding: 12px; margin-top: 8px; font-size: 0.9375rem; font-weight: 500; font-family: inherit;
            text-transform: uppercase; letter-spacing: 0.05em; color: #fff; background: var(--primary);
            border: none; border-radius: 4px; cursor: pointer;
            box-shadow: 0 3px 1px -2px rgba(0,0,0,.2), 0 2px 2px 0 rgba(0,0,0,.14), 0 1px 5px 0 rgba(0,0,0,.12);
            transition: background .15s;
        }
        .btn-primary:hover { background: var(--primary-hover); }

        .btn-remove {
            background: transparent; border: 1px solid var(--border); color: var(--text-secondary);
            border-radius: 4px; padding: 6px 12px; font-size: 0.8125rem; font-family: inherit; cursor: pointer;
        }
        .btn-remove:hover { color: var(--error); border-color: var(--error); }

        .done { display: block; text-align: center; margin-top: 20px; font-size: 0.875rem; color: var(--text-secondary); text-decoration: none; }
        .done:hover { color: var(--primary); }
    </style>
</head>
<body>
    <main>
        <div class="card">
            <div class="brand">SimplArchive</div>
            <h1 class="title">Passkeys</h1>

            @if (Model.Error is not null)
            {
                <div class="error">@Model.Error</div>
            }
            @if (Model.Notice is not null)
            {
                <div class="notice">@Model.Notice</div>
            }

            <p class="hint">Passkeys let you sign in with your device's fingerprint, face, or a security key — as a second factor, or (when your organization allows it) with no password at all.</p>

            @if (Model.Passkeys.Count == 0)
            {
                <p class="empty">No passkeys yet.</p>
            }
            else
            {
                <ul class="keys">
                    @foreach (var key in Model.Passkeys)
                    {
                        <li class="key">
                            <div class="key-name">
                                <div class="n">@key.Name</div>
                                <div class="meta">Added @key.CreatedAt.LocalDateTime.ToString("yyyy-MM-dd")@(key.LastUsedAt is { } u ? $" · last used {u.LocalDateTime:yyyy-MM-dd}" : "")</div>
                            </div>
                            <form method="post" asp-page-handler="Remove" asp-route-id="@key.Id">
                                <input type="hidden" asp-for="Loopback" />
                                <button type="submit" class="btn-remove">Remove</button>
                            </form>
                        </li>
                    }
                </ul>
            }

            @if (Model.RegisterOptionsJson is not null)
            {
                <form method="post" asp-page-handler="Register" id="registerForm">
                    <input type="hidden" asp-for="Loopback" />
                    <input type="hidden" asp-for="PasskeyToken" />
                    <input type="hidden" asp-for="PasskeyResponse" id="passkeyResponse" />
                    <div class="field">
                        <label asp-for="NewName">New passkey name</label>
                        <input asp-for="NewName" placeholder="e.g. My laptop" autocomplete="off" autofocus />
                    </div>
                    <button type="button" id="addButton" class="btn-primary" data-options="@Model.RegisterOptionsJson">Add a passkey</button>
                </form>
            }

            @if (Model.Loopback is { } port)
            {
                <a class="done" href="http://127.0.0.1:@port/passkey-done?added=0">Done — return to SimplArchive</a>
            }
        </div>
    </main>

    <script src="/webauthn.js"></script>
    <script nonce="@SimplArchive.Api.Security.SecurityHeaders.Nonce(ViewContext.HttpContext)">
        (function () {
            var btn = document.getElementById('addButton');
            if (!btn) { return; }
            if (!window.simplArchiveWebAuthn || !window.simplArchiveWebAuthn.supported) {
                btn.disabled = true;
                btn.textContent = 'Passkeys are not supported in this browser';
                return;
            }
            btn.addEventListener('click', async function () {
                btn.disabled = true;
                try {
                    var attestation = await window.simplArchiveWebAuthn.register(btn.dataset.options);
                    document.getElementById('passkeyResponse').value = attestation;
                    document.getElementById('registerForm').submit();
                } catch (e) {
                    btn.disabled = false;
                    alert('Could not add the passkey: ' + (e && e.message ? e.message : e));
                }
            });
        })();
    </script>
</body>
</html>
