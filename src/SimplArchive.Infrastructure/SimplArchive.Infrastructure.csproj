<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\SimplArchive.Application\SimplArchive.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" Version="4.0.100.3" />
    <PackageReference Include="DiffPlex" Version="1.9.0" />
    <!-- Server-side preview renditions (TIFF -> PNG). NetVips is MIT; the native packages bundle libvips
         (LGPL-2.1+, dynamically linked) — both Apache-2.0-compatible. Both musl arches so the Alpine
         runtime image works whether built for x64 or arm64. See ADR "Server-side preview renditions". -->
    <PackageReference Include="NetVips" Version="3.2.0" />
    <PackageReference Include="NetVips.Native.linux-musl-x64" Version="8.18.4" />
    <PackageReference Include="NetVips.Native.linux-musl-arm64" Version="8.18.4" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.9" />
    <!-- Pin System.Security.Cryptography.Xml to the patched 10.0.10 — the DataProtection stack pulls 10.0.9
         transitively, which has High-severity advisories (NU1903). Same transitive-security-pin as Auth. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.9" />
    <!-- Email preview parsing (ADR "Email (.eml/.msg) preview"). Both MIT-licensed (Apache-2.0-compatible):
         MimeKit parses .eml, MSGReader parses Outlook .msg. -->
    <PackageReference Include="MimeKit" Version="4.17.0" />
    <!-- MailKit (MIT), MimeKit's SMTP companion — sends notification emails (ADR "Email notifications"). -->
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="MSGReader" Version="6.1.0" />
    <!-- Markdown -> HTML for the .md preview (ADR "CSV and Markdown preview"). BSD-2-Clause (Apache-2.0-compatible). -->
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.9" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="OpenIddict.EntityFrameworkCore" Version="7.5.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <PackageReference Include="UglyToad.PdfPig" Version="1.7.0-custom-5" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
