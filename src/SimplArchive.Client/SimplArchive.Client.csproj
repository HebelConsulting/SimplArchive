<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Disable WASM asset fingerprinting: the fingerprint placeholders in index.html
         (blazor.webassembly#[.{fingerprint}].js) are only resolved when the host injects a populated
         importmap via MapStaticAssets, but the Api serves the Client with UseBlazorFrameworkFiles +
         MapFallbackToFile, which don't — so the placeholder 404s and the app never boots. With
         fingerprinting off, index.html references the stable blazor.webassembly.js directly. See ADR 0211. -->
    <WasmFingerprintAssets>false</WasmFingerprintAssets>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.9" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Authentication" Version="10.0.9" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.9" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.9" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.9" />
    <PackageReference Include="MudBlazor" Version="9.7.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SimplArchive.Localization\SimplArchive.Localization.csproj" />
    <!-- The design tokens (ADR 0578): the MudTheme is built from them rather than being
         MudBlazor's stock palette. -->
    <ProjectReference Include="..\SimplArchive.Presentation\SimplArchive.Presentation.csproj" />
    <ProjectReference Include="..\SimplArchive.Theming\SimplArchive.Theming.csproj" />
  </ItemGroup>

</Project>
