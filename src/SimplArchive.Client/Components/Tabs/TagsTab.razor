@using System.Net
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject SimplArchive.Client.Services.ApiRoot ApiRoot
@inject IDialogService DialogService
@inject IJSRuntime JS

@* The Tags tab of the workbench (ADR "Tag controlled vocabulary"), extracted from Home.razor per ADR 0558:
   the tenant's tag catalogue — create, rename, recolour, retire, merge.

   It MANAGES the catalogue; the shell also READS it, for the index pane's autocomplete and the chip colours
   on list rows. So the tab raises CatalogChanged after every mutation rather than reaching into that state,
   and each side keeps what it is responsible for. *@

            @* The tenant tag catalog (ADR "Tag controlled vocabulary") — admin curation, in the Repositories
               shape (#530 tranche 6): [+ opens the create dialog, by decision — the inline form is gone] |
               [rename, recolour, merge acting on the selected row] | [retire SEPARATED, no error accent
               (ADR 0581)] | [refresh]. The row's ⋮ menu mirrors everything, row-addressed. *@
            <div class="wb-tags" style="height:100%; display:flex; flex-direction:column;">
                <div class="wb-search-bar pa-2" style="border-bottom:1px solid var(--mud-palette-lines-default);">
                    <MudButton Class="wb-rib-btn" Size="Size.Small" OnClick="NewTagAsync"
                               title="@Strings.Get("TagsAdd")" aria-label="@Strings.Get("TagsAdd")">
                        <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" /><span class="wb-rib-label">@Strings.Get("TagsAdd")</span>
                    </MudButton>
                    <MudButton Class="wb-rib-btn ml-3" Size="Size.Small" Disabled="@(_selected is null)" OnClick="@(() => RenameTagAsync(_selected!))"
                               title="@Strings.Get("RibbonRename")" aria-label="@Strings.Get("RibbonRename")">
                        <MudIcon Icon="@Icons.Material.Filled.Edit" Size="Size.Small" /><span class="wb-rib-label">@Strings.Get("RibbonRename")</span>
                    </MudButton>
                    <MudButton Class="wb-rib-btn" Size="Size.Small" Disabled="@(_selected is null)" OnClick="@(() => RecolourTagAsync(_selected!))"
                               title="@Strings.Get("TagsSetColour")" aria-label="@Strings.Get("TagsSetColour")">
                        <MudIcon Icon="@Icons.Material.Filled.Palette" Size="Size.Small" /><span class="wb-rib-label">@Strings.Get("TagsSetColour")</span>
                    </MudButton>
                    <MudButton Class="wb-rib-btn" Size="Size.Small" Disabled="@(_selected is null || _catalogTags.Count < 2)" OnClick="@(() => MergeTagFromDialogAsync(_selected!))"
                               title="@Strings.Get("TagsMergeInto")" aria-label="@Strings.Get("TagsMergeInto")">
                        <MudIcon Icon="@Icons.Material.Filled.CallMerge" Size="Size.Small" /><span class="wb-rib-label">@Strings.Get("TagsMergeInto")</span>
                    </MudButton>
                    <MudButton Class="wb-rib-btn ml-3" Size="Size.Small" Disabled="@(_selected is null)" OnClick="@(() => RetireTagAsync(_selected!))"
                               title="@Strings.Get("TagsRetire")" aria-label="@Strings.Get("TagsRetire")">
                        <MudIcon Icon="@Icons.Material.Filled.Delete" Size="Size.Small" /><span class="wb-rib-label">@Strings.Get("TagsRetire")</span>
                    </MudButton>
                    <MudButton Class="wb-rib-btn ml-3" Size="Size.Small" OnClick="LoadTagCatalogAsync"
                               title="@Strings.Get("RibbonRefresh")" aria-label="@Strings.Get("RibbonRefresh")">
                        <MudIcon Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" /><span class="wb-rib-label">@Strings.Get("RibbonRefresh")</span>
                    </MudButton>
                </div>
                @* The catalog description is information, not an action — its own line (the Retention shape). *@
                <div class="pa-2" style="border-bottom:1px solid var(--mud-palette-lines-default);">
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">@Strings.Get("TagsCatalogDesc")</MudText>
                </div>
                <div style="flex:1 1 auto; overflow:auto;">
                    <MudTable Items="_catalogTags" Dense="true" Hover="true" Bordered="false" Elevation="0" T="TagCatalogEntry"
                              Style="max-width:680px;"
                              OnRowClick="@((TableRowClickEventArgs<TagCatalogEntry> e) => _selected = e.Item)"
                              RowClassFunc="@((row, _) => row == _selected ? "wb-list-row-selected" : "")">
                        <HeaderContent>
                            <MudTh>@Strings.Get("TagsColTag")</MudTh>
                            <MudTh Style="width:1px;"></MudTh>
                        </HeaderContent>
                        <RowTemplate Context="row">
                            <MudTd><MudChip T="string" Size="Size.Small" Style="@ChipStyle(row.Color)">@row.Name</MudChip></MudTd>
                            @* What can be done to THIS row lives in its ⋮ menu (#521's split), row-addressed;
                               retire keeps its distance at the bottom. *@
                            <MudTd Style="text-align:right;" @onclick:stopPropagation="true">
                                <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true" AnchorOrigin="Origin.BottomLeft">
                                    <MudMenuItem Icon="@Icons.Material.Filled.Edit" OnClick="() => RenameTagAsync(row)">@Strings.Get("RibbonRename")</MudMenuItem>
                                    <MudMenuItem Icon="@Icons.Material.Filled.Palette" OnClick="() => RecolourTagAsync(row)">@Strings.Get("TagsSetColour")</MudMenuItem>
                                    @if (_catalogTags.Count > 1)
                                    {
                                        <MudMenuItem Icon="@Icons.Material.Filled.CallMerge" OnClick="() => MergeTagFromDialogAsync(row)">@Strings.Get("TagsMergeInto")</MudMenuItem>
                                    }
                                    <MudDivider />
                                    <MudMenuItem Icon="@Icons.Material.Filled.Delete" OnClick="() => RetireTagAsync(row)">@Strings.Get("TagsRetire")</MudMenuItem>
                                </MudMenu>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                    @if (_catalogTags.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Class="pa-3 mud-text-secondary">@Strings.Get("TagsEmpty")</MudText>
                    }
                </div>
            </div>
        

@code {
    /// <summary>
    /// Raised after the catalogue changes, so the shell can refresh what it uses the tags FOR — autocomplete
    /// in the index pane and the colours on list-row chips. The tab manages the catalogue; it does not own
    /// everyone else's copy of it (ADR 0558).
    /// </summary>
    [Parameter]
    public EventCallback CatalogChanged { get; set; }

    // The tab loads itself; SetTab's Tags branch is deleted rather than relocated (ADR 0558).
    protected override async Task OnInitializedAsync() => await LoadTagCatalogAsync();

    // ---- Tag catalog admin (ADR "Tag controlled vocabulary") ----------------------------------------
    private List<TagCatalogEntry> _catalogTags = [];
    private Dictionary<string, string?> _tagColors = new();

    /// <summary>The row the toolbar acts on (#530 tranche 6) — single-select.</summary>
    private TagCatalogEntry? _selected;

    private static string ChipStyle(string? color) => string.IsNullOrEmpty(color) ? "" : $"background:{color}; color:#fff;";
    private string? TagColor(string name) => _tagColors.TryGetValue(name, out var c) ? c : null;

    private async Task LoadTagCatalogAsync()
    {
        try
        {
            var resp = await Http.GetFromJsonAsync<TagsResponse>(await ApiRoot.RequireAsync("tags"));
            _catalogTags = resp?.Catalog ?? [];
            _tagColors = _catalogTags.ToDictionary(t => t.Name, t => t.Color);
            await CatalogChanged.InvokeAsync();
        }
        catch (Exception) { _catalogTags = []; }
    }

    // + opens the create dialog, by decision (#530 tranche 6) — the inline form is gone.
    private async Task NewTagAsync()
    {
        var dialog = await DialogService.ShowAsync<Dialogs.NewTagDialog>(Strings.Get("TagsAdd"));
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not Dialogs.NewTagDialog.NewTagResult tag)
        {
            return;
        }

        var resp = await Http.PostAsJsonAsync(await ApiRoot.RequireAsync("tags"), new { name = tag.Name, color = tag.Color });
        if (resp.IsSuccessStatusCode) await LoadTagCatalogAsync();
        else Snackbar.Add(Strings.Get(resp.StatusCode == HttpStatusCode.Conflict ? "StTagExists" : "StErrAddTag"), Severity.Warning);
    }

    // The toolbar and the ⋮ menu start merge with the target PICK (a dialog — a second pick is needed
    // wherever merge starts); the confirm + POST stay in MergeTagAsync.
    private async Task MergeTagFromDialogAsync(TagCatalogEntry from)
    {
        var parameters = new DialogParameters
        {
            [nameof(Dialogs.MergeTagDialog.Candidates)] = _catalogTags.Where(x => x.Id != from.Id).Select(x => (x.Id, x.Name)).ToList(),
        };
        var dialog = await DialogService.ShowAsync<Dialogs.MergeTagDialog>(Strings.Get("TagsMergeInto"), parameters);
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not Guid targetId
            || _catalogTags.FirstOrDefault(x => x.Id == targetId) is not { } into)
        {
            return;
        }

        await MergeTagAsync(from, into);
    }

    private async Task RenameTagAsync(TagCatalogEntry t)
    {
        var name = await JS.InvokeAsync<string?>("prompt", "Rename tag (documents are re-tagged):", t.Name);
        if (string.IsNullOrWhiteSpace(name) || name.Trim() == t.Name) return;
        if (t.Href("self") is not { } renameHref) { return; }

        var resp = await Http.PutAsJsonAsync(renameHref, new { name = name.Trim() });
        if (resp.IsSuccessStatusCode) await LoadTagCatalogAsync();
        else Snackbar.Add(Strings.Get("StErrRenameTaken"), Severity.Warning);
    }

    private async Task RecolourTagAsync(TagCatalogEntry t)
    {
        var color = await JS.InvokeAsync<string?>("prompt", "Tag colour as #RRGGBB (blank to clear):", t.Color ?? "");
        if (color is null) return;
        if (t.Href("self") is not { } recolourHref) { return; }

        var resp = await Http.PutAsJsonAsync(recolourHref, new { color = color.Trim() });
        if (resp.IsSuccessStatusCode) await LoadTagCatalogAsync();
        else Snackbar.Add(Strings.Get("StErrSetColour"), Severity.Warning);
    }

    private async Task RetireTagAsync(TagCatalogEntry t)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"Retire '{t.Name}'? It stays on documents that already have it but won't be offered for new tagging.")) return;
        if (t.Href("retire") is not { } retireHref) { return; }

        await Http.DeleteAsync(retireHref);
        await LoadTagCatalogAsync();
    }

    private async Task MergeTagAsync(TagCatalogEntry from, TagCatalogEntry into)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"Merge '{from.Name}' into '{into.Name}'? Every document tagged '{from.Name}' becomes '{into.Name}', and '{from.Name}' is removed from the catalog.")) return;
        if (from.Href("merge") is not { } mergeHref) { return; }

        await Http.PostAsJsonAsync(mergeHref, new { intoId = into.Id });
        await LoadTagCatalogAsync();
    }
}
