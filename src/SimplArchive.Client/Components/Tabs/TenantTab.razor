    // Bytes → a human "N.N MB" / "N.N GB" for the storage-usage line (ADR "Per-tenant storage quota").
    private static string FormatBytes(long bytes) => bytes switch
    {
        >= 1L << 30 => $"{bytes / (double)(1L << 30):0.##} GB",
        _ => $"{bytes / (double)(1L << 20):0.##} MB",
    };

    // Storage soft-quota indicator (ADR "Storage soft-quota warnings") — percent used + a level matching the
    // server's 80%/95% warning thresholds (0 = below, 1 = approaching, 2 = almost full).
    private int StoragePercent() => _tenant?.StorageQuotaBytes is { } q && q > 0 ? (int)(_tenant.StorageUsedBytes * 100 / q) : 0;
    private int StorageLevel() { var p = StoragePercent(); return p >= 95 ? 2 : p >= 80 ? 1 : 0; }
}
