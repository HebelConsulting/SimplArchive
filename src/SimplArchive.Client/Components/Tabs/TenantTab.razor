@using System.Net
@inject HttpClient Http
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject SimplArchive.Client.Services.ApiRoot ApiRoot
@inject SimplArchive.Client.Services.OcrLanguageCatalog OcrLanguages

@* The Tenant-admin settings tab (ADR "Tenant-admin settings tab"), extracted from Home.razor per ADR 0558.

   Self-service tenant configuration: retention, MFA policy, OCR defaults, quotas and the rest, read-only until
   Edit. Two ribbon-style actions beside the header stay with the shell and arrive as callbacks, because both
   reach state this tab does not own — creating a repository refreshes the tree, and editing the sensitivity
   labels refreshes the detail pane's picker. *@

@* Tenant-admin self-service settings (ADR "Tenant-admin settings tab"): read-only until Edit,
   then Save/Cancel. Plus a New repository button. Gated on isTenantAdmin. *@
<div class="wb-tenant pa-4" style="overflow:auto; max-width:720px;">
    <div style="display:flex; align-items:center; gap:8px; margin-bottom:14px;">
        <MudText Typo="Typo.h6">@Strings.Get("TenantHeader")</MudText>
        @if (!_tenantEditing)
        {
            <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.Edit" OnClick="BeginTenantEdit" Disabled="@(_tenant is null)">@Strings.Get("Edit")</MudButton>
        }
        else
        {
            <MudButton Size="Size.Small" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveTenantSettingsAsync">@Strings.Get("Save")</MudButton>
            <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.Close" OnClick="CancelTenantEdit">@Strings.Get("Cancel")</MudButton>
        }
        <MudSpacer />
        <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Shield" OnClick="@(() => ManageSensitivityLabels.InvokeAsync())">@Strings.Get("TenantSensitivityLabels")</MudButton>
        <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.CreateNewFolder" OnClick="@(() => NewRepository.InvokeAsync())">@Strings.Get("TenantNewRepository")</MudButton>
    </div>
    @if (_tenant is not null)
    {
        <div class="wb-setting-row mb-3">
            <MudTextField T="string" Label="@Strings.Get("TenantNameLabel")" @bind-Value="_tenantEdit.Name" Disabled="@(!_tenantEditing)" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" />
            <InfoButton Text="@(Strings.Get("TenantNameInfo"))" />
        </div>

        <div class="wb-setting-row mb-3">
            <MudSelect T="string" Label="@Strings.Get("TenantOcrLabel")" MultiSelection="true" @bind-SelectedValues="_tenantEditOcr"
                       Disabled="@(!_tenantEditing)" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1"
                       MultiSelectionTextFunc="@(v => string.Join(", ", v))">
                @foreach (var lang in _ocrCatalog)
                {
                    <MudSelectItem T="string" Value="@lang.Code">@lang.DisplayName (@lang.Code)</MudSelectItem>
                }
            </MudSelect>
            <InfoButton Text="@(Strings.Get("TenantOcrInfo"))" />
        </div>

        <div class="wb-setting-row mb-3">
            <MudNumericField T="int" Label="@Strings.Get("TenantAuditRetLabel")" @bind-Value="_tenantEdit.AuditRetentionDays"
                             Disabled="@(!_tenantEditing)" Min="0" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" />
            <InfoButton Text="@(Strings.Get("TenantAuditRetInfo"))" />
        </div>

        <div class="wb-setting-row mb-3">
            <MudNumericField T="int" Label="@Strings.Get("TenantCoTtlLabel")" @bind-Value="_tenantEdit.CheckoutTtlDays"
                             Disabled="@(!_tenantEditing)" Min="0" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" />
            <InfoButton Text="@(Strings.Get("TenantCoTtlInfo"))" />
        </div>

        <div class="wb-setting-row mb-3">
            <MudNumericField T="int" Label="@Strings.Get("TenantCoWarnLabel")" @bind-Value="_tenantEdit.CheckoutWarningDays"
                             Disabled="@(!_tenantEditing)" Min="0" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" />
            <InfoButton Text="@(Strings.Get("TenantCoWarnInfo"))" />
        </div>

        <div class="wb-setting-row mb-4">
            <MudSelect T="int" Label="@Strings.Get("TenantWormLabel")" @bind-Value="_tenantEdit.WormLockMode"
                       Disabled="@(!_tenantEditing)" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1">
                <MudSelectItem T="int" Value="0">@Strings.Get("TenantWormGovernance")</MudSelectItem>
                <MudSelectItem T="int" Value="1">@Strings.Get("TenantWormCompliance")</MudSelectItem>
            </MudSelect>
            <InfoButton Text="@(Strings.Get("TenantWormInfo"))" />
        </div>

        <div class="wb-setting-row mb-1">
            <MudNumericField T="int?" Label="@Strings.Get("TenantQuotaLabel")" @bind-Value="_tenantEdit.StorageQuotaMb"
                             Disabled="@(!_tenantEditing)" Min="0" Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" />
            <InfoButton Text="@(Strings.Get("TenantQuotaInfo"))" />
        </div>
        <div class="wb-setting-row mb-4" style="align-items:center; gap:8px;">
            <MudText Typo="Typo.body2" Class="mud-text-secondary flex-grow-1">
                @string.Format(Strings.Get("TenantUsed"), FormatBytes(_tenant.StorageUsedBytes))@(_tenant.StorageQuotaBytes is { } q ? string.Format(Strings.Get("TenantUsedOf"), FormatBytes(q), StoragePercent()) : Strings.Get("TenantNoLimit"))
                @if (StorageLevel() == 1)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Class="ml-2">@Strings.Get("TenantApproachingQuota")</MudChip>
                }
                else if (StorageLevel() == 2)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Error" Class="ml-2">@Strings.Get("TenantAlmostFull")</MudChip>
                }
            </MudText>
            <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Refresh" OnClick="RecomputeStorageAsync">@Strings.Get("TenantRecompute")</MudButton>
            <InfoButton Text="@(Strings.Get("TenantRecomputeInfo"))" />
        </div>

        <div class="wb-setting-row mb-4">
            <MudNumericField T="int" Label="@Strings.Get("TenantUploadCleanupLabel")" @bind-Value="_tenantEdit.IncompleteUploadCleanupDays"
                             Disabled="@(!_tenantEditing)" Min="0" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" />
            <InfoButton Text="@(Strings.Get("TenantUploadCleanupInfo"))" />
        </div>

        <div class="wb-setting-row mb-4">
            <MudSwitch T="bool" @bind-Value="_tenantEdit.RequireMfa" Disabled="@(!_tenantEditing)" Color="Color.Primary" Class="flex-grow-1"
                       Label="@Strings.Get("TenantRequireMfa")" />
            <InfoButton Text="@(Strings.Get("TenantRequireMfaInfo"))" />
        </div>

        <div class="wb-setting-row mb-4">
            <MudSwitch T="bool" @bind-Value="_tenantEdit.AllowPasskeyLogin" Disabled="@(!_tenantEditing)" Color="Color.Primary" Class="flex-grow-1"
                       Label="@Strings.Get("TenantAllowPasskey")" />
            <InfoButton Text="@(Strings.Get("TenantAllowPasskeyInfo"))" />
        </div>

        <div class="wb-setting-row mb-4">
            <MudSwitch T="bool" @bind-Value="_tenantEdit.RequireDispositionReview" Disabled="@(!_tenantEditing)" Color="Color.Primary" Class="flex-grow-1"
                       Label="@Strings.Get("TenantRequireDisposition")" />
            <InfoButton Text="@(Strings.Get("TenantRequireDispositionInfo"))" />
        </div>

        <div class="wb-setting-row mb-4">
            <MudSwitch T="bool" @bind-Value="_tenantEdit.RestrictTagsToCatalog" Disabled="@(!_tenantEditing)" Color="Color.Primary" Class="flex-grow-1"
                       Label="@Strings.Get("TenantRestrictTags")" />
            <InfoButton Text="@(Strings.Get("TenantRestrictTagsInfo"))" />
        </div>

        <div class="wb-setting-row mb-4">
            <MudSwitch T="bool" @bind-Value="_tenantEdit.EnforceClearance" Disabled="@(!_tenantEditing)" Color="Color.Primary" Class="flex-grow-1"
                       Label="@Strings.Get("TenantEnforceClearance")" />
            <InfoButton Text="@(Strings.Get("TenantEnforceClearanceInfo"))" />
        </div>

        @* External links (ADR 0546). Off by default: this is the switch that opens an
           unauthenticated way for documents to leave the tenant, so it is opted into rather than
           inherited. The caps only matter once it is on, hence the nesting. *@
        <div class="wb-setting-row mb-2">
            <MudSwitch T="bool" @bind-Value="_tenantEdit.AllowExternalLinks" Disabled="@(!_tenantEditing)" Color="Color.Primary" Class="flex-grow-1"
                       Label="@Strings.Get("TenantAllowExternalLinks")" />
            <InfoButton Text="@(Strings.Get("TenantAllowExternalLinksInfo"))" />
        </div>
        @if (_tenantEdit.AllowExternalLinks)
        {
            <div class="wb-setting-row mb-2">
                <MudNumericField T="int" @bind-Value="_tenantEdit.ExternalLinkMaxDays" Min="1" Max="3650"
                                 Label="@Strings.Get("TenantExtLinkMaxDays")" Disabled="@(!_tenantEditing)"
                                 Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" />
            </div>
            <div class="wb-setting-row mb-2">
                <MudNumericField T="int" @bind-Value="_tenantEdit.ExternalLinkDefaultAccesses" Min="1" Max="1000"
                                 Label="@Strings.Get("TenantExtLinkDefaultAccesses")" Disabled="@(!_tenantEditing)"
                                 Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" />
            </div>
            <div class="wb-setting-row mb-4">
                <MudSwitch T="bool" @bind-Value="_tenantEdit.ShowExternalLinkUrl" Disabled="@(!_tenantEditing)" Color="Color.Primary" Class="flex-grow-1"
                           Label="@Strings.Get("TenantShowExternalLinkUrl")" />
                <InfoButton Text="@(Strings.Get("TenantShowExternalLinkUrlInfo"))" />
            </div>
        }

        <div class="wb-setting-row mb-2">
            <MudTextField T="string" Label="@Strings.Get("TenantWebhookUrlLabel")" @bind-Value="_tenantEdit.AuditWebhookUrl"
                          Disabled="@(!_tenantEditing)" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1"
                          Placeholder="https://siem.example.com/ingest" />
            <InfoButton Text="@(Strings.Get("TenantWebhookUrlInfo"))" />
        </div>
        @if (_tenantEditing)
        {
            <div class="wb-setting-row mb-2">
                <MudTextField T="string" Label="@(_tenant.AuditWebhookConfigured ? Strings.Get("TenantSecretLabelKeep") : Strings.Get("TenantSecretLabel"))"
                              @bind-Value="_tenantEdit.AuditWebhookSecret" InputType="InputType.Password"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" />
                <InfoButton Text="@(Strings.Get("TenantSecretInfo"))" />
            </div>
        }
        else
        {
            <div class="wb-setting-row mb-1" style="align-items:center; gap:8px;">
                <MudText Typo="Typo.body2" Class="mud-text-secondary flex-grow-1">
                    @(_tenant.AuditWebhookConfigured ? Strings.Get("TenantSecretConfigured") : Strings.Get("TenantSecretNotSet"))
                </MudText>
                @if (_tenant.AuditWebhookUrl is not null && _tenant.AuditWebhookConfigured)
                {
                    <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Send" OnClick="TestWebhookAsync">@Strings.Get("TenantSendTest")</MudButton>
                }
            </div>
            @if (_tenant.AuditWebhookUrl is not null)
            {
                <div class="wb-setting-row mb-4">
                    @if (_tenant.AuditWebhookConsecutiveFailures == 0)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Success" Class="flex-grow-1">
                            @Strings.Get("TenantDeliveryHealthy")@(_tenant.AuditWebhookLastSuccessAt is { } s ? string.Format(Strings.Get("TenantLastSuccess"), s.ToLocalTime().ToString("g")) : "")
                        </MudText>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Color="Color.Warning" Class="flex-grow-1">
                            @Strings.Get("TenantDeliveryFailing") @string.Format(_tenant.AuditWebhookConsecutiveFailures == 1 ? Strings.Get("TenantConsecFailure") : Strings.Get("TenantConsecFailures"), _tenant.AuditWebhookConsecutiveFailures)@(_tenant.AuditWebhookLastError is { } e ? $" ({e})" : "")@(_tenant.AuditWebhookNextAttemptAt is { } n ? string.Format(Strings.Get("TenantNextRetry"), n.ToLocalTime().ToString("g")) : "")@(_tenant.AuditWebhookLastSuccessAt is { } s2 ? string.Format(Strings.Get("TenantLastSuccessSemi"), s2.ToLocalTime().ToString("g")) : Strings.Get("TenantNeverDelivered"))
                        </MudText>
                    }
                    <InfoButton Text="@(Strings.Get("TenantDeliveryInfo"))" />
                </div>
            }
        }

        <MudDivider Class="mb-3" />
        <MudText Typo="Typo.subtitle2" Class="mb-1 mud-text-secondary">@Strings.Get("TenantReference")</MudText>
        <MudSimpleTable Dense="true" Bordered="false" Elevation="0">
            <tbody>
                <tr><td class="mud-text-secondary" style="width:140px;">@Strings.Get("TenantIdLabel")</td><td>@_tenant.Id</td></tr>
                <tr><td class="mud-text-secondary">@Strings.Get("TenantStatusLabel")</td><td>@_tenant.Status</td></tr>
                <tr><td class="mud-text-secondary">@Strings.Get("TenantCreatedLabel")</td><td>@_tenant.CreatedAt.LocalDateTime.ToString("yyyy-MM-dd HH:mm")</td></tr>
            </tbody>
        </MudSimpleTable>
    }
</div>

@code {
    /// <summary>Create a repository — the shell owns the tree this adds a root to.</summary>
    [Parameter]
    public EventCallback NewRepository { get; set; }

    /// <summary>Open the sensitivity-labels editor — the shell refreshes its picker afterwards.</summary>
    [Parameter]
    public EventCallback ManageSensitivityLabels { get; set; }

    // The tenant resource's own advertised addresses, captured when its settings are read (ADR 0557).
    private IReadOnlyDictionary<string, string>? _tenantLinks;

    private IReadOnlyList<OcrLanguageOption> _ocrCatalog = [];

    // The tab loads itself; the shell's activation branch is deleted, not relocated (ADR 0558 rule 3).
    protected override async Task OnInitializedAsync()
    {
        await LoadTenantSettingsAsync();
        _ocrCatalog = await OcrLanguages.GetAsync();
    }


    // A small info "button" (hover tooltip) shown next to a setting that needs explanation.
    private TenantSettingsDto? _tenant;
    private TenantSettingsEdit _tenantEdit = new();
    private IReadOnlyCollection<string> _tenantEditOcr = new HashSet<string>();
    private bool _tenantEditing;

    private async Task LoadTenantSettingsAsync()
    {
        _tenantEditing = false;
        try
        {
            _tenant = await Http.GetFromJsonAsync<TenantSettingsDto>(await ApiRoot.RequireAsync("tenantSettings"));
            _tenantLinks = Links.RelMap(_tenant?.Links);
            if (_ocrCatalog.Count == 0)
            {
                _ocrCatalog = (await Http.GetFromJsonAsync<OcrCatalogResponse>(await ApiRoot.RequireAsync("ocrLanguages")))?.Languages ?? [];
            }
            SyncTenantEditFromTenant(); // the read-only fields bind to _tenantEdit too, so keep it in sync
        }
        catch (Exception)
        {
            _tenant = null;
        }
    }

    // The read-only view and the edit form share the _tenantEdit binding, so it mirrors _tenant except while
    // the user is actively editing (BeginTenantEdit → Save/Cancel).
    private void SyncTenantEditFromTenant()
    {
        if (_tenant is null) return;
        _tenantEdit = new TenantSettingsEdit { Name = _tenant.Name, AuditRetentionDays = _tenant.AuditRetentionDays, CheckoutTtlDays = _tenant.CheckoutTtlDays, CheckoutWarningDays = _tenant.CheckoutWarningDays, WormLockMode = _tenant.WormLockMode, RequireMfa = _tenant.RequireMfa, AllowPasskeyLogin = _tenant.AllowPasskeyLogin, RequireDispositionReview = _tenant.RequireDispositionReview, RestrictTagsToCatalog = _tenant.RestrictTagsToCatalog, EnforceClearance = _tenant.EnforceClearance, AllowExternalLinks = _tenant.AllowExternalLinks, ShowExternalLinkUrl = _tenant.ShowExternalLinkUrl, ExternalLinkMaxDays = _tenant.ExternalLinkMaxDays, ExternalLinkDefaultAccesses = _tenant.ExternalLinkDefaultAccesses, StorageQuotaMb = _tenant.StorageQuotaBytes is { } b ? (int)(b / (1024 * 1024)) : null, IncompleteUploadCleanupDays = _tenant.IncompleteUploadCleanupDays, AuditWebhookUrl = _tenant.AuditWebhookUrl, AuditWebhookSecret = null };
        _tenantEditOcr = new HashSet<string>(_tenant.DefaultOcrLanguages.Split('+', StringSplitOptions.RemoveEmptyEntries));
    }

    private void BeginTenantEdit()
    {
        if (_tenant is null) return;
        SyncTenantEditFromTenant();
        _tenantEditing = true;
    }

    private void CancelTenantEdit()
    {
        SyncTenantEditFromTenant(); // discard in-flight edits back to the persisted values
        _tenantEditing = false;
    }

    private async Task SaveTenantSettingsAsync()
    {
        // Preserve the catalog order for the "+"-joined default (a stable priority).
        var ocr = string.Join('+', _ocrCatalog.Select(l => l.Code).Where(c => _tenantEditOcr.Contains(c)));
        var webhookUrl = string.IsNullOrWhiteSpace(_tenantEdit.AuditWebhookUrl) ? null : _tenantEdit.AuditWebhookUrl.Trim();
        var webhookSecret = string.IsNullOrWhiteSpace(_tenantEdit.AuditWebhookSecret) ? null : _tenantEdit.AuditWebhookSecret;
        long? storageQuotaBytes = _tenantEdit.StorageQuotaMb is { } mb ? (long)mb * 1024 * 1024 : null;
        var body = new { name = _tenantEdit.Name, defaultOcrLanguages = ocr, auditRetentionDays = _tenantEdit.AuditRetentionDays, checkoutTtlDays = _tenantEdit.CheckoutTtlDays, checkoutWarningDays = _tenantEdit.CheckoutWarningDays, wormLockMode = _tenantEdit.WormLockMode, requireMfa = _tenantEdit.RequireMfa, allowPasskeyLogin = _tenantEdit.AllowPasskeyLogin, requireDispositionReview = _tenantEdit.RequireDispositionReview, restrictTagsToCatalog = _tenantEdit.RestrictTagsToCatalog, enforceClearance = _tenantEdit.EnforceClearance, allowExternalLinks = _tenantEdit.AllowExternalLinks, showExternalLinkUrl = _tenantEdit.ShowExternalLinkUrl, externalLinkMaxDays = _tenantEdit.ExternalLinkMaxDays, externalLinkDefaultAccesses = _tenantEdit.ExternalLinkDefaultAccesses, storageQuotaBytes, incompleteUploadCleanupDays = _tenantEdit.IncompleteUploadCleanupDays, auditWebhookUrl = webhookUrl, auditWebhookSecret = webhookSecret };
        var resp = await Http.PutAsJsonAsync(await ApiRoot.RequireAsync("tenantSettings"), body);
        if (resp.StatusCode == System.Net.HttpStatusCode.Conflict) { Snackbar.Add(Strings.Get("StTenantNameTaken"), Severity.Warning); return; }
        if (resp.StatusCode == System.Net.HttpStatusCode.BadRequest) { Snackbar.Add(Strings.Get("StTenantCheckFields"), Severity.Warning); return; }
        if (!resp.IsSuccessStatusCode) { Snackbar.Add(Strings.Get("StErrSaveSettings"), Severity.Error); return; }
        _tenant = await resp.Content.ReadFromJsonAsync<TenantSettingsDto>();
        SyncTenantEditFromTenant();
        _tenantEditing = false;
        Snackbar.Add(Strings.Get("StTenantSaved"), Severity.Success);
    }

    private async Task TestWebhookAsync()
    {
        if (_tenantLinks?.GetValueOrDefault("audit-webhook-test") is not { } webhookTestHref) { return; }

        var resp = await Http.PostAsync(webhookTestHref, null);
        if (resp.StatusCode == System.Net.HttpStatusCode.BadRequest) { Snackbar.Add(Strings.Get("StSaveWebhookFirst"), Severity.Warning); return; }
        if (!resp.IsSuccessStatusCode) { Snackbar.Add(Strings.Get("StErrTestEvent"), Severity.Error); return; }
        var result = await resp.Content.ReadFromJsonAsync<TestWebhookResult>();
        if (result?.Success == true) Snackbar.Add(Strings.Get("StTestEventDelivered"), Severity.Success);
        else Snackbar.Add(string.Format(Strings.Get("StTestDeliveryFailed"), result?.Error ?? "unknown error"), Severity.Warning);
    }

    private record TestWebhookResult { public bool Success { get; set; } public string? Error { get; set; } }

    private async Task RecomputeStorageAsync()
    {
        if (_tenantLinks?.GetValueOrDefault("recompute-storage") is not { } recomputeHref) { return; }

        var resp = await Http.PostAsync(recomputeHref, null);
        if (!resp.IsSuccessStatusCode) { Snackbar.Add(Strings.Get("StErrRecompute"), Severity.Error); return; }
        _tenant = await resp.Content.ReadFromJsonAsync<TenantSettingsDto>();
        if (!_tenantEditing) SyncTenantEditFromTenant();
        Snackbar.Add(Strings.Get("StStorageRecomputed"), Severity.Success);
    }

    // Manage the tenant's configurable sensitivity labels (ADR "Configurable sensitivity labels + upload
    // defaults"); reload the picker list on close so a detail-pane edit sees any changes.


    private record TenantSettingsDto
    {
        // The settings resource advertises its own maintenance actions (issue #416).
        public List<LinkResponse> Links { get; set; } = [];

        // External links (ADR 0546) — the tenant master switch plus its two caps.
        public bool AllowExternalLinks { get; set; }

        public bool ShowExternalLinkUrl { get; set; }
        public int ExternalLinkMaxDays { get; set; } = 180;
        public int ExternalLinkDefaultAccesses { get; set; } = 5;

        public Guid Id { get; set; }
        public string Name { get; set; } = "";
        public string Status { get; set; } = "";
        public DateTimeOffset CreatedAt { get; set; }
        public string DefaultOcrLanguages { get; set; } = "";
        public int AuditRetentionDays { get; set; }
        public int CheckoutTtlDays { get; set; }
        public int CheckoutWarningDays { get; set; } = 1;
        public int WormLockMode { get; set; }
        public bool RequireMfa { get; set; }
        public bool AllowPasskeyLogin { get; set; }
        public bool RequireDispositionReview { get; set; }
        public bool RestrictTagsToCatalog { get; set; }
        public bool EnforceClearance { get; set; }
        public long? StorageQuotaBytes { get; set; }
        public long StorageUsedBytes { get; set; }

        // (Storage-warning indicator is computed by StoragePercent/StorageLevel below.)
        public int IncompleteUploadCleanupDays { get; set; }
        public string? AuditWebhookUrl { get; set; }
        public bool AuditWebhookConfigured { get; set; }
        public int AuditWebhookConsecutiveFailures { get; set; }
        public DateTimeOffset? AuditWebhookLastSuccessAt { get; set; }
        public DateTimeOffset? AuditWebhookLastFailureAt { get; set; }
        public DateTimeOffset? AuditWebhookNextAttemptAt { get; set; }
        public string? AuditWebhookLastError { get; set; }
    }

    private class TenantSettingsEdit
    {
        public string Name { get; set; } = "";
        // External links (ADR 0546).
        public bool AllowExternalLinks { get; set; }

        public bool ShowExternalLinkUrl { get; set; }
        public int ExternalLinkMaxDays { get; set; } = 180;
        public int ExternalLinkDefaultAccesses { get; set; } = 5;
        public int AuditRetentionDays { get; set; }
        public int CheckoutTtlDays { get; set; }
        public int CheckoutWarningDays { get; set; } = 1;
        public int WormLockMode { get; set; }
        public bool RequireMfa { get; set; }
        public bool AllowPasskeyLogin { get; set; }
        public bool RequireDispositionReview { get; set; }
        public bool RestrictTagsToCatalog { get; set; }
        public bool EnforceClearance { get; set; }
        public int? StorageQuotaMb { get; set; }
        public int IncompleteUploadCleanupDays { get; set; }
        public string? AuditWebhookUrl { get; set; }
        public string? AuditWebhookSecret { get; set; }
    }

    // Bytes → a human "N.N MB" / "N.N GB" for the storage-usage line (ADR "Per-tenant storage quota").
    private static string FormatBytes(long bytes) => bytes switch
    {
        >= 1L << 30 => $"{bytes / (double)(1L << 30):0.##} GB",
        _ => $"{bytes / (double)(1L << 20):0.##} MB",
    };

    // Storage soft-quota indicator (ADR "Storage soft-quota warnings") — percent used + a level matching the
    // server's 80%/95% warning thresholds (0 = below, 1 = approaching, 2 = almost full).
    private int StoragePercent() => _tenant?.StorageQuotaBytes is { } q && q > 0 ? (int)(_tenant.StorageUsedBytes * 100 / q) : 0;
    private int StorageLevel() { var p = StoragePercent(); return p >= 95 ? 2 : p >= 80 ? 1 : 0; }

}
