@using System.Net
@inject HttpClient Http
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject SimplArchive.Client.Services.ApiRoot ApiRoot
@inject SimplArchive.Client.Services.OcrLanguageCatalog OcrLanguages

@* The Tenant-admin settings tab (ADR "Tenant-admin settings tab" + "Per-group tenant settings", #530
   tranche 10), extracted from Home.razor per ADR 0558.

   The decided shape: a toolbar with the three tab-level launchers; the tenant's REFERENCE card first — you see
   what you are administering before how it is configured; then one group per settings category, each read-only
   with its own pencil → Save/Cancel in the same header row (ADR 0550). A group's Save PUTs exactly its own
   fields to the settings-<group> rel the server advertised, and produces its own scoped audit event — the old
   tab-wide Edit and the full-settings PUT are gone. The three launchers stay with the shell and arrive as
   callbacks, because each reaches state this tab does not own. *@
<div class="wb-tenant-wrap" style="flex:1 1 auto; min-height:0; display:flex; flex-direction:column;">
    <div class="wb-search-bar pa-2" style="border-bottom:1px solid var(--mud-palette-lines-default);">
        <MudButton Class="wb-rib-btn" Size="Size.Small" OnClick="@(() => ManageSensitivityLabels.InvokeAsync())"
                   title="@Strings.Get("TenantSensitivityLabels")" aria-label="@Strings.Get("TenantSensitivityLabels")">
            <MudIcon Icon="@Icons.Material.Filled.Shield" Size="Size.Small" /><span class="wb-rib-label">@Strings.Get("TenantSensitivityLabels")</span>
        </MudButton>
        <MudButton Class="wb-rib-btn" Size="Size.Small" OnClick="OpenMailDomainsAsync"
                   title="@Strings.Get("MdTitle")" aria-label="@Strings.Get("MdTitle")">
            <MudIcon Icon="@Icons.Material.Filled.AlternateEmail" Size="Size.Small" /><span class="wb-rib-label">@Strings.Get("MdTitle")</span>
        </MudButton>
        <MudButton Class="wb-rib-btn" Size="Size.Small" OnClick="@(() => NewRepository.InvokeAsync())"
                   title="@Strings.Get("TenantNewRepository")" aria-label="@Strings.Get("TenantNewRepository")">
            <MudIcon Icon="@Icons.Material.Filled.CreateNewFolder" Size="Size.Small" /><span class="wb-rib-label">@Strings.Get("TenantNewRepository")</span>
        </MudButton>
        <MudButton Class="wb-rib-btn ml-3" Size="Size.Small" OnClick="@(() => ConvertScans.InvokeAsync())"
                   title="@Strings.Get("RibbonConvertScans")" aria-label="@Strings.Get("RibbonConvertScans")">
            <MudIcon Icon="@Icons.Material.Filled.PictureAsPdf" Size="Size.Small" /><span class="wb-rib-label">@Strings.Get("RibbonConvertScans")</span>
        </MudButton>
    </div>
    <div class="wb-tenant pa-4" style="flex:1 1 auto; min-height:0; overflow:auto; max-width:720px;">
    @if (_tenant is not null)
    {
        @* The tenant's detail information first, by decision — the reference card. *@
        <MudText Typo="Typo.subtitle2" Class="mb-1 mud-text-secondary">@Strings.Get("TenantReference")</MudText>
        <MudSimpleTable Dense="true" Bordered="false" Elevation="0" Class="mb-4">
            <tbody>
                <tr><td class="mud-text-secondary" style="width:140px;">@Strings.Get("TenantIdLabel")</td><td>@_tenant.Id</td></tr>
                <tr><td class="mud-text-secondary">@Strings.Get("TenantStatusLabel")</td><td>@_tenant.Status</td></tr>
                <tr><td class="mud-text-secondary">@Strings.Get("TenantCreatedLabel")</td><td>@_tenant.CreatedAt.LocalDateTime.ToString("yyyy-MM-dd HH:mm")</td></tr>
            </tbody>
        </MudSimpleTable>

        @* ---- General ------------------------------------------------------------------------------ *@
        @GroupHeader("general", Strings.Get("TenantGroupGeneral"))
        <div class="wb-setting-row mb-4">
            <MudTextField T="string" Label="@Strings.Get("TenantNameLabel")" @bind-Value="_tenantEdit.Name" Disabled="@(!Editing("general"))" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" />
            <InfoButton Text="@(Strings.Get("TenantNameInfo"))" />
        </div>

        @* ---- Documents & capture ------------------------------------------------------------------ *@
        @GroupHeader("capture", Strings.Get("TenantGroupCapture"))
        <div class="wb-setting-row mb-3">
            <MudSelect T="string" Label="@Strings.Get("TenantOcrLabel")" MultiSelection="true" @bind-SelectedValues="_tenantEditOcr"
                       Disabled="@(!Editing("capture"))" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1"
                       MultiSelectionTextFunc="@(v => string.Join(", ", v))">
                @foreach (var lang in _ocrCatalog)
                {
                    <MudSelectItem T="string" Value="@lang.Code">@lang.DisplayName (@lang.Code)</MudSelectItem>
                }
            </MudSelect>
            <InfoButton Text="@(Strings.Get("TenantOcrInfo"))" />
        </div>
        <div class="wb-setting-row mb-4">
            <MudSwitch T="bool" @bind-Value="_tenantEdit.RestrictTagsToCatalog" Disabled="@(!Editing("capture"))" Color="Color.Primary" Class="flex-grow-1"
                       Label="@Strings.Get("TenantRestrictTags")" />
            <InfoButton Text="@(Strings.Get("TenantRestrictTagsInfo"))" />
        </div>

        @* ---- Security & sign-in ------------------------------------------------------------------- *@
        @GroupHeader("security", Strings.Get("TenantGroupSecurity"))
        <div class="wb-setting-row mb-3">
            <MudSwitch T="bool" @bind-Value="_tenantEdit.RequireMfa" Disabled="@(!Editing("security"))" Color="Color.Primary" Class="flex-grow-1"
                       Label="@Strings.Get("TenantRequireMfa")" />
            <InfoButton Text="@(Strings.Get("TenantRequireMfaInfo"))" />
        </div>
        <div class="wb-setting-row mb-3">
            <MudSwitch T="bool" @bind-Value="_tenantEdit.AllowPasskeyLogin" Disabled="@(!Editing("security"))" Color="Color.Primary" Class="flex-grow-1"
                       Label="@Strings.Get("TenantAllowPasskey")" />
            <InfoButton Text="@(Strings.Get("TenantAllowPasskeyInfo"))" />
        </div>
        <div class="wb-setting-row mb-4">
            <MudSwitch T="bool" @bind-Value="_tenantEdit.EnforceClearance" Disabled="@(!Editing("security"))" Color="Color.Primary" Class="flex-grow-1"
                       Label="@Strings.Get("TenantEnforceClearance")" />
            <InfoButton Text="@(Strings.Get("TenantEnforceClearanceInfo"))" />
        </div>

        @* ---- Records & compliance ----------------------------------------------------------------- *@
        @GroupHeader("records", Strings.Get("TenantGroupRecords"))
        <div class="wb-setting-row mb-3">
            <MudNumericField T="int" Label="@Strings.Get("TenantAuditRetLabel")" @bind-Value="_tenantEdit.AuditRetentionDays"
                             Disabled="@(!Editing("records"))" Min="0" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" />
            <InfoButton Text="@(Strings.Get("TenantAuditRetInfo"))" />
        </div>
        <div class="wb-setting-row mb-3">
            <MudSelect T="int" Label="@Strings.Get("TenantWormLabel")" @bind-Value="_tenantEdit.WormLockMode"
                       Disabled="@(!Editing("records"))" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1">
                <MudSelectItem T="int" Value="0">@Strings.Get("TenantWormGovernance")</MudSelectItem>
                <MudSelectItem T="int" Value="1">@Strings.Get("TenantWormCompliance")</MudSelectItem>
            </MudSelect>
            <InfoButton Text="@(Strings.Get("TenantWormInfo"))" />
        </div>
        <div class="wb-setting-row mb-4">
            <MudSwitch T="bool" @bind-Value="_tenantEdit.RequireDispositionReview" Disabled="@(!Editing("records"))" Color="Color.Primary" Class="flex-grow-1"
                       Label="@Strings.Get("TenantRequireDisposition")" />
            <InfoButton Text="@(Strings.Get("TenantRequireDispositionInfo"))" />
        </div>

        @* ---- Check-out ---------------------------------------------------------------------------- *@
        @GroupHeader("checkout", Strings.Get("TenantGroupCheckout"))
        <div class="wb-setting-row mb-3">
            <MudNumericField T="int" Label="@Strings.Get("TenantCoTtlLabel")" @bind-Value="_tenantEdit.CheckoutTtlDays"
                             Disabled="@(!Editing("checkout"))" Min="0" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" />
            <InfoButton Text="@(Strings.Get("TenantCoTtlInfo"))" />
        </div>
        <div class="wb-setting-row mb-4">
            <MudNumericField T="int" Label="@Strings.Get("TenantCoWarnLabel")" @bind-Value="_tenantEdit.CheckoutWarningDays"
                             Disabled="@(!Editing("checkout"))" Min="0" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" />
            <InfoButton Text="@(Strings.Get("TenantCoWarnInfo"))" />
        </div>

        @* ---- Storage ------------------------------------------------------------------------------ *@
        @GroupHeader("storage", Strings.Get("TenantGroupStorage"))
        <div class="wb-setting-row mb-1">
            <MudNumericField T="int?" Label="@Strings.Get("TenantQuotaLabel")" @bind-Value="_tenantEdit.StorageQuotaMb"
                             Disabled="@(!Editing("storage"))" Min="0" Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" />
            <InfoButton Text="@(Strings.Get("TenantQuotaInfo"))" />
        </div>
        <div class="wb-setting-row mb-3" style="align-items:center; gap:8px;">
            <MudText Typo="Typo.body2" Class="mud-text-secondary flex-grow-1">
                @string.Format(Strings.Get("TenantUsed"), FormatBytes(_tenant.StorageUsedBytes))@(_tenant.StorageQuotaBytes is { } q ? string.Format(Strings.Get("TenantUsedOf"), FormatBytes(q), StoragePercent()) : Strings.Get("TenantNoLimit"))
                @if (StorageLevel() == 1)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Class="ml-2">@Strings.Get("TenantApproachingQuota")</MudChip>
                }
                else if (StorageLevel() == 2)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Error" Class="ml-2">@Strings.Get("TenantAlmostFull")</MudChip>
                }
            </MudText>
            <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Refresh" OnClick="RecomputeStorageAsync">@Strings.Get("TenantRecompute")</MudButton>
            <InfoButton Text="@(Strings.Get("TenantRecomputeInfo"))" />
        </div>
        <div class="wb-setting-row mb-4">
            <MudNumericField T="int" Label="@Strings.Get("TenantUploadCleanupLabel")" @bind-Value="_tenantEdit.IncompleteUploadCleanupDays"
                             Disabled="@(!Editing("storage"))" Min="0" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" />
            <InfoButton Text="@(Strings.Get("TenantUploadCleanupInfo"))" />
        </div>

        @* ---- Mail (#793) --------------------------------------------------------------------------- *@
        @GroupHeader("mail", Strings.Get("TenantGroupMail"))
        <div class="wb-setting-row mb-4">
            <MudSwitch T="bool" @bind-Value="_tenantEdit.ImapShowAllDocumentsDefault" Disabled="@(!Editing("mail"))" Color="Color.Primary" Class="flex-grow-1"
                       Label="@Strings.Get("TenantImapShowAllDefault")" />
            <InfoButton Text="@(Strings.Get("TenantImapShowAllDefaultInfo"))" />
        </div>

        @* ---- External links (ADR 0546) ------------------------------------------------------------ *@
        @GroupHeader("external-links", Strings.Get("TenantGroupExternalLinks"))
        <div class="wb-setting-row mb-2">
            <MudSwitch T="bool" @bind-Value="_tenantEdit.AllowExternalLinks" Disabled="@(!Editing("external-links"))" Color="Color.Primary" Class="flex-grow-1"
                       Label="@Strings.Get("TenantAllowExternalLinks")" />
            <InfoButton Text="@(Strings.Get("TenantAllowExternalLinksInfo"))" />
        </div>
        @if (_tenantEdit.AllowExternalLinks)
        {
            <div class="wb-setting-row mb-2">
                <MudNumericField T="int" @bind-Value="_tenantEdit.ExternalLinkMaxDays" Min="1" Max="3650"
                                 Label="@Strings.Get("TenantExtLinkMaxDays")" Disabled="@(!Editing("external-links"))"
                                 Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" />
            </div>
            <div class="wb-setting-row mb-2">
                <MudNumericField T="int" @bind-Value="_tenantEdit.ExternalLinkDefaultAccesses" Min="1" Max="1000"
                                 Label="@Strings.Get("TenantExtLinkDefaultAccesses")" Disabled="@(!Editing("external-links"))"
                                 Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" />
            </div>
            <div class="wb-setting-row mb-4">
                <MudSwitch T="bool" @bind-Value="_tenantEdit.ShowExternalLinkUrl" Disabled="@(!Editing("external-links"))" Color="Color.Primary" Class="flex-grow-1"
                           Label="@Strings.Get("TenantShowExternalLinkUrl")" />
                <InfoButton Text="@(Strings.Get("TenantShowExternalLinkUrlInfo"))" />
            </div>
        }

        @* ---- Audit streaming (SIEM) --------------------------------------------------------------- *@
        @GroupHeader("audit-streaming", Strings.Get("TenantGroupAuditStreaming"))
        <div class="wb-setting-row mb-2">
            <MudTextField T="string" Label="@Strings.Get("TenantWebhookUrlLabel")" @bind-Value="_tenantEdit.AuditWebhookUrl"
                          Disabled="@(!Editing("audit-streaming"))" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1"
                          Placeholder="https://siem.example.com/ingest" />
            <InfoButton Text="@(Strings.Get("TenantWebhookUrlInfo"))" />
        </div>
        @if (Editing("audit-streaming"))
        {
            <div class="wb-setting-row mb-2">
                <MudTextField T="string" Label="@(_tenant.AuditWebhookConfigured ? Strings.Get("TenantSecretLabelKeep") : Strings.Get("TenantSecretLabel"))"
                              @bind-Value="_tenantEdit.AuditWebhookSecret" InputType="InputType.Password"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" />
                <InfoButton Text="@(Strings.Get("TenantSecretInfo"))" />
            </div>
        }
        else
        {
            <div class="wb-setting-row mb-1" style="align-items:center; gap:8px;">
                <MudText Typo="Typo.body2" Class="mud-text-secondary flex-grow-1">
                    @(_tenant.AuditWebhookConfigured ? Strings.Get("TenantSecretConfigured") : Strings.Get("TenantSecretNotSet"))
                </MudText>
                @if (_tenant.AuditWebhookUrl is not null && _tenant.AuditWebhookConfigured)
                {
                    <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Send" OnClick="TestWebhookAsync">@Strings.Get("TenantSendTest")</MudButton>
                }
            </div>
            @if (_tenant.AuditWebhookUrl is not null)
            {
                <div class="wb-setting-row mb-4">
                    @if (_tenant.AuditWebhookConsecutiveFailures == 0)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Success" Class="flex-grow-1">
                            @Strings.Get("TenantDeliveryHealthy")@(_tenant.AuditWebhookLastSuccessAt is { } s ? string.Format(Strings.Get("TenantLastSuccess"), s.ToLocalTime().ToString("g")) : "")
                        </MudText>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Color="Color.Warning" Class="flex-grow-1">
                            @Strings.Get("TenantDeliveryFailing") @string.Format(_tenant.AuditWebhookConsecutiveFailures == 1 ? Strings.Get("TenantConsecFailure") : Strings.Get("TenantConsecFailures"), _tenant.AuditWebhookConsecutiveFailures)@(_tenant.AuditWebhookLastError is { } e ? $" ({e})" : "")@(_tenant.AuditWebhookNextAttemptAt is { } n ? string.Format(Strings.Get("TenantNextRetry"), n.ToLocalTime().ToString("g")) : "")@(_tenant.AuditWebhookLastSuccessAt is { } s2 ? string.Format(Strings.Get("TenantLastSuccessSemi"), s2.ToLocalTime().ToString("g")) : Strings.Get("TenantNeverDelivered"))
                        </MudText>
                    }
                    <InfoButton Text="@(Strings.Get("TenantDeliveryInfo"))" />
                </div>
            }
        }
    }
    </div>
</div>

@code {
    /// <summary>Create a repository — the shell owns the tree this adds a root to.</summary>
    [Parameter]
    public EventCallback NewRepository { get; set; }

    /// <summary>
    /// Opens the mail-domains editor (#667) — from HERE, not via the shell.
    /// </summary>
    /// <remarks>
    /// Its siblings are shell callbacks because each reaches state the shell caches and must refresh: the
    /// sensitivity picker, the repository tree. Mail domains are cached nowhere, so routing this through the
    /// shell would add a parameter, a method and a hop to arrive at the same dialog — and would grow the file
    /// ADR 0558 is decomposing, for a reason that does not apply.
    /// </remarks>
    private async Task OpenMailDomainsAsync() =>
        await (await DialogService.ShowAsync<MailDomainsDialog>(
            Strings.Get("MdTitle"), new DialogOptions { MaxWidth = MaxWidth.Medium })).Result;

    /// <summary>Open the sensitivity-labels editor — the shell refreshes its picker afterwards.</summary>
    [Parameter]
    public EventCallback ManageSensitivityLabels { get; set; }

    /// <summary>Batch-convert existing TIFF scans (#530 tranche 10 — moved here from the Repositories ribbon,
    /// matching the desktop); the shell owns the flow and its progress reporting.</summary>
    [Parameter]
    public EventCallback ConvertScans { get; set; }

    // The tenant resource's own advertised addresses, captured when its settings are read (ADR 0557):
    // the maintenance actions plus one settings-<group> rel per editable group.
    private IReadOnlyDictionary<string, string>? _tenantLinks;

    private IReadOnlyList<OcrLanguageOption> _ocrCatalog = [];

    // The tab loads itself; the shell's activation branch is deleted, not relocated (ADR 0558 rule 3).
    protected override async Task OnInitializedAsync()
    {
        await LoadTenantSettingsAsync();
        _ocrCatalog = await OcrLanguages.GetAsync();
    }

    private TenantSettingsDto? _tenant;
    private TenantSettingsEdit _tenantEdit = new();
    private IReadOnlyCollection<string> _tenantEditOcr = new HashSet<string>();

    /// <summary>The ONE group in edit mode, by its rel suffix — null when everything is read-only
    /// (#530 tranche 10: per-group pencils, ADR 0550).</summary>
    private string? _editingGroup;

    private bool Editing(string group) => _editingGroup == group;

    // The group header: title + pencil (read-only) or title + Save/Cancel (editing) — the transition's
    // actions live where the pencil was, in the same row (ADR 0550), and the OTHER groups' pencils hide
    // while one group edits: starting a second edit would silently discard the first. A RenderFragment
    // method rather than a component, because it closes over this tab's state.
    private RenderFragment GroupHeader(string group, string title) => __builder =>
    {
        <div class="wb-tenant-group-head" style="display:flex; align-items:center; gap:8px; margin:10px 0 6px;">
            <MudText Typo="Typo.subtitle2">@title</MudText>
            @if (Editing(group))
            {
                <MudButton Size="Size.Small" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" OnClick="() => SaveGroupAsync(group)">@Strings.Get("Save")</MudButton>
                <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.Close" OnClick="CancelGroupEdit">@Strings.Get("Cancel")</MudButton>
            }
            else if (_editingGroup is null)
            {
                <MudButton Class="wb-rib-btn" Size="Size.Small" OnClick="() => BeginGroupEdit(group)"
                           title="@Strings.Get("Edit")" aria-label="@Strings.Get("Edit")">
                    <MudIcon Icon="@Icons.Material.Filled.Edit" Size="Size.Small" /><span class="wb-rib-label">@Strings.Get("Edit")</span>
                </MudButton>
            }
        </div>
    };

    private void BeginGroupEdit(string group)
    {
        if (_tenant is null) return;
        SyncTenantEditFromTenant(); // discard any other group's in-flight edits
        _editingGroup = group;
    }

    private void CancelGroupEdit()
    {
        SyncTenantEditFromTenant();
        _editingGroup = null;
    }

    private async Task LoadTenantSettingsAsync()
    {
        _editingGroup = null;
        try
        {
            _tenant = await Http.GetFromJsonAsync<TenantSettingsDto>(await ApiRoot.RequireAsync("tenantSettings"));
            _tenantLinks = Links.RelMap(_tenant?.Links);
            if (_ocrCatalog.Count == 0)
            {
                _ocrCatalog = (await Http.GetFromJsonAsync<OcrCatalogResponse>(await ApiRoot.RequireAsync("ocrLanguages")))?.Languages ?? [];
            }
            SyncTenantEditFromTenant(); // the read-only fields bind to _tenantEdit too, so keep it in sync
        }
        catch (Exception)
        {
            _tenant = null;
        }
    }

    // The read-only view and the edit form share the _tenantEdit binding, so it mirrors _tenant except while
    // the user is actively editing one group (BeginGroupEdit → Save/Cancel).
    private void SyncTenantEditFromTenant()
    {
        if (_tenant is null) return;
        _tenantEdit = new TenantSettingsEdit { Name = _tenant.Name, AuditRetentionDays = _tenant.AuditRetentionDays, CheckoutTtlDays = _tenant.CheckoutTtlDays, CheckoutWarningDays = _tenant.CheckoutWarningDays, WormLockMode = _tenant.WormLockMode, RequireMfa = _tenant.RequireMfa, AllowPasskeyLogin = _tenant.AllowPasskeyLogin, RequireDispositionReview = _tenant.RequireDispositionReview, RestrictTagsToCatalog = _tenant.RestrictTagsToCatalog, EnforceClearance = _tenant.EnforceClearance, ImapShowAllDocumentsDefault = _tenant.ImapShowAllDocumentsDefault, AllowExternalLinks = _tenant.AllowExternalLinks, ShowExternalLinkUrl = _tenant.ShowExternalLinkUrl, ExternalLinkMaxDays = _tenant.ExternalLinkMaxDays, ExternalLinkDefaultAccesses = _tenant.ExternalLinkDefaultAccesses, StorageQuotaMb = _tenant.StorageQuotaBytes is { } b ? (int)(b / (1024 * 1024)) : null, IncompleteUploadCleanupDays = _tenant.IncompleteUploadCleanupDays, AuditWebhookUrl = _tenant.AuditWebhookUrl, AuditWebhookSecret = null };
        _tenantEditOcr = new HashSet<string>(_tenant.DefaultOcrLanguages.Split('+', StringSplitOptions.RemoveEmptyEntries));
    }

    // One save per group (#530 tranche 10): PUT exactly the group's fields to the rel the server advertised.
    private async Task SaveGroupAsync(string group)
    {
        if (_tenantLinks?.GetValueOrDefault($"settings-{group}") is not { } href) { return; }

        object body = group switch
        {
            "general" => new { name = _tenantEdit.Name },
            "capture" => new
            {
                // Preserve the catalog order for the "+"-joined default (a stable priority).
                defaultOcrLanguages = string.Join('+', _ocrCatalog.Select(l => l.Code).Where(c => _tenantEditOcr.Contains(c))),
                restrictTagsToCatalog = _tenantEdit.RestrictTagsToCatalog,
            },
            "security" => new { requireMfa = _tenantEdit.RequireMfa, allowPasskeyLogin = _tenantEdit.AllowPasskeyLogin, enforceClearance = _tenantEdit.EnforceClearance },
            "records" => new { auditRetentionDays = _tenantEdit.AuditRetentionDays, wormLockMode = _tenantEdit.WormLockMode, requireDispositionReview = _tenantEdit.RequireDispositionReview },
            "checkout" => new { checkoutTtlDays = _tenantEdit.CheckoutTtlDays, checkoutWarningDays = _tenantEdit.CheckoutWarningDays },
            "storage" => new
            {
                storageQuotaBytes = _tenantEdit.StorageQuotaMb is { } mb ? (long?)((long)mb * 1024 * 1024) : null,
                incompleteUploadCleanupDays = _tenantEdit.IncompleteUploadCleanupDays,
            },
            "mail" => new { imapShowAllDocumentsDefault = _tenantEdit.ImapShowAllDocumentsDefault },
            "external-links" => new { allowExternalLinks = _tenantEdit.AllowExternalLinks, externalLinkMaxDays = _tenantEdit.ExternalLinkMaxDays, externalLinkDefaultAccesses = _tenantEdit.ExternalLinkDefaultAccesses, showExternalLinkUrl = _tenantEdit.ShowExternalLinkUrl },
            "audit-streaming" => new
            {
                auditWebhookUrl = string.IsNullOrWhiteSpace(_tenantEdit.AuditWebhookUrl) ? null : _tenantEdit.AuditWebhookUrl.Trim(),
                auditWebhookSecret = string.IsNullOrWhiteSpace(_tenantEdit.AuditWebhookSecret) ? null : _tenantEdit.AuditWebhookSecret,
            },
            _ => throw new InvalidOperationException($"Unknown settings group '{group}'."),
        };

        var resp = await Http.PutAsJsonAsync(href, body);
        if (resp.StatusCode == System.Net.HttpStatusCode.Conflict) { Snackbar.Add(Strings.Get("StTenantNameTaken"), Severity.Warning); return; }
        if (resp.StatusCode == System.Net.HttpStatusCode.BadRequest) { Snackbar.Add(Strings.Get("StTenantCheckFields"), Severity.Warning); return; }
        if (!resp.IsSuccessStatusCode) { Snackbar.Add(Strings.Get("StErrSaveSettings"), Severity.Error); return; }
        _tenant = await resp.Content.ReadFromJsonAsync<TenantSettingsDto>();
        _tenantLinks = Links.RelMap(_tenant?.Links);
        SyncTenantEditFromTenant();
        _editingGroup = null;
        Snackbar.Add(Strings.Get("StTenantSaved"), Severity.Success);
    }

    private async Task TestWebhookAsync()
    {
        if (_tenantLinks?.GetValueOrDefault("audit-webhook-test") is not { } webhookTestHref) { return; }

        var resp = await Http.PostAsync(webhookTestHref, null);
        if (resp.StatusCode == System.Net.HttpStatusCode.BadRequest) { Snackbar.Add(Strings.Get("StSaveWebhookFirst"), Severity.Warning); return; }
        if (!resp.IsSuccessStatusCode) { Snackbar.Add(Strings.Get("StErrTestEvent"), Severity.Error); return; }
        var result = await resp.Content.ReadFromJsonAsync<TestWebhookResult>();
        if (result?.Success == true) Snackbar.Add(Strings.Get("StTestEventDelivered"), Severity.Success);
        else Snackbar.Add(string.Format(Strings.Get("StTestDeliveryFailed"), result?.Error ?? Strings.Get("StUnknownError")), Severity.Warning);
    }

    private record TestWebhookResult { public bool Success { get; set; } public string? Error { get; set; } }

    private async Task RecomputeStorageAsync()
    {
        if (_tenantLinks?.GetValueOrDefault("recompute-storage") is not { } recomputeHref) { return; }

        var resp = await Http.PostAsync(recomputeHref, null);
        if (!resp.IsSuccessStatusCode) { Snackbar.Add(Strings.Get("StErrRecompute"), Severity.Error); return; }
        _tenant = await resp.Content.ReadFromJsonAsync<TenantSettingsDto>();
        _tenantLinks = Links.RelMap(_tenant?.Links);
        if (_editingGroup is null) SyncTenantEditFromTenant();
        Snackbar.Add(Strings.Get("StStorageRecomputed"), Severity.Success);
    }

