@using SimplArchive.Client.Services
@inject DavCollections DavCollections
@inject BrowseService Browse
@inject StructuredEditors StructuredEditors
@inject IDialogService DialogService
@inject ISnackbar Snackbar

@* The Calendar tab of the workbench (#564) — the web twin of the desktop tab, which is the reference
   (ADR 0511). Same shape as Contacts beside it, differing only where a calendar genuinely differs: the list
   leads with TIME and is ordered by it, and undated appointments sort LAST rather than into the top rows. *@

<div class="wb-calendar" style="height:100%; display:flex; flex-direction:column; flex:1 1 auto; min-height:0;">
    <div class="wb-search-bar pa-2" style="border-bottom:1px solid var(--mud-palette-lines-default);">
        <MudButton Class="wb-rib-btn" Size="Size.Small" OnClick="LoadAsync"
                   title="@Strings.Get("RibbonRefresh")" aria-label="@Strings.Get("RibbonRefresh")">
            <MudIcon Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" /><span class="wb-rib-label">@Strings.Get("RibbonRefresh")</span>
        </MudButton>
        @* Disabled until a ticked calendar says the caller MAY create there, so the affordance never lies. *@
        <MudButton Class="wb-rib-btn ml-3" Size="Size.Small" Disabled="@(!CanCreate)" OnClick="NewAppointmentAsync"
                   title="@Strings.Get("CalendarNew")" aria-label="@Strings.Get("CalendarNew")">
            <MudIcon Icon="@Icons.Material.Filled.EventAvailable" Size="Size.Small" /><span class="wb-rib-label">@Strings.Get("CalendarNew")</span>
        </MudButton>
        @* Edit opens the same structured editor; whether the entry is really editable is the server's answer,
           told by the document's appointment rel (ADR 0543). *@
        <MudButton Class="wb-rib-btn" Size="Size.Small" Disabled="@(_selected is null)" OnClick="EditAppointmentAsync"
                   title="@Strings.Get("CalendarEdit")" aria-label="@Strings.Get("CalendarEdit")">
            <MudIcon Icon="@Icons.Material.Filled.Edit" Size="Size.Small" /><span class="wb-rib-label">@Strings.Get("CalendarEdit")</span>
        </MudButton>

        @* Month ⇄ List. Two questions, not two skins of one: the list answers "what is coming up" and keeps the
           filter; the month answers "what does this month look like". Neither subsumes the other, which is why
           the grid is a second view rather than a replacement. *@
        <div class="ml-auto">
            <MudButton Class="@ViewButtonClass(true)" Size="Size.Small" OnClick="@(() => SetMonthView(true))"
                       title="@Strings.Get("CalendarViewMonth")" aria-label="@Strings.Get("CalendarViewMonth")">
                <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Size="Size.Small" /><span class="wb-rib-label">@Strings.Get("CalendarViewMonth")</span>
            </MudButton>
            <MudButton Class="@ViewButtonClass(false)" Size="Size.Small" OnClick="@(() => SetMonthView(false))"
                       title="@Strings.Get("CalendarViewList")" aria-label="@Strings.Get("CalendarViewList")">
                <MudIcon Icon="@Icons.Material.Filled.ViewList" Size="Size.Small" /><span class="wb-rib-label">@Strings.Get("CalendarViewList")</span>
            </MudButton>
        </div>
    </div>

    <div style="flex:1 1 auto; min-height:0; display:flex;">
        <div style="flex:0 0 220px; border-right:1px solid var(--mud-palette-lines-default); min-width:0;">
            <DavCollectionPicker Collections="_collections" Checked="_checked"
                                 Heading="@Strings.Get("CalendarCollections")"
                                 EmptyText="@Strings.Get("CalendarNoneSelected")"
                                 ChangedAsync="ReloadAppointmentsAsync" />
        </div>

        <div style="flex:1 1 auto; min-width:0; display:flex; flex-direction:column;">
            <div class="pa-2 d-flex align-center" style="border-bottom:1px solid var(--mud-palette-lines-default); gap:.5rem;">
                <SearchField @bind-Value="_filter" Placeholder="@Strings.Get("FilterHint")" />
                @if (_dayFilter is { } dayFilter)
                {
                    @* The day arrived from the grid's "+N more". It says so, and it is clearable — a filter the
                       user cannot see is one they conclude is a bug (ADR 0550). *@
                    <MudChip T="string" Size="Size.Small" OnClose="@(() => _dayFilter = null)">
                        @dayFilter.ToDateTime(TimeOnly.MinValue).ToString("D", System.Globalization.CultureInfo.CurrentCulture)
                    </MudChip>
                }
            </div>
            @if (_monthView)
            {
                <CalendarMonth Entries="Visible.ToList()" Selected="_selected"
                               OnSelected="@(async row => await SelectAsync(row))"
                               OnActivated="@(async row => { await SelectAsync(row); await EditAppointmentAsync(); })"
                               OnDayOverflowed="ShowDay" />
            }
            else
            {
            <div style="flex:1 1 auto; min-height:0; overflow:auto;">
                @if (_appointments.Count == 0)
                {
                    @* See ContactsTab: "tick a calendar" is wrong once one IS ticked. *@
                    <MudText Typo="Typo.body2" Class="mud-text-secondary pa-3">
                        @(_checked.Count == 0 ? Strings.Get("CalendarNoneSelected") : Strings.Get("CalendarEmpty"))
                    </MudText>
                }
                else
                {
                    <MudTable Items="Visible" Dense="true" Hover="true" Bordered="false" Elevation="0" T="AppointmentRow"
                              OnRowClick="@(async (TableRowClickEventArgs<AppointmentRow> e) => await SelectAsync(e.Item))"
                              RowClassFunc="@((row, _) => row == _selected ? "wb-list-row-selected" : "")">
                        <HeaderContent>
                            <MudTh Style="width:1px;"></MudTh>
                            <MudTh>@Strings.Get("CalendarWhen")</MudTh>
                            <MudTh>@Strings.Get("Name")</MudTh>
                            <MudTh>@Strings.Get("CalendarWhere")</MudTh>
                        </HeaderContent>
                        <RowTemplate Context="row">
                            <MudTd><span style="@Swatch(row.CollectionColor)" title="@row.CollectionName"></span></MudTd>
                            @* Time leads: a calendar row is read by WHEN before WHAT. *@
                            <MudTd Class="mud-text-secondary" Style="font-variant-numeric:tabular-nums;">@row.TimeRange</MudTd>
                            <MudTd>
                                @row.Title
                                @if (row.Recurring)
                                {
                                    <span class="wb-cal-repeat ml-1" title="@Strings.Get("CalendarRepeatsHint")"
                                          aria-label="@Strings.Get("CalendarRepeatsHint")">@AppointmentCoverage.RepeatMark</span>
                                }
                            </MudTd>
                            <MudTd Class="mud-text-secondary">@row.Location</MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </div>
            }
        </div>

        @* Detail. Sized to its content: this pane must not claim space it is not using (ADR 0550). *@
        <div style="flex:0 0 320px; border-left:1px solid var(--mud-palette-lines-default); overflow:auto;" class="pa-3">
            @if (_selected is { } selected)
            {
                <MudText Typo="Typo.h6">@selected.Title</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">@selected.CollectionName</MudText>
                @* One instant, three readings (ADR 0690). UTC first because it is what anything else can be
                   compared against; then what the organiser wrote, with the zone each endpoint names — two
                   lines when they differ, which is a real appointment (a flight) and not an edge case; then
                   the reader's own zone, and ONLY when it would say something the recorded block did not.
                   Every row draws only when it has a value (ADR 0550). *@
                @if (_detail?.Times is { } times)
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@Strings.Get("CalendarUtc")</MudText>
                    <MudText Typo="Typo.body2" Class="mb-2">@times.Utc.Range</MudText>

                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@Strings.Get("CalendarRecorded")</MudText>
                    @foreach (var line in times.Recorded)
                    {
                        <MudText Typo="Typo.body2">
                            @line.Range
                            @* A floating time names no zone, and saying so in words is not the same as leaving
                               the label off: it means "this time, wherever you are". *@
                            <span class="mud-text-secondary" style="font-size:.78rem;">@(line.Zone ?? Strings.Get("CalendarNoZone"))</span>
                        </MudText>
                    }

                    @if (times.Viewer is { } viewer)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2">@Strings.Get("CalendarYourZone")</MudText>
                        <MudText Typo="Typo.body2" Class="mb-2">
                            @viewer.Range <span class="mud-text-secondary" style="font-size:.78rem;">@viewer.Zone</span>
                        </MudText>
                    }
                }
                else
                {
                    @* An all-day entry has no instant to place and none may be invented (ADR 0647), so it keeps
                       the single row it always had. Also what shows while the read is still in flight. *@
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@Strings.Get("CalendarWhen")</MudText>
                    <MudText Typo="Typo.body2" Class="mb-2">@selected.TimeRange</MudText>
                }

                @if (_detail?.Location is { Length: > 0 } location)
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@Strings.Get("CalendarWhere")</MudText>
                    <MudText Typo="Typo.body2" Class="mb-2">@location</MudText>
                }

                @if (_detail?.Url is { Length: > 0 } url)
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@Strings.Get("CalendarLink")</MudText>
                    @* Target is REQUIRED: Blazor swallows a same-origin-looking link otherwise, and an external
                       address opened inside the SPA loses the workbench. rel keeps the referrer off it. *@
                    <MudText Typo="Typo.body2" Class="mb-2">
                        <MudLink Href="@url" Target="_blank" rel="noopener noreferrer">@url</MudLink>
                    </MudText>
                }

                @if (_detail?.Notes is { Length: > 0 } notes)
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@Strings.Get("CalendarNotes")</MudText>
                    <MudText Typo="Typo.body2" Class="mb-2" Style="white-space:pre-wrap;">@notes</MudText>
                }
                @if (selected.Recurring)
                {
                    @* The rule verbatim, where there is room for it. The grid has space only for a mark, and a
                       mark answers "does this repeat" but not "how" — which is the next thing a reader asks.
                       Not prettified into prose: inventing wording for a rule we deliberately do not interpret
                       would state more than we know (the same call the edit form's read-only RRULE line made). *@
                    <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2">@Strings.Get("CalendarRepeats")</MudText>
                    <MudText Typo="Typo.body2" Style="font-family:var(--mud-typography-default-family); word-break:break-all;">@selected.Repeats</MudText>
                }
            }
        </div>
    </div>
</div>

@code {
    private List<DavCollection> _collections = [];
    private readonly HashSet<Guid> _checked = [];
    private List<AppointmentRow> _appointments = [];
    private AppointmentRow? _selected;

    /// <summary>
    /// What the pane says about the selected appointment beyond its row — the zones, the link, the notes.
    /// </summary>
    /// <remarks>
    /// Null while nothing is selected AND for the whole window between a click and the read landing: the pane
    /// shows the row's own values immediately and fills the rest when it arrives, rather than leaving the
    /// PREVIOUS appointment's notes on screen, which is a claim about the wrong object (ADR 0559).
    /// </remarks>
    private AppointmentDetail? _detail;

    /// <summary>What the structured entry adds to a row: the three time readings, the link and the notes.</summary>
    private sealed record AppointmentDetail(AppointmentTimeBlocks? Times, string Location, string Url, string Notes);

    /// <summary>
    /// Selects a row and reads its entry — one request, at the address the ROW advertised (ADRs 0555/0557).
    /// </summary>
    /// <remarks>
    /// The detail is cleared FIRST and synchronously, so nothing of the previous appointment survives the load;
    /// and a load that is overtaken stands down rather than repainting the pane under a different subject
    /// (ADR 0559).
    /// </remarks>
    private async Task SelectAsync(AppointmentRow? row)
    {
        _selected = row;
        _detail = null;
        if (row?.AppointmentHref is not { } href)
        {
            return;
        }

        // Null on failure: a pane that cannot read its subject shows the row's own values and nothing more,
        // which is the same reading as a rel that was never advertised (ADR 0543).
        var form = await StructuredEditors.ReadAtAsync(href, AppointmentForm.From);
        var times = form is null
            ? null
            : AppointmentTimes.For(
                Combine(form.StartDate, form.StartTime), Combine(form.EndDate, form.EndTime), form.IsAllDay,
                form.StartTimeZoneId is { Length: > 0 } startZone ? startZone : null,
                form.EndTimeZoneId is { Length: > 0 } endZone ? endZone : null,
                TimeZoneInfo.Local);

        var detail = form is null
            ? null
            : new AppointmentDetail(
                times is null ? null : AppointmentTimeBlocks.From(times, System.Globalization.CultureInfo.CurrentCulture),
                form.Location, form.Url, form.Description);

        if (ReferenceEquals(_selected, row))
        {
            _detail = detail;
        }
    }

    // The form holds the date and the time apart so an all-day entry can drop the time without inventing one;
    // the arithmetic wants them back together as the wall clock the file records.
    private static DateTime? Combine(DateTime? date, TimeSpan? time) =>
        date is { } d ? d.Date + (time ?? TimeSpan.Zero) : null;
    private string _filter = string.Empty;

    /// <summary>Month grid or flat list. Opens on the month, which is what the tab is for.</summary>
    private bool _monthView = true;

    /// <summary>Set by the grid's "+N more"; narrows the LIST to that day rather than growing a cell.</summary>
    private DateOnly? _dayFilter;

    private void SetMonthView(bool month)
    {
        _monthView = month;
        if (month)
        {
            // The day filter belongs to the list it sent the user to; carrying it back into the grid would
            // silently hide every other day.
            _dayFilter = null;
        }
    }

    private string ViewButtonClass(bool month) =>
        _monthView == month ? "wb-rib-btn mud-primary-text" : "wb-rib-btn";

    /// <summary>Hands a day to the list — which already has the columns, the filter and the selection.</summary>
    private void ShowDay(DateOnly day)
    {
        _dayFilter = day;
        _monthView = false;
    }

    /// <summary>
    /// One listed appointment. <c>SelfHref</c> is the row's own advertised address — Edit acts from THIS,
    /// never from whatever the detail pane last finished loading (ADR 0559).
    /// </summary>
    public sealed record AppointmentRow(
        Guid Id, string CollectionColor, string CollectionName, string Title,
        DateTimeOffset? Start, DateTimeOffset? End, string Location, string? SelfHref,
        DateOnly? Day = null, bool AllDay = false, DateOnly? EndDay = null, string? Repeats = null,
        // The structured entry's OWN address, advertised on the row (ADR 0690) — the detail pane follows it
        // directly, so selecting a row costs ONE request rather than resolving the document first (ADR 0557).
        string? AppointmentHref = null)
    {
        /// <summary>
        /// Whether this entry repeats — and therefore whether the grid is showing less than the month holds.
        /// </summary>
        /// <remarks>
        /// The server never expands a recurrence set, so a weekly rehearsal is drawn at its FIRST occurrence and
        /// nowhere else. That is a deliberate limitation, but a silent one is a grid quietly claiming three
        /// weeks are free. The marker is what makes it a stated limitation instead.
        /// </remarks>
        public bool Recurring => !string.IsNullOrEmpty(Repeats);

        /// <summary>The last day this entry covers — see <c>AppointmentCoverage</c> for the arithmetic.</summary>
        /// <remarks>
        /// Shared with the desktop rather than written twice: the end being exclusive at midnight is a single
        /// off-by-one in each direction, invisible until somebody counts, and two copies of it is how the two
        /// grids come to disagree about a Tuesday.
        /// </remarks>
        public DateOnly? LastDay => AppointmentCoverage.LastDay(Day, AllDay, EndDay, End);

        /// <summary>Whether this entry is on show on <paramref name="day"/> — the grid's bucketing question.</summary>
        public bool CoversDay(DateOnly day) => AppointmentCoverage.CoversDay(day, Day, AllDay, EndDay, End);

        /// <summary>True on a covered day that is not the first — the cell reads as "still going", not "starts".</summary>
        public bool ContinuesOn(DateOnly day) => AppointmentCoverage.ContinuesOn(day, Day, AllDay, EndDay, End);

        /// <summary>"09:00–10:00", the all-day marker, or empty when the entry carries no time at all.</summary>
        public string TimeRange => (AllDay, Start, End) switch
        {
            (true, _, _) => Strings.Get("CalendarAllDay"),
            (_, { } s, { } e) => $"{s.LocalDateTime:HH:mm}–{e.LocalDateTime:HH:mm}",
            (_, { } s, null) => $"{s.LocalDateTime:HH:mm}",
            _ => string.Empty,
        };

        /// <summary>
        /// The full start in the reader's own time zone. Its own property for the same reason as the desktop's:
        /// formatting the raw DateTimeOffset shows the STORED OFFSET while TimeRange converts to local, so one
        /// appointment read "When 11:00–12:00" and "Starts 09:00" two lines apart. One instant, one answer.
        /// </summary>
        public string StartsOn => Start is { } s ? s.LocalDateTime.ToString("g") : string.Empty;
    }

    /// <summary>
    /// The checked calendars the caller may create in — asked of the collection's <c>CanCreateEntries</c>
    /// capability. NOT of the <c>appointments</c> rel, which now serves the LISTING too and is therefore
    /// advertised to any reader; not <c>Writable</c> either, which reports the right to edit content. Three
    /// questions, and only one of them is the one the POST actually checks.
    /// </summary>
    private List<CreateTarget> CreateTargets() =>
    [
        .. _collections
            .Where(c => _checked.Contains(c.Id) && c.CanCreateEntries && c.Href("appointments") is not null)
            .Select(c => new CreateTarget(c.Id, c.DisplayName, c.Href("appointments")!)),
    ];

    private bool CanCreate => CreateTargets().Count > 0;

    private IEnumerable<AppointmentRow> Visible
    {
        get
        {
            var rows = _appointments.AsEnumerable();
            if (_filter is { Length: > 0 })
            {
                rows = rows.Where(a =>
                    a.Title.Contains(_filter, StringComparison.CurrentCultureIgnoreCase)
                    || a.Location.Contains(_filter, StringComparison.CurrentCultureIgnoreCase));
            }

            // The day filter narrows the LIST only: the grid shows a month, and a month narrowed to one day is
            // an empty month.
            if (!_monthView && _dayFilter is { } day)
            {
                rows = rows.Where(a => a.Day == day);
            }

            return rows;
        }
    }

    private static string Swatch(string color) =>
        $"display:inline-block; width:8px; height:8px; border-radius:4px; background:{color};";

    protected override async Task OnInitializedAsync() => await LoadAsync();

    /// <summary>Loads the calendars; the caller's own is ticked so the tab opens with content.</summary>
    public async Task LoadAsync()
    {
        try
        {
            _collections = await DavCollections.ListAsync("calendar");
            _checked.Clear();
            foreach (var collection in _collections.Where(c => c.IsPersonalDefault))
            {
                _checked.Add(collection.Id);
            }

            await ReloadAppointmentsAsync();
        }
        catch (Exception e)
        {
            Snackbar.Add(string.Format(Strings.Get("StErrLoadCalendars"), e.Message), Severity.Error);
        }
    }

    private async Task ReloadAppointmentsAsync()
    {
        var rows = new List<AppointmentRow>();
        foreach (var collection in _collections.Where(c => _checked.Contains(c.Id)))
        {
            // The collection's OWN rel, followed with GET. The children listing was the wrong source: it carries
            // a name and nothing else, so every row's When and Where came out of an empty string and the detail
            // pane beside them was blank by construction (#660).
            if (collection.Href("appointments") is not { } entriesHref)
            {
                continue; // a rel the server did not advertise means "not available here" (ADR 0543)
            }

            try
            {
                foreach (var entry in await DavCollections.ListEntriesAsync(entriesHref))
                {
                    rows.Add(new AppointmentRow(
                        entry.Id, collection.Color ?? "#8a8a8a", collection.DisplayName, entry.Name,
                        entry.StartsAt, entry.EndsAt, entry.Location ?? string.Empty, entry.Href("self"),
                        entry.Day, entry.AllDay, entry.EndDay, entry.Repeats, entry.Href("appointment")));
                }
            }
            catch (Exception e)
            {
                // One unreadable calendar must not blank the whole tab — the others still have appointments.
                Snackbar.Add(string.Format(Strings.Get("StErrLoadCalendars"), e.Message), Severity.Error);
            }
        }

        // Undated last: a null start ordering to the top would put the least informative rows where the eye lands.
        _appointments = [.. rows
            .OrderBy(r => r.Start is null)
            .ThenBy(r => r.Start)
            .ThenBy(r => r.Title, StringComparer.CurrentCultureIgnoreCase)];
        StateHasChanged();
    }

    /// <summary>
    /// New appointment (#631): the SAME dialog as Edit, opened on the next full hour, with the entry created
    /// FROM the filled-in form — nothing exists until Save, so cancelling leaves nothing behind.
    /// </summary>
    private async Task NewAppointmentAsync()
    {
        if (CreateTargets() is not { Count: > 0 } targets)
        {
            return;
        }

        var parameters = new DialogParameters
        {
            { nameof(Dialogs.AppointmentDialog.Form), AppointmentForm.ForCreate() },
            { nameof(Dialogs.AppointmentDialog.Targets), targets },
        };

        var dialog = await DialogService.ShowAsync<Dialogs.AppointmentDialog>(Strings.Get("CalendarNew"), parameters);
        if ((await dialog.Result) is not { Canceled: false, Data: Dialogs.AppointmentDialog.Saved saved }
            || saved.Target is not { } target)
        {
            return;
        }

        var createdId = await StructuredEditors.CreateAsync(target.CreateHref, saved.Form.ToPayload());
        if (createdId is null)
        {
            Snackbar.Add(string.Format(Strings.Get("StErrCreateAppt"), string.Empty), Severity.Error);
            return;
        }

        await ReloadAppointmentsAsync();

        // By the id the server returned, not by the summary the form holds: the server decides the filed name,
        // and a second "Quarterly review" would otherwise select the first one or nothing at all.
        _selected = _appointments.FirstOrDefault(a => a.Id == createdId) ?? _selected;
        Snackbar.Add(string.Format(Strings.Get("StApptCreated"), saved.Form.Summary, target.DisplayName), Severity.Success);
    }

    /// <summary>Opens the structured editor for the selected appointment, addressed from the ROW (ADR 0559).</summary>
    private async Task EditAppointmentAsync()
    {
        if (_selected is not { SelfHref: { } self } row)
        {
            return;
        }

        var loaded = await StructuredEditors.ReadAsync(self, "appointment", AppointmentForm.From);
        if (loaded is null)
        {
            Snackbar.Add(Strings.Get("ApptNotEditable"), Severity.Info);
            return;
        }

        loaded.Value.CanEdit = loaded.CanEdit;

        // See the contacts twin: the raw source loads on demand, through a lambda.
        var parameters = new DialogParameters
        {
            { nameof(Dialogs.AppointmentDialog.Form), loaded.Value },
            { nameof(Dialogs.AppointmentDialog.LoadRaw), (Func<Task>)(async () =>
                {
                    if (await StructuredEditors.ReadRawAsync(loaded.Links) is { } raw)
                    {
                        loaded.Value.Raw.Set(raw.Text, raw.Format, raw.ETag);
                    }
                })
            },
        };

        var dialog = await DialogService.ShowAsync<Dialogs.AppointmentDialog>(row.Title, parameters);
        if ((await dialog.Result) is not { Canceled: false, Data: Dialogs.AppointmentDialog.Saved saved })
        {
            return;
        }

        // A dirty raw box wins and REPLACES the entry — see the contacts twin.
        if (saved.Form.Raw.IsDirty)
        {
            if (await StructuredEditors.SaveRawAsync(loaded.Links, saved.Form.Raw.Text, saved.Form.Raw.ETag) is { } problem)
            {
                Snackbar.Add(problem, Severity.Error);
                return;
            }

            Snackbar.Add(Strings.Get("StRawSaved"), Severity.Success);
            await ReloadAppointmentsAsync();
            return;
        }

        if (await StructuredEditors.SaveAsync(loaded.Href, saved.Form.ToPayload(), loaded.ETag))
        {
            Snackbar.Add(string.Format(Strings.Get("StApptSaved"), row.Title), Severity.Success);
            await ReloadAppointmentsAsync();
        }
        else
        {
            Snackbar.Add(string.Format(Strings.Get("StErrSaveAppt"), string.Empty), Severity.Error);
        }
    }
}
