@using System.Net
@using Microsoft.AspNetCore.Components.Forms
@inject HttpClient Http
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject SimplArchive.Client.Services.ApiRoot ApiRoot
@inject SimplArchive.Client.Services.IntrayUploads IntrayUploads
@inject SimplArchive.Client.Services.OcrLanguageCatalog OcrLanguages
@inject SimplArchive.Client.Services.WebDavMountLink WebDavLink
@implements IAsyncDisposable

@* The Intray tab of the workbench (ADR "S3-backed inbox"), extracted from Home.razor per ADR 0558.

   Staged files waiting to be filed into a repository: uploaded by picker or by dropping onto the list, given a
   mask + index data here, then filed. Self-contained — it owns its list, its staging form, its drop-zone and
   the DotNetObjectReference dropUpload.js calls back into, so nothing about it lives in the shell any more.

   Two facts arrive as parameters rather than being re-fetched (ADR 0557): whether the caller may triage other
   people's intrays, and which folder the Repositories tree has selected, which pre-fills the filing target. *@

@* Only this tab has a filter row, so its rule lives here rather than in the shell, which may only shrink
   (ADR 0558). Bottom-aligned because the switch and the select have different label geometry and would
   otherwise sit at different heights. *@
<style>
    .wb-intray-filters { flex: 0 0 auto; display: flex; align-items: flex-end; gap: 16px; padding: 2px 2px 8px; }
    /* Both filters size to themselves: a MudSelect's root is a block, so in a flex row it otherwise grows to
       the full width of the list and reads as an input you are meant to type a whole line into. */
    .wb-intray-filters > * { flex: 0 0 auto; }
    .wb-intray-filters .mud-select { width: 240px; }
</style>

@* Per-user S3-backed intray (ADR "S3-backed inbox") — staged files to file into a repository. *@
<div class="wb-search">
    <div class="wb-search-bar">
        @* Flat, like every other button here. It used to carry a filled accent to say "start here", which was
           unambiguous while it was a rounded rect with a label — but in a row of circles whose toggles show ON
           as filled primary, a filled circle says "pressed", not "primary". The tab already says where to
           start: this is the first button, and the list below it is a drop-zone that says so in words. *@
        @* A REAL button, not a label over the input (#511): a label is unfocusable and a display:none
           input is out of the tab order, so the label pattern left no keyboard path to Upload at all. The
           button forwards its activation to the input; focus, Enter/Space and the role stay native. *@
        <MudButton Class="wb-rib-btn" Size="Size.Small"
                   OnClick="@(async () => await JS.InvokeVoidAsync("openFilePicker", "intray-file-input"))"
                   title="@Strings.Get("IntrayUpload")" aria-label="@Strings.Get("IntrayUpload")">
            <MudIcon Icon="@Icons.Material.Filled.Upload" Size="Size.Small" /><span class="wb-rib-label">@Strings.Get("IntrayUpload")</span>
        </MudButton>
        <InputFile id="intray-file-input" OnChange="OnIntrayInputChangeAsync" multiple style="display:none" />
        <MudButton Class="wb-rib-btn ml-2" Size="Size.Small" OnClick="LoadIntrayAsync"
                   title="@Strings.Get("RibbonRefresh")" aria-label="@Strings.Get("RibbonRefresh")">
            <MudIcon Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" /><span class="wb-rib-label">@Strings.Get("RibbonRefresh")</span>
        </MudButton>
        <MudButton Class="wb-rib-btn ml-2" Size="Size.Small" OnClick="@(() => WebDavLink.CopyPersonalFolderAsync(WebDavFolder))"
                   title="@Strings.Get("IntrayCopyDav")" aria-label="@Strings.Get("IntrayCopyDav")">
            <MudIcon Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" /><span class="wb-rib-label">@Strings.Get("IntrayCopyDav")</span>
        </MudButton>
        @* Own-items-only by default; held DOWN it reveals my group intrays (ADR 0532). A toggle rather than the
           switch it used to be: it is a sticky on/off that belongs beside the other actions on this view, and a
           switch with a written label set the height of every button next to it. Disabled while viewing another
           user's intray — the two selectors are mutually exclusive. *@
        <MudToggleIconButton Toggled="_intrayIncludeGroups" ToggledChanged="ToggleIntrayGroupsAsync" Size="Size.Small"
                             Icon="@Icons.Material.Outlined.Groups" ToggledIcon="@Icons.Material.Filled.Groups"
                             Color="Color.Default" ToggledColor="Color.Primary" Class="ml-1"
                             Disabled="@(_intrayViewUserId is not null)"
                             title="@Strings.Get("IntrayShowGroups")" />
        @* Selected-item group, FIRST — the desktop's shape (#521, ADR 0511). The same actions the row's ⋮ menu
           offers, differing only in SCOPE: the menu acts on the row it was opened from, these on the current
           selection. Disabled rather than hidden when nothing is selected, which is the Repositories ribbon's
           rule: a right you do not hold is not advertised, but a button that merely has nothing to act on yet
           stays put, so the bar does not reflow under the cursor. *@
        @* ONE file button, and its scope is the checked set. There used to be two — a "File to folder…" acting
           on the single selection and a "File N items" that appeared beside it once two rows were checked —
           which put two buttons carrying the same glyph next to each other, differing only in a scope the user
           could not see. Now that a plain click makes the clicked row the whole checked set, "the selection"
           and "what is checked" are the same thing, so one button says it: it files what is highlighted,
           however many that is, and the tooltip carries the count when there is more than one. *@
        <MudButton Class="wb-rib-btn ml-2" Size="Size.Small" Disabled="@(_intrayChecked.Count == 0)"
                   OnClick="FileCheckedAsync" title="@FileCheckedLabel" aria-label="@FileCheckedLabel">
            <MudIcon Icon="@Icons.Material.Filled.DriveFileMove" Size="Size.Small" /><span class="wb-rib-label">@FileCheckedLabel</span>
        </MudButton>
        @if (_selectedIntrayItem?.IsOwn != false)
        {
            <MudButton Class="wb-rib-btn ml-1" Size="Size.Small" Disabled="@(_selectedIntrayItem is null)"
                       OnClick="@(() => SendIntrayItemAsync(_selectedIntrayItem!))"
                       title="@Strings.Get("IntraySendTitle")" aria-label="@Strings.Get("IntraySendTitle")">
                <MudIcon Icon="@Icons.Material.Filled.Send" Size="Size.Small" /><span class="wb-rib-label">@Strings.Get("IntraySendTitle")</span>
            </MudButton>
        }
        else
        {
            <MudButton Class="wb-rib-btn ml-1" Size="Size.Small"
                       OnClick="@(() => MoveToMyIntrayAsync(_selectedIntrayItem!))"
                       title="@Strings.Get("IntrayClaimToMine")" aria-label="@Strings.Get("IntrayClaimToMine")">
                <MudIcon Icon="@Icons.Material.Filled.MoveToInbox" Size="Size.Small" /><span class="wb-rib-label">@Strings.Get("IntrayClaimToMine")</span>
            </MudButton>
        }
        <MudButton Class="wb-rib-btn ml-1" Size="Size.Small" Disabled="@(_selectedIntrayItem is null)"
                   OnClick="@(() => DownloadIntrayItemAsync(_selectedIntrayItem!))"
                   title="@Strings.Get("Download")" aria-label="@Strings.Get("Download")">
            <MudIcon Icon="@Icons.Material.Filled.Download" Size="Size.Small" /><span class="wb-rib-label">@Strings.Get("Download")</span>
        </MudButton>
        @* Delete composes across the CHECKED set like File selected does (N deletes, one confirm naming the
           count, one summary — the checkout tab's bulk story); with nothing checked it acts on the selected
           row (review finding). The row's ⋮ twin stays single — it acts on its own row (ADR 0559). *@
        <MudButton Class="wb-rib-btn ml-1" Size="Size.Small" Disabled="@(_selectedIntrayItem is null && _intrayChecked.Count == 0)"
                   OnClick="DeleteIntraySelectionAsync"
                   title="@Strings.Get("RibbonDelete")" aria-label="@Strings.Get("RibbonDelete")">
            <MudIcon Icon="@Icons.Material.Filled.Delete" Size="Size.Small" /><span class="wb-rib-label">@Strings.Get("RibbonDelete")</span>
        </MudButton>

        @* Page operations (#487, ADR 0575) — its own component. It owns the "what can be done to this
           item" answer and re-asks it whenever the checked set changes; busy, the status line and the
           three sticky preferences stay here, because this tab sets busy around its own uploads, owns the
           one status line, and seeds the preferences from the `me` resource it fetches at init. *@
        <IntrayPageOperations Checked="@_intrayChecked.ToList()"
                              JoinHref="@_joinHref"
                              PatchCodeSheetHref="@_patchCodeSheetHref"
                              @bind-Busy="_intrayBusy"
                              @bind-DeskewAutomatically="_deskewAutomatically"
                              @bind-RotateAutomatically="_rotateAutomatically"
                              @bind-CutAtPatchCodesAutomatically="_cutAtPatchCodesAutomatically"
                              StatusChanged="@(s => _intrayStatus = s)"
                              OnChanged="@LoadIntrayAsync" />
    </div>
    <div class="wb-search-status">@_intrayStatus</div>
    @if (CanManageIntrays)
    {
        @* The one filter that cannot be a button: it picks a value out of a list, and the list is as long as
           the tenant has users. So it sits BELOW the action bar and directly above the list it filters — where
           the desktop already puts it (ADR 0511) — rather than setting the bar's height for every button beside
           it. Its companion, "show group intrays", is an on/off and went to the bar as a toggle.

           CanManageIntrays: open any user's intray for triage; "My intray" resets to own. *@
        <div class="wb-intray-filters">
            <MudSelect T="Guid?" Value="_intrayViewUserId" ValueChanged="ViewUserIntrayAsync" Dense="true"
                       Margin="Margin.Dense" Variant="Variant.Outlined"
                       Label="@Strings.Get("IntrayUserPicker")">
                <MudSelectItem T="Guid?" Value="@((Guid?)null)">@Strings.Get("IntrayMine")</MudSelectItem>
                @foreach (var u in _intrayUsers)
                {
                    <MudSelectItem T="Guid?" Value="@((Guid?)u.Id)">@u.Name</MudSelectItem>
                }
            </MudSelect>
        </div>
    }
    <div style="display:flex; flex:1 1 auto; min-height:0;">
        @* Drop-zone: dropping OS files anywhere on this list uploads them straight into the intray
           (ADR "Inbox file-list drop-zone"). *@
        <div class="wb-search-results wb-intray-drop" style="flex:1 1 40%; min-width:0;" @ref="_dropZone">
            <div class="wb-intray-drophint"><MudIcon Icon="@Icons.Material.Filled.CloudUpload" Size="Size.Small" /> @Strings.Get("IntrayDropHint")</div>
            @foreach (var item in _intrayItems)
            {
                <div class="wb-list-row @(item == _selectedIntrayItem || _intrayChecked.Contains(item) ? "wb-list-row-selected" : "")" @onclick="e => OnIntrayRowClickAsync(item, e)">
                    @* The checkbox is the TOUCH affordance only. On a device with a hover and a fine pointer
                       the list multi-selects natively — Ctrl/Cmd-click toggles a row in, Shift-click takes a
                       range — which is what the Repositories list has always done, and what anyone who selects
                       files in their own OS expects. Touch has neither modifier keys nor a right-click, so
                       there the checkbox IS the affordance; the same input-device query that decides whether a
                       toolbar shows labels decides this (ADR 0491). *@
                    <div class="wb-touch-only" @onclick:stopPropagation="true">
                        <MudCheckBox T="bool" Value="_intrayChecked.Contains(item)" ValueChanged="@(v => ToggleIntrayCheck(item, v))" Dense="true" Size="Size.Small" />
                    </div>
                    <MudIcon Icon="@(item.GroupId is not null ? Icons.Material.Filled.Group : item.UserId is not null ? Icons.Material.Filled.Person : Icons.Material.Filled.InsertDriveFile)" Size="Size.Small" />
                    <span style="flex:1 1 auto; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@item.DisplayName</span>
                    @if (!item.IsOwn && item.SourceLabel is { } src)
                    {
                        @* Whose queue this item came from (a group, or — for an admin view — another user). *@
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Default" Class="ma-0">@src</MudChip>
                    }
                    @if (item.Signed)
                    {
                        @* Every page operation would void a signature, so none is offered on this row (#491). *@
                        <MudTooltip Text="@Strings.Get("SignedBadgeTip")">
                            <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined"
                                     Icon="@Icons.Material.Filled.WorkspacePremium" Class="ma-0">@Strings.Get("SignedBadge")</MudChip>
                        </MudTooltip>
                    }
                    <span class="mud-text-secondary" style="font-size:.8em;">@SimplArchive.Client.Services.ByteSize.Format(item.Size)</span>
                    <div @onclick:stopPropagation="true">
                        <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true" AnchorOrigin="Origin.BottomLeft">
                            <MudMenuItem Icon="@Icons.Material.Filled.DriveFileMove" OnClick="() => FileIntrayItemAsync(item)">@Strings.Get("IntrayFileToFolder")</MudMenuItem>
                            @if (item.IsOwn)
                            {
                                @* Own items can be handed to a group or another user (ADR 0532). *@
                                <MudMenuItem Icon="@Icons.Material.Filled.Send" OnClick="() => SendIntrayItemAsync(item)">@Strings.Get("IntraySendTitle")</MudMenuItem>
                            }
                            else
                            {
                                @* A group/other-user item can be claimed into my own intray. *@
                                <MudMenuItem Icon="@Icons.Material.Filled.MoveToInbox" OnClick="() => MoveToMyIntrayAsync(item)">@Strings.Get("IntrayClaimToMine")</MudMenuItem>
                            }
                            <MudMenuItem Icon="@Icons.Material.Filled.Download" OnClick="() => DownloadIntrayItemAsync(item)">@Strings.Get("Download")</MudMenuItem>
                            <MudMenuItem Icon="@Icons.Material.Filled.Delete" IconColor="Color.Error" OnClick="() => DeleteIntrayItemAsync(item)">@Strings.Get("RibbonDelete")</MudMenuItem>
                        </MudMenu>
                    </div>
                </div>
            }
        </div>
        @if (_selectedIntrayItem is not null)
        {
            <div style="flex:1 1 60%; min-width:0; border-left:1px solid var(--mud-palette-lines-default); display:flex; flex-direction:column;">
                @* Mask/index-data staging pane (ADRs 0279/0281/0285). *@
                <div style="flex:0 0 auto; max-height:46%; overflow:auto; padding:10px 14px; border-bottom:1px solid var(--mud-palette-lines-default);">
                    <MudText Typo="Typo.subtitle2">@_selectedIntrayItem.Name</MudText>
                    @if (_intrayIsEmail)
                    {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-2">
                            <MudIcon Icon="@Icons.Material.Filled.MarkEmailRead" Size="Size.Small" /> @Strings.Get("IntrayEmailAutoMask")
                        </MudText>
                    }
                    else
                    {
                        <table class="wb-sysfields">
                            <tr><td>@Strings.Get("Name")</td><td><MudTextField @bind-Value="_intrayStgName" Margin="Margin.Dense" Variant="Variant.Outlined" /></td></tr>
                            <tr><td>@Strings.Get("VerColDocDate")</td><td><MudDatePicker @bind-Date="_intrayStgDate" DateFormat="yyyy-MM-dd" Margin="Margin.Dense" Variant="Variant.Outlined" /></td></tr>
                            @if (_intrayStgScannable)
                            {
                                @* OCR languages for a scannable item — staged + applied to the searchable-PDF conversion at filing (ADR "Inbox OCR-language staging"). *@
                                <tr>
                                    <td>@Strings.Get("SysOcrLanguages")</td>
                                    <td>
                                        <div class="wb-ocr-chips">
                                            @foreach (var lang in _ocrCatalog)
                                            {
                                                var idx = _intrayStgOcrCodes.IndexOf(lang.Code);
                                                <button type="button" class="wb-ocr-chip @(idx >= 0 ? "wb-ocr-chip-on" : "")" @onclick="() => ToggleIntrayOcr(lang.Code)">@(idx >= 0 ? $"{idx + 1}. " : "")@lang.DisplayName</button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </table>
                        <div class="wb-mask-edit">
                            <div class="wb-mask-row">
                                <span class="wb-mask-label">@Strings.Get("MaskLabel")</span>
                                <MudSelect T="Guid?" Value="_intrayStgMaskId" ValueChanged="OnIntrayStgMaskChanged" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined">
                                    <MudSelectItem T="Guid?" Value="@((Guid?)null)">@Strings.Get("NoMask")</MudSelectItem>
                                    @foreach (var m in _intrayStgMasks)
                                    {
                                        <MudSelectItem T="Guid?" Value="@((Guid?)m.Id)">@m.Name</MudSelectItem>
                                    }
                                </MudSelect>
                            </div>
                            @foreach (var f in _intrayStgFields)
                            {
                                <div class="wb-mask-row">
                                    <span class="wb-mask-label">@f.Label</span>
                                    @if (f.IsDate)
                                    {
                                        <MudDatePicker @bind-Date="f.DateValue" DateFormat="yyyy-MM-dd" Margin="Margin.Dense" Variant="Variant.Outlined" />
                                    }
                                    else if (f.IsBoolean)
                                    {
                                        <MudCheckBox T="bool" @bind-Value="f.BoolValue" />
                                    }
                                    else if (f.IsMultiLine)
                                    {
                                        <MudTextField @bind-Value="f.TextValue" Lines="3" Placeholder="@Strings.Get("OneValuePerLine")" Margin="Margin.Dense" Variant="Variant.Outlined" />
                                    }
                                    else
                                    {
                                        <MudTextField @bind-Value="f.TextValue" Margin="Margin.Dense" Variant="Variant.Outlined" />
                                    }
                                </div>
                            }
                        </div>
                        <div class="wb-detail-actions">
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveIntrayMaskAsync" Disabled="_intrayStgBusy">@Strings.Get("Save")</MudButton>
                        </div>
                    }
                </div>
                @* The intray previews a STAGED file — nothing to annotate, so no Toolbar and no
                   annotation host; the gestures become no-ops rather than missing features. *@
                <PreviewPane @ref="_preview"
                             Style="flex:1 1 auto; min-height:0; position:relative; display:flex; flex-direction:column;"
                             EmptyText="@(_selectedIntrayItem is null ? Strings.Get("NoItemSelected") : Strings.Get("NoPreview"))"
                             ConvertedBadgeTooltip="This is a generated preview, not the original file." />
            </div>
        }
    </div>
</div>

@code {

    /// <summary>
    /// The folder currently selected in the Repositories tree, used to pre-fill the filing dialog. Arrives as a
    /// parameter because the shell already holds it — asking the server again would be a request spent learning
    /// something known (ADR 0557).
    /// </summary>
    [Parameter]
    public Guid? CurrentFolderId { get; set; }

    /// <summary>The selected folder's name, shown in the filing dialog beside its id.</summary>
    [Parameter]
    public string? CurrentFolderName { get; set; }

    /// <summary>Whether the caller may open another user's intray for triage (the CanManageIntrays right).</summary>
    [Parameter]
    public bool CanManageIntrays { get; set; }

    /// <summary>
    /// Copies the WebDAV mount URL. Stays in the shell because the Check-out tab offers the same action, and it
    /// is stateless — a candidate for a small shared service when the shell is finally thinned (PR 4).
    /// </summary>
    /// <summary>This tab's folder inside the WebDAV mount — the desktop's button opens it; the web copies it.</summary>
    /// <summary>The folder inside the caller's personal space this tab links to.</summary>
    /// <remarks>
    /// The LEAF only. It used to spell out "Personal/…", and a personal space is named after its owner
    /// (ADR 0671), so that addressed a folder which does not exist. The mount link resolves the owner's
    /// name for itself — one place, rather than each tab learning to ask.
    /// </remarks>
    private const string WebDavFolder = "Intray";

    /// <summary>
    /// The document selected on the Repositories tab, offered as "file as a new version of it" (ADR 0286).
    /// Null unless a real document is selected — the shell decides that, since it owns the selection.
    /// </summary>
    [Parameter]
    public Guid? CurrentDocumentId { get; set; }

    /// <summary>That document's name, shown in the filing dialog.</summary>
    [Parameter]
    public string? CurrentDocumentName { get; set; }

    /// <summary>The signed-in user's id, used to tell own items from a group's.</summary>
    [Parameter]
    public Guid? MyUserId { get; set; }

    // The tenant's OCR languages, fetched on demand the first time a scannable item is selected. The tab keeps
    // its own copy rather than sharing the shell's: it is a small catalogue, read at most once per session here,
    // and a cache shared across tabs is the coupling this decomposition is unwinding.
    private IReadOnlyList<OcrLanguageOption> _ocrCatalog = [];

    private ElementReference _dropZone;
    private bool _dropWired;
    private IJSObjectReference? _module;
    private DotNetObjectReference<IntrayTab>? _selfRef;
    private PreviewPane? _preview;

    // A preview requested before the pane existed. The pane sits inside "is an item selected?", so the FIRST
    // selection is what creates it — and rendering into a null ref would lose the preview silently (ADR 0558).
    private (string? Url, string? Layout, bool Converted)? _pendingPreview;

    protected override async Task OnInitializedAsync() => await LoadIntrayAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _selfRef = DotNetObjectReference.Create(this);
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./dropUpload.js");
        }

        // Wire the file-list drop-zone once its element is real (ADR "Inbox file-list drop-zone"). initIntrayDrop
        // returns false until then, so simply retry on each render.
        if (!_dropWired && _module is not null)
        {
            _dropWired = await _module.InvokeAsync<bool>("initIntrayDrop", _dropZone, _selfRef);
        }

        // Last, after the wiring: this is the only await here that can take real time.
        if (_pendingPreview is { } pending && _preview is not null)
        {
            _pendingPreview = null;
            await ShowPreviewAsync(pending.Url, pending.Layout, pending.Converted);
            StateHasChanged();
        }
    }

    // Renders into the pane, or remembers the request until the pane exists (see _pendingPreview).
    private async Task ShowPreviewAsync(string? url, string? layout, bool converted)
    {
        if (_preview is null)
        {
            _pendingPreview = (url, layout, converted);
            return;
        }

        await _preview.RenderAsync(url, layout, converted);
    }

    public async ValueTask DisposeAsync()
    {
        _selfRef?.Dispose();
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException) { /* page is going away */ }
            catch (JSException) { /* module already torn down */ }
        }
    }

    private List<IntrayItem> _intrayItems = [];
    private string _intrayStatus = string.Empty;
    private bool _intrayBusy;

    // Passed down to IntrayPageOperations. They stay HERE rather than moving with the buttons because this
    // component is what learns them: the join address comes from the listing it loads, the separator sheet
    // from the same response, and the three preferences from the `me` resource it fetches at init.
    private string? _joinHref;
    private string? _patchCodeSheetHref;
    private bool _deskewAutomatically = true;
    private bool _rotateAutomatically = true;
    private bool _cutAtPatchCodesAutomatically = true;

    // The three preference flags this component seeds from `me` at init. IntrayPageOperations declares its
    // own view of the same resource: a DTO is a description of what a caller reads, and these two read
    // different subsets — sharing one would couple each to the other's fields for no gain.
    private record MeResponse
    {
        public bool DeskewIntrayUploads { get; set; }

        public bool RotateIntrayUploads { get; set; }

        public bool CutIntrayUploadsAtPatchCodes { get; set; }
    }
    private IntrayItem? _selectedIntrayItem;
    // Intray view filters (ADR 0532): own-items-only by default; a toggle reveals my group intrays, and a
    // CanManageIntrays holder can open a specific user's intray via the user-picker (mutually exclusive with groups).
    private bool _intrayIncludeGroups;
    private Guid? _intrayViewUserId;
    private List<IntrayUserOption> _intrayUsers = []; // the admin user-picker's choices (CanManageIntrays only)
    private sealed record IntrayUserOption(Guid Id, string Name);
    // Every address this row acts on comes from the listing that drew it (ADR 0555) — including `mask` and
    // `preview`, which the row had been carrying all along while the tab rebuilt them from Name plus a
    // hand-written `?group=`/`?user=` query. The server's own hrefs already carry that source query, so the
    // SourceQuery property that existed to re-append it is gone (ADR 0532/0543, #416).
    // The addresses are NULLABLE on purpose (#876). They used to be `string` filled with `?? ""`, and an empty
    // href does not fail — it resolves against the client's base address, so a missing rel became a request to
    // the APPLICATION ROOT whose response is the SPA's own HTML. That is worse than a no-op: it is a real
    // request whose error, if any, points somewhere else entirely. Null forces each use site to say what it
    // does when the server did not offer the action.
    /// <summary>True when the server did not offer this action on this row — say so, never request it.</summary>
    /// <remarks>
    /// The point of the guard is that an ABSENT address is not a harmless one. `Http.GetAsync(null)` and
    /// `Http.GetAsync("")` both resolve against the client's BaseAddress, so a missing rel became a real request
    /// to the application root whose response is the SPA's own HTML — a failure that points at the wrong place
    /// (#876). Making the fields nullable alone does not fix that; it only changes how the same request is
    /// spelled, which is why every use site is guarded rather than merely compiling.
    /// </remarks>
    private bool NotOffered(string? href)
    {
        if (href is not null)
        {
            return false;
        }

        _intrayStatus = Strings.Get("IntrayActionUnavailable");
        return true;
    }


    private async Task LoadIntrayAsync()
    {
        // The toggle's state belongs to the USER, not the browser, so it is read from the server rather than
        // restored from layout persistence (#491).
        try
        {
            var me = await Http.GetFromJsonAsync<MeResponse>(await ApiRoot.RequireAsync("me"));
            _deskewAutomatically = me?.DeskewIntrayUploads ?? true;
            _rotateAutomatically = me?.RotateIntrayUploads ?? true;
            _cutAtPatchCodesAutomatically = me?.CutIntrayUploadsAtPatchCodes ?? true;
        }
        catch (Exception)
        {
            // Leave it at its default; the ribbon still works and the server remains the authority.
        }

        _intrayBusy = true;
        _intrayStatus = "Loading…";
        _intrayChecked.Clear();
        try
        {
            // A CanManageIntrays holder gets a user-picker; load the tenant's users once for it.
            if (CanManageIntrays && _intrayUsers.Count == 0)
            {
                var users = await Http.GetFromJsonAsync<IntrayUsersResponse>(await ApiRoot.RequireAsync("intrayUsers"));
                _intrayUsers = users?.Users ?? [];
            }

            // The server owns the path, the caller owns the filter: appending a QUERY to the advertised href is
            // FOLLOWING it, where appending a path segment would be composing in disguise (ADR 0557).
            var intray = await ApiRoot.RequireAsync("intray");
            var url = _intrayViewUserId is { } viewUser ? $"{intray}?user={viewUser}"
                : _intrayIncludeGroups ? $"{intray}?includeGroups=true"
                : intray;
            var response = await Http.GetFromJsonAsync<IntrayResponse>(url);
            _joinHref = Links.Href(response?.Links, "join");
            _patchCodeSheetHref = Links.Href(response?.Links, "patchCodeSheet");
            _intrayItems = (response?.Items ?? []).Select(i => new IntrayItem(
                i.Name, i.Size, i.HasMask,
                Links.Href(i.Links, "download"), Links.Href(i.Links, "preview"),
                Links.Href(i.Links, "file"), Links.Href(i.Links, "self"),
                Links.Href(i.Links, "move"), Links.Href(i.Links, "mask"),
                // A null `pages` means the server offered no page operations for this row's format (ADR 0554).
                i.GroupId, i.GroupName, i.UserId, i.UserName, Links.Href(i.Links, "pages"), i.Signed)).ToList();
            _intrayStatus = _intrayItems.Count == 0 ? "Your intray is empty. Upload files to file them into a repository." : $"{_intrayItems.Count} item(s).";
        }
        catch (Exception)
        {
            _intrayStatus = "Could not load the intray.";
        }
        finally
        {
            _intrayBusy = false;
        }
    }

    private async Task OnIntrayInputChangeAsync(InputFileChangeEventArgs e) => await OnIntrayFilesSelectedAsync(e.GetMultipleFiles(100));

    // Uploads each selected file straight into the S3 intray: POST /api/intray for a presigned URL, then PUT the
    // bytes to it (cross-origin, unauthenticated — same direct-to-storage model as document upload).
    private async Task OnIntrayFilesSelectedAsync(IReadOnlyList<IBrowserFile> files)
    {
        if (files.Count == 0)
        {
            return;
        }

        _intrayBusy = true;
        _intrayStatus = "Uploading…";
        StateHasChanged();
        try
        {
            foreach (var file in files)
            {
                var target = await (await Http.PostAsJsonAsync(await ApiRoot.RequireAsync("intray"), new { fileName = file.Name })).Content.ReadFromJsonAsync<UploadIntrayResponse>();
                if (target is null)
                {
                    continue;
                }

                using var buffer = new MemoryStream();
                await file.OpenReadStream(maxAllowedSize: 200L * 1024 * 1024).CopyToAsync(buffer);
                using var content = new ByteArrayContent(buffer.ToArray());
                if (!string.IsNullOrWhiteSpace(file.ContentType))
                {
                    content.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);
                }

                (await PresignedTransfer.Anonymous.PutAsync(target.UploadUrl, content)).EnsureSuccessStatusCode();
            }

            Snackbar.Add(string.Format(Strings.Get("StUploadedToIntray"), files.Count), Severity.Success);
        }
        catch (Exception)
        {
            Snackbar.Add(Strings.Get("StSomeUploadsFailed"), Severity.Error);
        }
        finally
        {
            _intrayBusy = false;
            await LoadIntrayAsync();
        }
    }

    // ---- Intray drop-zone upload (called from dropUpload.js, ADR "Inbox file-list drop-zone") --------------
    // The browser reads the dropped files and PUTs them straight to storage; .NET only mints the presigned URL
    // and refreshes, mirroring the document-upload drop path.
    [JSInvokable]
    public Task OnIntrayUploadsStartingAsync(int count)
    {
        _intrayBusy = true;
        _intrayStatus = $"Uploading {count} file(s)…";
        StateHasChanged();
        return Task.CompletedTask;
    }

    [JSInvokable]
    public Task<string?> CreateIntrayUploadTargetAsync(string fileName) => IntrayUploads.CreateTargetAsync(fileName);

    [JSInvokable]
    public async Task OnIntrayUploadsCompleteAsync(int count)
    {
        if (count > 0)
        {
            Snackbar.Add(string.Format(Strings.Get("StUploadedToIntray"), count), Severity.Success);
        }

        // Signal ingest BEFORE dropping the busy state and reloading: deskew and the patch-code cut run in
        // that call, so reloading first would show the un-straightened, un-split file and then change it
        // under the user — or, before this was wired at all, not until the sweep worker's five-minute poll.
        // The busy flag clears in finally: a failure here must not leave the spinner running forever, and it
        // must be SAID — a swallowed ingest failure means deskew/cut silently did not run.
        try
        {
            await IntrayUploads.SignalProcessedAsync();
        }
        catch (Exception)
        {
            Snackbar.Add(Strings.Get("StErrIntrayProcessing"), Severity.Warning);
        }
        finally
        {
            _intrayBusy = false;
        }

        await LoadIntrayAsync();
        // A [JSInvokable] call doesn't auto-render (unlike a Blazor event handler): without this, the busy
        // spinner kept spinning INDEFINITELY after a successful upload — every request 200, the list even
        // refreshed, and the user staring at a stale render of it.
        StateHasChanged();
    }

    // ---- Intray mask/index-data staging pane (ADRs 0279/0281/0285) ------------------------------------

    private bool _intrayIsEmail;
    private bool _intrayStgBusy;
    private string _intrayStgName = string.Empty;
    private DateTime? _intrayStgDate;
    private Guid? _intrayStgMaskId;
    private readonly List<EditField> _intrayStgFields = [];
    private List<MaskSummary> _intrayStgMasks = [];
    private Dictionary<Guid, List<string>> _intrayDraftValues = [];
    // Staged OCR languages for a scannable item (.tif/.tiff/.pdf) — consumed at filing (ADR "Inbox OCR-language staging").
    private List<string> _intrayStgOcrCodes = [];
    private bool _intrayStgScannable;

    private async Task SelectIntrayItemAsync(IntrayItem item)
    {
        _selectedIntrayItem = item;
        _preview?.Clear();
        _intrayStgFields.Clear();
        _intrayStgMasks = [];
        _preview?.Clear();

        // Resolve the rendition-backed preview URL (the `preview` link is an endpoint returning JSON, ADR 0279,
        // not a direct file URL — so fetch it and use its previewUrl) plus its text-layout link, then render via
        // the shared pdf.js host with the hit-overlay. 204 = no preview available.
        try
        {
            if (NotOffered(item.PreviewHref)) { return; }

            using var r = await Http.GetAsync(item.PreviewHref);
            if (r.IsSuccessStatusCode && r.StatusCode != HttpStatusCode.NoContent)
            {
                var preview = await r.Content.ReadFromJsonAsync<IntrayPreviewResponse>();

                var textLayoutUrl = Links.Href(preview?.Links, "text-layout");
                await ShowPreviewAsync(preview?.PreviewUrl, textLayoutUrl, preview?.PreviewConverted ?? false);
            }
        }
        catch (Exception)
        {
            // Non-fatal — no preview.
        }

        // Emails are classified automatically by the system on filing — not offered a mask here (ADR 0285).
        _intrayIsEmail = item.Name.EndsWith(".eml", StringComparison.OrdinalIgnoreCase) || item.Name.EndsWith(".msg", StringComparison.OrdinalIgnoreCase);
        if (_intrayIsEmail)
        {
            return;
        }

        try
        {
            _intrayStgMasks = (await Http.GetFromJsonAsync<MaskListResponse>(await ApiRoot.RequireAsync("masks")))?.Masks ?? [];
            if (NotOffered(item.MaskHref)) { return; }

            var draft = await Http.GetFromJsonAsync<IntrayMaskDraft>(item.MaskHref);
            _intrayStgName = string.IsNullOrEmpty(draft?.Name) ? System.IO.Path.GetFileNameWithoutExtension(item.Name) : draft.Name;
            _intrayStgDate = DateTime.TryParse(draft?.DocumentDate, out var d) ? d.Date : null;
            _intrayDraftValues = (draft?.Fields ?? []).ToDictionary(f => f.FieldDefinitionId, f => f.Values);

            // OCR languages: only offered for a scannable item, staged + consumed at filing (ADR "Inbox
            // OCR-language staging"). Load the catalog on demand.
            _intrayStgScannable = IsScannableExtension(item.Name);
            _intrayStgOcrCodes = draft?.OcrLanguages ?? [];
            if (_intrayStgScannable && _ocrCatalog.Count == 0)
            {
                _ocrCatalog = await OcrLanguages.GetAsync();
            }

            // Preselect the staged mask, or default to "Basic Entry" for an un-classified item (ADR 0284).
            _intrayStgMaskId = draft?.MaskId ?? _intrayStgMasks.FirstOrDefault(m => m.Name == "Basic Entry")?.Id;
            await LoadIntrayStgFieldsAsync(_intrayStgMaskId, useDraftValues: true);
        }
        catch (HttpRequestException)
        {
            // Non-fatal — the pane just shows an empty form.
        }
    }

    private async Task LoadIntrayStgFieldsAsync(Guid? maskId, bool useDraftValues)
    {
        _intrayStgFields.Clear();
        if (maskId is not { } id)
        {
            return;
        }

        // The picker's rows are the catalogue listing, and each row carries its own address (ADR 0555) — the
        // fields live behind the chosen row's `self`, not behind a path rebuilt from its id.
        if (Links.Href(_intrayStgMasks.FirstOrDefault(m => m.Id == id)?.Links, "self") is not { } maskHref)
        {
            return;
        }

        var fields = await Http.GetFromJsonAsync<MaskFieldsResponse>(maskHref);
        foreach (var f in fields?.Fields ?? [])
        {
            var values = useDraftValues && _intrayDraftValues.TryGetValue(f.Id, out var v) ? v : [];
            _intrayStgFields.Add(EditField.Create(f, values));
        }
    }

    private async Task OnIntrayStgMaskChanged(Guid? maskId)
    {
        _intrayStgMaskId = maskId;
        await LoadIntrayStgFieldsAsync(maskId, useDraftValues: false);
    }

    // Toggle a staged OCR language (ordered: click appends the next priority, click again removes + renumbers).
    private void ToggleIntrayOcr(string code)
    {
        if (!_intrayStgOcrCodes.Remove(code))
        {
            _intrayStgOcrCodes.Add(code);
        }
    }

    // OCR-language staging only applies to the scannable types the searchable-PDF conversion runs on at filing.
    private static bool IsScannableExtension(string name) =>
        System.IO.Path.GetExtension(name).ToLowerInvariant() is ".tif" or ".tiff" or ".pdf";

    // Saves the staged Name/Document date/mask/index-data to the item's {name}.mask.json sidecar (ADR 0281).
    private async Task SaveIntrayMaskAsync()
    {
        if (_selectedIntrayItem is not { } item)
        {
            return;
        }

        _intrayStgBusy = true;
        try
        {
            var body = new
            {
                name = string.IsNullOrWhiteSpace(_intrayStgName) ? null : _intrayStgName.Trim(),
                documentDate = _intrayStgDate?.ToString("yyyy-MM-dd"),
                maskId = _intrayStgMaskId,
                fields = _intrayStgFields.Select(f => new { fieldDefinitionId = f.FieldDefinitionId, values = f.ToValues() }),
                ocrLanguages = _intrayStgScannable && _intrayStgOcrCodes.Count > 0 ? _intrayStgOcrCodes : null,
            };

            if (NotOffered(item.MaskHref)) { return; }

            var resp = await Http.PutAsJsonAsync(item.MaskHref, body);
            if (resp.IsSuccessStatusCode)
            {
                Snackbar.Add(Strings.Get("StMaskSaved"), Severity.Success);
                var name = item.Name;
                await LoadIntrayAsync();                 // refresh the square-bracket indicator
                var fresh = _intrayItems.FirstOrDefault(i => i.Name == name);
                if (fresh is not null)
                {
                    await SelectIntrayItemAsync(fresh);
                }
            }
            else
            {
                Snackbar.Add(Strings.Get("StErrMaskSave"), Severity.Error);
            }
        }
        finally
        {
            _intrayStgBusy = false;
        }
    }

    private readonly HashSet<IntrayItem> _intrayChecked = [];

    // The row the next Shift-click ranges from. Set by every click that establishes a position — a plain
    // single-select and a Ctrl-click both do; a Shift-click extends and leaves it where it was, so shifting
    // twice grows the same range instead of walking the anchor along behind the cursor.
    private IntrayItem? _intrayAnchor;

    // Native multi-selection, the same shape the Repositories list uses (ADR "Bulk actions on selected
    // documents"): Ctrl/Cmd-click toggles a row into the checked set, Shift-click takes the range from the
    // anchor, and a plain click clears the set and single-selects. The checked set is what the page operations
    // and "file N items" already act on, so this is the pointer-device way to build it — the checkbox column
    // stays for touch, where there are no modifier keys.
    private async Task OnIntrayRowClickAsync(IntrayItem item, Microsoft.AspNetCore.Components.Web.MouseEventArgs e)
    {
        if (e.CtrlKey || e.MetaKey)
        {
            if (!_intrayChecked.Remove(item))
            {
                _intrayChecked.Add(item);
            }

            _intrayAnchor = item;
            return;
        }

        if (e.ShiftKey && _intrayAnchor is { } anchor)
        {
            var a = _intrayItems.IndexOf(anchor);
            var b = _intrayItems.IndexOf(item);
            if (a >= 0 && b >= 0)
            {
                for (var i = Math.Min(a, b); i <= Math.Max(a, b); i++)
                {
                    _intrayChecked.Add(_intrayItems[i]);
                }

                return;
            }
        }

        // A plain click makes this row the whole selection — it does not merely EMPTY the checked set. The page
        // operations (split, sort, straighten, cut) each need exactly one checked item, so a click that cleared
        // the set would take them off the toolbar on every pointer device: you would have to tick a hidden
        // checkbox to get them back. "Selected" and "checked" are one thing here; the checkbox column, where it
        // shows, is a second way to reach the same set.
        _intrayChecked.Clear();
        _intrayChecked.Add(item);
        _intrayAnchor = item;
        await SelectIntrayItemAsync(item);
    }

    // One button, one scope. The count is in the name whenever there is more than one thing to move, because
    // the label is hidden on a pointer device and the tooltip is then the only place it can say how many.
    private string FileCheckedLabel => _intrayChecked.Count > 1
        ? string.Format(Strings.Get("IntrayFileN"), _intrayChecked.Count)
        : Strings.Get("IntrayFileToFolder");

    // Exactly one checked item takes the single-item dialog (it names the file); more take the bulk one. Both
    // read the CHECKED set rather than _selectedIntrayItem: after Ctrl-clicking a row back out, the detail pane
    // still shows whatever it last loaded, and filing what the pane shows rather than what is highlighted is
    // the mistake ADR 0559 is about.
    private Task FileCheckedAsync() => _intrayChecked.Count switch
    {
        0 => Task.CompletedTask,
        1 => FileIntrayItemAsync(_intrayChecked.Single()),
        _ => FileMultipleAsync(),
    };

    private void ToggleIntrayCheck(IntrayItem item, bool on)
    {
        if (on) { _intrayChecked.Add(item); } else { _intrayChecked.Remove(item); }
        _intrayAnchor = item;
    }

    // Shows the context-aware filing dialog seeded with the Repositories tab's current selection (ADR 0286).
    private async Task<FilingDialog.FilingChoice?> ShowFilingDialogAsync(string title, bool bulk)
    {
        var parameters = new DialogParameters<FilingDialog>
        {
            { x => x.DocumentId, bulk ? null : CurrentDocumentId },
            { x => x.DocumentName, CurrentDocumentId is null ? null : CurrentDocumentName },
            { x => x.FolderId, CurrentFolderId },
            { x => x.FolderName, CurrentFolderName },
            { x => x.Bulk, bulk },
        };
        var dialog = await DialogService.ShowAsync<FilingDialog>(title, parameters);
        var result = await dialog.Result;
        return result is { Canceled: false, Data: FilingDialog.FilingChoice choice } ? choice : null;
    }

    // Posts one file request (as a new version, or into a folder), with the optional feed comment (ADR 0287).
    private async Task<bool> PostFileAsync(IntrayItem item, FilingDialog.FilingChoice choice)
    {
        object body = choice.Mode == FilingDialog.FilingMode.AsVersion
            ? new { documentId = choice.TargetId, comment = choice.Comment }
            : new { folderId = choice.TargetId, comment = choice.Comment };

        if (NotOffered(item.FileHref)) { return false; }

        var response = await Http.PostAsJsonAsync(item.FileHref, body);
        if (response.IsSuccessStatusCode)
        {
            return true;
        }

        Snackbar.Add(string.Format(
            Strings.Get(response.StatusCode == HttpStatusCode.Forbidden ? "StNoPermFileThere" : "StErrFileItem"),
            item.Name), Severity.Warning);
        return false;
    }

    private async Task FileIntrayItemAsync(IntrayItem item)
    {
        var choice = await ShowFilingDialogAsync($"File '{item.Name}'", bulk: false);
        if (choice is null)
        {
            return;
        }

        if (await PostFileAsync(item, choice))
        {
            Snackbar.Add(string.Format(
                Strings.Get(choice.Mode == FilingDialog.FilingMode.AsVersion ? "StFiledAsVersion" : "StFiledItem"),
                item.Name), Severity.Success);
            ClearIntraySelection(item);
            await LoadIntrayAsync();
        }
    }

    // Bulk-file the checked items into one folder, each with the same optional comment (ADR 0288).
    private async Task FileMultipleAsync()
    {
        var items = _intrayItems.Where(_intrayChecked.Contains).ToList();
        if (items.Count == 0)
        {
            return;
        }

        var choice = await ShowFilingDialogAsync($"File {items.Count} items", bulk: true);
        if (choice is null)
        {
            return;
        }

        var filed = 0;
        foreach (var it in items)
        {
            if (await PostFileAsync(it, choice))
            {
                filed++;
            }
        }

        Snackbar.Add(string.Format(Strings.Get("StFiledOf"), filed, items.Count), Severity.Success);
        _intrayChecked.Clear();
        await LoadIntrayAsync();
    }


    // The "show group intrays" filter (ADR 0532) — off by default; clears any admin user-view when toggled.
    private async Task ToggleIntrayGroupsAsync(bool on)
    {
        _intrayIncludeGroups = on;
        _intrayViewUserId = null;
        await LoadIntrayAsync();
    }

    // The admin user-picker (CanManageIntrays) — open a chosen user's intray, or back to my own (null).
    private async Task ViewUserIntrayAsync(Guid? userId)
    {
        _intrayViewUserId = userId;
        if (userId is not null)
        {
            _intrayIncludeGroups = false;
        }

        await LoadIntrayAsync();
    }


    private record IntrayResponse { public List<IntrayItemDto> Items { get; set; } = []; public List<LinkResponse> Links { get; set; } = []; }
    private record IntrayItemDto { public string Name { get; set; } = string.Empty; public long Size { get; set; } public bool HasMask { get; set; } public bool Signed { get; set; } public Guid? GroupId { get; set; } public string? GroupName { get; set; } public Guid? UserId { get; set; } public string? UserName { get; set; } public List<LinkResponse> Links { get; set; } = []; }
    private record IntrayMaskDraft { public string? Name { get; set; } public string? DocumentDate { get; set; } public Guid? MaskId { get; set; } public List<IntrayDraftField> Fields { get; set; } = []; public List<string>? OcrLanguages { get; set; } }
    private record IntrayPreviewResponse { public string? PreviewUrl { get; set; } public bool PreviewConverted { get; set; } public List<LinkResponse> Links { get; set; } = []; }
    private record IntrayDraftField { public Guid FieldDefinitionId { get; set; } public List<string> Values { get; set; } = []; }
    private record UploadIntrayResponse { public string Name { get; set; } = string.Empty; public string UploadUrl { get; set; } = string.Empty; }
    private record IntrayUsersResponse { public List<IntrayUserOption> Users { get; set; } = []; }
}
