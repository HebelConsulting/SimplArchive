@using System.Net
@using Microsoft.AspNetCore.Components.Forms
@inject HttpClient Http
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject SimplArchive.Client.Services.ApiRoot ApiRoot
@inject SimplArchive.Client.Services.InboxUploads InboxUploads
@inject SimplArchive.Client.Services.OcrLanguageCatalog OcrLanguages
@inject SimplArchive.Client.Services.WebDavMountLink WebDavLink
@implements IAsyncDisposable

@* The Inbox tab of the workbench (ADR "S3-backed inbox"), extracted from Home.razor per ADR 0558.

   Staged files waiting to be filed into a repository: uploaded by picker or by dropping onto the list, given a
   mask + index data here, then filed. Self-contained — it owns its list, its staging form, its drop-zone and
   the DotNetObjectReference dropUpload.js calls back into, so nothing about it lives in the shell any more.

   Two facts arrive as parameters rather than being re-fetched (ADR 0557): whether the caller may triage other
   people's inboxes, and which folder the Repositories tree has selected, which pre-fills the filing target. *@

@* Only this tab has a filter row, so its rule lives here rather than in the shell, which may only shrink
   (ADR 0558). Bottom-aligned because the switch and the select have different label geometry and would
   otherwise sit at different heights. *@
<style>
    .wb-inbox-filters { flex: 0 0 auto; display: flex; align-items: flex-end; gap: 16px; padding: 2px 2px 8px; }
    /* Both filters size to themselves: a MudSelect's root is a block, so in a flex row it otherwise grows to
       the full width of the list and reads as an input you are meant to type a whole line into. */
    .wb-inbox-filters > * { flex: 0 0 auto; }
    .wb-inbox-filters .mud-select { width: 240px; }
</style>

@* Per-user S3-backed inbox (ADR "S3-backed inbox") — staged files to file into a repository. *@
<div class="wb-search">
    <div class="wb-search-bar">
        @* Flat, like every other button here. It used to carry a filled accent to say "start here", which was
           unambiguous while it was a rounded rect with a label — but in a row of circles whose toggles show ON
           as filled primary, a filled circle says "pressed", not "primary". The tab already says where to
           start: this is the first button, and the list below it is a drop-zone that says so in words. *@
        <MudButton Class="wb-rib-btn" Size="Size.Small"
                   HtmlTag="label" for="inbox-file-input"
                   title="@Strings.Get("InboxUpload")" aria-label="@Strings.Get("InboxUpload")">
            <MudIcon Icon="@Icons.Material.Filled.Upload" Size="Size.Small" /><span class="wb-rib-label">@Strings.Get("InboxUpload")</span>
        </MudButton>
        <InputFile id="inbox-file-input" OnChange="OnInboxInputChangeAsync" multiple style="display:none" />
        <MudButton Class="wb-rib-btn ml-2" Size="Size.Small" OnClick="LoadInboxAsync"
                   title="@Strings.Get("RibbonRefresh")" aria-label="@Strings.Get("RibbonRefresh")">
            <MudIcon Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" /><span class="wb-rib-label">@Strings.Get("RibbonRefresh")</span>
        </MudButton>
        <MudButton Class="wb-rib-btn ml-2" Size="Size.Small" OnClick="@(() => WebDavLink.CopyAsync(WebDavFolder))"
                   title="@Strings.Get("InboxCopyDav")" aria-label="@Strings.Get("InboxCopyDav")">
            <MudIcon Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" /><span class="wb-rib-label">@Strings.Get("InboxCopyDav")</span>
        </MudButton>
        @* Own-items-only by default; held DOWN it reveals my group inboxes (ADR 0532). A toggle rather than the
           switch it used to be: it is a sticky on/off that belongs beside the other actions on this view, and a
           switch with a written label set the height of every button next to it. Disabled while viewing another
           user's inbox — the two selectors are mutually exclusive. *@
        <MudToggleIconButton Toggled="_inboxIncludeGroups" ToggledChanged="ToggleInboxGroupsAsync" Size="Size.Small"
                             Icon="@Icons.Material.Outlined.Groups" ToggledIcon="@Icons.Material.Filled.Groups"
                             Color="Color.Default" ToggledColor="Color.Primary" Class="ml-1"
                             Disabled="@(_inboxViewUserId is not null)"
                             title="@Strings.Get("InboxShowGroups")" />
        @* Selected-item group, FIRST — the desktop's shape (#521, ADR 0511). The same actions the row's ⋮ menu
           offers, differing only in SCOPE: the menu acts on the row it was opened from, these on the current
           selection. Disabled rather than hidden when nothing is selected, which is the Repositories ribbon's
           rule: a right you do not hold is not advertised, but a button that merely has nothing to act on yet
           stays put, so the bar does not reflow under the cursor. *@
        @* ONE file button, and its scope is the checked set. There used to be two — a "File to folder…" acting
           on the single selection and a "File N items" that appeared beside it once two rows were checked —
           which put two buttons carrying the same glyph next to each other, differing only in a scope the user
           could not see. Now that a plain click makes the clicked row the whole checked set, "the selection"
           and "what is checked" are the same thing, so one button says it: it files what is highlighted,
           however many that is, and the tooltip carries the count when there is more than one. *@
        <MudButton Class="wb-rib-btn ml-2" Size="Size.Small" Disabled="@(_inboxChecked.Count == 0)"
                   OnClick="FileCheckedAsync" title="@FileCheckedLabel" aria-label="@FileCheckedLabel">
            <MudIcon Icon="@Icons.Material.Filled.DriveFileMove" Size="Size.Small" /><span class="wb-rib-label">@FileCheckedLabel</span>
        </MudButton>
        @if (_selectedInboxItem?.IsOwn != false)
        {
            <MudButton Class="wb-rib-btn ml-1" Size="Size.Small" Disabled="@(_selectedInboxItem is null)"
                       OnClick="@(() => SendInboxItemAsync(_selectedInboxItem!))"
                       title="@Strings.Get("InboxSendTitle")" aria-label="@Strings.Get("InboxSendTitle")">
                <MudIcon Icon="@Icons.Material.Filled.Send" Size="Size.Small" /><span class="wb-rib-label">@Strings.Get("InboxSendTitle")</span>
            </MudButton>
        }
        else
        {
            <MudButton Class="wb-rib-btn ml-1" Size="Size.Small"
                       OnClick="@(() => MoveToMyInboxAsync(_selectedInboxItem!))"
                       title="@Strings.Get("InboxClaimToMine")" aria-label="@Strings.Get("InboxClaimToMine")">
                <MudIcon Icon="@Icons.Material.Filled.MoveToInbox" Size="Size.Small" /><span class="wb-rib-label">@Strings.Get("InboxClaimToMine")</span>
            </MudButton>
        }
        <MudButton Class="wb-rib-btn ml-1" Size="Size.Small" Disabled="@(_selectedInboxItem is null)"
                   OnClick="@(() => DownloadInboxItemAsync(_selectedInboxItem!))"
                   title="@Strings.Get("Download")" aria-label="@Strings.Get("Download")">
            <MudIcon Icon="@Icons.Material.Filled.Download" Size="Size.Small" /><span class="wb-rib-label">@Strings.Get("Download")</span>
        </MudButton>
        @* Delete composes across the CHECKED set like File selected does (N deletes, one confirm naming the
           count, one summary — the checkout tab's bulk story); with nothing checked it acts on the selected
           row (review finding). The row's ⋮ twin stays single — it acts on its own row (ADR 0559). *@
        <MudButton Class="wb-rib-btn ml-1" Size="Size.Small" Disabled="@(_selectedInboxItem is null && _inboxChecked.Count == 0)"
                   OnClick="DeleteInboxSelectionAsync"
                   title="@Strings.Get("RibbonDelete")" aria-label="@Strings.Get("RibbonDelete")">
            <MudIcon Icon="@Icons.Material.Filled.Delete" Size="Size.Small" /><span class="wb-rib-label">@Strings.Get("RibbonDelete")</span>
        </MudButton>

        @* Page operations (#487, ADR 0575), matching the desktop ribbon's group. Each appears only when the
           server said it can succeed: one checked item with more than one page for split/sort, two or more for
           join. A missing rel means "not available to you, here, now" (ADR 0543/0554). *@
        @if (_pages is { CanSplit: true })
        {
            <MudButton Class="wb-rib-btn ml-2" Size="Size.Small" OnClick="SplitPagesAsync"
                       title="@Strings.Get("InboxSplit")" aria-label="@Strings.Get("InboxSplit")">
                <MudIcon Icon="@Icons.Material.Filled.CallSplit" Size="Size.Small" /><span class="wb-rib-label">@Strings.Get("InboxSplit")</span>
            </MudButton>
        }
        @if (_pages is { CanSort: true })
        {
            <MudButton Class="wb-rib-btn ml-2" Size="Size.Small" OnClick="SortPagesAsync"
                       title="@Strings.Get("InboxSortTitle")" aria-label="@Strings.Get("InboxSortTitle")">
                <MudIcon Icon="@Icons.Material.Filled.Sort" Size="Size.Small" /><span class="wb-rib-label">@Strings.Get("InboxSortTitle")</span>
            </MudButton>
        }
        @if (_inboxChecked.Count >= 2 && _joinHref is not null)
        {
            <MudButton Class="wb-rib-btn ml-2" Size="Size.Small" OnClick="JoinItemsAsync"
                       title="@Strings.Get("InboxJoinTitle")" aria-label="@Strings.Get("InboxJoinTitle")">
                <MudIcon Icon="@Icons.Material.Filled.CallMerge" Size="Size.Small" /><span class="wb-rib-label">@Strings.Get("InboxJoinTitle")</span>
            </MudButton>
        }
        @if (_pages is { CanDeskew: true })
        {
            <MudButton Class="wb-rib-btn ml-2" Size="Size.Small" OnClick="DeskewAsync"
                       title="@Strings.Get("InboxDeskewNow")" aria-label="@Strings.Get("InboxDeskewNow")">
                <MudIcon Icon="@Icons.Material.Filled.Straighten" Size="Size.Small" /><span class="wb-rib-label">@Strings.Get("InboxDeskewNow")</span>
            </MudButton>
        }
        @if (_pages is { CanCutAtPatchCodes: true })
        {
            <MudButton Class="wb-rib-btn ml-2" Size="Size.Small" OnClick="CutAtPatchCodesAsync"
                       title="@Strings.Get("InboxPatchCutNow")" aria-label="@Strings.Get("InboxPatchCutNow")">
                <MudIcon Icon="@Icons.Material.Filled.ContentCut" Size="Size.Small" /><span class="wb-rib-label">@Strings.Get("InboxPatchCutNow")</span>
            </MudButton>
        }
        @* The sticky preferences, held DOWN while on — the desktop's ribbon toggles, in this tab's toolbar
           (ADR 0511). Server-side per user, because the Worker's sweep reads them for WebDAV arrivals.

           Size.Small on every one of these: an icon button defaults to Medium (a 24px glyph in a 48px button)
           while a Size.Small MudButton is a 20px glyph in a 28px one — mixing the two made this bar 52px tall
           against the Repositories ribbon's 41px, which reads as "the Inbox has bigger icons". A toolbar is one
           row of one size. *@
        <MudToggleIconButton Toggled="_rotateAutomatically" ToggledChanged="SetRotateAutomaticallyAsync" Size="Size.Small"
                             Icon="@Icons.Material.Outlined.RotateRight" ToggledIcon="@Icons.Material.Filled.RotateRight"
                             Color="Color.Default" ToggledColor="Color.Primary" Class="ml-2"
                             title="@Strings.Get("InboxRotateAutoTip")" />
        <MudToggleIconButton Toggled="_deskewAutomatically" ToggledChanged="SetDeskewAutomaticallyAsync" Size="Size.Small"
                             Icon="@Icons.Material.Outlined.AutoFixHigh" ToggledIcon="@Icons.Material.Filled.AutoFixHigh"
                             Color="Color.Default" ToggledColor="Color.Primary" Class="ml-1"
                             title="@Strings.Get("InboxDeskewAutoTipTiff")" />
        <MudToggleIconButton Toggled="_cutAtPatchCodesAutomatically" ToggledChanged="SetCutAtPatchCodesAutomaticallyAsync" Size="Size.Small"
                             Icon="@Icons.Material.Outlined.ContentCut" ToggledIcon="@Icons.Material.Filled.ContentCut"
                             Color="Color.Default" ToggledColor="Color.Primary" Class="ml-1"
                             title="@Strings.Get("InboxPatchAutoTip")" />
        @if (_patchCodeSheetHref is { } sheetHref)
        {
            @* A plain link, because the browser already knows how to show a PDF and then print it — a fetch
               into a blob would take that away and give nothing back. *@
            <MudIconButton Href="@sheetHref" Target="_blank" Icon="@Icons.Material.Filled.Print" Class="ml-1" Size="Size.Small"
                           title="@Strings.Get("InboxPatchSheetTip")" />
        }
        @if (_inboxBusy)
        {
            <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="ml-2" />
        }
    </div>
    <div class="wb-search-status">@_inboxStatus</div>
    @if (CanManageInboxes)
    {
        @* The one filter that cannot be a button: it picks a value out of a list, and the list is as long as
           the tenant has users. So it sits BELOW the action bar and directly above the list it filters — where
           the desktop already puts it (ADR 0511) — rather than setting the bar's height for every button beside
           it. Its companion, "show group inboxes", is an on/off and went to the bar as a toggle.

           CanManageInboxes: open any user's inbox for triage; "My inbox" resets to own. *@
        <div class="wb-inbox-filters">
            <MudSelect T="Guid?" Value="_inboxViewUserId" ValueChanged="ViewUserInboxAsync" Dense="true"
                       Margin="Margin.Dense" Variant="Variant.Outlined"
                       Label="@Strings.Get("InboxUserPicker")">
                <MudSelectItem T="Guid?" Value="@((Guid?)null)">@Strings.Get("InboxMine")</MudSelectItem>
                @foreach (var u in _inboxUsers)
                {
                    <MudSelectItem T="Guid?" Value="@((Guid?)u.Id)">@u.Name</MudSelectItem>
                }
            </MudSelect>
        </div>
    }
    <div style="display:flex; flex:1 1 auto; min-height:0;">
        @* Drop-zone: dropping OS files anywhere on this list uploads them straight into the inbox
           (ADR "Inbox file-list drop-zone"). *@
        <div class="wb-search-results wb-inbox-drop" style="flex:1 1 40%; min-width:0;" @ref="_dropZone">
            <div class="wb-inbox-drophint"><MudIcon Icon="@Icons.Material.Filled.CloudUpload" Size="Size.Small" /> @Strings.Get("InboxDropHint")</div>
            @foreach (var item in _inboxItems)
            {
                <div class="wb-list-row @(item == _selectedInboxItem || _inboxChecked.Contains(item) ? "wb-list-row-selected" : "")" @onclick="e => OnInboxRowClickAsync(item, e)">
                    @* The checkbox is the TOUCH affordance only. On a device with a hover and a fine pointer
                       the list multi-selects natively — Ctrl/Cmd-click toggles a row in, Shift-click takes a
                       range — which is what the Repositories list has always done, and what anyone who selects
                       files in their own OS expects. Touch has neither modifier keys nor a right-click, so
                       there the checkbox IS the affordance; the same input-device query that decides whether a
                       toolbar shows labels decides this (ADR 0491). *@
                    <div class="wb-touch-only" @onclick:stopPropagation="true">
                        <MudCheckBox T="bool" Value="_inboxChecked.Contains(item)" ValueChanged="@(v => ToggleInboxCheck(item, v))" Dense="true" Size="Size.Small" />
                    </div>
                    <MudIcon Icon="@(item.GroupId is not null ? Icons.Material.Filled.Group : item.UserId is not null ? Icons.Material.Filled.Person : Icons.Material.Filled.InsertDriveFile)" Size="Size.Small" />
                    <span style="flex:1 1 auto; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@item.DisplayName</span>
                    @if (!item.IsOwn && item.SourceLabel is { } src)
                    {
                        @* Whose queue this item came from (a group, or — for an admin view — another user). *@
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Default" Class="ma-0">@src</MudChip>
                    }
                    @if (item.Signed)
                    {
                        @* Every page operation would void a signature, so none is offered on this row (#491). *@
                        <MudTooltip Text="@Strings.Get("SignedBadgeTip")">
                            <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined"
                                     Icon="@Icons.Material.Filled.WorkspacePremium" Class="ma-0">@Strings.Get("SignedBadge")</MudChip>
                        </MudTooltip>
                    }
                    <span class="mud-text-secondary" style="font-size:.8em;">@SimplArchive.Client.Services.ByteSize.Format(item.Size)</span>
                    <div @onclick:stopPropagation="true">
                        <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true" AnchorOrigin="Origin.BottomLeft">
                            <MudMenuItem Icon="@Icons.Material.Filled.DriveFileMove" OnClick="() => FileInboxItemAsync(item)">@Strings.Get("InboxFileToFolder")</MudMenuItem>
                            @if (item.IsOwn)
                            {
                                @* Own items can be handed to a group or another user (ADR 0532). *@
                                <MudMenuItem Icon="@Icons.Material.Filled.Send" OnClick="() => SendInboxItemAsync(item)">@Strings.Get("InboxSendTitle")</MudMenuItem>
                            }
                            else
                            {
                                @* A group/other-user item can be claimed into my own inbox. *@
                                <MudMenuItem Icon="@Icons.Material.Filled.MoveToInbox" OnClick="() => MoveToMyInboxAsync(item)">@Strings.Get("InboxClaimToMine")</MudMenuItem>
                            }
                            <MudMenuItem Icon="@Icons.Material.Filled.Download" OnClick="() => DownloadInboxItemAsync(item)">@Strings.Get("Download")</MudMenuItem>
                            <MudMenuItem Icon="@Icons.Material.Filled.Delete" IconColor="Color.Error" OnClick="() => DeleteInboxItemAsync(item)">@Strings.Get("RibbonDelete")</MudMenuItem>
                        </MudMenu>
                    </div>
                </div>
            }
        </div>
        @if (_selectedInboxItem is not null)
        {
            <div style="flex:1 1 60%; min-width:0; border-left:1px solid var(--mud-palette-lines-default); display:flex; flex-direction:column;">
                @* Mask/index-data staging pane (ADRs 0279/0281/0285). *@
                <div style="flex:0 0 auto; max-height:46%; overflow:auto; padding:10px 14px; border-bottom:1px solid var(--mud-palette-lines-default);">
                    <MudText Typo="Typo.subtitle2">@_selectedInboxItem.Name</MudText>
                    @if (_inboxIsEmail)
                    {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-2">
                            <MudIcon Icon="@Icons.Material.Filled.MarkEmailRead" Size="Size.Small" /> @Strings.Get("InboxEmailAutoMask")
                        </MudText>
                    }
                    else
                    {
                        <table class="wb-sysfields">
                            <tr><td>@Strings.Get("Name")</td><td><MudTextField @bind-Value="_inboxStgName" Margin="Margin.Dense" Variant="Variant.Outlined" /></td></tr>
                            <tr><td>@Strings.Get("VerColDocDate")</td><td><MudDatePicker @bind-Date="_inboxStgDate" DateFormat="yyyy-MM-dd" Margin="Margin.Dense" Variant="Variant.Outlined" /></td></tr>
                            @if (_inboxStgScannable)
                            {
                                @* OCR languages for a scannable item — staged + applied to the searchable-PDF conversion at filing (ADR "Inbox OCR-language staging"). *@
                                <tr>
                                    <td>@Strings.Get("SysOcrLanguages")</td>
                                    <td>
                                        <div class="wb-ocr-chips">
                                            @foreach (var lang in _ocrCatalog)
                                            {
                                                var idx = _inboxStgOcrCodes.IndexOf(lang.Code);
                                                <button type="button" class="wb-ocr-chip @(idx >= 0 ? "wb-ocr-chip-on" : "")" @onclick="() => ToggleInboxOcr(lang.Code)">@(idx >= 0 ? $"{idx + 1}. " : "")@lang.DisplayName</button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </table>
                        <div class="wb-mask-edit">
                            <div class="wb-mask-row">
                                <span class="wb-mask-label">@Strings.Get("MaskLabel")</span>
                                <MudSelect T="Guid?" Value="_inboxStgMaskId" ValueChanged="OnInboxStgMaskChanged" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined">
                                    <MudSelectItem T="Guid?" Value="@((Guid?)null)">@Strings.Get("NoMask")</MudSelectItem>
                                    @foreach (var m in _inboxStgMasks)
                                    {
                                        <MudSelectItem T="Guid?" Value="@((Guid?)m.Id)">@m.Name</MudSelectItem>
                                    }
                                </MudSelect>
                            </div>
                            @foreach (var f in _inboxStgFields)
                            {
                                <div class="wb-mask-row">
                                    <span class="wb-mask-label">@f.Label</span>
                                    @if (f.IsDate)
                                    {
                                        <MudDatePicker @bind-Date="f.DateValue" DateFormat="yyyy-MM-dd" Margin="Margin.Dense" Variant="Variant.Outlined" />
                                    }
                                    else if (f.IsBoolean)
                                    {
                                        <MudCheckBox T="bool" @bind-Value="f.BoolValue" />
                                    }
                                    else if (f.IsMultiSelect)
                                    {
                                        <MudTextField @bind-Value="f.TextValue" Lines="3" Placeholder="@Strings.Get("OneValuePerLine")" Margin="Margin.Dense" Variant="Variant.Outlined" />
                                    }
                                    else
                                    {
                                        <MudTextField @bind-Value="f.TextValue" Margin="Margin.Dense" Variant="Variant.Outlined" />
                                    }
                                </div>
                            }
                        </div>
                        <div class="wb-detail-actions">
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveInboxMaskAsync" Disabled="_inboxStgBusy">@Strings.Get("Save")</MudButton>
                        </div>
                    }
                </div>
                @* The inbox previews a STAGED file — nothing to annotate, so no Toolbar and no
                   annotation host; the gestures become no-ops rather than missing features. *@
                <PreviewPane @ref="_preview"
                             Style="flex:1 1 auto; min-height:0; position:relative; display:flex; flex-direction:column;"
                             EmptyText="@(_selectedInboxItem is null ? Strings.Get("NoItemSelected") : Strings.Get("NoPreview"))"
                             ConvertedBadgeTooltip="This is a generated preview, not the original file." />
            </div>
        }
    </div>
</div>

@code {

    /// <summary>
    /// The folder currently selected in the Repositories tree, used to pre-fill the filing dialog. Arrives as a
    /// parameter because the shell already holds it — asking the server again would be a request spent learning
    /// something known (ADR 0557).
    /// </summary>
    [Parameter]
    public Guid? CurrentFolderId { get; set; }

    /// <summary>The selected folder's name, shown in the filing dialog beside its id.</summary>
    [Parameter]
    public string? CurrentFolderName { get; set; }

    /// <summary>Whether the caller may open another user's inbox for triage (the CanManageInboxes right).</summary>
    [Parameter]
    public bool CanManageInboxes { get; set; }

    /// <summary>
    /// Copies the WebDAV mount URL. Stays in the shell because the Check-out tab offers the same action, and it
    /// is stateless — a candidate for a small shared service when the shell is finally thinned (PR 4).
    /// </summary>
    /// <summary>This tab's folder inside the WebDAV mount — the desktop's button opens it; the web copies it.</summary>
    private const string WebDavFolder = "Personal/Inbox";

    /// <summary>
    /// The document selected on the Repositories tab, offered as "file as a new version of it" (ADR 0286).
    /// Null unless a real document is selected — the shell decides that, since it owns the selection.
    /// </summary>
    [Parameter]
    public Guid? CurrentDocumentId { get; set; }

    /// <summary>That document's name, shown in the filing dialog.</summary>
    [Parameter]
    public string? CurrentDocumentName { get; set; }

    /// <summary>The signed-in user's id, used to tell own items from a group's.</summary>
    [Parameter]
    public Guid? MyUserId { get; set; }

    // The tenant's OCR languages, fetched on demand the first time a scannable item is selected. The tab keeps
    // its own copy rather than sharing the shell's: it is a small catalogue, read at most once per session here,
    // and a cache shared across tabs is the coupling this decomposition is unwinding.
    private IReadOnlyList<OcrLanguageOption> _ocrCatalog = [];

    private ElementReference _dropZone;
    private bool _dropWired;
    private IJSObjectReference? _module;
    private DotNetObjectReference<InboxTab>? _selfRef;
    private PreviewPane? _preview;

    // A preview requested before the pane existed. The pane sits inside "is an item selected?", so the FIRST
    // selection is what creates it — and rendering into a null ref would lose the preview silently (ADR 0558).
    private (string? Url, string? Layout, bool Converted)? _pendingPreview;

    protected override async Task OnInitializedAsync() => await LoadInboxAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _selfRef = DotNetObjectReference.Create(this);
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./dropUpload.js");
        }

        // Wire the file-list drop-zone once its element is real (ADR "Inbox file-list drop-zone"). initInboxDrop
        // returns false until then, so simply retry on each render.
        if (!_dropWired && _module is not null)
        {
            _dropWired = await _module.InvokeAsync<bool>("initInboxDrop", _dropZone, _selfRef);
        }

        // Last, after the wiring: this is the only await here that can take real time.
        if (_pendingPreview is { } pending && _preview is not null)
        {
            _pendingPreview = null;
            await ShowPreviewAsync(pending.Url, pending.Layout, pending.Converted);
            StateHasChanged();
        }
    }

    // Renders into the pane, or remembers the request until the pane exists (see _pendingPreview).
    private async Task ShowPreviewAsync(string? url, string? layout, bool converted)
    {
        if (_preview is null)
        {
            _pendingPreview = (url, layout, converted);
            return;
        }

        await _preview.RenderAsync(url, layout, converted);
    }

    public async ValueTask DisposeAsync()
    {
        _selfRef?.Dispose();
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException) { /* page is going away */ }
            catch (JSException) { /* module already torn down */ }
        }
    }

    private List<InboxItem> _inboxItems = [];
    private string _inboxStatus = "";
    private bool _inboxBusy;
    private InboxItem? _selectedInboxItem;
    // Inbox view filters (ADR 0532): own-items-only by default; a toggle reveals my group inboxes, and a
    // CanManageInboxes holder can open a specific user's inbox via the user-picker (mutually exclusive with groups).
    private bool _inboxIncludeGroups;
    private Guid? _inboxViewUserId;
    private List<InboxUserOption> _inboxUsers = []; // the admin user-picker's choices (CanManageInboxes only)
    private sealed record InboxUserOption(Guid Id, string Name);
    // Every address this row acts on comes from the listing that drew it (ADR 0555) — including `mask` and
    // `preview`, which the row had been carrying all along while the tab rebuilt them from Name plus a
    // hand-written `?group=`/`?user=` query. The server's own hrefs already carry that source query, so the
    // SourceQuery property that existed to re-append it is gone (ADR 0532/0543, #416).
    private record InboxItem(string Name, long Size, bool HasMask, string DownloadHref, string PreviewHref, string FileHref, string DeleteHref, string MoveHref, string MaskHref, Guid? GroupId, string? GroupName, Guid? UserId, string? UserName, string? PagesHref, bool Signed)
    {
        // Un-classified items (no staged mask sidecar) show in square brackets (ADRs 0279/0281).
        public string DisplayName => HasMask ? Name : $"[{Name}]";

        // True for the caller's own items (no group/user source) — they get the "Send to…" action; non-own items
        // get "Move to my inbox".
        public bool IsOwn => GroupId is null && UserId is null;

        // The `[GroupName]` / `[UserName]` source label shown before the name; null for own items.
        public string? SourceLabel => GroupName ?? UserName;
    }

    private async Task LoadInboxAsync()
    {
        // The toggle's state belongs to the USER, not the browser, so it is read from the server rather than
        // restored from layout persistence (#491).
        try
        {
            var me = await Http.GetFromJsonAsync<MeResponse>(await ApiRoot.RequireAsync("me"));
            _deskewAutomatically = me?.DeskewInboxUploads ?? true;
            _rotateAutomatically = me?.RotateInboxUploads ?? true;
            _cutAtPatchCodesAutomatically = me?.CutInboxUploadsAtPatchCodes ?? true;
        }
        catch (Exception)
        {
            // Leave it at its default; the ribbon still works and the server remains the authority.
        }

        _inboxBusy = true;
        _inboxStatus = "Loading…";
        _inboxChecked.Clear();
        try
        {
            // A CanManageInboxes holder gets a user-picker; load the tenant's users once for it.
            if (CanManageInboxes && _inboxUsers.Count == 0)
            {
                var users = await Http.GetFromJsonAsync<InboxUsersResponse>(await ApiRoot.RequireAsync("inboxUsers"));
                _inboxUsers = users?.Users ?? [];
            }

            // The server owns the path, the caller owns the filter: appending a QUERY to the advertised href is
            // FOLLOWING it, where appending a path segment would be composing in disguise (ADR 0557).
            var inbox = await ApiRoot.RequireAsync("inbox");
            var url = _inboxViewUserId is { } viewUser ? $"{inbox}?user={viewUser}"
                : _inboxIncludeGroups ? $"{inbox}?includeGroups=true"
                : inbox;
            var response = await Http.GetFromJsonAsync<InboxResponse>(url);
            _joinHref = Links.Href(response?.Links, "join");
            _patchCodeSheetHref = Links.Href(response?.Links, "patchCodeSheet");
            _inboxItems = (response?.Items ?? []).Select(i => new InboxItem(
                i.Name, i.Size, i.HasMask,
                Links.Href(i.Links, "download") ?? "", Links.Href(i.Links, "preview") ?? "",
                Links.Href(i.Links, "file") ?? "", Links.Href(i.Links, "self") ?? "",
                Links.Href(i.Links, "move") ?? "", Links.Href(i.Links, "mask") ?? "",
                // A null `pages` means the server offered no page operations for this row's format (ADR 0554).
                i.GroupId, i.GroupName, i.UserId, i.UserName, Links.Href(i.Links, "pages"), i.Signed)).ToList();
            _inboxStatus = _inboxItems.Count == 0 ? "Your inbox is empty. Upload files to file them into a repository." : $"{_inboxItems.Count} item(s).";
        }
        catch (Exception)
        {
            _inboxStatus = "Could not load the inbox.";
        }
        finally
        {
            _inboxBusy = false;
        }
    }

    private async Task OnInboxInputChangeAsync(InputFileChangeEventArgs e) => await OnInboxFilesSelectedAsync(e.GetMultipleFiles(100));

    // Uploads each selected file straight into the S3 inbox: POST /api/inbox for a presigned URL, then PUT the
    // bytes to it (cross-origin, unauthenticated — same direct-to-storage model as document upload).
    private async Task OnInboxFilesSelectedAsync(IReadOnlyList<IBrowserFile> files)
    {
        if (files.Count == 0)
        {
            return;
        }

        _inboxBusy = true;
        _inboxStatus = "Uploading…";
        StateHasChanged();
        try
        {
            foreach (var file in files)
            {
                var target = await (await Http.PostAsJsonAsync(await ApiRoot.RequireAsync("inbox"), new { fileName = file.Name })).Content.ReadFromJsonAsync<UploadInboxResponse>();
                if (target is null)
                {
                    continue;
                }

                using var buffer = new MemoryStream();
                await file.OpenReadStream(maxAllowedSize: 200L * 1024 * 1024).CopyToAsync(buffer);
                using var content = new ByteArrayContent(buffer.ToArray());
                if (!string.IsNullOrWhiteSpace(file.ContentType))
                {
                    content.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);
                }

                (await PresignedTransfer.Anonymous.PutAsync(target.UploadUrl, content)).EnsureSuccessStatusCode();
            }

            Snackbar.Add(string.Format(Strings.Get("StUploadedToInbox"), files.Count), Severity.Success);
        }
        catch (Exception)
        {
            Snackbar.Add(Strings.Get("StSomeUploadsFailed"), Severity.Error);
        }
        finally
        {
            _inboxBusy = false;
            await LoadInboxAsync();
        }
    }

    // ---- Inbox drop-zone upload (called from dropUpload.js, ADR "Inbox file-list drop-zone") --------------
    // The browser reads the dropped files and PUTs them straight to storage; .NET only mints the presigned URL
    // and refreshes, mirroring the document-upload drop path.
    [JSInvokable]
    public Task OnInboxUploadsStartingAsync(int count)
    {
        _inboxBusy = true;
        _inboxStatus = $"Uploading {count} file(s)…";
        StateHasChanged();
        return Task.CompletedTask;
    }

    [JSInvokable]
    public Task<string?> CreateInboxUploadTargetAsync(string fileName) => InboxUploads.CreateTargetAsync(fileName);

    [JSInvokable]
    public async Task OnInboxUploadsCompleteAsync(int count)
    {
        if (count > 0)
        {
            Snackbar.Add(string.Format(Strings.Get("StUploadedToInbox"), count), Severity.Success);
        }

        // Signal ingest BEFORE dropping the busy state and reloading: deskew and the patch-code cut run in
        // that call, so reloading first would show the un-straightened, un-split file and then change it
        // under the user — or, before this was wired at all, not until the sweep worker's five-minute poll.
        // The busy flag clears in finally: a failure here must not leave the spinner running forever, and it
        // must be SAID — a swallowed ingest failure means deskew/cut silently did not run.
        try
        {
            await InboxUploads.SignalProcessedAsync();
        }
        catch (Exception)
        {
            Snackbar.Add(Strings.Get("StErrInboxProcessing"), Severity.Warning);
        }
        finally
        {
            _inboxBusy = false;
        }

        await LoadInboxAsync();
        // A [JSInvokable] call doesn't auto-render (unlike a Blazor event handler): without this, the busy
        // spinner kept spinning INDEFINITELY after a successful upload — every request 200, the list even
        // refreshed, and the user staring at a stale render of it.
        StateHasChanged();
    }

    // ---- Inbox mask/index-data staging pane (ADRs 0279/0281/0285) ------------------------------------

    private bool _inboxIsEmail;
    private bool _inboxStgBusy;
    private string _inboxStgName = "";
    private DateTime? _inboxStgDate;
    private Guid? _inboxStgMaskId;
    private readonly List<EditField> _inboxStgFields = [];
    private List<MaskSummary> _inboxStgMasks = [];
    private Dictionary<Guid, List<string>> _inboxDraftValues = [];
    // Staged OCR languages for a scannable item (.tif/.tiff/.pdf) — consumed at filing (ADR "Inbox OCR-language staging").
    private List<string> _inboxStgOcrCodes = [];
    private bool _inboxStgScannable;

    private async Task SelectInboxItemAsync(InboxItem item)
    {
        _selectedInboxItem = item;
        _preview?.Clear();
        _inboxStgFields.Clear();
        _inboxStgMasks = [];
        _preview?.Clear();

        // Resolve the rendition-backed preview URL (the `preview` link is an endpoint returning JSON, ADR 0279,
        // not a direct file URL — so fetch it and use its previewUrl) plus its text-layout link, then render via
        // the shared pdf.js host with the hit-overlay. 204 = no preview available.
        try
        {
            using var r = await Http.GetAsync(item.PreviewHref);
            if (r.IsSuccessStatusCode && r.StatusCode != HttpStatusCode.NoContent)
            {
                var preview = await r.Content.ReadFromJsonAsync<InboxPreviewResponse>();

                var textLayoutUrl = Links.Href(preview?.Links, "text-layout");
                await ShowPreviewAsync(preview?.PreviewUrl, textLayoutUrl, preview?.PreviewConverted ?? false);
            }
        }
        catch (Exception)
        {
            // Non-fatal — no preview.
        }

        // Emails are classified automatically by the system on filing — not offered a mask here (ADR 0285).
        _inboxIsEmail = item.Name.EndsWith(".eml", StringComparison.OrdinalIgnoreCase) || item.Name.EndsWith(".msg", StringComparison.OrdinalIgnoreCase);
        if (_inboxIsEmail)
        {
            return;
        }

        try
        {
            _inboxStgMasks = (await Http.GetFromJsonAsync<MaskListResponse>(await ApiRoot.RequireAsync("masks")))?.Masks ?? [];
            var draft = await Http.GetFromJsonAsync<InboxMaskDraft>(item.MaskHref);
            _inboxStgName = string.IsNullOrEmpty(draft?.Name) ? System.IO.Path.GetFileNameWithoutExtension(item.Name) : draft.Name;
            _inboxStgDate = DateTime.TryParse(draft?.DocumentDate, out var d) ? d.Date : null;
            _inboxDraftValues = (draft?.Fields ?? []).ToDictionary(f => f.FieldDefinitionId, f => f.Values);

            // OCR languages: only offered for a scannable item, staged + consumed at filing (ADR "Inbox
            // OCR-language staging"). Load the catalog on demand.
            _inboxStgScannable = IsScannableExtension(item.Name);
            _inboxStgOcrCodes = draft?.OcrLanguages ?? [];
            if (_inboxStgScannable && _ocrCatalog.Count == 0)
            {
                _ocrCatalog = await OcrLanguages.GetAsync();
            }

            // Preselect the staged mask, or default to "Basic Entry" for an un-classified item (ADR 0284).
            _inboxStgMaskId = draft?.MaskId ?? _inboxStgMasks.FirstOrDefault(m => m.Name == "Basic Entry")?.Id;
            await LoadInboxStgFieldsAsync(_inboxStgMaskId, useDraftValues: true);
        }
        catch (HttpRequestException)
        {
            // Non-fatal — the pane just shows an empty form.
        }
    }

    private async Task LoadInboxStgFieldsAsync(Guid? maskId, bool useDraftValues)
    {
        _inboxStgFields.Clear();
        if (maskId is not { } id)
        {
            return;
        }

        // The picker's rows are the catalogue listing, and each row carries its own address (ADR 0555) — the
        // fields live behind the chosen row's `self`, not behind a path rebuilt from its id.
        if (Links.Href(_inboxStgMasks.FirstOrDefault(m => m.Id == id)?.Links, "self") is not { } maskHref)
        {
            return;
        }

        var fields = await Http.GetFromJsonAsync<MaskFieldsResponse>(maskHref);
        foreach (var f in fields?.Fields ?? [])
        {
            var values = useDraftValues && _inboxDraftValues.TryGetValue(f.Id, out var v) ? v : [];
            _inboxStgFields.Add(EditField.Create(f, values));
        }
    }

    private async Task OnInboxStgMaskChanged(Guid? maskId)
    {
        _inboxStgMaskId = maskId;
        await LoadInboxStgFieldsAsync(maskId, useDraftValues: false);
    }

    // Toggle a staged OCR language (ordered: click appends the next priority, click again removes + renumbers).
    private void ToggleInboxOcr(string code)
    {
        if (!_inboxStgOcrCodes.Remove(code))
        {
            _inboxStgOcrCodes.Add(code);
        }
    }

    // OCR-language staging only applies to the scannable types the searchable-PDF conversion runs on at filing.
    private static bool IsScannableExtension(string name) =>
        System.IO.Path.GetExtension(name).ToLowerInvariant() is ".tif" or ".tiff" or ".pdf";

    // Saves the staged Name/Document date/mask/index-data to the item's {name}.mask.json sidecar (ADR 0281).
    private async Task SaveInboxMaskAsync()
    {
        if (_selectedInboxItem is not { } item)
        {
            return;
        }

        _inboxStgBusy = true;
        try
        {
            var body = new
            {
                name = string.IsNullOrWhiteSpace(_inboxStgName) ? null : _inboxStgName.Trim(),
                documentDate = _inboxStgDate?.ToString("yyyy-MM-dd"),
                maskId = _inboxStgMaskId,
                fields = _inboxStgFields.Select(f => new { fieldDefinitionId = f.FieldDefinitionId, values = f.ToValues() }),
                ocrLanguages = _inboxStgScannable && _inboxStgOcrCodes.Count > 0 ? _inboxStgOcrCodes : null,
            };

            var resp = await Http.PutAsJsonAsync(item.MaskHref, body);
            if (resp.IsSuccessStatusCode)
            {
                Snackbar.Add(Strings.Get("StMaskSaved"), Severity.Success);
                var name = item.Name;
                await LoadInboxAsync();                 // refresh the square-bracket indicator
                var fresh = _inboxItems.FirstOrDefault(i => i.Name == name);
                if (fresh is not null)
                {
                    await SelectInboxItemAsync(fresh);
                }
            }
            else
            {
                Snackbar.Add(Strings.Get("StErrMaskSave"), Severity.Error);
            }
        }
        finally
        {
            _inboxStgBusy = false;
        }
    }

    private readonly HashSet<InboxItem> _inboxChecked = [];

    // The row the next Shift-click ranges from. Set by every click that establishes a position — a plain
    // single-select and a Ctrl-click both do; a Shift-click extends and leaves it where it was, so shifting
    // twice grows the same range instead of walking the anchor along behind the cursor.
    private InboxItem? _inboxAnchor;

    // Native multi-selection, the same shape the Repositories list uses (ADR "Bulk actions on selected
    // documents"): Ctrl/Cmd-click toggles a row into the checked set, Shift-click takes the range from the
    // anchor, and a plain click clears the set and single-selects. The checked set is what the page operations
    // and "file N items" already act on, so this is the pointer-device way to build it — the checkbox column
    // stays for touch, where there are no modifier keys.
    private async Task OnInboxRowClickAsync(InboxItem item, Microsoft.AspNetCore.Components.Web.MouseEventArgs e)
    {
        if (e.CtrlKey || e.MetaKey)
        {
            if (!_inboxChecked.Remove(item))
            {
                _inboxChecked.Add(item);
            }

            _inboxAnchor = item;
            await LoadPagesAsync();
            return;
        }

        if (e.ShiftKey && _inboxAnchor is { } anchor)
        {
            var a = _inboxItems.IndexOf(anchor);
            var b = _inboxItems.IndexOf(item);
            if (a >= 0 && b >= 0)
            {
                for (var i = Math.Min(a, b); i <= Math.Max(a, b); i++)
                {
                    _inboxChecked.Add(_inboxItems[i]);
                }

                await LoadPagesAsync();
                return;
            }
        }

        // A plain click makes this row the whole selection — it does not merely EMPTY the checked set. The page
        // operations (split, sort, straighten, cut) each need exactly one checked item, so a click that cleared
        // the set would take them off the toolbar on every pointer device: you would have to tick a hidden
        // checkbox to get them back. "Selected" and "checked" are one thing here; the checkbox column, where it
        // shows, is a second way to reach the same set.
        _inboxChecked.Clear();
        _inboxChecked.Add(item);
        _inboxAnchor = item;
        await SelectInboxItemAsync(item);
        await LoadPagesAsync();
    }

    // One button, one scope. The count is in the name whenever there is more than one thing to move, because
    // the label is hidden on a pointer device and the tooltip is then the only place it can say how many.
    private string FileCheckedLabel => _inboxChecked.Count > 1
        ? string.Format(Strings.Get("InboxFileN"), _inboxChecked.Count)
        : Strings.Get("InboxFileToFolder");

    // Exactly one checked item takes the single-item dialog (it names the file); more take the bulk one. Both
    // read the CHECKED set rather than _selectedInboxItem: after Ctrl-clicking a row back out, the detail pane
    // still shows whatever it last loaded, and filing what the pane shows rather than what is highlighted is
    // the mistake ADR 0559 is about.
    private Task FileCheckedAsync() => _inboxChecked.Count switch
    {
        0 => Task.CompletedTask,
        1 => FileInboxItemAsync(_inboxChecked.Single()),
        _ => FileMultipleAsync(),
    };

    private void ToggleInboxCheck(InboxItem item, bool on)
    {
        if (on) { _inboxChecked.Add(item); } else { _inboxChecked.Remove(item); }
        _inboxAnchor = item;
        _ = LoadPagesAsync();
    }

    // ---- Page operations (#487, ADR 0575) -------------------------------------------------------------
    // Every address here was advertised: the row's `pages` rel, and the split/sort rels that resource itself
    // returns. Nothing is composed (ADR 0543), and each resource is read once and followed many times (0557).

    private string? _joinHref;
    private PagesInfo? _pages;

    private sealed record PagesInfo(
        int PageCount,
        string? SplitHref,
        string? SortHref,
        string? DeskewHref,
        string? PatchCodesHref)
    {
        public bool CanSplit => SplitHref is not null;

        public bool CanSort => SortHref is not null;

        public bool CanDeskew => DeskewHref is not null;

        public bool CanCutAtPatchCodes => PatchCodesHref is not null;
    }

    private bool _deskewAutomatically = true;
    private bool _rotateAutomatically = true;

    private bool _cutAtPatchCodesAutomatically = true;

    // The printable separator sheet, captured from the inbox listing that advertised it (ADR 0557).
    private string? _patchCodeSheetHref;

    // Asked whenever the checked set changes, and CLEARED first: a rel that has not arrived means "not
    // available here, now", which during the request is exactly true — so the buttons never describe the
    // previously checked item while a newer one is loading (ADR 0559).
    private async Task LoadPagesAsync()
    {
        _pages = null;
        if (_inboxChecked.Count != 1 || _inboxChecked.Single().PagesHref is not { } pagesHref)
        {
            StateHasChanged();
            return;
        }

        try
        {
            var response = await Http.GetFromJsonAsync<InboxPagesResponse>(pagesHref);
            _pages = new PagesInfo(
                response?.PageCount ?? 0,
                Links.Href(response?.Links, "split"),
                Links.Href(response?.Links, "sort"),
                Links.Href(response?.Links, "deskew"),
                Links.Href(response?.Links, "patchCodes"));
        }
        catch (Exception)
        {
            _pages = null;
        }

        StateHasChanged();
    }

    private async Task SplitPagesAsync()
    {
        if (_pages is not { SplitHref: { } splitHref } pages || _inboxChecked.SingleOrDefault() is not { } item)
        {
            return;
        }

        // Splitting adds N items and keeps the source, so the count is worth stating BEFORE it happens: on a
        // 40-page scan the difference between "split" and "what have I done" is knowing it was 40.
        var confirmed = await DialogService.ShowMessageBoxAsync(new MessageBoxOptions
        {
            Title = Strings.Get("InboxSplit"),
            Message = string.Format(Strings.Get("InboxSplitConfirm"), item.Name, pages.PageCount),
            YesText = Strings.Get("InboxSplit"),
            CancelText = Strings.Get("Cancel"),
        });

        if (confirmed != true)
        {
            return;
        }

        await RunPageOperationAsync(async () =>
        {
            var response = await Http.PostAsJsonAsync(splitHref, new { });
            await ThrowIfRefusedAsync(response);
            var written = await response.Content.ReadFromJsonAsync<InboxPageItemsResponse>();
            _inboxStatus = string.Format(Strings.Get("StInboxSplit"), item.Name, written?.Names.Count ?? 0);
        });
    }

    private async Task SortPagesAsync()
    {
        if (_pages is not { SortHref: { } sortHref } pages || _inboxChecked.SingleOrDefault() is not { } item)
        {
            return;
        }

        // Thumbnails come from pdf.js, which this client already loads for the preview — the same trade the
        // desktop makes with PDFium. A failure here costs the pictures, not the dialog: it falls back to
        // numbered tiles rather than refusing to open.
        var images = new List<string>();
        try
        {
            var module = await JS.InvokeAsync<IJSObjectReference>("import", "./preview.js");
            await using (module)
            {
                images = (await module.InvokeAsync<string[]>("pageThumbnails", item.DownloadHref, 260)).ToList();
            }
        }
        catch (Exception)
        {
            images = [];
        }

        var parameters = new DialogParameters<Dialogs.SortPagesDialog>
        {
            { d => d.ItemName, item.Name },
            { d => d.PageImages, images },
            { d => d.PageCount, pages.PageCount },
        };

        var dialog = await DialogService.ShowAsync<Dialogs.SortPagesDialog>(Strings.Get("InboxSortTitle"), parameters);
        if (await dialog.Result is not { Canceled: false, Data: Dialogs.SortPagesDialog.Result arrangement })
        {
            return;
        }

        await RunPageOperationAsync(async () =>
        {
            // One request writes the whole arrangement — order and turns together (#522).
            object body = arrangement.Rotations.Count > 0
                ? new
                {
                    pageOrder = arrangement.Order,
                    rotations = arrangement.Rotations.Select(r => new { page = r.Key, degrees = r.Value }).ToList(),
                }
                : new { pageOrder = arrangement.Order };
            var response = await Http.PostAsJsonAsync(sortHref, body);
            await ThrowIfRefusedAsync(response);
            _inboxStatus = string.Format(Strings.Get("StInboxSorted"), item.Name);
        });
    }

    // Straighten THIS item, now. The format change is stated before it happens: a TIFF comes back a PDF,
    // because straightening re-renders the pages, and discovering that afterwards is how a user concludes the
    // archive is unreliable.
    private async Task DeskewAsync()
    {
        if (_pages is not { DeskewHref: { } deskewHref } || _inboxChecked.SingleOrDefault() is not { } item)
        {
            return;
        }

        var confirmed = await DialogService.ShowMessageBoxAsync(new MessageBoxOptions
        {
            Title = Strings.Get("InboxDeskewNow"),
            Message = string.Format(Strings.Get("InboxDeskewConfirm"), item.Name),
            YesText = Strings.Get("InboxDeskewNow"),
            CancelText = Strings.Get("Cancel"),
        });

        if (confirmed != true)
        {
            return;
        }

        await RunPageOperationAsync(async () =>
        {
            var response = await Http.PostAsJsonAsync(deskewHref, new { });
            await ThrowIfRefusedAsync(response);
            var written = await response.Content.ReadFromJsonAsync<InboxPageItemsResponse>();
            var name = written?.Names.FirstOrDefault() ?? string.Empty;
            _inboxStatus = string.Format(
                Strings.Get(name.Length > 0 ? "StInboxDeskewed" : "StInboxDeskewNothing"),
                name.Length > 0 ? name : item.Name);
        });
    }

    // Cut THIS batch at its separator sheets, now. What happens to the batch is stated before it happens: it
    // stays, under a name that says it can go — a user who expects it to vanish and finds it still there
    // concludes the cut did not work.
    private async Task CutAtPatchCodesAsync()
    {
        if (_pages is not { PatchCodesHref: { } patchCodesHref } || _inboxChecked.SingleOrDefault() is not { } item)
        {
            return;
        }

        var confirmed = await DialogService.ShowMessageBoxAsync(new MessageBoxOptions
        {
            Title = Strings.Get("InboxPatchCutNow"),
            Message = string.Format(Strings.Get("InboxPatchCutConfirm"), item.Name),
            YesText = Strings.Get("InboxPatchCutNow"),
            CancelText = Strings.Get("Cancel"),
        });

        if (confirmed != true)
        {
            return;
        }

        await RunPageOperationAsync(async () =>
        {
            var response = await Http.PostAsJsonAsync(patchCodesHref, new { });
            await ThrowIfRefusedAsync(response);
            var written = await response.Content.ReadFromJsonAsync<InboxPageItemsResponse>();
            _inboxStatus = string.Format(
                Strings.Get("StInboxCutAtPatchCodes"), item.Name, written?.Names.Count ?? 0);
        });
    }

    // Writes a toggle through, putting the button back if the server refuses — a control showing a state the
    // server does not hold is worse than one that failed visibly. Which rel and which field differ; the shape
    // does not, so the difference arrives as two lambdas rather than as a second copy.
    private Task SetDeskewAutomaticallyAsync(bool enabled) =>
        SetPreferenceAsync("deskewPreference", enabled, _deskewAutomatically, value => _deskewAutomatically = value);

    private Task SetRotateAutomaticallyAsync(bool enabled) =>
        SetPreferenceAsync("rotatePreference", enabled, _rotateAutomatically, value => _rotateAutomatically = value);

    private Task SetCutAtPatchCodesAutomaticallyAsync(bool enabled) =>
        SetPreferenceAsync("patchCodePreference", enabled, _cutAtPatchCodesAutomatically, value => _cutAtPatchCodesAutomatically = value);

    private async Task SetPreferenceAsync(string rel, bool enabled, bool previous, Action<bool> set)
    {
        set(enabled);
        try
        {
            var me = await Http.GetFromJsonAsync<MeResponse>(await ApiRoot.RequireAsync("me"));
            if (Links.Href(me?.Links, rel) is not { } href)
            {
                return;
            }

            (await Http.PutAsJsonAsync(href, new { enabled })).EnsureSuccessStatusCode();
        }
        catch (Exception)
        {
            set(previous);
            _inboxStatus = ApiErrorText.For(null);
        }
    }

    private record MeResponse
    {
        public bool DeskewInboxUploads { get; set; }

        public bool RotateInboxUploads { get; set; }

        public bool CutInboxUploadsAtPatchCodes { get; set; }

        public List<LinkResponse> Links { get; set; } = [];
    }

    private async Task JoinItemsAsync()
    {
        if (_joinHref is not { } joinHref || _inboxChecked.Count < 2)
        {
            return;
        }

        var names = _inboxChecked.Select(i => i.Name).ToList();
        var parameters = new DialogParameters<Dialogs.JoinItemsDialog> { { d => d.Names, names } };
        var dialog = await DialogService.ShowAsync<Dialogs.JoinItemsDialog>(Strings.Get("InboxJoinTitle"), parameters);
        if (await dialog.Result is not { Canceled: false, Data: Dialogs.JoinItemsDialog.Result result })
        {
            return;
        }

        await RunPageOperationAsync(async () =>
        {
            var response = await Http.PostAsJsonAsync(joinHref, new { names = result.Names, name = result.Name });
            await ThrowIfRefusedAsync(response);
            var written = await response.Content.ReadFromJsonAsync<InboxPageItemsResponse>();
            _inboxStatus = string.Format(Strings.Get("StInboxJoined"), result.Names.Count, written?.Names.FirstOrDefault() ?? "");
        });
    }

    // Every page operation ends the same way: the server's own words on refusal, and a reload either way — a
    // failed operation can still have followed one that succeeded, so the list must not be left describing a
    // state that no longer exists.
    private async Task RunPageOperationAsync(Func<Task> action)
    {
        _inboxBusy = true;
        try
        {
            await action();
        }
        catch (Exception e)
        {
            _inboxStatus = e.Message;
        }
        finally
        {
            _inboxBusy = false;
        }

        await LoadInboxAsync();
    }

    // The refusal's ERROR CODE, mapped to words this client owns — never the Problem Details `detail`, which is
    // English whatever the user's language, because the Api's exception classes carry their message as a
    // constructor literal (issue #424). The code is the stable, language-neutral contract (ADR 0543).
    private static async Task ThrowIfRefusedAsync(HttpResponseMessage response)
    {
        if (response.IsSuccessStatusCode)
        {
            return;
        }

        string? errorCode = null;
        try
        {
            errorCode = (await response.Content.ReadFromJsonAsync<ProblemResponse>())?.ErrorCode;
        }
        catch (Exception)
        {
            // No problem body at all (a proxy error page, a connection reset) — the generic text below covers it.
        }

        throw new InvalidOperationException(ApiErrorText.For(errorCode));
    }

    private record InboxPagesResponse { public string? Format { get; set; } public int PageCount { get; set; } public List<LinkResponse> Links { get; set; } = []; }

    private record InboxPageItemsResponse { public List<string> Names { get; set; } = []; }

    private record ProblemResponse { public string? ErrorCode { get; set; } }

    // Shows the context-aware filing dialog seeded with the Repositories tab's current selection (ADR 0286).
    private async Task<FilingDialog.FilingChoice?> ShowFilingDialogAsync(string title, bool bulk)
    {
        var parameters = new DialogParameters<FilingDialog>
        {
            { x => x.DocumentId, bulk ? null : CurrentDocumentId },
            { x => x.DocumentName, CurrentDocumentId is null ? null : CurrentDocumentName },
            { x => x.FolderId, CurrentFolderId },
            { x => x.FolderName, CurrentFolderName },
            { x => x.Bulk, bulk },
        };
        var dialog = await DialogService.ShowAsync<FilingDialog>(title, parameters);
        var result = await dialog.Result;
        return result is { Canceled: false, Data: FilingDialog.FilingChoice choice } ? choice : null;
    }

    // Posts one file request (as a new version, or into a folder), with the optional feed comment (ADR 0287).
    private async Task<bool> PostFileAsync(InboxItem item, FilingDialog.FilingChoice choice)
    {
        object body = choice.Mode == FilingDialog.FilingMode.AsVersion
            ? new { documentId = choice.TargetId, comment = choice.Comment }
            : new { folderId = choice.TargetId, comment = choice.Comment };

        var response = await Http.PostAsJsonAsync(item.FileHref, body);
        if (response.IsSuccessStatusCode)
        {
            return true;
        }

        Snackbar.Add(string.Format(
            Strings.Get(response.StatusCode == HttpStatusCode.Forbidden ? "StNoPermFileThere" : "StErrFileItem"),
            item.Name), Severity.Warning);
        return false;
    }

    private async Task FileInboxItemAsync(InboxItem item)
    {
        var choice = await ShowFilingDialogAsync($"File '{item.Name}'", bulk: false);
        if (choice is null)
        {
            return;
        }

        if (await PostFileAsync(item, choice))
        {
            Snackbar.Add(string.Format(
                Strings.Get(choice.Mode == FilingDialog.FilingMode.AsVersion ? "StFiledAsVersion" : "StFiledItem"),
                item.Name), Severity.Success);
            ClearInboxSelection(item);
            await LoadInboxAsync();
        }
    }

    // Bulk-file the checked items into one folder, each with the same optional comment (ADR 0288).
    private async Task FileMultipleAsync()
    {
        var items = _inboxItems.Where(_inboxChecked.Contains).ToList();
        if (items.Count == 0)
        {
            return;
        }

        var choice = await ShowFilingDialogAsync($"File {items.Count} items", bulk: true);
        if (choice is null)
        {
            return;
        }

        var filed = 0;
        foreach (var it in items)
        {
            if (await PostFileAsync(it, choice))
            {
                filed++;
            }
        }

        Snackbar.Add(string.Format(Strings.Get("StFiledOf"), filed, items.Count), Severity.Success);
        _inboxChecked.Clear();
        await LoadInboxAsync();
    }

    private async Task DownloadInboxItemAsync(InboxItem item) => await JS.InvokeVoidAsync("open", item.DownloadHref, "_blank");

    // Send an OWN item into another inbox (ADR 0532): pick a group or a user, then move it there.
    private async Task SendInboxItemAsync(InboxItem item)
    {
        var parameters = new DialogParameters<Dialogs.InboxSendDialog> { { x => x.ItemName, item.Name } };
        var dialog = await DialogService.ShowAsync<Dialogs.InboxSendDialog>(Strings.Get("InboxSendTitle"), parameters);
        if ((await dialog.Result) is { Canceled: false, Data: Dialogs.InboxSendDialog.SendTarget t })
        {
            await MoveInboxItemAsync(item, t.TargetGroupId, t.TargetUserId);
        }
    }

    // Move a NON-own item (a group's, or another user's for an admin) into my own inbox to work it privately.
    private async Task MoveToMyInboxAsync(InboxItem item)
    {
        if (MyUserId is { } me)
        {
            await MoveInboxItemAsync(item, null, me);
        }
    }

    private async Task MoveInboxItemAsync(InboxItem item, Guid? targetGroupId, Guid? targetUserId)
    {
        try
        {
            var response = await Http.PostAsJsonAsync(item.MoveHref, new { targetGroupId, targetUserId });
            if (!response.IsSuccessStatusCode)
            {
                Snackbar.Add(string.Format(Strings.Get("StErrMoveItemStatus"), (int)response.StatusCode), Severity.Error);
                return;
            }

            Snackbar.Add(string.Format(Strings.Get("StMoved"), item.Name), Severity.Success);
            ClearInboxSelection(item);
            await LoadInboxAsync();
        }
        catch (Exception)
        {
            Snackbar.Add(Strings.Get("StErrMoveItem"), Severity.Error);
        }
    }

    // The "show group inboxes" filter (ADR 0532) — off by default; clears any admin user-view when toggled.
    private async Task ToggleInboxGroupsAsync(bool on)
    {
        _inboxIncludeGroups = on;
        _inboxViewUserId = null;
        await LoadInboxAsync();
    }

    // The admin user-picker (CanManageInboxes) — open a chosen user's inbox, or back to my own (null).
    private async Task ViewUserInboxAsync(Guid? userId)
    {
        _inboxViewUserId = userId;
        if (userId is not null)
        {
            _inboxIncludeGroups = false;
        }

        await LoadInboxAsync();
    }

    private async Task DeleteInboxSelectionAsync()
    {
        var items = _inboxChecked.Count > 0 ? _inboxChecked.ToList()
            : _selectedInboxItem is { } one ? new List<InboxItem> { one } : [];
        if (items.Count <= 1)
        {
            if (items.Count == 1)
            {
                await DeleteInboxItemAsync(items[0]);
            }

            return;
        }

        var confirmed = await DialogService.ShowMessageBoxAsync(new MessageBoxOptions
        {
            Title = "Delete inbox items",
            Message = string.Format(Strings.Get("InboxDeleteManyConfirm"), items.Count),
            YesText = "Delete",
            CancelText = "Cancel",
        });
        if (confirmed != true)
        {
            return;
        }

        var deleted = 0;
        foreach (var item in items)
        {
            if ((await Http.DeleteAsync(item.DeleteHref)).IsSuccessStatusCode)
            {
                deleted++;
                ClearInboxSelection(item);
            }
        }

        Snackbar.Add(
            deleted == items.Count ? string.Format(Strings.Get("StDeletedItems"), deleted) : Strings.Get("StErrDeleteSelection"),
            deleted == items.Count ? Severity.Success : Severity.Warning);
        await LoadInboxAsync();
    }

    private async Task DeleteInboxItemAsync(InboxItem item)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(new MessageBoxOptions
        {
            Title = "Delete inbox item",
            Message = $"Delete '{item.Name}' from your inbox?",
            YesText = "Delete",
            CancelText = "Cancel",
        });
        if (confirmed != true)
        {
            return;
        }

        if ((await Http.DeleteAsync(item.DeleteHref)).IsSuccessStatusCode)
        {
            ClearInboxSelection(item);
            await LoadInboxAsync();
        }
        else
        {
            Snackbar.Add(string.Format(Strings.Get("StErrDeleteNamed"), item.Name), Severity.Error);
        }
    }

    private void ClearInboxSelection(InboxItem item)
    {
        if (_selectedInboxItem == item)
        {
            _selectedInboxItem = null;
            _preview?.Clear();
        }
    }

