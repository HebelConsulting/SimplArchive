@using System.Net
@inject HttpClient Http
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject SimplArchive.Client.Services.ApiRoot ApiRoot

@* The Recycle bin tab of the workbench (ADR "Recycle bin tab"), extracted from Home.razor per ADR 0558.

   The tenant-wide list of deleted documents, with an isolated detail pane — mask, index data, chat and a
   read-only preview — plus per-row and bulk restore/purge.

   Every address it uses is one the server advertised: the row carries restore/purge and the four detail reads
   (#450 added them), and the listing envelope carries the three bulk actions. Nothing here is composed from an
   id, which is what the burn-down in #416 is for. *@

<div class="wb-recyclebin" style="height:100%; display:flex; min-height:0;">
    @* Left: the list of deleted items. *@
    <div style="flex:1.5 1 0; min-width:0; display:flex; flex-direction:column; border-right:1px solid var(--mud-palette-lines-default);">
        @* The toolbar in the Repositories shape (#530 tranche 1): restore first (selection-scoped, the
           counted label rides in the tooltip), the DESTRUCTIVE pair icon-only in its own group SEPARATED from
           it — destructive never sits beside the button that commits work — and refresh last. Admin-only
           actions are HIDDEN, not greyed (a right the caller does not hold is not advertised, ADR 0543);
           merely-nothing-selected only disables. The buttons stay flat: no toggles here, but the one-shape
           rule (ADR 0576/0581) is why the filled/outlined accents went. *@
        <div class="wb-search-bar pa-2" style="border-bottom:1px solid var(--mud-palette-lines-default);">
            <MudButton Class="wb-rib-btn" Size="Size.Small" Disabled="@(_rbChecked.Count == 0)" OnClick="RestoreSelectedAsync"
                       title="@string.Format(Strings.Get("RbRestoreSelected"), _rbChecked.Count)"
                       aria-label="@string.Format(Strings.Get("RbRestoreSelected"), _rbChecked.Count)">
                <MudIcon Icon="@Icons.Material.Filled.RestoreFromTrash" Size="Size.Small" /><span class="wb-rib-label">@string.Format(Strings.Get("RbRestoreSelected"), _rbChecked.Count)</span>
            </MudButton>
            @if (IsTenantAdmin)
            {
                <MudButton Class="wb-rib-btn ml-3" Size="Size.Small" Disabled="@(_rbChecked.Count == 0)" OnClick="PurgeSelectedAsync"
                           title="@string.Format(Strings.Get("RbPurgeSelected"), _rbChecked.Count)"
                           aria-label="@string.Format(Strings.Get("RbPurgeSelected"), _rbChecked.Count)">
                    <MudIcon Icon="@Icons.Material.Filled.DeleteForever" Size="Size.Small" /><span class="wb-rib-label">@string.Format(Strings.Get("RbPurgeSelected"), _rbChecked.Count)</span>
                </MudButton>
                <MudButton Class="wb-rib-btn ml-1" Size="Size.Small" Disabled="@(_recycleBinItems.Count == 0)" OnClick="HardDeleteAllAsync"
                           title="@Strings.Get("RbHardDeleteAll")" aria-label="@Strings.Get("RbHardDeleteAll")">
                    <MudIcon Icon="@Icons.Material.Filled.DeleteSweep" Size="Size.Small" /><span class="wb-rib-label">@Strings.Get("RbHardDeleteAll")</span>
                </MudButton>
            }
            <MudButton Class="wb-rib-btn ml-3" Size="Size.Small" OnClick="LoadRecycleBinAsync"
                       title="@Strings.Get("RibbonRefresh")" aria-label="@Strings.Get("RibbonRefresh")">
                <MudIcon Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" /><span class="wb-rib-label">@Strings.Get("RibbonRefresh")</span>
            </MudButton>
        </div>
        <div style="flex:1 1 auto; overflow:auto;">
            <MudTable Items="_recycleBinItems" Dense="true" Hover="true" Bordered="false" Elevation="0" T="RecycleBinItem" OnRowClick="@((TableRowClickEventArgs<RecycleBinItem> e) => e.Item is { } item ? OnRowClickAsync(item, e.MouseEventArgs) : Task.CompletedTask)">
                <HeaderContent>
                    @* The checkbox column is the TOUCH affordance only (#530): a hover-capable pointer device
                       multi-selects natively — Ctrl/Cmd-click toggles, Shift-click ranges — the Intray recipe.
                       No select-all: touch keeps per-row boxes, pointer gets Ctrl-click. *@
                    <MudTh Style="width:1px;" Class="wb-touch-only"></MudTh>
                    <MudTh>@Strings.Get("Name")</MudTh><MudTh>@Strings.Get("RbColPath")</MudTh><MudTh>@Strings.Get("RbColDeleted")</MudTh><MudTh>@Strings.Get("RbColDeletedBy")</MudTh><MudTh Style="width:1px;"></MudTh>
                </HeaderContent>
                <RowTemplate Context="row">
                    <MudTd Class="wb-touch-only" @onclick:stopPropagation="true"><MudCheckBox T="bool" Value="@_rbChecked.Contains(row.Id)" ValueChanged="@(v => ToggleRbChecked(row.Id, v))" Dense="true" /></MudTd>
                    <MudTd Class="@(_rbChecked.Contains(row.Id) ? "wb-list-row-selected" : "")">@row.Name</MudTd>
                    <MudTd Class="mud-text-secondary">@row.Path</MudTd>
                    <MudTd>@row.DeletedAt.ToLocalTime().ToString("g")</MudTd>
                    <MudTd>@row.DeletedBy</MudTd>
                    @* What you can do to THIS row lives in its ⋮ menu — the same actions the toolbar offers for
                       the selection, differing only in scope (#521's split). Hard delete stays admin-HIDDEN. *@
                    <MudTd Style="text-align:right; white-space:nowrap;" @onclick:stopPropagation="true">
                        <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true" AnchorOrigin="Origin.BottomLeft">
                            <MudMenuItem Icon="@Icons.Material.Filled.RestoreFromTrash" OnClick="() => RestoreRecycleBinItemAsync(row)">@Strings.Get("RbRestore")</MudMenuItem>
                            @if (IsTenantAdmin)
                            {
                                @* Destructive keeps its distance in a menu too — the divider the desktop's
                                   context menu had from day one (tranche-1 parity slip, caught in review). *@
                                <MudDivider />
                                <MudMenuItem Icon="@Icons.Material.Filled.DeleteForever" OnClick="() => HardDeleteRecycleBinItemAsync(row)">@Strings.Get("RbHardDelete")</MudMenuItem>
                            }
                        </MudMenu>
                    </MudTd>
                </RowTemplate>
            </MudTable>
            @if (_recycleBinItems.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="pa-3 mud-text-secondary">@Strings.Get("RbEmpty")</MudText>
            }
        </div>
    </div>
    @* Right: read-only details + isolated preview + chat (mirrors the Repositories detail pane). *@
    <div style="flex:1 1 0; min-width:0; display:flex; flex-direction:column;">
        @if (_rbSelected is null)
        {
            <MudText Typo="Typo.body2" Class="pa-3 mud-text-secondary">@Strings.Get("RbSelectItem")</MudText>
        }
        else
        {
            <div style="padding:8px 12px; border-bottom:1px solid var(--mud-palette-lines-default); max-height:34%; overflow:auto;">
                <MudText Typo="Typo.subtitle1">@_rbSelected.Name</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">@string.Format(Strings.Get("RbDeletedByLine"), _rbSelected.DeletedAt.ToLocalTime().ToString("g"), _rbSelected.DeletedBy)</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-1">@string.Format(Strings.Get("RbMaskLine"), _rbMaskName ?? Strings.Get("RbMaskNone"))</MudText>
                @if (_rbIndexData is { Count: > 0 })
                {
                    <MudSimpleTable Dense="true" Bordered="false" Class="mt-1"><tbody>
                        @foreach (var f in _rbIndexData)
                        {
                            <tr><td>@f.FieldName</td><td>@string.Join(", ", f.Values)</td></tr>
                        }
                    </tbody></MudSimpleTable>
                }
            </div>
            <div style="flex:1 1 auto; display:flex; min-height:0;">
                @* The recycle bin previews a DELETED document: nothing to annotate, and no
                   toolbar — it is a glance at what is about to be restored or purged. It used
                   to carry its own duplicate host purely to escape the shared one (ADR 0558). *@
                <PreviewPane @ref="_preview" ShowToolbar="false"
                             Style="flex:1.6 1 0; min-width:0; display:flex; flex-direction:column; position:relative;"
                             EmptyText="@Strings.Get("NoPreview")"
                             ConvertedBadgeTooltip="@Strings.Get("RbConvertedPreview")" />
                <div style="flex:1 1 0; min-width:0; overflow:auto; border-left:1px solid var(--mud-palette-lines-default); padding:8px;">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-1">@Strings.Get("RbCommentsHeader")</MudText>
                    @foreach (var c in _rbComments)
                    {
                        <div class="mb-2">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@c.AuthorName · @c.CreatedAt.ToLocalTime().ToString("g")</MudText>
                            <MudText Typo="Typo.body2">@c.Body</MudText>
                        </div>
                    }
                    @if (_rbComments.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">@Strings.Get("RbNoComments")</MudText>
                    }
                </div>
            </div>
        }
    </div>
</div>

@code {

    /// <summary>A tenant admin may empty the bin; everyone else sees only what they can act on.</summary>
    [Parameter]
    public bool IsTenantAdmin { get; set; }

    private PreviewPane? _preview;

    // The collection's bulk actions, captured when the listing is read (ADR 0557). Null means the server did
    // not offer it, so the button stays hidden rather than failing on use.
    private string? _restoreSelectedHref;
    private string? _purgeSelectedHref;
    private string? _purgeAllHref;

    // A preview requested before the pane existed — the pane lives inside "is a row selected?", so the first
    // selection is what creates it (ADR 0558).
    private (string? Url, string? Layout, bool Converted)? _pendingPreview;

    protected override async Task OnInitializedAsync() => await LoadRecycleBinAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pendingPreview is { } pending && _preview is not null)
        {
            _pendingPreview = null;
            await ShowPreviewAsync(pending.Url, pending.Layout, pending.Converted);
            StateHasChanged();
        }
    }

    private async Task ShowPreviewAsync(string? url, string? layout, bool converted)
    {
        if (_preview is null)
        {
            _pendingPreview = (url, layout, converted);
            return;
        }

        await _preview.RenderAsync(url, layout, converted);
    }

    private readonly List<RecycleBinItem> _recycleBinItems = new();
    // Multi-select for bulk restore (ADR "Bulk restore from the recycle bin").
    private readonly HashSet<Guid> _rbChecked = new();
    private RecycleBinItem? _rbSelected;
    private string? _rbMaskName;
    private List<FieldGroup>? _rbIndexData;
    private List<ChatMessageResponse> _rbComments = new();

    private async Task LoadRecycleBinAsync()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<RecycleBinResponse>(await ApiRoot.RequireAsync("recycleBin"));
            // The bulk actions belong to the COLLECTION, so they are captured here rather than rebuilt at
            // each button (ADR 0557).
            _restoreSelectedHref = response?.Href("restore-selected");
            _purgeSelectedHref = response?.Href("purge-selected");
            _purgeAllHref = response?.Href("purge-all");
            _recycleBinItems.Clear();
            if (response?.Items is { } items)
            {
                _recycleBinItems.AddRange(items);
            }
            // Drop the selection if the selected item is gone.
            if (_rbSelected is { } sel && _recycleBinItems.All(i => i.Id != sel.Id))
            {
                _rbSelected = null;
                ClearRbPreview();
            }
            // Prune checked ids that are no longer present (restored/purged).
            _rbChecked.RemoveWhere(id => _recycleBinItems.All(i => i.Id != id));
        }
        catch (Exception)
        {
            Snackbar.Add(Strings.Get("StErrLoadRecycleBin"), Severity.Error);
        }
        StateHasChanged();
    }

    private async Task SelectRecycleBinItemAsync(RecycleBinItem item)
    {
        _rbSelected = item;
        _rbMaskName = null;
        _rbIndexData = null;
        _rbComments = new();
        ClearRbPreview();
        StateHasChanged();

        try
        {
            _rbMaskName = item.Href("mask") is { } maskHref ? (await Http.GetFromJsonAsync<MaskResponse>(maskHref))?.Name : null;
            _rbIndexData = item.Href("index-data") is { } indexHref ? (await Http.GetFromJsonAsync<IndexDataResponse>(indexHref))?.Fields ?? [] : [];
            _rbComments = item.Href("chat") is { } chatHref ? (await Http.GetFromJsonAsync<ChatMessageListResponse>(chatHref))?.Messages ?? new() : new();

            var versions = item.Href("versions") is { } versionsHref ? await Http.GetFromJsonAsync<VersionListResponse>(versionsHref) : null;
            var latest = VersionListResponse.PickCurrent(versions?.Versions?.Where(v => v.Status == "Confirmed").ToList() ?? [], versions?.CurrentVersionId);
            var previewUrl = latest is null ? null : Http.Absolute(Links.Href(latest.Links, "preview"));
            var textLayoutUrl = latest is null ? null : Links.Href(latest.Links, "text-layout");
            await ShowPreviewAsync(previewUrl, textLayoutUrl, latest?.PreviewConverted ?? false);
        }
        catch (Exception)
        {
            // best-effort — a partial detail is fine
        }
        StateHasChanged();
    }

    // The recycle bin now renders through its own PreviewPane instance like every other tab, so there is no
    // hand-rolled second host to keep in step (ADR 0558).
    private void ClearRbPreview() => _preview?.Clear();

    private async Task RestoreRecycleBinItemAsync(RecycleBinItem item)
    {
        if (item.Href("restore") is not { } restoreHref) { return; }

        var response = await Http.PostAsync(restoreHref, null);
        if (response.IsSuccessStatusCode)
        {
            Snackbar.Add(string.Format(Strings.Get("StRestored"), item.Name), Severity.Success);
            if (_rbSelected?.Id == item.Id) { _rbSelected = null; ClearRbPreview(); }
            await LoadRecycleBinAsync();
        }
        else
        {
            Snackbar.Add(Strings.Get("StErrRestoreItem"), Severity.Warning);
        }
    }

    // ---- Bulk restore (ADR "Bulk restore from the recycle bin") ----
    // Native multi-selection over the checked set — the Intray recipe (#530): Ctrl/Cmd-click toggles,
    // Shift-click ranges from the anchor, a plain click makes the clicked row the whole set AND the detail
    // subject. "Selected" and "checked" are one thing; the touch-only checkbox column is a second way in.
    private Guid? _rbAnchor;

    private async Task OnRowClickAsync(RecycleBinItem item, Microsoft.AspNetCore.Components.Web.MouseEventArgs e)
    {
        if (e.CtrlKey || e.MetaKey)
        {
            if (!_rbChecked.Remove(item.Id))
            {
                _rbChecked.Add(item.Id);
            }

            _rbAnchor = item.Id;
            return;
        }

        if (e.ShiftKey && _rbAnchor is { } anchor)
        {
            var order = _recycleBinItems.Select(x => x.Id).ToList();
            var a = order.IndexOf(anchor);
            var b = order.IndexOf(item.Id);
            if (a >= 0 && b >= 0)
            {
                for (var i = Math.Min(a, b); i <= Math.Max(a, b); i++)
                {
                    _rbChecked.Add(order[i]);
                }

                return;
            }
        }

        _rbChecked.Clear();
        _rbChecked.Add(item.Id);
        _rbAnchor = item.Id;
        await SelectRecycleBinItemAsync(item);
    }

    private void ToggleRbChecked(Guid id, bool value)
    {
        if (value) _rbChecked.Add(id); else _rbChecked.Remove(id);
    }



    private async Task RestoreSelectedAsync()
    {
        var ids = _rbChecked.ToList();
        if (_restoreSelectedHref is not { } href) { return; }

        var response = await Http.PostAsJsonAsync(href, new { ids });
        if (response.IsSuccessStatusCode)
        {
            var result = await response.Content.ReadFromJsonAsync<RestoreManyResult>();
            var restored = result?.Restored ?? 0;
            var skipped = result?.Skipped ?? 0;
            Snackbar.Add(skipped > 0 ? string.Format(Strings.Get("StRestoredSkipped"), restored, skipped) : string.Format(Strings.Get("StRestoredItems"), restored), Severity.Success);
            _rbChecked.Clear();
            if (_rbSelected is { } sel && ids.Contains(sel.Id)) { _rbSelected = null; ClearRbPreview(); }
            await LoadRecycleBinAsync();
        }
        else
        {
            Snackbar.Add(Strings.Get("StErrRestoreSelected"), Severity.Warning);
        }
    }

    private record RestoreManyResult { public int Restored { get; set; } public int Skipped { get; set; } }

    // Per-row permanent purge — no extra confirmation (per spec).
    private async Task HardDeleteRecycleBinItemAsync(RecycleBinItem item)
    {
        if (item.Href("purge") is not { } purgeHref) { return; }

        var response = await Http.PostAsync(purgeHref, null);
        if (response.IsSuccessStatusCode)
        {
            Snackbar.Add(string.Format(Strings.Get("StPermanentlyDeleted"), item.Name), Severity.Success);
            if (_rbSelected?.Id == item.Id) { _rbSelected = null; ClearRbPreview(); }
            await LoadRecycleBinAsync();
        }
        else if (response.StatusCode == HttpStatusCode.Conflict)
        {
            Snackbar.Add(Strings.Get("StErrHardDeleteHold"), Severity.Warning);
        }
        else
        {
            Snackbar.Add(Strings.Get("StErrHardDelete"), Severity.Error);
        }
    }

    // Bulk purge of the checked items (ADR "Bulk purge of selected recycle-bin items") — the same "I AGREE" gate
    // as Hard-delete all; protected (legal-hold / WORM) items are skipped server-side and reported.
    private async Task PurgeSelectedAsync()
    {
        var result = await (await DialogService.ShowAsync<HardDeleteAllDialog>(Strings.Get("RbHardDeleteSelected"))).Result;
        if (result is not { Canceled: false })
        {
            return;
        }

        var ids = _rbChecked.ToList();
        if (_purgeSelectedHref is not { } href) { return; }

        var response = await Http.PostAsJsonAsync(href, new { ids });
        if (response.IsSuccessStatusCode)
        {
            var r = await response.Content.ReadFromJsonAsync<PurgeManyResult>();
            var purged = r?.Purged ?? 0;
            var skipped = r?.Skipped ?? 0;
            Snackbar.Add(skipped > 0 ? string.Format(Strings.Get("StPurgedSkipped"), purged, skipped) : string.Format(Strings.Get("StPurgedItems"), purged), Severity.Success);
            _rbChecked.Clear();
            if (_rbSelected is { } sel && ids.Contains(sel.Id)) { _rbSelected = null; ClearRbPreview(); }
            await LoadRecycleBinAsync();
        }
        else
        {
            Snackbar.Add(Strings.Get("StErrPurgeSelected"), Severity.Error);
        }
    }

    private record PurgeManyResult { public int Purged { get; set; } public int Skipped { get; set; } }

    private async Task HardDeleteAllAsync()
    {
        var result = await (await DialogService.ShowAsync<HardDeleteAllDialog>(Strings.Get("RbHardDeleteAll"))).Result;
        if (result is not { Canceled: false })
        {
            return;
        }

        if (_purgeAllHref is not { } href) { return; }

        var response = await Http.PostAsync(href, null);
        if (response.IsSuccessStatusCode)
        {
            Snackbar.Add(Strings.Get("StRecycleBinEmptied"), Severity.Success);
            _rbSelected = null;
            ClearRbPreview();
            await LoadRecycleBinAsync();
        }
        else
        {
            Snackbar.Add(Strings.Get("StErrEmptyRecycleBin"), Severity.Error);
        }
    }

        public string Name { get; set; } = "";
        public string Path { get; set; } = "";
        public DateTimeOffset DeletedAt { get; set; }
        public string DeletedBy { get; set; } = "";
    }


}
