@* The Tasks tab (ADR "Workflow task inbox"), extracted from Home.razor per ADR 0558.

   The workflow reviews assigned to me. Deliberately thin: the task LIST stays in the shell because three
   surfaces read it — this tab, the My work dashboard, and the tab-bar badge count — so re-fetching it here
   would be a request spent learning something already in memory (ADR 0557). Opening one navigates the
   Repositories tab, which only the shell can do. *@

<div class="wb-tasks" style="height:100%; display:flex; flex-direction:column;">
    @* The toolbar in the Repositories shape (#530 tranche 3). Restructure only, by decision: approve/reject
       stay in the workflow detail a task opens into — approving from a list row without seeing the document
       invites rubber-stamping. So: Open acting on THE selected row, greyed when there is none, and refresh. *@
    <div class="wb-search-bar pa-2" style="border-bottom:1px solid var(--mud-palette-lines-default);">
        <MudButton Class="wb-rib-btn" Size="Size.Small" Disabled="@(_selected is null)"
                   OnClick="@(() => OpenRequested.InvokeAsync(_selected!))"
                   title="@Strings.Get("RibbonOpen")" aria-label="@Strings.Get("RibbonOpen")">
            <MudIcon Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" /><span class="wb-rib-label">@Strings.Get("RibbonOpen")</span>
        </MudButton>
        <MudButton Class="wb-rib-btn ml-3" Size="Size.Small" OnClick="@(() => Refresh.InvokeAsync())"
                   title="@Strings.Get("RibbonRefresh")" aria-label="@Strings.Get("RibbonRefresh")">
            <MudIcon Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" /><span class="wb-rib-label">@Strings.Get("RibbonRefresh")</span>
        </MudButton>
    </div>
    <div style="flex:1 1 auto; overflow:auto;">
        @if (Tasks.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="pa-3 mud-text-secondary">@Strings.Get("TasksEmpty")</MudText>
        }
        else
        {
            <MudTable Items="FilteredTasks" Dense="true" Hover="true" Bordered="false" Elevation="0" T="TaskItem"
                      Style="max-width:860px;"
                      OnRowClick="@((TableRowClickEventArgs<TaskItem> e) => _selected = e.Item)"
                      RowClassFunc="@((row, _) => row == _selected ? "wb-list-row-selected" : "")">
                <HeaderContent>
                    @* Sortable data columns (#550); Status stays plain — a task IS a review, the chip is
                       invariant. Default sort is due-first (overdue on top, no-due-date last): what a task
                       list is for. *@
                    <MudTh><MudTableSortLabel T="TaskItem" SortBy="@(t => t.DocumentName)">@Strings.Get("ColDocument")</MudTableSortLabel></MudTh>
                    <MudTh>@Strings.Get("WorkflowStatus")</MudTh>
                    <MudTh><MudTableSortLabel T="TaskItem" SortBy="@(t => t.VersionNumber ?? int.MinValue)">@Strings.Get("VerColVersion")</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel T="TaskItem" SortBy="@(t => t.AssignedAt)">@Strings.Get("ColAssigned")</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel T="TaskItem" InitialDirection="SortDirection.Ascending" SortBy="@(t => t.DueAt ?? DateTimeOffset.MaxValue)">@Strings.Get("ColDue")</MudTableSortLabel></MudTh>
                    <MudTh Style="width:1px;"></MudTh>
                    @* The filter row is VISIBLE, not behind a menu (ADR 0550/#550). *@
                    <MudTHeadRow Class="wb-task-filters">
                        <MudTh><MudTextField T="string" @bind-Value="_filterDocument" Immediate="true" Placeholder="@Strings.Get("FilterHint")" Margin="Margin.Dense" Variant="Variant.Outlined" /></MudTh>
                        <MudTh></MudTh>
                        <MudTh><MudTextField T="string" @bind-Value="_filterVersion" Immediate="true" Placeholder="@Strings.Get("FilterHint")" Margin="Margin.Dense" Variant="Variant.Outlined" /></MudTh>
                        <MudTh></MudTh>
                        <MudTh><MudCheckBox T="bool" @bind-Value="_filterOverdueOnly" Dense="true" Size="Size.Small" Label="@Strings.Get("OverdueOnly")" /></MudTh>
                        <MudTh></MudTh>
                    </MudTHeadRow>
                </HeaderContent>
                <RowTemplate Context="row">
                    <MudTd>@row.DocumentName</MudTd>
                    @* Constant by construction — the tasks API lists exactly the reviews assigned to you
                       (Status == InReview) — but SAID, because "which state is this in?" was not obvious
                       (review finding). If the tab ever lists more than reviews, this becomes per-row data. *@
                    <MudTd><MudChip T="string" Size="Size.Small" Color="Color.Warning">@Strings.Get("WfStateInReview")</MudChip></MudTd>
                    <MudTd>@(row.VersionNumber is { } n ? $"v{n}" : "—")</MudTd>
                    <MudTd>@row.AssignedAt.LocalDateTime.ToString("yyyy-MM-dd HH:mm")</MudTd>
                    <MudTd>
                        @if (row.DueAt is { } due)
                        {
                            @if (row.IsOverdue)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Error" Icon="@Icons.Material.Filled.Warning">@string.Format(Strings.Get("WorkflowOverdue"), due.LocalDateTime.ToString("yyyy-MM-dd"))</MudChip>
                            }
                            else
                            {
                                <span>@due.LocalDateTime.ToString("yyyy-MM-dd")</span>
                            }
                        }
                        else
                        {
                            <span class="mud-text-secondary">—</span>
                        }
                    </MudTd>
                    @* What can be done to THIS row lives in its ⋮ menu — the toolbar's twin acts on the
                       selection (#521's split). *@
                    <MudTd Style="text-align:right;" @onclick:stopPropagation="true">
                        <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true" AnchorOrigin="Origin.BottomLeft">
                            <MudMenuItem Icon="@Icons.Material.Filled.OpenInNew" OnClick="() => OpenRequested.InvokeAsync(row)">@Strings.Get("RibbonOpen")</MudMenuItem>
                        </MudMenu>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    </div>
</div>

@code {
    // The visible filter row's state (#550): client-side over the loaded page, like the sort — the tasks
    // API's cursor order is untouched.
    private string _filterDocument = string.Empty;
    private string _filterVersion = string.Empty;
    private bool _filterOverdueOnly;

    private IEnumerable<TaskItem> FilteredTasks => Tasks.Where(t =>
        (string.IsNullOrWhiteSpace(_filterDocument) || t.DocumentName.Contains(_filterDocument.Trim(), StringComparison.CurrentCultureIgnoreCase))
        && (string.IsNullOrWhiteSpace(_filterVersion) || (t.VersionNumber is { } n ? $"v{n}" : "—").Contains(_filterVersion.Trim(), StringComparison.CurrentCultureIgnoreCase))
        && (!_filterOverdueOnly || t.IsOverdue));

    /// <summary>The caller's open review tasks, owned by the shell and read by three surfaces.</summary>
    [Parameter]
    public List<TaskItem> Tasks { get; set; } = [];

    /// <summary>Ask the shell to re-read the list (it owns it, and the badge count follows).</summary>
    [Parameter]
    public EventCallback Refresh { get; set; }

    /// <summary>Open the task's document — a switch to the Repositories tab, so the shell performs it.</summary>
    [Parameter]
    public EventCallback<TaskItem> OpenRequested { get; set; }

    /// <summary>The row the toolbar acts on (#530 tranche 3) — single-select by decision.</summary>
    private TaskItem? _selected;
}
