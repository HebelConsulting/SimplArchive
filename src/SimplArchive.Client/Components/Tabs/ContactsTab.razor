@using SimplArchive.Client.Services
@inject DavCollections DavCollections
@inject BrowseService Browse
@inject StructuredEditors StructuredEditors
@inject IDialogService DialogService
@inject ISnackbar Snackbar

@* The Contacts tab of the workbench (#564) — the web twin of the desktop tab, which is the reference
   (ADR 0511): addressbooks │ contacts │ detail, with the collections picked from a flat checkbox list because
   several OVERLAY. Nothing here composes an API URL; every address comes from the listing that carried it. *@

<div class="wb-contacts" style="height:100%; display:flex; flex-direction:column; flex:1 1 auto; min-height:0;">
    <div class="wb-search-bar pa-2" style="border-bottom:1px solid var(--mud-palette-lines-default);">
        <MudButton Class="wb-rib-btn" Size="Size.Small" OnClick="LoadAsync"
                   title="@Strings.Get("RibbonRefresh")" aria-label="@Strings.Get("RibbonRefresh")">
            <MudIcon Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" /><span class="wb-rib-label">@Strings.Get("RibbonRefresh")</span>
        </MudButton>
        @* Disabled until a ticked addressbook ADVERTISES the create (#631) — the server's answer rather than
           the client's guess at it, so the affordance never lies about what it can do. *@
        <MudButton Class="wb-rib-btn ml-3" Size="Size.Small" Disabled="@(!CanCreate)" OnClick="NewContactAsync"
                   title="@Strings.Get("ContactsNew")" aria-label="@Strings.Get("ContactsNew")">
            <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Size="Size.Small" /><span class="wb-rib-label">@Strings.Get("ContactsNew")</span>
        </MudButton>
        @* Edit opens the same structured editor. Enabled only with a row selected; whether the card is really
           editable is the server's answer, told by the document's contact-card rel (ADR 0543). *@
        <MudButton Class="wb-rib-btn" Size="Size.Small" Disabled="@(_selected is null)" OnClick="EditContactAsync"
                   title="@Strings.Get("ContactsEdit")" aria-label="@Strings.Get("ContactsEdit")">
            <MudIcon Icon="@Icons.Material.Filled.Edit" Size="Size.Small" /><span class="wb-rib-label">@Strings.Get("ContactsEdit")</span>
        </MudButton>
    </div>

    <div style="flex:1 1 auto; min-height:0; display:flex;">
        <div style="flex:0 0 220px; border-right:1px solid var(--mud-palette-lines-default); min-width:0;">
            <DavCollectionPicker Collections="_collections" Checked="_checked"
                                 Heading="@Strings.Get("ContactsCollections")"
                                 EmptyText="@Strings.Get("ContactsNoneSelected")"
                                 ChangedAsync="ReloadContactsAsync" />
        </div>

        <div style="flex:1 1 auto; min-width:0; display:flex; flex-direction:column;">
            <div class="pa-2" style="border-bottom:1px solid var(--mud-palette-lines-default);">
                <SearchField @bind-Value="_filter" Placeholder="@Strings.Get("FilterHint")" />
            </div>
            <div style="flex:1 1 auto; overflow:auto;">
                @if (_contacts.Count == 0)
                {
                    @* Two different empty states, deliberately: telling someone to tick an addressbook when
                       they already have one ticked instructs them to do what they just did, and reads as the
                       tab being broken. *@
                    <MudText Typo="Typo.body2" Class="mud-text-secondary pa-3">
                        @(_checked.Count == 0 ? Strings.Get("ContactsNoneSelected") : Strings.Get("ContactsEmpty"))
                    </MudText>
                }
                else
                {
                    <MudTable Items="Visible" Dense="true" Hover="true" Bordered="false" Elevation="0" T="ContactRow"
                              OnRowClick="@((TableRowClickEventArgs<ContactRow> e) => _selected = e.Item)"
                              RowClassFunc="@((row, _) => row == _selected ? "wb-list-row-selected" : "")">
                        <HeaderContent>
                            <MudTh Style="width:1px;"></MudTh>
                            <MudTh>@Strings.Get("Name")</MudTh>
                            <MudTh>@Strings.Get("ContactsOrg")</MudTh>
                            <MudTh>@Strings.Get("ContactsEmail")</MudTh>
                            <MudTh>@Strings.Get("ContactsPhone")</MudTh>
                        </HeaderContent>
                        <RowTemplate Context="row">
                            <MudTd><span style="@Swatch(row.CollectionColor)" title="@row.CollectionName"></span></MudTd>
                            <MudTd>@row.FullName</MudTd>
                            <MudTd Class="mud-text-secondary">@row.Organization</MudTd>
                            <MudTd Class="mud-text-secondary">@row.Email</MudTd>
                            <MudTd Class="mud-text-secondary">@row.Phone</MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </div>
        </div>

        @* Detail. Sized to its content: this pane must not claim space it is not using (ADR 0550). *@
        <div style="flex:0 0 320px; border-left:1px solid var(--mud-palette-lines-default); overflow:auto;" class="pa-3">
            @if (_selected is { } selected)
            {
                <MudText Typo="Typo.h6">@selected.FullName</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">@selected.CollectionName</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@Strings.Get("ContactsOrg")</MudText>
                <MudText Typo="Typo.body2" Class="mb-2">@selected.Organization</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@Strings.Get("ContactsEmail")</MudText>
                <MudText Typo="Typo.body2" Class="mb-2">@selected.Email</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@Strings.Get("ContactsPhone")</MudText>
                <MudText Typo="Typo.body2">@selected.Phone</MudText>
            }
        </div>
    </div>
</div>

@code {
    private List<DavCollection> _collections = [];
    private readonly HashSet<Guid> _checked = [];
    private List<ContactRow> _contacts = [];
    private ContactRow? _selected;
    private string _filter = string.Empty;

    /// <summary>
    /// One listed contact. <paramref name="SelfHref"/> is the row's own advertised address — Edit acts from
    /// THIS, never from whatever the detail pane last finished loading (ADR 0559).
    /// </summary>
    public sealed record ContactRow(
        Guid Id, string CollectionColor, string CollectionName, string FullName,
        string Organization, string Email, string Phone, string? SelfHref);

    /// <summary>
    /// The checked addressbooks the caller may create in — asked of the <c>contacts</c> rel, not of
    /// <c>Writable</c>. They are different questions: the flag reports the right to edit CONTENT, while the
    /// create needs the right to add sub-items, and gating on the wrong one either hides a create that would
    /// succeed or offers one the server refuses (ADR 0543).
    /// </summary>
    private List<CreateTarget> CreateTargets() =>
    [
        .. _collections
            .Where(c => _checked.Contains(c.Id) && c.Href("contacts") is not null)
            .Select(c => new CreateTarget(c.Id, c.DisplayName, c.Href("contacts")!)),
    ];

    private bool CanCreate => CreateTargets().Count > 0;

    private IEnumerable<ContactRow> Visible =>
        _filter is { Length: > 0 }
            ? _contacts.Where(c =>
                c.FullName.Contains(_filter, StringComparison.CurrentCultureIgnoreCase)
                || c.Organization.Contains(_filter, StringComparison.CurrentCultureIgnoreCase)
                || c.Email.Contains(_filter, StringComparison.CurrentCultureIgnoreCase))
            : _contacts;

    private static string Swatch(string color) =>
        $"display:inline-block; width:8px; height:8px; border-radius:4px; background:{color};";

    protected override async Task OnInitializedAsync() => await LoadAsync();

    /// <summary>Loads the addressbooks; the caller's own is ticked so the tab opens with content.</summary>
    public async Task LoadAsync()
    {
        try
        {
            _collections = await DavCollections.ListAsync("addressbook");
            _checked.Clear();
            foreach (var collection in _collections.Where(c => c.IsPersonalDefault))
            {
                _checked.Add(collection.Id);
            }

            await ReloadContactsAsync();
        }
        catch (Exception e)
        {
            Snackbar.Add(string.Format(Strings.Get("StErrLoadContacts"), e.Message), Severity.Error);
        }
    }

    private async Task ReloadContactsAsync()
    {
        var rows = new List<ContactRow>();
        foreach (var collection in _collections.Where(c => _checked.Contains(c.Id)))
        {
            if (collection.Href("children") is not { } childrenHref)
            {
                continue; // a rel the server did not advertise means "not available here" (ADR 0543)
            }

            try
            {
                var contents = await Browse.LoadContentsAsync(collection.Id, collection.Id, childrenHref);
                foreach (var node in contents.Nodes.Where(n => n.HasVersions))
                {
                    // Organization/Email/Phone come from the Contact mask's index data, which this listing does
                    // not carry — the same gap the desktop tab has, and it closes the same way for both.
                    rows.Add(new ContactRow(
                        node.Id, collection.Color ?? "#8a8a8a", collection.DisplayName, node.Name,
                        string.Empty, string.Empty, string.Empty, BrowseService.HrefOf(node, "self")));
                }
            }
            catch (Exception e)
            {
                // One unreadable addressbook must not blank the whole tab — the others still have contacts.
                Snackbar.Add(string.Format(Strings.Get("StErrLoadContacts"), e.Message), Severity.Error);
            }
        }

        _contacts = [.. rows.OrderBy(r => r.FullName, StringComparer.CurrentCultureIgnoreCase)];
        StateHasChanged();
    }

    /// <summary>
    /// New contact (#631): the SAME dialog as Edit, opened empty, with the document created FROM the filled-in
    /// form. Nothing exists until Save, so a cancelled dialog leaves nothing behind — and no DAV client syncing
    /// meanwhile takes a copy of a stub.
    /// </summary>
    private async Task NewContactAsync()
    {
        // Re-read rather than trusting the disabled button: the ticks can change while the tab is open.
        if (CreateTargets() is not { Count: > 0 } targets)
        {
            return;
        }

        var parameters = new DialogParameters
        {
            { nameof(Dialogs.ContactDialog.Form), new ContactCardForm() },
            { nameof(Dialogs.ContactDialog.Targets), targets },
        };

        var dialog = await DialogService.ShowAsync<Dialogs.ContactDialog>(Strings.Get("ContactsNew"), parameters);
        if ((await dialog.Result) is not { Canceled: false, Data: Dialogs.ContactDialog.Saved saved }
            || saved.Target is not { } target)
        {
            return;
        }

        var createdId = await StructuredEditors.CreateAsync(target.CreateHref, saved.Form.ToPayload());
        if (createdId is null)
        {
            Snackbar.Add(string.Format(Strings.Get("StErrCreateContact"), string.Empty), Severity.Error);
            return;
        }

        await ReloadContactsAsync();

        // Selected by the id the server returned, never by the name the form composed: the server decides the
        // filed name (it disambiguates a sibling clash), so matching on our guess selects nothing on exactly
        // the second "Ada Lovelace".
        _selected = _contacts.FirstOrDefault(c => c.Id == createdId) ?? _selected;
        Snackbar.Add(string.Format(Strings.Get("StContactCreated"), _selected?.FullName ?? string.Empty, target.DisplayName), Severity.Success);
    }

    /// <summary>Opens the structured editor for the selected contact.</summary>
    /// <remarks>
    /// Addressed from the ROW the user clicked (ADR 0559), never from the pane's loaded state. The row's link
    /// set comes from a children listing, which advertises what BROWSING needs (ADR 0557), so the card is
    /// reached by resolving that address once and following what the document itself offers — and a document
    /// advertising no contact-card rel is the server saying this is not an editable contact (ADR 0543).
    /// </remarks>
    private async Task EditContactAsync()
    {
        if (_selected is not { SelfHref: { } self } row)
        {
            return;
        }

        var loaded = await StructuredEditors.ReadAsync(self, "contact-card", ContactCardForm.From);
        if (loaded is null)
        {
            Snackbar.Add(Strings.Get("ContactNotEditable"), Severity.Info);
            return;
        }

        loaded.Value.CanEdit = loaded.CanEdit;

        // The raw source loads only if the user opens the disclosure (#648) — the lambda is how the dialog
        // reaches the api client without owning one, the same split the desktop uses.
        var parameters = new DialogParameters
        {
            { nameof(Dialogs.ContactDialog.Form), loaded.Value },
            { nameof(Dialogs.ContactDialog.LoadRaw), (Func<Task>)(async () =>
                {
                    if (await StructuredEditors.ReadRawAsync(loaded.Links) is { } raw)
                    {
                        loaded.Value.Raw.Set(raw.Text, raw.Format, raw.ETag);
                    }
                })
            },
        };

        var dialog = await DialogService.ShowAsync<Dialogs.ContactDialog>(row.FullName, parameters);
        if ((await dialog.Result) is not { Canceled: false, Data: Dialogs.ContactDialog.Saved saved })
        {
            return;
        }

        // A dirty raw box wins and REPLACES the card. The two describe the same contact and only one can be
        // saved, which is why the form went read-only the moment the raw text changed.
        if (saved.Form.Raw.IsDirty)
        {
            if (await StructuredEditors.SaveRawAsync(loaded.Links, saved.Form.Raw.Text, saved.Form.Raw.ETag) is { } problem)
            {
                // Verbatim: the refusals name the line to fix, which "saving failed" would throw away.
                Snackbar.Add(problem, Severity.Error);
                return;
            }

            Snackbar.Add(Strings.Get("StRawSaved"), Severity.Success);
            await ReloadContactsAsync();
            return;
        }

        if (await StructuredEditors.SaveAsync(loaded.Href, saved.Form.ToPayload(), loaded.ETag))
        {
            Snackbar.Add(string.Format(Strings.Get("StContactSaved"), row.FullName), Severity.Success);
            await ReloadContactsAsync();
        }
        else
        {
            Snackbar.Add(string.Format(Strings.Get("StErrSaveContact"), string.Empty), Severity.Error);
        }
    }
}
