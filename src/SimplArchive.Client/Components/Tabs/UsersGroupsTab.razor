@using System.Net
@inject HttpClient Http
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject SimplArchive.Client.Services.ApiRoot ApiRoot
@inject SimplArchive.Client.Services.SensitivityLabelCatalog SensitivityLabels
@inject SimplArchive.Client.Services.ImpersonationService ImpersonationSvc

@* The Users & groups tab (ADRs "Users & groups administration", "Group membership editing"), extracted from
   Home.razor per ADR 0558.

   Tenant administration: the principal directory, group membership, system rights, passwords/MFA/photos, and
   service accounts. Entirely self-contained — the only thing it is told is whether the caller may manage
   service accounts, which gates one button. *@

@* Users & groups administration (ADR "Users & groups administration tab"): a combined
   principal list on the left, the assignable system-rights matrix on the right. *@
<div style="flex:1 1 auto; min-height:0; display:flex; flex-direction:column;">
    @* The toolbar in the Repositories shape (#530 tranche 4), spanning the tab like every converted tab's:
       one + with a New user/New group flyout (by decision — creation is one affordance, not two competing
       buttons), copy greyed without a selection, delete SEPARATED as the destructive one (and no error
       accent — in a control group the appearance meaning state can't also mean emphasis, ADR 0581), the
       service-account manager HIDDEN without the right (ADR 0543), refresh last. The class keeps its old
       name: the tests address this toolbar by it, and the first three buttons keep their old positions. *@
    <div class="wb-ug-toolbar wb-search-bar pa-2" style="border-bottom:1px solid var(--mud-palette-lines-default);">
        <MudButton Class="wb-rib-btn" Size="Size.Small" OnClick="@(e => _newMenu.OpenMenuAsync(e))"
                   title="@Strings.Get("UgNew")" aria-label="@Strings.Get("UgNew")">
            <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" /><span class="wb-rib-label">@Strings.Get("UgNew")</span>
        </MudButton>
        @* MudMenu's ActivatorContent auto-open is unreliable for a custom activator (the MainLayout
           precedent), so the + button above opens it explicitly and the menu's own activator is hidden. *@
        <MudMenu @ref="_newMenu" Dense="true" AnchorOrigin="Origin.BottomLeft">
            <ActivatorContent><span style="display:none;"></span></ActivatorContent>
            <ChildContent>
                <MudMenuItem Icon="@Icons.Material.Filled.Person" OnClick="() => NewPrincipalAsync(false)">@Strings.Get("UgNewUser")</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.Group" OnClick="() => NewPrincipalAsync(true)">@Strings.Get("UgNewGroup")</MudMenuItem>
            </ChildContent>
        </MudMenu>
        <MudButton Class="wb-rib-btn ml-3" Size="Size.Small" Disabled="@(_selectedPrincipal is null)" OnClick="CopyPrincipalAsync"
                   title="@Strings.Get("UgCopy")" aria-label="@Strings.Get("UgCopy")">
            <MudIcon Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" /><span class="wb-rib-label">@Strings.Get("UgCopy")</span>
        </MudButton>
        <MudButton Class="wb-rib-btn ml-3" Size="Size.Small" Disabled="@(_selectedPrincipal is null)" OnClick="DeletePrincipalAsync"
                   title="@Strings.Get("UgDelete")" aria-label="@Strings.Get("UgDelete")">
            <MudIcon Icon="@Icons.Material.Filled.Delete" Size="Size.Small" /><span class="wb-rib-label">@Strings.Get("UgDelete")</span>
        </MudButton>
        @* Service accounts (machine-to-machine) management — ADR 0534, gated on CanManageServiceAccounts. *@
        @if (CanManageServiceAccounts)
        {
            <MudButton Class="wb-rib-btn ml-3" Size="Size.Small" OnClick="OpenServiceAccountsAsync"
                       title="@Strings.Get("SaManage")" aria-label="@Strings.Get("SaManage")">
                <MudIcon Icon="@Icons.Material.Filled.Api" Size="Size.Small" /><span class="wb-rib-label">@Strings.Get("SaManage")</span>
            </MudButton>
        }
        <MudButton Class="wb-rib-btn ml-3" Size="Size.Small" OnClick="LoadPrincipalsAsync"
                   title="@Strings.Get("RibbonRefresh")" aria-label="@Strings.Get("RibbonRefresh")">
            <MudIcon Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" /><span class="wb-rib-label">@Strings.Get("RibbonRefresh")</span>
        </MudButton>
    </div>
<div class="wb-ug">
    <div class="wb-ug-list">
        <div class="wb-ug-rows">
            @foreach (var p in _principals)
            {
                <div class="wb-list-row @(ReferenceEquals(p, _selectedPrincipal) ? "wb-list-row-selected" : "")" @onclick="() => SelectPrincipalAsync(p)">
                    <MudIcon Icon="@(p.IsGroup ? Icons.Material.Filled.Group : Icons.Material.Filled.Person)" Size="Size.Small" />
                    <span style="flex:1 1 auto; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@p.Name</span>
                    @if (!p.IsGroup && !p.IsActive)
                    {
                        <span class="mud-text-secondary" style="font-size:.75em;">@Strings.Get("UgInactive")</span>
                    }
                    @* What can be done to THIS row lives in its ⋮ menu — the toolbar's twins act on the
                       selection (#521's split). Selecting first makes the menu's subject and the selection
                       the same row before either action reads it (ADR 0559). *@
                    <span @onclick:stopPropagation="true">
                        <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true" AnchorOrigin="Origin.BottomLeft">
                            <MudMenuItem Icon="@Icons.Material.Filled.ContentCopy" OnClick="async () => { await SelectPrincipalAsync(p); await CopyPrincipalAsync(); }">@Strings.Get("UgCopy")</MudMenuItem>
                            <MudMenuItem Icon="@Icons.Material.Filled.Delete" OnClick="async () => { await SelectPrincipalAsync(p); await DeletePrincipalAsync(); }">@Strings.Get("UgDelete")</MudMenuItem>
                        </MudMenu>
                    </span>
                </div>
            }
        </div>
    </div>
    <div class="wb-ug-rights">
        @if (_selectedPrincipal is { } sel)
        {
            <div class="wb-ug-rights-head">
                <MudIcon Icon="@(sel.IsGroup ? Icons.Material.Filled.Group : Icons.Material.Filled.Person)" Size="Size.Small" />
                <MudText Typo="Typo.subtitle1">@sel.Name</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@string.Format(Strings.Get("UgRights"), sel.IsGroup ? Strings.Get("UgGroup") : Strings.Get("UgUser"))</MudText>
            </div>
            @* Profile photo (users only — groups have none). ADR "User profile photo". *@
            @if (!sel.IsGroup)
            {
                <div class="wb-ug-photo">
                    @if (_principalPhotoUrl is not null)
                    {
                        <MudAvatar Size="Size.Large"><MudImage Src="@_principalPhotoUrl" /></MudAvatar>
                    }
                    else
                    {
                        <MudAvatar Size="Size.Large" Color="Color.Secondary">@PrincipalInitials(sel.Name)</MudAvatar>
                    }
                    <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.PhotoCamera" OnClick="ChangePrincipalPhotoAsync">@Strings.Get("UgChangePhoto")</MudButton>
                    @if (_principalPhotoUrl is not null)
                    {
                        <MudButton Size="Size.Small" Color="Color.Error" OnClick="RemovePrincipalPhotoAsync">@Strings.Get("UgRemove")</MudButton>
                    }
                </div>
                @* Admin password reset (ADR "User password management"). *@
                <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.Password" OnClick="ResetPrincipalPasswordAsync" Class="mb-2">@Strings.Get("UgResetPassword")</MudButton>
                @* Two-factor status + admin reset (ADR "MFA (interactive login, TOTP)"). *@
                <div class="mb-2">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        <MudIcon Icon="@(sel.MfaEnabled ? Icons.Material.Filled.Security : Icons.Material.Filled.NoEncryption)" Size="Size.Small" />
                        @string.Format(Strings.Get("UgTwoFactor"), sel.MfaEnabled ? Strings.Get("UgMfaEnabled") : Strings.Get("UgMfaOff"))
                    </MudText>
                    @if (sel.MfaEnabled && CanResetMfa)
                    {
                        <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.LockReset" Color="Color.Error" OnClick="ResetPrincipalMfaAsync">@Strings.Get("UgResetMfa")</MudButton>
                    }
                </div>
                @* Impersonate a non-admin user (ADR "User impersonation"). *@
                @if (CanImpersonate && !sel.Rights.IsTenantAdmin && !sel.Rights.CanImpersonate)
                {
                    <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.SupervisorAccount" OnClick="() => ImpersonatePrincipalAsync(sel)" Class="mb-2">@Strings.Get("UgImpersonate")</MudButton>
                }
            }
            @if (sel.IsGroup)
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary mb-2">
                    <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" /> @Strings.Get("UgGroupRightsNote")
                </MudText>
            }
            <div class="wb-ug-rights-grid">
                @foreach (var r in _rightsFields)
                {
                    <MudCheckBox T="bool" Value="@r.Get(_editRights)" ValueChanged="@(v => r.Set(_editRights, v))" Dense="true" Label="@r.Label" Class="wb-ug-right" Disabled="@(!_ugEditing)" />
                }
            </div>
            @* Sensitivity clearance (ADR "Sensitivity clearance enforcement") — the highest label rank this principal may access. *@
            <div class="d-flex align-center gap-1 mt-2" style="max-width:340px;">
                <MudSelect T="int" Label="@Strings.Get("UgClearanceLabel")" @bind-Value="_editRights.ClearanceRank" Dense="true"
                           Disabled="@(!_ugEditing)" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1">
                    <MudSelectItem T="int" Value="0">@Strings.Get("UgClearanceNone")</MudSelectItem>
                    @foreach (var lbl in _sensitivityLabels.Where(l => !l.Retired).OrderBy(l => l.Rank))
                    {
                        <MudSelectItem T="int" Value="@lbl.Rank">@lbl.Rank — @lbl.Name</MudSelectItem>
                    }
                </MudSelect>
                <InfoButton Text="@(Strings.Get("UgClearanceInfo"))" />
            </div>
            <div class="wb-detail-actions">
                @if (_ugEditing)
                {
                    <MudButton Size="Size.Small" OnClick="CancelRightsEdit" Disabled="_ugBusy">@Strings.Get("Cancel")</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveRightsAsync" Disabled="_ugBusy">@Strings.Get("Save")</MudButton>
                }
                else
                {
                    <MudButton Size="Size.Small" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Edit" OnClick="BeginRightsEdit">@Strings.Get("Edit")</MudButton>
                }
            </div>
            @* Group membership (ADR "Group membership editing") — direct members with a
               searchable add-picker. *@
            @if (sel.IsGroup)
            {
                <MudDivider Class="my-3" />
                <MudText Typo="Typo.subtitle2" Class="mb-1">@Strings.Get("UgMembers")</MudText>
                <MudAutocomplete T="MemberOption" Label="@Strings.Get("UgAddMember")" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined"
                                 SearchFunc="SearchNonMembers" ToStringFunc="@(o => o?.Name ?? "")" ValueChanged="AddMemberAsync"
                                 ResetValueOnEmptyText="true" CoerceText="true" Clearable="true" Class="wb-ug-add-member" Style="max-width:360px;" />
                @if (_groupMembers.Count == 0)
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary mt-2">@Strings.Get("UgNoMembers")</MudText>
                }
                else
                {
                    <div class="wb-ug-members">
                        @foreach (var m in _groupMembers)
                        {
                            <div class="wb-ug-member">
                                <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" />
                                <span style="flex:1 1 auto; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@m.Name</span>
                                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Error" OnClick="() => RemoveMemberAsync(m)" title="@Strings.Get("UgRemoveMember")" />
                            </div>
                        }
                    </div>
                }
            }
        }
        else
        {
            <div class="wb-preview-empty"><MudText Typo="Typo.body2">@Strings.Get("UgSelectPrincipal")</MudText></div>
        }
    </div>
</div>
</div>

@code {

    /// <summary>The + button's flyout, opened explicitly (its own activator is hidden).</summary>
    private MudMenu _newMenu = null!;

    /// <summary>Gates the service-accounts button; the server enforces the right regardless.</summary>
    [Parameter]
    public bool CanManageServiceAccounts { get; set; }

    /// <summary>Gates the reset-MFA action on a selected user.</summary>
    [Parameter]
    public bool CanResetMfa { get; set; }

    /// <summary>Gates the impersonate action.</summary>
    [Parameter]
    public bool CanImpersonate { get; set; }

    // Both loaders the shell's activation branch used to call. Carried TOGETHER on purpose: extracting the
    // Audit tab moved its event page and silently dropped the second call in its SetTab branch, which compiled
    // and failed only in the browser (ADR 0558).
    protected override async Task OnInitializedAsync()
    {
        await LoadPrincipalsAsync();

        // The clearance dropdown maps ranks to sensitivity-label names (ADR "Sensitivity clearance"). Read
        // through the shared catalogue, so this tab and the Repositories picker cannot drift apart.
        _sensitivityLabels = await SensitivityLabels.GetAsync();
    }

    private IReadOnlyList<SensitivityLabel> _sensitivityLabels = [];

    // Four lines over the impersonation service, and reachable only from this tab's own button.
    private async Task ImpersonatePrincipalAsync(PrincipalRow p)
    {
        if (!await ImpersonationSvc.StartAsync(p.Id))
        {
            Snackbar.Add(Strings.Get("StErrImpersonate"), Severity.Error);
        }
    }


    private List<PrincipalRow> _principals = [];
    private PrincipalRow? _selectedPrincipal;
    private SystemRightsDto _editRights = new();
    private bool _ugBusy;
    // The rights matrix is read-only until Edit is clicked, then Save/Cancel (like the Repositories detail pane).
    private bool _ugEditing;

    private void BeginRightsEdit() => _ugEditing = true;

    private void CancelRightsEdit()
    {
        _ugEditing = false;
        _editRights = _selectedPrincipal is { } sel ? sel.Rights with { } : new();
    }

    // The rights matrix, in display order (management rights first, then the not-yet-enforced ones).
    private static readonly RightField[] _rightsFields =
    [
        new("Tenant administrator", r => r.IsTenantAdmin, (r, v) => r.IsTenantAdmin = v),
        new("Manage users & groups", r => r.CanManageUsers, (r, v) => r.CanManageUsers = v),
        new("Manage repositories", r => r.CanManageRepositories, (r, v) => r.CanManageRepositories = v),
        new("Manage masks", r => r.CanManageMasks, (r, v) => r.CanManageMasks = v),
        new("Manage service accounts", r => r.CanManageServiceAccounts, (r, v) => r.CanManageServiceAccounts = v),
        new("Impersonate", r => r.CanImpersonate, (r, v) => r.CanImpersonate = v),
        new("Override checkout", r => r.CanOverrideCheckout, (r, v) => r.CanOverrideCheckout = v),
        new("Legal hold", r => r.CanLegalHold, (r, v) => r.CanLegalHold = v),
        new("Manage classification", r => r.CanManageClassification, (r, v) => r.CanManageClassification = v),
        new("Reset MFA", r => r.CanResetMfa, (r, v) => r.CanResetMfa = v),
        new("View audit log", r => r.CanViewAuditLog, (r, v) => r.CanViewAuditLog = v),
        new("Export", r => r.CanExport, (r, v) => r.CanExport = v),
        new("Import", r => r.CanImport, (r, v) => r.CanImport = v),
        new("Manage inboxes", r => r.CanManageInboxes, (r, v) => r.CanManageInboxes = v),
        new("Create external links", r => r.CanCreateExternalLink, (r, v) => r.CanCreateExternalLink = v),
    ];

    private async Task LoadPrincipalsAsync()
    {
        var previousId = _selectedPrincipal?.Id;
        var previousIsGroup = _selectedPrincipal?.IsGroup;
        var rows = new List<PrincipalRow>();

        try
        {
            var gurl = await ApiRoot.RequireAsync("groups");
            while (gurl is not null)
            {
                var page = await Http.GetFromJsonAsync<GroupsAdminResponse>(gurl);
                foreach (var g in page?.Groups ?? [])
                {
                    rows.Add(new PrincipalRow { IsGroup = true, Id = g.Id, Name = g.Name, Rights = g.Rights ?? new(), Links = Links.RelMap(g.Links) });
                }
                gurl = Links.Href(page?.Links, "next");
            }

            var uurl = await ApiRoot.RequireAsync("users");
            while (uurl is not null)
            {
                var page = await Http.GetFromJsonAsync<UsersAdminResponse>(uurl);
                foreach (var u in page?.Users ?? [])
                {
                    rows.Add(new PrincipalRow { IsGroup = false, Id = u.Id, Name = u.DisplayName, IsActive = u.IsActive, MfaEnabled = u.MfaEnabled, Rights = u.Rights ?? new(), PhotoHref = Links.Href(u.Links, "photo"), Links = Links.RelMap(u.Links) });
                }
                uurl = Links.Href(page?.Links, "next");
            }
        }
        catch (Exception)
        {
            Snackbar.Add(Strings.Get("StErrLoadUsers"), Severity.Error);
            return;
        }

        // Groups first (two-person icon), then users (one-person icon), each alphabetical.
        _principals = rows.OrderByDescending(p => p.IsGroup).ThenBy(p => p.Name, StringComparer.OrdinalIgnoreCase).ToList();
        _selectedPrincipal = _principals.FirstOrDefault(p => p.Id == previousId && p.IsGroup == previousIsGroup);
        _editRights = _selectedPrincipal is { } sel ? sel.Rights with { } : new();
        await LoadPrincipalPhotoAsync(_selectedPrincipal);
        await LoadGroupMembersAsync(_selectedPrincipal);
    }

    private string? _principalPhotoUrl;

    private async Task SelectPrincipalAsync(PrincipalRow p)
    {
        _selectedPrincipal = p;
        _ugEditing = false; // a fresh selection starts read-only
        _editRights = p.Rights with { }; // an independent copy so the matrix edits don't mutate the row until Save
        await LoadPrincipalPhotoAsync(p);
        await LoadGroupMembersAsync(p);
    }

    // ---- Group membership (ADR "Group membership editing") -------------------------------------------

    private readonly List<MemberOption> _groupMembers = [];

    // The members collection's `add-member` address, captured when the list loads.
    private string? _groupMembersAddHref;
    // RemoveHref is the member row's own `remove` rel — the only resource that knows both ends of the
    // (group, user) pair a membership is addressed by (issue #416).
    private record MemberOption(Guid Id, string Name, string? RemoveHref = null);

    private async Task LoadGroupMembersAsync(PrincipalRow? p)
    {
        _groupMembers.Clear();
        _groupMembersAddHref = null;
        if (p is null || !p.IsGroup)
        {
            return;
        }

        try
        {
            var url = p.Href("members");
            while (url is not null)
            {
                var page = await Http.GetFromJsonAsync<MembersResponse>(url);
                foreach (var m in page?.Members ?? [])
                {
                    _groupMembers.Add(new MemberOption(m.Id, m.DisplayName, Links.Href(m.Links, "remove")));
                }
                _groupMembersAddHref ??= Links.Href(page?.Links, "add-member");
                url = Links.Href(page?.Links, "next");
            }
        }
        catch (Exception)
        {
            Snackbar.Add(Strings.Get("StErrLoadMembers"), Severity.Error);
        }
    }

    // Non-member tenant users matching the typed text — the add-picker's candidates.
    private Task<IEnumerable<MemberOption>> SearchNonMembers(string? text, CancellationToken _)
    {
        var memberIds = _groupMembers.Select(m => m.Id).ToHashSet();
        var candidates = _principals
            .Where(p => !p.IsGroup && !memberIds.Contains(p.Id))
            .Where(p => string.IsNullOrWhiteSpace(text) || p.Name.Contains(text, StringComparison.OrdinalIgnoreCase))
            .OrderBy(p => p.Name, StringComparer.OrdinalIgnoreCase)
            .Select(p => new MemberOption(p.Id, p.Name));
        return Task.FromResult<IEnumerable<MemberOption>>(candidates);
    }

    private async Task AddMemberAsync(MemberOption? option)
    {
        if (option is null || _selectedPrincipal is not { IsGroup: true } group)
        {
            return;
        }

        // The API now takes the member in the BODY of a POST to the collection, so this follows a rel like
        // everything else — the chosen user travels as data rather than as a path segment (issue #416).
        if (_groupMembersAddHref is null) { return; }

        using var resp = await Http.PostAsJsonAsync(_groupMembersAddHref, new { userId = option.Id });
        if (resp.IsSuccessStatusCode)
        {
            await LoadGroupMembersAsync(group);
            Snackbar.Add(string.Format(Strings.Get("StAdded"), option.Name), Severity.Success);
        }
        else
        {
            Snackbar.Add(Strings.Get(resp.StatusCode == HttpStatusCode.Forbidden ? "NoPermission" : "StErrAddMember"), Severity.Warning);
        }
    }

    private async Task RemoveMemberAsync(MemberOption member)
    {
        if (_selectedPrincipal is not { IsGroup: true } group)
        {
            return;
        }

        if (member.RemoveHref is not { } removeHref) { return; }

        using var resp = await Http.DeleteAsync(removeHref);
        if (resp.IsSuccessStatusCode)
        {
            _groupMembers.Remove(member);
            Snackbar.Add(string.Format(Strings.Get("StRemovedName"), member.Name), Severity.Success);
        }
        else
        {
            Snackbar.Add(Strings.Get("StErrRemoveMember"), Severity.Warning);
        }
    }

    private record MembersResponse { public List<MemberDto> Members { get; set; } = []; public List<LinkResponse> Links { get; set; } = []; }
    private record MemberDto { public Guid Id { get; set; } public string DisplayName { get; set; } = ""; public List<LinkResponse> Links { get; set; } = []; }

    // The photo endpoint is bearer-protected, so fetch the bytes with the authenticated client and render a
    // data URL (a raw <img src> sends no token) — ADR "User profile photo". 404 → no photo.
    private async Task LoadPrincipalPhotoAsync(PrincipalRow? p)
    {
        _principalPhotoUrl = null;
        if (p is null || p.IsGroup)
        {
            return;
        }

        try
        {
            if (p.PhotoHref is not { } photoHref) { return; }

            var bytes = await Http.GetByteArrayAsync(photoHref);
            _principalPhotoUrl = "data:image/png;base64," + Convert.ToBase64String(bytes);
        }
        catch (Exception)
        {
            _principalPhotoUrl = null;
        }
    }

    private async Task ChangePrincipalPhotoAsync()
    {
        if (_selectedPrincipal is not { IsGroup: false } p)
        {
            return;
        }

        var parameters = new DialogParameters<ProfilePhotoDialog> { { x => x.PhotoHref, p.PhotoHref } };
        var dialog = await DialogService.ShowAsync<ProfilePhotoDialog>(Strings.Get("PpTitle"), parameters);
        if (await dialog.Result is { Canceled: false })
        {
            await LoadPrincipalPhotoAsync(p);
        }
    }

    private async Task RemovePrincipalPhotoAsync()
    {
        if (_selectedPrincipal is not { IsGroup: false } p)
        {
            return;
        }

        if (p.PhotoHref is not { } photoHref) { return; }

        using var resp = await Http.DeleteAsync(photoHref);
        if (resp.IsSuccessStatusCode)
        {
            _principalPhotoUrl = null;
            Snackbar.Add(Strings.Get("StPhotoRemoved"), Severity.Success);
        }
    }

    private static string PrincipalInitials(string name) => string.IsNullOrWhiteSpace(name)
        ? "?"
        : string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => char.ToUpperInvariant(w[0])));

    // Admin password reset (ADR "User password management") — generates a random password shown once.
    private async Task ResetPrincipalPasswordAsync()
    {
        if (_selectedPrincipal is not { IsGroup: false } p)
        {
            return;
        }

        var confirmed = await DialogService.ShowMessageBoxAsync(new MessageBoxOptions
        {
            Title = "Reset password",
            Message = $"Reset the password for '{p.Name}'? A new random password will be generated and shown once.",
            YesText = "Reset",
            CancelText = "Cancel",
        });
        if (confirmed != true)
        {
            return;
        }

        try
        {
            if (p.Href("reset-password") is not { } resetPasswordHref) { return; }

            using var resp = await Http.PostAsync(resetPasswordHref, null);
            if (resp.IsSuccessStatusCode)
            {
                var result = await resp.Content.ReadFromJsonAsync<ResetPasswordResult>();
                var parameters = new DialogParameters<GeneratedPasswordDialog>
                {
                    { x => x.Password, result?.Password ?? "" },
                    { x => x.UserName, p.Name },
                };
                await (await DialogService.ShowAsync<GeneratedPasswordDialog>(Strings.Get("GenPwTitle"), parameters)).Result;
            }
            else
            {
                Snackbar.Add(Strings.Get(resp.StatusCode == HttpStatusCode.Forbidden ? "NoPermission" : "StErrResetPassword"), Severity.Warning);
            }
        }
        catch (Exception)
        {
            Snackbar.Add(Strings.Get("StErrResetPw"), Severity.Error);
        }
    }

    private record ResetPasswordResult { public string Password { get; set; } = ""; }

    // Admin MFA reset (ADR "MFA (interactive login, TOTP)") — disables a locked-out user's two-factor so they
    // can sign in with just their password and re-enroll.
    private async Task ResetPrincipalMfaAsync()
    {
        if (_selectedPrincipal is not { IsGroup: false } p)
        {
            return;
        }

        var confirmed = await DialogService.ShowMessageBoxAsync(new MessageBoxOptions
        {
            Title = "Reset two-factor authentication",
            Message = $"Disable two-factor authentication for '{p.Name}'? They'll be able to sign in with just their password until they re-enroll.",
            YesText = "Reset",
            CancelText = "Cancel",
        });
        if (confirmed != true)
        {
            return;
        }

        try
        {
            if (p.Href("reset-mfa") is not { } resetMfaHref) { return; }

            using var resp = await Http.PostAsync(resetMfaHref, null);
            if (resp.IsSuccessStatusCode)
            {
                p.MfaEnabled = false;
                Snackbar.Add(string.Format(Strings.Get("StMfaResetFor"), p.Name), Severity.Success);
                StateHasChanged();
            }
            else
            {
                Snackbar.Add(Strings.Get(resp.StatusCode == HttpStatusCode.Forbidden ? "NoPermission" : "StErrResetMfa"), Severity.Warning);
            }
        }
        catch (Exception)
        {
            Snackbar.Add(Strings.Get("StErrResetMfa"), Severity.Error);
        }
    }

    private async Task NewPrincipalAsync(bool isGroup)
