    private async Task<PrincipalDialog.Result?> ShowPrincipalDialogAsync(bool isGroup, string title, string initialName, string initialEmail)
    {
        var parameters = new DialogParameters<PrincipalDialog>
        {
            { x => x.IsGroup, isGroup },
            { x => x.InitialName, initialName },
            { x => x.InitialEmail, initialEmail },
        };
        var dialog = await DialogService.ShowAsync<PrincipalDialog>(title, parameters);
        var result = await dialog.Result;
        return result is { Canceled: false, Data: PrincipalDialog.Result data } ? data : null;
    }

    private async Task CreatePrincipalAsync(bool isGroup, string name, string email, SystemRightsDto? copyRights)
    {
        try
        {
            Guid newId;
            string? rightsHref;
            using (var resp = isGroup
                ? await Http.PostAsJsonAsync(await ApiRoot.RequireAsync("groups"), new { name })
                : await Http.PostAsJsonAsync(await ApiRoot.RequireAsync("users"), new { email, displayName = name }))
            {
                if (!resp.IsSuccessStatusCode)
                {
                    Snackbar.Add(Strings.Get(resp.StatusCode switch
                    {
                        HttpStatusCode.Conflict when isGroup => "StGroupNameExists",
                        HttpStatusCode.Conflict => "StUserEmailExists",
                        _ => "StErrCreate",
                    }), Severity.Warning);
                    return;
                }

                // The create response IS the new principal, and it advertises where its rights are set —
                // followed for the copy-rights option rather than rebuilt from the fresh id (ADR 0543, #416).
                if (isGroup)
                {
                    var g = (await resp.Content.ReadFromJsonAsync<GroupAdminDto>())!;
                    (newId, rightsHref) = (g.Id, Links.Href(g.Links, "rights"));
                }
                else
                {
                    var u = (await resp.Content.ReadFromJsonAsync<UserAdminDto>())!;
                    (newId, rightsHref) = (u.Id, Links.Href(u.Links, "rights"));
                }
            }

            if (copyRights is not null && rightsHref is not null)
            {
                await Http.PutAsJsonAsync(rightsHref, copyRights);
            }

            await LoadPrincipalsAsync();
            if (_principals.FirstOrDefault(p => p.IsGroup == isGroup && p.Id == newId) is { } created)
            {
                await SelectPrincipalAsync(created);
            }

            Snackbar.Add(Strings.Get(isGroup ? "StGroupCreated" : "StUserCreated"), Severity.Success);
        }
        catch (Exception)
        {
            Snackbar.Add(Strings.Get("StErrCreate"), Severity.Error);
        }
    }

    private async Task DeletePrincipalAsync()
    {
        if (_selectedPrincipal is not { } p)
        {
            return;
        }

        var confirmed = await DialogService.ShowMessageBoxAsync(new MessageBoxOptions
        {
            Title = p.IsGroup ? "Delete group" : "Deactivate user",
            Message = p.IsGroup ? $"Delete the group '{p.Name}'?" : $"Deactivate the user '{p.Name}'?",
            YesText = p.IsGroup ? "Delete" : "Deactivate",
            CancelText = "Cancel",
        });
        if (confirmed != true)
        {
            return;
        }

        try
        {
            // One rel per kind — the server names the address for removing this principal, so the client no
            // longer branches on IsGroup to build two different paths.
            if ((p.IsGroup ? p.Href("delete") : p.Href("deactivate")) is not { } removeHref) { return; }

            using var resp = await Http.DeleteAsync(removeHref);
            if (resp.IsSuccessStatusCode)
            {
                Snackbar.Add(Strings.Get(p.IsGroup ? "StGroupDeleted" : "StUserDeactivated"), Severity.Success);
                _selectedPrincipal = null;
                await LoadPrincipalsAsync();
                return;
            }

            // A user with pending review tasks can't be deactivated without handing them over — prompt for a
            // replacement reviewer, then retry with ?reassignReviewsTo= (ADR "Workflow review reassignment").
            if (!p.IsGroup && resp.StatusCode == HttpStatusCode.Conflict)
            {
                var problem = await resp.Content.ReadFromJsonAsync<DeleteProblem>();
                if (problem?.ErrorCode == "REVIEWER_HAS_PENDING_REVIEWS")
                {
                    await ReassignThenDeactivateAsync(p);
                    return;
                }
            }

            Snackbar.Add(Strings.Get(resp.StatusCode switch
            {
                HttpStatusCode.Conflict => "StGroupHasChildren",
                HttpStatusCode.Forbidden => "NoPermission",
                _ => "StErrDelete",
            }), Severity.Warning);
        }
        catch (Exception)
        {
            Snackbar.Add(Strings.Get("StErrDelete"), Severity.Error);
        }
    }

    private async Task ReassignThenDeactivateAsync(PrincipalRow user)
    {
        var candidates = _principals
            .Where(x => !x.IsGroup && x.IsActive && x.Id != user.Id)
            .Select(x => new ReplacementReviewerDialog.ReviewerCandidate(x.Id, x.Name))
            .ToList();
        if (candidates.Count == 0)
        {
            Snackbar.Add(Strings.Get("StNoReplacementReviewer"), Severity.Warning);
            return;
        }

        var parameters = new DialogParameters
        {
            [nameof(ReplacementReviewerDialog.UserName)] = user.Name,
            [nameof(ReplacementReviewerDialog.Candidates)] = candidates,
        };
        var dialog = await DialogService.ShowAsync<ReplacementReviewerDialog>(Strings.Get("RrTitle"), parameters);
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not Guid replacementId)
        {
            return;
        }

        // The reassignment is a QUERY on the advertised address, not a path this client invents.
        if (user.Href("deactivate") is not { } deactivateHref) { return; }

        using var retry = await Http.DeleteAsync($"{deactivateHref}?reassignReviewsTo={replacementId}");
        if (retry.IsSuccessStatusCode)
        {
            Snackbar.Add(Strings.Get("StReviewsReassigned"), Severity.Success);
            _selectedPrincipal = null;
            await LoadPrincipalsAsync();
        }
        else
        {
            Snackbar.Add(Strings.Get("StErrReassign"), Severity.Warning);
        }
    }

    private record DeleteProblem { public string? ErrorCode { get; set; } public string? Detail { get; set; } }

    private async Task SaveRightsAsync()
    {
        if (_selectedPrincipal is not { } p)
        {
            return;
        }

        _ugBusy = true;
        try
        {
            if (p.Href("rights") is not { } path) { return; }
            using var resp = await Http.PutAsJsonAsync(path, _editRights);
            if (resp.IsSuccessStatusCode)
            {
                p.Rights = _editRights with { };
                _ugEditing = false;
                Snackbar.Add(Strings.Get("StRightsSaved"), Severity.Success);
            }
            else if (resp.StatusCode == HttpStatusCode.Forbidden)
            {
                Snackbar.Add(Strings.Get("StCannotGrantMoreRights"), Severity.Warning);
            }
            else
            {
                Snackbar.Add(Strings.Get("StErrSaveRights"), Severity.Warning);
            }
        }
        catch (Exception)
        {
            Snackbar.Add(Strings.Get("StErrSaveRights"), Severity.Error);
        }
        finally
        {
            _ugBusy = false;
        }
    }

    private sealed class PrincipalRow
    {
        public bool IsGroup { get; set; }
        public Guid Id { get; set; }
        public string Name { get; set; } = "";
        public bool IsActive { get; set; } = true;
        public bool MfaEnabled { get; set; }
        public SystemRightsDto Rights { get; set; } = new();

        // The addresses the listing advertised for this row (issue #416): a user carries photo /
        // reset-password / reset-mfa / deactivate, a group carries members / delete, and both carry rights.
        // A group has no photo, which is also why that affordance is hidden for one.
        public string? PhotoHref { get; set; }
        public IReadOnlyDictionary<string, string>? Links { get; set; }

        public string? Href(string rel) => Links is not null && Links.TryGetValue(rel, out var href) ? href : null;
    }

    private sealed record RightField(string Label, Func<SystemRightsDto, bool> Get, Action<SystemRightsDto, bool> Set);

    private record SystemRightsDto
    {
        public bool IsTenantAdmin { get; set; }
        public bool CanImpersonate { get; set; }
        public bool CanOverrideCheckout { get; set; }
        public bool CanLegalHold { get; set; }
        public bool CanManageClassification { get; set; }
        public bool CanResetMfa { get; set; }
        public bool CanManageRepositories { get; set; }
        public bool CanManageMasks { get; set; }
        public bool CanManageServiceAccounts { get; set; }
        public bool CanManageUsers { get; set; }
        public bool CanViewAuditLog { get; set; }
        public bool CanExport { get; set; }
        public bool CanImport { get; set; }
        public bool CanManageInboxes { get; set; }
        public bool CanCreateExternalLink { get; set; }
        public int ClearanceRank { get; set; }
    }

    private record UserAdminDto { public Guid Id { get; set; } public string Email { get; set; } = ""; public string DisplayName { get; set; } = ""; public bool IsActive { get; set; } public bool MfaEnabled { get; set; } public SystemRightsDto? Rights { get; set; } public List<LinkResponse> Links { get; set; } = []; }
    private record GroupAdminDto { public Guid Id { get; set; } public string Name { get; set; } = ""; public SystemRightsDto? Rights { get; set; } public List<LinkResponse> Links { get; set; } = []; }
    private record UsersAdminResponse { public List<UserAdminDto> Users { get; set; } = []; public List<LinkResponse> Links { get; set; } = []; }
    private record GroupsAdminResponse { public List<GroupAdminDto> Groups { get; set; } = []; public List<LinkResponse> Links { get; set; } = []; }

