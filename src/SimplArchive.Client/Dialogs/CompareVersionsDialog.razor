@inject HttpClient Http

@* Compare two versions of a document SIDE BY SIDE (ADR 0712): the server sends the two extracted texts, the
   shared Presentation TextDiff aligns the lines and marks the changed words, DiffView renders the rows. Two
   pickers + Compare; "Not available" for binary formats.
   The comparison NEVER runs on its own (ADR "Explicit compare"): the result area shows a hint until Compare is
   clicked, the button is disabled until two DIFFERENT versions are picked, and changing a picker after a run
   clears the result back to the hint so a stale diff can't be mistaken for the current selection's. *@
<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@string.Format(Strings.Get("CompareTitle"), DocumentName)</MudText>
    </TitleContent>
    <DialogContent>
        <div style="min-width: 860px;">
            @if (_unavailable)
            {
                @* The versions could not be listed at all. Showing the pickers here is what produced the
                   "00000000-0000-…" the bug was reported as: controls that look ready, bound to nothing. *@
                <MudAlert data-testid="compare-unavailable" Severity="Severity.Warning" Dense="true">@Strings.Get("CompareNoVersions")</MudAlert>
            }
            else
            {
            <div style="display:flex; align-items:center; gap:12px; margin-bottom:8px;">
                <MudSelect T="Guid" Value="_fromId" ValueChanged="OnFromChanged" Label="@Strings.Get("CompareFrom")" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Style="max-width:180px;">
                    @foreach (var v in _versions)
                    {
                        <MudSelectItem T="Guid" Value="@v.Id">v@(v.VersionNumber)</MudSelectItem>
                    }
                </MudSelect>
                <MudIcon Icon="@Icons.Material.Filled.ArrowForward" />
                <MudSelect T="Guid" Value="_toId" ValueChanged="OnToChanged" Label="@Strings.Get("CompareTo")" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Style="max-width:180px;">
                    @foreach (var v in _versions)
                    {
                        <MudSelectItem T="Guid" Value="@v.Id">v@(v.VersionNumber)</MudSelectItem>
                    }
                </MudSelect>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Difference" OnClick="CompareAsync" Disabled="@(_fromId == _toId || _busy)">@Strings.Get("CompareButton")</MudButton>
            </div>

            @if (_busy)
            {
                <MudProgressCircular Indeterminate="true" Size="Size.Small" />
            }
            else if (_result is { Available: false })
            {
                <MudAlert Severity="Severity.Info" Dense="true">@Strings.Get("CompareNotAvailable")</MudAlert>
            }
            else if (_result is { } r)
            {
                <DiffView FromText="@r.FromText" ToText="@r.ToText" />
            }
            else
            {
                @* Nothing has been compared yet (or the selection changed since) — say so instead of leaving the
                   panel blank, which would read as "these versions are identical". *@
                <div data-testid="compare-hint"
                     style="display:flex; align-items:center; justify-content:center; min-height:120px; padding:16px; text-align:center;
                            border:1px dashed var(--mud-palette-lines-default); border-radius:4px;">
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">@Strings.Get("CompareHint")</MudText>
                </div>
            }
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => Dialog.Cancel())">@Strings.Get("Close")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = null!;

    [Parameter] public Guid DocumentId { get; set; }

    // The version list's address, followed from the row's `versions` rel (issue #416). The compare call below
    // still composes: comparing a PAIR has no rel to follow — a link names one resource, and there is no
    // advertised address for "these two against each other". Converting it needs an API shape that can express
    // the pair (a compare rel on a version, or the pair as query parameters), which is its own change.
    //
    // EditorRequired is a secondary net, NOT the guard. It is a Razor MARKUP diagnostic (RZ2012) and this
    // dialog is never written as a tag — it is launched through DialogService.ShowAsync with a runtime
    // DialogParameters dictionary the Razor compiler never inspects. What actually catches an omission is
    // CompareVersionsDialogCallersTests, which reads the call sites. The attribute earns its place only if
    // someone later uses this component as markup.
    [Parameter, EditorRequired] public string? VersionsHref { get; set; }

    private string? _compareHref;
    [Parameter] public string DocumentName { get; set; } = "";

    private List<VersionInfo> _versions = [];
    private Guid _fromId;
    private Guid _toId;
    private bool _busy;
    private bool _unavailable;
    private CompareResult? _result;

    protected override async Task OnInitializedAsync()
    {
        // No address, no version list — and SAY so. Returning quietly left the dialog looking operable: two
        // pickers bound to Guid, holding the default, which MudSelect renders literally as "00000000-0000-…".
        // A user reads that as the app having lost the document, not as a caller having forgotten a parameter.
        if (VersionsHref is null)
        {
            _unavailable = true;
            return;
        }

        var resp = await Http.GetFromJsonAsync<VersionListResponse>(VersionsHref);
        _compareHref = resp?.Links?.FirstOrDefault(l => l.Rel == "compare")?.Href.TrimStart('/');
        _versions = (resp?.Versions ?? [])
            .Where(v => v.Status == "Confirmed")
            .OrderByDescending(v => v.VersionNumber ?? 0)
            .Select(v => new VersionInfo(v.Id, v.VersionNumber ?? 0))
            .ToList();
        if (_versions.Count >= 2)
        {
            _toId = _versions[0].Id;      // latest
            _fromId = _versions[1].Id;    // previous
        }
    }

    // Changing either picker discards the rendered diff — it belongs to the old pair, and leaving it up would
    // misattribute it to the new selection. The user re-runs with Compare.
    private void OnFromChanged(Guid id)
    {
        _fromId = id;
        _result = null;
    }

    private void OnToChanged(Guid id)
    {
        _toId = id;
        _result = null;
    }

    private async Task CompareAsync()
    {
        _busy = true;
        _result = null;
        try
        {
            if (_compareHref is null) { return; }

            // The collection advertises ONE compare address; the two versions travel as query parameters,
            // because a link names one resource and a pair has none (issue #416, resolved by reshaping the API).
            _result = await Http.GetFromJsonAsync<CompareResult>($"{_compareHref}?from={_fromId}&to={_toId}");
        }
        catch (Exception)
        {
            _result = new CompareResult { Available = false };
        }
        _busy = false;
    }

    // Restore was moved out of the compare dialog (issue #265) — "Make current" lives on the Versions dialog.

    private record VersionInfo(Guid Id, int VersionNumber);
    private record LinkDto { public string Rel { get; set; } = ""; public string Href { get; set; } = ""; }
    private record VersionListResponse { public List<VersionResponse> Versions { get; set; } = []; public List<LinkDto> Links { get; set; } = []; }
    private record VersionResponse { public Guid Id { get; set; } public int? VersionNumber { get; set; } public string Status { get; set; } = ""; }
    private record CompareResult { public bool Available { get; set; } public string FromText { get; set; } = ""; public string ToText { get; set; } = ""; }
}
