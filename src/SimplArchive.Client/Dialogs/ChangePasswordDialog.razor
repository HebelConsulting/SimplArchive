@inject HttpClient Http
@inject ISnackbar Snackbar
@inject SimplArchive.Client.Services.ApiRoot ApiRoot

@* Self-service password change (ADR "User password management") — PUT /api/users/me/password. Requires
   the current password; the server rejects a wrong one with 400 INVALID_CURRENT_PASSWORD. *@
<MudDialog>
    <DialogContent>
        <div style="min-width: 360px;">
            <MudTextField @bind-Value="_current" Label="@Strings.Get("PwdCurrent")" InputType="InputType.Password" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" Class="mb-2" />
            <MudTextField @bind-Value="_new" Label="@Strings.Get("PwdNew")" InputType="InputType.Password" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" Class="mb-2" />
            <MudTextField @bind-Value="_confirm" Label="@Strings.Get("PwdConfirm")" InputType="InputType.Password" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true"
                          Error="@(_confirm.Length > 0 && _confirm != _new)" ErrorText="@Strings.Get("PwdMismatch")" />
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@Strings.Get("Cancel")</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync" Disabled="@(!IsValid || _busy)">@Strings.Get("DlgChangePassword")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance Dialog { get; set; } = null!;

    private string _current = "";
    private string _new = "";
    private string _confirm = "";
    private bool _busy;

    private bool IsValid => _current.Length > 0 && _new.Length > 0 && _new == _confirm;

    private async Task SaveAsync()
    {
        _busy = true;
        try
        {
            using var response = await Http.PutAsJsonAsync(await ApiRoot.RequireMeAsync("changePassword"), new { currentPassword = _current, newPassword = _new });
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add(Strings.Get("PwdChanged"), Severity.Success);
                Dialog.Close(DialogResult.Ok(true));
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.BadRequest)
            {
                Snackbar.Add(Strings.Get("PwdIncorrect"), Severity.Warning);
            }
            else
            {
                Snackbar.Add(Strings.Get("PwdChangeError"), Severity.Warning);
            }
        }
        catch (Exception)
        {
            Snackbar.Add(Strings.Get("PwdChangeError"), Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private void Cancel() => Dialog.Cancel();
}
