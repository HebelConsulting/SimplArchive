@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IDialogService DialogService

@* Everything the caller has shared, across all documents (ADR 0546, issue #385) — so a person can audit their own
   shares without hunting document by document, rather than relying on an administrator noticing later.

   A tenant admin additionally gets a picker to view somebody else's links, or a whole group's. A GROUP means
   "links created by anyone CURRENTLY in that group": membership is evaluated server-side at query time, so
   someone who leaves drops out of this view while their links keep working. *@
<MudDialog>
    <DialogContent>
        @* Wide enough for four data columns plus THREE row actions (issue #410): the row gained Go to and Show
           without the dialog growing, and Revoke — the one action somebody reaches for under time pressure, after
           a link has leaked — was the one pushed off the edge. The document name truncates instead, being the
           most compressible column: the row is identified by it, but rarely needs all of it. *@
        @* Fills the dialog rather than demanding a width from it (issue #410): the dialog is the clipping box, so
           content that insists on being wider simply overflows and the last column — Revoke — is what is lost. *@
        <div style="width:100%;">
            @if (_canViewOthers)
            {
                <div style="display:flex; gap:8px;" class="mb-3">
                    <MudSelect T="Guid" @bind-Value="_userFilter" Label="@Strings.Get("ExtLinkViewFor")"
                               Variant="Variant.Outlined" Dense="true" Class="flex-grow-1">
                        <MudSelectItem T="Guid" Value="@Guid.Empty">@Strings.Get("ExtLinkMine")</MudSelectItem>
                        @foreach (var user in _users)
                        {
                            <MudSelectItem T="Guid" Value="@user.Id">@user.DisplayName</MudSelectItem>
                        }
                    </MudSelect>
                    <MudSelect T="Guid" @bind-Value="_groupFilter" Label="@Strings.Get("UgGroup")"
                               Variant="Variant.Outlined" Dense="true" Class="flex-grow-1">
                        <MudSelectItem T="Guid" Value="@Guid.Empty">—</MudSelectItem>
                        @foreach (var group in _groups)
                        {
                            <MudSelectItem T="Guid" Value="@group.Id">@group.Name</MudSelectItem>
                        }
                    </MudSelect>
                    <MudButton Variant="Variant.Filled" OnClick="LoadAsync">@Strings.Get("SearchBtn")</MudButton>
                </div>
            }

            @if (_links.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary">@Strings.Get("ExtLinkNone")</MudText>
            }
            else
            {
                <MudSimpleTable Dense="true" Hover="true" Style="width:100%; table-layout:fixed;">
                    <thead>
                        <tr>
                            <th>@Strings.Get("ExtLinkDocument")</th>
                            <th>@Strings.Get("ExtLinkExpires")</th>
                            <th>@Strings.Get("ExtLinkAccesses")</th>
                            <th>@Strings.Get("ExtLinkCreatedBy")</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var link in _links)
                        {
                            <tr>
                                <td style="max-width:20rem; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;"
                                    title="@link.DocumentName">@link.DocumentName</td>
                                <td>@link.ExpiresAt.ToLocalTime().ToString("g")</td>
                                <td>@link.AccessCount@(link.MaxAccesses is { } max ? $" / {max}" : "")</td>
                                <td>@link.CreatedByName</td>
                                <td style="white-space:nowrap; width:1%;">
                                    @* This list spans documents, so the row is often the reader's only handle on
                                       where the thing actually lives — "Go to" is what turns it back into one. *@
                                    <MudTooltip Text="@Strings.Get("ExtLinkGoToTooltip")">
                                        <MudIconButton Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small"
                                                       aria-label="@Strings.Get("ExtLinkGoTo")" OnClick="@(() => GoTo(link))" />
                                    </MudTooltip>
                                    <MudTooltip Text="@Strings.Get("ExtLinkShowTooltip")">
                                        <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small"
                                                       aria-label="@Strings.Get("ExtLinkShow")" OnClick="@(() => ShowAsync(link))" />
                                    </MudTooltip>
                                    @* Colour-coded because it is the only destructive one of the three, and the
                                       one that matters most when it matters at all (issue #410). *@
                                    @if (RelativeHref(link.Links, "revoke") is not null)
                                    {
                                        <MudTooltip Text="@Strings.Get("ExtLinkRevoke")">
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                                           aria-label="@Strings.Get("ExtLinkRevoke")" OnClick="@(() => RevokeAsync(link))" />
                                        </MudTooltip>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Close())">@Strings.Get("Close")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    // The collection's href, as the server advertised it (ADR 0543).
    [Parameter] public string LinksHref { get; set; } = string.Empty;

    // Supplied by the caller, which already loads them for other admin surfaces — this dialog does not fetch the
    // directory itself.
    [Parameter] public List<PrincipalOption> Users { get; set; } = [];

    [Parameter] public List<PrincipalOption> Groups { get; set; } = [];

    public record PrincipalOption(Guid Id, string DisplayName, string Name);

    private readonly List<MyLinkResponse> _links = [];
    private List<PrincipalOption> _users = [];
    private List<PrincipalOption> _groups = [];
    private bool _canViewOthers;
    private Guid _userFilter;
    private Guid _groupFilter;

    protected override async Task OnInitializedAsync()
    {
        _users = Users;
        _groups = Groups;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _links.Clear();

        // A group filter wins when both are set: it is the broader question, and combining them would answer
        // neither clearly.
        var query = _groupFilter != Guid.Empty
            ? $"?groupId={_groupFilter}"
            : _userFilter != Guid.Empty ? $"?userId={_userFilter}" : "";

        try
        {
            var page = await Http.GetFromJsonAsync<MyLinkListResponse>(LinksHref + query);
            _links.AddRange(page?.ExternalLinks ?? []);
            _canViewOthers = page?.CanViewOthers ?? false;
        }
        catch (HttpRequestException)
        {
            _canViewOthers = false;
        }
    }

    private async Task RevokeAsync(MyLinkResponse link)
    {
        // The button renders only when this rel is present, so reaching here with it absent means a stale row —
        // say so rather than returning silently (#863's plain-no-op shape).
        if (RelativeHref(link.Links, "revoke") is not { } href)
        {
            Snackbar.Add(Strings.Get("ExtLinkRevokeUnavailable"), Severity.Warning);
            return;
        }

        var request = new HttpRequestMessage(HttpMethod.Delete, href);
        request.Headers.TryAddWithoutValidation("If-Match", link.Etag);
        var response = await Http.SendAsync(request);
        if (response.IsSuccessStatusCode)
        {
            await LoadAsync();
        }
        else
        {
            Snackbar.Add(Strings.Get("ExtLinkActionFailed"), Severity.Error);
        }
    }

    // The link's own details, read-only, with renewal as the one thing still open to change. Renewing lives HERE
    // rather than on the row because it is now two decisions (how long, how many) and a row-sized button cannot
    // ask for either without guessing.
    private async Task ShowAsync(MyLinkResponse link)
    {
        var parameters = new DialogParameters
        {
            {
                nameof(ExternalLinkDetailDialog.Link),
                new ExternalLinkDetailDialog.LinkView(
                    link.DocumentName, link.CreatedByName, link.ExpiresAt, link.MaxAccesses, link.AccessCount, link.Etag)
            },
            // Only offered while the link is near enough to its end to be worth renewing — the same "nearly up"
            // hint the row used to gate its Extend button on.
            { nameof(ExternalLinkDetailDialog.RenewHref), link.CanExtend ? RelativeHref(link.Links, "availability") : null },
            // Followed, never composed (ADR 0543). Absent on any tenant that has not opted into revealing a
            // link's URL, which is precisely how the dialog knows to keep saying it is not shown (issue #412).
            { nameof(ExternalLinkDetailDialog.RevealHref), RelativeHref(link.Links, "reveal-url") },
        };

        var dialog = await DialogService.ShowAsync<ExternalLinkDetailDialog>(Strings.Get("ExtLinkDetailTitle"), parameters);
        if ((await dialog.Result)?.Data is true)
        {
            // Renewed: this list is now stale in three columns at once, including the ETag every action needs.
            await LoadAsync();
        }
    }

    // Closes the dialog and hands the document back to the caller, which owns the tree and list panes. Navigating
    // is the workbench's job, not this dialog's — it has no idea what is selected behind it.
    private void GoTo(MyLinkResponse link) =>
        MudDialog.Close(DialogResult.Ok(new GoToDocument(link.DocumentId, link.ParentId)));

    public record GoToDocument(Guid DocumentId, Guid? ParentId);

    private static string? RelativeHref(List<LinkResponse>? links, string rel)
    {
        // Null still means "no such rel" -- ADR 0543's "not available to you, here, now", which is what the
        // callers gate their affordances on. An href that is PRESENT but empty is not followable either, so it
        // reads as absent rather than as a link to the base address.
        var href = links?.FirstOrDefault(l => l.Rel == rel)?.Href;
        return string.IsNullOrEmpty(href) ? null : href.TrimStart('/');
    }

    private record MyLinkListResponse
    {
        public List<MyLinkResponse> ExternalLinks { get; set; } = [];
        public bool CanViewOthers { get; set; }
    }

    private record MyLinkResponse
    {
        public Guid Id { get; set; }
        public Guid DocumentId { get; set; }
        public string DocumentName { get; set; } = string.Empty;
        public DateTimeOffset ExpiresAt { get; set; }
        public int? MaxAccesses { get; set; }
        public int AccessCount { get; set; }
        public string CreatedByName { get; set; } = string.Empty;
        // The document's folder, so "Go to" can open it and select the row inside — data, not a URL to follow.
        public Guid? ParentId { get; set; }
        public bool CanExtend { get; set; }
        public string Etag { get; set; } = string.Empty;
        public List<LinkResponse> Links { get; set; } = [];
    }
}
