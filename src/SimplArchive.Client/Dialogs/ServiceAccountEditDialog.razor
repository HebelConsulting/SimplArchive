@* Edit an existing service account's name + rights (ADR 0534) → PUT /api/service-accounts/{id}. The API caps
   rights the caller can't grant (403); this dialog just collects the intended state and returns it. Admin
   surface — plain English labels, matching ServiceAccountsDialog. *@
<MudDialog>
    <DialogContent>
        <div style="min-width: 420px; max-width: 560px;">
            <MudTextField T="string" @bind-Value="_name" Label="Name" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />
            <MudText Typo="Typo.body2" Class="mb-1 mud-text-secondary">Rights</MudText>
            <div style="display:flex; gap:14px; flex-wrap:wrap;">
                @foreach (var r in _rightDefs)
                {
                    <MudCheckBox T="bool" Value="_rights[r.Key]" ValueChanged="@(v => _rights[r.Key] = v)" Dense="true" Size="Size.Small" Label="@r.Label" />
                }
            </div>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => Dialog.Cancel()">@Strings.Get("Cancel")</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@string.IsNullOrWhiteSpace(_name)" OnClick="Save">@Strings.Get("Save")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = null!;

    [Parameter] public string Name { get; set; } = "";
    [Parameter] public bool CanManageRepositories { get; set; }
    [Parameter] public bool CanManageMasks { get; set; }
    [Parameter] public bool CanManageServiceAccounts { get; set; }
    [Parameter] public bool CanImport { get; set; }
    [Parameter] public bool CanExport { get; set; }

    private string _name = "";
    private readonly Dictionary<string, bool> _rights = new();

    private sealed record RightDef(string Key, string Label);

    private static readonly RightDef[] _rightDefs =
    [
        new("canExport", "Export"),
        new("canImport", "Import"),
        new("canManageRepositories", "Manage repositories"),
        new("canManageMasks", "Manage masks"),
        new("canManageServiceAccounts", "Manage service accounts"),
    ];

    protected override void OnInitialized()
    {
        _name = Name;
        _rights["canExport"] = CanExport;
        _rights["canImport"] = CanImport;
        _rights["canManageRepositories"] = CanManageRepositories;
        _rights["canManageMasks"] = CanManageMasks;
        _rights["canManageServiceAccounts"] = CanManageServiceAccounts;
    }

    // Return the intended name + rights as the PUT body; the parent posts it.
    private void Save()
    {
        var body = new Dictionary<string, object> { ["name"] = _name.Trim() };
        foreach (var (k, v) in _rights) { body[k] = v; }
        Dialog.Close(DialogResult.Ok(body));
    }
}
