@inject IDialogService DialogService

@* Sort the pages of a staged intray item (#487, ADR 0575) — the web half of the desktop's SortPagesDialog,
   which is the canonical one (ADR 0511). Returns the chosen order as 1-based ORIGINAL page numbers.

   Deliberately dumb, exactly like its desktop twin: it is handed the page pictures and hands back an order.
   It does not call the Api and cannot half-apply anything — the single request that rewrites the file happens
   after it closes.

   Reordering is selection-plus-buttons rather than drag. Drag is the obvious gesture and worth adding, but it
   must not be the ONLY one: a tap-then-move path works on touch, where there is no hover to discover a drag
   handle with, and it is what a Playwright test can drive. *@

<MudDialog>
    <DialogContent>
        <div style="min-width: 620px; max-width: 78vw;">
            <MudText Typo="Typo.body2" Class="mb-2 mud-text-secondary">
                @string.Format(Strings.Get("IntraySortPrompt"), ItemName, _pages.Count)
            </MudText>

            @* The tiles carry the page each STARTED as — the position is already visible from where the tile
               sits, while "which page is this" is what the user tracks as they move things around. *@
            <div style="display:flex; flex-wrap:wrap; gap:8px; max-height:52vh; overflow-y:auto; padding:4px;">
                @foreach (var tile in _pages)
                {
                    var selected = tile == _selected;
                    <div @onclick="@(() => _selected = tile)"
                         data-page="@tile.OriginalNumber"
                         class="@(selected ? "wb-page-tile wb-page-tile-on" : "wb-page-tile")"
                         style="width:130px; cursor:pointer; border:2px solid @(selected ? "var(--mud-palette-primary)" : "transparent"); border-radius:4px; padding:4px;">
                        @* The bin sits ON the page it removes rather than in the toolbar: a delete that acts on
                           "the selection" is one the user has to double-check before pressing (#487). *@
                        <div style="position:relative; height:150px; background:#fff; border:1px solid var(--mud-palette-lines-default); display:flex; align-items:center; justify-content:center; overflow:hidden;">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                           Style="position:absolute; top:2px; right:2px; background:rgba(255,255,255,0.85);"
                                           title="@Strings.Get("IntrayPageRemove")"
                                           OnClick="@(() => Remove(tile))" data-remove="@tile.OriginalNumber" />
                            @if (tile.Image is { Length: > 0 })
                            {
                                @* The turn shows immediately, or the user cannot tell whether the click
                                   registered (#522). A quarter-turned portrait must re-fit the box, so the
                                   constraints swap axes with the turn. *@
                                <img src="@tile.Image" alt="@tile.OriginalNumber"
                                     style="@(tile.RotationDegrees is 90 or 270
                                              ? $"max-width:146px; max-height:126px; transform:rotate({tile.RotationDegrees}deg);"
                                              : $"max-width:100%; max-height:100%; transform:rotate({tile.RotationDegrees}deg);")" />
                            }
                            else
                            {
                                <MudText Typo="Typo.h6" Class="mud-text-secondary">@tile.OriginalNumber</MudText>
                            }
                        </div>
                        @* The turn controls sit UNDER the page they turn, one per direction (#522) — the same
                           per-tile scope as the bin. *@
                        <div style="display:flex; align-items:center; justify-content:space-between;">
                            <MudIconButton Icon="@Icons.Material.Filled.RotateLeft" Size="Size.Small"
                                           title="@Strings.Get("IntrayPageRotateLeft")" data-rotate-left="@tile.OriginalNumber"
                                           OnClick="@(() => RotateLeft(tile))" />
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@tile.OriginalNumber</MudText>
                            <MudIconButton Icon="@Icons.Material.Filled.RotateRight" Size="Size.Small"
                                           title="@Strings.Get("IntrayPageRotateRight")" data-rotate-right="@tile.OriginalNumber"
                                           OnClick="@(() => RotateRight(tile))" />
                        </div>
                    </div>
                }
            </div>
        </div>
    </DialogContent>
    <DialogActions>
        @* The actions of this state, where the state is (ADR 0550). *@
        <MudButton StartIcon="@Icons.Material.Filled.ArrowBack" Disabled="@(_selected is null)" OnClick="MoveEarlier">@Strings.Get("IntrayPageEarlier")</MudButton>
        <MudButton EndIcon="@Icons.Material.Filled.ArrowForward" Disabled="@(_selected is null)" OnClick="MoveLater">@Strings.Get("IntrayPageLater")</MudButton>
        <MudButton OnClick="Reverse">@Strings.Get("IntrayPagesReverse")</MudButton>
        @if (_removed > 0)
        {
            <MudText Typo="Typo.caption" Color="Color.Error" Class="ml-2">
                @string.Format(Strings.Get("IntrayPagesRemovedCount"), _removed)
            </MudText>
        }
        <MudSpacer />
        <MudButton OnClick="@(() => Dialog.Cancel())">@Strings.Get("Cancel")</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Apply">@Strings.Get("IntrayPagesApply")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance Dialog { get; set; } = null!;

    /// <summary>The item whose pages these are — shown in the prompt.</summary>
    [Parameter]
    public string ItemName { get; set; } = string.Empty;

    /// <summary>One data-URL per page, in page order. Empty entries render as a bare page number.</summary>
    [Parameter]
    public IReadOnlyList<string> PageImages { get; set; } = [];

    /// <summary>How many pages the item has, when no images could be produced.</summary>
    [Parameter]
    public int PageCount { get; set; }

    private sealed class Page(int originalNumber, string? image)
    {
        public int OriginalNumber { get; } = originalNumber;

        public string? Image { get; } = image;

        /// <summary>Clockwise degrees the user turned this page by (#522) — preview state until Apply.</summary>
        public int RotationDegrees { get; set; }
    }

    /// <summary>What Apply hands back: the whole arrangement, written by ONE request after the dialog closes.</summary>
    public sealed record Result(IReadOnlyList<int> Order, IReadOnlyDictionary<int, int> Rotations);

    private readonly List<Page> _pages = [];
    private Page? _selected;
    private int _removed;

    protected override void OnInitialized()
    {
        // Pictures when we have them, numbers when we do not: a thumbnail is a convenience, and losing it must
        // not cost the user the ability to reorder at all.
        var count = PageImages.Count > 0 ? PageImages.Count : PageCount;
        for (var i = 0; i < count; i++)
        {
            _pages.Add(new Page(i + 1, i < PageImages.Count ? PageImages[i] : null));
        }

        _selected = _pages.FirstOrDefault();
    }

    private void RotateLeft(Page tile) => tile.RotationDegrees = (tile.RotationDegrees + 270) % 360;

    private void RotateRight(Page tile) => tile.RotationDegrees = (tile.RotationDegrees + 90) % 360;

    private void MoveEarlier() => Move(-1);

    private void MoveLater() => Move(+1);

    // The selection stays with the PAGE, not the slot — see ListOrder.Move, which both reorder dialogs share.
    private void Move(int delta)
    {
        if (_selected is { } page)
        {
            SimplArchive.Client.Services.ListOrder.Move(_pages, _pages.IndexOf(page), delta);
        }
    }

    private void Reverse()
    {
        _pages.Reverse();
        _selected = _pages.FirstOrDefault();
    }

    /// <summary>
    /// Removes a page from the result — applied only when the dialog is, so cancelling costs nothing and the
    /// count of what will be lost stays visible until then.
    /// </summary>
    private void Remove(Page tile)
    {
        if (_pages.Count <= 1)
        {
            return; // the last page cannot be removed: an empty document is not a sort
        }

        var index = _pages.IndexOf(tile);
        _pages.Remove(tile);
        _removed++;
        _selected = _pages[Math.Min(index, _pages.Count - 1)];
    }

    // The confirm exists because this deletion is in place and has nothing to undo it. Only when pages were
    // actually removed — a pure reorder needs no ceremony.
    private async Task Apply()
    {
        if (_removed > 0)
        {
            var confirmed = await DialogService.ShowMessageBoxAsync(new MessageBoxOptions
            {
                Title = Strings.Get("IntraySortTitle"),
                Message = string.Format(Strings.Get("IntrayPagesRemoveConfirm"), _removed),
                YesText = Strings.Get("IntrayPagesApply"),
                CancelText = Strings.Get("Cancel"),
            });

            if (confirmed != true)
            {
                return;
            }
        }

        Dialog.Close(DialogResult.Ok(new Result(
            _pages.Select(p => p.OriginalNumber).ToList(),
            _pages.Where(p => p.RotationDegrees != 0).ToDictionary(p => p.OriginalNumber, p => p.RotationDegrees))));
    }
}
