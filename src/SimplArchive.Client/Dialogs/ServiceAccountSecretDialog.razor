@inject IJSRuntime JS
@inject ISnackbar Snackbar

@* Shows a service account's client_id + one-time client_secret after create/rotate (ADR 0534) — the secret is
   never retrievable again (OpenIddict stores it hashed), so the admin copies it now. Mirrors
   GeneratedPasswordDialog's copy-once pattern. *@
<MudDialog>
    <DialogContent>
        <div style="min-width: 420px;">
            <MudText Typo="Typo.body2" Class="mb-3">
                Service account @Verb. Copy the client secret now — it can't be retrieved again.
            </MudText>
            <MudTextField T="string" Label="Client ID" Value="@ClientId" ReadOnly="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                          Class="mb-2" Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.ContentCopy"
                          OnAdornmentClick="@(() => CopyAsync(ClientId))" />
            <MudTextField T="string" Label="Client secret" Value="@ClientSecret" ReadOnly="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                          Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.ContentCopy"
                          OnAdornmentClick="@(() => CopyAsync(ClientSecret))" />
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Close">@Strings.Get("Done")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance Dialog { get; set; } = null!;

    [Parameter] public string ClientId { get; set; } = "";
    [Parameter] public string ClientSecret { get; set; } = "";
    [Parameter] public string Verb { get; set; } = "created";

    private async Task CopyAsync(string value)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", value);
            Snackbar.Add(Strings.Get("CopiedClipboard"), Severity.Info);
        }
        catch (Exception)
        {
            // Clipboard blocked — the value is still shown for manual copy.
        }
    }

    private void Close() => Dialog.Close();
}
