@using SimplArchive.Presentation
@inject SimplArchive.Client.Services.ApiRoot ApiRoot
@inject SimplArchive.Client.Services.BrowseService Browse
@inject HttpClient Http

@* Folder picker for Move / Place-reference targets (real folders only, no references) — see ADR
   "Web client move/reference/search UI". Returns the chosen folder id. *@
<MudDialog>
    <DialogContent>
        <div style="min-width: 380px; height: 360px; overflow: auto;">
            @if (_loading)
            {
                <MudProgressCircular Indeterminate="true" Size="Size.Small" />
            }
            else if (_roots.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary">@Strings.Get("NoFoldersAvailable")</MudText>
            }
            else
            {
                <MudTreeView T="PickNode" Items="_roots" ServerData="LoadChildrenAsync" Hover="true" Dense="true">
                    <ItemTemplate Context="item">
                        @* A root that is not itself a target is dimmed, so that reads before the click
                           rather than after it (ADR 0689). *@
                        <MudTreeViewItem Value="@item.Value" Text="@item.Text" Icon="@Icons.Material.Filled.Folder"
                                         Style="@(item.Value is { Selectable: false } ? "opacity:.55;" : null)"
                                         CanExpand="@item.Expandable" Items="@item.Children"
                                         OnClick="@(() => _selected = item.Value)" />
                    </ItemTemplate>
                </MudTreeView>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudText Typo="Typo.caption" Class="mud-text-secondary mr-auto ml-2">
            @(_selected is { } s ? string.Format(Strings.Get("FolderPickerSelected"), s.Name) : Strings.Get("FolderPickerSelectPrompt"))
        </MudText>
        <MudButton OnClick="Cancel">@Strings.Get("Cancel")</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@(_selected is null or { Selectable: false })" OnClick="Select">@Strings.Get("FolderPickerConfirm")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance Dialog { get; set; } = null!;

    private IReadOnlyCollection<TreeItemData<PickNode>> _roots = [];
    private PickNode? _selected;
    private bool _loading = true;

    // ChildrenHref is the row's own `children` rel — the tree walks by following it, so no level of this
    // picker composes /documents/{id}/children from an id (ADR 0543, issue #416).
    private record PickNode(Guid Id, string Name, bool HasSubfolders, string? ChildrenHref = null, bool Selectable = true);

    protected override async Task OnInitializedAsync()
    {
        var shared = new List<PickNode>();
        var url = await ApiRoot.RequireAsync("repositories");
        while (url is not null)
        {
            var page = await Http.GetFromJsonAsync<ListResponse>(url);
            foreach (var r in page?.Repositories ?? [])
            {
                shared.Add(new PickNode(r.Id, r.Name, r.HasSubfolders, Rel(r.Links, "children"), r.CanCreateChildren));
            }
            url = Next(page?.Links);
        }

        // The personal space, which GET /repositories deliberately excludes — so a picker built on that listing
        // alone offered every shared repository and silently omitted the user's own (ADR 0689). Always
        // expandable: what a user wants is one of the folders inside it.
        var personal = await Browse.EnsurePersonalRepositoryAsync();
        var personalNode = personal is null
            ? null
            : new PickNode(personal.Id, personal.Name, true, Rel(personal.Links, "children"));

        // Composed by the shared rule, and the SELECTABILITY comes from it too rather than being restated here:
        // the personal root is a place to go into, not a place to put something (#634).
        _roots = [.. FilingRoots.Compose(personalNode, shared, n => n.Name)
            // Both reasons must hold: FilingRoots excludes a personal space's own root (ADR 0689), and
            // the row's `canCreateChildren` says whether the server would accept a document here (ADR 0543).
            .Select(root => ToItem(root.Node with { Selectable = root.Selectable && root.Node.Selectable }))];
        _loading = false;
    }

    // Real child folders only (no references) — a move/reference target is a real folder.
    private async Task<IReadOnlyCollection<TreeItemData<PickNode>>> LoadChildrenAsync(PickNode node)
    {
        var children = new List<TreeItemData<PickNode>>();
        var url = node.ChildrenHref;
        while (url is not null)
        {
            var page = await Http.GetFromJsonAsync<ChildrenResponse>(url);
            foreach (var c in (page?.Children ?? []).Where(c => !c.HasVersions))
            {
                children.Add(ToItem(new PickNode(c.Id, c.Name, c.HasSubfolders, Rel(c.Links, "children"), c.CanCreateChildren)));
            }
            url = Next(page?.Links);
        }
        return children;
    }


    private static TreeItemData<PickNode> ToItem(PickNode n) => new() { Value = n, Text = n.Name, Expandable = n.HasSubfolders };

    private void Select()
    {
        if (_selected is { } s)
        {
            Dialog.Close(DialogResult.Ok(s.Id));
        }
    }

    private void Cancel() => Dialog.Cancel();

    /// <summary>The same normalisation for the shared link shape the personal-repository resource uses.</summary>
    private static string? Rel(List<SimplArchive.Client.Hypermedia.LinkResponse>? links, string rel)
    {
        var href = SimplArchive.Client.Hypermedia.Links.Href(links, rel);
        return href is null ? null : (href.StartsWith("http") ? href : href.TrimStart('/'));
    }

    private static string? Rel(List<Link>? links, string rel)
    {
        var href = links?.FirstOrDefault(l => l.Rel == rel)?.Href;
        return href is null ? null : (href.StartsWith("http") ? href : href.TrimStart('/'));
    }

    private static string? Next(List<Link>? links)
    {
        var href = links?.FirstOrDefault(l => l.Rel == "next")?.Href;
        return href is null ? null : (href.StartsWith("http") ? href : href.TrimStart('/'));
    }

    private record Link { public string Rel { get; set; } = string.Empty; public string Href { get; set; } = string.Empty; }
    private record ListResponse { public List<Repo> Repositories { get; set; } = []; public List<Link> Links { get; set; } = []; }
    private record Repo { public Guid Id { get; set; } public string Name { get; set; } = string.Empty; public bool HasSubfolders { get; set; } public bool CanCreateChildren { get; set; } public List<Link> Links { get; set; } = []; }
    private record ChildrenResponse { public List<Child> Children { get; set; } = []; public List<Link> Links { get; set; } = []; }
    private record Child { public Guid Id { get; set; } public string Name { get; set; } = string.Empty; public bool HasVersions { get; set; } public bool HasSubfolders { get; set; } public bool CanCreateChildren { get; set; } public List<Link> Links { get; set; } = []; }
}
