@using SimplArchive.Client.Components
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject SimplArchive.Client.Services.ApiRoot ApiRoot

@* Profile-photo picker: a dialog around the ProfilePhotoEditor component (which owns the picture and the crop),
   adding Save — the crop is rasterized to a 256×256 PNG and PUT to the target (self = the me resource's `photo`
   rel, or a specific user for an admin).

   Since #464 the caller's OWN photo is normally changed inside the "Edit profile" dialog, which hosts the same
   editor inline. This dialog stays for the admin path — setting another principal's photo from their row in
   Users & groups — where a standalone modal is the right shape. *@
<MudDialog>
    <DialogContent>
        <ProfilePhotoEditor @ref="_editor" OnImageChanged="StateHasChanged" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@Strings.Get("Cancel")</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync" Disabled="@(_editor?.HasImage != true || _busy)">@Strings.Get("Save")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance Dialog { get; set; } = null!;

    // null = the current user (the me resource's `photo` rel); set = that user (admin, followed from that
    // user's row — issue #416).
    [Parameter] public string? PhotoHref { get; set; }

    private ProfilePhotoEditor? _editor;
    private bool _busy;

    // A method, not a property: following the "photo" rel is a lookup that may have to fetch the me
    // resource first, and a property cannot await. Both sides are rels — the caller's own from the me
    // resource, another user's handed in from that user's row (issue #416).
    private async Task<string> PutUrlAsync() =>
        PhotoHref ?? await ApiRoot.RequireMeAsync("photo");

    private async Task SaveAsync()
    {
        if (_editor is null)
        {
            return;
        }

        _busy = true;
        try
        {
            var base64 = await _editor.CroppedPngAsync();
            if (string.IsNullOrEmpty(base64))
            {
                return;
            }

            using var response = await ProfilePhotoUpload.PutAsync(Http, await PutUrlAsync(), base64);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add(Strings.Get("PhotoUpdated"), Severity.Success);
                Dialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add(response.StatusCode == System.Net.HttpStatusCode.Forbidden ? Strings.Get("NoPermission") : Strings.Get("PhotoSaveError"), Severity.Warning);
            }
        }
        catch (Exception)
        {
            Snackbar.Add(Strings.Get("PhotoSaveError"), Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private void Cancel() => Dialog.Cancel();
}
