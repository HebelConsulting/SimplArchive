@inject IJSRuntime JS
@inject ISnackbar Snackbar

@* Shows an admin-reset generated password once (ADR "User password management") — it isn't retrievable
   again. The admin copies it and hands it to the user. *@
<MudDialog>
    <DialogContent>
        <div style="min-width: 380px;">
            <MudText Typo="Typo.body2" Class="mb-2">
                @((MarkupString)string.Format(Strings.Get("GenPwdInfo"), UserName))
            </MudText>
            <MudTextField T="string" Value="@Password" ReadOnly="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                          Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.ContentCopy" OnAdornmentClick="CopyAsync" />
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Close">@Strings.Get("Done")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance Dialog { get; set; } = null!;

    [Parameter] public string Password { get; set; } = string.Empty;
    [Parameter] public string UserName { get; set; } = string.Empty;

    private async Task CopyAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", Password);
            Snackbar.Add(Strings.Get("CopiedClipboard"), Severity.Info);
        }
        catch (Exception)
        {
            // Clipboard blocked — the value is still shown for manual copy.
        }
    }

    private void Close() => Dialog.Close();
}
