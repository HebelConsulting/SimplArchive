@inject IJSRuntime JS
@inject ISnackbar Snackbar

@* Shows an admin-reset generated password once (ADR "User password management") — it isn't retrievable
   again. The admin copies it and hands it to the user. *@
<MudDialog>
    <DialogContent>
        <div style="min-width: 380px;">
            <MudText Typo="Typo.body2" Class="mb-2">
                @if (Intro is { Length: > 0 } intro)
                {
                    @intro
                }
                else
                {
                    @((MarkupString)string.Format(Strings.Get("GenPwdInfo"), UserName))
                }
            </MudText>
            <MudTextField T="string" Value="@Password" ReadOnly="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                          Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.ContentCopy" OnAdornmentClick="CopyAsync" />
            @if (ScanImage is { Length: > 0 } scanImage)
            {
                <MudText Typo="Typo.body2" Class="mt-3 mb-1">@Strings.Get("RevealOnceScanHint")</MudText>
                <img class="reveal-scan" src="@scanImage" alt="@Strings.Get("RevealOnceScanAlt")" width="200" height="200" />
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Close">@Strings.Get("Done")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance Dialog { get; set; } = null!;

    [Parameter] public string Password { get; set; } = string.Empty;
    [Parameter] public string UserName { get; set; } = string.Empty;

    /// <summary>
    /// Replaces the password wording for any other value shown once — a module's revealed credential (#1628,
    /// ABI 1.8) — as the desktop's dialog does. Plain text, never markup: the module composed the label.
    /// </summary>
    [Parameter] public string? Intro { get; set; }

    /// <summary>The value's scan address drawn as a QR code by the core (a PNG data URL; ABI 1.13, ADR 0913), or null.</summary>
    [Parameter] public string? ScanImage { get; set; }

    private async Task CopyAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", Password);
            Snackbar.Add(Strings.Get("CopiedClipboard"), Severity.Info);
        }
        catch (Exception)
        {
            // Clipboard blocked — the value is still shown for manual copy.
        }
    }

    private void Close() => Dialog.Close();
}
