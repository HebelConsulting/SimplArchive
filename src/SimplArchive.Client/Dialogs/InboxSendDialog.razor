@* Send an own inbox item to another inbox (ADR 0532): pick one destination — a group the caller belongs to
   (from /api/inbox/groups) or any other user in the tenant (from /api/inbox/users) — and return the chosen
   target. The controller enforces "exactly one target"; this dialog offers a single-select so only one can win. *@
@inject HttpClient Http

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@Strings.Get("InboxSendTitle")</MudText>
    </TitleContent>
    <DialogContent>
        <div style="min-width: 360px;">
            <MudText Typo="Typo.body2" Class="mb-3">@string.Format(Strings.Get("InboxSendPrompt"), ItemName)</MudText>
            @if (_loading)
            {
                <MudProgressCircular Indeterminate="true" Size="Size.Small" />
            }
            else if (_groups.Count == 0 && _users.Count == 0)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">@Strings.Get("InboxSendEmpty")</MudText>
            }
            else
            {
                <MudSelect T="string" @bind-Value="_selected" Label="@Strings.Get("InboxDestination")"
                           Dense="true" Variant="Variant.Outlined">
                    @foreach (var g in _groups)
                    {
                        <MudSelectItem Value="@($"g:{g.Id}")">@Strings.Get("InboxGroupTag") · @g.Name</MudSelectItem>
                    }
                    @foreach (var u in _users)
                    {
                        <MudSelectItem Value="@($"u:{u.Id}")">@Strings.Get("InboxUserTag") · @u.Name</MudSelectItem>
                    }
                </MudSelect>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@Strings.Get("Cancel")</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   Disabled="@string.IsNullOrEmpty(_selected)" OnClick="Send">@Strings.Get("InboxSend")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance Dialog { get; set; } = null!;

    [Parameter] public string ItemName { get; set; } = "";

    // Exactly one of the two is non-null — the controller rejects anything else (InboxMoveTargetRequiredException).
    public record SendTarget(Guid? TargetGroupId, Guid? TargetUserId);

    private bool _loading = true;
    private string? _selected;
    private List<Option> _groups = [];
    private List<Option> _users = [];

    private sealed record Option(Guid Id, string Name);
    private sealed class GroupsResponse { public List<Option> Groups { get; set; } = []; }
    private sealed class UsersResponse { public List<Option> Users { get; set; } = []; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _groups = (await Http.GetFromJsonAsync<GroupsResponse>("api/inbox/groups"))?.Groups ?? [];
            _users = (await Http.GetFromJsonAsync<UsersResponse>("api/inbox/users"))?.Users ?? [];
        }
        catch (Exception)
        {
            // Leave the lists empty — the dialog shows the "nothing available" hint.
        }

        _loading = false;
    }

    private void Send()
    {
        if (string.IsNullOrEmpty(_selected))
        {
            return;
        }

        var id = Guid.Parse(_selected[2..]);
        var target = _selected[0] == 'g' ? new SendTarget(id, null) : new SendTarget(null, id);
        Dialog.Close(DialogResult.Ok(target));
    }

    private void Cancel() => Dialog.Cancel();
}
