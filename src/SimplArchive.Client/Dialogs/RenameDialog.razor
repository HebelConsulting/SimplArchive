@* Name dialog, pre-filled with the current name — see ADR "Web client rename/delete/recycle-bin".
   Returns the trimmed name, or cancels.

   Also serves the plain "give this a name" prompts (a new section, #564), which is why the confirm button
   takes its label from a parameter: a create whose button says "Rename" is a small lie the user reads before
   they read anything else. Defaults to Rename, so every existing caller is unchanged. *@
<MudDialog>
    <DialogContent>
        <MudTextField @bind-Value="_name" Label="@Strings.Get("Name")" Variant="Variant.Outlined" Immediate="true"
                      AutoFocus="true" OnKeyDown="OnKeyDown" Style="min-width: 360px;" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@Strings.Get("Cancel")</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@string.IsNullOrWhiteSpace(_name)" OnClick="Save">@Strings.Get(ConfirmLabelKey)</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance Dialog { get; set; } = null!;

    [Parameter] public string CurrentName { get; set; } = "";

    /// <summary>Localisation key for the confirm button — "Rename" unless the caller is creating something.</summary>
    [Parameter] public string ConfirmLabelKey { get; set; } = "RibbonRename";

    private string _name = "";

    protected override void OnInitialized() => _name = CurrentName;

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_name))
        {
            Save();
        }
    }

    private void Save() => Dialog.Close(DialogResult.Ok(_name.Trim()));

    private void Cancel() => Dialog.Cancel();
}
