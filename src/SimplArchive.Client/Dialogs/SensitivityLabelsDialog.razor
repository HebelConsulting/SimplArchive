@inject SimplArchive.Client.Services.ApiRoot ApiRoot
@* Manage the tenant's configurable sensitivity labels (ADR "Configurable sensitivity labels + upload defaults").
   Create / rename / recolour / toggle-watermark / retire — gated on CanManageClassification (the API enforces).
   Calls the API directly; closes with no result (the caller reloads its label list on close). *@
@inject HttpClient Http
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <div style="min-width: 560px; max-width: 640px;">
            <MudText Typo="Typo.body2" Class="mb-2 mud-text-secondary">
                @Strings.Get("SensLabelsInfo")
            </MudText>

            <div style="display:flex; gap:8px; align-items:center; margin-bottom:12px;">
                <MudTextField T="string" @bind-Value="_newName" Placeholder="@Strings.Get("SensNewLabel")" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:180px;" />
                <MudTextField T="string" @bind-Value="_newColor" Placeholder="#RRGGBB" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:110px;" />
                <MudNumericField T="int" @bind-Value="_newRank" Label="@Strings.Get("SensRank")" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:80px;" />
                <MudCheckBox T="bool" @bind-Value="_newWatermark" Label="@Strings.Get("SensWm")" Dense="true" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="CreateAsync">@Strings.Get("Add")</MudButton>
            </div>

            <MudSimpleTable Dense="true" Hover="true">
                <thead><tr><th>@Strings.Get("SensColLabel")</th><th style="width:70px;">@Strings.Get("SensRank")</th><th style="width:100px;">@Strings.Get("AnnotationColour")</th><th style="width:70px;">@Strings.Get("SensWm")</th><th style="width:150px;">@Strings.Get("VerColActions")</th></tr></thead>
                <tbody>
                    @foreach (var l in _labels.OrderBy(x => x.Rank).ThenBy(x => x.Name))
                    {
                        <tr style="@(l.Retired ? "opacity:.5;" : "")">
                            <td><MudChip T="string" Size="Size.Small" Style="@ChipStyle(l.Color)">@l.Name</MudChip></td>
                            <td>@l.Rank</td>
                            <td>@(l.Color ?? "—")</td>
                            <td>@(l.Watermark ? "✓" : "")</td>
                            <td>
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" title="Edit" OnClick="@(() => EditAsync(l))" />
                                @if (l.Retired)
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Undo" Size="Size.Small" title="Un-retire" OnClick="@(() => UnretireAsync(l))" />
                                }
                                else
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Archive" Size="Size.Small" Color="Color.Warning" title="Retire" OnClick="@(() => RetireAsync(l))" />
                                }
                            </td>
                        </tr>
                    }
                    @if (_labels.Count == 0)
                    {
                        <tr><td colspan="5" class="mud-text-secondary">@Strings.Get("SensNoLabels")</td></tr>
                    }
                </tbody>
            </MudSimpleTable>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => Dialog.Close())">@Strings.Get("Close")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance Dialog { get; set; } = null!;

    private List<LabelDto> _labels = [];
    private string _newName = string.Empty;
    private string _newColor = string.Empty;
    private int _newRank = 1;
    private bool _newWatermark;

    private sealed class LinkDto { public string Rel { get; set; } = string.Empty; public string Href { get; set; } = string.Empty; }
    private sealed class LabelDto
    {
        public Guid Id { get; set; } public string Name { get; set; } = string.Empty; public int Rank { get; set; }
        public string? Color { get; set; } public bool Watermark { get; set; } public bool Retired { get; set; }
        public List<LinkDto> Links { get; set; } = [];

        // The server says which of the two transitions this label is in; the client no longer derives it.
        public string? Href(string rel) => Links.FirstOrDefault(l => l.Rel == rel)?.Href.TrimStart('/');
    }
    private sealed class LabelsResponse { public List<LabelDto> Labels { get; set; } = []; }

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        try { _labels = (await Http.GetFromJsonAsync<LabelsResponse>(await ApiRoot.RequireAsync("sensitivityLabels")))?.Labels ?? []; }
        catch (Exception) { _labels = []; }
    }

    private static string ChipStyle(string? color) => string.IsNullOrEmpty(color) ? "" : $"background:{color}; color:#fff;";

    private async Task CreateAsync()
    {
        if (string.IsNullOrWhiteSpace(_newName)) return;
        var resp = await Http.PostAsJsonAsync(await ApiRoot.RequireAsync("sensitivityLabels"), new { name = _newName.Trim(), rank = _newRank, color = string.IsNullOrWhiteSpace(_newColor) ? null : _newColor.Trim(), watermark = _newWatermark });
        if (resp.IsSuccessStatusCode) { _newName = string.Empty; _newColor = string.Empty; _newWatermark = false; await LoadAsync(); }
        else { Snackbar.Add(Strings.Get(resp.StatusCode == System.Net.HttpStatusCode.Conflict ? "StLabelNameExists" : "StErrAddLabel"), Severity.Warning); }
    }

    private async Task EditAsync(LabelDto l)
    {
        var name = await JsPrompt("Label name:", l.Name);
        if (name is null) return;
        var color = await JsPrompt("Colour (#RRGGBB, blank for none):", l.Color ?? "");
        var rankStr = await JsPrompt("Rank (severity):", l.Rank.ToString());
        var wm = await JsConfirm($"Watermark documents labelled '{name}'?");
        var rank = int.TryParse(rankStr, out var r) ? r : l.Rank;
        var resp = await Http.PutAsJsonAsync(l.Href("self")!, new { name = name.Trim(), rank, color = string.IsNullOrWhiteSpace(color) ? null : color!.Trim(), watermark = wm });
        if (resp.IsSuccessStatusCode) { await LoadAsync(); }
        else { Snackbar.Add(Strings.Get(resp.StatusCode == System.Net.HttpStatusCode.Conflict ? "StLabelNameExists" : "StErrUpdateLabel"), Severity.Warning); }
    }

    private async Task RetireAsync(LabelDto l)
    {
        if (l.Href("retire") is not { } href) return;
        if (!await JsConfirm($"Retire '{l.Name}'? It stays on existing documents but won't be offered.")) return;
        (await Http.DeleteAsync(href)).EnsureSuccessStatusCode();
        await LoadAsync();
    }

    private async Task UnretireAsync(LabelDto l)
    {
        if (l.Href("unretire") is not { } href) return;
        (await Http.PostAsync(href, null)).EnsureSuccessStatusCode();
        await LoadAsync();
    }

    [Inject] private IJSRuntime JS { get; set; } = null!;
    private async Task<string?> JsPrompt(string message, string value) => await JS.InvokeAsync<string?>("prompt", message, value);
    private async Task<bool> JsConfirm(string message) => await JS.InvokeAsync<bool>("confirm", message);
}
