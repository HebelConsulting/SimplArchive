@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject SimplArchive.Client.Services.ExternalLinksClient Links

@* External links for one document (ADR 0546, issue #385): create a link, see the live ones, extend or revoke.
   Interactive — does its own API calls.

   The created URL is shown ONCE and never again: the token is a live credential, so the list endpoint
   deliberately does not return it. That is why the newly-created link gets its own prominent block with a copy
   button rather than simply appearing in the list below. *@
<MudDialog>
    <DialogContent>
        <div style="min-width: 520px;">
            <MudText Typo="Typo.subtitle2" Class="mb-2">@DocumentName</MudText>

            @if (!_allowed)
            {
                <MudAlert Severity="Severity.Info" Dense="true">@Strings.Get("ExtLinkDisabled")</MudAlert>
            }
            else
            {
                @if (_createdUrl is not null)
                {
                    <MudAlert Severity="Severity.Success" Dense="true" Class="mb-2">
                        @Strings.Get("ExtLinkShownOnce")
                    </MudAlert>
                    <div style="display:flex; align-items:center; gap:8px;" class="mb-3">
                        <MudTextField Value="@_createdUrl" ReadOnly="true" Variant="Variant.Outlined"
                                      Label="@Strings.Get("ExtLinkUrl")" Class="flex-grow-1" />
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CopyAsync">@Strings.Get("ExtLinkCopy")</MudButton>
                    </div>
                }

                @if (_links.Count == 0)
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">@Strings.Get("ExtLinkNone")</MudText>
                }
                else
                {
                    <MudList T="string" Dense="true" Class="mb-1">
                        @foreach (var link in _links)
                        {
                            <MudListItem T="string">
                                <div style="display:flex; align-items:center; gap:8px;">
                                    <MudIcon Icon="@Icons.Material.Filled.Link" Size="Size.Small" />
                                    <div style="flex:1 1 auto; min-width:0;">
                                        <div>@Strings.Get("ExtLinkExpires"): @link.ExpiresAt.InZone(SessionTimeZone.Current).ToString("g")</div>
                                        <div class="mud-text-secondary" style="font-size:.8em;">
                                            @Strings.Get("ExtLinkAccesses"): @link.AccessCount@(link.MaxAccesses is { } max ? $" / {max}" : "")
                                            · @Strings.Get("ExtLinkCreatedBy"): @link.CreatedByName
                                        </div>
                                    </div>
                                    @* Extend is offered only when the link is close to running out, so it stays a
                                       renewal rather than a way to push a share indefinitely (ADR 0546). *@
                                    @if (link.CanExtend)
                                    {
                                        <MudButton Size="Size.Small" OnClick="@(() => ExtendAsync(link))">@Strings.Get("ExtLinkExtend")</MudButton>
                                    }
                                    @* Rendered only where the server offered it (#861). It was UNGATED, and its
                                       address fell back to a composed `{ListUrl}/{link.Id}` — a path-segment
                                       append onto a rel-supplied href, which ADR 0557 calls composing in
                                       disguise and which the hypermedia ratchet cannot see (#862). *@
                                    @if (RelativeHref(link.Links, "revoke") is not null)
                                    {
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                                       aria-label="@Strings.Get("ExtLinkRevoke")" OnClick="@(() => RevokeAsync(link))" />
                                    }
                                </div>
                            </MudListItem>
                        }
                    </MudList>
                    <MudDivider Class="my-2" />
                }

                @if (_canCreate)
                {
                    <MudDatePicker Editable="true" PickerVariant="PickerVariant.Dialog" @bind-Date="_expiry" Label="@Strings.Get("ExtLinkExpires")" MinDate="DateTime.Today.AddDays(1)"
                                   DateFormat="yyyy-MM-dd" Variant="Variant.Outlined" Class="mb-2" />
                    <MudNumericField T="int?" @bind-Value="_maxAccesses" Label="@Strings.Get("ExtLinkMaxAccesses")"
                                     Min="1" Variant="Variant.Outlined" />

                    @* The recipient this link's content is enveloped to (ADR 0827), matching the desktop dialog
                       (ADR 0511). Shown on EVERY tenant because the server accepts it everywhere — only its
                       requiredness follows the tier — and a field that appears and disappears with configuration
                       the sharer cannot see is worse than one that is simply optional. *@
                    @* Immediate: the helper text below describes what was pasted, and a description that only
                       appears after tabbing away is a description most people never see. It also keeps the two
                       clients the same — the desktop's TextBox updates its description on every change
                       (ADR 0511) — and the default, committing on blur, would have made the web the odd one. *@
                    <MudTextField T="string" Value="_recipientCertificatePem" Immediate="true" Lines="3" Class="mt-2"
                                  Label="@Strings.Get("ExtLinkRecipientCert")" Variant="Variant.Outlined"
                                  Placeholder="-----BEGIN CERTIFICATE-----"
                                  Required="_requiresRecipientCertificate"
                                  HelperText="@_recipientDescription"
                                  ValueChanged="@(async v => { _recipientCertificatePem = v; await DescribeRecipientAsync(); })" />
                    @if (_requiresRecipientCertificate)
                    {
                        <MudText Typo="Typo.caption">@Strings.Get("ExtLinkCertHint")</MudText>
                    }
                }
            }
        </div>
    </DialogContent>
    <DialogActions>
        @if (_allowed && _canCreate)
        {
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="CreateAsync">@Strings.Get("ExtLinkCreate")</MudButton>
        }
        <MudButton OnClick="Close">@Strings.Get("Close")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public Guid DocumentId { get; set; }

    [Parameter] public string DocumentName { get; set; } = string.Empty;

    // The href of this document's links collection, as the SERVER advertised it via the "external-links" rel
    // (ADR 0543). REQUIRED: the client does not compose this URL, and the hypermedia ledger enforces that — the
    // first draft of this dialog carried a composed fallback and the guard failed the build for it.
    [Parameter] public string LinksHref { get; set; } = string.Empty;

    private readonly List<ExternalLinkResponse> _links = [];
    private bool _canCreate;
    private bool _requiresRecipientCertificate;
    private string? _recipientCertificatePem;
    private string _recipientDescription = string.Empty;
    private string? _describeCertificateUrl;
    private bool _allowed = true;
    private string? _createdUrl;
    private DateTime? _expiry = DateTime.Today.AddDays(30);
    private int? _maxAccesses;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private string ListUrl => LinksHref;

    private async Task LoadAsync()
    {
        _links.Clear();
        try
        {
            var page = await Http.GetFromJsonAsync<ExternalLinkListResponse>(ListUrl);
            _links.AddRange(page?.ExternalLinks ?? []);
            _canCreate = page?.CanCreate ?? false;
            _requiresRecipientCertificate = page?.RequiresRecipientCertificate ?? false;
            // Followed, never composed (ADR 0543) — the listing advertises where to ask.
            _describeCertificateUrl = page?.Links?
                .FirstOrDefault(l => l.Rel == "describe-certificate")?.Href;
        }
        catch (HttpRequestException)
        {
            _canCreate = false;
        }
    }

    private async Task CreateAsync()
    {
        var body = new
        {
            // SpecifyKind(Unspecified) is load-bearing, not tidying. MudDatePicker hands back a DateTime with
            // Kind=Local, and `new DateTimeOffset(local, TimeSpan.Zero)` THROWS unless the machine's own offset is
            // zero — so creating a link failed for every user outside UTC, silently (the exception is unhandled,
            // so no snackbar appeared and the dialog simply did nothing). Every test missed it because CI runs in
            // UTC. The picked value is a calendar date, which carries no zone of its own; Unspecified says exactly
            // that, and the offset below then reads it as end-of-day UTC.
            expiresAt = _expiry is { } d
                ? new DateTimeOffset(DateTime.SpecifyKind(d.Date.AddHours(23).AddMinutes(59), DateTimeKind.Unspecified), TimeSpan.Zero)
                : (DateTimeOffset?)null,
            maxAccesses = _maxAccesses,
            recipientCertificatePem = string.IsNullOrWhiteSpace(_recipientCertificatePem) ? null : _recipientCertificatePem,
        };

        // The tier's requirement, checked before the round trip — not instead of the server's refusal, which
        // stands whatever a client believes, but the difference between a field the sharer can still fill in
        // and an error about one.
        if (_requiresRecipientCertificate && string.IsNullOrWhiteSpace(_recipientCertificatePem))
        {
            Snackbar.Add(Strings.Get("ExtLinkCertRequired"), Severity.Warning);
            return;
        }

        var response = await Http.PostAsJsonAsync(ListUrl, body);
        if (!response.IsSuccessStatusCode)
        {
            // A tenant with the feature switched off answers 403 EXTERNAL_LINKS_DISABLED; anything else is a
            // genuine failure worth showing as one.
            var problem = await response.Content.ReadAsStringAsync();
            if (problem.Contains("EXTERNAL_LINKS_DISABLED", StringComparison.Ordinal))
            {
                _allowed = false;
                return;
            }

            Snackbar.Add(Strings.Get("WebDavGenError"), Severity.Error);
            return;
        }

        var created = await response.Content.ReadFromJsonAsync<ExternalLinkResponse>();
        _createdUrl = created?.Url;
        await LoadAsync();
    }

    private async Task RevokeAsync(ExternalLinkResponse link)
    {
        // No composed fallback: the button above renders only when this rel is present, so an absent one here
        // means the row went stale rather than that we should guess its address (#861).
        if (RelativeHref(link.Links, "revoke") is not { } revokeHref)
        {
            Snackbar.Add(Strings.Get("ExtLinkRevokeUnavailable"), Severity.Warning);
            return;
        }

        if (await Links.RevokeAsync(revokeHref, link.Etag))
        {
            await LoadAsync();
        }
        else
        {
            Snackbar.Add(Strings.Get("WebDavGenError"), Severity.Error);
        }
    }

    // 90 days FROM TODAY, not added onto what remains (ADR 0546).
    private async Task ExtendAsync(ExternalLinkResponse link)
    {
        // FOLLOWED, not composed (ADR 0543). This dialog used to build ".../expiry" itself, so when that route
        // became ".../availability" it went on calling a route that no longer existed — the exact failure a rel
        // exists to prevent.
        if (RelativeHref(link.Links, "availability") is not { } href)
        {
            return;
        }

        // The cap travels WITH the expiry and is re-sent as it stands: availability replaces both, and
        // omitting it would quietly turn a capped link into an unlimited one. The client takes it as a
        // required argument for that reason, so it cannot be dropped by forgetting it.
        if (await Links.RenewAsync(href, days: 90, maxAccesses: link.MaxAccesses, etag: link.Etag))
        {
            await LoadAsync();
        }
        else
        {
            Snackbar.Add(Strings.Get("ExtLinkActionFailed"), Severity.Error);
        }
    }


    private async Task CopyAsync()
    {
        if (_createdUrl is null)
        {
            return;
        }

        // One URL, no variants: opening it lands on a page offering both Open and Download, so the RECIPIENT
        // decides how to take the document. The sharer used to make that choice for them at creation time, which
        // they were never in a position to make (ADR 0546).
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", _createdUrl);
        Snackbar.Add(Strings.Get("ExtLinkCopied"), Severity.Success);
    }

    private void Close() => MudDialog.Close();

    private static string? RelativeHref(List<LinkResponse>? links, string rel)
    {
        // Null still means "no such rel" -- ADR 0543's "not available to you, here, now", which is what the
        // callers gate their affordances on. An href that is PRESENT but empty is not followable either, so it
        // reads as absent rather than as a link to the base address.
        var href = links?.FirstOrDefault(l => l.Rel == rel)?.Href;
        return string.IsNullOrEmpty(href) ? null : href.TrimStart('/');
    }

    /// <summary>
    /// Asks the server who the pasted certificate belongs to — the only check available to the sharer, since a
    /// PEM is unreadable by eye and addressing a document to the wrong key cannot be undone once the link has
    /// been sent.
    /// </summary>
    /// <remarks>
    /// <para>
    /// <b>The server answers because this runtime cannot.</b> `X509Certificate2` throws
    /// `PlatformNotSupportedException` in Blazor WASM — measured, not assumed — so there is no local parse to
    /// fall back on here. The desktop asks the same endpoint even though it COULD parse in-process, so that
    /// one question has one answer, computed by the same code that validates the certificate on create and
    /// writes it to the audit.
    /// </para>
    /// <para>
    /// Asked only once the text looks like a whole certificate, so typing does not become a request per
    /// keystroke — a paste, which is how a PEM actually arrives, satisfies it in one change.
    /// </para>
    /// </remarks>
    private async Task DescribeRecipientAsync()
    {
        _recipientDescription = string.Empty;
        var asked = _recipientCertificatePem;
        if (string.IsNullOrWhiteSpace(asked)
            || !asked.Contains("BEGIN CERTIFICATE", StringComparison.Ordinal)
            || !asked.Contains("END CERTIFICATE", StringComparison.Ordinal)
            || _describeCertificateUrl is not { } url)
        {
            return;
        }

        var response = await Http.PostAsJsonAsync(url, new { certificatePem = asked });

        // The box may have moved on while the request was in flight, and a description of what WAS in it is
        // the wrong-subject failure this feature exists to prevent, reproduced inside the dialog.
        if (_recipientCertificatePem != asked)
        {
            return;
        }

        _recipientDescription = response.IsSuccessStatusCode
            && await response.Content.ReadFromJsonAsync<CertificateDescriptionResponse>() is { } described
                ? $"{described.Subject} · {described.Fingerprint}"
                : Strings.Get("ExtLinkCertUnreadable");
    }

    private record CertificateDescriptionResponse
    {
        public string? Subject { get; set; }
        public string? Fingerprint { get; set; }
    }

    private record ExternalLinkListResponse
    {
        public List<ExternalLinkResponse> ExternalLinks { get; set; } = [];
        public bool CanCreate { get; set; }

        // Absent means NO, like every capability here — the safe direction: a client that wrongly thinks a
        // certificate is required merely asks for one it did not need.
        public bool RequiresRecipientCertificate { get; set; }

        public List<LinkResponse>? Links { get; set; }
    }

    private record LinkResponse
    {
        public string? Rel { get; set; }
        public string? Href { get; set; }
    }

    private record ExternalLinkResponse
    {
        public Guid Id { get; set; }
        public string? Url { get; set; }
        public DateTimeOffset ExpiresAt { get; set; }
        public int? MaxAccesses { get; set; }
        public int AccessCount { get; set; }
        public string CreatedByName { get; set; } = string.Empty;
        public bool CanExtend { get; set; }
        public string Etag { get; set; } = string.Empty;
        public List<LinkResponse> Links { get; set; } = [];
    }
}
