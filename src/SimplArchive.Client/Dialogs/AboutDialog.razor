@using System.Reflection

@* About dialog (ADR 0504): the vendor block (constant, not translated) + the running client version. *@
<MudDialog>
    <DialogContent>
        <div style="text-align:center; padding: 8px 6px; min-width: 260px;">
            <MudText Typo="Typo.h6" Color="Color.Primary">SimplArchive</MudText>
            <MudText Typo="Typo.body2" Class="mt-3"><strong>Hebel Consulting GmbH</strong></MudText>
            <MudText Typo="Typo.body2">Schweighofplatz 7</MudText>
            <MudText Typo="Typo.body2">6010 Kriens, Switzerland</MudText>
            <MudText Typo="Typo.body2" Class="mt-1">
                <MudLink Href="mailto:support@simplarchive.dev">support@simplarchive.dev</MudLink>
            </MudText>
            <MudText Typo="Typo.caption" Class="mt-4" Style="display:block;">@Strings.Get("AboutVersion") @_version</MudText>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => Dialog.Close())">@Strings.Get("Close")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance Dialog { get; set; } = null!;

    private string _version = "1.0.0";

    protected override void OnInitialized()
    {
        var asm = typeof(AboutDialog).Assembly;
        var raw = asm.GetCustomAttribute<AssemblyInformationalVersionAttribute>()?.InformationalVersion
                  ?? asm.GetName().Version?.ToString() ?? "1.0.0";
        var plus = raw.IndexOf('+');
        _version = plus >= 0 ? raw[..plus] : raw;
    }
}
