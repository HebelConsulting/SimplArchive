@inject HttpClient Http

@* Compare the current version against the working copy in check-out (the cloud stash) SIDE BY SIDE (ADRs
   0517/0712): the server sends the two extracted texts, the shared Presentation TextDiff aligns the lines and
   marks the changed words, DiffView renders the rows. Fixed two sides (no version pickers) — Current version →
   Your working copy. "Not available" for binary formats / no working copy. *@
<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@string.Format(Strings.Get("CoCompareTitleFor"), DocumentName)</MudText>
    </TitleContent>
    <DialogContent>
        <div style="min-width: 860px;">
            <div style="display:flex; align-items:center; gap:12px; margin-bottom:8px; font-size:13px;">
                <span class="mud-text-secondary">@Strings.Get("CoCompareCurrent")</span>
                <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" />
                <span class="mud-text-secondary">@Strings.Get("CoCompareWorking")</span>
            </div>

            @if (_busy)
            {
                <MudProgressCircular Indeterminate="true" Size="Size.Small" />
            }
            else if (_result is { Available: false })
            {
                <MudAlert Severity="Severity.Info" Dense="true">@Strings.Get("CompareNotAvailable")</MudAlert>
            }
            else if (_result is { } r)
            {
                <DiffView FromText="@r.FromText" ToText="@r.ToText" />
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => Dialog.Cancel())">@Strings.Get("Close")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = null!;

    [Parameter] public Guid DocumentId { get; set; }

    // The diff's address, followed from the check-out row's `compare` rel (issue #416).
    [Parameter] public string? CompareHref { get; set; }
    [Parameter] public string DocumentName { get; set; } = string.Empty;

    private bool _busy = true;
    private CompareResult? _result;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // `_busy` starts TRUE here, so this early return left the dialog spinning forever — the same shape
            // as CompareVersionsDialog and VersionsDialog (#874). Found by sweeping for the shape rather than
            // by the audit, which is the argument for fixing a pattern instead of the instances someone
            // happened to notice.
            if (CompareHref is null)
            {
                _result = new CompareResult { Available = false };
                return;
            }

            _result = await Http.GetFromJsonAsync<CompareResult>(CompareHref);
        }
        catch (Exception)
        {
            _result = new CompareResult { Available = false };
        }
        finally
        {
            _busy = false;
        }
    }

    private record CompareResult { public bool Available { get; set; } public string FromText { get; set; } = string.Empty; public string ToText { get; set; } = string.Empty; }
}
