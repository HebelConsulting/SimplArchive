@inject IJSRuntime JsRuntime

@* One-time post-logon desktop-client promo (ADR 0505). "Don't show again" persists in localStorage the moment
   it is ticked — see PersistChoiceAsync (#427). *@
<MudDialog>
    <DialogContent>
        <div style="max-width: 440px;">
            <MudText Typo="Typo.body1">@Strings.Get("DesktopNoticeBody")</MudText>
            <MudCheckBox T="bool" @bind-Value="_dontShowAgain" @bind-Value:after="PersistChoiceAsync" Class="mt-3" Color="Color.Primary" Label="@Strings.Get("DesktopNoticeDontShow")" />
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseAsync">@Strings.Get("DesktopNoticeClose")</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Download" OnClick="DownloadAsync">@Strings.Get("DesktopNoticeDownload")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance Dialog { get; set; } = null!;

    private bool _dontShowAgain;

    // Resolve the visitor's OS and open the matching /download/clients/<os>/ listing (ADR 0490/0499).
    private async Task DownloadAsync()
    {
        var os = await JsRuntime.InvokeAsync<string>("simplArchiveDesktop.resolveOs");
        await JsRuntime.InvokeVoidAsync("open", $"/download/clients/{os}/", "_blank");
        CloseAsync();
    }

    // Persist as soon as the box changes, rather than on the way out. A MudDialog also closes on a BACKDROP
    // CLICK, which runs none of its own handlers, so writing in CloseAsync silently threw the choice away for a
    // visitor who ticked the box and then clicked outside — the modal looked both dismissed and accepted, and
    // came back on the next visit (#427). Ticking IS the decision, so it is recorded then, and unticking undoes
    // it, which also keeps every future dismissal path correct for free.
    private Task PersistChoiceAsync() =>
        JsRuntime.InvokeVoidAsync("simplArchiveDesktop.setNoticeDismissed", _dontShowAgain).AsTask();

    private void CloseAsync() => Dialog.Close();
}
