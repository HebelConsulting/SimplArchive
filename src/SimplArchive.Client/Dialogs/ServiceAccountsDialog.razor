@inject SimplArchive.Client.Services.ApiRoot ApiRoot
@* Manage tenant service accounts (ADR "ServiceAccount management endpoints") — list / create / rotate-secret /
   revoke, gated on CanManageServiceAccounts (the API enforces). The client_id + client_secret are shown ONCE on
   create/rotate (not retrievable again). Admin surface — plain English labels, like the rights matrix. Calls the
   API directly; closes with no result. *@
@inject HttpClient Http
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudDialog>
    <DialogContent>
        <div style="min-width: 560px; max-width: 680px;">
            <MudText Typo="Typo.body2" Class="mb-3 mud-text-secondary">
                Service accounts authenticate machine-to-machine (OAuth client-credentials). The secret is shown once
                on create and rotate — copy it now; it can't be retrieved later.
            </MudText>

            @* Create row. *@
            <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap; margin-bottom:6px;">
                <MudTextField T="string" @bind-Value="_newName" Placeholder="New service account name" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:220px;" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Disabled="@(_busy || string.IsNullOrWhiteSpace(_newName))" OnClick="CreateAsync">Create</MudButton>
            </div>
            <div style="display:flex; gap:14px; flex-wrap:wrap; margin-bottom:14px;">
                @foreach (var r in _rightDefs)
                {
                    <MudCheckBox T="bool" Value="_newRights[r.Key]" ValueChanged="@(v => _newRights[r.Key] = v)" Dense="true" Size="Size.Small" Label="@r.Label" />
                }
            </div>

            <MudDivider Class="mb-2" />

            @if (_accounts.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary">No service accounts yet.</MudText>
            }
            else
            {
                <MudSimpleTable Dense="true" Hover="true" Style="overflow-x:auto;">
                    <thead>
                        <tr><th>Name</th><th>Client ID</th><th>Rights</th><th style="text-align:right;">Actions</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var a in _accounts)
                        {
                            <tr>
                                <td>@a.Name</td>
                                <td><code style="font-size:.78em;">@a.ClientId</code></td>
                                <td>
                                    @foreach (var r in _rightDefs.Where(r => r.Get(a)))
                                    {
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ma-0">@r.Short</MudChip>
                                    }
                                </td>
                                <td style="text-align:right; white-space:nowrap;">
                                    <MudTooltip Text=@Strings.Get("SaEditNameRights")>
                                        <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Edit" Disabled="@(_busy || a.Href("edit") is null)" OnClick="() => EditAsync(a)" />
                                    </MudTooltip>
                                    <MudTooltip Text=@Strings.Get("SaRotate")>
                                        <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Autorenew" Disabled="@(_busy || a.Href("rotate-secret") is null)" OnClick="() => RotateAsync(a)" />
                                    </MudTooltip>
                                    <MudTooltip Text=@Strings.Get("SaRevoke")>
                                        <MudIconButton Size="Size.Small" Color="Color.Error" Icon="@Icons.Material.Filled.DeleteOutline" Disabled="@(_busy || a.Href("revoke") is null)" OnClick="() => RevokeAsync(a)" />
                                    </MudTooltip>
                                </td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => Dialog.Close()">@Strings.Get("Done")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = null!;

    private bool _busy;
    private string _newName = "";
    private readonly Dictionary<string, bool> _newRights = new();
    private List<ServiceAccountDto> _accounts = [];

    private sealed record RightDef(string Key, string Label, string Short, Func<ServiceAccountDto, bool> Get);

    private static readonly RightDef[] _rightDefs =
    [
        new("canExport", "Export", "Export", a => a.CanExport),
        new("canImport", "Import", "Import", a => a.CanImport),
        new("canManageRepositories", "Manage repositories", "Repos", a => a.CanManageRepositories),
        new("canManageMasks", "Manage masks", "Masks", a => a.CanManageMasks),
        new("canManageServiceAccounts", "Manage service accounts", "SvcAccts", a => a.CanManageServiceAccounts),
    ];

    protected override async Task OnInitializedAsync()
    {
        foreach (var r in _rightDefs) { _newRights[r.Key] = false; }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try { _accounts = (await Http.GetFromJsonAsync<ServiceAccountsListDto>(await ApiRoot.RequireAsync("serviceAccounts")))?.ServiceAccounts ?? []; }
        catch (Exception) { _accounts = []; }
    }

    private async Task CreateAsync()
    {
        _busy = true;
        try
        {
            var body = new Dictionary<string, object> { ["name"] = _newName.Trim() };
            foreach (var (k, v) in _newRights) { body[k] = v; }
            var response = await Http.PostAsJsonAsync(await ApiRoot.RequireAsync("serviceAccounts"), body);
            if (!response.IsSuccessStatusCode)
            {
                Snackbar.Add(string.Format(Strings.Get("StErrCreateSaStatus"), (int)response.StatusCode), Severity.Error);
                return;
            }

            var created = await response.Content.ReadFromJsonAsync<ServiceAccountDto>();
            await ShowSecretAsync(created!.ClientId, created.ClientSecret ?? "");
            _newName = "";
            foreach (var r in _rightDefs) { _newRights[r.Key] = false; }
            await LoadAsync();
        }
        catch (Exception) { Snackbar.Add(Strings.Get("StErrCreateSa"), Severity.Error); }
        finally { _busy = false; }
    }

    private async Task RotateAsync(ServiceAccountDto a)
    {
        _busy = true;
        try
        {
            var response = await Http.PostAsync(a.Href("rotate-secret")!, null);
            if (!response.IsSuccessStatusCode)
            {
                Snackbar.Add(string.Format(Strings.Get("StErrRotateSecretStatus"), (int)response.StatusCode), Severity.Error);
                return;
            }

            var rotated = await response.Content.ReadFromJsonAsync<ServiceAccountDto>();
            await ShowSecretAsync(rotated!.ClientId, rotated.ClientSecret ?? "");
        }
        catch (Exception) { Snackbar.Add(Strings.Get("StErrRotateSecret"), Severity.Error); }
        finally { _busy = false; }
    }

    // Edit an existing account's name + rights via the edit dialog → PUT. The API enforces the escalation cap
    // (a 403 if the caller tries to grant a right it lacks); surface that plainly.
    private async Task EditAsync(ServiceAccountDto a)
    {
        var parameters = new DialogParameters<ServiceAccountEditDialog>
        {
            { x => x.Name, a.Name },
            { x => x.CanManageRepositories, a.CanManageRepositories },
            { x => x.CanManageMasks, a.CanManageMasks },
            { x => x.CanManageServiceAccounts, a.CanManageServiceAccounts },
            { x => x.CanImport, a.CanImport },
            { x => x.CanExport, a.CanExport },
        };
        var dialog = await DialogService.ShowAsync<ServiceAccountEditDialog>(Strings.Get("SaEditTitle"), parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not Dictionary<string, object> body) { return; }

        _busy = true;
        try
        {
            var response = await Http.PutAsJsonAsync(a.Href("edit")!, body);
            if (response.IsSuccessStatusCode) { await LoadAsync(); }
            else if ((int)response.StatusCode == 403) { Snackbar.Add(Strings.Get("StErrGrantRightNotHeld"), Severity.Error); }
            else { Snackbar.Add(string.Format(Strings.Get("StErrUpdateSaStatus"), (int)response.StatusCode), Severity.Error); }
        }
        catch (Exception) { Snackbar.Add(Strings.Get("StErrUpdateSa"), Severity.Error); }
        finally { _busy = false; }
    }

    private async Task RevokeAsync(ServiceAccountDto a)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(new MessageBoxOptions
        {
            Title = "Revoke service account",
            Message = $"Revoke '{a.Name}'? Its client credentials stop working immediately.",
            YesText = "Revoke",
            CancelText = "Cancel",
        });
        if (confirmed != true) { return; }

        _busy = true;
        try
        {
            if ((await Http.DeleteAsync(a.Href("revoke")!)).IsSuccessStatusCode) { await LoadAsync(); }
            else { Snackbar.Add(Strings.Get("StErrRevokeSa"), Severity.Error); }
        }
        catch (Exception) { Snackbar.Add(Strings.Get("StErrRevokeSa"), Severity.Error); }
        finally { _busy = false; }
    }

    // Show the client_id + one-time secret with copy buttons (a plain message box would truncate; use a simple
    // read-only field pair via the shared generated-secret dialog styling).
    private async Task ShowSecretAsync(string clientId, string secret)
    {
        var parameters = new DialogParameters<ServiceAccountSecretDialog>
        {
            { x => x.ClientId, clientId },
            { x => x.ClientSecret, secret },
        };
        await DialogService.ShowAsync<ServiceAccountSecretDialog>(Strings.Get("SaSecretTitle"), parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
    }

    private sealed class ServiceAccountsListDto { public List<ServiceAccountDto> ServiceAccounts { get; set; } = []; }

    private sealed class LinkDto { public string Rel { get; set; } = ""; public string Href { get; set; } = ""; }

    private sealed class ServiceAccountDto
    {
        public List<LinkDto> Links { get; set; } = [];

        // A revoked account advertises none of the management rels, so the row's buttons follow the server
        // rather than re-deriving "is it still live" from IsActive (issue #416).
        public string? Href(string rel) => Links.FirstOrDefault(l => l.Rel == rel)?.Href.TrimStart('/');

        public Guid Id { get; set; }
        public string Name { get; set; } = "";
        public string ClientId { get; set; } = "";
        public string? ClientSecret { get; set; }
        public bool IsActive { get; set; }
        public bool CanManageRepositories { get; set; }
        public bool CanManageMasks { get; set; }
        public bool CanManageServiceAccounts { get; set; }
        public bool CanImport { get; set; }
        public bool CanExport { get; set; }
    }
}
