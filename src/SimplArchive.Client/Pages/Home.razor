@page "/"
@using System.IO
@using System.Net
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@implements IAsyncDisposable
@implements SimplArchive.Client.Components.Panes.IPreviewAnnotationHost
@using SimplArchive.Client.Dialogs
@inject HttpClient Http
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject SimplArchive.Client.Services.ImpersonationService ImpersonationSvc
@inject SimplArchive.Client.Services.AppNavigationState AppNav
@inject SimplArchive.Client.Services.ApiRoot ApiRoot
@inject SimplArchive.Client.Services.SensitivityLabelCatalog SensitivityLabels
@inject SimplArchive.Client.Services.OcrLanguageCatalog OcrLanguages
@inject SimplArchive.Client.Services.DocumentActions Actions
@inject SimplArchive.Client.Services.BrowseService Browse
@inject SimplArchive.Client.Services.TreeState Tree

<PageTitle>SimplArchive</PageTitle>

<style>
    .wb { height: 100%; display: flex; flex-direction: column; background: var(--mud-palette-background); }
    /* flex-wrap so ribbon buttons reflow onto a new row when they don't fit, instead of clipping/overflowing —
       matching the preview-pane toolbar's wrapping behavior (both clients). */
    .wb-ribbon { flex: 0 0 auto; display: flex; flex-wrap: wrap; align-items: center; gap: 4px; padding: 6px 12px;
        border-bottom: 1px solid var(--mud-palette-lines-default); background: var(--mud-palette-surface); }
    /* #305: the label sits after the icon inside the button; a small gap when it's shown. */
    .wb-rib-btn .wb-rib-label { margin-left: 6px; }
    /* Icon-only ribbon buttons on hover-capable computers — the label rides in the `title` tooltip, matching the
       desktop client + the #298 tabs (ADR 0511). Touch devices keep the visible label. */
    @@media (hover: hover) and (pointer: fine) {
        .wb-rib-btn { min-width: 0; }
        .wb-rib-btn .wb-rib-label { display: none; }
    }
    .wb-cols { flex: 1 1 auto; min-height: 0; display: flex; }
    .wb-pane { overflow: auto; }
    /* Pane basis/collapsed state are set inline by wbLayout.js (persisted); these are the pre-JS fallbacks.
       Dividers are the gutters below, so panes carry no border on the gutter side. */
    .wb-tree { flex: 0 0 240px; padding: 4px; }
    /* The tree row's ⋮ button (ADR "Tree-pane folder context menu"): the touch-reachable path to the context
       menu, since touch has no right-click. Hidden until the row is hovered/focused on a fine pointer so the
       tree stays clean — but ALWAYS shown on a coarse pointer, where there is no hover to reveal it (ADR 0491:
       a hover-only affordance can't be the only cue on touch). It is absolutely positioned OVER the row's
       trailing edge rather than taking a flex slot, so folder names keep the full pane width (reserving ~28px
       truncated "Demo Repository" at the default 240px) and nothing reflows when it appears; background:inherit
       chains up to the row so it masks the label's tail cleanly on a hovered/selected row too. */
    .wb-tree-row { position: relative; display: flex; align-items: center; flex: 1 1 auto; min-width: 0;
        background: inherit; }
    .wb-tree-row .mud-treeview-item-label { flex: 1 1 auto; min-width: 0; overflow: hidden;
        text-overflow: ellipsis; white-space: nowrap; }
    .wb-tree .wb-tree-menu-btn { visibility: hidden; position: absolute; right: 0; top: 50%;
        transform: translateY(-50%); padding: 2px; background: inherit; }
    .wb-tree .mud-treeview-item-content:hover .wb-tree-menu-btn,
    .wb-tree .mud-treeview-item-content:focus-within .wb-tree-menu-btn { visibility: visible; }
    @@media (pointer: coarse) { .wb-tree .wb-tree-menu-btn { visibility: visible; } }
    /* The tree's glyph colours (ADR "Folder icon scheme"), matching the desktop client. The direct-child chain is
       deliberate: a MudTreeViewItem renders its children inside itself (nested under .mud-collapse-container), so
       a descendant selector would colour every subfolder too. The four-class chain also out-specifies MudBlazor's
       own .mud-icon-default colour; the svg has no fill, so it inherits currentColor.

       GOLD marks a place documents live — a folder, the personal root, a referenced folder. The Inbox /
       Check-out launchers and the Administration branch are real nodes but not containers, so they take the
       theme's secondary text colour: gold that lands on every row says nothing.

       An EMPTY folder is the SAME gold, mixed toward the pane's own surface colour — not a second hue. The
       previous fixed pale yellow could only recede on light; on dark it was LIGHTER than the gold, which made
       empty folders the loudest thing in the tree. Mixing toward --mud-palette-surface follows the in-app dark
       toggle for free (a media query would not: the toggle is ours, not the OS's). Browsers without color-mix
       fall back to the flat gold and lean on the outline glyph, which carries the distinction anyway. */
    .wb-tree-folder > .mud-treeview-item > .mud-treeview-item-content > .mud-treeview-item-icon > .mud-icon-root {
        color: #d9a400;
    }
    /* The detail pane and the contents list draw the SAME object, so they use the same glyph colours as the tree
       (ADR 0547): a folder looks like a folder, and an empty one like an empty one, in every pane. The earlier
       decision — colour only in the tree, filled glyphs everywhere else — made one object look like three. */
    .wb-detail-head.wb-tree-folder > .wb-detail-glyph, .wb-list-row .wb-glyph-folder { color: #d9a400; }
    .wb-detail-head.wb-tree-empty > .wb-detail-glyph, .wb-list-row .wb-glyph-empty {
        color: #d9a400;
        color: color-mix(in srgb, #d9a400 55%, var(--mud-palette-surface));
    }
    .wb-detail-head.wb-tree-muted > .wb-detail-glyph { color: var(--mud-palette-text-secondary); }
    .wb-tree-empty > .mud-treeview-item > .mud-treeview-item-content > .mud-treeview-item-icon > .mud-icon-root {
        color: #d9a400;
        color: color-mix(in srgb, #d9a400 55%, var(--mud-palette-surface));
    }
    .wb-tree-muted > .mud-treeview-item > .mud-treeview-item-content > .mud-treeview-item-icon > .mud-icon-root {
        color: var(--mud-palette-text-secondary);
    }
    .wb-list { flex: 0 0 300px; container-type: inline-size; }
    .wb-detail { flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column; }
    /* NOTE (ADR 0550): this pane should size to its CONTENT for short detail sets — the preview is what the user
       came to look at, and a scrollbar on a four-row pane means the pane is claiming space it is not using. It
       does NOT yet: wbLayout.js applies an inline flex basis in pixels here (persisted, user-resizable), and an
       inline style beats this rule. Fixing it belongs in wbLayout.js — default to fit-content and let a manual
       drag take over — not in a stylesheet the script overrides. */
    .wb-index { flex: 0 0 280px; overflow: auto; padding: 10px 14px; }
    /* The pane's own header stays put while the fields scroll, so the commit controls a transition put there
       cannot scroll out of reach (ADR 0550). */
    .wb-detail-head { position: sticky; top: -10px; z-index: 2; background: var(--mud-palette-surface);
        padding: 4px 0 6px; margin-top: -4px; }
    /* System-fields grid + editable-mask form (ADRs 0273/0278). */
    .wb-sysfields { width: 100%; border-collapse: collapse; margin-top: 6px; }
    .wb-sysfields td { padding: 2px 6px 2px 0; vertical-align: middle; font-size: 0.82rem; }
    .wb-sysfields td:first-child { width: 110px; color: var(--mud-palette-text-secondary); white-space: nowrap; }
    .wb-sys-muted { color: var(--mud-palette-text-secondary); }
    .wb-mask-edit { margin-top: 10px; }
    .wb-mask-row { display: flex; align-items: center; gap: 8px; margin: 4px 0; }
    .wb-mask-label { width: 150px; flex: 0 0 auto; color: var(--mud-palette-text-secondary); font-size: 0.82rem; }
    .wb-mask-row .mud-input-control { flex: 1 1 auto; }
    .wb-ocr-chips { display: flex; flex-wrap: wrap; gap: 4px; }
    .wb-ocr-chip { border: 1px solid var(--mud-palette-lines-default); border-radius: 12px; padding: 1px 8px; font-size: 0.75rem; background: transparent; cursor: pointer; color: var(--mud-palette-text-primary); }
    .wb-ocr-chip-on { background: var(--mud-palette-primary); color: var(--mud-palette-primary-text); border-color: var(--mud-palette-primary); }
    .wb-detail-actions { display: flex; justify-content: flex-end; gap: 8px; margin-top: 12px; }
    .wb-detail-bottom { flex: 1 1 auto; min-height: 0; display: flex; }
    .wb-preview { flex: 1 1 auto; min-width: 0; display: flex; position: relative; }
    .wb-preview iframe { width: 100%; height: 100%; border: 0; }
    /* pdf.js / image preview with search hit-overlay + click-to-copy (ADRs 0268/0269/0282). */
    /* touch-action: allow native single-finger pan/scroll but suppress the browser's own pinch-zoom, so preview.js'
       two-finger pinch controls the preview zoom instead of the whole page (#357). */
    .wb-pv-host { flex: 1 1 auto; min-height: 0; overflow: auto; padding: 8px; background: var(--mud-palette-background-grey); text-align: center; touch-action: pan-x pan-y; }
    /* Zoom (#357): --wb-pv-zoom (1..4, set by preview.js) scales the page's max-width; at 1 this is the fit-width
       default. When zoomed, left-align so an overflowing page is scrollable to both edges (centering can strand the
       left edge under overflow). */
    .wb-pv-host.wb-pv-zoomed { text-align: left; }
    .wb-pv-page { position: relative; display: inline-block; margin: 0 auto 8px; width: calc(100% * var(--wb-pv-zoom, 1)); box-shadow: 0 1px 4px rgba(0,0,0,.2); }
    .wb-pv-media { display: block; width: 100%; height: auto; }
    .wb-pv-overlay { position: absolute; inset: 0; cursor: pointer; }
    .wb-pv-hit { position: absolute; background: rgba(255,213,0,.4); outline: 1px solid rgba(224,164,0,.8); }
    .wb-pv-hit-active { background: rgba(255,140,0,.55); outline: 2px solid rgba(210,110,0,1); }
    /* Sticky-note markers (ADR "Document annotations"): a small coloured square pinned at the note's position. */
    /* A sticky-note box showing its text, always visible (ADR "Post-it note boxes" web parity). Height grows to
       fit the text but is at least the persisted min-height, so a note keeps its true (resized) height. */
    .wb-pv-note { position: absolute; min-width: 90px; box-sizing: border-box; padding: 5px 7px; border-radius: 4px; border: 1px solid rgba(0,0,0,.5); box-shadow: 0 1px 3px rgba(0,0,0,.35); cursor: grab; color: #222; font-size: 12px; line-height: 1.25; word-break: break-word; white-space: pre-wrap; }
    .wb-pv-note-grip { position: absolute; right: 0; bottom: 0; width: 14px; height: 14px; cursor: nwse-resize; background: linear-gradient(135deg, transparent 55%, rgba(0,0,0,.45) 55%, rgba(0,0,0,.45) 68%, transparent 68%, transparent 80%, rgba(0,0,0,.45) 80%, rgba(0,0,0,.45) 92%, transparent 92%); }
    /* Multi-select (ADR "Annotation multi-select" web parity): a dashed outline on selected annotations + the marquee rubber-band. */
    .wb-pv-selected { outline: 2px dashed #2f6fed; outline-offset: 2px; }
    .wb-pv-marquee { position: absolute; background: rgba(47,111,237,.13); border: 1px dashed rgba(47,111,237,.7); pointer-events: none; }
    .wb-pv-adding .wb-pv-overlay { cursor: crosshair; }
    /* Markup shapes (ADR "Annotation markup"): highlight box, rectangle outline, arrow (SVG). */
    .wb-pv-shape { position: absolute; pointer-events: none; }
    /* Shapes are movable (drag the body) — a move cursor, not a link-hand (ADR "Highlighting redesign"). */
    .wb-pv-hl { opacity: .38; border-radius: 2px; cursor: move; }
    .wb-pv-rect { border: 2px solid #F44336; background: transparent; cursor: move; }
    .wb-pv-arrow { overflow: visible; cursor: move; }
    .wb-pv-arrow line { stroke: #F44336; stroke-width: .8; vector-effect: non-scaling-stroke; }
    .wb-pv-arrow polygon { fill: #F44336; }
    .wb-pv-stamp { border: 2px solid #F44336; background: transparent; color: #F44336; display: flex; align-items: center; justify-content: center; text-align: center; font-weight: 700; text-transform: uppercase; font-size: .8rem; letter-spacing: .05em; opacity: .85; border-radius: 3px; overflow: hidden; cursor: move; }
    .wb-pv-textbox { border: 1px solid #1976D2; background: rgba(255,255,255,.75); color: #222; padding: 2px 4px; font-size: .72rem; overflow: hidden; cursor: move; }
    .wb-pv-strike { cursor: move; }
    .wb-pv-strike::after { content: ''; position: absolute; left: 0; right: 0; top: 50%; border-top: 2px solid currentColor; }
    .wb-pv-freehand { overflow: visible; cursor: move; }
    .wb-pv-freehand polyline { fill: none; stroke: #F44336; stroke-width: .8; vector-effect: non-scaling-stroke; }
    /* A resize grip on a box shape (highlight/rectangle), like the note grip. */
    .wb-pv-shape-grip { position: absolute; right: -3px; bottom: -3px; width: 12px; height: 12px; cursor: nwse-resize; background: rgba(0,0,0,.55); border: 1px solid #fff; border-radius: 2px; pointer-events: auto; }
    /* Toolbar colour palette (ADR "Highlighting redesign"). */
    .wb-pv-palette { display: inline-flex; gap: 3px; align-items: center; margin: 0 4px; }
    .wb-pv-swatch { width: 16px; height: 16px; border-radius: 3px; cursor: pointer; border: 2px solid rgba(0,0,0,.3); }
    .wb-pv-swatch-on { border-color: var(--mud-palette-primary); }
    .wb-pv-shape-preview { opacity: .6; pointer-events: none; }
    .wb-pv-drawing .wb-pv-overlay { cursor: crosshair; }
    /* flex-wrap + min-width:0, so a narrowed pane wraps the toolbar onto another line instead of letting its
       controls escape the pane and draw over the chat pane (#419). This mirrors the desktop, whose toolbar is a
       WrapPanel (PreviewPane.axaml) and never had the defect — ADR 0511, the desktop is the reference. */
    .wb-pv-findbar { flex: 0 0 auto; min-width: 0; display: flex; flex-wrap: wrap; align-items: center; gap: 6px; padding: 4px 8px; border-bottom: 1px solid var(--mud-palette-lines-default); }
    /* The find controls wrap as ONE unit, like the desktop's StackPanel — a text field split from its match
       counter and arrows reads as broken rather than as a second row. */
    .wb-pv-findbar .wb-pv-findgrp { display: inline-flex; align-items: center; gap: 6px; min-width: 0; }
    /* Right-aligned control group (zoom + fullscreen) at the end of the preview toolbar (#357). */
    .wb-pv-findbar .wb-pv-rightgrp { margin-left: auto; display: inline-flex; align-items: center; gap: 2px; }
    /* In-app full-screen: the preview pane becomes a fixed overlay over the workbench, stopping just above the
       bottom tab bar (`--wb-tab-h`, measured by preview.js on enter) so the tabs stay visible and clickable.
       z-index sits above the app bar (1100) but below MudBlazor's snackbar (1400) so the click-to-copy toast
       still shows on top. */
    /* Keep the inherited `display:flex` row direction (the inner findbar+host wrapper is the single flex item and
       stretches to this fixed height, so the host's overflow:auto clips to the pane); switching to column here
       let the wrapper grow to its full content height and overflow past the fixed container onto the tab bar. */
    .wb-pv-fullscreen { position: fixed !important; top: 0; left: 0; right: 0; bottom: var(--wb-tab-h, 41px);
        z-index: 1300; background: var(--mud-palette-surface); padding: 4px; }
    /* "Converted preview" badge, bottom-right corner (avoids the top PDF-viewer toolbar). */
    /* Sensitivity watermark overlay (ADR "Document watermarking") — a repeating diagonal label+viewer, over the
       preview but click-through so it doesn't block the pdf.js hit-overlay. */
    .wb-watermark { position: absolute; inset: 0; z-index: 3; pointer-events: none; background-repeat: repeat; }
    .wb-preview-badge { position: absolute; bottom: 10px; right: 10px; z-index: 4;
        display: flex; align-items: center; gap: 4px; padding: 3px 9px; border-radius: 11px;
        font-size: .72rem; font-weight: 500; background: rgba(0,0,0,.62); color: #fff; }
    .wb-preview-badge .mud-icon-root { font-size: .95rem; }
    .wb-preview-empty { flex: 1 1 auto; display: flex; align-items: center; justify-content: center; color: var(--mud-palette-text-secondary); }
    .wb-chat { flex: 0 0 340px; min-height: 0; display: flex; flex-direction: column; }
    /* A collapsed pane shrinks to nothing; its gutter stays as the re-open strip. */
    [data-collapsed] { overflow: hidden !important; padding: 0 !important; min-width: 0; min-height: 0; }
    .wb-gutter { flex: 0 0 8px; position: relative; display: flex; align-items: center; justify-content: center;
        background: var(--mud-palette-surface); }
    .wb-gutter:hover { background: var(--mud-palette-action-default-hover); }
    .wb-gutter-v { cursor: col-resize; border-left: 1px solid var(--mud-palette-lines-default);
        border-right: 1px solid var(--mud-palette-lines-default); }
    .wb-gutter-h { cursor: row-resize; border-top: 1px solid var(--mud-palette-lines-default);
        border-bottom: 1px solid var(--mud-palette-lines-default); }
    .wb-gutter-toggle { position: absolute; z-index: 2; width: 16px; height: 16px; padding: 0; line-height: 1;
        display: flex; align-items: center; justify-content: center; font-size: 11px; cursor: pointer;
        border: 1px solid var(--mud-palette-lines-default); border-radius: 3px;
        background: var(--mud-palette-surface); color: var(--mud-palette-text-secondary); }
    .wb-gutter-toggle:hover { color: var(--mud-palette-primary); border-color: var(--mud-palette-primary); }
    .wb-chat-empty { flex: 1 1 auto; display: flex; flex-direction: column; align-items: center; justify-content: center;
        gap: 8px; color: var(--mud-palette-text-secondary); text-align: center; padding: 14px; }
    .wb-chat-header { flex: 0 0 auto; padding: 8px 12px; border-bottom: 1px solid var(--mud-palette-lines-default); }
    .wb-chat-thread { flex: 1 1 auto; overflow: auto; padding: 6px 12px; }
    .wb-comment { padding: 6px 0; }
    .wb-comment-reply { margin-left: 18px; border-left: 2px solid var(--mud-palette-lines-default); padding-left: 10px; }
    .wb-comment-meta { font-size: .72rem; color: var(--mud-palette-text-secondary); }
    /* An author whose card can be opened (ADR 0544). A ServiceAccount author has no card and stays plain text,
       so the affordance itself tells you whether there is a person behind the name. */
    .wb-author-link { color: var(--mud-palette-primary); cursor: pointer; }
    .wb-author-link:hover { text-decoration: underline; }
    .wb-author-card { max-width: 22rem; }
    /* An automatic entry (ADR 0545) reads as a recorded event, not somebody talking. */
    .wb-system-entry { color: var(--mud-palette-text-secondary); font-style: italic; }
    .wb-version-entry { display: flex; align-items: flex-start; gap: .4rem; margin-top: .25rem;
                        padding: .3rem .5rem; border-left: 2px solid var(--mud-palette-divider); font-size: .8rem; }
    .wb-version-comment { color: var(--mud-palette-text-secondary); white-space: pre-wrap; }
    .wb-comment-body { font-size: .9rem; white-space: pre-wrap; }
    /* A mention has to be visibly not-prose, so a reader can tell at a glance they were addressed (issue #383). */
    .wb-mention { color: var(--mud-palette-primary); font-weight: 500; }
    /* Anchored above the compose box: the picker opens while typing at the bottom of the pane, so opening
       downwards would push it off the visible area. */
    .wb-mention-picker { position: absolute; bottom: 100%; left: 0; right: 0; max-height: 190px; overflow-y: auto; z-index: 10; }
    .wb-compose { position: relative; }
    .wb-reply-link { font-size: .72rem; color: var(--mud-palette-primary); cursor: pointer; user-select: none; }
    .wb-compose { flex: 0 0 auto; border-top: 1px solid var(--mud-palette-lines-default); padding: 8px 12px; }
    .wb-compose-actions { display: flex; justify-content: flex-end; margin-top: 4px; }
    .wb-tabs { flex: 0 0 auto; display: flex; border-top: 1px solid var(--mud-palette-lines-default); background: var(--mud-palette-surface); }
    .wb-tab { padding: 8px 22px; cursor: pointer; border-right: 1px solid var(--mud-palette-lines-default);
        user-select: none; font-size: .9rem; display: flex; align-items: center; gap: 6px; }
    .wb-tab-active { background: var(--mud-palette-primary); color: var(--mud-palette-primary-text); }
    .wb-tab-disabled { opacity: .5; cursor: not-allowed; }
    /* #298: the icon wrapper anchors the live-count badge (Check-out/Tasks), mirroring the desktop client. */
    .wb-tab-ico { position: relative; display: inline-flex; align-items: center; }
    .wb-tab-badge { position: absolute; top: -5px; right: -9px; min-width: 16px; height: 16px; padding: 0 4px;
        box-sizing: border-box; display: flex; align-items: center; justify-content: center; border-radius: 8px;
        font-size: .625rem; line-height: 1; background: var(--mud-palette-primary); color: var(--mud-palette-primary-text); }
    /* On the active tab the tab background is already primary, so invert the badge to stay legible. */
    .wb-tab-active .wb-tab-badge { background: var(--mud-palette-primary-text); color: var(--mud-palette-primary); }
    /* Icon-only tabs on hover-capable computers — the label rides in the `title` tooltip (#298). Touch devices
       (no hover ⇒ no tooltip) fall outside this query and keep the visible .wb-tab-label. */
    @@media (hover: hover) and (pointer: fine) {
        .wb-tab { padding: 8px 14px; }
        .wb-tab-label { display: none; }
    }
    .wb-bulk-bar { display: flex; align-items: center; gap: 4px; padding: 3px 8px; background: var(--mud-palette-primary-hover); border-bottom: 1px solid var(--mud-palette-lines-default); position: sticky; top: 0; z-index: 2; }
    /* Contents-list columns (ADR "List-row columns and sorting" + "Pane-adaptive contents columns") — a grid
       modifier on .wb-list-row (higher specificity so it overrides the base flex layout), keeping the base
       hover/cursor/selected + test hooks. Every track is minmax(0, …) so the cells SHRINK + ellipsize rather than
       overflow the pane, and the trailing `auto` track is the ⋮ row-menu — it never shrinks and is always the last
       visible column, so the menu can never be clipped/scrolled off. The `.wb-list` pane is an inline-size query
       container (above), so the breakpoints below react to the *pane's own width*, not the viewport — collapsing
       lower-priority columns as the user narrows the split, uniformly on computer/tablet/phone. */
    .wb-list-row.wb-cols, .wb-chead { display: grid; grid-template-columns: minmax(0, 2.4fr) minmax(0, 1fr) minmax(0, 92px) minmax(0, 70px) minmax(0, 1.3fr) auto; align-items: center; gap: 8px; }
    .wb-chead { padding: 4px 12px; font-size: .72rem; font-weight: 600; color: var(--mud-palette-text-secondary); border-bottom: 1px solid var(--mud-palette-lines-default); position: sticky; top: 0; background: var(--mud-palette-surface); z-index: 1; }
    .wb-chead > span { cursor: pointer; user-select: none; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .wb-ccell { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: .82rem; color: var(--mud-palette-text-secondary); }
    .wb-cname { display: flex; align-items: center; gap: 6px; color: var(--mud-palette-text-primary); font-size: unset; }
    /* Medium pane: drop Size (4th) + Tags (5th), keeping Name · Type · Doc date · ⋮. */
    @@container (max-width: 519px) {
        .wb-list-row.wb-cols, .wb-chead { grid-template-columns: minmax(0, 2.4fr) minmax(0, 1fr) minmax(0, 92px) auto; }
        .wb-list-row.wb-cols > :nth-child(4), .wb-list-row.wb-cols > :nth-child(5),
        .wb-chead > :nth-child(4), .wb-chead > :nth-child(5) { display: none; }
    }
    /* Narrow pane: Name + ⋮ only (the menu stays — it isn't a .wb-ccell). */
    @@container (max-width: 399px) {
        .wb-list-row.wb-cols, .wb-chead { grid-template-columns: minmax(0, 1fr) auto; }
        .wb-list-row.wb-cols > .wb-ccell:not(.wb-cname), .wb-chead > span:not(:first-child) { display: none; }
    }
    .wb-list-row { display: flex; align-items: center; gap: 8px; padding: 5px 12px; cursor: pointer; user-select: none; }
    .wb-list-row:hover { background: var(--mud-palette-action-default-hover); }
    .wb-list-row-selected { background: var(--mud-palette-primary-hover); }
    /* Touch (coarse pointer): enlarge the primary tap targets toward the ~44px guideline (#359). ADDITIVE — keyed
       off `pointer: coarse` (not `hover: none`), so a hybrid device with a mouse keeps the denser layout and every
       feature; a finger just gets bigger hit areas. The dead resize gutters (drag is mouse-only) lose their
       resize cursor/borders, but the collapse/expand toggle they host is enlarged so it stays usable. */
    @@media (pointer: coarse) {
        .wb-list-row { padding: 11px 12px; }
        .wb-tab { padding: 12px 20px; }
        .wb-list-row .mud-icon-button, .wb-chead .mud-icon-button { min-width: 40px; min-height: 40px; }
        .wb-gutter-toggle { width: 34px; height: 34px; font-size: 15px; border-radius: 6px; }
        .wb-gutter-v { cursor: default; }
        .wb-gutter-h { cursor: default; }
        .mud-treeview-item-content { min-height: 42px; }
    }
    .wb-placeholder { flex: 1 1 auto; display: flex; align-items: center; justify-content: center; color: var(--mud-palette-text-secondary); }
    /* Fill the space between the ribbon and the bottom tab bar (and scroll internally), so the tab bar stays
       pinned — same as .wb-cols/.wb-search. Without this the content-sized panel lets the tab bar ride up or
       get pushed off-screen. */
    .wb-tasks, .wb-checkout, .wb-tenant, .wb-mywork, .wb-tags { flex: 1 1 auto; min-height: 0; }
    .wb-setting-row { display: flex; align-items: flex-start; gap: 4px; }
    .wb-setting-row .mud-icon-button { margin-top: 6px; }
    /* Users & groups admin tab: principal list | rights matrix. Fills to the tab bar, same as .wb-cols. */
    .wb-ug { flex: 1 1 auto; min-height: 0; display: flex; }
    .wb-ug-list { flex: 0 0 300px; min-width: 0; display: flex; flex-direction: column; border-right: 1px solid var(--mud-palette-lines-default); }
    .wb-ug-toolbar { flex: 0 0 auto; display: flex; align-items: center; gap: 2px; padding: 4px 6px; border-bottom: 1px solid var(--mud-palette-lines-default); }
    .wb-ug-rows { flex: 1 1 auto; min-height: 0; overflow: auto; }
    .wb-ug-rights { flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column; padding: 14px 18px; overflow: auto; }
    .wb-ug-rights-head { display: flex; align-items: center; gap: 8px; margin-bottom: 10px; }
    .wb-ug-rights-grid { display: grid; grid-template-columns: repeat(2, minmax(220px, 1fr)); gap: 0 24px; }
    .wb-ug-right { margin: 0; }
    .wb-ug-photo { display: flex; align-items: center; gap: 12px; margin-bottom: 12px; }
    .wb-ug-members { max-width: 360px; }
    .wb-ug-member { display: flex; align-items: center; gap: 8px; padding: 2px 0; }
    .drop-target-active { outline: 2px dashed var(--mud-palette-primary); outline-offset: -3px; background: var(--mud-palette-primary-hover); }
    .wb-search { flex: 1 1 auto; min-height: 0; display: flex; flex-direction: column; padding: 12px 16px; }
    .wb-search-bar { flex: 0 0 auto; display: flex; align-items: center; }
    .wb-search-status { flex: 0 0 auto; font-size: .8rem; color: var(--mud-palette-text-secondary); padding: 8px 2px; }
    .wb-search-filters { flex: 0 0 auto; display: flex; flex-direction: column; gap: 6px; padding: 4px 2px 8px; }
    .wb-filter-row { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .wb-filter-label { flex: 0 0 96px; font-size: .8rem; color: var(--mud-palette-text-secondary); }
    .wb-filter-date { max-width: 150px; }
    .wb-saved-searches { flex: 0 0 auto; display: flex; align-items: center; flex-wrap: wrap; gap: 4px; padding: 4px 2px; }
    .wb-search-facets { flex: 0 0 auto; display: flex; flex-direction: column; gap: 2px; padding: 2px 2px 8px; border-bottom: 1px solid var(--mud-palette-lines-default); margin-bottom: 4px; }
    .wb-facet-group { display: flex; align-items: center; flex-wrap: wrap; gap: 4px; }
    .wb-facet-label { font-size: .72rem; font-weight: 600; color: var(--mud-palette-text-secondary); min-width: 74px; }
    .wb-search-results { flex: 1 1 auto; min-height: 0; overflow: auto; }
    .wb-search-path { font-size: .72rem; color: var(--mud-palette-text-secondary); }
    .wb-search-snippet { font-size: .78rem; color: var(--mud-palette-text-secondary); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .wb-search-snippet em { font-style: normal; font-weight: 600; background: var(--mud-palette-warning-lighten); color: var(--mud-palette-text-primary); border-radius: 2px; padding: 0 1px; }
    /* Audit log viewer tab. Fills to the tab bar, same as .wb-cols. */
    .wb-audit { flex: 1 1 auto; min-height: 0; display: flex; flex-direction: column; }
    .wb-audit-filters { flex: 0 0 auto; display: flex; align-items: center; gap: 10px; flex-wrap: wrap; padding: 10px 14px; border-bottom: 1px solid var(--mud-palette-lines-default); }
    .wb-audit-retention { flex: 0 0 auto; display: flex; align-items: center; gap: 8px; flex-wrap: wrap; padding: 6px 14px; border-bottom: 1px solid var(--mud-palette-lines-default); }
    .wb-audit-rows { flex: 1 1 auto; min-height: 0; overflow: auto; }
    .wb-audit-table { width: 100%; border-collapse: collapse; font-size: .82rem; }
    .wb-audit-table th { text-align: left; position: sticky; top: 0; background: var(--mud-palette-surface); border-bottom: 1px solid var(--mud-palette-lines-default); padding: 6px 12px; font-weight: 600; }
    .wb-audit-table td { padding: 5px 12px; border-bottom: 1px solid var(--mud-palette-lines-default); vertical-align: top; }

    /* Phone drill-down chrome (ADR "Responsive phone drill-down") — hidden on desktop/tablet, shown only ≤767. */
    .wb-phone-topbar, .wb-phone-scrim, .wb-phone-detbar { display: none; }

    /* Responsive workbench (ADR "Responsive web workbench", iPad-first). Below 1200px wbLayout.js stops applying
       the persisted px pane widths (they'd overflow) and these rules govern: drop the lower-priority panes so
       tree | list | preview fit. Placed last so they win over the base .wb-* pane widths at equal specificity.
       (!important also beats any residual inline flex if JS hasn't cleared it yet.) */
    @@media (max-width: 1199px) {
        /* Tablet / iPad: drop the chat (comments) pane; trim the tree + contents list; the preview flexes to fill. */
        .wb-chat, [data-gutter="chat"] { display: none !important; }
        .wb-tree { flex: 0 0 190px !important; }
        .wb-list { flex: 0 1 34% !important; min-width: 200px; max-width: 340px; }
        /* Column collapse is handled by the .wb-list container queries above (by pane width), not here. */
        /* Many bottom tabs won't fit a tablet width — let them scroll horizontally rather than wrap/clip. */
        .wb-tabs { overflow-x: auto; }
        .wb-tab { white-space: nowrap; }
    }
    /* Phone single-pane drill-down (ADR "Responsive phone drill-down"), replacing the trimmed-3-pane tier: the
       tree becomes a slide-out drawer, the folder contents list is the default full-width view, and a selected
       document opens a full-screen detail overlay with Preview/Details/Comments sub-tabs. */
    @@media (max-width: 767px) {
        .wb-ribbon { padding: 4px 8px; }
        .wb-phone-topbar { display: flex; align-items: center; gap: 4px; flex: 0 0 auto; padding: 2px 6px;
            border-bottom: 1px solid var(--mud-palette-lines-default); background: var(--mud-palette-surface); }
        .wb-phone-title { font-size: .9rem; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

        /* wb-cols is the positioning context for the drawer + detail overlay; no resize gutters on a phone. */
        .wb-cols { position: relative; }
        .wb-cols [data-gutter] { display: none !important; }
        .wb-list { flex: 1 1 auto !important; min-width: 0; max-width: none; }

        /* Tree = slide-out drawer within the content region (below the ribbon, above the tabs). */
        .wb-tree { position: absolute; top: 0; left: 0; bottom: 0; width: 78%; max-width: 300px; z-index: 50;
            flex: none !important; transform: translateX(-104%); transition: transform .2s ease;
            background: var(--mud-palette-surface); box-shadow: 2px 0 8px rgba(0,0,0,.3); }
        .wb-cols.wb-phone-tree-open .wb-tree { transform: translateX(0); }
        .wb-phone-scrim-on { display: block; position: absolute; inset: 0; z-index: 45; background: rgba(0,0,0,.35); }

        /* Detail = full-screen overlay, shown only when a document is selected. */
        .wb-detail { position: absolute; inset: 0; z-index: 55; background: var(--mud-palette-background); display: none; }
        .wb-detail.wb-phone-detail-open { display: flex; flex-direction: column; }
        .wb-detail [data-gutter] { display: none !important; }
        .wb-phone-detbar { display: flex; align-items: center; gap: 2px; flex: 0 0 auto; padding: 2px 4px;
            border-bottom: 1px solid var(--mud-palette-lines-default); background: var(--mud-palette-surface); }
        .wb-ptab-btn { flex: 1 1 auto; padding: 7px 4px; border: 0; background: transparent; font-size: .82rem;
            color: var(--mud-palette-text-secondary); cursor: pointer; border-bottom: 2px solid transparent; }
        .wb-ptab-on { color: var(--mud-palette-primary); border-bottom-color: var(--mud-palette-primary); font-weight: 600; }

        /* Sub-tab pane visibility inside the overlay (chat + index were dropped by the wider tiers — re-show the
           active one; more-specific selectors beat those !important hides). */
        .wb-detail .wb-index { flex: 1 1 auto !important; }
        .wb-detail.wb-ptab-preview .wb-index { display: none; }
        .wb-detail.wb-ptab-preview .wb-detail-bottom { display: flex; }
        .wb-detail.wb-ptab-preview .wb-preview { display: flex; flex: 1 1 auto; }
        .wb-detail.wb-ptab-preview .wb-chat { display: none !important; }
        .wb-detail.wb-ptab-details .wb-index { display: flex !important; }
        .wb-detail.wb-ptab-details .wb-detail-bottom { display: none; }
        .wb-detail.wb-ptab-comments .wb-index { display: none; }
        .wb-detail.wb-ptab-comments .wb-detail-bottom { display: flex; }
        .wb-detail.wb-ptab-comments .wb-preview { display: none; }
        .wb-detail.wb-ptab-comments .wb-chat { display: flex !important; flex: 1 1 auto; }
    }
</style>

<AuthorizeView>
    <Authorized>
        <div class="wb" @ref="_dropRoot">
            @* ---- Ribbon (Repositories tab) ---- *@
            <div class="wb-ribbon">
                @* Ribbon buttons (#305): icon-only on hover-capable computers with the label in a `title` tooltip +
                   `aria-label`; touch keeps the visible .wb-rib-label. Matches the desktop client + the #298 tabs
                   (ADR 0511). The icon + label are our own child content so hiding the label leaves a clean icon. *@
                @if (_activeTab == Tab.Repositories)
                {
                    <MudButton Class="wb-rib-btn" Size="Size.Small" Disabled="@(_selectedFolder is null)" OnClick="UploadAsync" title="@Strings.Get("Upload")" aria-label="@Strings.Get("Upload")">
                        <MudIcon Icon="@Icons.Material.Filled.Upload" Size="Size.Small" /><span class="wb-rib-label">@Strings.Get("Upload")</span>
                    </MudButton>
                    <MudButton Class="wb-rib-btn" data-tour="action-new-folder" Size="Size.Small" Disabled="@(_selectedFolder is null)" OnClick="NewFolderAsync" title="@Strings.Get("NewFolder")" aria-label="@Strings.Get("NewFolder")">
                        <MudIcon Icon="@Icons.Material.Filled.CreateNewFolder" Size="Size.Small" /><span class="wb-rib-label">@Strings.Get("NewFolder")</span>
                    </MudButton>
                    <MudButton Class="wb-rib-btn" Size="Size.Small" Disabled="@(_downloadUrl is null)" OnClick="DownloadAsync" title="@Strings.Get("Download")" aria-label="@Strings.Get("Download")">
                        <MudIcon Icon="@Icons.Material.Filled.Download" Size="Size.Small" /><span class="wb-rib-label">@Strings.Get("Download")</span>
                    </MudButton>
                    <MudButton Class="wb-rib-btn" Size="Size.Small" Disabled="@(_selectedItem is null)" OnClick="() => OpenVersionsAsync(_selectedItem!)" title="@Strings.Get("RibbonVersions")" aria-label="@Strings.Get("RibbonVersions")">
                        <MudIcon Icon="@Icons.Material.Filled.History" Size="Size.Small" /><span class="wb-rib-label">@Strings.Get("RibbonVersions")</span>
                    </MudButton>
                    <MudButton Class="wb-rib-btn" Size="Size.Small" Disabled="@(_selectedItem is null)" OnClick="() => OpenWorkflowAsync(_selectedItem!)" title="@Strings.Get("RibbonStartWorkflow")" aria-label="@Strings.Get("RibbonStartWorkflow")">
                        <MudIcon Icon="@Icons.Material.Filled.AccountTree" Size="Size.Small" /><span class="wb-rib-label">@Strings.Get("RibbonStartWorkflow")</span>
                    </MudButton>
                    <MudButton Class="wb-rib-btn" Size="Size.Small" OnClick="RefreshAsync" title="@Strings.Get("RibbonRefresh")" aria-label="@Strings.Get("RibbonRefresh")">
                        <MudIcon Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" /><span class="wb-rib-label">@Strings.Get("RibbonRefresh")</span>
                    </MudButton>
                    @* "My external links" — everything the caller has shared, across documents (ADR 0546). A
                       cross-document review surface, so it belongs to the general group rather than to the selected
                       document, matching where the desktop puts it (ADR 0511). Hidden until the API root
                       advertises the rel: its absence means the feature is not available here. *@
                    @if (_myExternalLinksHref is not null)
                    {
                        <MudButton Class="wb-rib-btn" Size="Size.Small" OnClick="OpenMyExternalLinksAsync" title="@Strings.Get("ExtLinkMyLinks")" aria-label="@Strings.Get("ExtLinkMyLinks")">
                            <MudIcon Icon="@Icons.Material.Filled.Link" Size="Size.Small" /><span class="wb-rib-label">@Strings.Get("ExtLinkMyLinks")</span>
                        </MudButton>
                    }
                    @if (_isTenantAdmin)
                    {
                        <MudButton Class="wb-rib-btn" Size="Size.Small" OnClick="RunTiffBackfillAsync" title="@Strings.Get("RibbonConvertScans")" aria-label="@Strings.Get("RibbonConvertScans")">
                            <MudIcon Icon="@Icons.Material.Filled.PictureAsPdf" Size="Size.Small" /><span class="wb-rib-label">@Strings.Get("RibbonConvertScans")</span>
                        </MudButton>
                    }
                    @if (_canExport)
                    {
                        <MudButton Class="wb-rib-btn" Size="Size.Small" Disabled="@(_selectedFolder is null)" OnClick="OpenExportDialogAsync" title="@Strings.Get("HomeExport")" aria-label="@Strings.Get("HomeExport")">
                            <MudIcon Icon="@Icons.Material.Filled.Archive" Size="Size.Small" /><span class="wb-rib-label">@Strings.Get("HomeExport")</span>
                        </MudButton>
                    }
                    @if (_canImport)
                    {
                        <MudButton Class="wb-rib-btn" Size="Size.Small" OnClick="OpenImportDialogAsync" title="@Strings.Get("HomeImport")" aria-label="@Strings.Get("HomeImport")">
                            <MudIcon Icon="@Icons.Material.Filled.Unarchive" Size="Size.Small" /><span class="wb-rib-label">@Strings.Get("HomeImport")</span>
                        </MudButton>
                    }
                    @if (_uploading)
                    {
                        <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="ml-2" />
                    }
                }
                else
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">@Strings.Get("NoActions")</MudText>
                }
            </div>

            @* ---- Tab content ---- *@
            @if (_activeTab == Tab.Repositories)
            {
                @* Phone-only top bar (ADR "Responsive phone drill-down"): the hamburger toggles the tree drawer;
                   the current folder name. Rendered ONLY in phone mode (not merely CSS-hidden) so its duplicate
                   folder-name text can't collide with the desktop tests' text locators. *@
                @if (_isPhone)
                {
                    <div class="wb-phone-topbar">
                        <MudIconButton Icon="@Icons.Material.Filled.Menu" Size="Size.Small" aria-label="Folders" OnClick="ToggleTreeDrawer" />
                        <span class="wb-phone-title">@(_selectedFolder?.Name ?? Strings.Get("TabRepositories"))</span>
                    </div>
                }
                <div class="wb-cols @(_treeDrawerOpen ? "wb-phone-tree-open" : "")" @ref="_layoutRoot">
                    @* Scrim behind the open tree drawer — tap to close (phone only). *@
                    @if (_isPhone)
                    {
                        <div class="wb-phone-scrim @(_treeDrawerOpen ? "wb-phone-scrim-on" : "")" @onclick="() => _treeDrawerOpen = false"></div>
                    }
                    @* The tree pane (ADR 0558). Its nodes live in the injected TreeState, not in the
                       component — this whole tab is torn down on a tab switch. The menu items are the
                       SHELL's operations, so they are supplied here rather than owned by the pane. *@
                    <TreePane @ref="_treePane" SelectedFolder="_selectedFolder" FolderSelected="SelectFolderAsync">
                        <NodeMenu Context="tn">
                            <MudMenuItem Icon="@Icons.Material.Filled.CreateNewFolder" OnClick="NewFolderAsync">@Strings.Get("MwNewSubfolder")</MudMenuItem>
                            <MudMenuItem Icon="@Icons.Material.Filled.Upload" OnClick="UploadAsync">@Strings.Get("Upload")</MudMenuItem>
                            <MudDivider />
                            <MudMenuItem Icon="@Icons.Material.Filled.Edit" OnClick="() => RunAndRefreshAsync(Actions.RenameAsync(tn))">@Strings.Get("CtxRename")</MudMenuItem>
                            <MudMenuItem Icon="@Icons.Material.Filled.DriveFileMove" OnClick="() => RunAndRefreshAsync(Actions.MoveAsync(tn))">@Strings.Get("CtxMoveTo")</MudMenuItem>
                            @* Opens the ONE detail edit on this folder (issue #408) — the contents order is a
                               field in that pane now, not a mode of its own. *@
                            <MudMenuItem Icon="@Icons.Material.Filled.Sort" OnClick="@(() => BeginFolderSortEditAsync(tn))">@Strings.Get("FolderSortLabel")</MudMenuItem>
                            <MudMenuItem Icon="@Icons.Material.Filled.Delete" IconColor="Color.Error" OnClick="() => DeleteRowAsync(tn)">@Strings.Get("UgDelete")</MudMenuItem>
                            <MudDivider />
                            <MudMenuItem Icon="@Icons.Material.Filled.Security" OnClick="() => Actions.OpenManageAccessAsync(tn)">@Strings.Get("MaManageAccess")</MudMenuItem>
                            @if (_canLegalHold)
                            {
                                <MudMenuItem Icon="@Icons.Material.Filled.Gavel" OnClick="() => RunAndRefreshAsync(Actions.PlaceLegalHoldAsync(tn))">@Strings.Get("CtxPlaceLegalHold")</MudMenuItem>
                            }
                            <MudDivider />
                            <MudMenuItem Icon="@Icons.Material.Filled.Link" OnClick="() => RunAndRefreshAsync(Actions.PlaceReferenceAsync(tn))">@Strings.Get("CtxPlaceReference")</MudMenuItem>
                            @if (tn.HasReferences)
                            {
                                <MudMenuItem Icon="@Icons.Material.Filled.Share" OnClick="() => ShowReferencesForAsync(tn)">@Strings.Get("CtxReferences")</MudMenuItem>
                            }
                            <MudDivider />
                            <MudMenuItem Icon="@(_folderSubscribed ? Icons.Material.Filled.NotificationsOff : Icons.Material.Filled.Notifications)"
                                         OnClick="ToggleFolderSubscriptionAsync">@Strings.Get(_folderSubscribed ? "UnfollowFolder" : "MwFollowFolder")</MudMenuItem>
                            <MudDivider />
                            @if (_canExport)
                            {
                                <MudMenuItem Icon="@Icons.Material.Filled.Archive" OnClick="OpenExportDialogAsync">@Strings.Get("HomeExport")</MudMenuItem>
                            }
                            <MudMenuItem Icon="@Icons.Material.Filled.Refresh" OnClick="RefreshAsync">@Strings.Get("RibbonRefresh")</MudMenuItem>
                        </NodeMenu>
                    </TreePane>

                    <div class="wb-gutter wb-gutter-v" data-gutter="tree"><button type="button" class="wb-gutter-toggle"></button></div>

                    @* The whole contents pane is a drop target for the currently-listed folder, so files
                       can be dropped anywhere in it (empty area or a document row), not only onto a
                       sub-folder row — see ADR "Content-pane drop target". A sub-folder row's own
                       data-drop-folder still wins (closest() finds the nearest one). *@
                    <div class="wb-pane wb-list" data-pane="list" data-tour="pane-list" data-tour-rows="@_folderContents.Count" @attributes="ListDropAttributes()">
                        @* Bulk-action bar (ADR "Bulk actions on selected documents") — shows when ≥2 rows are Ctrl/Shift-selected. *@
                        @if (_bulkIds.Count >= 2 && _archiveDocument is null)
                        {
                            <div class="wb-bulk-bar">
                                <span style="flex:1 1 auto; font-size:.8rem; font-weight:600;">@string.Format(Strings.Get("BulkSelected"), _bulkIds.Count)</span>
                                <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.DriveFileMove" OnClick="BulkMoveAsync">@Strings.Get("BulkMove")</MudButton>
                                <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.Label" OnClick="BulkAddTagsAsync">@Strings.Get("BulkTag")</MudButton>
                                <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.Shield" OnClick="BulkSensitivityAsync">@Strings.Get("BulkSensLabel")</MudButton>
                                <MudButton Size="Size.Small" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" OnClick="BulkDeleteAsync">@Strings.Get("UgDelete")</MudButton>
                                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="() => { _bulkIds.Clear(); }" title="@Strings.Get("BulkClearSelection")" />
                            </div>
                        }
                        @if (_archiveDocument is not null)
                        {
                            @* Browsing a .zip's entries virtually — read on demand, nothing unpacked (ADR "Zip file browsing"). *@
                            <div class="wb-list-row" @onclick="ExitArchiveAsync" style="cursor:pointer;">
                                <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" />
                                <span style="flex:1 1 auto;">@_archiveDocument.Name@Strings.Get("ArchiveBack")</span>
                            </div>
                            @if (_archiveEntries.Count == 0)
                            {
                                <MudText Typo="Typo.body2" Class="pa-3 mud-text-secondary">@Strings.Get("ArchiveEmpty")</MudText>
                            }
                            @foreach (var entry in _archiveEntries)
                            {
                                <div class="wb-list-row" @onclick="() => DownloadArchiveEntryAsync(entry)" style="cursor:pointer;" title="@Strings.Get("Download")">
                                    <MudIcon Icon="@Icons.Material.Filled.InsertDriveFile" Size="Size.Small" />
                                    <span style="flex:1 1 auto; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@entry.Path</span>
                                    <span class="mud-text-secondary" style="font-size:0.8em;">@ByteSize.Format(entry.Size)</span>
                                </div>
                            }
                        }
                        else if (_selectedFolder is null)
                        {
                            <MudText Typo="Typo.body2" Class="pa-3 mud-text-secondary">@Strings.Get("SelectFolderTree")</MudText>
                        }
                        else if (_folderContents.Count == 0)
                        {
                            <MudText Typo="Typo.body2" Class="pa-3 mud-text-secondary">@Strings.Get("EmptyFolderDrop")</MudText>
                        }
                        else
                        {
                            @* Sortable column header (ADR "List-row columns and sorting"). *@
                            <div class="wb-chead">
                                <span @onclick="() => SortBy(ContentSort.Name)">@Strings.Get("Name") @SortArrow(ContentSort.Name)</span>
                                <span @onclick="() => SortBy(ContentSort.Type)">@Strings.Get("FacetType") @SortArrow(ContentSort.Type)</span>
                                <span @onclick="() => SortBy(ContentSort.Date)">@Strings.Get("SortDocDate") @SortArrow(ContentSort.Date)</span>
                                <span @onclick="() => SortBy(ContentSort.Size)">@Strings.Get("SortSize") @SortArrow(ContentSort.Size)</span>
                                <span @onclick="() => SortBy(ContentSort.Tags)">@Strings.Get("TagsLabel") @SortArrow(ContentSort.Tags)</span>
                                <span></span>
                            </div>
                            @foreach (var node in SortedContents())
                            {
                                var attrs = BrowseService.DropAttributes(node);
                                <div class="wb-list-row wb-cols @(_bulkIds.Contains(node.Id) || ReferenceEquals(node, _commentTarget) ? "wb-list-row-selected" : "")"
                                     @onclick="(e) => OnRowClickAsync(node, e)" @ondblclick="() => OnRowDoubleClickAsync(node)" @attributes="attrs">
                                    <span class="wb-ccell wb-cname" title="@node.DisplayName">
                                        <MudIcon Icon="@BrowseService.TreeIcon(node)" Size="Size.Small"
                                                 Class="@(node.IsFolder ? (node.IsEmptyFolder ? "wb-glyph-empty" : "wb-glyph-folder") : "")" />
                                        <span style="flex:1 1 auto; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@node.DisplayName</span>
                                        @if (node.OnLegalHold)
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Color="Color.Warning" title="@Strings.Get("LhUnderHold")" />
                                        }
                                        @if (node.CheckedOutByMe)
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.LockOpen" Size="Size.Small" Color="Color.Success" title="@Strings.Get("CoLockedMine")" />
                                        }
                                        else if (node.CheckedOutByOther)
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Color="Color.Error" title="@Strings.Get("CoLockedOther")" />
                                        }
                                        @if (!string.IsNullOrEmpty(node.SensitivityLabelName))
                                        {
                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Class="ma-0"
                                                     Style="@($"{ChipStyle(node.SensitivityLabelColor)}height:16px; font-size:.62rem;")" title="@string.Format(Strings.Get("SensitivityTip"), node.SensitivityLabelName)">@node.SensitivityLabelName</MudChip>
                                        }
                                    </span>
                                    <span class="wb-ccell" title="@node.DocumentType">@(node.IsFolder ? Strings.Get("FolderType") : node.DocumentType)</span>
                                    <span class="wb-ccell" title="@(node.DocumentDate?.ToString("yyyy-MM-dd") ?? "")">@(node.DocumentDate?.ToString("yyyy-MM-dd") ?? "")</span>
                                    <span class="wb-ccell" title="@ByteSize.Format(node.SizeBytes)">@ByteSize.Format(node.SizeBytes)</span>
                                    <span class="wb-ccell" title="@string.Join(", ", node.TagList)">@string.Join(", ", node.TagList)</span>
                                    <div @onclick:stopPropagation="true">
                                        <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true" AnchorOrigin="Origin.BottomLeft">
                                            @if (!node.IsReference)
                                            {
                                                <MudMenuItem Icon="@Icons.Material.Filled.Edit" OnClick="() => RunAndRefreshAsync(Actions.RenameAsync(node))">@Strings.Get("CtxRename")</MudMenuItem>
                                                <MudMenuItem Icon="@Icons.Material.Filled.DriveFileMove" OnClick="() => RunAndRefreshAsync(Actions.MoveAsync(node))">@Strings.Get("CtxMoveTo")</MudMenuItem>
                                            }
                                            @if (!node.IsReference && _canLegalHold)
                                            {
                                                <MudMenuItem Icon="@Icons.Material.Filled.Gavel" OnClick="() => RunAndRefreshAsync(Actions.PlaceLegalHoldAsync(node))">@Strings.Get("CtxPlaceLegalHold")</MudMenuItem>
                                            }
                                            @if (!node.IsReference && !node.IsFolder && !node.CheckedOut)
                                            {
                                                <MudMenuItem Icon="@Icons.Material.Filled.Lock" OnClick="() => CheckOutAsync(node)">@Strings.Get("CtxCheckOut")</MudMenuItem>
                                            }
                                            @if (!node.IsReference && node.CheckedOutByOther && _canOverrideCheckout)
                                            {
                                                <MudMenuItem Icon="@Icons.Material.Filled.LockOpen" OnClick="() => OverrideCheckoutAsync(node)">@Strings.Get("CtxOverrideCheckout")</MudMenuItem>
                                            }
                                            <MudMenuItem Icon="@Icons.Material.Filled.Link" OnClick="() => RunAndRefreshAsync(Actions.PlaceReferenceAsync(node))">@Strings.Get("CtxPlaceReference")</MudMenuItem>
                                            @if (node.IsReference)
                                            {
                                                <MudMenuItem Icon="@Icons.Material.Filled.ArrowForward" OnClick="() => GoToAsync(node)">@Strings.Get("CtxGoTo")</MudMenuItem>
                                                <MudMenuItem Icon="@Icons.Material.Filled.LinkOff" OnClick="() => RemoveReferenceAsync(node)">@Strings.Get("CtxRemoveReference")</MudMenuItem>
                                            }
                                            @if (node.HasReferences)
                                            {
                                                <MudMenuItem Icon="@Icons.Material.Filled.Share" OnClick="() => ShowReferencesForAsync(node)">@Strings.Get("CtxReferences")</MudMenuItem>
                                            }
                                            @if (!node.IsFolder && node.VersionCount > 1)
                                            {
                                                <MudMenuItem Icon="@Icons.Material.Filled.History" OnClick="() => OpenVersionsAsync(node)">@Strings.Get("CtxVersions")</MudMenuItem>
                                            }
                                            @if (!node.IsFolder)
                                            {
                                                <MudMenuItem Icon="@Icons.Material.Filled.AccountTree" OnClick="() => OpenWorkflowAsync(node)">@Strings.Get("CtxStartWorkflow")</MudMenuItem>
                                            }
                                            @if (!node.IsReference)
                                            {
                                                <MudMenuItem Icon="@Icons.Material.Filled.Security" OnClick="() => Actions.OpenManageAccessAsync(node)">@Strings.Get("MaManageAccess")</MudMenuItem>
                                                <MudMenuItem Icon="@Icons.Material.Filled.Delete" IconColor="Color.Error" OnClick="() => DeleteRowAsync(node)">@Strings.Get("UgDelete")</MudMenuItem>
                                            }
                                        </MudMenu>
                                    </div>
                                </div>
                            }
                        }
                    </div>

                    <div class="wb-gutter wb-gutter-v" data-gutter="list"><button type="button" class="wb-gutter-toggle"></button></div>

                    <div class="wb-detail @(_isPhone && _selectedItem is not null ? "wb-phone-detail-open" : "") wb-ptab-@_phoneDetailTab">
                        @* Phone-only detail bar: back to the folder list + Preview/Details/Comments sub-tabs
                           (ADR "Responsive phone drill-down"). Rendered ONLY in phone mode so its button text
                           can't collide with the desktop tests' locators. *@
                        @if (_isPhone)
                        {
                            <div class="wb-phone-detbar">
                                <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" aria-label="Back" OnClick="PhoneBack" />
                                <button type="button" class="wb-ptab-btn @(_phoneDetailTab == "preview" ? "wb-ptab-on" : "")" @onclick='() => SetPhoneTab("preview")'>@Strings.Get("PhoneTabPreview")</button>
                                <button type="button" class="wb-ptab-btn @(_phoneDetailTab == "details" ? "wb-ptab-on" : "")" @onclick='() => SetPhoneTab("details")'>@Strings.Get("PhoneTabDetails")</button>
                                <button type="button" class="wb-ptab-btn @(_phoneDetailTab == "comments" ? "wb-ptab-on" : "")" @onclick='() => SetPhoneTab("comments")'>@Strings.Get("PhoneTabComments")</button>
                            </div>
                        }
                        @* Esc cancels the edit (ADR 0550). tabindex makes the pane focusable so it can receive the
                           key at all.

                           NO preventDefault, and therefore NO Ctrl/Cmd+S on the web. The attribute is evaluated per
                           RENDER for every key, not per keystroke — so binding it to _isEditing prevented the
                           default on EVERY key while editing, and typing into any field in this pane produced
                           nothing at all. It broke tag entry outright, which the UI suite caught.
                           Suppressing the browser's own Save dialog needs a document-level JS handler (the pattern
                           wbLayout.js uses); until that exists the web keeps Esc, which needs no preventDefault,
                           and ⌘S stays a desktop affordance where it works properly. *@
                        <div class="wb-pane wb-index" data-pane="index" data-tour="pane-index" tabindex="-1"
                             @onkeydown="OnDetailKeyDown">
                            @if (_detailNode is null)
                            {
                                <MudText Typo="Typo.body2" Class="mud-text-secondary">@Strings.Get("SelectDocDetail")</MudText>
                            }
                            else
                            {
                                <div class="wb-detail-head @(_detailNode?.TreeGlyphClass) @(_isEditing ? "wb-editing" : "")" style="display:flex; align-items:center; gap:4px;">
                                    @* The SAME glyph the tree draws for this object (ADR 0547): a folder looks like a
                                       folder — and an empty one like an empty one — wherever it appears, rather than
                                       changing style depending on which pane you are looking at. *@
                                    @if (_detailNode is { } glyphNode)
                                    {
                                        <MudIcon Icon="@BrowseService.TreeIcon(glyphNode)" Size="Size.Small" Class="wb-detail-glyph" />
                                    }
                                    <MudText Typo="Typo.subtitle1" Style="flex:1 1 auto; min-width:0;">@_sysName</MudText>
                                    @* While EDITING, the actions that can do nothing disappear and the commit controls
                                       take their slots (ADR 0550) — the row does not reflow under the cursor that just
                                       clicked the pencil, and Save/Cancel are where that pencil was. *@
                                    @if (_isEditing)
                                    {
                                        <MudTooltip Text="@Strings.Get("Save")">
                                            <MudIconButton data-tour="action-save-index" Size="Size.Small" aria-label="@Strings.Get("Save")" Color="Color.Primary"
                                                           Icon="@Icons.Material.Filled.Save" OnClick="SaveDetailAsync" Disabled="_detailBusy" />
                                        </MudTooltip>
                                        <MudTooltip Text="@Strings.Get("Cancel")">
                                            <MudIconButton Size="Size.Small" aria-label="@Strings.Get("Cancel")"
                                                           Icon="@Icons.Material.Filled.Close" OnClick="CancelEdit" Disabled="_detailBusy" />
                                        </MudTooltip>
                                    }
                                    else
                                    {
                                    @* Follow / unfollow this document (ADR "Document subscriptions"). *@
                                    <MudTooltip Text="@(_detailSubscribed ? Strings.Get("UnfollowDoc") : Strings.Get("FollowDoc"))">
                                        <MudIconButton Size="Size.Small" aria-label="Follow"
                                                       Icon="@(_detailSubscribed ? Icons.Material.Filled.Notifications : Icons.Material.Outlined.NotificationsNone)"
                                                       Color="@(_detailSubscribed ? Color.Primary : Color.Default)"
                                                       OnClick="ToggleSubscriptionAsync" />
                                    </MudTooltip>
                                    @* Set a reminder (Wiedervorlage) on this document (ADR "Document reminders"). *@
                                    <MudTooltip Text="@Strings.Get("RemindTooltip")">
                                        <MudIconButton Size="Size.Small" aria-label="Remind" Icon="@Icons.Material.Filled.Alarm" OnClick="OpenReminderDialogAsync" />
                                        @if (_detailExternalLinksHref is not null)
                                        {
                                            <MudTooltip Text="@Strings.Get("ExtLinkManage")">
                                                <MudIconButton Size="Size.Small" aria-label="@Strings.Get("ExtLinkManage")"
                                                               Icon="@Icons.Material.Filled.Link" OnClick="OpenExternalLinksDialogAsync" />
                                            </MudTooltip>
                                        }
                                    </MudTooltip>
                                    @* Manage access (ACL) — only when the caller can manage permissions (ADR "Manage-access UI"). *@
                                    @if (_detailCanManagePermissions)
                                    {
                                        <MudTooltip Text="@Strings.Get("MaManageAccess")">
                                            <MudIconButton data-tour="action-manage-access" Size="Size.Small" aria-label="Manage access" Icon="@Icons.Material.Filled.Security" OnClick="() => OpenManageAccessForSelectedAsync()" />
                                        </MudTooltip>
                                    }
                                    @* Edit the index data (issue #407). It belongs beside the thing it edits, in the row of
                                       per-document actions, rather than at the far end of the pane where it began — and
                                       icon-only like its neighbours, so the row stays one vocabulary. Always visible rather
                                       than on hover: touch has no hover (ADR 0511). Save and Cancel stay down with the
                                       FIELDS, because they act on the form rather than on the document. *@
                                    @if (CanEditDetail)
                                    {
                                        <MudTooltip Text="@Strings.Get("Edit")">
                                            <MudIconButton data-tour="action-edit-index" Size="Size.Small" aria-label="@Strings.Get("Edit")" Icon="@Icons.Material.Filled.Edit"
                                                           OnClick="BeginEditAsync" Disabled="_detailBusy" />
                                        </MudTooltip>
                                    }
                                    }
                                </div>

                                @* System fields (ADR 0273). Rendered for a FOLDER as well since issue #408 — the rows
                                   that come from a VERSION stay conditional, because a folder has none, but Name and the
                                   mask below are as real for a folder as for a document. *@
                                <table class="wb-sysfields">
                                        <tr>
                                            <td>@Strings.Get("Name")</td>
                                            <td>
                                                @if (_isEditing)
                                                {
                                                    <MudTextField @bind-Value="_editName" Margin="Margin.Dense" Variant="Variant.Outlined" />
                                                }
                                                else
                                                {
                                                    @_sysName
                                                }
                                            </td>
                                        </tr>
                                        @if (_sysHasVersion)
                                        {
                                        <tr><td>@Strings.Get("SysFileExtension")</td><td class="wb-sys-muted">@_sysFileExtension</td></tr>
                                        <tr>
                                            <td>@Strings.Get("VerColDocDate")</td>
                                            <td>
                                                @if (_isEditing)
                                                {
                                                    <MudDatePicker @bind-Date="_editDocumentDate" DateFormat="yyyy-MM-dd" Margin="Margin.Dense" Variant="Variant.Outlined" />
                                                }
                                                else
                                                {
                                                    @(_sysDocumentDate?.ToString("yyyy-MM-dd"))
                                                }
                                            </td>
                                        </tr>
                                        @if (_sysHasTiff)
                                        {
                                            <tr>
                                                <td>@Strings.Get("SysOcrLanguages")</td>
                                                <td>
                                                    @if (_isEditing)
                                                    {
                                                        <div class="wb-ocr-chips">
                                                            @foreach (var lang in _ocrCatalog)
                                                            {
                                                                var idx = _editOcrCodes.IndexOf(lang.Code);
                                                                <button type="button" class="wb-ocr-chip @(idx >= 0 ? "wb-ocr-chip-on" : "")" @onclick="() => ToggleOcr(lang.Code)">
                                                                    @(idx >= 0 ? $"{idx + 1}. " : "")@lang.DisplayName
                                                                </button>
                                                            }
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        @OcrDisplay(_sysOcrCodes)
                                                    }
                                                </td>
                                            </tr>
                                        }
                                        <tr><td>@Strings.Get("SysCreated")</td><td class="wb-sys-muted">@_sysCreated</td></tr>
                                        <tr><td>@Strings.Get("SysCreatedBy")</td><td class="wb-sys-muted">@_sysCreatedBy</td></tr>
                                        }
                                        @* The document's current (latest confirmed) version number, directly below Created by
                                           (ADR "Mask-pane current-version line"). *@
                                        @if (_sysCurrentVersion is { } curVer)
                                        {
                                            <tr><td>@Strings.Get("SysCurrentVersion")</td><td class="wb-current-version wb-sys-muted">@curVer</td></tr>
                                        }
                                        @if (_detailRetention is { } ret)
                                        {
                                            <tr>
                                                <td>@Strings.Get("SysRetention")</td>
                                                <td class="wb-sys-muted">
                                                    @ret.RetentionYears years · disposition @ret.DispositionDate@(ret.SuspendedByHold ? " (suspended — legal hold)" : "")
                                                </td>
                                            </tr>
                                        }
                                        @* Folder-only: the order this folder lists its contents in (ADR "Per-folder
                                           contents sort order"). It rides in the same pane and the same edit as the
                                           mask now, rather than in a pane of its own with its own Edit button. *@
                                        @if (_detailNode?.IsFolder == true)
                                        {
                                            <tr>
                                                <td>@Strings.Get("FolderSortLabel")</td>
                                                <td>
                                                    @if (_isEditing)
                                                    {
                                                        <MudSelect T="FolderContentsSortOrder" @bind-Value="_editSortOrder" Margin="Margin.Dense" Variant="Variant.Outlined" Dense="true">
                                                            <MudSelectItem Value="FolderContentsSortOrder.Name">@Strings.Get("FolderSortName")</MudSelectItem>
                                                            <MudSelectItem Value="FolderContentsSortOrder.DocumentDate">@Strings.Get("FolderSortDocDate")</MudSelectItem>
                                                            <MudSelectItem Value="FolderContentsSortOrder.Created">@Strings.Get("FolderSortCreated")</MudSelectItem>
                                                        </MudSelect>
                                                    }
                                                    else
                                                    {
                                                        @FolderSortText(_detailSortOrder)
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </table>

                                @if (_isEditing)
                                {
                                    @* Mask edit: pick the mask + type-aware field editors. *@
                                    <div class="wb-mask-edit">
                                        <div class="wb-mask-row">
                                            <span class="wb-mask-label">@Strings.Get("MaskLabel")</span>
                                            <MudSelect T="Guid?" Value="_editMaskId" ValueChanged="OnEditMaskChanged" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined">
                                                <MudSelectItem T="Guid?" Value="@((Guid?)null)">@Strings.Get("NoMask")</MudSelectItem>
                                                @foreach (var m in _availableMasks)
                                                {
                                                    <MudSelectItem T="Guid?" Value="@((Guid?)m.Id)">@m.Name</MudSelectItem>
                                                }
                                            </MudSelect>
                                        </div>
                                        @* Sensitivity label (ADR "Configurable sensitivity labels + upload defaults"). *@
                                        <div class="wb-mask-row">
                                            <span class="wb-mask-label">@Strings.Get("BulkSensLabel")</span>
                                            <MudSelect T="Guid?" @bind-Value="_editSensitivityId" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Clearable="true">
                                                <MudSelectItem T="Guid?" Value="@((Guid?)null)">(None)</MudSelectItem>
                                                @foreach (var lbl in _sensitivityLabels.Where(l => !l.Retired || l.Id == _editSensitivityId))
                                                {
                                                    <MudSelectItem T="Guid?" Value="@((Guid?)lbl.Id)">@lbl.Name</MudSelectItem>
                                                }
                                            </MudSelect>
                                        </div>
                                        @foreach (var f in _editFields)
                                        {
                                            <div class="wb-mask-row">
                                                <span class="wb-mask-label">@f.Label</span>
                                                @if (f.IsDate)
                                                {
                                                    <MudDatePicker @bind-Date="f.DateValue" DateFormat="yyyy-MM-dd" Margin="Margin.Dense" Variant="Variant.Outlined" />
                                                }
                                                else if (f.IsBoolean)
                                                {
                                                    <MudCheckBox T="bool" @bind-Value="f.BoolValue" />
                                                }
                                                else if (f.IsMultiSelect)
                                                {
                                                    <MudTextField @bind-Value="f.TextValue" Lines="3" Placeholder="@Strings.Get("OneValuePerLine")" Margin="Margin.Dense" Variant="Variant.Outlined" />
                                                }
                                                else
                                                {
                                                    <MudTextField @bind-Value="f.TextValue" Margin="Margin.Dense" Variant="Variant.Outlined" />
                                                }
                                            </div>
                                        }
                                        @* Free-form tags (ADR "Document tags") — chips + an autocomplete add box over the tenant catalog. *@
                                        <div class="wb-mask-row">
                                            <span class="wb-mask-label">@Strings.Get("TagsLabel")</span>
                                            <div style="display:flex; flex-direction:column; gap:4px; min-width:0;">
                                                @if (_editTags.Count > 0)
                                                {
                                                    <div style="display:flex; flex-wrap:wrap; gap:4px;">
                                                        @foreach (var t in _editTags)
                                                        {
                                                            <MudChip T="string" Size="Size.Small" Style="@ChipStyle(TagColor(t))" OnClose="@(() => _editTags.Remove(t))">@t</MudChip>
                                                        }
                                                    </div>
                                                }
                                                <div style="display:flex; align-items:center; gap:4px;">
                                                    <MudAutocomplete T="string" @bind-Value="_newTag" SearchFunc="SearchTagCatalog" CoerceValue="true"
                                                                     Placeholder="@Strings.Get("TagAddPlaceholder")" Margin="Margin.Dense" Variant="Variant.Outlined" Style="max-width:200px;"
                                                                     OnKeyUp="OnTagKeyUp" Immediate="true" />
                                                    @* Explicit Add — Enter also works, but a click is a deterministic commit path (MudAutocomplete's Enter binding can lag). *@
                                                    <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" aria-label="Add tag" OnClick="AddCurrentTag" />
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2">
                                        Mask: @(_detailMaskName ?? "none")@(_detailVersionNumber is { } vn ? $" · version {vn}" : "")
                                    </MudText>
                                    @if (_detailSensitivityId is not null)
                                    {
                                        <MudChip T="string" Size="Size.Small" Style="@ChipStyle(_detailSensitivityColor)" Variant="Variant.Filled" Class="mt-1" Icon="@Icons.Material.Filled.Shield">@_detailSensitivityName</MudChip>
                                    }
                                    @if (_detailIndexData is { Count: > 0 })
                                    {
                                        <MudSimpleTable Dense="true" Bordered="false" Class="mt-2">
                                            <tbody>
                                                @foreach (var field in _detailIndexData)
                                                {
                                                    <tr><td>@field.FieldName</td><td>@string.Join(", ", field.Values)</td></tr>
                                                }
                                            </tbody>
                                        </MudSimpleTable>
                                    }
                                    @if (_detailTags is { Count: > 0 })
                                    {
                                        <div style="display:flex; flex-wrap:wrap; gap:4px;" class="mt-2">
                                            @foreach (var t in _detailTags)
                                            {
                                                <MudChip T="string" Size="Size.Small" Style="@ChipStyle(TagColor(t))" Icon="@Icons.Material.Filled.Label" OnClick="@(() => SearchByTagAsync(t))">@t</MudChip>
                                            }
                                        </div>
                                    }
                                }

                                @* Save/Cancel are NOT here any more — they live in the header row, where the pencil
                                   that started the edit is (ADR 0550). Compare versions stays: it is about the
                                   document's history, not about editing it. *@
                                <div class="wb-detail-actions">
                                    @if (!_isEditing && _detailVersionCount >= 2)
                                    {
                                        @* Edit moved to the header (issue #407); Compare versions stays, being about the
                                           document's history rather than about editing it. *@
                                        <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Difference" OnClick="OpenCompareVersionsAsync">@Strings.Get("CompareVersionsBtn")</MudButton>
                                    }
                                </div>
                            }
                        </div>
                        <div class="wb-gutter wb-gutter-h" data-gutter="index"><button type="button" class="wb-gutter-toggle"></button></div>

                        <div class="wb-detail-bottom">
                            @* One PreviewPane instance per tab (ADR 0558). Before the extraction this tab and
                               the Inbox SHARED one JS-owned host and one state object, kept apart only by a
                               reset on tab switch; an instance each removes that question entirely. The
                               annotation tools ride in as Toolbar, and the gestures come back through
                               IPreviewAnnotationHost, because acting on one writes to the version's
                               annotation collection — document state this pane deliberately does not hold. *@
                            <PreviewPane @ref="_repoPreview" DataPane="preview" DataTour="pane-preview"
                                         EmptyText="@(_selectedItem is null ? Strings.Get("NoDocSelected") : Strings.Get("NoPreview"))"
                                         ConvertedBadgeTooltip="@Strings.Get("ConvertedPreviewTooltip")"
                                         AnnotationHost="this" WordCopied="OnPreviewWordCopiedAsync">
                                <Toolbar>
                                            @if (_pvAnnotatable)
                                            {
                                                @* Sticky notes (ADR "Document annotations"): add a note (only with CanAnnotate,
                                                   ADR "CanAnnotate right"), and show/hide the markers (viewing needs only read). *@
                                                @if (_annotationsCanCreate && !_isTouchOnly)
                                                {
                                                    <MudIconButton Class="wb-pv-note-add" Icon="@Icons.Material.Filled.AddComment" Size="Size.Small" Color="@(_annotationAddMode ? Color.Primary : Color.Default)"
                                                                   OnClick="StartAddNoteAsync" title="@Strings.Get("AddStickyNote")" />
                                                    @* Markup tools (ADR "Annotation markup"): drag on the page to draw a highlight / rectangle / arrow. *@
                                                    <MudIconButton Class="wb-pv-tool-highlight" Icon="@Icons.Material.Filled.BorderColor" Size="Size.Small" Color="@(_annotationTool == 1 ? Color.Primary : Color.Default)"
                                                                   OnClick="@(() => SelectShapeToolAsync(1))" title="@Strings.Get("PvHighlight")" />
                                                    <MudIconButton Class="wb-pv-tool-rect" Icon="@Icons.Material.Filled.CropSquare" Size="Size.Small" Color="@(_annotationTool == 2 ? Color.Primary : Color.Default)"
                                                                   OnClick="@(() => SelectShapeToolAsync(2))" title="@Strings.Get("PvRectangle")" />
                                                    <MudIconButton Class="wb-pv-tool-arrow" Icon="@Icons.Material.Filled.NorthEast" Size="Size.Small" Color="@(_annotationTool == 3 ? Color.Primary : Color.Default)"
                                                                   OnClick="@(() => SelectShapeToolAsync(3))" title="@Strings.Get("PvArrow")" />
                                                    @* Colour palette (ADR "Highlighting redesign"): sets the draw colour for new shapes AND recolours the selected annotations. Shown while drawing or with a selection. *@
                                                    @if (_annotationTool > 0 || _hasAnnotationSelection)
                                                    {
                                                        <span class="wb-pv-palette">
                                                            @foreach (var c in AnnotationPalette)
                                                            {
                                                                <span class="wb-pv-swatch @(_annotationColor == c ? "wb-pv-swatch-on" : "")" style="@($"background:{c}")"
                                                                      @onclick="@(() => SetAnnotationColorAsync(c))" title="Set colour"></span>
                                                            }
                                                        </span>
                                                    }
                                                }
                                                <MudIconButton Class="wb-pv-note-toggle" Icon="@(_annotationsVisible ? Icons.Material.Filled.StickyNote2 : Icons.Material.Outlined.StickyNote2)" Size="Size.Small"
                                                               OnClick="ToggleAnnotationsAsync" title="@(_annotationsVisible ? Strings.Get("PvHideNotes") : Strings.Get("PvShowNotes"))" />
                                                @* Multi-select actions (ADR "Annotation multi-select" web parity): Ctrl-click / marquee to select, then copy / paste / delete. *@
                                                @if (_annotationsCanCreate && !_isTouchOnly)
                                                {
                                                    <MudIconButton Class="wb-pv-anno-copy" Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" Disabled="@(!_hasAnnotationSelection)"
                                                                   OnClick="CopySelectedAnnotations" title="@Strings.Get("CopyAnnotationsTip")" />
                                                    <MudIconButton Class="wb-pv-anno-paste" Icon="@Icons.Material.Filled.ContentPaste" Size="Size.Small" Disabled="@(!_hasAnnotationClipboard)"
                                                                   OnClick="PasteAnnotationsAsync" title="@Strings.Get("PasteAnnotationsTip")" />
                                                    <MudIconButton Class="wb-pv-anno-delete" Icon="@Icons.Material.Filled.DeleteOutline" Size="Size.Small" Disabled="@(!_hasAnnotationSelection)"
                                                                   OnClick="DeleteSelectedAnnotationsAsync" title="@Strings.Get("DeleteAnnotationsTip")" />
                                                }
                                            }
                                </Toolbar>
                                <Overlay>
                                    @if (_detailSensitivityWatermark)
                                    {
                                        @* Sensitivity watermark (ADR "Document watermarking") — Confidential/Restricted only. *@
                                        <div class="wb-watermark" style="@WatermarkStyle()"></div>
                                    }
                                </Overlay>
                            </PreviewPane>
                            <div class="wb-gutter wb-gutter-v" data-gutter="chat"><button type="button" class="wb-gutter-toggle"></button></div>

                            <div class="wb-chat" data-pane="chat" data-tour="pane-chat">
                                @if (_commentTarget is null)
                                {
                                    <div class="wb-chat-empty">
                                        <MudIcon Icon="@Icons.Material.Filled.Forum" Size="Size.Large" />
                                        <MudText Typo="Typo.body2">@Strings.Get("SelectForComments")</MudText>
                                    </div>
                                }
                                else
                                {
                                    <div class="wb-chat-header" style="display:flex; align-items:center; gap:8px;">
                                        <MudText Typo="Typo.subtitle2" style="flex:1 1 auto;">@Strings.Get("CommentsHeader")</MudText>
                                        @* Follow a folder and its whole subtree (ADR "Folder / subtree subscriptions"). *@
                                        @if (_commentTarget is { IsFolder: true })
                                        {
                                            <MudTooltip Text="@(_folderSubscribed ? Strings.Get("UnfollowFolder") : Strings.Get("FollowFolder"))">
                                                <MudIconButton Size="Size.Small" aria-label="Follow folder"
                                                               Icon="@(_folderSubscribed ? Icons.Material.Filled.Notifications : Icons.Material.Outlined.NotificationsNone)"
                                                               Color="@(_folderSubscribed ? Color.Primary : Color.Default)"
                                                               OnClick="ToggleFolderSubscriptionAsync" />
                                            </MudTooltip>
                                        }
                                    </div>
                                    @* The author identity card (ADR 0544) — opened from an author name in the
                                       thread. One popover reused for whichever author was clicked, since only
                                       one can be open at a time. *@
                                    <MudPopover Open="@_authorCardOpen" Fixed="true" Class="wb-author-card pa-4"
                                                AnchorOrigin="Origin.CenterCenter" TransformOrigin="Origin.CenterCenter">
                                        @if (_authorCard is { } card)
                                        {
                                            <div class="d-flex align-center gap-3">
                                                @if (_authorCardPhoto is not null)
                                                {
                                                    <MudAvatar Size="Size.Large"><MudImage Src="@_authorCardPhoto" /></MudAvatar>
                                                }
                                                else
                                                {
                                                    <MudAvatar Size="Size.Large" Color="Color.Primary">@Initials(card.DisplayName)</MudAvatar>
                                                }
                                                <div>
                                                    <MudText Typo="Typo.subtitle1">@card.DisplayName</MudText>
                                                    <MudText Typo="Typo.body2" Class="mud-text-secondary">@card.Email</MudText>
                                                    @if (!card.IsActive)
                                                    {
                                                        <MudChip T="string" Size="Size.Small" Color="Color.Warning">@Strings.Get("UserCardDeactivated")</MudChip>
                                                    }
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <MudText Typo="Typo.body2">@Strings.Get("UserCardLoadFailed")</MudText>
                                        }
                                    </MudPopover>
                                    @if (_authorCardOpen)
                                    {
                                        <MudOverlay Visible="true" AutoClose="false" @onclick="CloseAuthorCard" />
                                    }
                                    <div class="wb-chat-thread">
                                        @if (_comments.Count == 0)
                                        {
                                            <MudText Typo="Typo.body2" Class="mud-text-secondary">@Strings.Get("NoCommentsYet")</MudText>
                                        }
                                        @foreach (var c in _comments.Where(x => x.ParentMessageId is null).OrderBy(x => x.CreatedAt))
                                        {
                                            <div class="wb-comment">
                                                @if (c.Kind == ChatUserPost)
                                                {
                                                    <div class="wb-comment-meta">@AuthorMarkup(c) · @c.CreatedAt.ToLocalTime().ToString("g")</div>
                                                    <div class="wb-comment-body">@MentionMarkup(c)</div>
                                                    <span class="wb-reply-link" @onclick="() => ToggleReply(c.Id)">@Strings.Get("ReplyBtn")</span>
                                                }
                                                else
                                                {
                                                    @* An automatic entry READS as a sentence with the author in
                                                       it, so the author isn't repeated in the meta line — only
                                                       the time is (ADR 0545). No reply affordance: there is no
                                                       conversation to continue with an event. *@
                                                    <div class="wb-comment-meta">@c.CreatedAt.ToLocalTime().ToString("g")</div>
                                                    <div class="wb-comment-body wb-system-entry">@SystemSentence(c)</div>
                                                    @if (c.VersionNumber is { } versionNumber)
                                                    {
                                                        <div class="wb-version-entry">
                                                            <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Small" />
                                                            <div>
                                                                <div>@string.Format(Strings.Get("ChatVersionLabel"), versionNumber)</div>
                                                                @if (VersionCommentText(c) is { } versionComment)
                                                                {
                                                                    <div class="wb-version-comment">@versionComment</div>
                                                                }
                                                            </div>
                                                        </div>
                                                    }
                                                }
                                            </div>
                                            @foreach (var r in _comments.Where(x => x.ParentMessageId == c.Id).OrderBy(x => x.CreatedAt))
                                            {
                                                <div class="wb-comment wb-comment-reply">
                                                    <div class="wb-comment-meta">@AuthorMarkup(r) · @r.CreatedAt.ToLocalTime().ToString("g")</div>
                                                    <div class="wb-comment-body">@MentionMarkup(r)</div>
                                                </div>
                                            }
                                            @if (_replyingTo == c.Id)
                                            {
                                                <div class="wb-comment-reply">
                                                    <MudTextField T="string" Value="_replyText" ValueChanged="OnReplyChangedAsync" Immediate="true"
                                                                  Placeholder="@Strings.Get("ReplyPlaceholder")" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2" />
                                                    @if (_mentionCandidates.Count > 0)
                                                    {
                                                        <MudPaper Class="wb-mention-picker" Elevation="4">
                                                            <MudList T="string" Dense="true">
                                                                @foreach (var candidate in _mentionCandidates)
                                                                {
                                                                    <MudListItem T="string" OnClick="@(() => PickMention(candidate))">@candidate.DisplayName</MudListItem>
                                                                }
                                                            </MudList>
                                                        </MudPaper>
                                                    }
                                                    <div class="wb-compose-actions">
                                                        <MudButton Size="Size.Small" OnClick="@(() => PostReplyAsync(c.Id))" Disabled="@string.IsNullOrWhiteSpace(_replyText)">@Strings.Get("ReplyBtn")</MudButton>
                                                    </div>
                                                </div>
                                            }
                                        }
                                    </div>
                                    <div class="wb-compose">
                                        @* Immediate, so the @-picker can react as the name is typed (issue #383) —
                                           the default commits on blur, which would only offer names after the box
                                           lost focus. *@
                                        <MudTextField T="string" Value="_newComment" ValueChanged="OnComposeChangedAsync" Immediate="true"
                                                      Placeholder="@Strings.Get("CommentPlaceholder")" Variant="Variant.Outlined"
                                                      Margin="Margin.Dense" Lines="2" />
                                        @if (_mentionCandidates.Count > 0)
                                        {
                                            <MudPaper Class="wb-mention-picker" Elevation="4">
                                                <MudList T="string" Dense="true">
                                                    @foreach (var candidate in _mentionCandidates)
                                                    {
                                                        <MudListItem T="string" OnClick="@(() => PickMention(candidate))">@candidate.DisplayName</MudListItem>
                                                    }
                                                </MudList>
                                            </MudPaper>
                                        }
                                        <div class="wb-compose-actions">
                                            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="PostCommentAsync" Disabled="@string.IsNullOrWhiteSpace(_newComment)">@Strings.Get("CommentBtn")</MudButton>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
            else if (_activeTab == Tab.Search)
            {
                @* State lives in the injected SearchState, not in the tab — this component is disposed the
                   moment another tab is shown, and opening a hit IS a switch to Repositories (ADR 0558). *@
                @* InitialTagFilter needs the @ — it is a STRING parameter, and Razor treats an unprefixed
                   attribute value on one as a literal, so InitialTagFilter="_pendingSearchTag" silently passes
                   the field's NAME and never a null. It compiles clean and re-runs a bogus tag search on every
                   activation. A non-string parameter would not have compiled at all. *@
                <SearchTab InitialTagFilter="@_pendingSearchTag" OnFilterApplied="() => _pendingSearchTag = null"
                           OnOpenHit="OpenSearchResultAsync" />
            }
            else if (_activeTab == Tab.Inbox)
            {
                @* The tree's current folder pre-fills the filing dialog; the tab owns everything else,
                   including its own drop-zone and the DotNetObjectReference behind it (ADR 0558). *@
                <InboxTab CurrentFolderId="_selectedFolder?.Id" CurrentFolderName="@(_selectedFolder?.Name)"
                          CurrentDocumentId="@(_selectedItem is { IsFolder: false, IsReference: false } d ? (Guid?)d.Id : null)"
                          CurrentDocumentName="@(_selectedItem?.Name)"
                          MyUserId="_myUserId" CanManageInboxes="_canManageInboxes" CopyWebDavUrl="CopyWebDavUrlAsync" />
            }
            else if (_activeTab == Tab.Checkout)
            {
                <CheckoutTab Checkouts="_checkouts" Refresh="LoadCheckoutsAsync" OpenRequested="NavigateToDocumentAsync" CopyWebDavUrl="CopyWebDavUrlAsync" />
            }
            else if (_activeTab == Tab.Tenant)
            {
                @* Both actions reach state this tab does not own — the tree, and the detail pane's
                   sensitivity picker — so they stay with the shell (ADR 0558). *@
                <TenantTab NewRepository="NewRepositoryAsync" ManageSensitivityLabels="OpenSensitivityLabelsAsync" />
            }
            else if (_activeTab == Tab.Tags)
            {
                <TagsTab CatalogChanged="LoadTagCatalogAsync" />
            }
            else if (_activeTab == Tab.Tasks)
            {
                @* The list stays in the shell: this tab, My work and the tab-bar badge all read it. *@
                <TasksTab Tasks="_tasks" Refresh="LoadTasksAsync" OpenRequested="OpenTaskAsync" />
            }
            else if (_activeTab == Tab.MyWork)
            {
                <MyWorkTab Tasks="_tasks" TasksRefreshRequested="LoadTasksAsync" OpenRequested="NavigateToDocumentAsync" />
            }
            else if (_activeTab == Tab.UsersGroups)
            {
                @* All three capability flags come from /diagnostics/whoami, which the shell already read —
                   the tab is told rather than asking again (ADR 0557). *@
                <UsersGroupsTab CanManageServiceAccounts="_canManageServiceAccounts"
                                CanResetMfa="_canResetMfa" CanImpersonate="_canImpersonate" />
            }
            else if (_activeTab == Tab.Audit)
            {
                <AuditTab IsTenantAdmin="_isTenantAdmin" />
            }
            else if (_activeTab == Tab.LegalHolds)
            {
                <LegalHoldsTab HoldsChanged="RefreshOpenFolderAsync" />
            }
            else if (_activeTab == Tab.Retention)
            {
                <RetentionTab />
            }
            else if (_activeTab == Tab.RecycleBin)
            {
                <RecycleBinTab IsTenantAdmin="_isTenantAdmin" />
            }
            else
            {
                <div class="wb-placeholder">
                    <MudText Typo="Typo.h6">@_activeTab &mdash; coming soon</MudText>
                </div>
            }

            @* ---- Bottom tabs ---- *@
            @* Bottom tabs (#298): icon-only on hover-capable computers, with the label in a `title` tooltip +
               `aria-label`; touch devices (no hover → no tooltip) keep the visible label via the .wb-tab-label span.
               Check-out/Tasks show their live count as a small badge overlaid on the icon (mirrors the desktop). *@
            <div class="wb-tabs" data-tour="tab-bar">
                <div class="wb-tab @(_activeTab == Tab.Repositories ? "wb-tab-active" : "")" data-tour="tab-repositories" data-tour-active="@(_activeTab == Tab.Repositories ? "true" : "false")" title="@Strings.Get("TabRepositories")" aria-label="@Strings.Get("TabRepositories")" @onclick="() => SetTab(Tab.Repositories)">
                    <span class="wb-tab-ico"><MudIcon Icon="@Icons.Material.Filled.Folder" Size="Size.Small" /></span>
                    <span class="wb-tab-label">@Strings.Get("TabRepositories")</span>
                </div>
                <div class="wb-tab @(_activeTab == Tab.Inbox ? "wb-tab-active" : "")" data-tour="tab-inbox" data-tour-active="@(_activeTab == Tab.Inbox ? "true" : "false")" title="@Strings.Get("TabInbox")" aria-label="@Strings.Get("TabInbox")" @onclick="() => SetTab(Tab.Inbox)">
                    <span class="wb-tab-ico"><MudIcon Icon="@Icons.Material.Filled.Inbox" Size="Size.Small" /></span>
                    <span class="wb-tab-label">@Strings.Get("TabInbox")</span>
                </div>
                <div class="wb-tab @(_activeTab == Tab.Checkout ? "wb-tab-active" : "")" data-tour="tab-checkout" data-tour-active="@(_activeTab == Tab.Checkout ? "true" : "false")" title="@Strings.Get("TabCheckout")" aria-label="@Strings.Get("TabCheckout")" @onclick="() => SetTab(Tab.Checkout)">
                    <span class="wb-tab-ico">
                        <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" />
                        @if (_checkouts.Count > 0) { <span class="wb-tab-badge">@_checkouts.Count</span> }
                    </span>
                    <span class="wb-tab-label">@Strings.Get("TabCheckout")</span>
                </div>
                <div class="wb-tab @(_activeTab == Tab.Search ? "wb-tab-active" : "")" data-tour="tab-search" data-tour-active="@(_activeTab == Tab.Search ? "true" : "false")" title="@Strings.Get("TabSearch")" aria-label="@Strings.Get("TabSearch")" @onclick="() => SetTab(Tab.Search)">
                    <span class="wb-tab-ico"><MudIcon Icon="@Icons.Material.Filled.Search" Size="Size.Small" /></span>
                    <span class="wb-tab-label">@Strings.Get("TabSearch")</span>
                </div>
                <div class="wb-tab @(_activeTab == Tab.RecycleBin ? "wb-tab-active" : "")" data-tour="tab-recycle-bin" data-tour-active="@(_activeTab == Tab.RecycleBin ? "true" : "false")" title="@Strings.Get("TabRecycleBin")" aria-label="@Strings.Get("TabRecycleBin")" @onclick="() => SetTab(Tab.RecycleBin)">
                    <span class="wb-tab-ico"><MudIcon Icon="@Icons.Material.Filled.Delete" Size="Size.Small" /></span>
                    <span class="wb-tab-label">@Strings.Get("TabRecycleBin")</span>
                </div>
                <div class="wb-tab @(_activeTab == Tab.Tasks ? "wb-tab-active" : "")" data-tour="tab-tasks" data-tour-active="@(_activeTab == Tab.Tasks ? "true" : "false")" title="@Strings.Get("TabTasks")" aria-label="@Strings.Get("TabTasks")" @onclick="() => SetTab(Tab.Tasks)">
                    <span class="wb-tab-ico">
                        <MudIcon Icon="@Icons.Material.Filled.Task" Size="Size.Small" />
                        @if (_taskCount > 0) { <span class="wb-tab-badge">@_taskCount</span> }
                    </span>
                    <span class="wb-tab-label">@Strings.Get("TabTasks")</span>
                </div>
                <div class="wb-tab @(_activeTab == Tab.MyWork ? "wb-tab-active" : "")" data-tour="tab-my-work" data-tour-active="@(_activeTab == Tab.MyWork ? "true" : "false")" title="@Strings.Get("TabMyWork")" aria-label="@Strings.Get("TabMyWork")" @onclick="() => SetTab(Tab.MyWork)">
                    <span class="wb-tab-ico"><MudIcon Icon="@Icons.Material.Filled.Dashboard" Size="Size.Small" /></span>
                    <span class="wb-tab-label">@Strings.Get("TabMyWork")</span>
                </div>
                @if (_canManageUsers)
                {
                    <div class="wb-tab @(_activeTab == Tab.UsersGroups ? "wb-tab-active" : "")" data-tour="tab-users-groups" data-tour-active="@(_activeTab == Tab.UsersGroups ? "true" : "false")" title="@Strings.Get("TabUsersGroups")" aria-label="@Strings.Get("TabUsersGroups")" @onclick="() => SetTab(Tab.UsersGroups)">
                        <span class="wb-tab-ico"><MudIcon Icon="@Icons.Material.Filled.ManageAccounts" Size="Size.Small" /></span>
                        <span class="wb-tab-label">@Strings.Get("TabUsersGroups")</span>
                    </div>
                }
                @if (_canViewAuditLog)
                {
                    <div class="wb-tab @(_activeTab == Tab.Audit ? "wb-tab-active" : "")" data-tour="tab-audit" data-tour-active="@(_activeTab == Tab.Audit ? "true" : "false")" title="@Strings.Get("TabAudit")" aria-label="@Strings.Get("TabAudit")" @onclick="() => SetTab(Tab.Audit)">
                        <span class="wb-tab-ico"><MudIcon Icon="@Icons.Material.Filled.History" Size="Size.Small" /></span>
                        <span class="wb-tab-label">@Strings.Get("TabAudit")</span>
                    </div>
                }
                @if (_canLegalHold)
                {
                    <div class="wb-tab @(_activeTab == Tab.LegalHolds ? "wb-tab-active" : "")" data-tour="tab-legal-holds" data-tour-active="@(_activeTab == Tab.LegalHolds ? "true" : "false")" title="@Strings.Get("TabLegalHolds")" aria-label="@Strings.Get("TabLegalHolds")" @onclick="() => SetTab(Tab.LegalHolds)">
                        <span class="wb-tab-ico"><MudIcon Icon="@Icons.Material.Filled.Gavel" Size="Size.Small" /></span>
                        <span class="wb-tab-label">@Strings.Get("TabLegalHolds")</span>
                    </div>
                }
                @if (_canManageClassification)
                {
                    <div class="wb-tab @(_activeTab == Tab.Retention ? "wb-tab-active" : "")" data-tour="tab-retention" data-tour-active="@(_activeTab == Tab.Retention ? "true" : "false")" title="@Strings.Get("TabRetention")" aria-label="@Strings.Get("TabRetention")" @onclick="() => SetTab(Tab.Retention)">
                        <span class="wb-tab-ico"><MudIcon Icon="@Icons.Material.Filled.EventBusy" Size="Size.Small" /></span>
                        <span class="wb-tab-label">@Strings.Get("TabRetention")</span>
                    </div>
                }
                @if (_isTenantAdmin)
                {
                    <div class="wb-tab @(_activeTab == Tab.Tags ? "wb-tab-active" : "")" data-tour="tab-tags" data-tour-active="@(_activeTab == Tab.Tags ? "true" : "false")" title="@Strings.Get("TabTags")" aria-label="@Strings.Get("TabTags")" @onclick="() => SetTab(Tab.Tags)">
                        <span class="wb-tab-ico"><MudIcon Icon="@Icons.Material.Filled.Label" Size="Size.Small" /></span>
                        <span class="wb-tab-label">@Strings.Get("TabTags")</span>
                    </div>
                    <div class="wb-tab @(_activeTab == Tab.Tenant ? "wb-tab-active" : "")" data-tour="tab-tenant" data-tour-active="@(_activeTab == Tab.Tenant ? "true" : "false")" title="@Strings.Get("TabTenant")" aria-label="@Strings.Get("TabTenant")" @onclick="() => SetTab(Tab.Tenant)">
                        <span class="wb-tab-ico"><MudIcon Icon="@Icons.Material.Filled.Business" Size="Size.Small" /></span>
                        <span class="wb-tab-label">@Strings.Get("TabTenant")</span>
                    </div>
                }
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="wb-placeholder" style="height:100%;">
            <MudPaper Class="pa-8" Elevation="2">
                <MudText Typo="Typo.h6" Class="mb-2">SimplArchive</MudText>
                <MudText Typo="Typo.body2" Class="mb-4 mud-text-secondary">Please log in to open the repositories.</MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="authentication/login">Log in</MudButton>
            </MudPaper>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private enum Tab { Repositories, Inbox, Checkout, Tasks, Search, RecycleBin, MyWork, UsersGroups, Audit, LegalHolds, Retention, Tenant, Tags }


    // Reference (shortcut) metadata mirrors the desktop client: for a reference, Id is the TARGET's id (so
    // open/detail/drop act on the target), ReferenceId identifies the shortcut, RealParentId is the target's
    // home folder. HasReferences marks an item that at least one reference targets. See ADR "Web client
    // move/reference/search UI".

    // Reload the open folder's contents. Raised by tabs whose actions change what a row shows — a legal hold
    // draws a lock indicator — so they announce the change and the shell decides what to redraw (ADR 0558).
    private async Task RefreshOpenFolderAsync()
    {
        if (_selectedFolder is { } sf)
        {
            _folderContents = await OpenFolderContentsAsync(sf);
        }
    }

    private Tab _activeTab = Tab.Repositories;

    // A tag to hand the Search tab the next time it is shown (set by a tag-chip click on index data). The tab
    // consumes it on activation and calls back so this is dropped, rather than being re-applied on every visit.
    private string? _pendingSearchTag;

    // The tree pane component, so the shell can tell it to re-render after it reloads TreeState's roots.
    private Components.Panes.TreePane? _treePane;

    private BrowseNode? _selectedFolder;
    private List<BrowseNode> _folderContents = [];

    // Contents ordering (ADR "Per-folder contents sort order"): folders are ALWAYS listed on top; within each
    // group the default is the open folder's persisted ContentsSortOrder (_folderSortOrder, loaded from the
    // ListChildren envelope). Clicking a column header is an EPHEMERAL override (_headerSortActive) that resets
    // when another folder is opened. Client-side over the fully-loaded rows (the listing loads all pages).
    private FolderContentsSortOrder _folderSortOrder = FolderContentsSortOrder.DocumentDate;

    // What the detail pane is describing (issue #408). A selected row wins; with none, it is the open folder —
    // so the pane always describes SOMETHING you can see, and a folder gets the same pane as a document rather
    // than a thinner one of its own. Distinct from _selectedItem, which still means "a highlighted LIST row" and
    // governs the ribbon's per-item actions.
    private BrowseNode? _detailNode;

    // The subject's own contents-sort order (folders only), read from its detail resource.
    private FolderContentsSortOrder _detailSortOrder = FolderContentsSortOrder.Name;
    private bool _headerSortActive;

    private enum ContentSort { Name, Type, Date, Size, Tags }
    private ContentSort _contentSort = ContentSort.Name;
    private bool _contentSortAsc = true;

    private void SortBy(ContentSort col)
    {
        if (_headerSortActive && _contentSort == col)
        {
            _contentSortAsc = !_contentSortAsc;
        }
        else
        {
            _contentSort = col;
            _contentSortAsc = true;
            _headerSortActive = true; // an ephemeral override, until the next folder is opened
        }
    }

    private string SortArrow(ContentSort col) => _headerSortActive && _contentSort == col ? (_contentSortAsc ? "▲" : "▼") : "";

    private IEnumerable<BrowseNode> SortedContents()
    {
        // Folders on top (always alphabetical, issue #339), then documents ordered by the active criterion (default
        // DocumentDate). A column-header click is an explicit ephemeral override of the whole list.
        var folders = _folderContents.Where(n => n.IsFolder);
        var docs = _folderContents.Where(n => !n.IsFolder);
        if (_headerSortActive)
        {
            return ApplyHeaderSort(folders).Concat(ApplyHeaderSort(docs));
        }
        return folders.OrderBy(n => n.DisplayName, StringComparer.OrdinalIgnoreCase).Concat(ApplyFolderSort(docs));
    }

    private IEnumerable<BrowseNode> ApplyFolderSort(IEnumerable<BrowseNode> items) => _folderSortOrder switch
    {
        FolderContentsSortOrder.DocumentDate => items.OrderBy(n => n.DocumentDate ?? DateOnly.MinValue).ThenBy(n => n.DisplayName, StringComparer.OrdinalIgnoreCase),
        FolderContentsSortOrder.Created => items.OrderBy(n => n.VersionCreatedAt ?? DateTimeOffset.MinValue).ThenBy(n => n.DisplayName, StringComparer.OrdinalIgnoreCase),
        _ => items.OrderBy(n => n.DisplayName, StringComparer.OrdinalIgnoreCase),
    };

    private IEnumerable<BrowseNode> ApplyHeaderSort(IEnumerable<BrowseNode> items)
    {
        IEnumerable<BrowseNode> ordered = _contentSort switch
        {
            ContentSort.Type => items.OrderBy(n => n.DocumentType, StringComparer.OrdinalIgnoreCase),
            ContentSort.Date => items.OrderBy(n => n.DocumentDate ?? DateOnly.MinValue),
            ContentSort.Size => items.OrderBy(n => n.SizeBytes ?? -1),
            ContentSort.Tags => items.OrderBy(n => string.Join(",", n.TagList), StringComparer.OrdinalIgnoreCase),
            _ => items.OrderBy(n => n.DisplayName, StringComparer.OrdinalIgnoreCase),
        };
        return _contentSortAsc ? ordered : ordered.Reverse();
    }

    // Folder detail-pane editing of the persisted contents sort order (ADR "Per-folder contents sort order").
    private string FolderSortText(FolderContentsSortOrder order) => order switch
    {
        FolderContentsSortOrder.DocumentDate => Strings.Get("FolderSortDocDate"),
        FolderContentsSortOrder.Created => Strings.Get("FolderSortCreated"),
        _ => Strings.Get("FolderSortName"),
    };

    // Selecting a folder and starting the pane's edit, for the tree context menu's "Contents sort order" entry.
    // The order lives in the detail pane now (issue #408), so this navigates to it rather than opening an editor
    // of its own — one edit, one Save, wherever you started from.
    private async Task BeginFolderSortEditAsync(BrowseNode? folder)
    {
        if (folder is null)
        {
            return;
        }

        await SelectFolderAsync(folder);
        await BeginEditAsync();
    }

    // When non-null, the contents pane is showing a .zip's entries virtually (ADR "Zip file browsing")
    // instead of _folderContents; ExitArchiveAsync returns to the folder listing.
    private BrowseNode? _archiveDocument;
    private List<ArchiveEntryRow> _archiveEntries = [];
    private record ArchiveEntryRow(string Name, string Path, long Size, string DownloadHref);

    // The repository (root document id) the current selection belongs to — the recycle bin's scope. Threaded
    // down every BrowseNode via RepositoryId; Guid.Empty when unknown (e.g. after a search navigation).
    private Guid _currentRepositoryId;

