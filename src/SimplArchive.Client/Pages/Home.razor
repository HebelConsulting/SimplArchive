    // Bytes → a human "N.N MB" / "N.N GB" for the storage-usage line (ADR "Per-tenant storage quota").
    private static string FormatBytes(long bytes) => bytes switch
    {
        >= 1L << 30 => $"{bytes / (double)(1L << 30):0.##} GB",
        _ => $"{bytes / (double)(1L << 20):0.##} MB",
    };

    // Storage soft-quota indicator (ADR "Storage soft-quota warnings") — percent used + a level matching the
    // server's 80%/95% warning thresholds (0 = below, 1 = approaching, 2 = almost full).
    private int StoragePercent() => _tenant?.StorageQuotaBytes is { } q && q > 0 ? (int)(_tenant.StorageUsedBytes * 100 / q) : 0;
    private int StorageLevel() { var p = StoragePercent(); return p >= 95 ? 2 : p >= 80 ? 1 : 0; }

    // ---- Tree + list navigation ----------------------------------------------------------------------

    private async Task ReloadRootsAsync()
    {
        try
        {
            var nodes = new List<TreeItemData<BrowseNode>>();

            // The user's personal repository, pinned at the top of the tree (ADR "Per-user personal repository").
            // POST is get-or-create; it's excluded from the shared GET /repositories list below.
            var personal = await EnsurePersonalRepositoryAsync();
            if (personal is not null)
            {
                nodes.Add(PersonalTreeItem(personal));
            }

            var shared = new List<TreeItemData<BrowseNode>>();
            var url = "api/repositories";
            while (url is not null)
            {
                var page = await Http.GetFromJsonAsync<RepositoryListResponse>(url);
                foreach (var r in page?.Repositories ?? [])
                {
                    // A repository is its own repository scope.
                    shared.Add(ToTreeItem(new BrowseNode(r.Id, r.Name, r.HasChildren, r.HasVersions, r.HasSubfolders, RepositoryId: r.Id)));
                }
                url = RelativeHref(page?.Links, "next");
            }

            // Shared repositories sorted alphabetically (issue #339); Personal stays pinned above them.
            nodes.AddRange(shared.OrderBy(n => n.Value!.DisplayName, StringComparer.OrdinalIgnoreCase));

            // Tenant admins get a synthetic "Administration → Users" branch (ADR "Tenant-admin Administration →
            // Users view") to browse every user's personal space; its children load from the admin endpoint.
            if (_isTenantAdmin)
            {
                nodes.Add(new TreeItemData<BrowseNode>
                {
                    Value = new BrowseNode(Guid.Empty, "Administration", true, false, true, AdminKind: "admin-root"),
                    Expandable = true,
                    Text = "Administration",
                    Icon = Icons.Material.Filled.AdminPanelSettings,
                });
            }

            _roots = nodes;
        }
        catch (AccessTokenNotAvailableException) { }
        catch (HttpRequestException) { }
    }

    // Loads the synthetic Administration branch's children (ADR "Tenant-admin Administration → Users view").
    private async Task<IReadOnlyCollection<TreeItemData<BrowseNode>>> LoadAdminChildrenAsync(BrowseNode node)
    {
        if (node.AdminKind == "admin-root")
        {
            return
            [
                new TreeItemData<BrowseNode>
                {
                    Value = new BrowseNode(Guid.Empty, "Users", true, false, true, AdminKind: "admin-users"),
                    Expandable = true,
                    Text = "Users",
                    Icon = Icons.Material.Filled.People,
                },
            ];
        }

        // admin-users → one node per user's personal repository (browsable via the admin's ACL bypass). A fetch
        // error returns an empty branch rather than breaking the tree.
        AdminPersonalReposResponse? page;
        try { page = await Http.GetFromJsonAsync<AdminPersonalReposResponse>("api/admin/personal-repositories"); }
        catch (Exception) { page = null; }
        return (page?.Repositories ?? []).Select(r => new TreeItemData<BrowseNode>
        {
            Value = new BrowseNode(r.RepositoryId, r.DisplayName, r.HasChildren, false, r.HasSubfolders, RepositoryId: r.RepositoryId),
            Expandable = r.HasSubfolders,
            Text = r.UserIsActive ? r.DisplayName : $"{r.DisplayName} (inactive)",
            Icon = Icons.Material.Filled.Person,
        }).ToList();
    }

    private record AdminPersonalReposResponse { public List<AdminPersonalRepo> Repositories { get; set; } = []; }
    private record AdminPersonalRepo { public Guid UserId { get; set; } public string DisplayName { get; set; } = ""; public string Email { get; set; } = ""; public bool UserIsActive { get; set; } public Guid RepositoryId { get; set; } public bool HasChildren { get; set; } public bool HasSubfolders { get; set; } }

    // The tree contains folders only (no documents) — see ADR "Workbench pane content fixes".
    private async Task<IReadOnlyCollection<TreeItemData<BrowseNode>>> LoadChildrenAsync(BrowseNode node)
    {
        if (node.AdminKind is not "")
        {
            return await LoadAdminChildrenAsync(node);
        }

        // Folders are always sorted alphabetically in the tree (issue #339); the contents load orders for its list
        // default, so re-sort the folder nodes by name here.
        var children = (await LoadContentsAsync(node.Id, node.RepositoryId)).Where(c => !c.HasVersions)
            .OrderBy(c => c.DisplayName, StringComparer.OrdinalIgnoreCase).Select(ToTreeItem).ToList();

        // The Personal repository nests the Inbox + Check-out launcher nodes above its real subfolders,
        // mirroring /webdav/Personal (ADR "GUI-tree Personal space grouping"). Clicking a launcher switches to
        // the corresponding bottom tab (SelectFolderAsync), where the full staging / check-out UX lives.
        if (node.PersonalKind == "personal-root")
        {
            children.Insert(0, PersonalLauncherItem("checkout", "Check-out", Icons.Material.Filled.LockOpen));
            children.Insert(0, PersonalLauncherItem("inbox", "Inbox", Icons.Material.Filled.Inbox));
        }

        return children;
    }

    private static TreeItemData<BrowseNode> PersonalLauncherItem(string kind, string text, string icon) => new()
    {
        Value = new BrowseNode(Guid.Empty, text, false, false, false, PersonalKind: kind),
        Expandable = false,
        Text = text,
        Icon = icon,
    };

    // Real children plus references (shortcuts) filed in the folder — the references appear as extra rows
    // (with a shortcut icon); a folder-target reference also shows in the tree (ADR "Referenced folder in
    // the tree"). Id on a reference is its target, so open/detail act on the target.
    // trackAsCurrentFolder: this load is the contents pane for the open folder (not a tree-child load), so capture
    // its persisted ContentsSortOrder as the default order + reset the ephemeral header sort (ADR "Per-folder
    // contents sort order").
    private async Task<List<BrowseNode>> LoadContentsAsync(Guid folderId, Guid repositoryId, bool trackAsCurrentFolder = false)
    {
        var nodes = new List<BrowseNode>();
        var url = $"api/documents/{folderId}/children";
        var first = true;
        while (url is not null)
        {
            var page = await Http.GetFromJsonAsync<DocumentChildrenResponse>(url);
            if (first && trackAsCurrentFolder && page is not null)
            {
                _folderSortOrder = page.ContentsSortOrder;
                _headerSortActive = false;
            }
            first = false;
            foreach (var c in page?.Children ?? [])
            {
                nodes.Add(new BrowseNode(c.Id, c.Name, c.HasChildren, c.HasVersions, c.HasSubfolders, c.HasReferences, RepositoryId: repositoryId, FileExtension: c.FileExtension, OnLegalHold: c.OnLegalHold,
                    CheckedOut: c.CheckedOut, CheckedOutByMe: c.CheckedOutByMe, CheckedOutByName: c.CheckedOutByName,
                    DocumentType: c.DocumentType, DocumentDate: c.DocumentDate, SizeBytes: c.SizeBytes, Tags: c.Tags, SensitivityLabelName: c.SensitivityLabelName, SensitivityLabelColor: c.SensitivityLabelColor, VersionCount: c.VersionCount, VersionCreatedAt: c.VersionCreatedAt));
            }
            url = RelativeHref(page?.Links, "next");
        }

        var refUrl = $"api/documents/{folderId}/references";
        while (refUrl is not null)
        {
            var page = await Http.GetFromJsonAsync<ReferenceListResponse>(refUrl);
            foreach (var r in page?.References ?? [])
            {
                nodes.Add(new BrowseNode(r.Id, r.Name, r.HasChildren, r.HasVersions, r.HasSubfolders, r.HasReferences, true, r.ReferenceId, r.RealParentId, repositoryId));
            }
            refUrl = RelativeHref(page?.Links, "next");
        }

        return nodes;
    }

    // Get-or-create the current user's personal repository. Null on failure (e.g. a not-yet-ready session) so the
    // tree still renders the shared repositories.
    private async Task<PersonalRepositoryResponse?> EnsurePersonalRepositoryAsync()
    {
        try
        {
            var response = await Http.PostAsync("api/me/personal-repository", null);
            if (!response.IsSuccessStatusCode) return null;
            return await response.Content.ReadFromJsonAsync<PersonalRepositoryResponse>();
        }
        catch (AccessTokenNotAvailableException) { return null; }
        catch (HttpRequestException) { return null; }
    }

    // The personal repository's tree node carries a distinct person icon; it browses like any repository (its own
    // RepositoryId), so drill-in/upload/recycle-bin all flow through the existing paths.
    private static TreeItemData<BrowseNode> PersonalTreeItem(PersonalRepositoryResponse personal) => new()
    {
        Value = new BrowseNode(personal.Id, personal.Name, personal.HasChildren, false, personal.HasSubfolders, RepositoryId: personal.Id, PersonalKind: "personal-root"),
        // Always expandable — it holds at least the Inbox + Check-out launcher nodes (ADR "GUI-tree Personal
        // space grouping"), even before any real subfolder exists.
        Expandable = true,
        Text = personal.Name,
        Icon = Icons.Material.Filled.Person,
    };

    private static TreeItemData<BrowseNode> ToTreeItem(BrowseNode node) => new()
    {
        Value = node,
        // The tree is folders-only, so the caret reflects sub-folders (not any child) — a folder holding
        // only documents is a leaf in the tree. See ADR "Workbench pane content fixes".
        Expandable = node.HasSubfolders,
        Text = node.Name,
        Icon = NodeIcon(node),
    };

    // Material icon per node — a shortcut variant for references, matching the desktop client's icons.
    private static string NodeIcon(BrowseNode n) => (n.IsReference, n.IsFolder) switch
    {
        (true, true) => Icons.Material.Filled.FolderSpecial,
        (true, false) => Icons.Material.Filled.Link,
        (false, true) => Icons.Material.Filled.Folder,
        (false, false) => Icons.Material.Filled.Description,
    };

    // A folder row is a drop target that files into itself; a document row is a drop target that opens the
    // inbox-style filing dialog (ADR "List-pane drop filing"). For a reference, node.Id is the target's id.
    private static Dictionary<string, object> DropAttributes(BrowseNode? node)
    {
        if (node is null)
        {
            return EmptyAttributes;
        }

        var attrs = node.HasVersions
            ? new Dictionary<string, object> { ["data-drop-doc"] = node.Id.ToString() }
            : new Dictionary<string, object> { ["data-drop-folder"] = node.Id.ToString() };

        // A real document/folder is also an internal drag source — dragging it onto a folder moves or references
        // it (mirrors the desktop client, ADR "Desktop drag-and-drop move and reference"). Synthetic admin /
        // personal-space / launcher nodes aren't movable, so they're not drag sources.
        if (node is { AdminKind: "", PersonalKind: "" })
        {
            attrs["draggable"] = "true";
            attrs["data-node-id"] = node.Id.ToString();
            attrs["data-node-ref"] = node.IsReference ? "true" : "false";
        }

        return attrs;
    }

    // Makes the whole contents pane a drop target for the currently-selected folder.
    private Dictionary<string, object> ListDropAttributes()
        => _selectedFolder is { } folder ? new() { ["data-drop-folder"] = folder.Id.ToString() } : EmptyAttributes;

    // Selecting a folder (tree click or drilling into a folder row) lists its contents in the middle pane.
    private async Task SelectFolderAsync(BrowseNode? folder)
    {
        _treeDrawerOpen = false; // phone: navigating a folder closes the tree drawer (no-op on desktop)
        // The synthetic Administration/Users nodes (ADR "Tenant-admin Administration → Users view") aren't real
        // folders — clicking them just expands; a user's personal repo node (a real repo id) browses normally.
        if (folder is { AdminKind: not "" })
        {
            return;
        }

        // The Inbox / Check-out launcher nodes under Personal switch to their bottom tab (ADR "GUI-tree Personal
        // space grouping"); the personal-root node itself browses like any repository (falls through).
        if (folder is { PersonalKind: "inbox" })
        {
            await SetTab(Tab.Inbox);
            return;
        }

        if (folder is { PersonalKind: "checkout" })
        {
            await SetTab(Tab.Checkout);
            return;
        }

        _archiveDocument = null; // leave any archive-browsing view
        _selectedFolder = folder;
        _currentRepositoryId = folder?.RepositoryId ?? Guid.Empty;
        ClearDetail();
        _folderContents = folder is null ? [] : await LoadContentsAsync(folder.Id, folder.RepositoryId);

        // A folder has its own comment thread too, even though it has no index-data/preview.
        if (folder is not null)
        {
            _commentTarget = folder;
            await LoadFolderSubscriptionAsync(folder);
            await LoadCommentsAsync(folder.Id);
        }
    }

    // Single click only ever *selects* the row (never navigates), so e.g. a document's Download button
    // enables. A document loads its index-data/preview; a folder is selected (highlighted, its comments
    // shown) without opening — only a double click drills into it (OnRowDoubleClickAsync).
    // Native multi-selection (ADR "Bulk actions on selected documents") — no checkboxes: Ctrl/Cmd-click toggles
    // a row into the bulk set, Shift-click range-selects from the anchor, a plain click clears the set and
    // single-selects (the existing detail-pane behavior). When ≥2 rows are selected a bulk-action bar appears.
    private async Task OnRowClickAsync(BrowseNode node, Microsoft.AspNetCore.Components.Web.MouseEventArgs e)
    {
        if (e.CtrlKey || e.MetaKey)
        {
            if (!_bulkIds.Remove(node.Id))
            {
                _bulkIds.Add(node.Id);
                if (_bulkIds.Count == 1 && _bulkAnchorId is { } prior && prior != node.Id)
                {
                    _bulkIds.Add(prior); // fold the previously single-selected row into the multi-selection
                }
            }

            _bulkAnchorId = node.Id;
            StateHasChanged();
            return;
        }

        if (e.ShiftKey && _bulkAnchorId is { } anchorId)
        {
            var order = _folderContents.Select(n => n.Id).ToList();
            var a = order.IndexOf(anchorId);
            var b = order.IndexOf(node.Id);
            if (a >= 0 && b >= 0)
            {
                for (var i = Math.Min(a, b); i <= Math.Max(a, b); i++)
                {
                    _bulkIds.Add(order[i]);
                }
            }

            StateHasChanged();
            return;
        }

        // Phone: a single tap navigates (there's no side-by-side detail) — a folder / doc-with-children / zip
        // drills in; a leaf document opens the full-screen detail overlay.
        if (_isPhone)
        {
            if (node.IsFolder || node.HasChildren || (node.HasVersions && node.FileExtension.Equals(".zip", StringComparison.OrdinalIgnoreCase)))
            {
                await OnRowDoubleClickAsync(node);
            }
            else
            {
                _phoneDetailTab = "preview";
                await SelectRowAsync(node);
            }
            return;
        }

        await SelectRowAsync(node);
    }

    // Plain single-select (clears any bulk multi-selection) — the row's default behavior, also used by
    // programmatic navigation (go-to / search result).
    private async Task SelectRowAsync(BrowseNode node)
    {
        _bulkIds.Clear();
        _bulkAnchorId = node.Id;
        if (node.HasVersions)
        {
            await SelectItemAsync(node);
        }
        else
        {
            await SelectContentFolderAsync(node);
        }
    }

    private readonly HashSet<Guid> _bulkIds = [];
    private Guid? _bulkAnchorId;

    // Double click drills into any node that has children — a folder, or a document that has child documents
    // (an email with filed attachments, ADR "Email attachments as child documents"), listing its contents.
    // On a childless document it's a no-op — the single click already selected it.
    private async Task OnRowDoubleClickAsync(BrowseNode node)
    {
        if (node.HasVersions && node.FileExtension.Equals(".zip", StringComparison.OrdinalIgnoreCase))
        {
            await EnterArchiveAsync(node);
        }
        else if (node.IsFolder || node.HasChildren)
        {
            await SelectFolderAsync(node);
        }
    }

    // Browse a .zip's entries virtually — read on demand from the stored archive, nothing unpacked (ADR
    // "Zip file browsing"). The parent folder listing (_folderContents) is left in place so Exit returns to it.
    private async Task EnterArchiveAsync(BrowseNode zip)
    {
        try
        {
            var response = await Http.GetFromJsonAsync<ArchiveEntriesResponse>($"api/documents/{zip.Id}/archive-entries");
            _archiveEntries = (response?.Entries ?? [])
                .Select(e => new ArchiveEntryRow(e.Name, e.Path, e.Size,
                    e.Links?.FirstOrDefault(l => l.Rel == "download")?.Href?.TrimStart('/') ?? ""))
                .ToList();
            _archiveDocument = zip;
        }
        catch (Exception)
        {
            Snackbar.Add($"Could not read '{zip.Name}'.", Severity.Error);
        }
    }

    private void ExitArchiveAsync()
    {
        _archiveDocument = null;
        _archiveEntries = [];
    }

    // Download one archive entry: the Api proxies the bytes (entries aren't storage objects), so fetch with
    // the authenticated client and hand the blob to the browser to save.
    private async Task DownloadArchiveEntryAsync(ArchiveEntryRow entry)
    {
        try
        {
            var bytes = await Http.GetByteArrayAsync(entry.DownloadHref);
            using var stream = new MemoryStream(bytes);
            using var streamRef = new DotNetStreamReference(stream);
            await JS.InvokeVoidAsync("downloadFileFromStream", entry.Name, streamRef);
        }
        catch (Exception)
        {
            Snackbar.Add($"Could not download '{entry.Name}'.", Severity.Error);
        }
    }

    private static string FormatSize(long bytes) => bytes switch
    {
        >= 1024 * 1024 => $"{bytes / (1024.0 * 1024.0):0.#} MB",
        >= 1024 => $"{bytes / 1024.0:0.#} KB",
        _ => $"{bytes} B",
    };

    // Select a folder shown in the contents list without opening it: highlight it and show its comment
    // thread, but leave the current listing (_selectedFolder/_folderContents) in place, and clear any
    // document detail so the index/preview panes fall back to their placeholder.
    private async Task SelectContentFolderAsync(BrowseNode folder)
    {
        ClearDetail();
        _commentTarget = folder;
        await LoadFolderSubscriptionAsync(folder);
        await LoadCommentsAsync(folder.Id);
    }

    private async Task SelectItemAsync(BrowseNode item)
    {
        ClearDetail();
        _selectedItem = item;
        _commentTarget = item;

        try
        {
            _detailMaskId = null;
            var mask = await Http.GetFromJsonAsync<MaskResponse>($"api/documents/{item.Id}/mask");
            _detailMaskName = mask?.Name;
            _detailMaskId = mask?.MaskId;
            _detailVersionNumber = mask?.VersionNumber;

            var index = await Http.GetFromJsonAsync<IndexDataResponse>($"api/documents/{item.Id}/index-data");
            _detailIndexData = index?.Fields ?? [];

            // Free-form tags (ADR "Document tags").
            _detailTags = (await Http.GetFromJsonAsync<TagsResponse>($"api/documents/{item.Id}/tags"))?.Tags ?? [];

            // The document resource carries the computed retention schedule (ADR "Retention policies") + the
            // sensitivity label (ADR "Data classification / sensitivity labels").
            var detail = await Http.GetFromJsonAsync<DocumentDetailResponse>($"api/documents/{item.Id}");
            _detailRetention = detail?.Retention;
            _detailSensitivityId = detail?.SensitivityLabelId;
            _detailSensitivityName = detail?.SensitivityLabelName ?? "";
            _detailSensitivityColor = detail?.SensitivityLabelColor;
            _detailSensitivityWatermark = detail?.SensitivityWatermark ?? false;
            _detailCanManagePermissions = detail?.CanManagePermissions ?? false;
            _detailBreaksInheritance = detail?.BreaksInheritance ?? false;
            if (_sensitivityLabels.Count == 0)
            {
                await LoadSensitivityLabelsAsync();
            }

            // Whether the current user follows this document (ADR "Document subscriptions").
            var sub = await Http.GetFromJsonAsync<SubscriptionResponse>($"api/documents/{item.Id}/subscription");
            _detailSubscribed = sub?.Subscribed ?? false;

            var versions = await Http.GetFromJsonAsync<VersionListResponse>($"api/documents/{item.Id}/versions");
            var confirmed = versions?.Versions?.Where(v => v.Status == "Confirmed").ToList() ?? [];
            var latest = PickCurrent(confirmed, versions?.CurrentVersionId);
            string? textLayoutUrl = null;
            if (latest is not null)
            {
                _pv.Url = RelativeToAbsolute(RelativeHref(latest.Links, "preview"));
                _downloadUrl = RelativeToAbsolute(RelativeHref(latest.Links, "download"));
                _pv.Converted = latest.PreviewConverted;
                textLayoutUrl = RelativeHref(latest.Links, "text-layout");
                _pvAnnotationsUrl = RelativeHref(latest.Links, "annotations");
            }

            DeriveSystemFields(item, confirmed, versions?.CurrentVersionId);
            await RenderPreviewAsync(_pv.Url, textLayoutUrl, seedQuery: null);

            // Sticky notes are available whenever a real version preview loaded (ADR "Document annotations").
            _pvAnnotatable = latest is not null && _pv.HasPages && _pvAnnotationsUrl is not null;
            if (_pvAnnotatable)
            {
                await LoadAnnotationsAsync();
            }
        }
        catch (HttpRequestException)
        {
            _detailIndexData ??= [];
        }

        await LoadCommentsAsync(item.Id);
    }

    private void ClearDetail()
    {
        _selectedItem = null;
        _detailMaskName = null;
        _detailVersionNumber = null;
        _detailIndexData = null;
        _detailTags = null;
        _pv.Url = null;
        _downloadUrl = null;
        ClearPreviewPane();
        _commentTarget = null;
        _comments = [];
        _replyingTo = null;
        _newComment = "";
        _replyText = "";

        _isEditing = false;
        _sysHasVersion = false;
        _sysCurrentVersionId = Guid.Empty;
        _sysCurrentVersion = null;
        _detailVersionCount = 0;
        _sysName = "";
        _sysFileExtension = "";
        _sysDocumentDate = null;
        _sysCreated = "";
        _sysCreatedBy = "";
        _sysHasTiff = false;
        _sysOcrCodes = [];
        _detailRetention = null;
        _detailSubscribed = false;
        _editFields.Clear();
        _availableMasks = [];
    }

    // Open the reminder (Wiedervorlage) dialog for the selected document (ADR "Document reminders").
    private async Task OpenReminderDialogAsync()
    {
        if (_selectedItem is not { } item)
        {
            return;
        }

        var parameters = new DialogParameters
        {
            ["DocumentId"] = item.Id,
            ["DocumentName"] = _sysName,
        };
        await DialogService.ShowAsync<Dialogs.ReminderDialog>("Reminders", parameters);
    }

    // Whether the current user follows the selected document (ADR "Document subscriptions").
    private bool _detailSubscribed;

    private async Task ToggleSubscriptionAsync()
    {
        if (_selectedItem is not { } item)
        {
            return;
        }

        try
        {
            var target = _detailSubscribed;
            using var response = target
                ? await Http.DeleteAsync($"api/documents/{item.Id}/subscription")
                : await Http.PutAsync($"api/documents/{item.Id}/subscription", null);
            response.EnsureSuccessStatusCode();
            _detailSubscribed = !target;
            Snackbar.Add(_detailSubscribed ? "Following this document." : "Unfollowed.", Severity.Success);
        }
        catch (Exception)
        {
            Snackbar.Add("Could not update your subscription.", Severity.Error);
        }
    }

    private record SubscriptionResponse { public bool Subscribed { get; set; } }

    // Folder / subtree subscriptions (ADR "Folder / subtree subscriptions"): following a folder notifies of any
    // change within its subtree. State for the currently-selected folder (the chat-header bell).
    private bool _folderSubscribed;

    private async Task LoadFolderSubscriptionAsync(BrowseNode folder)
    {
        try
        {
            var sub = await Http.GetFromJsonAsync<SubscriptionResponse>($"api/documents/{folder.Id}/subscription");
            _folderSubscribed = sub?.Subscribed ?? false;
        }
        catch (Exception)
        {
            _folderSubscribed = false;
        }
    }

    private async Task ToggleFolderSubscriptionAsync()
    {
        if (_commentTarget is not { IsFolder: true } folder)
        {
            return;
        }

        try
        {
            var target = _folderSubscribed;
            using var response = target
                ? await Http.DeleteAsync($"api/documents/{folder.Id}/subscription")
                : await Http.PutAsync($"api/documents/{folder.Id}/subscription", null);
            response.EnsureSuccessStatusCode();
            _folderSubscribed = !target;
            Snackbar.Add(_folderSubscribed ? "Following this folder and everything in it." : "Unfollowed folder.", Severity.Success);
        }
        catch (Exception)
        {
            Snackbar.Add("Could not update your subscription.", Severity.Error);
        }
    }

    private DetailRetentionDto? _detailRetention;
    // Manage-access affordance (ADR "Manage-access UI for document/folder ACLs"): the caller's own
    // CanManagePermissions on the selected item gates the button; BreaksInheritance is shown in the dialog.
    private bool _detailCanManagePermissions;
    private bool _detailBreaksInheritance;
    // Sensitivity label (ADR "Data classification / sensitivity labels"): current value + the staged edit value.
    // The selected document's sensitivity (ADR "Configurable sensitivity labels + upload defaults") — the per-
    // tenant label id/name/colour + whether it watermarks; _edit* is the pending picker value.
    private Guid? _detailSensitivityId;
    private string _detailSensitivityName = "";
    private string? _detailSensitivityColor;
    private bool _detailSensitivityWatermark;
    private Guid? _editSensitivityId;
    private List<SensitivityLabelDto> _sensitivityLabels = [];
    private bool _canManageSensitivity;

    private record SensitivityLabelDto { public Guid Id { get; set; } public string Name { get; set; } = ""; public int Rank { get; set; } public string? Color { get; set; } public bool Watermark { get; set; } public bool Retired { get; set; } }
    private record SensitivityLabelsResponse { public List<SensitivityLabelDto> Labels { get; set; } = []; public bool CanManage { get; set; } }

    // The tenant's sensitivity labels for the picker + admin (loaded once, refreshable). Best-effort.
    private async Task LoadSensitivityLabelsAsync()
    {
        try
        {
            var resp = await Http.GetFromJsonAsync<SensitivityLabelsResponse>("api/sensitivity-labels");
            _sensitivityLabels = resp?.Labels ?? [];
            _canManageSensitivity = resp?.CanManage ?? false;
        }
        catch (Exception) { }
    }

    // A repeating diagonal SVG-background watermark of "<LABEL> · <viewer>" (ADR "Document watermarking"),
    // shown over the preview when the label's watermark flag is set. Client-side only (a screenshot deterrent /
    // classification reminder — bypassable, server-stamped downloads deferred).
    private string WatermarkStyle()
    {
        var text = System.Net.WebUtility.HtmlEncode($"{_detailSensitivityName} · {_viewerName}");
        var svg = $"<svg xmlns='http://www.w3.org/2000/svg' width='360' height='200'><text x='10' y='150' fill='rgba(130,130,130,0.20)' font-size='20' font-family='sans-serif' transform='rotate(-28 10 150)'>{text}</text></svg>";
        return $"background-image:url(\"data:image/svg+xml,{Uri.EscapeDataString(svg)}\");";
    }
    private record DocumentDetailResponse { public DetailRetentionDto? Retention { get; set; } public Guid? SensitivityLabelId { get; set; } public string SensitivityLabelName { get; set; } = ""; public string? SensitivityLabelColor { get; set; } public bool SensitivityWatermark { get; set; } public bool CanManagePermissions { get; set; } public bool BreaksInheritance { get; set; } }
    private record DetailRetentionDto { public int RetentionYears { get; set; } public string DispositionDate { get; set; } = ""; public bool SuspendedByHold { get; set; } }

    // Derives the always-shown system fields from the confirmed versions (ADR 0273): the current version's
    // Created/Created-by/Document-date/File-extension, and the OCR override + TIFF-source from the latest TIFF.
    private void DeriveSystemFields(BrowseNode item, List<VersionResponse> confirmed, Guid? currentVersionId)
    {
        var current = PickCurrent(confirmed, currentVersionId);
        if (current is null)
        {
            return; // a folder or a document with no confirmed version yet
        }

        static bool IsTiff(string? key) => key is not null && (key.EndsWith(".tif", StringComparison.OrdinalIgnoreCase) || key.EndsWith(".tiff", StringComparison.OrdinalIgnoreCase));
        var tiff = confirmed.Where(v => IsTiff(v.ObjectKey)).OrderByDescending(v => v.VersionNumber ?? 0).FirstOrDefault();

        _sysHasVersion = true;
        _sysCurrentVersionId = current.Id;
        _sysCurrentVersion = current.VersionNumber;
        _detailVersionCount = confirmed.Count;
        _sysName = item.Name;
        _sysFileExtension = current.FileExtension ?? "";
        _sysDocumentDate = DateTime.TryParse(current.DocumentDate, out var d) ? d.Date : null;
        _sysCreated = current.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm");
        _sysCreatedBy = current.CreatedByName ?? "";
        _sysHasTiff = tiff is not null;
        _sysOcrCodes = string.IsNullOrWhiteSpace(tiff?.OcrLanguages) ? [] : tiff!.OcrLanguages!.Split('+', StringSplitOptions.RemoveEmptyEntries).ToList();
    }

    // ---- Single pane-level edit (ADR 0278): Name/date/OCR/mask/index-data all editable at once -----------

    private bool CanEditDetail => _selectedItem is not null && !_isEditing;

    private async Task BeginEditAsync()
    {
        if (_selectedItem is null)
        {
            return;
        }

        _detailBusy = true;
        try
        {
            // Snapshot originals for change detection + cancel.
            _editName = _origName = _sysName;
            _editDocumentDate = _origDocumentDate = _sysDocumentDate;
            _editOcrCodes = [.. _sysOcrCodes];
            _origOcrCodes = [.. _sysOcrCodes];
            _editMaskId = _origMaskId = _detailMaskId;
            _editSensitivityId = _detailSensitivityId;
            _editTags = [.. (_detailTags ?? [])];
            _origTags = [.. (_detailTags ?? [])];
            _newTag = null;
            if (_tagColors.Count == 0)
            {
                await LoadTagCatalogAsync(); // names for autocomplete + colours for the chips
            }

            _availableMasks = (await Http.GetFromJsonAsync<MaskListResponse>("api/masks"))?.Masks ?? [];
            if (_sysHasTiff && _ocrCatalog.Count == 0)
            {
                _ocrCatalog = (await Http.GetFromJsonAsync<OcrCatalogResponse>("api/ocr-languages"))?.Languages ?? [];
            }

            await LoadEditFieldsAsync(_editMaskId, useCurrentValues: true);
            _isEditing = true;
        }
        catch (HttpRequestException e)
        {
            Snackbar.Add($"Could not start editing: {e.Message}", Severity.Error);
        }
        finally
        {
            _detailBusy = false;
        }
    }

    // Compare two versions of the selected document as an inline text diff (ADR "Document version comparison").
    // Versions dialog (ADR "Versions dialog") — list versions with Open/Download/Make-current + a Compare
    // launcher. A make-current there returns true, so reselect the document to reflect the new current version.
    private async Task OpenVersionsAsync(BrowseNode item)
    {
        var parameters = new DialogParameters { ["DocumentId"] = item.Id, ["DocumentName"] = item.Name };
        var dialog = await DialogService.ShowAsync<Dialogs.VersionsDialog>("Versions", parameters, new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        if ((await dialog.Result) is { Canceled: false, Data: true } && _selectedItem?.Id == item.Id)
        {
            await SelectItemAsync(item);
        }
    }

    private async Task OpenCompareVersionsAsync()
    {
        if (_selectedItem is not { } item)
