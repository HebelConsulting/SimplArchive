    private record PvResult { public string Kind { get; set; } = ""; public string Text { get; set; } = ""; }
    private record TextLayoutResponse { public List<TextLayoutPage> Pages { get; set; } = []; }
    private record TextLayoutPage { public List<TextLayoutWord> Words { get; set; } = []; }
    private record TextLayoutWord { public string Text { get; set; } = ""; public double X { get; set; } public double Y { get; set; } public double Width { get; set; } public double Height { get; set; } }

    // Renders a preview (image/pdf/text) with its hit-overlay into the JS host (preview.js). `previewUrl` is the
    // presigned rendition URL; `textLayoutUrl` is the version's text-layout link (may be null / 204).
    private async Task RenderPreviewAsync(string? previewUrl, string? textLayoutUrl, string? seedQuery)
    {
        _pv.Kind = "";
        _pv.Text = null;
        _pv.Count = 0;
        _pv.Index = 0;
        _pv.FindQuery = seedQuery ?? "";

        if (previewUrl is null)
        {
            _pv.Kind = "unsupported";
            return;
        }

        // Fetch the per-page word boxes (may be 204 = no overlay).
        List<TextLayoutPage>? layout = null;
        if (textLayoutUrl is not null)
        {
            try
            {
                using var r = await Http.GetAsync(textLayoutUrl.TrimStart('/'));
                if (r.IsSuccessStatusCode && r.StatusCode != HttpStatusCode.NoContent)
                {
                    layout = (await r.Content.ReadFromJsonAsync<TextLayoutResponse>())?.Pages;
                }
            }
            catch (Exception) { /* no overlay */ }
        }

        _previewModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./preview.js");
        _pvSelfRef ??= DotNetObjectReference.Create(this);
        StateHasChanged(); // make sure the host div is in the DOM before JS fills it

        try
        {
            var result = await _previewModule.InvokeAsync<PvResult>("load", _pvHost, previewUrl, layout, _pvSelfRef);
            _pv.Kind = result.Kind;
            _pv.Text = result.Text;
            if (_pv.HasPages && !string.IsNullOrWhiteSpace(_pv.FindQuery))
            {
                _pv.Count = await _previewModule.InvokeAsync<int>("setFind", _pv.FindQuery);
                _pv.Index = _pv.Count > 0 ? 1 : 0;
            }
        }
        catch (Exception)
        {
            _pv.Kind = "error";
        }
    }

    private async Task ApplyFindAsync(string query)
    {
        _pv.FindQuery = query;
        if (_previewModule is null || !_pv.HasPages)
        {
            return;
        }

        _pv.Count = await _previewModule.InvokeAsync<int>("setFind", query);
        _pv.Index = _pv.Count > 0 ? 1 : 0;
    }

    private async Task FindNextAsync()
    {
        if (_previewModule is not null && _pv.Count > 0)
        {
            _pv.Index = await _previewModule.InvokeAsync<int>("next");
        }
    }

    private async Task FindPrevAsync()
    {
        if (_previewModule is not null && _pv.Count > 0)
        {
            _pv.Index = await _previewModule.InvokeAsync<int>("prev");
        }
    }

