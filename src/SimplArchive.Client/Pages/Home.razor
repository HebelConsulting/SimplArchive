    // Multi-select facet selections (ADR "Search facet refinements"): each dimension holds a set of chosen
    // values (OR within the dimension); a per-field dictionary keys the Select index-field facets by name.
    private readonly HashSet<string> _facetTypes = [];
    private readonly HashSet<string> _facetCreatedBy = [];
    private readonly HashSet<string> _facetYears = [];
    private readonly HashSet<string> _facetTags = [];
    private readonly HashSet<string> _facetFileTypes = [];
    private readonly HashSet<string> _facetSensitivity = [];
    private readonly Dictionary<string, HashSet<string>> _facetFields = [];

    // Toggle a facet value in/out of its dimension's set (ADR "Search facet refinements"), then re-search — the
    // dimension stays open (post-filter faceting) so other values remain selectable.
    private Task ToggleFacetAsync(HashSet<string> set, string v) { if (!set.Remove(v)) set.Add(v); return RunSearchAsync(); }

    private Task ToggleFieldFacetAsync(string field, string v)
    {
        if (!_facetFields.TryGetValue(field, out var set)) { set = _facetFields[field] = []; }
        if (!set.Remove(v)) { set.Add(v); }
        return RunSearchAsync();
    }

    private void ClearFacetSelections()
    {
        _facetTypes.Clear(); _facetCreatedBy.Clear(); _facetYears.Clear(); _facetTags.Clear(); _facetFileTypes.Clear(); _facetSensitivity.Clear();
        _facetFields.Clear();
    }

    // Tag chip editor + catalog autocomplete (ADR "Document tags"). SearchFunc suggests not-yet-added catalog
    // tags; Enter commits the box (a coerced free-form value or the highlighted suggestion).
    private Task<IEnumerable<string>> SearchTagCatalog(string value, CancellationToken ct)
    {
        var pool = _tagCatalog.Where(t => !_editTags.Contains(t));
        return Task.FromResult(string.IsNullOrWhiteSpace(value)
            ? pool
            : pool.Where(t => t.Contains(value.Trim(), StringComparison.OrdinalIgnoreCase)));
    }

    private void OnTagKeyUp(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or "NumpadEnter")
        {
            AddCurrentTag();
