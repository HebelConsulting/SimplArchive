                    </span>
                    <span class="wb-tab-label">@Strings.Get("TabTasks")</span>
                </div>
                <div class="wb-tab @(_activeTab == Tab.MyWork ? "wb-tab-active" : "")" title="@Strings.Get("TabMyWork")" aria-label="@Strings.Get("TabMyWork")" @onclick="() => SetTab(Tab.MyWork)">
                    <span class="wb-tab-ico"><MudIcon Icon="@Icons.Material.Filled.Dashboard" Size="Size.Small" /></span>
                    <span class="wb-tab-label">@Strings.Get("TabMyWork")</span>
                </div>
                @if (_canManageUsers)
                {
                    <div class="wb-tab @(_activeTab == Tab.UsersGroups ? "wb-tab-active" : "")" title="@Strings.Get("TabUsersGroups")" aria-label="@Strings.Get("TabUsersGroups")" @onclick="() => SetTab(Tab.UsersGroups)">
                        <span class="wb-tab-ico"><MudIcon Icon="@Icons.Material.Filled.ManageAccounts" Size="Size.Small" /></span>
                        <span class="wb-tab-label">@Strings.Get("TabUsersGroups")</span>
                    </div>
                }
                @if (_canViewAuditLog)
                {
                    <div class="wb-tab @(_activeTab == Tab.Audit ? "wb-tab-active" : "")" title="@Strings.Get("TabAudit")" aria-label="@Strings.Get("TabAudit")" @onclick="() => SetTab(Tab.Audit)">
                        <span class="wb-tab-ico"><MudIcon Icon="@Icons.Material.Filled.History" Size="Size.Small" /></span>
                        <span class="wb-tab-label">@Strings.Get("TabAudit")</span>
                    </div>
                }
                @if (_canLegalHold)
                {
                    <div class="wb-tab @(_activeTab == Tab.LegalHolds ? "wb-tab-active" : "")" title="@Strings.Get("TabLegalHolds")" aria-label="@Strings.Get("TabLegalHolds")" @onclick="() => SetTab(Tab.LegalHolds)">
                        <span class="wb-tab-ico"><MudIcon Icon="@Icons.Material.Filled.Gavel" Size="Size.Small" /></span>
                        <span class="wb-tab-label">@Strings.Get("TabLegalHolds")</span>
                    </div>
                }
                @if (_canManageClassification)
                {
                    <div class="wb-tab @(_activeTab == Tab.Retention ? "wb-tab-active" : "")" title="@Strings.Get("TabRetention")" aria-label="@Strings.Get("TabRetention")" @onclick="() => SetTab(Tab.Retention)">
                        <span class="wb-tab-ico"><MudIcon Icon="@Icons.Material.Filled.EventBusy" Size="Size.Small" /></span>
                        <span class="wb-tab-label">@Strings.Get("TabRetention")</span>
                    </div>
                }
                @if (_isTenantAdmin)
                {
                    <div class="wb-tab @(_activeTab == Tab.Tags ? "wb-tab-active" : "")" title="@Strings.Get("TabTags")" aria-label="@Strings.Get("TabTags")" @onclick="() => SetTab(Tab.Tags)">
                        <span class="wb-tab-ico"><MudIcon Icon="@Icons.Material.Filled.Label" Size="Size.Small" /></span>
                        <span class="wb-tab-label">@Strings.Get("TabTags")</span>
