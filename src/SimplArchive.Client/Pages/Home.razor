    // afterwards, since submitting/approving/etc. changes the caller's (or the reviewer's) task set.
    private async Task OpenWorkflowAsync(BrowseNode node)
    {
        var parameters = new DialogParameters { ["DocumentId"] = node.Id, ["DocumentHref"] = DocumentActions.DocumentAddress(node) };
        var dialog = await DialogService.ShowAsync<WorkflowDialog>(Strings.Get("WfTitle"), parameters, new DialogOptions { CloseButton = true });
        await dialog.Result;
        await LoadTasksAsync();
