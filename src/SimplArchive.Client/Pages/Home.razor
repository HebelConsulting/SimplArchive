    // The read-only view and the edit form share the _tenantEdit binding, so it mirrors _tenant except while
    // the user is actively editing (BeginTenantEdit → Save/Cancel).
    private void SyncTenantEditFromTenant()
    {
        if (_tenant is null) return;
        _tenantEdit = new TenantSettingsEdit { Name = _tenant.Name, AuditRetentionDays = _tenant.AuditRetentionDays, CheckoutTtlDays = _tenant.CheckoutTtlDays, CheckoutWarningDays = _tenant.CheckoutWarningDays, WormLockMode = _tenant.WormLockMode, RequireMfa = _tenant.RequireMfa, AllowPasskeyLogin = _tenant.AllowPasskeyLogin, RequireDispositionReview = _tenant.RequireDispositionReview, RestrictTagsToCatalog = _tenant.RestrictTagsToCatalog, EnforceClearance = _tenant.EnforceClearance, StorageQuotaMb = _tenant.StorageQuotaBytes is { } b ? (int)(b / (1024 * 1024)) : null, IncompleteUploadCleanupDays = _tenant.IncompleteUploadCleanupDays, AuditWebhookUrl = _tenant.AuditWebhookUrl, AuditWebhookSecret = null };
        _tenantEditOcr = new HashSet<string>(_tenant.DefaultOcrLanguages.Split('+', StringSplitOptions.RemoveEmptyEntries));
    }

    private void BeginTenantEdit()
    {
        if (_tenant is null) return;
        SyncTenantEditFromTenant();
        _tenantEditing = true;
    }

    private void CancelTenantEdit()
    {
        SyncTenantEditFromTenant(); // discard in-flight edits back to the persisted values
        _tenantEditing = false;
    }

    private async Task SaveTenantSettingsAsync()
    {
        // Preserve the catalog order for the "+"-joined default (a stable priority).
        var ocr = string.Join('+', _ocrCatalog.Select(l => l.Code).Where(c => _tenantEditOcr.Contains(c)));
        var webhookUrl = string.IsNullOrWhiteSpace(_tenantEdit.AuditWebhookUrl) ? null : _tenantEdit.AuditWebhookUrl.Trim();
        var webhookSecret = string.IsNullOrWhiteSpace(_tenantEdit.AuditWebhookSecret) ? null : _tenantEdit.AuditWebhookSecret;
        long? storageQuotaBytes = _tenantEdit.StorageQuotaMb is { } mb ? (long)mb * 1024 * 1024 : null;
        var body = new { name = _tenantEdit.Name, defaultOcrLanguages = ocr, auditRetentionDays = _tenantEdit.AuditRetentionDays, checkoutTtlDays = _tenantEdit.CheckoutTtlDays, checkoutWarningDays = _tenantEdit.CheckoutWarningDays, wormLockMode = _tenantEdit.WormLockMode, requireMfa = _tenantEdit.RequireMfa, allowPasskeyLogin = _tenantEdit.AllowPasskeyLogin, requireDispositionReview = _tenantEdit.RequireDispositionReview, restrictTagsToCatalog = _tenantEdit.RestrictTagsToCatalog, enforceClearance = _tenantEdit.EnforceClearance, storageQuotaBytes, incompleteUploadCleanupDays = _tenantEdit.IncompleteUploadCleanupDays, auditWebhookUrl = webhookUrl, auditWebhookSecret = webhookSecret };
        var resp = await Http.PutAsJsonAsync("api/tenant-settings", body);
        if (resp.StatusCode == System.Net.HttpStatusCode.Conflict) { Snackbar.Add("Another active tenant already uses this name.", Severity.Warning); return; }
        if (resp.StatusCode == System.Net.HttpStatusCode.BadRequest) { Snackbar.Add("Check the name, OCR languages, retention/expiry values and the webhook URL/secret.", Severity.Warning); return; }
        if (!resp.IsSuccessStatusCode) { Snackbar.Add("Could not save the settings.", Severity.Error); return; }
        _tenant = await resp.Content.ReadFromJsonAsync<TenantSettingsDto>();
        SyncTenantEditFromTenant();
        _tenantEditing = false;
        Snackbar.Add("Tenant settings saved.", Severity.Success);
    }

