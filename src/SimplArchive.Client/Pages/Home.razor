    private async Task LoadPrincipalsAsync()
    {
        var previousId = _selectedPrincipal?.Id;
        var previousIsGroup = _selectedPrincipal?.IsGroup;
        var rows = new List<PrincipalRow>();

        try
        {
            var gurl = "api/groups";
            while (gurl is not null)
            {
                var page = await Http.GetFromJsonAsync<GroupsAdminResponse>(gurl);
                foreach (var g in page?.Groups ?? [])
                {
                    rows.Add(new PrincipalRow { IsGroup = true, Id = g.Id, Name = g.Name, Rights = g.Rights ?? new() });
                }
                gurl = RelativeHref(page?.Links, "next");
            }

            var uurl = "api/users";
            while (uurl is not null)
            {
                var page = await Http.GetFromJsonAsync<UsersAdminResponse>(uurl);
                foreach (var u in page?.Users ?? [])
                {
                    rows.Add(new PrincipalRow { IsGroup = false, Id = u.Id, Name = u.DisplayName, IsActive = u.IsActive, MfaEnabled = u.MfaEnabled, Rights = u.Rights ?? new() });
                }
                uurl = RelativeHref(page?.Links, "next");
            }
        }
        catch (Exception)
        {
            Snackbar.Add("Could not load users and groups.", Severity.Error);
            return;
        }

        // Groups first (two-person icon), then users (one-person icon), each alphabetical.
        _principals = rows.OrderByDescending(p => p.IsGroup).ThenBy(p => p.Name, StringComparer.OrdinalIgnoreCase).ToList();
        _selectedPrincipal = _principals.FirstOrDefault(p => p.Id == previousId && p.IsGroup == previousIsGroup);
        _editRights = _selectedPrincipal is { } sel ? sel.Rights with { } : new();
        await LoadPrincipalPhotoAsync(_selectedPrincipal);
        await LoadGroupMembersAsync(_selectedPrincipal);
    }

