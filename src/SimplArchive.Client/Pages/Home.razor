    // Persists only the fields that changed; a failure keeps the pane in edit mode and reports it (ADR 0278).
    private async Task SaveDetailAsync()
    {
        if (_selectedItem is not { } item)
        {
            return;
        }

        _detailBusy = true;
        var failures = new List<string>();
        var nameChanged = false;
        try
        {
            var newName = _editName.Trim();
            if (newName.Length > 0 && newName != _origName)
            {
                var etag = await GetETagAsync(item.Id);
                using var req = new HttpRequestMessage(HttpMethod.Put, $"api/documents/{item.Id}") { Content = JsonContent.Create(new { name = newName }) };
                if (etag is not null)
                {
                    req.Headers.TryAddWithoutValidation("If-Match", etag);
                }

                var resp = await Http.SendAsync(req);
                if (resp.IsSuccessStatusCode) { _sysName = _origName = newName; nameChanged = true; }
                else if (resp.StatusCode == HttpStatusCode.Conflict) { failures.Add("name (already exists here)"); }
                else { failures.Add("name"); }
            }

            if (_sysHasVersion && _sysCurrentVersionId != Guid.Empty && _editDocumentDate is { } dd && dd != _origDocumentDate)
            {
                var resp = await Http.PutAsJsonAsync($"api/documents/{item.Id}/versions/{_sysCurrentVersionId}/document-date", new { documentDate = dd.ToString("yyyy-MM-dd") });
                if (resp.IsSuccessStatusCode) { _sysDocumentDate = _origDocumentDate = dd; } else { failures.Add("document date"); }
            }

            if (_sysHasTiff && !_editOcrCodes.SequenceEqual(_origOcrCodes))
            {
                var resp = await Http.PutAsJsonAsync($"api/documents/{item.Id}/ocr-languages", new { languages = _editOcrCodes });
                if (resp.IsSuccessStatusCode) { _sysOcrCodes = [.. _editOcrCodes]; _origOcrCodes = [.. _editOcrCodes]; } else { failures.Add("OCR languages"); }
            }

            if (_editSensitivityId != _detailSensitivityId)
            {
                var resp = await Http.PutAsJsonAsync($"api/documents/{item.Id}/sensitivity", new { labelId = _editSensitivityId });
                if (resp.IsSuccessStatusCode)
                {
                    _detailSensitivityId = _editSensitivityId;
                    var lbl = _sensitivityLabels.FirstOrDefault(l => l.Id == _editSensitivityId);
                    _detailSensitivityName = lbl?.Name ?? "";
                    _detailSensitivityColor = lbl?.Color;
                    _detailSensitivityWatermark = lbl?.Watermark ?? false;
                }
                else { failures.Add("sensitivity"); }
            }

            // Free-form tags (ADR "Document tags"): PUT-replaces the whole set; the server normalizes/dedupes.
            var editTags = _editTags.Select(t => t.Trim().ToLowerInvariant()).Where(t => t.Length is > 0 and <= 100).Distinct().ToList();
            if (!editTags.OrderBy(t => t).SequenceEqual(_origTags.OrderBy(t => t)))
            {
                var resp = await Http.PutAsJsonAsync($"api/documents/{item.Id}/tags", new { tags = editTags });
                if (resp.IsSuccessStatusCode)
                {
                    _detailTags = (await resp.Content.ReadFromJsonAsync<TagsResponse>())?.Tags ?? [];
                    _origTags = [.. _detailTags];
                }
                else { failures.Add("tags"); }
            }

            try
            {
                if (_editMaskId is null)
                {
                    if (_origMaskId is not null)
                    {
                        (await Http.DeleteAsync($"api/documents/{item.Id}/mask")).EnsureSuccessStatusCode();
                    }
                }
                else
                {
                    // Fill index data first, then (re)assign the mask (which re-checks required fields).
                    var body = new { fields = _editFields.Select(f => new { fieldDefinitionId = f.FieldDefinitionId, values = f.ToValues() }) };
                    (await Http.PutAsJsonAsync($"api/documents/{item.Id}/index-data", body)).EnsureSuccessStatusCode();
                    if (_editMaskId != _origMaskId)
                    {
                        (await Http.PutAsJsonAsync($"api/documents/{item.Id}/mask", new { maskId = _editMaskId })).EnsureSuccessStatusCode();
                    }
                }
            }
            catch (HttpRequestException)
            {
                failures.Add("mask / index data (check required and formatted fields)");
            }

            if (failures.Count > 0)
            {
                Snackbar.Add($"Could not save: {string.Join("; ", failures)}", Severity.Warning);
                return; // stay in edit mode so the rejected field can be fixed
            }

            _isEditing = false;
            Snackbar.Add("Saved.", Severity.Success);
            if (nameChanged)
            {
                // Rebuild the tree/list so rows show the new name, then reselect the *fresh* node (the old
                // _selectedItem still carries the old name, which would otherwise reappear in the detail pane).
                await ReloadRootsAsync();
                if (_selectedFolder is { } folder)
                {
                    _folderContents = await LoadContentsAsync(folder.Id, folder.RepositoryId, trackAsCurrentFolder: true);
                }

                var fresh = (_folderContents ?? []).FirstOrDefault(c => c.Id == item.Id) ?? item with { Name = _sysName };
                await SelectItemAsync(fresh);
            }
            else
            {
                await SelectItemAsync(item);
            }
        }
        finally
        {
            _detailBusy = false;
        }
    }

