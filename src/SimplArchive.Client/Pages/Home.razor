    protected override async Task OnInitializedAsync()
    {
        // Load whoami first, so the tree reflects tenant-admin state (the Administration → Users branch, ADR
        // "Tenant-admin Administration → Users view") on the first render rather than only after a refresh.
        // Tenant admins also get the searchable-PDF backfill ribbon button (ADR 0274); CanManageUsers holders get
        // the Users & groups tab (ADR "Users & groups administration tab").
        try
        {
            var me = await Http.GetFromJsonAsync<WhoAmIResponse>(await ApiRoot.RequireAsync("whoami"));
            _isTenantAdmin = me?.IsTenantAdmin ?? false;
            _canManageUsers = me?.CanManageUsers ?? false;
            _canManageServiceAccounts = me?.CanManageServiceAccounts ?? false;
            _canViewAuditLog = me?.CanViewAuditLog ?? false;
            _canResetMfa = me?.CanResetMfa ?? false;
            _canLegalHold = me?.CanLegalHold ?? false;
            _canManageClassification = me?.CanManageClassification ?? false;
            _canOverrideCheckout = me?.CanOverrideCheckout ?? false;
            _canImpersonate = me?.CanImpersonate ?? false;
            _canExport = me?.CanExport ?? false;
            _canImport = me?.CanImport ?? false;
            _canManageIntrays = me?.CanManageIntrays ?? false;
            Catalogs.MayRouteMail = me?.CanManageMailRouting ?? false;
            _myUserId = me?.UserId;
            _viewerName = me?.UserName ?? "";
        }
        catch (Exception)
        {
            _isTenantAdmin = false;
            _canManageUsers = false;
            _canManageServiceAccounts = false;
            _canViewAuditLog = false;
            _canResetMfa = false;
            _canLegalHold = false;
            _canManageClassification = false;
            _canExport = false;
            _canImport = false;
        }

        await ReloadTreeAsync();

        _myExternalLinksHref = await Actions.MyExternalLinksHrefAsync(); // gates the ribbon's "my external links" button (ADR 0546)
        await LoadTasksAsync(); // for the Tasks tab badge count

        AppNav.OpenDocumentRequested += OpenDocumentFromNotificationAsync; // ADR "Notification viewer + click-through"

        // A deep link parked by the /go/{id} lander before this page existed (#761): consume exactly once,
        // through the same open-and-select path the notification bell uses — deep-linking is NAVIGATING.
        if (AppNav.TakePendingDeepLink() is { } deepLink)
        {
            await OpenDocumentFromNotificationAsync(deepLink.DocumentId, deepLink.ParentId);
        }
    }

    // Copy a deep link (#761): the https app route /go/{id} — universally openable, and the desktop's
    // scheme handler accepts it too. Addressed from the ROW the menu was opened on (ADR 0559), and a
    // reference row links its TARGET: the link's promise is "this document", not "this appearance".
    private async Task CopyDeepLinkAsync(BrowseNode node)
    {
        // node.Id is the DOCUMENT id even on a reference row (the row model's contract), which is exactly
        // what the link should promise: this document, wherever its appearances live.
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", $"{Nav.BaseUri}go/{node.Id}");
        Snackbar.Add(Strings.Get("DeepLinkCopied"), Severity.Success);
    }

    // A notification bell click (in MainLayout) asks the workbench to open the related document.
    private Task OpenDocumentFromNotificationAsync(Guid documentId, Guid? parentId) => InvokeAsync(async () =>
    {
        await SetTab(Tab.Repositories);
        if (parentId is { } p)
        {
            await NavigateToFolderAsync(p, documentId); // open the parent folder + select the document
        }
        else
        {
            await NavigateToFolderAsync(documentId); // the document is a repository root
        }

        StateHasChanged();
    });

