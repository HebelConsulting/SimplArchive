    private string FolderSortText(FolderContentsSortOrder order) => order switch
    {
        FolderContentsSortOrder.DocumentDate => Strings.Get("FolderSortDocDate"),
        FolderContentsSortOrder.Created => Strings.Get("FolderSortCreated"),
        _ => Strings.Get("FolderSortName"),
    };

    private async Task SaveFolderSortAsync()
    {
        if (_selectedFolder is not { } folder)
        {
            return;
        }

        _folderBusy = true;
        try
        {
            var resp = await Http.PutAsJsonAsync($"api/documents/{folder.Id}/contents-sort-order", new { sortOrder = (int)_folderSortEdit });
            if (resp.IsSuccessStatusCode)
            {
                _folderSortOrder = _folderSortEdit;
                _headerSortActive = false; // re-apply the persisted default order to the current listing
                _folderEditing = false;
            }
            else if (resp.StatusCode == System.Net.HttpStatusCode.Forbidden)
            {
                Snackbar.Add(Strings.Get("FolderSortNoPermission"), Severity.Warning);
            }
            else
            {
                Snackbar.Add(Strings.Get("FolderSortSaveFailed"), Severity.Error);
            }
        }
        finally
        {
            _folderBusy = false;
        }
    }

