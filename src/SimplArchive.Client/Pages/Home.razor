                {
                    <WorkbenchTab Icon="@Icons.Material.Filled.EventBusy" Label="@Strings.Get("TabRetention")" Tour="tab-retention"
                                  Active="@(_activeTab == Tab.Retention)" OnClick="@(() => SetTab(Tab.Retention))" />
                }
                @if (_isTenantAdmin)
                {
                    <WorkbenchTab Icon="@Icons.Material.Filled.Label" Label="@Strings.Get("TabTags")" Tour="tab-tags"
                                  Active="@(_activeTab == Tab.Tags)" OnClick="@(() => SetTab(Tab.Tags))" />
                    <WorkbenchTab Icon="@Icons.Material.Filled.Business" Label="@Strings.Get("TabTenant")" Tour="tab-tenant"
                                  Active="@(_activeTab == Tab.Tenant)" OnClick="@(() => SetTab(Tab.Tenant))" />
