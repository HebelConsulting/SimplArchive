    // Adds the typed tag as an editable chip (shared by the Enter key + the explicit Add button). A no-op for a
    // blank / too-long / duplicate value.
    private void AddCurrentTag()
    {
        var t = (_newTag ?? "").Trim().ToLowerInvariant();
        if (t.Length is > 0 and <= 100 && !_editTags.Contains(t))
        {
            _editTags.Add(t);
        }

        _newTag = null;
    }

