    private async Task CreatePrincipalAsync(bool isGroup, string name, string email, SystemRightsDto? copyRights)
    {
        try
        {
            Guid newId;
            using (var resp = isGroup
                ? await Http.PostAsJsonAsync("api/groups", new { name })
                : await Http.PostAsJsonAsync("api/users", new { email, displayName = name }))
            {
                if (!resp.IsSuccessStatusCode)
                {
                    Snackbar.Add(resp.StatusCode == HttpStatusCode.Conflict
                        ? (isGroup ? "A group with this name already exists." : "A user with this email already exists.")
                        : "Could not create.", Severity.Warning);
                    return;
                }

                newId = isGroup
                    ? (await resp.Content.ReadFromJsonAsync<GroupAdminDto>())!.Id
                    : (await resp.Content.ReadFromJsonAsync<UserAdminDto>())!.Id;
            }

            if (copyRights is not null)
            {
                await Http.PutAsJsonAsync($"api/{(isGroup ? "groups" : "users")}/{newId}/rights", copyRights);
            }

            await LoadPrincipalsAsync();
            if (_principals.FirstOrDefault(p => p.IsGroup == isGroup && p.Id == newId) is { } created)
            {
                await SelectPrincipalAsync(created);
            }

            Snackbar.Add(isGroup ? "Group created." : "User created.", Severity.Success);
        }
        catch (Exception)
        {
            Snackbar.Add("Could not create.", Severity.Error);
        }
    }

    private async Task DeletePrincipalAsync()
    {
        if (_selectedPrincipal is not { } p)
        {
            return;
        }

        var confirmed = await DialogService.ShowMessageBoxAsync(new MessageBoxOptions
        {
            Title = p.IsGroup ? "Delete group" : "Deactivate user",
            Message = p.IsGroup ? $"Delete the group '{p.Name}'?" : $"Deactivate the user '{p.Name}'?",
            YesText = p.IsGroup ? "Delete" : "Deactivate",
            CancelText = "Cancel",
        });
        if (confirmed != true)
        {
            return;
        }

        try
        {
            using var resp = await Http.DeleteAsync(p.IsGroup ? $"api/groups/{p.Id}" : $"api/users/{p.Id}");
            if (resp.IsSuccessStatusCode)
            {
                Snackbar.Add(p.IsGroup ? "Group deleted." : "User deactivated.", Severity.Success);
                _selectedPrincipal = null;
                await LoadPrincipalsAsync();
                return;
            }

            // A user with pending review tasks can't be deactivated without handing them over — prompt for a
            // replacement reviewer, then retry with ?reassignReviewsTo= (ADR "Workflow review reassignment").
            if (!p.IsGroup && resp.StatusCode == HttpStatusCode.Conflict)
            {
                var problem = await resp.Content.ReadFromJsonAsync<DeleteProblem>();
                if (problem?.ErrorCode == "REVIEWER_HAS_PENDING_REVIEWS")
                {
                    await ReassignThenDeactivateAsync(p);
                    return;
                }
            }

            Snackbar.Add(resp.StatusCode switch
            {
                HttpStatusCode.Conflict => "The group still has child groups or members.",
                HttpStatusCode.Forbidden => "You don't have permission to do that.",
                _ => "Could not delete.",
            }, Severity.Warning);
        }
        catch (Exception)
        {
            Snackbar.Add("Could not delete.", Severity.Error);
        }
    }

    private async Task ReassignThenDeactivateAsync(PrincipalRow user)
    {
        var candidates = _principals
            .Where(x => !x.IsGroup && x.IsActive && x.Id != user.Id)
            .Select(x => new ReplacementReviewerDialog.ReviewerCandidate(x.Id, x.Name))
            .ToList();
        if (candidates.Count == 0)
        {
            Snackbar.Add("No other active user is available to take over the reviews.", Severity.Warning);
            return;
        }

        var parameters = new DialogParameters
        {
            [nameof(ReplacementReviewerDialog.UserName)] = user.Name,
            [nameof(ReplacementReviewerDialog.Candidates)] = candidates,
        };
        var dialog = await DialogService.ShowAsync<ReplacementReviewerDialog>("Reassign pending reviews", parameters);
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not Guid replacementId)
        {
            return;
        }

        using var retry = await Http.DeleteAsync($"api/users/{user.Id}?reassignReviewsTo={replacementId}");
        if (retry.IsSuccessStatusCode)
        {
            Snackbar.Add("Reviews reassigned and user deactivated.", Severity.Success);
            _selectedPrincipal = null;
            await LoadPrincipalsAsync();
        }
        else
        {
            Snackbar.Add("Could not reassign the reviews.", Severity.Warning);
        }
    }

