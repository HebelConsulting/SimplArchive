    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Import the JS modules up front (no DOM dependency). The DOM-dependent wiring below must NOT
            // live here: the workbench markup is inside <Authorized>, so on a page reload (auth resolving
            // asynchronously) the elements don't exist yet at firstRender — wiring them here would throw and
            // abort this block before the second import even ran.
            _selfRef = DotNetObjectReference.Create(this);
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./dropUpload.js");
            try
            {
                _layoutModule = await JS.InvokeAsync<IJSObjectReference>("import", "./wbLayout.js");
            }
            catch (JSException ex)
            {
                // A missing wbLayout.js must not crash the workbench — the panes just stay at their CSS defaults
                // (issue #267). Leaving _layoutModule null makes the interop below no-op.
                Console.Error.WriteLine($"wbLayout.js failed to load: {ex.Message}");
            }
        }

        // Wire the drop root and the resizable/collapsible panes on whichever render first has the real
        // elements. Both JS sides return false (no-op) until their root is a real element and true once
        // wired, so we simply retry until each succeeds; the flags reset on a tab switch (SetTab) so we
        // re-wire the freshly-recreated DOM when returning to the Repositories tab.
        if (_activeTab == Tab.Repositories)
        {
            if (!_dropRootWired && _module is not null)
            {
                _dropRootWired = await _module.InvokeAsync<bool>("initDropRoot", _dropRoot, _selfRef);
            }
            // Both wbLayout.js calls are wrapped so a stale cached copy missing an export (e.g. watchViewport,
            // added in ADR "responsive web workbench") degrades quietly to the CSS-default layout instead of
            // triggering the Blazor error UI, and stops retrying so it can't spam every render (issue #267).
            if (!_panesWired && _layoutModule is not null)
            {
                try
                {
                    _panesWired = await _layoutModule.InvokeAsync<bool>("attach", _layoutRoot);
                }
                catch (JSException ex)
                {
                    _panesWired = true; // give up rather than retry-spam a broken/stale module
                    Console.Error.WriteLine($"wbLayout.js attach failed (stale cache?): {ex.Message}");
                }
            }
            if (!_viewportWatched && _layoutModule is not null)
            {
                try
                {
                    await _layoutModule.InvokeVoidAsync("watchViewport", _selfRef);
                    // Capture the touch-only-device flag once (gates the annotation authoring tools, #349). Guarded
                    // in the same try so a stale cached module missing the export degrades quietly to false.
                    _isTouchOnly = await _layoutModule.InvokeAsync<bool>("isTouchOnly");
                }
                catch (JSException ex)
                {
                    Console.Error.WriteLine($"wbLayout.js watchViewport failed (stale cache?): {ex.Message}");
                }
                finally
                {
                    _viewportWatched = true;
                }
            }
        }

        // Replay a preview requested before its pane existed (see ShowPreviewAsync). In the always-executed
        // part, because a pane appears on whichever render first carries its markup — not necessarily the
        // page's first render — and LAST, after the drop/pane wiring above: this is the only await in here
        // that can take real time (a JS preview load), and the wiring must not queue behind it.
        if (_pendingPreview is { } pending)
        {
            if (_repoPreview is not null)
            {
                _pendingPreview = null;
                await ShowPreviewAsync(pending.Url, pending.Layout, pending.Converted, pending.HasVersion);
                StateHasChanged();
            }
        }
    }

    private async Task SetTab(Tab tab)
    {
        // Leaving Repositories tears down the workbench DOM; clear the wired flags so returning re-wires the
        // freshly-recreated drop root and panes.
        if (tab != Tab.Repositories)
        {
            _dropRootWired = false;
            _panesWired = false;
        }
        // Each tab owns its PreviewPane now, so this is no longer about stopping a leak between two tabs through
        // one shared host (ADR 0558) — it drops the outgoing tab's annotation state and blanks the panes, so
        // returning to a tab does not show the previous document until the new selection has loaded.
        ClearPreviewPane();
        _activeTab = tab;

        // Returning to Repositories: refresh the folder-contents list pane so newly-filed documents appear, and
        // — keeping focus on the selected document — re-render its detail so a version filed elsewhere (e.g.
        // from the Inbox) shows. See the "refresh list pane on return" requirement.
        if (tab == Tab.Repositories && _selectedFolder is { } folder)
        {
            _folderContents = await OpenFolderContentsAsync(folder);
            if (_selectedItem is { } sel && _folderContents.FirstOrDefault(n => n.Id == sel.Id) is { } fresh)
            {
                await SelectItemAsync(fresh);
            }
        }

        if (tab == Tab.Tasks)
        {
            await LoadTasksAsync();
        }

        // Tab.Audit loads itself: the component exists only while its tab is shown, so the shell no longer has
        // to know what that tab needs or when (ADR 0558).

    }

    // ---- Legal hold from a document row (ADR "Legal hold & retention enforcement") -------------------
    // A row action on the CONTENTS pane, not part of the Legal holds tab: it acts on the document under the
    // cursor. It stays in the shell for the same reason export/import do — what it belongs to is the thing it
    // acts on, not the tab that happens to list the results (ADR 0558).
    // Places a legal hold on a specific document from the contents-pane ⋮ menu: creates a new matter covering it.

    // ---- Repository export / import (ADRs "Repository export" / "Repository import") -----------------
    // Acts on the SELECTED FOLDER, so it belongs to the Repositories surface and stays in the shell — it had
    // drifted into the audit and legal-hold sections, which is what made both of those extractions catch it.
    // Export the selected repository/folder + subtree to a .zip (ADR "Repository export"). Tenant-admin-only.
    // The filter dialog collects the version selection + date/creator filters; the zip is fetched with the
    // authenticated client and handed to the browser via the blob-download helper.
    private async Task OpenExportDialogAsync()
    {
        if (_selectedFolder is null)
        {
            return;
        }

        var root = _selectedFolder;
        var dialog = await DialogService.ShowAsync<ExportDialog>(Strings.Get("SaRightExport"), new DialogParameters { ["RootName"] = root.Name });
        if ((await dialog.Result) is not { Canceled: false, Data: ExportDialog.ExportOptions options })
        {
            return;
        }

        try
        {
            var query = new List<string> { $"versions={options.Versions}" };
            if (options.DocumentDateFrom is { } df) query.Add($"documentDateFrom={df:yyyy-MM-dd}");
            if (options.DocumentDateTo is { } dt) query.Add($"documentDateTo={dt:yyyy-MM-dd}");
            if (options.FiledFrom is { } ff) query.Add($"filedFrom={Uri.EscapeDataString(ff.ToUniversalTime().ToString("o"))}");
            if (options.FiledTo is { } ft) query.Add($"filedTo={Uri.EscapeDataString(ft.Date.AddDays(1).ToUniversalTime().ToString("o"))}");
            if (options.CreatedBy is { } cb) query.Add($"createdBy={Uri.EscapeDataString(cb)}");
            if (options.IncludePermissions) query.Add("includePermissions=true");

            Snackbar.Add(Strings.Get("StPreparingExport"), Severity.Info);
            var bytes = await Http.GetByteArrayAsync($"api/documents/{root.Id}/export?" + string.Join("&", query));
            using var stream = new MemoryStream(bytes);
            using var streamRef = new DotNetStreamReference(stream);
            await JS.InvokeVoidAsync("downloadFileFromStream", $"{root.Name}-export-{DateTime.UtcNow:yyyyMMdd-HHmmss}.zip", streamRef);
            Snackbar.Add(Strings.Get("StExportReady"), Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(string.Format(Strings.Get("StErrExport"), ex.Message), Severity.Error);
        }
    }

    // Import an export archive (ADRs "Repository import" / "Idempotent re-import"). Tenant-admin-only. Grafts
    // under the selected folder, or creates a new repository when nothing is selected. The dialog picks the .zip
    // + the update-existing flag; the archive is POSTed as multipart form data.
    private async Task OpenImportDialogAsync()
    {
        var dialog = await DialogService.ShowAsync<ImportDialog>(Strings.Get("SaRightImport"), new DialogParameters { ["TargetName"] = _selectedFolder?.Name });
        if ((await dialog.Result) is not { Canceled: false, Data: ImportDialog.Result options })
        {
            return;
        }

        try
        {
            Snackbar.Add(Strings.Get("StImporting"), Severity.Info);
            using var content = new MultipartFormDataContent();
            var fileContent = new ByteArrayContent(options.Bytes);
            fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue("application/zip");
            content.Add(fileContent, "file", options.FileName);

            var basePath = _selectedFolder is { } folder ? $"api/documents/{folder.Id}/import" : "api/repositories/import";
            var query = $"?updateExisting={options.UpdateExisting.ToString().ToLowerInvariant()}&includePermissions={options.IncludePermissions.ToString().ToLowerInvariant()}&merge={options.Merge.ToString().ToLowerInvariant()}&leafConflict={options.LeafConflict}";
            var resp = await Http.PostAsync($"{basePath}{query}", content);
            if (!resp.IsSuccessStatusCode)
            {
                Snackbar.Add(string.Format(Strings.Get("StImportFailedStatus"), (int)resp.StatusCode), Severity.Error);
                return;
            }

            var result = await resp.Content.ReadFromJsonAsync<ImportResultDto>();
            var skipped = result?.Skipped > 0 ? $", {result.Skipped} already imported" : "";
            Snackbar.Add(string.Format(Strings.Get("StImported"), result?.RootName, result?.Documents, result?.Versions, skipped), Severity.Success);
            await RefreshAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(string.Format(Strings.Get("StImportFailed"), ex.Message), Severity.Error);
        }
    }

    private sealed class ImportResultDto
    {
        public string? RootName { get; set; }
        public int Documents { get; set; }
        public int Versions { get; set; }
        public int Folders { get; set; }
        public int Skipped { get; set; }
    }

