                                            <div style="flex:1 1 auto; min-height:0; overflow:auto; padding:12px;"><pre style="white-space:pre-wrap; margin:0; font-family:Menlo,Consolas,monospace; font-size:.82em;">@_rbPv.Text</pre></div>
                                        }
                                        else
                                        {
                                            <div class="wb-pv-placeholder mud-text-secondary" style="flex:1 1 auto; display:flex; align-items:center; justify-content:center;">@Strings.Get("NoPreview")</div>
                                        }
                                    }
                                    @if (_rbPv.Converted && _rbPv.HasPages)
                                    {
                                        <div class="wb-pv-badge">@Strings.Get("RbConvertedPreview")</div>
                                    }
                                </div>
                                <div style="flex:1 1 0; min-width:0; overflow:auto; border-left:1px solid var(--mud-palette-lines-default); padding:8px;">
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-1">@Strings.Get("RbCommentsHeader")</MudText>
                                    @foreach (var c in _rbComments)
                                    {
                                        <div class="mb-2">
                                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@c.AuthorName · @c.CreatedAt.ToLocalTime().ToString("g")</MudText>
                                            <MudText Typo="Typo.body2">@c.Body</MudText>
                                        </div>
                                    }
                                    @if (_rbComments.Count == 0)
                                    {
                                        <MudText Typo="Typo.body2" Class="mud-text-secondary">@Strings.Get("RbNoComments")</MudText>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="wb-placeholder">
                    <MudText Typo="Typo.h6">@_activeTab &mdash; coming soon</MudText>
                </div>
            }

            @* ---- Bottom tabs ---- *@
            @* Bottom tabs (#298): icon-only on hover-capable computers, with the label in a `title` tooltip +
               `aria-label`; touch devices (no hover → no tooltip) keep the visible label via the .wb-tab-label span.
               Check-out/Tasks show their live count as a small badge overlaid on the icon (mirrors the desktop). *@
            <div class="wb-tabs">
                <div class="wb-tab @(_activeTab == Tab.Repositories ? "wb-tab-active" : "")" title="@Strings.Get("TabRepositories")" aria-label="@Strings.Get("TabRepositories")" @onclick="() => SetTab(Tab.Repositories)">
                    <span class="wb-tab-ico"><MudIcon Icon="@Icons.Material.Filled.Folder" Size="Size.Small" /></span>
                    <span class="wb-tab-label">@Strings.Get("TabRepositories")</span>
