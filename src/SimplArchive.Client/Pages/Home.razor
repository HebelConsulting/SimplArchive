                <div class="wb-tab @(_activeTab == Tab.Inbox ? "wb-tab-active" : "")" title="@Strings.Get("TabInbox")" aria-label="@Strings.Get("TabInbox")" @onclick="() => SetTab(Tab.Inbox)">
                    <span class="wb-tab-ico"><MudIcon Icon="@Icons.Material.Filled.Inbox" Size="Size.Small" /></span>
                    <span class="wb-tab-label">@Strings.Get("TabInbox")</span>
                </div>
                <div class="wb-tab @(_activeTab == Tab.Checkout ? "wb-tab-active" : "")" title="@Strings.Get("TabCheckout")" aria-label="@Strings.Get("TabCheckout")" @onclick="() => SetTab(Tab.Checkout)">
                    <span class="wb-tab-ico">
                        <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" />
