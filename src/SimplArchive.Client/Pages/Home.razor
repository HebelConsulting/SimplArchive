    // Open the scope dialog for my own saved search (ADR "Scoped saved-search sharing") — loads the picker
    // targets + current grants, then owner-only PUTs the chosen scope + principals.
    private async Task OpenShareDialogAsync(SavedSearchDto s)
    {
        var targets = new List<ShareSavedSearchDialog.TargetOption>();
        try
        {
            var t = await Http.GetFromJsonAsync<ShareTargetsResponse>("api/saved-searches/share-targets");
            targets.AddRange((t?.Users ?? []).Select(u => new ShareSavedSearchDialog.TargetOption("user", u.Id, u.DisplayName)));
            targets.AddRange((t?.Groups ?? []).Select(g => new ShareSavedSearchDialog.TargetOption("group", g.Id, g.Name)));
        }
        catch (Exception) { /* empty picker */ }

        var initialSelected = new List<string>();
        if (s.ShareScope == 2)
        {
            try
            {
                var shares = await Http.GetFromJsonAsync<SharesResponse>($"api/saved-searches/{s.Id}/shares");
                initialSelected.AddRange((shares?.Shares ?? []).Select(g => $"{g.PrincipalType}:{g.PrincipalId}"));
            }
            catch (Exception) { /* none */ }
        }

        var parameters = new DialogParameters
        {
            ["Name"] = s.Name,
            ["InitialScope"] = s.ShareScope,
            ["Targets"] = targets,
            ["InitialSelected"] = initialSelected,
        };
        var dialog = await DialogService.ShowAsync<ShareSavedSearchDialog>("Share saved search", parameters);
        if ((await dialog.Result) is not { Canceled: false, Data: ShareSavedSearchDialog.Result result })
        {
            return;
        }

        var shareBody = result.Selected.Select(k => new { type = k.Split(':')[0], id = Guid.Parse(k.Split(':')[1]) }).ToList();
        using var resp = await Http.PutAsJsonAsync($"api/saved-searches/{s.Id}", new { name = s.Name, queryString = s.QueryString, shareScope = result.Scope, shares = shareBody });
        if (resp.IsSuccessStatusCode)
        {
            Snackbar.Add(result.Scope switch { 1 => $"Shared '{s.Name}' with everyone.", 2 => $"Shared '{s.Name}' with specific people.", _ => $"'{s.Name}' is now private." }, Severity.Success);
            await LoadSavedSearchesAsync();
        }
        else
        {
            Snackbar.Add("Could not change sharing.", Severity.Warning);
        }
    }

    // The free-text term inside a saved query string (for showing in the search box on restore).
    private static string ExtractQ(string queryString)
    {
        foreach (var part in queryString.Split('&'))
        {
            if (part.StartsWith("q=", StringComparison.Ordinal))
            {
                return Uri.UnescapeDataString(part[2..]);
            }
        }

        return "";
    }

