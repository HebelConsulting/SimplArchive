    // ---- Link helpers + DTOs -------------------------------------------------------------------------

    // ---- WebDAV mount (ADR "WebDAV Inbox/Check-out under Personal") -----------------------------

    // Copies the WebDAV mount URL of the caller's Personal folder (which holds the Inbox, Check-out, and personal
    // archive) so the user can paste it into their OS "Connect to Server" dialog (ADR "WebDAV Inbox/Check-out
    // under Personal"). A browser can't mount WebDAV itself, so this is copy-to-clipboard rather than a launch.
    private async Task CopyWebDavUrlAsync()
    {
        try
        {
            var status = await Http.GetFromJsonAsync<WebDavStatusDto>(await ApiRoot.RequireMeAsync("webdavPassword"));
            if (status is not { Enabled: true } || string.IsNullOrEmpty(status.Url))
            {
                Snackbar.Add(Strings.Get("StSetUpWebDavFirst"), Severity.Info);
                return;
            }

            // The single "SimplArchive" resource (ADR 0509) — mounting it lists the whole tree (Personal, with
            // Inbox/Check-out, + the shared repositories).
            var mountUrl = status.Url.TrimEnd('/');
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", mountUrl);
            Snackbar.Add(string.Format(Strings.Get("StCopiedWebDavUrl"), mountUrl), Severity.Success);
        }
        catch (Exception)
        {
            Snackbar.Add(Strings.Get("StErrCopyWebDavUrl"), Severity.Error);
        }
    }

    private record WebDavStatusDto
    {
        public bool Enabled { get; set; }
        public string Url { get; set; } = "";
    }


    // The rels the OPEN document's resource advertised (set when the detail pane loads).
    private IReadOnlyDictionary<string, string>? _detailLinks;

    // Collection-level rels, captured where each collection is read (ADR 0543, issue #416). Null until then,
    // which is what disables the action rather than the client composing a path for it.

    private string DetailHref(string rel) => HrefOrThrow(_detailLinks, rel);

    // For an action on a node whose resource is not open — "Follow folder" from the tree context menu — FETCH
    // the document and follow the rel. One request, at the moment the user acts.
    //
    // Deliberately not solved by advertising `subscription` on the listings: a listing advertises what BROWSING
    // needs, and this is an action taken on ONE row, occasionally. Carrying it on every row of every page to
    // serve that would invert the cost (#416).
    private async Task<string> FetchDocumentRelAsync(Guid documentId, string rel)
    {
        var doc = await Http.GetFromJsonAsync<DocumentLinksResponse>($"api/documents/{documentId}");
        return Links.Href(doc?.Links, rel)
            ?? throw new InvalidOperationException($"Document {documentId} advertised no '{rel}' rel (ADR 0543).");
    }

    // The row's own advertised rel when it has one — no extra call — else the OPEN RESOURCE's, which this pane
    // has already fetched. Not every BrowseNode comes from a listing: a reference row, or a node built from an
    // id when navigating to a referencing folder, carries nothing. Those are exactly the "I hold an id, not a
    // resource" case, and the answer is to follow the resource we just fetched — never to compose (ADR 0543).
    private string RowOrDetailHref(BrowseNode item, string rel) =>
        item.Links is not null && item.Links.TryGetValue(rel, out var href) ? href : DetailHref(rel);

    // Throws rather than composing a fallback: a rel that was not advertised means the action is not available
    // here (ADR 0543), and rebuilding the path would paper over exactly what this is replacing.
    private static string HrefOrThrow(IReadOnlyDictionary<string, string>? links, string rel) =>
        links is not null && links.TryGetValue(rel, out var href)
            ? href
            : throw new InvalidOperationException($"The '{rel}' rel was not advertised (ADR 0543).");

