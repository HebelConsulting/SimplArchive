    // Non-member tenant users matching the typed text — the add-picker's candidates.
    private Task<IEnumerable<MemberOption>> SearchNonMembers(string? text, CancellationToken _)
    {
        var memberIds = _groupMembers.Select(m => m.Id).ToHashSet();
        var candidates = _principals
            .Where(p => !p.IsGroup && !memberIds.Contains(p.Id))
            .Where(p => string.IsNullOrWhiteSpace(text) || p.Name.Contains(text, StringComparison.OrdinalIgnoreCase))
            .OrderBy(p => p.Name, StringComparer.OrdinalIgnoreCase)
            .Select(p => new MemberOption(p.Id, p.Name));
        return Task.FromResult<IEnumerable<MemberOption>>(candidates);
    }

