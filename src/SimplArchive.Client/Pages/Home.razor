    // The tenant's users and groups as dialog options. Only the external-links dialog needs them, so this is
    // deliberately a fetch-on-open rather than page state — nothing else here would keep it fresh.
    private async Task<(List<Dialogs.MyExternalLinksDialog.PrincipalOption> Users, List<Dialogs.MyExternalLinksDialog.PrincipalOption> Groups)> LoadPrincipalDirectoryAsync()
    {
        var users = new List<Dialogs.MyExternalLinksDialog.PrincipalOption>();
        var groups = new List<Dialogs.MyExternalLinksDialog.PrincipalOption>();

        try
        {
            var url = await ApiRoot.RequireAsync("users");
            while (url is not null)
            {
                var page = await Http.GetFromJsonAsync<UsersDirectoryResponse>(url);
                users.AddRange((page?.Users ?? []).Select(u => new Dialogs.MyExternalLinksDialog.PrincipalOption(u.Id, u.DisplayName, u.DisplayName)));
                url = Links.Href(page?.Links, "next");
            }

            url = await ApiRoot.RequireAsync("groups");
            while (url is not null)
            {
                var page = await Http.GetFromJsonAsync<GroupsDirectoryResponse>(url);
                groups.AddRange((page?.Groups ?? []).Select(g => new Dialogs.MyExternalLinksDialog.PrincipalOption(g.Id, g.Name, g.Name)));
                url = Links.Href(page?.Links, "next");
            }
        }
        catch (Exception)
        {
            // Non-fatal: a caller who cannot read the directory simply gets no filters, which is what a
            // non-admin sees anyway.
        }

        return (users, groups);
    }

