    private static string? RelativeHref(List<LinkResponse>? links, string rel)
    {
        var href = links?.FirstOrDefault(l => l.Rel == rel)?.Href;
        if (href is null) return null;
        return href.StartsWith("http://") || href.StartsWith("https://") ? href : href.TrimStart('/');
    }

    private string? RelativeToAbsolute(string? href)
    {
        if (href is null) return null;
        return href.StartsWith("http://") || href.StartsWith("https://") ? href : new Uri(Http.BaseAddress!, href).ToString();
    }

