    // Contents ordering (ADR "Per-folder contents sort order"): folders are ALWAYS listed on top; within each
    // group the default is the open folder's persisted ContentsSortOrder (_folderSortOrder, loaded from the
    // ListChildren envelope). Clicking a column header is an EPHEMERAL override (_headerSortActive) that resets
    // when another folder is opened. Client-side over the fully-loaded rows (the listing loads all pages).
    private FolderContentsSortOrder _folderSortOrder = FolderContentsSortOrder.DocumentDate;
    private bool _headerSortActive;

    private enum ContentSort { Name, Type, Date, Size, Tags }
    private ContentSort _contentSort = ContentSort.Name;
    private bool _contentSortAsc = true;

    private void SortBy(ContentSort col)
    {
        if (_headerSortActive && _contentSort == col)
        {
            _contentSortAsc = !_contentSortAsc;
        }
        else
        {
            _contentSort = col;
            _contentSortAsc = true;
            _headerSortActive = true; // an ephemeral override, until the next folder is opened
        }
    }

    private string SortArrow(ContentSort col) => _headerSortActive && _contentSort == col ? (_contentSortAsc ? "▲" : "▼") : "";

    private IEnumerable<BrowseNode> SortedContents()
    {
        // Folders on top (always alphabetical, issue #339), then documents ordered by the active criterion (default
        // DocumentDate). A column-header click is an explicit ephemeral override of the whole list.
        var folders = _folderContents.Where(n => n.IsFolder);
        var docs = _folderContents.Where(n => !n.IsFolder);
        if (_headerSortActive)
        {
            return ApplyHeaderSort(folders).Concat(ApplyHeaderSort(docs));
        }
        return folders.OrderBy(n => n.DisplayName, StringComparer.OrdinalIgnoreCase).Concat(ApplyFolderSort(docs));
    }

    private IEnumerable<BrowseNode> ApplyFolderSort(IEnumerable<BrowseNode> items) => _folderSortOrder switch
    {
        FolderContentsSortOrder.DocumentDate => items.OrderBy(n => n.DocumentDate ?? DateOnly.MinValue).ThenBy(n => n.DisplayName, StringComparer.OrdinalIgnoreCase),
        FolderContentsSortOrder.Created => items.OrderBy(n => n.VersionCreatedAt ?? DateTimeOffset.MinValue).ThenBy(n => n.DisplayName, StringComparer.OrdinalIgnoreCase),
        _ => items.OrderBy(n => n.DisplayName, StringComparer.OrdinalIgnoreCase),
    };

    private IEnumerable<BrowseNode> ApplyHeaderSort(IEnumerable<BrowseNode> items)
    {
        IEnumerable<BrowseNode> ordered = _contentSort switch
        {
            ContentSort.Type => items.OrderBy(n => n.DocumentType, StringComparer.OrdinalIgnoreCase),
            ContentSort.Date => items.OrderBy(n => n.DocumentDate ?? DateOnly.MinValue),
            ContentSort.Size => items.OrderBy(n => n.SizeBytes ?? -1),
            ContentSort.Tags => items.OrderBy(n => string.Join(",", n.TagList), StringComparer.OrdinalIgnoreCase),
            _ => items.OrderBy(n => n.DisplayName, StringComparer.OrdinalIgnoreCase),
        };
        return _contentSortAsc ? ordered : ordered.Reverse();
    }

    // Folder detail-pane editing of the persisted contents sort order (ADR "Per-folder contents sort order").
    private bool _folderEditing;
