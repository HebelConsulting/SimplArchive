@page "/"
@using System.IO
@using System.Net
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@implements IAsyncDisposable
@using SimplArchive.Client.Dialogs
@inject HttpClient Http
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject SimplArchive.Client.Services.ImpersonationService ImpersonationSvc
@inject SimplArchive.Client.Services.AppNavigationState AppNav

<PageTitle>SimplArchive</PageTitle>

<style>
    .wb { height: 100%; display: flex; flex-direction: column; background: var(--mud-palette-background); }
    /* flex-wrap so ribbon buttons reflow onto a new row when they don't fit, instead of clipping/overflowing —
       matching the preview-pane toolbar's wrapping behavior (both clients). */
    .wb-ribbon { flex: 0 0 auto; display: flex; flex-wrap: wrap; align-items: center; gap: 4px; padding: 6px 12px;
        border-bottom: 1px solid var(--mud-palette-lines-default); background: var(--mud-palette-surface); }
    /* #305: the label sits after the icon inside the button; a small gap when it's shown. */
    .wb-rib-btn .wb-rib-label { margin-left: 6px; }
    /* Icon-only ribbon buttons on hover-capable computers — the label rides in the `title` tooltip, matching the
       desktop client + the #298 tabs (ADR 0511). Touch devices keep the visible label. */
    @@media (hover: hover) and (pointer: fine) {
        .wb-rib-btn { min-width: 0; }
        .wb-rib-btn .wb-rib-label { display: none; }
    }
    .wb-cols { flex: 1 1 auto; min-height: 0; display: flex; }
    .wb-pane { overflow: auto; }
    /* Pane basis/collapsed state are set inline by wbLayout.js (persisted); these are the pre-JS fallbacks.
       Dividers are the gutters below, so panes carry no border on the gutter side. */
    .wb-tree { flex: 0 0 240px; padding: 4px; }
    .wb-list { flex: 0 0 300px; container-type: inline-size; }
    .wb-detail { flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column; }
    .wb-index { flex: 0 0 280px; overflow: auto; padding: 10px 14px; }
    /* System-fields grid + editable-mask form (ADRs 0273/0278). */
    .wb-sysfields { width: 100%; border-collapse: collapse; margin-top: 6px; }
    .wb-sysfields td { padding: 2px 6px 2px 0; vertical-align: middle; font-size: 0.82rem; }
    .wb-sysfields td:first-child { width: 110px; color: var(--mud-palette-text-secondary); white-space: nowrap; }
    .wb-sys-muted { color: var(--mud-palette-text-secondary); }
    .wb-mask-edit { margin-top: 10px; }
    .wb-mask-row { display: flex; align-items: center; gap: 8px; margin: 4px 0; }
    .wb-mask-label { width: 150px; flex: 0 0 auto; color: var(--mud-palette-text-secondary); font-size: 0.82rem; }
    .wb-mask-row .mud-input-control { flex: 1 1 auto; }
    .wb-ocr-chips { display: flex; flex-wrap: wrap; gap: 4px; }
    .wb-ocr-chip { border: 1px solid var(--mud-palette-lines-default); border-radius: 12px; padding: 1px 8px; font-size: 0.75rem; background: transparent; cursor: pointer; color: var(--mud-palette-text-primary); }
    .wb-ocr-chip-on { background: var(--mud-palette-primary); color: var(--mud-palette-primary-text); border-color: var(--mud-palette-primary); }
    .wb-detail-actions { display: flex; justify-content: flex-end; gap: 8px; margin-top: 12px; }
    .wb-detail-bottom { flex: 1 1 auto; min-height: 0; display: flex; }
    .wb-preview { flex: 1 1 auto; min-width: 0; display: flex; position: relative; }
    .wb-preview iframe { width: 100%; height: 100%; border: 0; }
    /* pdf.js / image preview with search hit-overlay + click-to-copy (ADRs 0268/0269/0282). */
    .wb-pv-host { flex: 1 1 auto; min-height: 0; overflow: auto; padding: 8px; background: var(--mud-palette-background-grey); text-align: center; }
    .wb-pv-page { position: relative; display: inline-block; margin: 0 auto 8px; max-width: 100%; box-shadow: 0 1px 4px rgba(0,0,0,.2); }
    .wb-pv-media { display: block; width: 100%; height: auto; }
    .wb-pv-overlay { position: absolute; inset: 0; cursor: pointer; }
    .wb-pv-hit { position: absolute; background: rgba(255,213,0,.4); outline: 1px solid rgba(224,164,0,.8); }
    .wb-pv-hit-active { background: rgba(255,140,0,.55); outline: 2px solid rgba(210,110,0,1); }
    /* Sticky-note markers (ADR "Document annotations"): a small coloured square pinned at the note's position. */
    /* A sticky-note box showing its text, always visible (ADR "Post-it note boxes" web parity). Height grows to
       fit the text but is at least the persisted min-height, so a note keeps its true (resized) height. */
    .wb-pv-note { position: absolute; min-width: 90px; box-sizing: border-box; padding: 5px 7px; border-radius: 4px; border: 1px solid rgba(0,0,0,.5); box-shadow: 0 1px 3px rgba(0,0,0,.35); cursor: grab; color: #222; font-size: 12px; line-height: 1.25; word-break: break-word; white-space: pre-wrap; }
    .wb-pv-note-grip { position: absolute; right: 0; bottom: 0; width: 14px; height: 14px; cursor: nwse-resize; background: linear-gradient(135deg, transparent 55%, rgba(0,0,0,.45) 55%, rgba(0,0,0,.45) 68%, transparent 68%, transparent 80%, rgba(0,0,0,.45) 80%, rgba(0,0,0,.45) 92%, transparent 92%); }
    /* Multi-select (ADR "Annotation multi-select" web parity): a dashed outline on selected annotations + the marquee rubber-band. */
    .wb-pv-selected { outline: 2px dashed #2f6fed; outline-offset: 2px; }
    .wb-pv-marquee { position: absolute; background: rgba(47,111,237,.13); border: 1px dashed rgba(47,111,237,.7); pointer-events: none; }
    .wb-pv-adding .wb-pv-overlay { cursor: crosshair; }
    /* Markup shapes (ADR "Annotation markup"): highlight box, rectangle outline, arrow (SVG). */
    .wb-pv-shape { position: absolute; pointer-events: none; }
    /* Shapes are movable (drag the body) — a move cursor, not a link-hand (ADR "Highlighting redesign"). */
    .wb-pv-hl { opacity: .38; border-radius: 2px; cursor: move; }
    .wb-pv-rect { border: 2px solid #F44336; background: transparent; cursor: move; }
    .wb-pv-arrow { overflow: visible; cursor: move; }
    .wb-pv-arrow line { stroke: #F44336; stroke-width: .8; vector-effect: non-scaling-stroke; }
    .wb-pv-arrow polygon { fill: #F44336; }
    .wb-pv-stamp { border: 2px solid #F44336; background: transparent; color: #F44336; display: flex; align-items: center; justify-content: center; text-align: center; font-weight: 700; text-transform: uppercase; font-size: .8rem; letter-spacing: .05em; opacity: .85; border-radius: 3px; overflow: hidden; cursor: move; }
    .wb-pv-textbox { border: 1px solid #1976D2; background: rgba(255,255,255,.75); color: #222; padding: 2px 4px; font-size: .72rem; overflow: hidden; cursor: move; }
    .wb-pv-strike { cursor: move; }
    .wb-pv-strike::after { content: ''; position: absolute; left: 0; right: 0; top: 50%; border-top: 2px solid currentColor; }
    .wb-pv-freehand { overflow: visible; cursor: move; }
    .wb-pv-freehand polyline { fill: none; stroke: #F44336; stroke-width: .8; vector-effect: non-scaling-stroke; }
    /* A resize grip on a box shape (highlight/rectangle), like the note grip. */
    .wb-pv-shape-grip { position: absolute; right: -3px; bottom: -3px; width: 12px; height: 12px; cursor: nwse-resize; background: rgba(0,0,0,.55); border: 1px solid #fff; border-radius: 2px; pointer-events: auto; }
    /* Toolbar colour palette (ADR "Highlighting redesign"). */
    .wb-pv-palette { display: inline-flex; gap: 3px; align-items: center; margin: 0 4px; }
    .wb-pv-swatch { width: 16px; height: 16px; border-radius: 3px; cursor: pointer; border: 2px solid rgba(0,0,0,.3); }
    .wb-pv-swatch-on { border-color: var(--mud-palette-primary); }
    .wb-pv-shape-preview { opacity: .6; pointer-events: none; }
    .wb-pv-drawing .wb-pv-overlay { cursor: crosshair; }
    .wb-pv-findbar { flex: 0 0 auto; display: flex; align-items: center; gap: 6px; padding: 4px 8px; border-bottom: 1px solid var(--mud-palette-lines-default); }
    .wb-pv-findbar .wb-pv-fs-btn { margin-left: auto; }
    /* In-app full-screen: the preview pane becomes a fixed overlay over the workbench, stopping just above the
       bottom tab bar (`--wb-tab-h`, measured by preview.js on enter) so the tabs stay visible and clickable.
       z-index sits above the app bar (1100) but below MudBlazor's snackbar (1400) so the click-to-copy toast
       still shows on top. */
    /* Keep the inherited `display:flex` row direction (the inner findbar+host wrapper is the single flex item and
       stretches to this fixed height, so the host's overflow:auto clips to the pane); switching to column here
       let the wrapper grow to its full content height and overflow past the fixed container onto the tab bar. */
    .wb-pv-fullscreen { position: fixed !important; top: 0; left: 0; right: 0; bottom: var(--wb-tab-h, 41px);
        z-index: 1300; background: var(--mud-palette-surface); padding: 4px; }
    /* "Converted preview" badge, bottom-right corner (avoids the top PDF-viewer toolbar). */
    /* Sensitivity watermark overlay (ADR "Document watermarking") — a repeating diagonal label+viewer, over the
       preview but click-through so it doesn't block the pdf.js hit-overlay. */
    .wb-watermark { position: absolute; inset: 0; z-index: 3; pointer-events: none; background-repeat: repeat; }
    .wb-preview-badge { position: absolute; bottom: 10px; right: 10px; z-index: 4;
        display: flex; align-items: center; gap: 4px; padding: 3px 9px; border-radius: 11px;
        font-size: .72rem; font-weight: 500; background: rgba(0,0,0,.62); color: #fff; }
    .wb-preview-badge .mud-icon-root { font-size: .95rem; }
    .wb-preview-empty { flex: 1 1 auto; display: flex; align-items: center; justify-content: center; color: var(--mud-palette-text-secondary); }
    .wb-chat { flex: 0 0 340px; min-height: 0; display: flex; flex-direction: column; }
    /* A collapsed pane shrinks to nothing; its gutter stays as the re-open strip. */
    [data-collapsed] { overflow: hidden !important; padding: 0 !important; min-width: 0; min-height: 0; }
    .wb-gutter { flex: 0 0 8px; position: relative; display: flex; align-items: center; justify-content: center;
        background: var(--mud-palette-surface); }
    .wb-gutter:hover { background: var(--mud-palette-action-default-hover); }
    .wb-gutter-v { cursor: col-resize; border-left: 1px solid var(--mud-palette-lines-default);
        border-right: 1px solid var(--mud-palette-lines-default); }
    .wb-gutter-h { cursor: row-resize; border-top: 1px solid var(--mud-palette-lines-default);
        border-bottom: 1px solid var(--mud-palette-lines-default); }
    .wb-gutter-toggle { position: absolute; z-index: 2; width: 16px; height: 16px; padding: 0; line-height: 1;
        display: flex; align-items: center; justify-content: center; font-size: 11px; cursor: pointer;
        border: 1px solid var(--mud-palette-lines-default); border-radius: 3px;
        background: var(--mud-palette-surface); color: var(--mud-palette-text-secondary); }
    .wb-gutter-toggle:hover { color: var(--mud-palette-primary); border-color: var(--mud-palette-primary); }
    .wb-chat-empty { flex: 1 1 auto; display: flex; flex-direction: column; align-items: center; justify-content: center;
        gap: 8px; color: var(--mud-palette-text-secondary); text-align: center; padding: 14px; }
    .wb-chat-header { flex: 0 0 auto; padding: 8px 12px; border-bottom: 1px solid var(--mud-palette-lines-default); }
    .wb-chat-thread { flex: 1 1 auto; overflow: auto; padding: 6px 12px; }
    .wb-comment { padding: 6px 0; }
    .wb-comment-reply { margin-left: 18px; border-left: 2px solid var(--mud-palette-lines-default); padding-left: 10px; }
    .wb-comment-meta { font-size: .72rem; color: var(--mud-palette-text-secondary); }
    .wb-comment-body { font-size: .9rem; white-space: pre-wrap; }
    .wb-reply-link { font-size: .72rem; color: var(--mud-palette-primary); cursor: pointer; user-select: none; }
    .wb-compose { flex: 0 0 auto; border-top: 1px solid var(--mud-palette-lines-default); padding: 8px 12px; }
    .wb-compose-actions { display: flex; justify-content: flex-end; margin-top: 4px; }
    .wb-tabs { flex: 0 0 auto; display: flex; border-top: 1px solid var(--mud-palette-lines-default); background: var(--mud-palette-surface); }
    .wb-tab { padding: 8px 22px; cursor: pointer; border-right: 1px solid var(--mud-palette-lines-default);
        user-select: none; font-size: .9rem; display: flex; align-items: center; gap: 6px; }
    .wb-tab-active { background: var(--mud-palette-primary); color: var(--mud-palette-primary-text); }
    .wb-tab-disabled { opacity: .5; cursor: not-allowed; }
    /* #298: the icon wrapper anchors the live-count badge (Check-out/Tasks), mirroring the desktop client. */
    .wb-tab-ico { position: relative; display: inline-flex; align-items: center; }
    .wb-tab-badge { position: absolute; top: -5px; right: -9px; min-width: 16px; height: 16px; padding: 0 4px;
        box-sizing: border-box; display: flex; align-items: center; justify-content: center; border-radius: 8px;
        font-size: .625rem; line-height: 1; background: var(--mud-palette-primary); color: var(--mud-palette-primary-text); }
    /* On the active tab the tab background is already primary, so invert the badge to stay legible. */
    .wb-tab-active .wb-tab-badge { background: var(--mud-palette-primary-text); color: var(--mud-palette-primary); }
    /* Icon-only tabs on hover-capable computers — the label rides in the `title` tooltip (#298). Touch devices
       (no hover ⇒ no tooltip) fall outside this query and keep the visible .wb-tab-label. */
    @@media (hover: hover) and (pointer: fine) {
        .wb-tab { padding: 8px 14px; }
        .wb-tab-label { display: none; }
    }
    .wb-bulk-bar { display: flex; align-items: center; gap: 4px; padding: 3px 8px; background: var(--mud-palette-primary-hover); border-bottom: 1px solid var(--mud-palette-lines-default); position: sticky; top: 0; z-index: 2; }
    /* Contents-list columns (ADR "List-row columns and sorting" + "Pane-adaptive contents columns") — a grid
       modifier on .wb-list-row (higher specificity so it overrides the base flex layout), keeping the base
       hover/cursor/selected + test hooks. Every track is minmax(0, …) so the cells SHRINK + ellipsize rather than
       overflow the pane, and the trailing `auto` track is the ⋮ row-menu — it never shrinks and is always the last
       visible column, so the menu can never be clipped/scrolled off. The `.wb-list` pane is an inline-size query
       container (above), so the breakpoints below react to the *pane's own width*, not the viewport — collapsing
       lower-priority columns as the user narrows the split, uniformly on computer/tablet/phone. */
    .wb-list-row.wb-cols, .wb-chead { display: grid; grid-template-columns: minmax(0, 2.4fr) minmax(0, 1fr) minmax(0, 92px) minmax(0, 70px) minmax(0, 1.3fr) auto; align-items: center; gap: 8px; }
    .wb-chead { padding: 4px 12px; font-size: .72rem; font-weight: 600; color: var(--mud-palette-text-secondary); border-bottom: 1px solid var(--mud-palette-lines-default); position: sticky; top: 0; background: var(--mud-palette-surface); z-index: 1; }
    .wb-chead > span { cursor: pointer; user-select: none; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .wb-ccell { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: .82rem; color: var(--mud-palette-text-secondary); }
    .wb-cname { display: flex; align-items: center; gap: 6px; color: var(--mud-palette-text-primary); font-size: unset; }
    /* Medium pane: drop Size (4th) + Tags (5th), keeping Name · Type · Doc date · ⋮. */
    @@container (max-width: 519px) {
        .wb-list-row.wb-cols, .wb-chead { grid-template-columns: minmax(0, 2.4fr) minmax(0, 1fr) minmax(0, 92px) auto; }
        .wb-list-row.wb-cols > :nth-child(4), .wb-list-row.wb-cols > :nth-child(5),
        .wb-chead > :nth-child(4), .wb-chead > :nth-child(5) { display: none; }
    }
    /* Narrow pane: Name + ⋮ only (the menu stays — it isn't a .wb-ccell). */
    @@container (max-width: 399px) {
        .wb-list-row.wb-cols, .wb-chead { grid-template-columns: minmax(0, 1fr) auto; }
        .wb-list-row.wb-cols > .wb-ccell:not(.wb-cname), .wb-chead > span:not(:first-child) { display: none; }
    }
    .wb-list-row { display: flex; align-items: center; gap: 8px; padding: 5px 12px; cursor: pointer; user-select: none; }
    .wb-list-row:hover { background: var(--mud-palette-action-default-hover); }
    .wb-list-row-selected { background: var(--mud-palette-primary-hover); }
    .wb-placeholder { flex: 1 1 auto; display: flex; align-items: center; justify-content: center; color: var(--mud-palette-text-secondary); }
    /* Fill the space between the ribbon and the bottom tab bar (and scroll internally), so the tab bar stays
       pinned — same as .wb-cols/.wb-search. Without this the content-sized panel lets the tab bar ride up or
       get pushed off-screen. */
    .wb-tasks, .wb-checkout, .wb-tenant, .wb-mywork, .wb-tags { flex: 1 1 auto; min-height: 0; }
    .wb-setting-row { display: flex; align-items: flex-start; gap: 4px; }
    .wb-setting-row .mud-icon-button { margin-top: 6px; }
    /* Users & groups admin tab: principal list | rights matrix. Fills to the tab bar, same as .wb-cols. */
    .wb-ug { flex: 1 1 auto; min-height: 0; display: flex; }
    .wb-ug-list { flex: 0 0 300px; min-width: 0; display: flex; flex-direction: column; border-right: 1px solid var(--mud-palette-lines-default); }
    .wb-ug-toolbar { flex: 0 0 auto; display: flex; align-items: center; gap: 2px; padding: 4px 6px; border-bottom: 1px solid var(--mud-palette-lines-default); }
    .wb-ug-rows { flex: 1 1 auto; min-height: 0; overflow: auto; }
    .wb-ug-rights { flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column; padding: 14px 18px; overflow: auto; }
    .wb-ug-rights-head { display: flex; align-items: center; gap: 8px; margin-bottom: 10px; }
    .wb-ug-rights-grid { display: grid; grid-template-columns: repeat(2, minmax(220px, 1fr)); gap: 0 24px; }
    .wb-ug-right { margin: 0; }
    .wb-ug-photo { display: flex; align-items: center; gap: 12px; margin-bottom: 12px; }
    .wb-ug-members { max-width: 360px; }
    .wb-ug-member { display: flex; align-items: center; gap: 8px; padding: 2px 0; }
    .drop-target-active { outline: 2px dashed var(--mud-palette-primary); outline-offset: -3px; background: var(--mud-palette-primary-hover); }
    .wb-search { flex: 1 1 auto; min-height: 0; display: flex; flex-direction: column; padding: 12px 16px; }
    .wb-search-bar { flex: 0 0 auto; display: flex; align-items: center; }
    .wb-search-status { flex: 0 0 auto; font-size: .8rem; color: var(--mud-palette-text-secondary); padding: 8px 2px; }
    .wb-search-filters { flex: 0 0 auto; display: flex; flex-direction: column; gap: 6px; padding: 4px 2px 8px; }
    .wb-filter-row { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .wb-filter-label { flex: 0 0 96px; font-size: .8rem; color: var(--mud-palette-text-secondary); }
    .wb-filter-date { max-width: 150px; }
    .wb-saved-searches { flex: 0 0 auto; display: flex; align-items: center; flex-wrap: wrap; gap: 4px; padding: 4px 2px; }
    .wb-search-facets { flex: 0 0 auto; display: flex; flex-direction: column; gap: 2px; padding: 2px 2px 8px; border-bottom: 1px solid var(--mud-palette-lines-default); margin-bottom: 4px; }
    .wb-facet-group { display: flex; align-items: center; flex-wrap: wrap; gap: 4px; }
    .wb-facet-label { font-size: .72rem; font-weight: 600; color: var(--mud-palette-text-secondary); min-width: 74px; }
    .wb-search-results { flex: 1 1 auto; min-height: 0; overflow: auto; }
    .wb-search-path { font-size: .72rem; color: var(--mud-palette-text-secondary); }
    .wb-search-snippet { font-size: .78rem; color: var(--mud-palette-text-secondary); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .wb-search-snippet em { font-style: normal; font-weight: 600; background: var(--mud-palette-warning-lighten); color: var(--mud-palette-text-primary); border-radius: 2px; padding: 0 1px; }
    /* Audit log viewer tab. Fills to the tab bar, same as .wb-cols. */
    .wb-audit { flex: 1 1 auto; min-height: 0; display: flex; flex-direction: column; }
    .wb-audit-filters { flex: 0 0 auto; display: flex; align-items: center; gap: 10px; flex-wrap: wrap; padding: 10px 14px; border-bottom: 1px solid var(--mud-palette-lines-default); }
    .wb-audit-retention { flex: 0 0 auto; display: flex; align-items: center; gap: 8px; flex-wrap: wrap; padding: 6px 14px; border-bottom: 1px solid var(--mud-palette-lines-default); }
    .wb-audit-rows { flex: 1 1 auto; min-height: 0; overflow: auto; }
    .wb-audit-table { width: 100%; border-collapse: collapse; font-size: .82rem; }
    .wb-audit-table th { text-align: left; position: sticky; top: 0; background: var(--mud-palette-surface); border-bottom: 1px solid var(--mud-palette-lines-default); padding: 6px 12px; font-weight: 600; }
    .wb-audit-table td { padding: 5px 12px; border-bottom: 1px solid var(--mud-palette-lines-default); vertical-align: top; }

    /* Phone drill-down chrome (ADR "Responsive phone drill-down") — hidden on desktop/tablet, shown only ≤767. */
    .wb-phone-topbar, .wb-phone-scrim, .wb-phone-detbar { display: none; }

    /* Responsive workbench (ADR "Responsive web workbench", iPad-first). Below 1200px wbLayout.js stops applying
       the persisted px pane widths (they'd overflow) and these rules govern: drop the lower-priority panes so
       tree | list | preview fit. Placed last so they win over the base .wb-* pane widths at equal specificity.
       (!important also beats any residual inline flex if JS hasn't cleared it yet.) */
    @@media (max-width: 1199px) {
        /* Tablet / iPad: drop the chat (comments) pane; trim the tree + contents list; the preview flexes to fill. */
        .wb-chat, [data-gutter="chat"] { display: none !important; }
        .wb-tree { flex: 0 0 190px !important; }
        .wb-list { flex: 0 1 34% !important; min-width: 200px; max-width: 340px; }
        /* Column collapse is handled by the .wb-list container queries above (by pane width), not here. */
        /* Many bottom tabs won't fit a tablet width — let them scroll horizontally rather than wrap/clip. */
        .wb-tabs { overflow-x: auto; }
        .wb-tab { white-space: nowrap; }
    }
    /* Phone single-pane drill-down (ADR "Responsive phone drill-down"), replacing the trimmed-3-pane tier: the
       tree becomes a slide-out drawer, the folder contents list is the default full-width view, and a selected
       document opens a full-screen detail overlay with Preview/Details/Comments sub-tabs. */
    @@media (max-width: 767px) {
        .wb-ribbon { padding: 4px 8px; }
        .wb-phone-topbar { display: flex; align-items: center; gap: 4px; flex: 0 0 auto; padding: 2px 6px;
            border-bottom: 1px solid var(--mud-palette-lines-default); background: var(--mud-palette-surface); }
        .wb-phone-title { font-size: .9rem; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

        /* wb-cols is the positioning context for the drawer + detail overlay; no resize gutters on a phone. */
        .wb-cols { position: relative; }
        .wb-cols [data-gutter] { display: none !important; }
        .wb-list { flex: 1 1 auto !important; min-width: 0; max-width: none; }

        /* Tree = slide-out drawer within the content region (below the ribbon, above the tabs). */
        .wb-tree { position: absolute; top: 0; left: 0; bottom: 0; width: 78%; max-width: 300px; z-index: 50;
            flex: none !important; transform: translateX(-104%); transition: transform .2s ease;
            background: var(--mud-palette-surface); box-shadow: 2px 0 8px rgba(0,0,0,.3); }
        .wb-cols.wb-phone-tree-open .wb-tree { transform: translateX(0); }
        .wb-phone-scrim-on { display: block; position: absolute; inset: 0; z-index: 45; background: rgba(0,0,0,.35); }

        /* Detail = full-screen overlay, shown only when a document is selected. */
        .wb-detail { position: absolute; inset: 0; z-index: 55; background: var(--mud-palette-background); display: none; }
        .wb-detail.wb-phone-detail-open { display: flex; flex-direction: column; }
        .wb-detail [data-gutter] { display: none !important; }
        .wb-phone-detbar { display: flex; align-items: center; gap: 2px; flex: 0 0 auto; padding: 2px 4px;
            border-bottom: 1px solid var(--mud-palette-lines-default); background: var(--mud-palette-surface); }
        .wb-ptab-btn { flex: 1 1 auto; padding: 7px 4px; border: 0; background: transparent; font-size: .82rem;
            color: var(--mud-palette-text-secondary); cursor: pointer; border-bottom: 2px solid transparent; }
        .wb-ptab-on { color: var(--mud-palette-primary); border-bottom-color: var(--mud-palette-primary); font-weight: 600; }

        /* Sub-tab pane visibility inside the overlay (chat + index were dropped by the wider tiers — re-show the
           active one; more-specific selectors beat those !important hides). */
        .wb-detail .wb-index { flex: 1 1 auto !important; }
        .wb-detail.wb-ptab-preview .wb-index { display: none; }
        .wb-detail.wb-ptab-preview .wb-detail-bottom { display: flex; }
        .wb-detail.wb-ptab-preview .wb-preview { display: flex; flex: 1 1 auto; }
        .wb-detail.wb-ptab-preview .wb-chat { display: none !important; }
        .wb-detail.wb-ptab-details .wb-index { display: flex !important; }
        .wb-detail.wb-ptab-details .wb-detail-bottom { display: none; }
        .wb-detail.wb-ptab-comments .wb-index { display: none; }
        .wb-detail.wb-ptab-comments .wb-detail-bottom { display: flex; }
        .wb-detail.wb-ptab-comments .wb-preview { display: none; }
        .wb-detail.wb-ptab-comments .wb-chat { display: flex !important; flex: 1 1 auto; }
    }
</style>

<AuthorizeView>
    <Authorized>
        <div class="wb" @ref="_dropRoot">
            @* ---- Ribbon (Repositories tab) ---- *@
            <div class="wb-ribbon">
                @* Ribbon buttons (#305): icon-only on hover-capable computers with the label in a `title` tooltip +
                   `aria-label`; touch keeps the visible .wb-rib-label. Matches the desktop client + the #298 tabs
                   (ADR 0511). The icon + label are our own child content so hiding the label leaves a clean icon. *@
                @if (_activeTab == Tab.Repositories)
                {
                    <MudButton Class="wb-rib-btn" Size="Size.Small" Disabled="@(_selectedFolder is null)" OnClick="UploadAsync" title="@Strings.Get("Upload")" aria-label="@Strings.Get("Upload")">
                        <MudIcon Icon="@Icons.Material.Filled.Upload" Size="Size.Small" /><span class="wb-rib-label">@Strings.Get("Upload")</span>
                    </MudButton>
                    <MudButton Class="wb-rib-btn" Size="Size.Small" Disabled="@(_selectedFolder is null)" OnClick="NewFolderAsync" title="@Strings.Get("NewFolder")" aria-label="@Strings.Get("NewFolder")">
                        <MudIcon Icon="@Icons.Material.Filled.CreateNewFolder" Size="Size.Small" /><span class="wb-rib-label">@Strings.Get("NewFolder")</span>
                    </MudButton>
                    <MudButton Class="wb-rib-btn" Size="Size.Small" Disabled="@(_downloadUrl is null)" OnClick="DownloadAsync" title="@Strings.Get("Download")" aria-label="@Strings.Get("Download")">
                        <MudIcon Icon="@Icons.Material.Filled.Download" Size="Size.Small" /><span class="wb-rib-label">@Strings.Get("Download")</span>
                    </MudButton>
                    <MudButton Class="wb-rib-btn" Size="Size.Small" Disabled="@(_selectedItem is null)" OnClick="() => OpenVersionsAsync(_selectedItem!)" title="@Strings.Get("RibbonVersions")" aria-label="@Strings.Get("RibbonVersions")">
                        <MudIcon Icon="@Icons.Material.Filled.History" Size="Size.Small" /><span class="wb-rib-label">@Strings.Get("RibbonVersions")</span>
                    </MudButton>
                    <MudButton Class="wb-rib-btn" Size="Size.Small" Disabled="@(_selectedItem is null)" OnClick="() => OpenWorkflowAsync(_selectedItem!.Id)" title="@Strings.Get("RibbonStartWorkflow")" aria-label="@Strings.Get("RibbonStartWorkflow")">
                        <MudIcon Icon="@Icons.Material.Filled.AccountTree" Size="Size.Small" /><span class="wb-rib-label">@Strings.Get("RibbonStartWorkflow")</span>
                    </MudButton>
                    <MudButton Class="wb-rib-btn" Size="Size.Small" OnClick="RefreshAsync" title="@Strings.Get("RibbonRefresh")" aria-label="@Strings.Get("RibbonRefresh")">
                        <MudIcon Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" /><span class="wb-rib-label">@Strings.Get("RibbonRefresh")</span>
                    </MudButton>
                    @if (_isTenantAdmin)
                    {
                        <MudButton Class="wb-rib-btn" Size="Size.Small" OnClick="RunTiffBackfillAsync" title="@Strings.Get("RibbonConvertScans")" aria-label="@Strings.Get("RibbonConvertScans")">
                            <MudIcon Icon="@Icons.Material.Filled.PictureAsPdf" Size="Size.Small" /><span class="wb-rib-label">@Strings.Get("RibbonConvertScans")</span>
                        </MudButton>
                    }
                    @if (_canExport)
                    {
                        <MudButton Class="wb-rib-btn" Size="Size.Small" Disabled="@(_selectedFolder is null)" OnClick="OpenExportDialogAsync" title="@Strings.Get("HomeExport")" aria-label="@Strings.Get("HomeExport")">
                            <MudIcon Icon="@Icons.Material.Filled.Archive" Size="Size.Small" /><span class="wb-rib-label">@Strings.Get("HomeExport")</span>
                        </MudButton>
                    }
                    @if (_canImport)
                    {
                        <MudButton Class="wb-rib-btn" Size="Size.Small" OnClick="OpenImportDialogAsync" title="@Strings.Get("HomeImport")" aria-label="@Strings.Get("HomeImport")">
                            <MudIcon Icon="@Icons.Material.Filled.Unarchive" Size="Size.Small" /><span class="wb-rib-label">@Strings.Get("HomeImport")</span>
                        </MudButton>
                    }
                    @if (_uploading)
                    {
                        <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="ml-2" />
                    }
                }
                else
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">@Strings.Get("NoActions")</MudText>
                }
            </div>

            @* ---- Tab content ---- *@
            @if (_activeTab == Tab.Repositories)
            {
                @* Phone-only top bar (ADR "Responsive phone drill-down"): the hamburger toggles the tree drawer;
                   the current folder name. Rendered ONLY in phone mode (not merely CSS-hidden) so its duplicate
                   folder-name text can't collide with the desktop tests' text locators. *@
                @if (_isPhone)
                {
                    <div class="wb-phone-topbar">
                        <MudIconButton Icon="@Icons.Material.Filled.Menu" Size="Size.Small" aria-label="Folders" OnClick="ToggleTreeDrawer" />
                        <span class="wb-phone-title">@(_selectedFolder?.Name ?? Strings.Get("TabRepositories"))</span>
                    </div>
                }
                <div class="wb-cols @(_treeDrawerOpen ? "wb-phone-tree-open" : "")" @ref="_layoutRoot">
                    @* Scrim behind the open tree drawer — tap to close (phone only). *@
                    @if (_isPhone)
                    {
                        <div class="wb-phone-scrim @(_treeDrawerOpen ? "wb-phone-scrim-on" : "")" @onclick="() => _treeDrawerOpen = false"></div>
                    }
                    <div class="wb-pane wb-tree" data-pane="tree">
                        @if (_loadingRoots)
                        {
                            <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                        }
                        else if (_roots.Count == 0)
                        {
                            <MudText Typo="Typo.body2" Class="pa-2">@Strings.Get("NoRepositories")</MudText>
                        }
                        else
                        {
                            <MudTreeView T="BrowseNode" Items="_roots" ServerData="LoadChildrenAsync"
                                         SelectedValue="_selectedFolder" Hover="true" Dense="true">
                                <ItemTemplate Context="item">
                                    @* Explicit OnClick per item: MudTreeView's SelectedValueChanged didn't
                                       reliably fire for nested nodes with a custom template, so a subfolder
                                       couldn't be selected. See ADR "Workbench pane content fixes". *@
                                    <MudTreeViewItem Value="@item.Value" Text="@item.Text" Icon="@item.Icon"
                                                     CanExpand="@item.Expandable" Items="@item.Children"
                                                     OnClick="@(() => SelectFolderAsync(item.Value))"
                                                     @attributes="DropAttributes(item.Value)" />
                                </ItemTemplate>
                            </MudTreeView>
                        }
                    </div>

                    <div class="wb-gutter wb-gutter-v" data-gutter="tree"><button type="button" class="wb-gutter-toggle"></button></div>

                    @* The whole contents pane is a drop target for the currently-listed folder, so files
                       can be dropped anywhere in it (empty area or a document row), not only onto a
                       sub-folder row — see ADR "Content-pane drop target". A sub-folder row's own
                       data-drop-folder still wins (closest() finds the nearest one). *@
                    <div class="wb-pane wb-list" data-pane="list" @attributes="ListDropAttributes()">
                        @* Bulk-action bar (ADR "Bulk actions on selected documents") — shows when ≥2 rows are Ctrl/Shift-selected. *@
                        @if (_bulkIds.Count >= 2 && _archiveDocument is null)
                        {
                            <div class="wb-bulk-bar">
                                <span style="flex:1 1 auto; font-size:.8rem; font-weight:600;">@string.Format(Strings.Get("BulkSelected"), _bulkIds.Count)</span>
                                <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.DriveFileMove" OnClick="BulkMoveAsync">@Strings.Get("BulkMove")</MudButton>
                                <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.Label" OnClick="BulkAddTagsAsync">@Strings.Get("BulkTag")</MudButton>
                                <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.Shield" OnClick="BulkSensitivityAsync">@Strings.Get("BulkSensLabel")</MudButton>
                                <MudButton Size="Size.Small" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" OnClick="BulkDeleteAsync">@Strings.Get("UgDelete")</MudButton>
                                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="() => { _bulkIds.Clear(); }" title="@Strings.Get("BulkClearSelection")" />
                            </div>
                        }
                        @if (_archiveDocument is not null)
                        {
                            @* Browsing a .zip's entries virtually — read on demand, nothing unpacked (ADR "Zip file browsing"). *@
                            <div class="wb-list-row" @onclick="ExitArchiveAsync" style="cursor:pointer;">
                                <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" />
                                <span style="flex:1 1 auto;">@_archiveDocument.Name@Strings.Get("ArchiveBack")</span>
                            </div>
                            @if (_archiveEntries.Count == 0)
                            {
                                <MudText Typo="Typo.body2" Class="pa-3 mud-text-secondary">@Strings.Get("ArchiveEmpty")</MudText>
                            }
                            @foreach (var entry in _archiveEntries)
                            {
                                <div class="wb-list-row" @onclick="() => DownloadArchiveEntryAsync(entry)" style="cursor:pointer;" title="@Strings.Get("Download")">
                                    <MudIcon Icon="@Icons.Material.Filled.InsertDriveFile" Size="Size.Small" />
                                    <span style="flex:1 1 auto; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@entry.Path</span>
                                    <span class="mud-text-secondary" style="font-size:0.8em;">@FormatSize(entry.Size)</span>
                                </div>
                            }
                        }
                        else if (_selectedFolder is null)
                        {
                            <MudText Typo="Typo.body2" Class="pa-3 mud-text-secondary">@Strings.Get("SelectFolderTree")</MudText>
                        }
                        else if (_folderContents.Count == 0)
                        {
                            <MudText Typo="Typo.body2" Class="pa-3 mud-text-secondary">@Strings.Get("EmptyFolderDrop")</MudText>
                        }
                        else
                        {
                            @* Sortable column header (ADR "List-row columns and sorting"). *@
                            <div class="wb-chead">
                                <span @onclick="() => SortBy(ContentSort.Name)">@Strings.Get("Name") @SortArrow(ContentSort.Name)</span>
                                <span @onclick="() => SortBy(ContentSort.Type)">@Strings.Get("FacetType") @SortArrow(ContentSort.Type)</span>
                                <span @onclick="() => SortBy(ContentSort.Date)">@Strings.Get("SortDocDate") @SortArrow(ContentSort.Date)</span>
                                <span @onclick="() => SortBy(ContentSort.Size)">@Strings.Get("SortSize") @SortArrow(ContentSort.Size)</span>
                                <span @onclick="() => SortBy(ContentSort.Tags)">@Strings.Get("TagsLabel") @SortArrow(ContentSort.Tags)</span>
                                <span></span>
                            </div>
                            @foreach (var node in SortedContents())
                            {
                                var attrs = DropAttributes(node);
                                <div class="wb-list-row wb-cols @(_bulkIds.Contains(node.Id) || ReferenceEquals(node, _commentTarget) ? "wb-list-row-selected" : "")"
                                     @onclick="(e) => OnRowClickAsync(node, e)" @ondblclick="() => OnRowDoubleClickAsync(node)" @attributes="attrs">
                                    <span class="wb-ccell wb-cname" title="@node.DisplayName">
                                        <MudIcon Icon="@NodeIcon(node)" Size="Size.Small" />
                                        <span style="flex:1 1 auto; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@node.DisplayName</span>
                                        @if (node.OnLegalHold)
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Color="Color.Warning" title="@Strings.Get("LhUnderHold")" />
                                        }
                                        @if (node.CheckedOutByMe)
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.LockOpen" Size="Size.Small" Color="Color.Success" title="@Strings.Get("CoLockedMine")" />
                                        }
                                        else if (node.CheckedOutByOther)
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Color="Color.Error" title="@Strings.Get("CoLockedOther")" />
                                        }
                                        @if (!string.IsNullOrEmpty(node.SensitivityLabelName))
                                        {
                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Class="ma-0"
                                                     Style="@($"{ChipStyle(node.SensitivityLabelColor)}height:16px; font-size:.62rem;")" title="@string.Format(Strings.Get("SensitivityTip"), node.SensitivityLabelName)">@node.SensitivityLabelName</MudChip>
                                        }
                                    </span>
                                    <span class="wb-ccell" title="@node.DocumentType">@(node.IsFolder ? Strings.Get("FolderType") : node.DocumentType)</span>
                                    <span class="wb-ccell" title="@(node.DocumentDate?.ToString("yyyy-MM-dd") ?? "")">@(node.DocumentDate?.ToString("yyyy-MM-dd") ?? "")</span>
                                    <span class="wb-ccell" title="@FormatSize(node.SizeBytes)">@FormatSize(node.SizeBytes)</span>
                                    <span class="wb-ccell" title="@string.Join(", ", node.TagList)">@string.Join(", ", node.TagList)</span>
                                    <div @onclick:stopPropagation="true">
                                        <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true" AnchorOrigin="Origin.BottomLeft">
                                            @if (!node.IsReference)
                                            {
                                                <MudMenuItem Icon="@Icons.Material.Filled.Edit" OnClick="() => RenameAsync(node)">@Strings.Get("CtxRename")</MudMenuItem>
                                                <MudMenuItem Icon="@Icons.Material.Filled.DriveFileMove" OnClick="() => MoveAsync(node)">@Strings.Get("CtxMoveTo")</MudMenuItem>
                                            }
                                            @if (!node.IsReference && _canLegalHold)
                                            {
                                                <MudMenuItem Icon="@Icons.Material.Filled.Gavel" OnClick="() => PlaceLegalHoldAsync(node)">@Strings.Get("CtxPlaceLegalHold")</MudMenuItem>
                                            }
                                            @if (!node.IsReference && !node.IsFolder && !node.CheckedOut)
                                            {
                                                <MudMenuItem Icon="@Icons.Material.Filled.Lock" OnClick="() => CheckOutAsync(node)">@Strings.Get("CtxCheckOut")</MudMenuItem>
                                            }
                                            @if (!node.IsReference && node.CheckedOutByOther && _canOverrideCheckout)
                                            {
                                                <MudMenuItem Icon="@Icons.Material.Filled.LockOpen" OnClick="() => OverrideCheckoutAsync(node)">@Strings.Get("CtxOverrideCheckout")</MudMenuItem>
                                            }
                                            <MudMenuItem Icon="@Icons.Material.Filled.Link" OnClick="() => PlaceReferenceAsync(node)">@Strings.Get("CtxPlaceReference")</MudMenuItem>
                                            @if (node.IsReference)
                                            {
                                                <MudMenuItem Icon="@Icons.Material.Filled.ArrowForward" OnClick="() => GoToAsync(node)">@Strings.Get("CtxGoTo")</MudMenuItem>
                                                <MudMenuItem Icon="@Icons.Material.Filled.LinkOff" OnClick="() => RemoveReferenceAsync(node)">@Strings.Get("CtxRemoveReference")</MudMenuItem>
                                            }
                                            @if (node.HasReferences)
                                            {
                                                <MudMenuItem Icon="@Icons.Material.Filled.Share" OnClick="() => ShowReferencesAsync(node)">@Strings.Get("CtxReferences")</MudMenuItem>
                                            }
                                            @if (!node.IsFolder && node.VersionCount > 1)
                                            {
                                                <MudMenuItem Icon="@Icons.Material.Filled.History" OnClick="() => OpenVersionsAsync(node)">@Strings.Get("CtxVersions")</MudMenuItem>
                                            }
                                            @if (!node.IsFolder)
                                            {
                                                <MudMenuItem Icon="@Icons.Material.Filled.AccountTree" OnClick="() => OpenWorkflowAsync(node.Id)">@Strings.Get("CtxStartWorkflow")</MudMenuItem>
                                            }
                                            @if (!node.IsReference)
                                            {
                                                <MudMenuItem Icon="@Icons.Material.Filled.Security" OnClick="() => OpenManageAccessAsync(node.Id, node.Name)">@Strings.Get("MaManageAccess")</MudMenuItem>
                                                <MudMenuItem Icon="@Icons.Material.Filled.Delete" IconColor="Color.Error" OnClick="() => DeleteAsync(node)">@Strings.Get("UgDelete")</MudMenuItem>
                                            }
                                        </MudMenu>
                                    </div>
                                </div>
                            }
                        }
                    </div>

                    <div class="wb-gutter wb-gutter-v" data-gutter="list"><button type="button" class="wb-gutter-toggle"></button></div>

                    <div class="wb-detail @(_isPhone && _selectedItem is not null ? "wb-phone-detail-open" : "") wb-ptab-@_phoneDetailTab">
                        @* Phone-only detail bar: back to the folder list + Preview/Details/Comments sub-tabs
                           (ADR "Responsive phone drill-down"). Rendered ONLY in phone mode so its button text
                           can't collide with the desktop tests' locators. *@
                        @if (_isPhone)
                        {
                            <div class="wb-phone-detbar">
                                <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" aria-label="Back" OnClick="PhoneBack" />
                                <button type="button" class="wb-ptab-btn @(_phoneDetailTab == "preview" ? "wb-ptab-on" : "")" @onclick='() => SetPhoneTab("preview")'>@Strings.Get("PhoneTabPreview")</button>
                                <button type="button" class="wb-ptab-btn @(_phoneDetailTab == "details" ? "wb-ptab-on" : "")" @onclick='() => SetPhoneTab("details")'>@Strings.Get("PhoneTabDetails")</button>
                                <button type="button" class="wb-ptab-btn @(_phoneDetailTab == "comments" ? "wb-ptab-on" : "")" @onclick='() => SetPhoneTab("comments")'>@Strings.Get("PhoneTabComments")</button>
                            </div>
                        }
                        <div class="wb-pane wb-index" data-pane="index">
                            @if (_selectedItem is null && _selectedFolder is { } detailFolder)
                            {
                                @* Folder detail pane (ADR "Per-folder contents sort order") — the open folder's
                                   persisted default contents sort order, editable under an Edit toggle. *@
                                <MudText Typo="Typo.subtitle1" Style="min-width:0; overflow:hidden; text-overflow:ellipsis;">@detailFolder.Name</MudText>
                                <table class="wb-sysfields">
                                    <tr>
                                        <td>@Strings.Get("FolderSortLabel")</td>
                                        <td>
                                            @if (_folderEditing)
                                            {
                                                <MudSelect T="FolderContentsSortOrder" @bind-Value="_folderSortEdit" Margin="Margin.Dense" Variant="Variant.Outlined" Dense="true">
                                                    <MudSelectItem Value="FolderContentsSortOrder.Name">@Strings.Get("FolderSortName")</MudSelectItem>
                                                    <MudSelectItem Value="FolderContentsSortOrder.DocumentDate">@Strings.Get("FolderSortDocDate")</MudSelectItem>
                                                    <MudSelectItem Value="FolderContentsSortOrder.Created">@Strings.Get("FolderSortCreated")</MudSelectItem>
                                                </MudSelect>
                                            }
                                            else
                                            {
                                                @FolderSortText(_folderSortOrder)
                                            }
                                        </td>
                                    </tr>
                                </table>
                                @if (_folderEditing)
                                {
                                    <div style="display:flex; gap:6px; margin-top:8px;">
                                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveFolderSortAsync" Disabled="_folderBusy">@Strings.Get("Save")</MudButton>
                                        <MudButton Size="Size.Small" OnClick="() => _folderEditing = false" Disabled="_folderBusy">@Strings.Get("Cancel")</MudButton>
                                    </div>
                                }
                                else
                                {
                                    <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.Edit" OnClick="BeginFolderEdit">@Strings.Get("Edit")</MudButton>
                                }
                            }
                            else if (_selectedItem is null)
                            {
                                <MudText Typo="Typo.body2" Class="mud-text-secondary">@Strings.Get("SelectDocDetail")</MudText>
                            }
                            else
                            {
                                <div style="display:flex; align-items:center; gap:4px;">
                                    <MudText Typo="Typo.subtitle1" Style="flex:1 1 auto; min-width:0;">@_sysName</MudText>
                                    @* Follow / unfollow this document (ADR "Document subscriptions"). *@
                                    <MudTooltip Text="@(_detailSubscribed ? Strings.Get("UnfollowDoc") : Strings.Get("FollowDoc"))">
                                        <MudIconButton Size="Size.Small" aria-label="Follow"
                                                       Icon="@(_detailSubscribed ? Icons.Material.Filled.Notifications : Icons.Material.Outlined.NotificationsNone)"
                                                       Color="@(_detailSubscribed ? Color.Primary : Color.Default)"
                                                       OnClick="ToggleSubscriptionAsync" />
                                    </MudTooltip>
                                    @* Set a reminder (Wiedervorlage) on this document (ADR "Document reminders"). *@
                                    <MudTooltip Text="@Strings.Get("RemindTooltip")">
                                        <MudIconButton Size="Size.Small" aria-label="Remind" Icon="@Icons.Material.Filled.Alarm" OnClick="OpenReminderDialogAsync" />
                                    </MudTooltip>
                                    @* Manage access (ACL) — only when the caller can manage permissions (ADR "Manage-access UI"). *@
                                    @if (_detailCanManagePermissions)
                                    {
                                        <MudTooltip Text="@Strings.Get("MaManageAccess")">
                                            <MudIconButton Size="Size.Small" aria-label="Manage access" Icon="@Icons.Material.Filled.Security" OnClick="() => OpenManageAccessAsync(_selectedItem!.Id, _sysName)" />
                                        </MudTooltip>
                                    }
                                </div>

                                @* System fields — always shown for a document with a confirmed version (ADR 0273). *@
                                @if (_sysHasVersion)
                                {
                                    <table class="wb-sysfields">
                                        <tr>
                                            <td>@Strings.Get("Name")</td>
                                            <td>
                                                @if (_isEditing)
                                                {
                                                    <MudTextField @bind-Value="_editName" Margin="Margin.Dense" Variant="Variant.Outlined" />
                                                }
                                                else
                                                {
                                                    @_sysName
                                                }
                                            </td>
                                        </tr>
                                        <tr><td>@Strings.Get("SysFileExtension")</td><td class="wb-sys-muted">@_sysFileExtension</td></tr>
                                        <tr>
                                            <td>@Strings.Get("VerColDocDate")</td>
                                            <td>
                                                @if (_isEditing)
                                                {
                                                    <MudDatePicker @bind-Date="_editDocumentDate" DateFormat="yyyy-MM-dd" Margin="Margin.Dense" Variant="Variant.Outlined" />
                                                }
                                                else
                                                {
                                                    @(_sysDocumentDate?.ToString("yyyy-MM-dd"))
                                                }
                                            </td>
                                        </tr>
                                        @if (_sysHasTiff)
                                        {
                                            <tr>
                                                <td>@Strings.Get("SysOcrLanguages")</td>
                                                <td>
                                                    @if (_isEditing)
                                                    {
                                                        <div class="wb-ocr-chips">
                                                            @foreach (var lang in _ocrCatalog)
                                                            {
                                                                var idx = _editOcrCodes.IndexOf(lang.Code);
                                                                <button type="button" class="wb-ocr-chip @(idx >= 0 ? "wb-ocr-chip-on" : "")" @onclick="() => ToggleOcr(lang.Code)">
                                                                    @(idx >= 0 ? $"{idx + 1}. " : "")@lang.DisplayName
                                                                </button>
                                                            }
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        @OcrDisplay(_sysOcrCodes)
                                                    }
                                                </td>
                                            </tr>
                                        }
                                        <tr><td>@Strings.Get("SysCreated")</td><td class="wb-sys-muted">@_sysCreated</td></tr>
                                        <tr><td>@Strings.Get("SysCreatedBy")</td><td class="wb-sys-muted">@_sysCreatedBy</td></tr>
                                        @* The document's current (latest confirmed) version number, directly below Created by
                                           (ADR "Mask-pane current-version line"). *@
                                        @if (_sysCurrentVersion is { } curVer)
                                        {
                                            <tr><td>@Strings.Get("SysCurrentVersion")</td><td class="wb-current-version wb-sys-muted">@curVer</td></tr>
                                        }
                                        @if (_detailRetention is { } ret)
                                        {
                                            <tr>
                                                <td>@Strings.Get("SysRetention")</td>
                                                <td class="wb-sys-muted">
                                                    @ret.RetentionYears years · disposition @ret.DispositionDate@(ret.SuspendedByHold ? " (suspended — legal hold)" : "")
                                                </td>
                                            </tr>
                                        }
                                    </table>
                                }

                                @if (_isEditing)
                                {
                                    @* Mask edit: pick the mask + type-aware field editors. *@
                                    <div class="wb-mask-edit">
                                        <div class="wb-mask-row">
                                            <span class="wb-mask-label">@Strings.Get("MaskLabel")</span>
                                            <MudSelect T="Guid?" Value="_editMaskId" ValueChanged="OnEditMaskChanged" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined">
                                                <MudSelectItem T="Guid?" Value="@((Guid?)null)">@Strings.Get("NoMask")</MudSelectItem>
                                                @foreach (var m in _availableMasks)
                                                {
                                                    <MudSelectItem T="Guid?" Value="@((Guid?)m.Id)">@m.Name</MudSelectItem>
                                                }
                                            </MudSelect>
                                        </div>
                                        @* Sensitivity label (ADR "Configurable sensitivity labels + upload defaults"). *@
                                        <div class="wb-mask-row">
                                            <span class="wb-mask-label">@Strings.Get("BulkSensLabel")</span>
                                            <MudSelect T="Guid?" @bind-Value="_editSensitivityId" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Clearable="true">
                                                <MudSelectItem T="Guid?" Value="@((Guid?)null)">(None)</MudSelectItem>
                                                @foreach (var lbl in _sensitivityLabels.Where(l => !l.Retired || l.Id == _editSensitivityId))
                                                {
                                                    <MudSelectItem T="Guid?" Value="@((Guid?)lbl.Id)">@lbl.Name</MudSelectItem>
                                                }
                                            </MudSelect>
                                        </div>
                                        @foreach (var f in _editFields)
                                        {
                                            <div class="wb-mask-row">
                                                <span class="wb-mask-label">@f.Label</span>
                                                @if (f.IsDate)
                                                {
                                                    <MudDatePicker @bind-Date="f.DateValue" DateFormat="yyyy-MM-dd" Margin="Margin.Dense" Variant="Variant.Outlined" />
                                                }
                                                else if (f.IsBoolean)
                                                {
                                                    <MudCheckBox T="bool" @bind-Value="f.BoolValue" />
                                                }
                                                else if (f.IsMultiSelect)
                                                {
                                                    <MudTextField @bind-Value="f.TextValue" Lines="3" Placeholder="@Strings.Get("OneValuePerLine")" Margin="Margin.Dense" Variant="Variant.Outlined" />
                                                }
                                                else
                                                {
                                                    <MudTextField @bind-Value="f.TextValue" Margin="Margin.Dense" Variant="Variant.Outlined" />
                                                }
                                            </div>
                                        }
                                        @* Free-form tags (ADR "Document tags") — chips + an autocomplete add box over the tenant catalog. *@
                                        <div class="wb-mask-row">
                                            <span class="wb-mask-label">@Strings.Get("TagsLabel")</span>
                                            <div style="display:flex; flex-direction:column; gap:4px; min-width:0;">
                                                @if (_editTags.Count > 0)
                                                {
                                                    <div style="display:flex; flex-wrap:wrap; gap:4px;">
                                                        @foreach (var t in _editTags)
                                                        {
                                                            <MudChip T="string" Size="Size.Small" Style="@ChipStyle(TagColor(t))" OnClose="@(() => _editTags.Remove(t))">@t</MudChip>
                                                        }
                                                    </div>
                                                }
                                                <div style="display:flex; align-items:center; gap:4px;">
                                                    <MudAutocomplete T="string" @bind-Value="_newTag" SearchFunc="SearchTagCatalog" CoerceValue="true"
                                                                     Placeholder="@Strings.Get("TagAddPlaceholder")" Margin="Margin.Dense" Variant="Variant.Outlined" Style="max-width:200px;"
                                                                     OnKeyUp="OnTagKeyUp" Immediate="true" />
                                                    @* Explicit Add — Enter also works, but a click is a deterministic commit path (MudAutocomplete's Enter binding can lag). *@
                                                    <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" aria-label="Add tag" OnClick="AddCurrentTag" />
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2">
                                        Mask: @(_detailMaskName ?? "none")@(_detailVersionNumber is { } vn ? $" · version {vn}" : "")
                                    </MudText>
                                    @if (_detailSensitivityId is not null)
                                    {
                                        <MudChip T="string" Size="Size.Small" Style="@ChipStyle(_detailSensitivityColor)" Variant="Variant.Filled" Class="mt-1" Icon="@Icons.Material.Filled.Shield">@_detailSensitivityName</MudChip>
                                    }
                                    @if (_detailIndexData is { Count: > 0 })
                                    {
                                        <MudSimpleTable Dense="true" Bordered="false" Class="mt-2">
                                            <tbody>
                                                @foreach (var field in _detailIndexData)
                                                {
                                                    <tr><td>@field.FieldName</td><td>@string.Join(", ", field.Values)</td></tr>
                                                }
                                            </tbody>
                                        </MudSimpleTable>
                                    }
                                    @if (_detailTags is { Count: > 0 })
                                    {
                                        <div style="display:flex; flex-wrap:wrap; gap:4px;" class="mt-2">
                                            @foreach (var t in _detailTags)
                                            {
                                                <MudChip T="string" Size="Size.Small" Style="@ChipStyle(TagColor(t))" Icon="@Icons.Material.Filled.Label" OnClick="@(() => SearchByTagAsync(t))">@t</MudChip>
                                            }
                                        </div>
                                    }
                                }

                                <div class="wb-detail-actions">
                                    @if (_isEditing)
                                    {
                                        <MudButton Size="Size.Small" OnClick="CancelEdit" Disabled="_detailBusy">@Strings.Get("Cancel")</MudButton>
                                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveDetailAsync" Disabled="_detailBusy">@Strings.Get("Save")</MudButton>
                                    }
                                    else
                                    {
                                        <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Edit" OnClick="BeginEditAsync" Disabled="_detailBusy">@Strings.Get("Edit")</MudButton>
                                        @if (_detailVersionCount >= 2)
                                        {
                                            <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Difference" OnClick="OpenCompareVersionsAsync">@Strings.Get("CompareVersionsBtn")</MudButton>
                                        }
                                    }
                                </div>
                            }
                        </div>
                        <div class="wb-gutter wb-gutter-h" data-gutter="index"><button type="button" class="wb-gutter-toggle"></button></div>

                        <div class="wb-detail-bottom">
                            <div class="wb-preview @(_pvFullscreen ? "wb-pv-fullscreen" : "")" data-pane="preview">
                                @* Images/PDFs render via pdf.js into a JS-owned host with a search hit-overlay + click-to-copy
                                   (ADRs 0268/0269/0282); text formats show as text; otherwise a placeholder. *@
                                <div style="display:flex; flex-direction:column; flex:1 1 auto; min-width:0;">
                                    @* The toolbar shows for a page preview (find + full-screen) or a text preview (full-screen only). *@
                                    <div class="wb-pv-findbar" style="@((_pv.HasPages || _pv.Kind == "text") ? "" : "display:none;")">
                                        @if (_pv.HasPages)
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.Search" Size="Size.Small" />
                                            <MudTextField T="string" Value="_pv.FindQuery" ValueChanged="ApplyFindAsync" Immediate="true" Placeholder="@Strings.Get("FindInDocument")"
                                                          Margin="Margin.Dense" Variant="Variant.Outlined" Style="max-width:220px;" />
                                            <span class="mud-text-secondary" style="font-size:.8em; min-width:46px;">@_pv.Index / @_pv.Count</span>
                                            <MudIconButton Class="wb-pv-find-prev" Icon="@Icons.Material.Filled.KeyboardArrowUp" Size="Size.Small" Disabled="@(_pv.Count == 0)" OnClick="FindPrevAsync" />
                                            <MudIconButton Class="wb-pv-find-next" Icon="@Icons.Material.Filled.KeyboardArrowDown" Size="Size.Small" Disabled="@(_pv.Count == 0)" OnClick="FindNextAsync" />
                                        }
                                        @if (_pvAnnotatable)
                                        {
                                            @* Sticky notes (ADR "Document annotations"): add a note (only with CanAnnotate,
                                               ADR "CanAnnotate right"), and show/hide the markers (viewing needs only read). *@
                                            @if (_annotationsCanCreate)
                                            {
                                                <MudIconButton Class="wb-pv-note-add" Icon="@Icons.Material.Filled.AddComment" Size="Size.Small" Color="@(_annotationAddMode ? Color.Primary : Color.Default)"
                                                               OnClick="StartAddNoteAsync" title="@Strings.Get("AddStickyNote")" />
                                                @* Markup tools (ADR "Annotation markup"): drag on the page to draw a highlight / rectangle / arrow. *@
                                                <MudIconButton Class="wb-pv-tool-highlight" Icon="@Icons.Material.Filled.BorderColor" Size="Size.Small" Color="@(_annotationTool == 1 ? Color.Primary : Color.Default)"
                                                               OnClick="@(() => SelectShapeToolAsync(1))" title="@Strings.Get("PvHighlight")" />
                                                <MudIconButton Class="wb-pv-tool-rect" Icon="@Icons.Material.Filled.CropSquare" Size="Size.Small" Color="@(_annotationTool == 2 ? Color.Primary : Color.Default)"
                                                               OnClick="@(() => SelectShapeToolAsync(2))" title="@Strings.Get("PvRectangle")" />
                                                <MudIconButton Class="wb-pv-tool-arrow" Icon="@Icons.Material.Filled.NorthEast" Size="Size.Small" Color="@(_annotationTool == 3 ? Color.Primary : Color.Default)"
                                                               OnClick="@(() => SelectShapeToolAsync(3))" title="@Strings.Get("PvArrow")" />
                                                @* Colour palette (ADR "Highlighting redesign"): sets the draw colour for new shapes AND recolours the selected annotations. Shown while drawing or with a selection. *@
                                                @if (_annotationTool > 0 || _hasAnnotationSelection)
                                                {
                                                    <span class="wb-pv-palette">
                                                        @foreach (var c in AnnotationPalette)
                                                        {
                                                            <span class="wb-pv-swatch @(_annotationColor == c ? "wb-pv-swatch-on" : "")" style="@($"background:{c}")"
                                                                  @onclick="@(() => SetAnnotationColorAsync(c))" title="Set colour"></span>
                                                        }
                                                    </span>
                                                }
                                            }
                                            <MudIconButton Class="wb-pv-note-toggle" Icon="@(_annotationsVisible ? Icons.Material.Filled.StickyNote2 : Icons.Material.Outlined.StickyNote2)" Size="Size.Small"
                                                           OnClick="ToggleAnnotationsAsync" title="@(_annotationsVisible ? Strings.Get("PvHideNotes") : Strings.Get("PvShowNotes"))" />
                                            @* Multi-select actions (ADR "Annotation multi-select" web parity): Ctrl-click / marquee to select, then copy / paste / delete. *@
                                            @if (_annotationsCanCreate)
                                            {
                                                <MudIconButton Class="wb-pv-anno-copy" Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" Disabled="@(!_hasAnnotationSelection)"
                                                               OnClick="CopySelectedAnnotations" title="@Strings.Get("CopyAnnotationsTip")" />
                                                <MudIconButton Class="wb-pv-anno-paste" Icon="@Icons.Material.Filled.ContentPaste" Size="Size.Small" Disabled="@(!_hasAnnotationClipboard)"
                                                               OnClick="PasteAnnotationsAsync" title="@Strings.Get("PasteAnnotationsTip")" />
                                                <MudIconButton Class="wb-pv-anno-delete" Icon="@Icons.Material.Filled.DeleteOutline" Size="Size.Small" Disabled="@(!_hasAnnotationSelection)"
                                                               OnClick="DeleteSelectedAnnotationsAsync" title="@Strings.Get("DeleteAnnotationsTip")" />
                                            }
                                        }
                                        <MudIconButton Class="wb-pv-fs-btn" Icon="@(_pvFullscreen ? Icons.Material.Filled.FullscreenExit : Icons.Material.Filled.Fullscreen)" Size="Size.Small" OnClick="TogglePreviewFullscreenAsync" title="@(_pvFullscreen ? Strings.Get("PvExitFullscreen") : Strings.Get("PvFullscreen"))" />
                                    </div>
                                    <div class="wb-pv-host" @ref="_pvHost" style="@(_pv.HasPages ? "" : "display:none;")"></div>
                                    @if (_detailSensitivityWatermark && (_pv.HasPages || _pv.Kind == "text"))
                                    {
                                        @* Sensitivity watermark (ADR "Document watermarking") — Confidential/Restricted only. *@
                                        <div class="wb-watermark" style="@WatermarkStyle()"></div>
                                    }
                                    @if (!_pv.HasPages)
                                    {
                                        @if (_pv.Kind == "text")
                                        {
                                            <div style="flex:1 1 auto; min-height:0; overflow:auto; padding:12px;"><pre style="white-space:pre-wrap; margin:0; font-family:Menlo,Consolas,monospace; font-size:.82em;">@_pv.Text</pre></div>
                                        }
                                        else
                                        {
                                            <div class="wb-preview-empty">
                                                <MudText Typo="Typo.body2">@(_selectedItem is null ? Strings.Get("NoDocSelected") : Strings.Get("NoPreview"))</MudText>
                                            </div>
                                        }
                                    }
                                </div>
                                @if (_pv.Url is not null && _pv.Converted)
                                {
                                    @* Badge on renditions (converted from the original) — not shown for a PDF/image/text
                                       displayed as-is. See ADR "Converted-preview overlay badge". *@
                                    <div class="wb-preview-badge" title="@Strings.Get("ConvertedPreviewTooltip")">
                                        <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Size="Size.Small" />
                                        <span>@Strings.Get("ConvertedPreview")</span>
                                    </div>
                                }
                            </div>
                            <div class="wb-gutter wb-gutter-v" data-gutter="chat"><button type="button" class="wb-gutter-toggle"></button></div>

                            <div class="wb-chat" data-pane="chat">
                                @if (_commentTarget is null)
                                {
                                    <div class="wb-chat-empty">
                                        <MudIcon Icon="@Icons.Material.Filled.Forum" Size="Size.Large" />
                                        <MudText Typo="Typo.body2">@Strings.Get("SelectForComments")</MudText>
                                    </div>
                                }
                                else
                                {
                                    <div class="wb-chat-header" style="display:flex; align-items:center; gap:8px;">
                                        <MudText Typo="Typo.subtitle2" style="flex:1 1 auto;">@Strings.Get("CommentsHeader")</MudText>
                                        @* Follow a folder and its whole subtree (ADR "Folder / subtree subscriptions"). *@
                                        @if (_commentTarget is { IsFolder: true })
                                        {
                                            <MudTooltip Text="@(_folderSubscribed ? Strings.Get("UnfollowFolder") : Strings.Get("FollowFolder"))">
                                                <MudIconButton Size="Size.Small" aria-label="Follow folder"
                                                               Icon="@(_folderSubscribed ? Icons.Material.Filled.Notifications : Icons.Material.Outlined.NotificationsNone)"
                                                               Color="@(_folderSubscribed ? Color.Primary : Color.Default)"
                                                               OnClick="ToggleFolderSubscriptionAsync" />
                                            </MudTooltip>
                                        }
                                    </div>
                                    <div class="wb-chat-thread">
                                        @if (_comments.Count == 0)
                                        {
                                            <MudText Typo="Typo.body2" Class="mud-text-secondary">@Strings.Get("NoCommentsYet")</MudText>
                                        }
                                        @foreach (var c in _comments.Where(x => x.ParentCommentId is null).OrderBy(x => x.CreatedAt))
                                        {
                                            <div class="wb-comment">
                                                <div class="wb-comment-meta">@c.AuthorName · @c.CreatedAt.ToLocalTime().ToString("g")</div>
                                                <div class="wb-comment-body">@c.Body</div>
                                                <span class="wb-reply-link" @onclick="() => ToggleReply(c.Id)">@Strings.Get("ReplyBtn")</span>
                                            </div>
                                            @foreach (var r in _comments.Where(x => x.ParentCommentId == c.Id).OrderBy(x => x.CreatedAt))
                                            {
                                                <div class="wb-comment wb-comment-reply">
                                                    <div class="wb-comment-meta">@r.AuthorName · @r.CreatedAt.ToLocalTime().ToString("g")</div>
                                                    <div class="wb-comment-body">@r.Body</div>
                                                </div>
                                            }
                                            @if (_replyingTo == c.Id)
                                            {
                                                <div class="wb-comment-reply">
                                                    <MudTextField @bind-Value="_replyText" Placeholder="@Strings.Get("ReplyPlaceholder")" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2" />
                                                    <div class="wb-compose-actions">
                                                        <MudButton Size="Size.Small" OnClick="@(() => PostReplyAsync(c.Id))" Disabled="@string.IsNullOrWhiteSpace(_replyText)">@Strings.Get("ReplyBtn")</MudButton>
                                                    </div>
                                                </div>
                                            }
                                        }
                                    </div>
                                    <div class="wb-compose">
                                        <MudTextField @bind-Value="_newComment" Placeholder="@Strings.Get("CommentPlaceholder")" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2" />
                                        <div class="wb-compose-actions">
                                            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="PostCommentAsync" Disabled="@string.IsNullOrWhiteSpace(_newComment)">@Strings.Get("CommentBtn")</MudButton>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
            else if (_activeTab == Tab.Search)
            {
                <div class="wb-search">
                    <div class="wb-search-bar">
                        <MudTextField @bind-Value="_searchQuery" Immediate="true" OnKeyDown="OnSearchKeyDown" Style="flex:1 1 auto;"
                                      Placeholder="@Strings.Get("SearchPlaceholder")" Variant="Variant.Outlined" Margin="Margin.Dense"
                                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
                        <MudSelect T="Guid?" @bind-Value="_searchRepositoryId" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined"
                                   Style="max-width:180px;" Class="ml-2" Placeholder="@Strings.Get("SearchAllRepos")">
                            <MudSelectItem T="Guid?" Value="@((Guid?)null)">@Strings.Get("SearchAllRepos")</MudSelectItem>
                            @foreach (var repo in _searchRepos)
                            {
                                <MudSelectItem T="Guid?" Value="@((Guid?)repo.Id)">@repo.Name</MudSelectItem>
                            }
                        </MudSelect>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="RunSearchAsync" Class="ml-2">@Strings.Get("SearchBtn")</MudButton>
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.BookmarkAdd" OnClick="SaveCurrentSearchAsync"
                                   Disabled="@string.IsNullOrEmpty(_lastSearchQueryString)" Class="ml-2">@Strings.Get("Save")</MudButton>
                        @if (_searching)
                        {
                            <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="ml-2" />
                        }
                    </div>

                    @if (_savedSearches.Count > 0)
                    {
                        @* Saved searches (ADR "Saved searches"/"Scoped saved-search sharing") — click to restore +
                           re-run. Mine: ✕ removes, the share button opens the scope dialog. Others' shared searches
                           are run-only. *@
                        <div class="wb-saved-searches">
                            <span class="wb-filter-label">@Strings.Get("SearchSavedLabel")</span>
                            @foreach (var s in _savedSearches)
                            {
                                <span style="display:inline-flex; align-items:center; gap:2px;">
                                    @if (s.IsMine)
                                    {
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                                 Icon="@ScopeIcon(s.ShareScope)"
                                                 OnClick="@(() => RunSavedSearchAsync(s))" OnClose="@(() => DeleteSavedSearchAsync(s))">@s.Name</MudChip>
                                        <MudTooltip Text="@ScopeTooltip(s.ShareScope)">
                                            <MudIconButton Icon="@Icons.Material.Filled.Share"
                                                           aria-label="@Strings.Get("SearchShareAria")" Size="Size.Small" OnClick="@(() => OpenShareDialogAsync(s))" />
                                        </MudTooltip>
                                    }
                                    else
                                    {
                                        <MudTooltip Text="@string.Format(Strings.Get("SearchSharedBy"), s.OwnerName)">
                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info"
                                                     Icon="@Icons.Material.Filled.Group"
                                                     OnClick="@(() => RunSavedSearchAsync(s))">@s.Name</MudChip>
                                        </MudTooltip>
                                    }
                                </span>
                            }
                        </div>
                    }

                    <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => _filtersExpanded = !_filtersExpanded)"
                               StartIcon="@(_filtersExpanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)">@Strings.Get("SearchFilters")</MudButton>

                    @if (_filtersExpanded)
                    {
                        <div class="wb-search-filters">
                            <div class="wb-filter-row">
                                <span class="wb-filter-label">@Strings.Get("FilterDocDate")</span>
                                <MudDatePicker @bind-Date="_docDateFrom" Placeholder="from" DateFormat="yyyy-MM-dd" Margin="Margin.Dense" Variant="Variant.Outlined" Class="wb-filter-date" />
                                <MudDatePicker @bind-Date="_docDateTo" Placeholder="to" DateFormat="yyyy-MM-dd" Margin="Margin.Dense" Variant="Variant.Outlined" Class="wb-filter-date" />
                            </div>
                            <div class="wb-filter-row">
                                <span class="wb-filter-label">@Strings.Get("FilterCreated")</span>
                                <MudDatePicker @bind-Date="_createdFrom" Placeholder="from" DateFormat="yyyy-MM-dd" Margin="Margin.Dense" Variant="Variant.Outlined" Class="wb-filter-date" />
                                <MudDatePicker @bind-Date="_createdTo" Placeholder="to" DateFormat="yyyy-MM-dd" Margin="Margin.Dense" Variant="Variant.Outlined" Class="wb-filter-date" />
                            </div>
                            <div class="wb-filter-row">
                                <span class="wb-filter-label">@Strings.Get("FilterCreatedBy")</span>
                                <MudTextField @bind-Value="_createdBy" Placeholder="@Strings.Get("FilterNameContains")" Margin="Margin.Dense" Variant="Variant.Outlined" Style="max-width:240px;" />
                            </div>

                            @foreach (var row in _fieldFilters)
                            {
                                <div class="wb-filter-row">
                                    <span class="wb-filter-label">@Strings.Get("FilterIndexField")</span>
                                    <MudSelect T="string" Value="row.FieldName" ValueChanged="@(v => OnFieldFilterFieldChanged(row, v))" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Style="max-width:180px;">
                                        @foreach (var field in _availableFields)
                                        {
                                            <MudSelectItem T="string" Value="@field.Name">@field.Name</MudSelectItem>
                                        }
                                    </MudSelect>
                                    <MudSelect T="string" @bind-Value="row.Operator" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Style="max-width:120px;">
                                        @foreach (var op in OperatorsFor(row.DataType))
                                        {
                                            <MudSelectItem T="string" Value="@op.Value">@op.Label</MudSelectItem>
                                        }
                                    </MudSelect>
                                    @if (row.DataType == 2)
                                    {
                                        <MudDatePicker @bind-Date="row.DateValue" DateFormat="yyyy-MM-dd" Margin="Margin.Dense" Variant="Variant.Outlined" Class="wb-filter-date" />
                                    }
                                    else if (row.DataType == 3)
                                    {
                                        <MudSelect T="string" @bind-Value="row.Value" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Style="max-width:120px;">
                                            <MudSelectItem T="string" Value="@("true")">@Strings.Get("FilterYes")</MudSelectItem>
                                            <MudSelectItem T="string" Value="@("false")">@Strings.Get("FilterNo")</MudSelectItem>
                                        </MudSelect>
                                    }
                                    else
                                    {
                                        <MudTextField @bind-Value="row.Value" Placeholder="@Strings.Get("FilterValue")" Margin="Margin.Dense" Variant="Variant.Outlined" Style="max-width:200px;" />
                                    }
                                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="@(() => _fieldFilters.Remove(row))" />
                                </div>
                            }

                            <div class="wb-filter-row">
                                <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add" OnClick="AddFieldFilter" Disabled="@(_availableFields.Count == 0)">@Strings.Get("AddIndexFilter")</MudButton>
                                <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="ClearFilters">@Strings.Get("ClearFilters")</MudButton>
                            </div>
                        </div>
                    }

                    <div class="wb-search-status">@_searchStatus</div>
                    @if (_searchFacets is { } fc && (fc.DocumentTypes.Count > 0 || fc.CreatedBy.Count > 0 || fc.Years.Count > 0 || fc.Tags.Count > 0 || fc.FileTypes.Count > 0 || fc.SensitivityLabels.Count > 0 || fc.Fields.Count > 0))
                    {
                        <div class="wb-search-facets">
                            @FacetGroup(Strings.Get("FacetType"), fc.DocumentTypes, _facetTypes, v => ToggleFacetAsync(_facetTypes, v))
                            @FacetGroup(Strings.Get("FacetFileType"), fc.FileTypes, _facetFileTypes, v => ToggleFacetAsync(_facetFileTypes, v))
                            @FacetGroup(Strings.Get("FilterCreatedBy"), fc.CreatedBy, _facetCreatedBy, v => ToggleFacetAsync(_facetCreatedBy, v))
                            @FacetGroup(Strings.Get("FacetYear"), fc.Years, _facetYears, v => ToggleFacetAsync(_facetYears, v))
                            @FacetGroup(Strings.Get("TagsLabel"), fc.Tags, _facetTags, v => ToggleFacetAsync(_facetTags, v))
                            @FacetGroup(Strings.Get("BulkSensLabel"), fc.SensitivityLabels, _facetSensitivity, v => ToggleFacetAsync(_facetSensitivity, v))
                            @foreach (var ff in fc.Fields)
                            {
                                @FacetGroup(ff.Name, ff.Buckets, FieldFacetSet(ff.Name), v => ToggleFieldFacetAsync(ff.Name, v))
                            }
                        </div>
                    }
                    <div class="wb-search-results">
                        @foreach (var hit in _searchResults)
                        {
                            <div class="wb-list-row" @onclick="() => OpenSearchResultAsync(hit)">
                                <MudIcon Icon="@(hit.IsFolder ? Icons.Material.Filled.Folder : Icons.Material.Filled.Description)" Size="Size.Small" />
                                <div style="min-width:0;">
                                    <div style="overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@hit.Name</div>
                                    @if (!string.IsNullOrEmpty(hit.Highlight))
                                    {
                                        @* Highlight is HTML-escaped surrounding text with only <em> match tags (ADR "Search result highlighting") — safe to render as markup. *@
                                        <div class="wb-search-snippet">@((MarkupString)hit.Highlight)</div>
                                    }
                                    <div class="wb-search-path">@hit.Path</div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
            else if (_activeTab == Tab.Inbox)
            {
                @* Per-user S3-backed inbox (ADR "S3-backed inbox") — staged files to file into a repository. *@
                <div class="wb-search">
                    <div class="wb-search-bar">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Upload" HtmlTag="label" for="inbox-file-input">@Strings.Get("InboxUpload")</MudButton>
                        <InputFile id="inbox-file-input" OnChange="OnInboxInputChangeAsync" multiple style="display:none" />
                        <MudButton Variant="Variant.Text" OnClick="LoadInboxAsync" Class="ml-2" StartIcon="@Icons.Material.Filled.Refresh">@Strings.Get("RibbonRefresh")</MudButton>
                        <MudButton Variant="Variant.Text" OnClick="CopyWebDavUrlAsync" Class="ml-2" StartIcon="@Icons.Material.Filled.ContentCopy">@Strings.Get("InboxCopyDav")</MudButton>
                        @if (_inboxChecked.Count >= 2)
                        {
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="FileMultipleAsync" Class="ml-2" StartIcon="@Icons.Material.Filled.DriveFileMove">@string.Format(Strings.Get("InboxFileN"), _inboxChecked.Count)</MudButton>
                        }
                        @if (_inboxBusy)
                        {
                            <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="ml-2" />
                        }
                    </div>
                    <div class="wb-search-status">@_inboxStatus</div>
                    <div style="display:flex; flex:1 1 auto; min-height:0;">
                        @* Drop-zone: dropping OS files anywhere on this list uploads them straight into the inbox
                           (ADR "Inbox file-list drop-zone"). *@
                        <div class="wb-search-results wb-inbox-drop" style="flex:1 1 40%; min-width:0;" @ref="_inboxDropZone">
                            <div class="wb-inbox-drophint"><MudIcon Icon="@Icons.Material.Filled.CloudUpload" Size="Size.Small" /> @Strings.Get("InboxDropHint")</div>
                            @foreach (var item in _inboxItems)
                            {
                                <div class="wb-list-row @(item == _selectedInboxItem ? "wb-list-row-selected" : "")" @onclick="() => SelectInboxItemAsync(item)">
                                    <div @onclick:stopPropagation="true">
                                        <MudCheckBox T="bool" Value="_inboxChecked.Contains(item)" ValueChanged="@(v => ToggleInboxCheck(item, v))" Dense="true" Size="Size.Small" />
                                    </div>
                                    <MudIcon Icon="@Icons.Material.Filled.InsertDriveFile" Size="Size.Small" />
                                    <span style="flex:1 1 auto; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@item.DisplayName</span>
                                    <span class="mud-text-secondary" style="font-size:.8em;">@FormatSize(item.Size)</span>
                                    <div @onclick:stopPropagation="true">
                                        <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true" AnchorOrigin="Origin.BottomLeft">
                                            <MudMenuItem Icon="@Icons.Material.Filled.DriveFileMove" OnClick="() => FileInboxItemAsync(item)">@Strings.Get("InboxFileToFolder")</MudMenuItem>
                                            <MudMenuItem Icon="@Icons.Material.Filled.Download" OnClick="() => DownloadInboxItemAsync(item)">@Strings.Get("Download")</MudMenuItem>
                                            <MudMenuItem Icon="@Icons.Material.Filled.Delete" IconColor="Color.Error" OnClick="() => DeleteInboxItemAsync(item)">@Strings.Get("RibbonDelete")</MudMenuItem>
                                        </MudMenu>
                                    </div>
                                </div>
                            }
                        </div>
                        @if (_selectedInboxItem is not null)
                        {
                            <div style="flex:1 1 60%; min-width:0; border-left:1px solid var(--mud-palette-lines-default); display:flex; flex-direction:column;">
                                @* Mask/index-data staging pane (ADRs 0279/0281/0285). *@
                                <div style="flex:0 0 auto; max-height:46%; overflow:auto; padding:10px 14px; border-bottom:1px solid var(--mud-palette-lines-default);">
                                    <MudText Typo="Typo.subtitle2">@_selectedInboxItem.Name</MudText>
                                    @if (_inboxIsEmail)
                                    {
                                        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-2">
                                            <MudIcon Icon="@Icons.Material.Filled.MarkEmailRead" Size="Size.Small" /> @Strings.Get("InboxEmailAutoMask")
                                        </MudText>
                                    }
                                    else
                                    {
                                        <table class="wb-sysfields">
                                            <tr><td>@Strings.Get("Name")</td><td><MudTextField @bind-Value="_inboxStgName" Margin="Margin.Dense" Variant="Variant.Outlined" /></td></tr>
                                            <tr><td>@Strings.Get("VerColDocDate")</td><td><MudDatePicker @bind-Date="_inboxStgDate" DateFormat="yyyy-MM-dd" Margin="Margin.Dense" Variant="Variant.Outlined" /></td></tr>
                                            @if (_inboxStgScannable)
                                            {
                                                @* OCR languages for a scannable item — staged + applied to the searchable-PDF conversion at filing (ADR "Inbox OCR-language staging"). *@
                                                <tr>
                                                    <td>@Strings.Get("SysOcrLanguages")</td>
                                                    <td>
                                                        <div class="wb-ocr-chips">
                                                            @foreach (var lang in _ocrCatalog)
                                                            {
                                                                var idx = _inboxStgOcrCodes.IndexOf(lang.Code);
                                                                <button type="button" class="wb-ocr-chip @(idx >= 0 ? "wb-ocr-chip-on" : "")" @onclick="() => ToggleInboxOcr(lang.Code)">@(idx >= 0 ? $"{idx + 1}. " : "")@lang.DisplayName</button>
                                                            }
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </table>
                                        <div class="wb-mask-edit">
                                            <div class="wb-mask-row">
                                                <span class="wb-mask-label">@Strings.Get("MaskLabel")</span>
                                                <MudSelect T="Guid?" Value="_inboxStgMaskId" ValueChanged="OnInboxStgMaskChanged" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined">
                                                    <MudSelectItem T="Guid?" Value="@((Guid?)null)">@Strings.Get("NoMask")</MudSelectItem>
                                                    @foreach (var m in _inboxStgMasks)
                                                    {
                                                        <MudSelectItem T="Guid?" Value="@((Guid?)m.Id)">@m.Name</MudSelectItem>
                                                    }
                                                </MudSelect>
                                            </div>
                                            @foreach (var f in _inboxStgFields)
                                            {
                                                <div class="wb-mask-row">
                                                    <span class="wb-mask-label">@f.Label</span>
                                                    @if (f.IsDate)
                                                    {
                                                        <MudDatePicker @bind-Date="f.DateValue" DateFormat="yyyy-MM-dd" Margin="Margin.Dense" Variant="Variant.Outlined" />
                                                    }
                                                    else if (f.IsBoolean)
                                                    {
                                                        <MudCheckBox T="bool" @bind-Value="f.BoolValue" />
                                                    }
                                                    else if (f.IsMultiSelect)
                                                    {
                                                        <MudTextField @bind-Value="f.TextValue" Lines="3" Placeholder="@Strings.Get("OneValuePerLine")" Margin="Margin.Dense" Variant="Variant.Outlined" />
                                                    }
                                                    else
                                                    {
                                                        <MudTextField @bind-Value="f.TextValue" Margin="Margin.Dense" Variant="Variant.Outlined" />
                                                    }
                                                </div>
                                            }
                                        </div>
                                        <div class="wb-detail-actions">
                                            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveInboxMaskAsync" Disabled="_inboxStgBusy">@Strings.Get("Save")</MudButton>
                                        </div>
                                    }
                                </div>
                                @* Preview with the same pdf.js hit-overlay / find / click-to-copy as the Repositories
                                   pane (ADRs 0268/0269/0282), reusing the shared _pvHost + _pv* state (the two tabs
                                   are mutually exclusive in the DOM). *@
                                <div class="wb-preview @(_pvFullscreen ? "wb-pv-fullscreen" : "")" style="flex:1 1 auto; min-height:0; position:relative; display:flex; flex-direction:column;">
                                    <div style="display:flex; flex-direction:column; flex:1 1 auto; min-width:0;">
                                        @* The toolbar shows for a page preview (find + full-screen) or a text preview (full-screen only). *@
                                        <div class="wb-pv-findbar" style="@((_pv.HasPages || _pv.Kind == "text") ? "" : "display:none;")">
                                            @if (_pv.HasPages)
                                            {
                                                <MudIcon Icon="@Icons.Material.Filled.Search" Size="Size.Small" />
                                                <MudTextField T="string" Value="_pv.FindQuery" ValueChanged="ApplyFindAsync" Immediate="true" Placeholder="@Strings.Get("FindInDocument")"
                                                              Margin="Margin.Dense" Variant="Variant.Outlined" Style="max-width:220px;" />
                                                <span class="mud-text-secondary" style="font-size:.8em; min-width:46px;">@_pv.Index / @_pv.Count</span>
                                                <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowUp" Size="Size.Small" Disabled="@(_pv.Count == 0)" OnClick="FindPrevAsync" />
                                                <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowDown" Size="Size.Small" Disabled="@(_pv.Count == 0)" OnClick="FindNextAsync" />
                                            }
                                            <MudIconButton Class="wb-pv-fs-btn" Icon="@(_pvFullscreen ? Icons.Material.Filled.FullscreenExit : Icons.Material.Filled.Fullscreen)" Size="Size.Small" OnClick="TogglePreviewFullscreenAsync" title="@(_pvFullscreen ? Strings.Get("PvExitFullscreen") : Strings.Get("PvFullscreen"))" />
                                        </div>
                                        <div class="wb-pv-host" @ref="_pvHost" style="@(_pv.HasPages ? "" : "display:none;")"></div>
                                        @if (!_pv.HasPages)
                                        {
                                            @if (_pv.Kind == "text")
                                            {
                                                <div style="flex:1 1 auto; min-height:0; overflow:auto; padding:12px;"><pre style="white-space:pre-wrap; margin:0; font-family:Menlo,Consolas,monospace; font-size:.82em;">@_pv.Text</pre></div>
                                            }
                                            else
                                            {
                                                <div class="wb-preview-empty">
                                                    <MudText Typo="Typo.body2">@(_selectedInboxItem is null ? Strings.Get("NoItemSelected") : Strings.Get("NoPreview"))</MudText>
                                                </div>
                                            }
                                        }
                                    </div>
                                    @if (_pv.Converted && _pv.HasPages)
                                    {
                                        <div class="wb-preview-badge" title="This is a generated preview, not the original file.">
                                            <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Size="Size.Small" />
                                            <span>@Strings.Get("ConvertedPreview")</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
            else if (_activeTab == Tab.Checkout)
            {
                @* The caller's checked-out documents + their cloud working copy (ADR "Check-out working-copy stash").
                   The browser has no local folder, so the flow is manual: Download from stash (edit externally),
                   Upload to stash (put the edited file back), then Check in (promote the stash to a new version). *@
                <div class="wb-checkout pa-4" style="overflow:auto;">
                    <div style="display:flex; align-items:center; gap:8px; margin-bottom:8px;">
                        <MudText Typo="Typo.h6">@Strings.Get("CoHeader")</MudText>
                        <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" OnClick="LoadCheckoutsAsync" title="@Strings.Get("RibbonRefresh")" />
                        @* Copy the SimplArchive WebDAV mount URL — parity with the Inbox tab (ADR 0509); the Check-out folder lives under the mounted resource. *@
                        <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="CopyWebDavUrlAsync" StartIcon="@Icons.Material.Filled.ContentCopy">@Strings.Get("InboxCopyDav")</MudButton>
                    </div>
                    @if (_checkouts.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">@Strings.Get("CoEmpty")</MudText>
                    }
                    else
                    {
                        <MudSimpleTable Dense="true" Hover="true" Bordered="false">
                            <thead><tr><th>@Strings.Get("ColDocument")</th><th>@Strings.Get("CoColRepoPath")</th><th>@Strings.Get("CoColWorkingCopy")</th><th>@Strings.Get("CoColAutoRelease")</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var c in _checkouts)
                                {
                                    <tr>
                                        <td>@c.Name@c.FileExtension</td>
                                        <td class="mud-text-secondary">@c.Path</td>
                                        <td>@(c.IsModified ? Strings.Get("CoModified") : "—")</td>
                                        <td>
                                            @if (c.ExpiresAt is { } exp)
                                            {
                                                <MudText Typo="Typo.body2" Color="@((exp - DateTimeOffset.UtcNow).TotalDays <= 1 ? Color.Warning : Color.Default)">
                                                    @exp.ToLocalTime().ToString("g")@((exp - DateTimeOffset.UtcNow).TotalDays <= 1 ? Strings.Get("CoSoon") : "")
                                                </MudText>
                                            }
                                            else
                                            {
                                                <span class="mud-text-secondary">@Strings.Get("CoNever")</span>
                                            }
                                        </td>
                                        <td style="text-align:right; white-space:nowrap;">
                                            <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.CloudDownload" OnClick="() => DownloadFromStashAsync(c)">@Strings.Get("CoDownloadStash")</MudButton>
                                            <MudFileUpload T="IBrowserFile" FilesChanged="@(f => UploadToStashAsync(c, f))" Class="d-inline" Style="display:inline-block; margin:0;">
                                                <CustomContent Context="upload">
                                                    <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.CloudUpload" OnClick="@(() => upload.OpenFilePickerAsync())">@Strings.Get("CoUploadStash")</MudButton>
                                                </CustomContent>
                                            </MudFileUpload>
                                            @if (c.ExpiresAt is not null)
                                            {
                                                <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.MoreTime" OnClick="() => ExtendCheckoutAsync(c)">@Strings.Get("CoExtend")</MudButton>
                                            }
                                            @if (c.IsModified)
                                            {
                                                <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.Difference" OnClick="() => OpenCompareCheckoutAsync(c)">@Strings.Get("CoCompare")</MudButton>
                                            }
                                            <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.Check" Disabled="@(!c.IsModified)" OnClick="() => CheckInFromStashAsync(c)">@Strings.Get("CoCheckIn")</MudButton>
                                            <MudButton Size="Size.Small" Color="Color.Error" StartIcon="@Icons.Material.Filled.LockOpen" OnClick="() => CancelCheckoutAsync(c)">@Strings.Get("CoCancel")</MudButton>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    }
                </div>
            }
            else if (_activeTab == Tab.Tenant)
            {
                @* Tenant-admin self-service settings (ADR "Tenant-admin settings tab"): read-only until Edit,
                   then Save/Cancel. Plus a New repository button. Gated on isTenantAdmin. *@
                <div class="wb-tenant pa-4" style="overflow:auto; max-width:720px;">
                    <div style="display:flex; align-items:center; gap:8px; margin-bottom:14px;">
                        <MudText Typo="Typo.h6">@Strings.Get("TenantHeader")</MudText>
                        @if (!_tenantEditing)
                        {
                            <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.Edit" OnClick="BeginTenantEdit" Disabled="@(_tenant is null)">@Strings.Get("Edit")</MudButton>
                        }
                        else
                        {
                            <MudButton Size="Size.Small" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveTenantSettingsAsync">@Strings.Get("Save")</MudButton>
                            <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.Close" OnClick="CancelTenantEdit">@Strings.Get("Cancel")</MudButton>
                        }
                        <MudSpacer />
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Shield" OnClick="OpenSensitivityLabelsAsync">@Strings.Get("TenantSensitivityLabels")</MudButton>
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.CreateNewFolder" OnClick="NewRepositoryAsync">@Strings.Get("TenantNewRepository")</MudButton>
                    </div>
                    @if (_tenant is not null)
                    {
                        <div class="wb-setting-row mb-3">
                            <MudTextField T="string" Label="@Strings.Get("TenantNameLabel")" @bind-Value="_tenantEdit.Name" Disabled="@(!_tenantEditing)" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" />
                            @InfoButton(Strings.Get("TenantNameInfo"))
                        </div>

                        <div class="wb-setting-row mb-3">
                            <MudSelect T="string" Label="@Strings.Get("TenantOcrLabel")" MultiSelection="true" @bind-SelectedValues="_tenantEditOcr"
                                       Disabled="@(!_tenantEditing)" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1"
                                       MultiSelectionTextFunc="@(v => string.Join(", ", v))">
                                @foreach (var lang in _ocrCatalog)
                                {
                                    <MudSelectItem T="string" Value="@lang.Code">@lang.DisplayName (@lang.Code)</MudSelectItem>
                                }
                            </MudSelect>
                            @InfoButton(Strings.Get("TenantOcrInfo"))
                        </div>

                        <div class="wb-setting-row mb-3">
                            <MudNumericField T="int" Label="@Strings.Get("TenantAuditRetLabel")" @bind-Value="_tenantEdit.AuditRetentionDays"
                                             Disabled="@(!_tenantEditing)" Min="0" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" />
                            @InfoButton(Strings.Get("TenantAuditRetInfo"))
                        </div>

                        <div class="wb-setting-row mb-3">
                            <MudNumericField T="int" Label="@Strings.Get("TenantCoTtlLabel")" @bind-Value="_tenantEdit.CheckoutTtlDays"
                                             Disabled="@(!_tenantEditing)" Min="0" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" />
                            @InfoButton(Strings.Get("TenantCoTtlInfo"))
                        </div>

                        <div class="wb-setting-row mb-3">
                            <MudNumericField T="int" Label="@Strings.Get("TenantCoWarnLabel")" @bind-Value="_tenantEdit.CheckoutWarningDays"
                                             Disabled="@(!_tenantEditing)" Min="0" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" />
                            @InfoButton(Strings.Get("TenantCoWarnInfo"))
                        </div>

                        <div class="wb-setting-row mb-4">
                            <MudSelect T="int" Label="@Strings.Get("TenantWormLabel")" @bind-Value="_tenantEdit.WormLockMode"
                                       Disabled="@(!_tenantEditing)" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1">
                                <MudSelectItem T="int" Value="0">@Strings.Get("TenantWormGovernance")</MudSelectItem>
                                <MudSelectItem T="int" Value="1">@Strings.Get("TenantWormCompliance")</MudSelectItem>
                            </MudSelect>
                            @InfoButton(Strings.Get("TenantWormInfo"))
                        </div>

                        <div class="wb-setting-row mb-1">
                            <MudNumericField T="int?" Label="@Strings.Get("TenantQuotaLabel")" @bind-Value="_tenantEdit.StorageQuotaMb"
                                             Disabled="@(!_tenantEditing)" Min="0" Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" />
                            @InfoButton(Strings.Get("TenantQuotaInfo"))
                        </div>
                        <div class="wb-setting-row mb-4" style="align-items:center; gap:8px;">
                            <MudText Typo="Typo.body2" Class="mud-text-secondary flex-grow-1">
                                @string.Format(Strings.Get("TenantUsed"), FormatBytes(_tenant.StorageUsedBytes))@(_tenant.StorageQuotaBytes is { } q ? string.Format(Strings.Get("TenantUsedOf"), FormatBytes(q), StoragePercent()) : Strings.Get("TenantNoLimit"))
                                @if (StorageLevel() == 1)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Class="ml-2">@Strings.Get("TenantApproachingQuota")</MudChip>
                                }
                                else if (StorageLevel() == 2)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Error" Class="ml-2">@Strings.Get("TenantAlmostFull")</MudChip>
                                }
                            </MudText>
                            <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Refresh" OnClick="RecomputeStorageAsync">@Strings.Get("TenantRecompute")</MudButton>
                            @InfoButton(Strings.Get("TenantRecomputeInfo"))
                        </div>

                        <div class="wb-setting-row mb-4">
                            <MudNumericField T="int" Label="@Strings.Get("TenantUploadCleanupLabel")" @bind-Value="_tenantEdit.IncompleteUploadCleanupDays"
                                             Disabled="@(!_tenantEditing)" Min="0" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" />
                            @InfoButton(Strings.Get("TenantUploadCleanupInfo"))
                        </div>

                        <div class="wb-setting-row mb-4">
                            <MudSwitch T="bool" @bind-Value="_tenantEdit.RequireMfa" Disabled="@(!_tenantEditing)" Color="Color.Primary" Class="flex-grow-1"
                                       Label="@Strings.Get("TenantRequireMfa")" />
                            @InfoButton(Strings.Get("TenantRequireMfaInfo"))
                        </div>

                        <div class="wb-setting-row mb-4">
                            <MudSwitch T="bool" @bind-Value="_tenantEdit.AllowPasskeyLogin" Disabled="@(!_tenantEditing)" Color="Color.Primary" Class="flex-grow-1"
                                       Label="@Strings.Get("TenantAllowPasskey")" />
                            @InfoButton(Strings.Get("TenantAllowPasskeyInfo"))
                        </div>

                        <div class="wb-setting-row mb-4">
                            <MudSwitch T="bool" @bind-Value="_tenantEdit.RequireDispositionReview" Disabled="@(!_tenantEditing)" Color="Color.Primary" Class="flex-grow-1"
                                       Label="@Strings.Get("TenantRequireDisposition")" />
                            @InfoButton(Strings.Get("TenantRequireDispositionInfo"))
                        </div>

                        <div class="wb-setting-row mb-4">
                            <MudSwitch T="bool" @bind-Value="_tenantEdit.RestrictTagsToCatalog" Disabled="@(!_tenantEditing)" Color="Color.Primary" Class="flex-grow-1"
                                       Label="@Strings.Get("TenantRestrictTags")" />
                            @InfoButton(Strings.Get("TenantRestrictTagsInfo"))
                        </div>

                        <div class="wb-setting-row mb-4">
                            <MudSwitch T="bool" @bind-Value="_tenantEdit.EnforceClearance" Disabled="@(!_tenantEditing)" Color="Color.Primary" Class="flex-grow-1"
                                       Label="@Strings.Get("TenantEnforceClearance")" />
                            @InfoButton(Strings.Get("TenantEnforceClearanceInfo"))
                        </div>

                        <div class="wb-setting-row mb-2">
                            <MudTextField T="string" Label="@Strings.Get("TenantWebhookUrlLabel")" @bind-Value="_tenantEdit.AuditWebhookUrl"
                                          Disabled="@(!_tenantEditing)" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1"
                                          Placeholder="https://siem.example.com/ingest" />
                            @InfoButton(Strings.Get("TenantWebhookUrlInfo"))
                        </div>
                        @if (_tenantEditing)
                        {
                            <div class="wb-setting-row mb-2">
                                <MudTextField T="string" Label="@(_tenant.AuditWebhookConfigured ? Strings.Get("TenantSecretLabelKeep") : Strings.Get("TenantSecretLabel"))"
                                              @bind-Value="_tenantEdit.AuditWebhookSecret" InputType="InputType.Password"
                                              Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" />
                                @InfoButton(Strings.Get("TenantSecretInfo"))
                            </div>
                        }
                        else
                        {
                            <div class="wb-setting-row mb-1" style="align-items:center; gap:8px;">
                                <MudText Typo="Typo.body2" Class="mud-text-secondary flex-grow-1">
                                    @(_tenant.AuditWebhookConfigured ? Strings.Get("TenantSecretConfigured") : Strings.Get("TenantSecretNotSet"))
                                </MudText>
                                @if (_tenant.AuditWebhookUrl is not null && _tenant.AuditWebhookConfigured)
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Send" OnClick="TestWebhookAsync">@Strings.Get("TenantSendTest")</MudButton>
                                }
                            </div>
                            @if (_tenant.AuditWebhookUrl is not null)
                            {
                                <div class="wb-setting-row mb-4">
                                    @if (_tenant.AuditWebhookConsecutiveFailures == 0)
                                    {
                                        <MudText Typo="Typo.body2" Color="Color.Success" Class="flex-grow-1">
                                            @Strings.Get("TenantDeliveryHealthy")@(_tenant.AuditWebhookLastSuccessAt is { } s ? string.Format(Strings.Get("TenantLastSuccess"), s.ToLocalTime().ToString("g")) : "")
                                        </MudText>
                                    }
                                    else
                                    {
                                        <MudText Typo="Typo.body2" Color="Color.Warning" Class="flex-grow-1">
                                            @Strings.Get("TenantDeliveryFailing") @string.Format(_tenant.AuditWebhookConsecutiveFailures == 1 ? Strings.Get("TenantConsecFailure") : Strings.Get("TenantConsecFailures"), _tenant.AuditWebhookConsecutiveFailures)@(_tenant.AuditWebhookLastError is { } e ? $" ({e})" : "")@(_tenant.AuditWebhookNextAttemptAt is { } n ? string.Format(Strings.Get("TenantNextRetry"), n.ToLocalTime().ToString("g")) : "")@(_tenant.AuditWebhookLastSuccessAt is { } s2 ? string.Format(Strings.Get("TenantLastSuccessSemi"), s2.ToLocalTime().ToString("g")) : Strings.Get("TenantNeverDelivered"))
                                        </MudText>
                                    }
                                    @InfoButton(Strings.Get("TenantDeliveryInfo"))
                                </div>
                            }
                        }

                        <MudDivider Class="mb-3" />
                        <MudText Typo="Typo.subtitle2" Class="mb-1 mud-text-secondary">@Strings.Get("TenantReference")</MudText>
                        <MudSimpleTable Dense="true" Bordered="false" Elevation="0">
                            <tbody>
                                <tr><td class="mud-text-secondary" style="width:140px;">@Strings.Get("TenantIdLabel")</td><td>@_tenant.Id</td></tr>
                                <tr><td class="mud-text-secondary">@Strings.Get("TenantStatusLabel")</td><td>@_tenant.Status</td></tr>
                                <tr><td class="mud-text-secondary">@Strings.Get("TenantCreatedLabel")</td><td>@_tenant.CreatedAt.LocalDateTime.ToString("yyyy-MM-dd HH:mm")</td></tr>
                            </tbody>
                        </MudSimpleTable>
                    }
                </div>
            }
            else if (_activeTab == Tab.Tags)
            {
                @* The tenant tag catalog (ADR "Tag controlled vocabulary") — admin curation. *@
                <div class="wb-tags pa-4" style="overflow:auto; max-width:720px;">
                    <MudText Typo="Typo.h6" Class="mb-2">@Strings.Get("TagsCatalogHeader")</MudText>
                    <MudText Typo="Typo.body2" Class="mb-4 mud-text-secondary">@Strings.Get("TagsCatalogDesc")</MudText>

                    <div style="display:flex; gap:8px; align-items:center; margin-bottom:16px;">
                        <MudTextField T="string" @bind-Value="_newTagName" Placeholder="@Strings.Get("TagsNewPlaceholder")" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:220px;" />
                        <MudTextField T="string" @bind-Value="_newTagColor" Placeholder="#RRGGBB" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:120px;" />
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="CreateTagAsync">@Strings.Get("TagsAdd")</MudButton>
                    </div>

                    <MudSimpleTable Dense="true" Hover="true" Style="max-width:680px;">
                        <thead><tr><th>@Strings.Get("TagsColTag")</th><th style="width:200px;">@Strings.Get("TagsColActions")</th></tr></thead>
                        <tbody>
                            @foreach (var t in _catalogTags)
                            {
                                <tr>
                                    <td><MudChip T="string" Size="Size.Small" Style="@ChipStyle(t.Color)">@t.Name</MudChip></td>
                                    <td>
                                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" title="@Strings.Get("RibbonRename")" OnClick="@(() => RenameTagAsync(t))" />
                                        <MudIconButton Icon="@Icons.Material.Filled.Palette" Size="Size.Small" title="@Strings.Get("TagsSetColour")" OnClick="@(() => RecolourTagAsync(t))" />
                                        <MudMenu Icon="@Icons.Material.Filled.CallMerge" Size="Size.Small" Dense="true" title="@Strings.Get("TagsMergeInto")">
                                            @foreach (var other in _catalogTags.Where(x => x.Id != t.Id))
                                            {
                                                <MudMenuItem OnClick="@(() => MergeTagAsync(t, other))">@other.Name</MudMenuItem>
                                            }
                                        </MudMenu>
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" title="@Strings.Get("TagsRetire")" OnClick="@(() => RetireTagAsync(t))" />
                                    </td>
                                </tr>
                            }
                            @if (_catalogTags.Count == 0)
                            {
                                <tr><td colspan="2" class="mud-text-secondary">@Strings.Get("TagsEmpty")</td></tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                </div>
            }
            else if (_activeTab == Tab.Tasks)
            {
                @* Pending workflow review tasks assigned to me (ADR "Workflow / document state model"). *@
                <div class="wb-tasks pa-4" style="overflow:auto;">
                    <div style="display:flex; align-items:center; gap:8px; margin-bottom:8px;">
                        <MudText Typo="Typo.h6">@Strings.Get("TasksHeader")</MudText>
                        <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" OnClick="LoadTasksAsync" title="Refresh" />
                    </div>
                    @if (_tasks.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">@Strings.Get("TasksEmpty")</MudText>
                    }
                    else
                    {
                        <MudSimpleTable Dense="true" Hover="true" Bordered="false" Style="max-width:860px;">
                            <thead><tr><th>@Strings.Get("ColDocument")</th><th>@Strings.Get("VerColVersion")</th><th>@Strings.Get("ColAssigned")</th><th>@Strings.Get("ColDue")</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var t in _tasks)
                                {
                                    <tr>
                                        <td>@t.DocumentName</td>
                                        <td>@(t.VersionNumber is { } n ? $"v{n}" : "—")</td>
                                        <td>@t.AssignedAt.LocalDateTime.ToString("yyyy-MM-dd HH:mm")</td>
                                        <td>
                                            @if (t.DueAt is { } due)
                                            {
                                                @if (t.IsOverdue)
                                                {
                                                    <MudChip T="string" Size="Size.Small" Color="Color.Error" Icon="@Icons.Material.Filled.Warning">@string.Format(Strings.Get("WorkflowOverdue"), due.LocalDateTime.ToString("yyyy-MM-dd"))</MudChip>
                                                }
                                                else
                                                {
                                                    <span>@due.LocalDateTime.ToString("yyyy-MM-dd")</span>
                                                }
                                            }
                                            else
                                            {
                                                <span class="mud-text-secondary">—</span>
                                            }
                                        </td>
                                        <td><MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="() => OpenTaskAsync(t)">@Strings.Get("RibbonOpen")</MudButton></td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    }
                </div>
            }
            else if (_activeTab == Tab.MyWork)
            {
                @* Personal dashboard (ADR "My work dashboard"): overdue + due-soon reminders, followed
                   documents, and review tasks — three stacked sections, each item navigating to its document. *@
                <div class="wb-mywork pa-4" style="overflow:auto;">
                    <div style="display:flex; align-items:center; gap:8px; margin-bottom:8px;">
                        <MudText Typo="Typo.h6">@Strings.Get("MyWorkHeader")</MudText>
                        <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" OnClick="LoadMyWorkAsync" title="Refresh" />
                    </div>

                    <MudText Typo="Typo.subtitle2" Class="mt-2">@Strings.Get("MyWorkReminders")</MudText>
                    @if (_dashReminders.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">@Strings.Get("MyWorkNothingDue")</MudText>
                    }
                    else
                    {
                        <MudList T="string" Dense="true" Style="max-width:700px;">
                            @foreach (var r in _dashReminders)
                            {
                                <MudListItem T="string" OnClick="() => NavigateToDocumentAsync(r.DocumentId, r.ParentId)" Icon="@(r.Overdue ? Icons.Material.Filled.Warning : Icons.Material.Filled.Alarm)" IconColor="@(r.Overdue ? Color.Error : Color.Default)">
                                    <b>@r.DocumentName</b> — @(r.Overdue ? Strings.Get("MyWorkWasDue") : Strings.Get("MyWorkDue"))@r.RemindAt.LocalDateTime.ToString("g")@(r.Recurrence != 0 ? $" · {r.RecurrenceName.ToLowerInvariant()}" : "")@(string.IsNullOrEmpty(r.Note) ? "" : $" — {r.Note}")
                                </MudListItem>
                            }
                        </MudList>
                    }

                    <MudText Typo="Typo.subtitle2" Class="mt-4">@Strings.Get("MyWorkFollowing")</MudText>
                    @if (_dashFollowing.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">@Strings.Get("MyWorkNotFollowing")</MudText>
                    }
                    else
                    {
                        <MudList T="string" Dense="true" Style="max-width:700px;">
                            @foreach (var f in _dashFollowing)
                            {
                                <MudListItem T="string" OnClick="() => NavigateToDocumentAsync(f.DocumentId, f.ParentId)" Icon="@Icons.Material.Filled.Notifications">@f.DocumentName</MudListItem>
                            }
                        </MudList>
                    }

                    <MudText Typo="Typo.subtitle2" Class="mt-4">@Strings.Get("MyWorkReviewTasks")</MudText>
                    @if (_tasks.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">@Strings.Get("MyWorkNoReview")</MudText>
                    }
                    else
                    {
                        <MudList T="string" Dense="true" Style="max-width:700px;">
                            @foreach (var t in _tasks)
                            {
                                <MudListItem T="string" OnClick="() => OpenTaskAsync(t)" Icon="@Icons.Material.Filled.Task">
                                    <b>@t.DocumentName</b>@(t.VersionNumber is { } n ? $" v{n}" : "")@(t.IsOverdue ? Strings.Get("MyWorkOverdueSuffix") : "")
                                </MudListItem>
                            }
                        </MudList>
                    }
                </div>
            }
            else if (_activeTab == Tab.UsersGroups)
            {
                @* Users & groups administration (ADR "Users & groups administration tab"): a combined
                   principal list on the left, the assignable system-rights matrix on the right. *@
                <div class="wb-ug">
                    <div class="wb-ug-list">
                        <div class="wb-ug-toolbar">
                            <MudMenu Icon="@Icons.Material.Filled.Add" Size="Size.Small" Dense="true" title="@Strings.Get("UgNew")">
                                <MudMenuItem Icon="@Icons.Material.Filled.Person" OnClick="() => NewPrincipalAsync(false)">@Strings.Get("UgNewUser")</MudMenuItem>
                                <MudMenuItem Icon="@Icons.Material.Filled.Group" OnClick="() => NewPrincipalAsync(true)">@Strings.Get("UgNewGroup")</MudMenuItem>
                            </MudMenu>
                            <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" Disabled="@(_selectedPrincipal is null)" OnClick="CopyPrincipalAsync" title="@Strings.Get("UgCopy")" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" Disabled="@(_selectedPrincipal is null)" OnClick="DeletePrincipalAsync" title="@Strings.Get("UgDelete")" />
                            <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" OnClick="LoadPrincipalsAsync" title="@Strings.Get("RibbonRefresh")" />
                        </div>
                        <div class="wb-ug-rows">
                            @foreach (var p in _principals)
                            {
                                <div class="wb-list-row @(ReferenceEquals(p, _selectedPrincipal) ? "wb-list-row-selected" : "")" @onclick="() => SelectPrincipalAsync(p)">
                                    <MudIcon Icon="@(p.IsGroup ? Icons.Material.Filled.Group : Icons.Material.Filled.Person)" Size="Size.Small" />
                                    <span style="flex:1 1 auto; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@p.Name</span>
                                    @if (!p.IsGroup && !p.IsActive)
                                    {
                                        <span class="mud-text-secondary" style="font-size:.75em;">@Strings.Get("UgInactive")</span>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                    <div class="wb-ug-rights">
                        @if (_selectedPrincipal is { } sel)
                        {
                            <div class="wb-ug-rights-head">
                                <MudIcon Icon="@(sel.IsGroup ? Icons.Material.Filled.Group : Icons.Material.Filled.Person)" Size="Size.Small" />
                                <MudText Typo="Typo.subtitle1">@sel.Name</MudText>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">@string.Format(Strings.Get("UgRights"), sel.IsGroup ? Strings.Get("UgGroup") : Strings.Get("UgUser"))</MudText>
                            </div>
                            @* Profile photo (users only — groups have none). ADR "User profile photo". *@
                            @if (!sel.IsGroup)
                            {
                                <div class="wb-ug-photo">
                                    @if (_principalPhotoUrl is not null)
                                    {
                                        <MudAvatar Size="Size.Large"><MudImage Src="@_principalPhotoUrl" /></MudAvatar>
                                    }
                                    else
                                    {
                                        <MudAvatar Size="Size.Large" Color="Color.Secondary">@PrincipalInitials(sel.Name)</MudAvatar>
                                    }
                                    <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.PhotoCamera" OnClick="ChangePrincipalPhotoAsync">@Strings.Get("UgChangePhoto")</MudButton>
                                    @if (_principalPhotoUrl is not null)
                                    {
                                        <MudButton Size="Size.Small" Color="Color.Error" OnClick="RemovePrincipalPhotoAsync">@Strings.Get("UgRemove")</MudButton>
                                    }
                                </div>
                                @* Admin password reset (ADR "User password management"). *@
                                <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.Password" OnClick="ResetPrincipalPasswordAsync" Class="mb-2">@Strings.Get("UgResetPassword")</MudButton>
                                @* Two-factor status + admin reset (ADR "MFA (interactive login, TOTP)"). *@
                                <div class="mb-2">
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                        <MudIcon Icon="@(sel.MfaEnabled ? Icons.Material.Filled.Security : Icons.Material.Filled.NoEncryption)" Size="Size.Small" />
                                        @string.Format(Strings.Get("UgTwoFactor"), sel.MfaEnabled ? Strings.Get("UgMfaEnabled") : Strings.Get("UgMfaOff"))
                                    </MudText>
                                    @if (sel.MfaEnabled && _canResetMfa)
                                    {
                                        <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.LockReset" Color="Color.Error" OnClick="ResetPrincipalMfaAsync">@Strings.Get("UgResetMfa")</MudButton>
                                    }
                                </div>
                                @* Impersonate a non-admin user (ADR "User impersonation"). *@
                                @if (_canImpersonate && !sel.Rights.IsTenantAdmin && !sel.Rights.CanImpersonate)
                                {
                                    <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.SupervisorAccount" OnClick="() => ImpersonatePrincipalAsync(sel)" Class="mb-2">@Strings.Get("UgImpersonate")</MudButton>
                                }
                            }
                            @if (sel.IsGroup)
                            {
                                <MudText Typo="Typo.caption" Class="mud-text-secondary mb-2">
                                    <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" /> @Strings.Get("UgGroupRightsNote")
                                </MudText>
                            }
                            <div class="wb-ug-rights-grid">
                                @foreach (var r in _rightsFields)
                                {
                                    <MudCheckBox T="bool" Value="@r.Get(_editRights)" ValueChanged="@(v => r.Set(_editRights, v))" Dense="true" Label="@r.Label" Class="wb-ug-right" Disabled="@(!_ugEditing)" />
                                }
                            </div>
                            @* Sensitivity clearance (ADR "Sensitivity clearance enforcement") — the highest label rank this principal may access. *@
                            <div class="d-flex align-center gap-1 mt-2" style="max-width:340px;">
                                <MudSelect T="int" Label="@Strings.Get("UgClearanceLabel")" @bind-Value="_editRights.ClearanceRank" Dense="true"
                                           Disabled="@(!_ugEditing)" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1">
                                    <MudSelectItem T="int" Value="0">@Strings.Get("UgClearanceNone")</MudSelectItem>
                                    @foreach (var lbl in _sensitivityLabels.Where(l => !l.Retired).OrderBy(l => l.Rank))
                                    {
                                        <MudSelectItem T="int" Value="@lbl.Rank">@lbl.Rank — @lbl.Name</MudSelectItem>
                                    }
                                </MudSelect>
                                @InfoButton(Strings.Get("UgClearanceInfo"))
                            </div>
                            <div class="wb-detail-actions">
                                @if (_ugEditing)
                                {
                                    <MudButton Size="Size.Small" OnClick="CancelRightsEdit" Disabled="_ugBusy">@Strings.Get("Cancel")</MudButton>
                                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveRightsAsync" Disabled="_ugBusy">@Strings.Get("Save")</MudButton>
                                }
                                else
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Edit" OnClick="BeginRightsEdit">@Strings.Get("Edit")</MudButton>
                                }
                            </div>
                            @* Group membership (ADR "Group membership editing") — direct members with a
                               searchable add-picker. *@
                            @if (sel.IsGroup)
                            {
                                <MudDivider Class="my-3" />
                                <MudText Typo="Typo.subtitle2" Class="mb-1">@Strings.Get("UgMembers")</MudText>
                                <MudAutocomplete T="MemberOption" Label="@Strings.Get("UgAddMember")" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined"
                                                 SearchFunc="SearchNonMembers" ToStringFunc="@(o => o?.Name ?? "")" ValueChanged="AddMemberAsync"
                                                 ResetValueOnEmptyText="true" CoerceText="true" Clearable="true" Class="wb-ug-add-member" Style="max-width:360px;" />
                                @if (_groupMembers.Count == 0)
                                {
                                    <MudText Typo="Typo.body2" Class="mud-text-secondary mt-2">@Strings.Get("UgNoMembers")</MudText>
                                }
                                else
                                {
                                    <div class="wb-ug-members">
                                        @foreach (var m in _groupMembers)
                                        {
                                            <div class="wb-ug-member">
                                                <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" />
                                                <span style="flex:1 1 auto; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@m.Name</span>
                                                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Error" OnClick="() => RemoveMemberAsync(m)" title="@Strings.Get("UgRemoveMember")" />
                                            </div>
                                        }
                                    </div>
                                }
                            }
                        }
                        else
                        {
                            <div class="wb-preview-empty"><MudText Typo="Typo.body2">@Strings.Get("UgSelectPrincipal")</MudText></div>
                        }
                    </div>
                </div>
            }
            else if (_activeTab == Tab.Audit)
            {
                @* Audit log viewer (ADR "Audit trail (first slice)"): a filter bar over a newest-first table
                   of security-sensitive events, cursor-paginated via a "Load more" button. *@
                <div class="wb-audit">
                    <div class="wb-audit-filters">
                        <MudTextField @bind-Value="_auditActionFilter" Label="@Strings.Get("AuditActionLabel")" Placeholder="@Strings.Get("AuditActionPlaceholder")" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:220px;" />
                        <MudDatePicker @bind-Date="_auditFrom" Label="@Strings.Get("AuditFrom")" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:170px;" />
                        <MudDatePicker @bind-Date="_auditTo" Label="@Strings.Get("AuditTo")" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:170px;" />
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Search" OnClick="RunAuditSearchAsync">@Strings.Get("AuditApply")</MudButton>
                        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Clear" OnClick="ClearAuditFiltersAsync">@Strings.Get("AuditClear")</MudButton>
                        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Download" OnClick="ExportAuditAsync" Class="ml-auto">@Strings.Get("AuditExport")</MudButton>
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.VerifiedUser" OnClick="VerifyAuditChainAsync" Disabled="_auditVerifying">@Strings.Get("AuditVerify")</MudButton>
                        @if (_auditVerifyResult is { } vr)
                        {
                            <MudChip T="string" Size="Size.Small" Color="@(vr.Valid ? Color.Success : Color.Error)" Icon="@(vr.Valid ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.GppBad)">
                                @(vr.Valid ? string.Format(Strings.Get("AuditChainIntact"), vr.CheckedCount) : string.Format(Strings.Get("AuditTampered"), vr.BrokenAtSequence))
                            </MudChip>
                        }
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Lock" OnClick="VerifyWormSegmentsAsync" Disabled="_wormVerifying">@Strings.Get("AuditVerifyWorm")</MudButton>
                        @if (_wormVerifyResult is { } wv)
                        {
                            <MudChip T="string" Size="Size.Small" Color="@(wv.Valid ? Color.Success : Color.Error)" Icon="@(wv.Valid ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.GppBad)">
                                @(wv.Valid ? string.Format(Strings.Get("AuditWormIntact"), wv.CheckedCount, wv.SegmentCount) : string.Format(Strings.Get("AuditWormBroken"), wv.Reason, wv.BrokenAtSequence))
                            </MudChip>
                        }
                    </div>
                    @if (_auditRetention is { } rt)
                    {
                        <div class="wb-audit-retention">
                            <MudIcon Icon="@Icons.Material.Filled.AutoDelete" Size="Size.Small" />
                            @if (_isTenantAdmin)
                            {
                                <span>@Strings.Get("AuditRetentionLabel")</span>
                                <MudNumericField T="int" @bind-Value="_auditRetentionDaysEdit" Min="0" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:110px;" />
                                <span class="mud-text-secondary" style="font-size:.8em;">@Strings.Get("AuditRetentionDaysHint")</span>
                                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="SaveRetentionAsync" Disabled="_auditRetentionBusy">@Strings.Get("Save")</MudButton>
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.DeleteSweep" OnClick="PurgeAuditAsync" Disabled="_auditRetentionBusy">@Strings.Get("AuditPurgeNow")</MudButton>
                            }
                            else
                            {
                                <span class="mud-text-secondary" style="font-size:.85em;">@Strings.Get("AuditRetentionLabel") @(rt.RetentionDays == 0 ? Strings.Get("AuditKeepForever") : string.Format(Strings.Get("AuditDays"), rt.RetentionDays))</span>
                            }
                            @if (rt.ChainStartSequence > 0)
