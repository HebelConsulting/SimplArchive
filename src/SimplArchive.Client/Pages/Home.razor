    // (ADR "Mask-pane current-version line").
    private string? _downloadUrl;

    // The Repositories preview (ADRs 0268/0269/0282/0294/0295) — one INSTANCE, owning its own host, state,
    // preview.js module and DotNetObjectReference (ADR 0558). The Intray and Recycle-bin tabs each own theirs,
    // so the shell holds only this one. Null until the tab has rendered.
    private PreviewPane? _repoPreview;

    // A preview requested before the pane existed, replayed once it does (see ShowPreviewAsync).
    private (string? Url, string? Layout, bool Converted, bool HasVersion)? _pendingPreview;

    // Renders into the pane — or remembers the request when the pane is not in the DOM yet.
    //
    // That is ordinary use, not an edge case: a pane's @ref is only assigned after a render, and opening a
    // document from another tab — a search hit, a notification — switches tab and selects in one synchronous
    // run. The page could previously get away with calling StateHasChanged() mid-method to materialise its own
    // host div; a child component cannot do that on its own behalf, so the request waits for
    // OnAfterRenderAsync. Rendering into a null ref would lose the preview silently, which is the worst
    // possible failure for something this visible.
    private async Task ShowPreviewAsync(string? url, string? layout, bool converted, bool hasVersion = false)
    {
        if (_repoPreview is null)
        {
            _pendingPreview = (url, layout, converted, hasVersion);
            return;
        }

        await _repoPreview.RenderAsync(url, layout, converted);
        Annotations.Attach(_repoPreview);
        await Annotations.ApplyAnnotatableAsync(hasVersion);
    }


