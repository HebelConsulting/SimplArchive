    // Export the tenant's audit log (respecting the current filters) as NDJSON (ADR "Audit trail export") — a
    // SIEM-native feed; each line carries the Sequence + Hash for external verification. Fetched with the
    // authenticated client, then handed to the browser via the blob-download JS helper.
    private async Task ExportAuditAsync()
    {
        try
        {
            var query = new List<string>();
            if (!string.IsNullOrWhiteSpace(_auditActionFilter))
            {
                query.Add($"action={Uri.EscapeDataString(_auditActionFilter.Trim())}");
            }
            if (_auditFrom is { } from)
            {
                query.Add($"from={Uri.EscapeDataString(from.ToUniversalTime().ToString("o"))}");
            }
            if (_auditTo is { } to)
            {
                query.Add($"to={Uri.EscapeDataString(to.Date.AddDays(1).ToUniversalTime().ToString("o"))}");
            }

            var url = "api/audit-events/export" + (query.Count > 0 ? "?" + string.Join("&", query) : "");
            var bytes = await Http.GetByteArrayAsync(url);
            using var stream = new MemoryStream(bytes);
            using var streamRef = new DotNetStreamReference(stream);
            await JS.InvokeVoidAsync("downloadFileFromStream", $"audit-export-{DateTime.UtcNow:yyyyMMdd-HHmmss}.ndjson", streamRef);
            Snackbar.Add("Audit log exported.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not export the audit log: {ex.Message}", Severity.Error);
        }
    }

    // Export the selected repository/folder + subtree to a .zip (ADR "Repository export"). Tenant-admin-only.
    // The filter dialog collects the version selection + date/creator filters; the zip is fetched with the
    // authenticated client and handed to the browser via the blob-download helper.
    private async Task OpenExportDialogAsync()
    {
        if (_selectedFolder is null)
        {
            return;
        }

        var root = _selectedFolder;
        var dialog = await DialogService.ShowAsync<ExportDialog>("Export", new DialogParameters { ["RootName"] = root.Name });
        if ((await dialog.Result) is not { Canceled: false, Data: ExportDialog.ExportOptions options })
        {
            return;
        }

        try
        {
            var query = new List<string> { $"versions={options.Versions}" };
            if (options.DocumentDateFrom is { } df) query.Add($"documentDateFrom={df:yyyy-MM-dd}");
            if (options.DocumentDateTo is { } dt) query.Add($"documentDateTo={dt:yyyy-MM-dd}");
            if (options.FiledFrom is { } ff) query.Add($"filedFrom={Uri.EscapeDataString(ff.ToUniversalTime().ToString("o"))}");
            if (options.FiledTo is { } ft) query.Add($"filedTo={Uri.EscapeDataString(ft.Date.AddDays(1).ToUniversalTime().ToString("o"))}");
            if (options.CreatedBy is { } cb) query.Add($"createdBy={Uri.EscapeDataString(cb)}");
            if (options.IncludePermissions) query.Add("includePermissions=true");

            Snackbar.Add("Preparing export…", Severity.Info);
            var bytes = await Http.GetByteArrayAsync($"api/documents/{root.Id}/export?" + string.Join("&", query));
            using var stream = new MemoryStream(bytes);
            using var streamRef = new DotNetStreamReference(stream);
            await JS.InvokeVoidAsync("downloadFileFromStream", $"{root.Name}-export-{DateTime.UtcNow:yyyyMMdd-HHmmss}.zip", streamRef);
            Snackbar.Add("Export ready.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not export: {ex.Message}", Severity.Error);
        }
    }

    // Import an export archive (ADRs "Repository import" / "Idempotent re-import"). Tenant-admin-only. Grafts
    // under the selected folder, or creates a new repository when nothing is selected. The dialog picks the .zip
    // + the update-existing flag; the archive is POSTed as multipart form data.
    private async Task OpenImportDialogAsync()
    {
        var dialog = await DialogService.ShowAsync<ImportDialog>("Import", new DialogParameters { ["TargetName"] = _selectedFolder?.Name });
        if ((await dialog.Result) is not { Canceled: false, Data: ImportDialog.Result options })
        {
            return;
        }

        try
        {
            Snackbar.Add("Importing…", Severity.Info);
            using var content = new MultipartFormDataContent();
            var fileContent = new ByteArrayContent(options.Bytes);
            fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue("application/zip");
            content.Add(fileContent, "file", options.FileName);

            var basePath = _selectedFolder is { } folder ? $"api/documents/{folder.Id}/import" : "api/repositories/import";
            var query = $"?updateExisting={options.UpdateExisting.ToString().ToLowerInvariant()}&includePermissions={options.IncludePermissions.ToString().ToLowerInvariant()}&merge={options.Merge.ToString().ToLowerInvariant()}&leafConflict={options.LeafConflict}";
            var resp = await Http.PostAsync($"{basePath}{query}", content);
            if (!resp.IsSuccessStatusCode)
            {
                Snackbar.Add($"Import failed ({(int)resp.StatusCode}).", Severity.Error);
                return;
            }

            var result = await resp.Content.ReadFromJsonAsync<ImportResultDto>();
            var skipped = result?.Skipped > 0 ? $", {result.Skipped} already imported" : "";
            Snackbar.Add($"Imported \"{result?.RootName}\" ({result?.Documents} documents, {result?.Versions} versions{skipped}).", Severity.Success);
            await RefreshAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Import failed: {ex.Message}", Severity.Error);
        }
    }

