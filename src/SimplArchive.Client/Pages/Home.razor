    // --- Sticky notes / positional annotations (ADR "Document annotations") --------------------------------
    // Only the Repositories preview (a real document version) can carry notes; the Inbox preview cannot (no
    // version yet). _pvAnnotatable gates the toolbar buttons; the markers themselves live in preview.js.
    private bool _pvAnnotatable;
    private bool _annotationsVisible = true;
    private bool _annotationAddMode;
    private int _annotationTool;                    // active markup tool: 0 none, 1 highlight, 2 rectangle, 3 arrow (ADR "Annotation markup")
    private bool _annotationsCanCreate;             // whether the caller has CanAnnotate (ADR "CanAnnotate right")

    // The active colour for newly-drawn shapes + the toolbar palette (ADR "Highlighting redesign"). Picking a
    // swatch sets this AND recolours the current selection.
    private string _annotationColor = "#FFEB3B";
    private static readonly string[] AnnotationPalette = ["#FFEB3B", "#8BC34A", "#4FC3F7", "#FF8A80", "#FFB74D", "#CE93D8"];

    private async Task SetAnnotationColorAsync(string color)
    {
        _annotationColor = color;
        // Recolour every selected annotation the caller may edit (notes + shapes), then reload.
        if (_pvAnnotationsUrl is not null && _selectedAnnotationIds.Count > 0)
        {
            var targets = _annotations.Where(a => a.CanEdit && _selectedAnnotationIds.Contains(a.Id)).ToList();
            foreach (var a in targets)
            {
                var request = new HttpRequestMessage(HttpMethod.Put, $"{_pvAnnotationsUrl.TrimStart('/')}/{a.Id}")
                {
                    Content = JsonContent.Create(new { pageIndex = a.PageIndex, positionX = a.PositionX, positionY = a.PositionY, width = a.Width, height = a.Height, text = a.Text, color }),
                };
                request.Headers.TryAddWithoutValidation("If-Match", $"\"{a.Etag}\"");
                var resp = await Http.SendAsync(request);
                if (!resp.IsSuccessStatusCode) { Snackbar.Add("Could not recolour the selection.", Severity.Error); break; }
            }

            await LoadAnnotationsAsync();
        }

        await InvokeAsync(StateHasChanged);
    }
    private string? _pvAnnotationsUrl;              // the version's `annotations` link (base URL)
    private List<AnnotationDto> _annotations = [];

    // Multi-select (ADR "Annotation multi-select" web parity): the selected annotation ids (notes + shapes) on
    // the current version + an in-app clipboard of copied annotations (pasted as offset duplicates).
    private readonly HashSet<Guid> _selectedAnnotationIds = [];
    private readonly List<AnnotationDto> _annotationClipboard = [];
    private bool _hasAnnotationSelection;
    private bool _hasAnnotationClipboard;

    private async Task LoadAnnotationsAsync()
    {
        _annotations = [];
        _annotationsCanCreate = false;
        if (_pvAnnotationsUrl is not null)
        {
            try
            {
                var list = await Http.GetFromJsonAsync<AnnotationListDto>(_pvAnnotationsUrl.TrimStart('/'));
                _annotations = list?.Annotations ?? [];
                _annotationsCanCreate = list?.CanCreate ?? false;
            }
            catch (Exception) { /* no notes / not readable */ }
        }

        // Drop selection ids that no longer resolve to a loaded annotation (deleted elsewhere).
        _selectedAnnotationIds.RemoveWhere(id => _annotations.All(a => a.Id != id));
        _hasAnnotationSelection = _selectedAnnotationIds.Count > 0;
        await PushAnnotationsAsync();
    }

    // Pushes the current (visible) note set to preview.js to draw the markers.
    private async Task PushAnnotationsAsync()
    {
        if (_previewModule is null || !_pv.HasPages)
        {
            return;
        }

        var markers = _annotationsVisible
            ? _annotations.Select(a => new { id = a.Id, pageIndex = a.PageIndex, kind = a.Kind, x = a.PositionX, y = a.PositionY, w = a.Width, h = a.Height, text = a.Text, color = a.Color, canEdit = a.CanEdit, points = a.Points, selected = _selectedAnnotationIds.Contains(a.Id) }).ToArray()
            : [];
        // Cast to object: InvokeVoidAsync's last parameter is `params object?[]`, so passing the array directly
        // would spread its elements as separate JS arguments instead of passing the whole array as `annos`.
        await _previewModule.InvokeVoidAsync("setAnnotations", (object)markers);
    }

    private async Task ToggleAnnotationsAsync()
    {
        _annotationsVisible = !_annotationsVisible;
        if (!_annotationsVisible && _annotationAddMode)
        {
            await StopAddNoteAsync();
        }

        await PushAnnotationsAsync();
    }

    private async Task StartAddNoteAsync()
    {
        if (!_annotationsVisible)
        {
            _annotationsVisible = true;
            await PushAnnotationsAsync();
        }

        await SetShapeToolAsync(0); // notes and shape-drawing are mutually exclusive
        _annotationAddMode = true;
        if (_previewModule is not null)
        {
            await _previewModule.InvokeVoidAsync("setAddMode", true);
        }

        Snackbar.Add("Click a spot on the page to place a note.", Severity.Info);
    }

    private async Task StopAddNoteAsync()
    {
        _annotationAddMode = false;
        if (_previewModule is not null)
        {
            await _previewModule.InvokeVoidAsync("setAddMode", false);
        }
    }

    // Toggles a markup tool (highlight/rectangle/arrow): clicking the active one turns it off. Drag on the page
    // to draw (ADR "Annotation markup").
    private async Task SelectShapeToolAsync(int kind)
    {
        if (!_annotationsVisible)
        {
            _annotationsVisible = true;
            await PushAnnotationsAsync();
        }

        await StopAddNoteAsync();
        await SetShapeToolAsync(_annotationTool == kind ? 0 : kind);
        if (_annotationTool > 0)
        {
            Snackbar.Add("Drag on the page to draw.", Severity.Info);
        }
    }

    private async Task SetShapeToolAsync(int kind)
    {
        _annotationTool = kind;
        if (_previewModule is not null)
        {
            await _previewModule.InvokeVoidAsync("setDrawMode", kind);
        }
    }

    // A shape was drawn by dragging (ADR "Annotation markup") — create it immediately with the tool's default
    // colour. The tool deactivates after one draw (ADR "Draw-tool behaviour") — draw exactly one shape, then the
    // button returns to inactive.
    [JSInvokable]
    public async Task OnShapeDrawn(int pageIndex, int kind, double x, double y, double width, double height)
    {
        if (_pvAnnotationsUrl is null || kind <= 0)
        {
            return;
        }

        await SetShapeToolAsync(0); // one shape per tool activation
        var resp = await Http.PostAsJsonAsync(_pvAnnotationsUrl.TrimStart('/'),
            new { pageIndex, kind, positionX = x, positionY = y, width, height, text = "", color = _annotationColor });
        if (!resp.IsSuccessStatusCode)
        {
            Snackbar.Add("Could not add the markup.", Severity.Error);
            return;
        }

        await LoadAnnotationsAsync();
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task OnAnnotationPlaced(int pageIndex, double x, double y)
    {
        await StopAddNoteAsync(); // one note per Add-note activation (ADR "Draw-tool behaviour")
        if (_pvAnnotationsUrl is null)
        {
            return;
        }

        var dialog = await DialogService.ShowAsync<AnnotationDialog>("New note", new DialogParameters
        {
            ["Text"] = "",
            ["NoteColor"] = "#FFEB3B",
            ["CanEdit"] = true,
            ["CanDelete"] = false,
        });
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not AnnotationDialog.AnnotationEditResult edit || edit.Action != "save")
        {
            return;
        }

        // Create the note with a default size (kind 0 + width/height) so it renders as an always-visible box
        // (ADR "Post-it note boxes" web parity); the box shows its text and the author can resize it.
        var resp = await Http.PostAsJsonAsync(_pvAnnotationsUrl.TrimStart('/'), new { pageIndex, kind = 0, positionX = x, positionY = y, width = 0.22, height = 0.06, text = edit.Text, color = edit.Color });
        if (!resp.IsSuccessStatusCode)
        {
            Snackbar.Add("Could not add the note.", Severity.Error);
            return;
        }

        await LoadAnnotationsAsync();
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task OnAnnotationClicked(Guid id)
    {
        var note = _annotations.FirstOrDefault(a => a.Id == id);
        if (note is null || _pvAnnotationsUrl is null)
        {
            return;
        }

        var isShape = note.Kind > 0;
        var dialog = await DialogService.ShowAsync<AnnotationDialog>(isShape ? "Markup" : "Note", new DialogParameters
        {
            ["Text"] = note.Text,
            ["NoteColor"] = note.Color,
            ["AuthorName"] = note.AuthorName,
            ["CanEdit"] = note.CanEdit,
            ["CanDelete"] = note.CanDelete,
            ["IsShape"] = isShape,
        });
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not AnnotationDialog.AnnotationEditResult edit)
        {
            return;
        }

        var noteUrl = $"{_pvAnnotationsUrl.TrimStart('/')}/{note.Id}";
        HttpResponseMessage resp;
        if (edit.Action == "delete")
        {
            var request = new HttpRequestMessage(HttpMethod.Delete, noteUrl);
            request.Headers.TryAddWithoutValidation("If-Match", $"\"{note.Etag}\"");
            resp = await Http.SendAsync(request);
        }
        else
        {
            var request = new HttpRequestMessage(HttpMethod.Put, noteUrl)
            {
                Content = JsonContent.Create(new { pageIndex = note.PageIndex, positionX = note.PositionX, positionY = note.PositionY, width = note.Width, height = note.Height, text = edit.Text, color = edit.Color }),
            };
            request.Headers.TryAddWithoutValidation("If-Match", $"\"{note.Etag}\"");
            resp = await Http.SendAsync(request);
        }

        if (!resp.IsSuccessStatusCode)
        {
            Snackbar.Add(edit.Action == "delete" ? "Could not delete the note." : "Could not save the note.", Severity.Error);
            return;
        }

        await LoadAnnotationsAsync();
        await InvokeAsync(StateHasChanged);
    }

    // Drag-to-reposition (ADR "Document annotations"): the author dragged a note to a new spot; persist the new
    // position via the same PUT (keeping text/colour), using the etag the list already embeds. On failure/412 a
    // reload snaps it back to the persisted position and refreshes the etag.
    [JSInvokable]
    public async Task OnAnnotationMoved(Guid id, int pageIndex, double x, double y)
    {
        var note = _annotations.FirstOrDefault(a => a.Id == id);
        if (note is null || _pvAnnotationsUrl is null || !note.CanEdit)
        {
            return;
        }

        var request = new HttpRequestMessage(HttpMethod.Put, $"{_pvAnnotationsUrl.TrimStart('/')}/{note.Id}")
        {
            Content = JsonContent.Create(new { pageIndex = note.PageIndex, positionX = x, positionY = y, width = note.Width, height = note.Height, text = note.Text, color = note.Color }),
        };
        request.Headers.TryAddWithoutValidation("If-Match", $"\"{note.Etag}\"");
        var resp = await Http.SendAsync(request);
        if (resp.IsSuccessStatusCode)
        {
            // Update in place (position + the rotated etag from the response) rather than a full reload — no
            // flicker, and the note stays available for an immediate follow-up click/drag (a reload transiently
            // empties the list).
            note.PositionX = x;
            note.PositionY = y;
            if (resp.Headers.ETag?.Tag is { } tag)
            {
                note.Etag = tag.Trim('"');
            }
            await PushAnnotationsAsync();
        }
        else
        {
            Snackbar.Add("Could not move the note.", Severity.Error);
            await LoadAnnotationsAsync(); // snap back to the persisted position + refresh the etag
        }

        await InvokeAsync(StateHasChanged);
    }

    // Resize (ADR "Post-it note boxes" web parity): the author dragged a note box's corner grip; persist the new
    // size (keeping position/text/colour), updating in place from the response etag like the move.
    [JSInvokable]
    public async Task OnAnnotationResized(Guid id, int pageIndex, double width, double height)
    {
        var note = _annotations.FirstOrDefault(a => a.Id == id);
        if (note is null || _pvAnnotationsUrl is null || !note.CanEdit)
        {
            return;
        }

        var request = new HttpRequestMessage(HttpMethod.Put, $"{_pvAnnotationsUrl.TrimStart('/')}/{note.Id}")
        {
            Content = JsonContent.Create(new { pageIndex = note.PageIndex, positionX = note.PositionX, positionY = note.PositionY, width, height, text = note.Text, color = note.Color }),
        };
        request.Headers.TryAddWithoutValidation("If-Match", $"\"{note.Etag}\"");
        var resp = await Http.SendAsync(request);
        if (resp.IsSuccessStatusCode)
        {
            note.Width = width;
            note.Height = height;
            if (resp.Headers.ETag?.Tag is { } tag)
            {
                note.Etag = tag.Trim('"');
            }
            await PushAnnotationsAsync();
        }
        else
        {
            Snackbar.Add("Could not resize the note.", Severity.Error);
            await LoadAnnotationsAsync();
        }

        await InvokeAsync(StateHasChanged);
    }

    // --- Multi-select: select / marquee / group-move / delete / copy-paste (ADR "Annotation multi-select" web parity) ---

    // A click / Ctrl-click on an annotation: a plain click selects just it; a Ctrl-click toggles it in the set.
    [JSInvokable]
    public async Task OnAnnotationSelect(Guid id, bool toggle)
    {
        if (toggle)
        {
            if (!_selectedAnnotationIds.Remove(id)) _selectedAnnotationIds.Add(id);
        }
        else
        {
            _selectedAnnotationIds.Clear();
            _selectedAnnotationIds.Add(id);
        }

        await UpdateAnnotationSelectionAsync();
    }

    // A marquee drag over empty page area selected the enclosed annotations (Ctrl adds to the current selection).
    [JSInvokable]
    public async Task OnAnnotationMarquee(Guid[] ids, bool additive)
    {
        if (!additive) _selectedAnnotationIds.Clear();
        foreach (var id in ids) _selectedAnnotationIds.Add(id);
        await UpdateAnnotationSelectionAsync();
    }

    [JSInvokable]
    public async Task OnAnnotationClearSelection()
    {
        if (_selectedAnnotationIds.Count == 0) return;
        _selectedAnnotationIds.Clear();
        await UpdateAnnotationSelectionAsync();
    }

    private async Task UpdateAnnotationSelectionAsync()
    {
        _hasAnnotationSelection = _selectedAnnotationIds.Count > 0;
        // Toggle the outline on the existing elements (a full rebuild would break double-click-to-edit).
        if (_previewModule is not null)
        {
            await _previewModule.InvokeVoidAsync("setSelection", (object)_selectedAnnotationIds.Select(g => g.ToString()).ToArray());
        }
        await InvokeAsync(StateHasChanged);
    }

    // A group drag moved the whole selection by a normalized delta — shift every selected editable annotation on
    // the page, persist each, then reload.
    [JSInvokable]
    public async Task OnAnnotationGroupMove(int pageIndex, double dx, double dy)
    {
        if (_pvAnnotationsUrl is null) return;
        var targets = _annotations.Where(a => a.PageIndex == pageIndex && a.CanEdit && _selectedAnnotationIds.Contains(a.Id)).ToList();
        if (targets.Count == 0) return;

        foreach (var a in targets)
        {
            var nx = Math.Clamp(a.PositionX + dx, 0, 1);
            var ny = Math.Clamp(a.PositionY + dy, 0, 1);
            var request = new HttpRequestMessage(HttpMethod.Put, $"{_pvAnnotationsUrl.TrimStart('/')}/{a.Id}")
            {
                Content = JsonContent.Create(new { pageIndex = a.PageIndex, positionX = nx, positionY = ny, width = a.Width, height = a.Height, text = a.Text, color = a.Color }),
            };
            request.Headers.TryAddWithoutValidation("If-Match", $"\"{a.Etag}\"");
            var resp = await Http.SendAsync(request);
            if (!resp.IsSuccessStatusCode)
            {
                Snackbar.Add("Could not move the selection.", Severity.Error);
                break;
            }
        }

        await LoadAnnotationsAsync();
        await InvokeAsync(StateHasChanged);
    }

    // Delete every selected annotation the caller may delete; reload + clear the selection.
    private async Task DeleteSelectedAnnotationsAsync()
    {
        if (_pvAnnotationsUrl is null || _selectedAnnotationIds.Count == 0) return;
        var targets = _annotations.Where(a => a.CanDelete && _selectedAnnotationIds.Contains(a.Id)).ToList();
        foreach (var a in targets)
        {
            var request = new HttpRequestMessage(HttpMethod.Delete, $"{_pvAnnotationsUrl.TrimStart('/')}/{a.Id}");
            request.Headers.TryAddWithoutValidation("If-Match", $"\"{a.Etag}\"");
            var resp = await Http.SendAsync(request);
            if (!resp.IsSuccessStatusCode)
            {
                Snackbar.Add("Could not delete the selection.", Severity.Error);
                break;
            }
        }

        _selectedAnnotationIds.Clear();
        await LoadAnnotationsAsync();
        await InvokeAsync(StateHasChanged);
    }

    private void CopySelectedAnnotations()
    {
        _annotationClipboard.Clear();
        _annotationClipboard.AddRange(_annotations.Where(a => _selectedAnnotationIds.Contains(a.Id)));
        _hasAnnotationClipboard = _annotationClipboard.Count > 0;
        if (_hasAnnotationClipboard) Snackbar.Add($"Copied {_annotationClipboard.Count} annotation(s).", Severity.Info);
    }

    // Paste the clipboard as offset duplicates on their original page/version; then reload.
    private async Task PasteAnnotationsAsync()
    {
        if (_pvAnnotationsUrl is null || _annotationClipboard.Count == 0 || !_annotationsCanCreate) return;
        const double offset = 0.03;
        foreach (var a in _annotationClipboard)
        {
            var nx = Math.Clamp(a.PositionX + offset, 0, 1);
            var ny = Math.Clamp(a.PositionY + offset, 0, 1);
            var w = a.Width ?? (a.Kind == 0 ? 0.22 : 0.1);
            var h = a.Height ?? (a.Kind == 0 ? 0.06 : 0.05);
            var resp = await Http.PostAsJsonAsync(_pvAnnotationsUrl.TrimStart('/'),
                new { pageIndex = a.PageIndex, kind = a.Kind, positionX = nx, positionY = ny, width = w, height = h, text = a.Text, color = a.Color });
            if (!resp.IsSuccessStatusCode)
            {
                Snackbar.Add("Could not paste the annotations.", Severity.Error);
                break;
            }
        }

        await LoadAnnotationsAsync();
        await InvokeAsync(StateHasChanged);
    }

