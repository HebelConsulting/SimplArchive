    // ---- Bulk actions on the multi-selection (ADR "Bulk actions on selected documents") ------------------
    // The selection is the PAGE's — it is drawn by the list and read by the drag handler — so the page holds it
    // and hands the ids to the shared service, then decides what "refresh" means (see BulkActions).

    /// <summary>Does EVERY row in the bulk selection permit this? (#858)</summary>
    /// <remarks>
    /// The owner chose all-permit over offer-and-report, so a bulk button is disabled the moment one selected
    /// row would refuse. A row that is selected but no longer in the loaded list counts as NOT permitting:
    /// unknown is not permission, and the safe direction is the one that cannot promise what the server refuses.
    /// </remarks>
    private bool BulkAll(Func<BrowseNode, bool> permits) =>
        _bulkIds.Count > 0
        && _bulkIds.All(id => _folderContents.FirstOrDefault(n => n.Id == id) is { } node && permits(node));

    private Task BulkMoveAsync() => RunBulkAsync(Bulk.MoveAsync(_bulkIds));

