    // Persists only the fields that changed; a failure keeps the pane in edit mode and reports it (ADR 0278).
    private async Task SaveDetailAsync()
    {
        if (_detailNode is not { } item)
        {
            return;
        }

        _detailBusy = true;
        var failures = new List<string>();
        var nameChanged = false;
        try
        {
            var newName = _editName.Trim();
            if (newName.Length > 0 && newName != _origName)
            {
                var etag = await Actions.GetETagAsync(DetailHref("self"));
                using var req = new HttpRequestMessage(HttpMethod.Put, DetailHref("self")) { Content = JsonContent.Create(new { name = newName }) };
                if (etag is not null)
                {
                    req.Headers.TryAddWithoutValidation("If-Match", etag);
                }

                var resp = await Http.SendAsync(req);
                if (resp.IsSuccessStatusCode) { _sysName = _origName = newName; nameChanged = true; }
                else if (resp.StatusCode == HttpStatusCode.Conflict) { failures.Add("name (already exists here)"); }
                else { failures.Add("name"); }
            }

            if (_sysHasVersion && _sysCurrentVersionId != Guid.Empty && _editDocumentDate is { } dd && dd != _origDocumentDate)
            {
                var resp = await Http.PutAsJsonAsync($"api/documents/{item.Id}/versions/{_sysCurrentVersionId}/document-date", new { documentDate = dd.ToString("yyyy-MM-dd") });
                if (resp.IsSuccessStatusCode) { _sysDocumentDate = _origDocumentDate = dd; } else { failures.Add("document date"); }
            }

            if (_sysHasTiff && !_editOcrCodes.SequenceEqual(_origOcrCodes))
            {
                var resp = await Http.PutAsJsonAsync(DetailHref("ocr-languages"), new { languages = _editOcrCodes });
                if (resp.IsSuccessStatusCode) { _sysOcrCodes = [.. _editOcrCodes]; _origOcrCodes = [.. _editOcrCodes]; } else { failures.Add("OCR languages"); }
            }

            if (_editSensitivityId != _detailSensitivityId)
            {
                var resp = await Http.PutAsJsonAsync(DetailHref("sensitivity"), new { labelId = _editSensitivityId });
                if (resp.IsSuccessStatusCode)
                {
                    _detailSensitivityId = _editSensitivityId;
                    var lbl = _sensitivityLabels.FirstOrDefault(l => l.Id == _editSensitivityId);
                    _detailSensitivityName = lbl?.Name ?? "";
                    _detailSensitivityColor = lbl?.Color;
                    _detailSensitivityWatermark = lbl?.Watermark ?? false;
                }
                else { failures.Add("sensitivity"); }
            }

            // Free-form tags (ADR "Document tags"): PUT-replaces the whole set; the server normalizes/dedupes.
            var editTags = _editTags.Select(t => t.Trim().ToLowerInvariant()).Where(t => t.Length is > 0 and <= 100).Distinct().ToList();
            if (!editTags.OrderBy(t => t).SequenceEqual(_origTags.OrderBy(t => t)))
            {
                var resp = await Http.PutAsJsonAsync(DetailHref("tags"), new { tags = editTags });
                if (resp.IsSuccessStatusCode)
                {
                    _detailTags = (await resp.Content.ReadFromJsonAsync<TagsResponse>())?.Tags ?? [];
                    _origTags = [.. _detailTags];
                }
                else { failures.Add("tags"); }
            }

            try
            {
                if (_editMaskId is null)
                {
                    if (_origMaskId is not null)
                    {
                        (await Http.DeleteAsync(DetailHref("mask"))).EnsureSuccessStatusCode();
                    }
                }
                else
                {
                    // Fill index data first, then (re)assign the mask (which re-checks required fields).
                    var body = new { fields = _editFields.Select(f => new { fieldDefinitionId = f.FieldDefinitionId, values = f.ToValues() }) };
                    (await Http.PutAsJsonAsync(DetailHref("index-data"), body)).EnsureSuccessStatusCode();
                    if (_editMaskId != _origMaskId)
                    {
                        (await Http.PutAsJsonAsync(DetailHref("mask"), new { maskId = _editMaskId })).EnsureSuccessStatusCode();
                    }
                }
            }
            catch (HttpRequestException)
            {
                failures.Add("mask / index data (check required and formatted fields)");
            }

            // A folder's contents order commits with everything else, from the same pencil (issue #408). Skipped
            // for a document, which lists nothing, and when unchanged — so an ordinary edit sends no extra request.
            if (item.IsFolder && _editSortOrder != _detailSortOrder)
            {
                var resp = await Http.PutAsJsonAsync(DetailHref("contents-sort-order"), new { sortOrder = (int)_editSortOrder });
                if (resp.IsSuccessStatusCode)
                {
                    _detailSortOrder = _editSortOrder;
                    // The OPEN folder's own listing re-sorts only when it is the folder that changed.
                    if (_selectedFolder?.Id == item.Id)
                    {
                        _folderSortOrder = _editSortOrder;
                        _headerSortActive = false; // re-apply the persisted default order to the current listing
                    }
                }
                else
                {
                    failures.Add(resp.StatusCode == System.Net.HttpStatusCode.Forbidden
                        ? Strings.Get("FolderSortNoPermission")
                        : "contents sort order");
                }
            }

            if (failures.Count > 0)
            {
                Snackbar.Add(string.Format(Strings.Get("StErrSaveJoin"), string.Join("; ", failures)), Severity.Warning);
                return; // stay in edit mode so the rejected field can be fixed
            }

            _isEditing = false;
            Snackbar.Add(Strings.Get("StSaved"), Severity.Success);
            if (nameChanged)
            {
                // Rebuild the tree/list so rows show the new name, then reselect the *fresh* node (the old
                // _selectedItem still carries the old name, which would otherwise reappear in the detail pane).
                await ReloadTreeAsync();
                if (_selectedFolder is { } folder)
                {
                    _folderContents = await OpenFolderContentsAsync(folder);
                }

                var fresh = (_folderContents ?? []).FirstOrDefault(c => c.Id == item.Id) ?? item with { Name = _sysName };
                await SelectItemAsync(fresh);
            }
            else
            {
                await SelectItemAsync(item);
            }
        }
        finally
        {
            _detailBusy = false;
        }
    }

    // ---- Automatic chat entries (ADR 0545) -----------------------------------------------------------

    private const int ChatUserPost = 0, ChatVersionFiled = 1, ChatVersionActivated = 2;

    // Renders a system entry's sentence from a LOCALIZED TEMPLATE, splicing the author in as a live element so
    // the name stays a clickable identity card. String.Format would flatten it to text and lose the card, which
    // is why the wording is stored nowhere and composed here instead.
    private RenderFragment SystemSentence(ChatMessageResponse message) => builder =>
    {
        var template = message.Kind switch
        {
            // One entry per version, two sentences: a first version IS the document arriving; every later one is
            // a new working version of something already here. The version number the entry points at decides.
            ChatVersionFiled => Strings.Get(
                message.VersionNumber is null or <= 1 ? "ChatFiledNewDocument" : "ChatSavedNewVersion"),
            ChatVersionActivated => Strings.Get("ChatActivatedVersion"),
            _ => "{0}",
        };

        // {0} is the author element; {1}, where a template has one, is the version number.
        var sequence = 0;
        foreach (var part in SplitTemplate(template))
        {
            switch (part)
            {
                case "{0}":
                    builder.AddContent(sequence++, AuthorMarkup(message));
                    break;
                case "{1}":
                    builder.AddContent(sequence++, message.VersionNumber?.ToString() ?? "");
                    break;
                default:
                    builder.AddContent(sequence++, part);
                    break;
            }
        }
    };

    // Splits "{0} made Version {1} current." into its literal and placeholder parts, preserving order.
    private static IEnumerable<string> SplitTemplate(string template)
    {
        var buffer = new System.Text.StringBuilder();
        for (var i = 0; i < template.Length; i++)
        {
            if (i + 2 < template.Length && template[i] == '{' && char.IsDigit(template[i + 1]) && template[i + 2] == '}')
            {
                if (buffer.Length > 0)
                {
                    yield return buffer.ToString();
                    buffer.Clear();
                }

                yield return template.Substring(i, 3);
                i += 2;
                continue;
            }

            buffer.Append(template[i]);
        }

        if (buffer.Length > 0)
        {
            yield return buffer.ToString();
        }
    }

    // The check-in comment shown beneath "Version N". A machine-generated one carries no stored text — its
    // wording is a localized string for the kind (ADR 0545).
    private string? VersionCommentText(ChatMessageResponse message) => message.VersionCommentKind switch
    {
        1 => Strings.Get("VersionCommentSearchablePdf"),
        _ => string.IsNullOrWhiteSpace(message.VersionComment) ? null : message.VersionComment,
    };

    // ---- Author identity card (ADR 0544) -------------------------------------------------------------

    // The author label. A message that advertises an "author-card" rel renders a clickable name; one that does
    // not (a ServiceAccount posted it) renders plain text. The ABSENCE of the rel is the signal — the client
    // never decides for itself whether an author is a person (ADR 0543/0544).
    private RenderFragment AuthorMarkup(ChatMessageResponse message) => builder =>
    {
        var cardHref = Links.Href(message.Links, "author-card");
        if (cardHref is null)
        {
            builder.AddContent(0, message.AuthorName);
            return;
        }

        builder.OpenElement(1, "span");
        builder.AddAttribute(2, "class", "wb-author-link");
        builder.AddAttribute(3, "onclick", EventCallback.Factory.Create<MouseEventArgs>(this, () => OpenAuthorCardAsync(cardHref)));
        builder.AddContent(4, message.AuthorName);
        builder.CloseElement();
    };

    private UserCardResponse? _authorCard;
    private string? _authorCardPhoto;
    private bool _authorCardOpen;

    private void CloseAuthorCard() => _authorCardOpen = false;

    // Initials fallback when a colleague has no photo — the same treatment MainLayout gives the current user.
    private static string Initials(string displayName) =>
        string.Concat(displayName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(part => part[0])).ToUpperInvariant();

    private async Task OpenAuthorCardAsync(string cardHref)
    {
        _authorCard = null;
        _authorCardPhoto = null;
        _authorCardOpen = true;

        try
        {
            _authorCard = await Http.GetFromJsonAsync<UserCardResponse>(cardHref);
        }
        catch (HttpRequestException)
        {
            _authorCardOpen = true; // keep it open so the failure is visible rather than a dead click
            return;
        }

        // The photo rel is present only when there is one, so this never probes for a 404 (ADR 0543). The bytes
        // are bearer-protected, so a raw <img src> would 401 — fetch and render a data URL, as MainLayout does.
        if (Links.Href(_authorCard?.Links, "photo") is { } photoHref)
        {
            try
            {
                _authorCardPhoto = "data:image/png;base64," + Convert.ToBase64String(await Http.GetByteArrayAsync(photoHref));
            }
            catch (HttpRequestException)
            {
                _authorCardPhoto = null;
            }
        }

        StateHasChanged();
    }

    // ---- Chat thread ---------------------------------------------------------------------------------

    // Prefers the server-advertised "chat" rel and only composes a URL when the node came from a list that does
    // not emit it yet (ADR 0543). Every composed URL here is an entry in the hypermedia guard's allowlist.
    private string ChatUrlFor(BrowseNode node) => node.ChatHref ?? $"api/documents/{node.Id}/chat";

    private async Task LoadCommentsAsync(BrowseNode node)
    {
        _comments = [];
        _replyingTo = null;
        _mentionCandidates = [];
        _mentionableUsersHref = null;
        try
        {
            var url = ChatUrlFor(node);
            while (url is not null)
            {
                var page = await Http.GetFromJsonAsync<ChatMessageListResponse>(url);
                _comments.AddRange(page?.Messages ?? []);
                // Captured from the FIRST page: the rel is a property of the thread, not of a page of it.
                _mentionableUsersHref ??= Links.Href(page?.Links, "mentionable-users");
                url = Links.Href(page?.Links, "next");
            }
        }
        catch (HttpRequestException)
        {
            // No CanSee (shouldn't happen for a visible document) — leave the thread empty.
        }
    }

    private void ToggleReply(Guid commentId)
    {
        _replyingTo = _replyingTo == commentId ? null : commentId;
        _replyText = "";
        _mentionCandidates = [];
    }

    // ---- @-mentions (issue #383) ---------------------------------------------------------------------------

    // A mention is stored as a token holding the USER ID, never the typed name: display names contain spaces (so
    // "@Demo Admin" has no delimiter), are not unique, and can be renamed. The name shown here is resolved from
    // the id at render time, so it can never go stale.
    private async Task OnComposeChangedAsync(string value)
    {
        _newComment = value;
        await RefreshMentionCandidatesAsync(value);
    }

    private async Task OnReplyChangedAsync(string value)
    {
        _replyText = value;
        await RefreshMentionCandidatesAsync(value);
    }

    // The picker is driven off the text AFTER the last '@'. It deliberately does NOT stop at a space: display
    // names contain them, so "@Demo Ad" has to keep matching. The cost is that the query only makes sense while
    // the caret is at the end — which is where typing happens — so a stale run is capped at MentionQueryLimit
    // characters rather than searching the rest of the message.
    private const int MentionQueryLimit = 30;

    private async Task RefreshMentionCandidatesAsync(string text)
    {
        if (_mentionableUsersHref is not { } href || MentionQuery(text) is not { } query)
        {
            _mentionCandidates = [];
            return;
        }

        try
        {
            var page = await Http.GetFromJsonAsync<MentionableUserListResponse>($"{href}?q={Uri.EscapeDataString(query)}");
            _mentionCandidates = page?.Users ?? [];
        }
        catch (HttpRequestException)
        {
            _mentionCandidates = [];
        }
    }

    private static string? MentionQuery(string text)
    {
        var at = text.LastIndexOf('@');
        if (at < 0)
        {
            return null;
        }

        // Not a mention if the '@' is part of a word (an email address, say) — it has to start the token.
        if (at > 0 && !char.IsWhiteSpace(text[at - 1]))
        {
            return null;
        }

        var query = text[(at + 1)..];
        return query.Length > MentionQueryLimit || query.Contains('\n') ? null : query;
    }

    // Replaces the half-typed "@Dem" with the token, so what is stored is the id and what is shown is the name.
    private void PickMention(MentionableUserResponse user)
    {
        var target = _replyingTo is null ? _newComment : _replyText;
        var at = target.LastIndexOf('@');
        if (at < 0)
        {
            return;
        }

        var replaced = $"{target[..at]}@[{user.Id}] ";

        if (_replyingTo is null)
        {
            _newComment = replaced;
        }
        else
        {
            _replyText = replaced;
        }

        _mentionCandidates = [];
    }

    // Renders a body with its "@[id]" tokens turned into the mentioned person's name. The names come from the
    // message's own mentions list, so no extra lookup is needed; a token whose user is gone falls back to a
    // tombstone rather than showing a raw id or silently dropping the fact that somebody was addressed.
    private RenderFragment MentionMarkup(ChatMessageResponse message) => builder =>
    {
        var names = (message.Mentions ?? []).ToDictionary(m => m.UserId, m => m.DisplayName);
        var sequence = 0;

        foreach (var part in MentionParts(message.Body))
        {
            if (part.UserId is { } userId)
            {
                builder.OpenElement(sequence++, "span");
                builder.AddAttribute(sequence++, "class", "wb-mention");
                builder.AddContent(sequence++, $"@{names.GetValueOrDefault(userId, Strings.Get("ChatMentionUnknown"))}");
                builder.CloseElement();
            }
            else
            {
                builder.AddContent(sequence++, part.Text);
            }
        }
    };

    private static IEnumerable<(string Text, Guid? UserId)> MentionParts(string body)
    {
        var matches = MentionTokenPattern.Matches(body);
        var position = 0;

        foreach (System.Text.RegularExpressions.Match match in matches)
        {
            if (match.Index > position)
            {
                yield return (body[position..match.Index], null);
            }

            yield return ("", Guid.Parse(match.Groups[1].Value));
            position = match.Index + match.Length;
        }

        if (position < body.Length)
        {
            yield return (body[position..], null);
        }
    }

