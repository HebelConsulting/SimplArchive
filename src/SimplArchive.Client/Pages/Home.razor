    // Check out a document (take the exclusive edit lock) from the Repositories row menu.
    private async Task CheckOutAsync(BrowseNode node)
    {
        try
        {
            var resp = await Http.PutAsync($"api/documents/{node.Id}/checkout", null);
            if (resp.StatusCode == System.Net.HttpStatusCode.Conflict) { Snackbar.Add("Already checked out by another user.", Severity.Warning); return; }
            if (resp.StatusCode == System.Net.HttpStatusCode.Forbidden) { Snackbar.Add("You don't have permission to check this out.", Severity.Error); return; }
            resp.EnsureSuccessStatusCode();
            Snackbar.Add($"Checked out '{node.Name}'. Use the Check-out tab to download, edit and check it back in.", Severity.Success);
            await ReloadCurrentFolderAsync();
            await LoadCheckoutsAsync();
        }
        catch (Exception) { Snackbar.Add("Could not check out the document.", Severity.Error); }
    }

    // Force-release another user's lock (a CanOverrideCheckout holder).
    private async Task OverrideCheckoutAsync(BrowseNode node)
    {
        if (!await Confirm($"Force-release the check-out of '{node.Name}' held by {node.CheckedOutByName}?", "Override")) return;
        try
        {
            (await Http.DeleteAsync($"api/documents/{node.Id}/checkout")).EnsureSuccessStatusCode();
            Snackbar.Add($"Released the check-out of '{node.Name}'.", Severity.Success);
            await ReloadCurrentFolderAsync();
        }
        catch (Exception) { Snackbar.Add("Could not override the check-out.", Severity.Error); }
    }

    // Download from stash: fetch the cloud working copy (or the current version if no stash yet) as a file.
    private async Task DownloadFromStashAsync(CheckoutDto c)
    {
        var url = c.StashDownloadUrl ?? c.DownloadUrl;
        if (url is null) { Snackbar.Add("Nothing to download.", Severity.Warning); return; }
        try
        {
            var stream = await AnonymousHttp.GetStreamAsync(url);
            using var streamRef = new DotNetStreamReference(stream);
            await JS.InvokeVoidAsync("downloadFileFromStream", c.Name + c.FileExtension, streamRef);
        }
        catch (Exception) { Snackbar.Add("Could not download the working copy.", Severity.Error); }
    }

    // Upload to stash: put the edited file back into the cloud working copy (a presigned PUT).
    private async Task UploadToStashAsync(CheckoutDto c, IBrowserFile? file)
    {
        if (file is null) return;
        try
        {
            var target = await (await Http.PostAsJsonAsync($"api/checkouts/{c.Id}/working-copy", new { })).Content.ReadFromJsonAsync<WorkingCopyUploadResponse>();
            using var buffer = new MemoryStream();
            await file.OpenReadStream(maxAllowedSize: 500L * 1024 * 1024).CopyToAsync(buffer);
            using var content = new ByteArrayContent(buffer.ToArray());
            (await AnonymousHttp.PutAsync(target!.UploadUrl, content)).EnsureSuccessStatusCode();
            Snackbar.Add($"Saved '{c.Name}' to the cloud.", Severity.Success);
            await LoadCheckoutsAsync();
        }
        catch (Exception) { Snackbar.Add("Could not upload the working copy.", Severity.Error); }
    }

    // Check in: promote the cloud stash to a new version + release (server-side).
    private async Task CheckInFromStashAsync(CheckoutDto c)
    {
        try
        {
            var resp = await Http.PostAsync($"api/checkouts/{c.Id}/checkin", null);
            if (resp.StatusCode == System.Net.HttpStatusCode.BadRequest) { Snackbar.Add("Upload the edited file to the cloud first.", Severity.Warning); return; }
            resp.EnsureSuccessStatusCode();
            Snackbar.Add($"Checked in '{c.Name}'.", Severity.Success);
            await LoadCheckoutsAsync();
            await ReloadCurrentFolderAsync();
        }
        catch (Exception) { Snackbar.Add("Could not check in.", Severity.Error); }
    }

