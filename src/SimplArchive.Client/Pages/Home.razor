            _tasks = (await Http.GetFromJsonAsync<TaskListResponse>(await ApiRoot.RequireAsync("tasks")))?.Tasks ?? [];
            _taskCount = _tasks.Count;
        }
        catch (Exception)
        {
            _tasks = [];
            _taskCount = 0;
        }
    }

    // Reveal a document in the Repositories panes, switching to that tab first. The shell owns this because it
    // owns the tree and the list; tabs and dialogs hand back a document and let it navigate (ADR 0558).
    private async Task NavigateToDocumentAsync(Guid documentId, Guid? parentId)
    {
        _activeTab = Tab.Repositories;
        await (parentId is { } p ? NavigateToFolderAsync(p, documentId) : NavigateToFolderAsync(documentId));
    }

    private Task NavigateToDocumentAsync((Guid DocumentId, Guid? ParentId) target) =>
        NavigateToDocumentAsync(target.DocumentId, target.ParentId);

    private async Task OpenTaskAsync(TaskItem task)
    {
        _activeTab = Tab.Repositories;
        if (task.ParentId is { } parentId)
        {
            await NavigateToFolderAsync(parentId, task.DocumentId);
        }
        else
        {
            await NavigateToFolderAsync(task.DocumentId);
        }
