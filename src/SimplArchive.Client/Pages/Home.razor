    private async Task LoadGroupMembersAsync(PrincipalRow? p)
    {
        _groupMembers.Clear();
        if (p is null || !p.IsGroup)
        {
            return;
        }

        try
        {
            var url = $"api/groups/{p.Id}/members";
            while (url is not null)
            {
                var page = await Http.GetFromJsonAsync<MembersResponse>(url);
                foreach (var m in page?.Members ?? [])
                {
                    _groupMembers.Add(new MemberOption(m.Id, m.DisplayName));
                }
                url = RelativeHref(page?.Links, "next");
            }
        }
        catch (Exception)
        {
