    private async Task RenameAsync(BrowseNode node)
    {
        var parameters = new DialogParameters<RenameDialog> { { x => x.CurrentName, node.Name } };
        var dialog = await DialogService.ShowAsync<RenameDialog>("Rename", parameters);
        var result = await dialog.Result;
        if (result is not { Canceled: false, Data: string newName } || newName == node.Name)
        {
            return;
        }

        var etag = await GetETagAsync(node.Id);
        using var request = new HttpRequestMessage(HttpMethod.Put, $"api/documents/{node.Id}")
        {
            Content = JsonContent.Create(new { name = newName }),
        };
        if (etag is not null)
        {
            request.Headers.TryAddWithoutValidation("If-Match", etag);
        }

        var response = await Http.SendAsync(request);
        if (response.StatusCode == HttpStatusCode.Conflict)
        {
            Snackbar.Add($"A folder or document named '{newName}' already exists here.", Severity.Warning);
            return;
        }
        if (response.StatusCode == HttpStatusCode.Forbidden)
        {
            Snackbar.Add("You don't have permission to rename this item.", Severity.Warning);
            return;
        }
        if (response.StatusCode == HttpStatusCode.PreconditionFailed)
        {
            Snackbar.Add("This item changed since you loaded it — refresh and try again.", Severity.Warning);
            return;
        }
        if (!response.IsSuccessStatusCode)
        {
            Snackbar.Add("Could not rename the item.", Severity.Error);
            return;
        }

        Snackbar.Add($"Renamed to '{newName}'.", Severity.Success);
        await RefreshAsync();
    }

    private async Task DeleteAsync(BrowseNode node)
    {
        var message = node.IsFolder
            ? $"Delete the folder '{node.Name}' and everything inside it? It will be moved to the recycle bin."
            : $"Delete '{node.Name}'? It will be moved to the recycle bin.";
        var confirmed = await DialogService.ShowMessageBoxAsync(new MessageBoxOptions
        {
            Title = "Delete",
            Message = message,
            YesText = "Delete",
            CancelText = "Cancel",
        });
        if (confirmed != true)
        {
            return;
        }

        var etag = await GetETagAsync(node.Id);
        using var request = new HttpRequestMessage(HttpMethod.Delete, $"api/documents/{node.Id}");
        if (etag is not null)
        {
            request.Headers.TryAddWithoutValidation("If-Match", etag);
        }

        var response = await Http.SendAsync(request);
        if (response.StatusCode == HttpStatusCode.Forbidden)
        {
            Snackbar.Add("You don't have permission to delete this item.", Severity.Warning);
            return;
        }
        if (response.StatusCode == HttpStatusCode.PreconditionFailed)
        {
            Snackbar.Add("This item changed since you loaded it — refresh and try again.", Severity.Warning);
            return;
        }
        if (!response.IsSuccessStatusCode)
        {
            Snackbar.Add("Could not delete the item.", Severity.Error);
            return;
        }

        Snackbar.Add($"Deleted '{node.Name}'.", Severity.Success);
        if (_selectedItem?.Id == node.Id)
        {
            ClearDetail();
        }
        await RefreshAsync();
    }


    // Navigate the contents pane to a folder (from Go to / References / Search), optionally selecting an item.
    // Slice simplification: the tree isn't re-synced/expanded to the folder, matching the desktop.
    private async Task NavigateToFolderAsync(Guid folderId, Guid? selectItemId = null)
    {
        if (_activeTab != Tab.Repositories)
        {
            await SetTab(Tab.Repositories);
        }

        var name = await GetDocumentNameAsync(folderId) ?? "(folder)";
        await SelectFolderAsync(new BrowseNode(folderId, name, true, false, false));

        // Prefer the item's real row; fall back to its reference (shortcut) row when the folder holds only a
        // shortcut (a referencing folder) — selecting a reference loads the target document for viewing.
        if (selectItemId is { } id
            && (_folderContents.FirstOrDefault(n => n.Id == id && !n.IsReference)
                ?? _folderContents.FirstOrDefault(n => n.Id == id)) is { } target)
        {
            await SelectRowAsync(target);
        }

        StateHasChanged();
    }

    private async Task<string?> GetDocumentNameAsync(Guid id)
    {
        try
        {
            return (await Http.GetFromJsonAsync<DocNameResponse>($"api/documents/{id}"))?.Name;
        }
        catch (HttpRequestException)
        {
            return null;
        }
    }

    private async Task<string?> GetETagAsync(Guid id)
    {
        using var request = new HttpRequestMessage(HttpMethod.Head, $"api/documents/{id}");
        var response = await Http.SendAsync(request);
        return response.Headers.ETag?.Tag;
    }

