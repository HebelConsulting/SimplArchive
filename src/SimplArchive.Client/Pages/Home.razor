                <div class="wb-tab @(_activeTab == Tab.RecycleBin ? "wb-tab-active" : "")" title="@Strings.Get("TabRecycleBin")" aria-label="@Strings.Get("TabRecycleBin")" @onclick="() => SetTab(Tab.RecycleBin)">
                    <span class="wb-tab-ico"><MudIcon Icon="@Icons.Material.Filled.Delete" Size="Size.Small" /></span>
                    <span class="wb-tab-label">@Strings.Get("TabRecycleBin")</span>
                </div>
                <div class="wb-tab @(_activeTab == Tab.Tasks ? "wb-tab-active" : "")" title="@Strings.Get("TabTasks")" aria-label="@Strings.Get("TabTasks")" @onclick="() => SetTab(Tab.Tasks)">
                    <span class="wb-tab-ico">
                        <MudIcon Icon="@Icons.Material.Filled.Task" Size="Size.Small" />
