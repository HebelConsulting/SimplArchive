    // Tag chip editor + catalog autocomplete (ADR "Document tags"). SearchFunc suggests not-yet-added catalog
    // tags; Enter commits the box (a coerced free-form value or the highlighted suggestion).
    private Task<IEnumerable<string>> SearchTagCatalog(string value, CancellationToken ct)
    {
        var pool = _tagCatalog.Where(t => !_editTags.Contains(t));
        return Task.FromResult(string.IsNullOrWhiteSpace(value)
            ? pool
            : pool.Where(t => t.Contains(value.Trim(), StringComparison.OrdinalIgnoreCase)));
    }

    private void OnTagKeyUp(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or "NumpadEnter")
