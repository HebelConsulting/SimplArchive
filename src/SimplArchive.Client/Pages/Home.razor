    // Tenant-admin ribbon action (ADR 0274): convert every existing "current TIFF" document to a searchable
    // PDF — shows the pending count, confirms, then enqueues.
    private async Task RunTiffBackfillAsync()
    {
        int pending;
        try
        {
            pending = (await Http.GetFromJsonAsync<BackfillResponse>("api/searchable-pdf/backfill"))?.Count ?? 0;
        }
        catch (Exception)
        {
            Snackbar.Add("Could not check pending conversions.", Severity.Error);
            return;
        }

        if (pending == 0)
        {
            Snackbar.Add("No documents need conversion.", Severity.Info);
            return;
        }

        var confirmed = await DialogService.ShowMessageBoxAsync(new MessageBoxOptions
        {
            Title = "Convert scanned documents",
            Message = $"Queue {pending} scanned document(s) (TIFFs + scanned PDFs) for searchable-PDF conversion?",
            YesText = "Convert",
            CancelText = "Cancel",
        });
        if (confirmed != true)
        {
            return;
        }

        try
        {
            var resp = await Http.PostAsync("api/searchable-pdf/backfill", null);
            if (resp.IsSuccessStatusCode)
            {
                var count = (await resp.Content.ReadFromJsonAsync<BackfillResponse>())?.Count ?? 0;
                Snackbar.Add($"Queued {count} document(s) for searchable-PDF conversion.", Severity.Success);
            }
            else
            {
                Snackbar.Add(resp.StatusCode == HttpStatusCode.Forbidden ? "You don't have permission to do that." : "Could not start the conversion.", Severity.Warning);
            }
        }
        catch (Exception)
        {
            Snackbar.Add("Could not start the conversion.", Severity.Error);
        }
    }

