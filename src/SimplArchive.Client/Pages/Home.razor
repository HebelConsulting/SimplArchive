    private string _searchStatus = "";
    private bool _searching;

    // Refinement panel (ADR "Search-refinement UI").
    private bool _filtersExpanded;
    private bool _searchMetadataLoaded;
    private Guid? _searchRepositoryId;                       // null = all repositories
    private List<SearchRepoOption> _searchRepos = [];
    private List<SearchFieldOption> _availableFields = [];
    private DateTime? _docDateFrom, _docDateTo, _createdFrom, _createdTo;
    private string _createdBy = "";
    private List<FieldFilterRow> _fieldFilters = [];

    private sealed class FieldFilterRow
    {
        public string FieldName { get; set; } = "";
        public int DataType { get; set; }
        public string Operator { get; set; } = "";
        public string Value { get; set; } = "";
        public DateTime? DateValue { get; set; }
    }

    private record SearchFieldOption(string Name, int DataType);
    private record SearchRepoOption(Guid Id, string Name);

    // FieldDataType: Text=0, Number=1, Date=2, Boolean=3, SingleSelect=4, MultiSelect=5.
    private static IReadOnlyList<(string Value, string Label)> OperatorsFor(int dataType) => dataType switch
    {
        1 => [("eq", "="), ("gt", ">"), ("gte", "≥"), ("lt", "<"), ("lte", "≤")],
        2 => [("eq", "on"), ("gte", "on/after"), ("lte", "on/before"), ("gt", "after"), ("lt", "before")],
        3 => [("eq", "is")],
        4 or 5 => [("eq", "is"), ("in", "is any of")],
        _ => [("contains", "contains"), ("eq", "equals")],
    };

    private async Task LoadSearchMetadataAsync()
    {
        try
        {
            var fields = await Http.GetFromJsonAsync<SearchFieldsResponse>("api/search/fields");
            _availableFields = (fields?.Fields ?? []).Select(f => new SearchFieldOption(f.Name, f.DataType)).ToList();

            var repos = new List<SearchRepoOption>();
            var url = "api/repositories";
            while (url is not null)
            {
                var page = await Http.GetFromJsonAsync<RepositoryListResponse>(url);
                repos.AddRange((page?.Repositories ?? []).Select(r => new SearchRepoOption(r.Id, r.Name)));
                url = RelativeHref(page?.Links, "next");
            }
            _searchRepos = repos;
            _searchMetadataLoaded = true;
        }
        catch (Exception)
        {
            // Non-fatal — the free-text/system filters still work without the field picker.
        }
    }

    private void AddFieldFilter()
    {
        var first = _availableFields.FirstOrDefault();
        var row = new FieldFilterRow { FieldName = first?.Name ?? "", DataType = first?.DataType ?? 0 };
        row.Operator = OperatorsFor(row.DataType)[0].Value;
        _fieldFilters.Add(row);
    }

    private void OnFieldFilterFieldChanged(FieldFilterRow row, string fieldName)
    {
        row.FieldName = fieldName;
        row.DataType = _availableFields.FirstOrDefault(f => f.Name == fieldName)?.DataType ?? 0;
        row.Operator = OperatorsFor(row.DataType)[0].Value;
        row.Value = "";
        row.DateValue = null;
    }

    private void ClearFilters()
    {
        _searchRepositoryId = null;
        _docDateFrom = _docDateTo = _createdFrom = _createdTo = null;
        _createdBy = "";
        _fieldFilters = [];
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await RunSearchAsync();
        }
    }

    private async Task RunSearchAsync()
    {
        var query = _searchQuery.Trim();
        var parameters = new List<string>();

        if (query.Length > 0)
        {
            parameters.Add($"q={Uri.EscapeDataString(query)}");
        }

        if (_searchRepositoryId is { } repositoryId)
        {
            parameters.Add($"repositoryId={repositoryId}");
        }

        AddDateParam(parameters, "documentDate", "gte", _docDateFrom);
        AddDateParam(parameters, "documentDate", "lte", _docDateTo);
        AddDateParam(parameters, "createdAt", "gte", _createdFrom);
        AddDateParam(parameters, "createdAt", "lte", _createdTo);
        if (!string.IsNullOrWhiteSpace(_createdBy))
        {
            parameters.Add($"system[createdBy][contains]={Uri.EscapeDataString(_createdBy.Trim())}");
        }

        foreach (var row in _fieldFilters)
        {
            var value = row.DataType == 2 ? row.DateValue?.ToString("yyyy-MM-dd") ?? "" : row.Value.Trim();
            if (string.IsNullOrEmpty(row.FieldName) || string.IsNullOrEmpty(value))
            {
                continue;
            }

            parameters.Add($"fields[{Uri.EscapeDataString(row.FieldName)}][{row.Operator}]={Uri.EscapeDataString(value)}");
        }

        // Active facet drill-downs (ADR "Search facet refinements"): each dimension's selected values become an
        // `in` filter (OR within the dimension); the server keeps each dimension open (post-filter faceting).
        AddFacetParam(parameters, "system[documentType][in]", _facetTypes);
        AddFacetParam(parameters, "system[fileType][in]", _facetFileTypes);
        AddFacetParam(parameters, "system[createdBy][in]", _facetCreatedBy);
        AddFacetParam(parameters, "system[documentYear][in]", _facetYears);
        AddFacetParam(parameters, "system[tag][in]", _facetTags);
        AddFacetParam(parameters, "system[sensitivityLabel][in]", _facetSensitivity);
        foreach (var (field, set) in _facetFields)
        {
            AddFacetParam(parameters, $"fields[{Uri.EscapeDataString(field)}][in]", set);
        }

        // Nothing to search on (no text and no filters) — clear.
        if (parameters.Count == 0)
        {
            _searchResults = [];
            _searchFacets = null;
            _searchStatus = "";
            return;
        }

        _lastSearchQueryString = string.Join("&", parameters); // for "Save search" (ADR "Saved searches")
        await ExecuteSearchAsync(_lastSearchQueryString);
    }

    // Appends `key=v1,v2` (comma-joined, escaped) when the facet set is non-empty (ADR "Search facet refinements").
    private static void AddFacetParam(List<string> parameters, string key, HashSet<string> values)
    {
        if (values.Count > 0)
        {
            parameters.Add($"{key}={string.Join(",", values.Select(Uri.EscapeDataString))}");
        }
    }

    // Runs a pre-assembled query-params string (shared by the refinement search + a restored saved search).
    private async Task ExecuteSearchAsync(string queryParams)
    {
        _searching = true;
        _searchStatus = "Searching…";
        try
        {
            var results = new List<SearchHit>();
            var url = $"api/search?{queryParams}";
            var first = true;
            while (url is not null)
            {
                var page = await Http.GetFromJsonAsync<SearchResponse>(url);
                results.AddRange(page?.Results ?? []);
                if (first) { _searchFacets = page?.Facets; first = false; } // facets are the same across pages
                url = RelativeHref(page?.Links, "next");
            }
            _searchResults = results;
            _searchStatus = results.Count == 0 ? "No matches." : $"{results.Count} result(s).";
        }
        catch (Exception)
        {
            _searchStatus = "Search failed — check the filter values.";
        }
        finally
        {
            _searching = false;
        }
    }

    private static void AddDateParam(List<string> parameters, string field, string op, DateTime? value)
    {
        if (value is { } date)
        {
            parameters.Add($"system[{field}][{op}]={date:yyyy-MM-dd}");
        }
    }

    private async Task OpenSearchResultAsync(SearchHit hit)
    {
        if (hit.IsFolder)
        {
            await NavigateToFolderAsync(hit.Id);
        }
        else if (hit.ParentId is { } parentId)
        {
            await NavigateToFolderAsync(parentId, hit.Id);
        }
        else
        {
            await NavigateToFolderAsync(hit.Id);
        }
    }

    // ---- Upload orchestration (called from dropUpload.js) --------------------------------------------

    public record UploadTarget(string DocumentId, string VersionId, string UploadUrl);

    [JSInvokable]
    public Task OnUploadsStartingAsync(int count)
    {
        _uploading = true;
        StateHasChanged();
        return Task.CompletedTask;
    }

    // Called from dropUpload.js before each upload with the file's SHA-256 (ADR "Duplicate document detection").
    // Checks for an identical existing document; if found, shows the reference/file-anyway/cancel modal. Returns
    // "file" (upload normally), "referenced" (a shortcut was created instead — skip), or "cancel" (skip).
    [JSInvokable]
    public async Task<string> PrepareUploadAsync(string folderId, string hash, string fileName)
    {
        try
        {
            var resp = await Http.GetFromJsonAsync<DuplicatesResponse>($"api/duplicates?hash={hash}");
            var dups = resp?.Duplicates ?? [];
            if (dups.Count == 0)
            {
                return "file";
            }

            var parameters = new DialogParameters
            {
                ["FileName"] = fileName,
                ["Duplicates"] = dups.Select(d => (d.Id, d.Name, d.Path)).ToList(),
            };
            var result = await (await DialogService.ShowAsync<Dialogs.DuplicateUploadDialog>("Duplicate document", parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true })).Result;
            if (result is not { Canceled: false } || result.Data is not Dialogs.DuplicateUploadDialog.DuplicateUploadChoice choice)
            {
                return "cancel";
            }

            if (choice.Action == "reference" && Guid.TryParse(folderId, out var folderGuid))
            {
                var refResp = await Http.PostAsJsonAsync($"api/documents/{folderGuid}/references", new { targetId = choice.TargetId });
                if (refResp.IsSuccessStatusCode)
                {
                    Snackbar.Add($"Referenced the existing document instead of uploading '{fileName}'.", Severity.Success);
                }
                else if (refResp.StatusCode == HttpStatusCode.Conflict)
                {
                    Snackbar.Add("A reference to that document already exists in this folder.", Severity.Warning);
                }
                else
                {
                    Snackbar.Add("Could not create the reference.", Severity.Error);
                }

                return "referenced";
            }

            return choice.Action == "file" ? "file" : "cancel";
        }
        catch (Exception)
        {
            // If the check fails, don't block the upload — fall through to the normal path.
            return "file";
        }
    }

    private record DuplicatesResponse { public List<DuplicateDto> Duplicates { get; set; } = []; }
    private record DuplicateDto { public Guid Id { get; set; } public string Name { get; set; } = ""; public string Path { get; set; } = ""; }

    [JSInvokable]
    public async Task<UploadTarget?> CreateUploadTargetAsync(string folderId, string fileName)
    {
        try
        {
            // Document.Name is the bare stem; the extension goes on the version's object key via fileExtension
            // (ADR "Extension off Document.Name, derived from the object key").
            var stem = System.IO.Path.GetFileNameWithoutExtension(fileName);
            var extension = System.IO.Path.GetExtension(fileName);

            var create = await Http.PostAsJsonAsync($"api/documents/{folderId}/children", new { name = stem });
            if (create.StatusCode == HttpStatusCode.Conflict)
            {
                Snackbar.Add($"'{fileName}': a document with that name already exists here.", Severity.Warning);
                return null;
            }
            if (create.StatusCode == HttpStatusCode.Forbidden)
            {
                Snackbar.Add($"'{fileName}': you don't have permission to upload here.", Severity.Warning);
                return null;
            }
            create.EnsureSuccessStatusCode();
            var created = await create.Content.ReadFromJsonAsync<DocumentSummary>();

            var versionResponse = await Http.PostAsJsonAsync($"api/documents/{created!.Id}/versions", new { fileExtension = extension });
            versionResponse.EnsureSuccessStatusCode();
            var version = await versionResponse.Content.ReadFromJsonAsync<CreateVersionResponse>();

            return new UploadTarget(created.Id.ToString(), version!.Id.ToString(), version.UploadUrl);
        }
        catch (Exception)
        {
            Snackbar.Add($"'{fileName}': upload could not be started.", Severity.Error);
            return null;
        }
    }

    [JSInvokable]
    public async Task FinalizeUploadAsync(string documentId, string versionId, string fileName, string? comment)
    {
        try
        {
            // The filing comment is the version's "why this revision" note (ADR 0528) — set on the version at
            // finalize (the drop-upload created it first), not posted to the chat feed as it used to be.
            var versionComment = string.IsNullOrWhiteSpace(comment) ? null : comment.Trim();
            (await Http.PutAsJsonAsync($"api/documents/{documentId}/versions/{versionId}", new { comment = versionComment })).EnsureSuccessStatusCode();

            // The server assigns the mask at finalize (eMail for .eml/.msg, else Basic Entry) — see ADR
            // "Email auto-classification"; the client no longer classifies.

            Snackbar.Add($"Uploaded '{fileName}'.", Severity.Success);
        }
        catch (Exception)
        {
            Snackbar.Add($"'{fileName}': the upload was stored but could not be finalized.", Severity.Error);
        }
    }

    // ---- List-pane drop filing (ADR "List-pane drop filing") ---------------------------------------------
    // Dropping OS files onto a document row (data-drop-doc) shows the inbox-style filing dialog and, per the
    // choice, files as a new version of that document or as new documents in a folder (with an optional comment).

    public record DocumentDropDecision(string Mode, string? FolderId, string? Comment);

    [JSInvokable]
    public async Task<DocumentDropDecision?> BeginDocumentDropAsync(string documentId, int fileCount)
    {
        if (!Guid.TryParse(documentId, out var docId))
        {
            return null;
        }

        // The dropped-on document is a child of the currently-open folder — that's the "in folder" target.
        var docName = _folderContents.FirstOrDefault(n => n.Id == docId)?.Name ?? "document";
        var parameters = new DialogParameters<FilingDialog>
        {
            { x => x.DocumentId, fileCount > 1 ? null : (Guid?)docId },
            { x => x.DocumentName, fileCount > 1 ? null : docName },
            { x => x.FolderId, _selectedFolder?.Id },
            { x => x.FolderName, _selectedFolder?.Name },
            { x => x.Bulk, fileCount > 1 },
        };
        var dialog = await DialogService.ShowAsync<FilingDialog>(fileCount > 1 ? $"File {fileCount} files" : $"File '{docName}'", parameters);
        var result = await dialog.Result;
        if (result is not { Canceled: false, Data: FilingDialog.FilingChoice choice })
        {
            return null;
        }

        return choice.Mode == FilingDialog.FilingMode.AsVersion
            ? new DocumentDropDecision("version", null, choice.Comment)
            : new DocumentDropDecision("folder", choice.TargetId.ToString(), choice.Comment);
    }

    [JSInvokable]
    public async Task<UploadTarget?> CreateVersionTargetAsync(string documentId, string fileName)
    {
        try
        {
            var extension = System.IO.Path.GetExtension(fileName);
            var versionResponse = await Http.PostAsJsonAsync($"api/documents/{documentId}/versions", new { fileExtension = extension });
            if (versionResponse.StatusCode == HttpStatusCode.Conflict)
            {
                Snackbar.Add($"'{fileName}': the document is checked out or under a legal hold.", Severity.Warning);
                return null;
            }
            if (versionResponse.StatusCode == HttpStatusCode.Forbidden)
            {
                Snackbar.Add($"'{fileName}': you don't have permission to add a version here.", Severity.Warning);
                return null;
            }
            versionResponse.EnsureSuccessStatusCode();
            var version = await versionResponse.Content.ReadFromJsonAsync<CreateVersionResponse>();
            return new UploadTarget(documentId, version!.Id.ToString(), version.UploadUrl);
        }
        catch (Exception)
        {
            Snackbar.Add($"'{fileName}': a new version could not be started.", Severity.Error);
            return null;
        }
    }

    [JSInvokable]
    public async Task FinalizeVersionAsync(string documentId, string versionId, string fileName, string? comment)
    {
        try
        {
            // The check-in comment is the new version's "why this revision" note (ADR 0528) — set on the version
            // at finalize, not posted to the chat feed.
            var versionComment = string.IsNullOrWhiteSpace(comment) ? null : comment.Trim();
            (await Http.PutAsJsonAsync($"api/documents/{documentId}/versions/{versionId}", new { comment = versionComment })).EnsureSuccessStatusCode();

            Snackbar.Add($"Filed '{fileName}' as a new version.", Severity.Success);
        }
        catch (Exception)
        {
            Snackbar.Add($"'{fileName}': the version was stored but could not be finalized.", Severity.Error);
        }
    }

    [JSInvokable]
    public async Task OnDocumentVersionsFiledAsync(string documentId)
    {
        // Reload the current folder listing, and refresh the detail/preview if the target was still selected.
        // Capture the selection first — SelectFolderAsync clears it (ClearDetail), so we re-select afterward.
        var keepSelectedId = _selectedItem?.Id;
