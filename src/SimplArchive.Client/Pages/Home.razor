    // Check out a document (take the exclusive edit lock) from the Repositories row menu.
    private async Task CheckOutAsync(BrowseNode node)
    {
        try
        {
            var resp = await Http.PutAsync($"api/documents/{node.Id}/checkout", null);
            if (resp.StatusCode == System.Net.HttpStatusCode.Conflict) { Snackbar.Add(Strings.Get("CoErrAlreadyOut"), Severity.Warning); return; }
            if (resp.StatusCode == System.Net.HttpStatusCode.Forbidden) { Snackbar.Add(Strings.Get("CoErrNoPermission"), Severity.Error); return; }
            resp.EnsureSuccessStatusCode();
            Snackbar.Add(string.Format(Strings.Get("CoOkCheckedOut"), node.Name), Severity.Success);
            await ReloadCurrentFolderAsync();
            await LoadCheckoutsAsync();
        }
        catch (Exception) { Snackbar.Add(Strings.Get("CoErrCheckOut"), Severity.Error); }
    }

    // Force-release another user's lock (a CanOverrideCheckout holder).
    private async Task OverrideCheckoutAsync(BrowseNode node)
    {
        if (!await Confirm(string.Format(Strings.Get("CoConfirmOverride"), node.Name, node.CheckedOutByName), Strings.Get("CoOverride"))) return;
        try
        {
            (await Http.DeleteAsync($"api/documents/{node.Id}/checkout")).EnsureSuccessStatusCode();
            Snackbar.Add(string.Format(Strings.Get("StReleasedCheckout"), node.Name), Severity.Success);
            await ReloadCurrentFolderAsync();
        }
        catch (Exception) { Snackbar.Add(Strings.Get("CoErrOverride"), Severity.Error); }
    }

    private async Task ReloadCurrentFolderAsync()
    {
        if (_selectedFolder is { } sf)
        {
            _folderContents = await OpenFolderContentsAsync(sf);
        }
    }

    private async Task<bool> Confirm(string message, string yes) =>
        await DialogService.ShowMessageBoxAsync(new MessageBoxOptions { Title = yes, Message = message, YesText = yes, CancelText = "Cancel" }) == true;

    // ---- Tree + list navigation ----------------------------------------------------------------------

    // Rebuilds the tree's roots and re-renders the pane. The nodes live in the injected TreeState (they must
    // outlive the pane, which is disposed on every tab switch), so refreshing them is two steps: reload the
    // service, then tell the component — a change in a service is invisible to a component until it is.
    private async Task ReloadTreeAsync()
    {
        await Tree.ReloadAsync(_isTenantAdmin);
        _treePane?.Refresh();
    }

    // Reads a folder's contents for the CONTENTS PANE: the rows, plus the folder's persisted order adopted as
    // this listing's default (which also clears any ephemeral header sort — ADR "Per-folder contents sort
    // order"). A tree-child load wants the rows only, and calls the service directly.
    private async Task<List<BrowseNode>> OpenFolderContentsAsync(BrowseNode folder)
    {
        var contents = await Browse.LoadContentsAsync(folder.Id, folder.RepositoryId, BrowseService.ChildrenHrefOf(folder));
        _folderSortOrder = contents.SortOrder ?? _folderSortOrder;
        _headerSortActive = false;
        return contents.Nodes;
    }

    // Makes the whole contents pane a drop target for the currently-selected folder.
    private Dictionary<string, object> ListDropAttributes()
        => _selectedFolder is { } folder ? new() { ["data-drop-folder"] = folder.Id.ToString() } : BrowseService.EmptyAttributes;

    // Selecting a folder (tree click or drilling into a folder row) lists its contents in the middle pane.
    private async Task SelectFolderAsync(BrowseNode? folder)
    {
        _treeDrawerOpen = false; // phone: navigating a folder closes the tree drawer (no-op on desktop)
        // The synthetic Administration/Users nodes (ADR "Tenant-admin Administration → Users view") aren't real
        // folders — clicking them just expands; a user's personal repo node (a real repo id) browses normally.
        if (folder is { AdminKind: not "" })
        {
            return;
        }

        // The Inbox / Check-out launcher nodes under Personal switch to their bottom tab (ADR "GUI-tree Personal
        // space grouping"); the personal-root node itself browses like any repository (falls through).
        if (folder is { PersonalKind: "inbox" })
        {
            await SetTab(Tab.Inbox);
            return;
        }

        if (folder is { PersonalKind: "checkout" })
        {
            await SetTab(Tab.Checkout);
            return;
        }

        _archiveDocument = null; // leave any archive-browsing view
        _selectedFolder = folder;
        _currentRepositoryId = folder?.RepositoryId ?? Guid.Empty;
        ClearDetail();
        _folderContents = folder is null ? [] : (await Browse.LoadContentsAsync(folder.Id, folder.RepositoryId, BrowseService.ChildrenHrefOf(folder))).Nodes;

        // A folder has its own comment thread, and — since issue #408 — its own detail pane: the same one a
        // document gets, because a folder is a Document with a mask and index data of its own.
        if (folder is not null)
        {
            _commentTarget = folder;
            await LoadDetailForAsync(folder);
            await LoadFolderSubscriptionAsync(folder);
            await LoadCommentsAsync(folder);
        }
    }

    // Single click only ever *selects* the row (never navigates), so e.g. a document's Download button
    // enables. A document loads its index-data/preview; a folder is selected (highlighted, its comments
    // shown) without opening — only a double click drills into it (OnRowDoubleClickAsync).
    // Native multi-selection (ADR "Bulk actions on selected documents") — no checkboxes: Ctrl/Cmd-click toggles
    // a row into the bulk set, Shift-click range-selects from the anchor, a plain click clears the set and
    // single-selects (the existing detail-pane behavior). When ≥2 rows are selected a bulk-action bar appears.
    private async Task OnRowClickAsync(BrowseNode node, Microsoft.AspNetCore.Components.Web.MouseEventArgs e)
    {
        if (e.CtrlKey || e.MetaKey)
        {
            if (!_bulkIds.Remove(node.Id))
            {
                _bulkIds.Add(node.Id);
                if (_bulkIds.Count == 1 && _bulkAnchorId is { } prior && prior != node.Id)
                {
                    _bulkIds.Add(prior); // fold the previously single-selected row into the multi-selection
                }
            }

            _bulkAnchorId = node.Id;
            StateHasChanged();
            return;
        }

        if (e.ShiftKey && _bulkAnchorId is { } anchorId)
        {
            var order = _folderContents.Select(n => n.Id).ToList();
            var a = order.IndexOf(anchorId);
            var b = order.IndexOf(node.Id);
            if (a >= 0 && b >= 0)
            {
                for (var i = Math.Min(a, b); i <= Math.Max(a, b); i++)
                {
                    _bulkIds.Add(order[i]);
                }
            }

            StateHasChanged();
            return;
        }

        // Phone: a single tap navigates (there's no side-by-side detail) — a folder / doc-with-children / zip
        // drills in; a leaf document opens the full-screen detail overlay.
        if (_isPhone)
        {
            if (node.IsFolder || node.HasChildren || (node.HasVersions && node.FileExtension.Equals(".zip", StringComparison.OrdinalIgnoreCase)))
            {
                await OnRowDoubleClickAsync(node);
            }
            else
            {
                _phoneDetailTab = "preview";
                await SelectRowAsync(node);
            }
            return;
        }

        await SelectRowAsync(node);
    }

    // Plain single-select (clears any bulk multi-selection) — the row's default behavior, also used by
    // programmatic navigation (go-to / search result).
    private async Task SelectRowAsync(BrowseNode node)
    {
        _bulkIds.Clear();
        _bulkAnchorId = node.Id;
        if (node.HasVersions)
        {
            await SelectItemAsync(node);
        }
        else
        {
            await SelectContentFolderAsync(node);
        }
    }

    private readonly HashSet<Guid> _bulkIds = [];
    private Guid? _bulkAnchorId;

    // Double click drills into any node that has children — a folder, or a document that has child documents
    // (an email with filed attachments, ADR "Email attachments as child documents"), listing its contents.
    // On a childless document it's a no-op — the single click already selected it.
    private async Task OnRowDoubleClickAsync(BrowseNode node)
    {
        if (node.HasVersions && node.FileExtension.Equals(".zip", StringComparison.OrdinalIgnoreCase))
        {
            await EnterArchiveAsync(node);
        }
        else if (node.IsFolder || node.HasChildren)
        {
            await SelectFolderAsync(node);
        }
    }

    // Browse a .zip's entries virtually — read on demand from the stored archive, nothing unpacked (ADR
    // "Zip file browsing"). The parent folder listing (_folderContents) is left in place so Exit returns to it.
    private async Task EnterArchiveAsync(BrowseNode zip)
    {
        try
        {
            // The resource advertises archive-entries only for a zip (#416) — follow it rather than compose.
            var response = await Http.GetFromJsonAsync<ArchiveEntriesResponse>(await FetchDocumentRelAsync(zip.Id, "archive-entries"));
            _archiveEntries = (response?.Entries ?? [])
                .Select(e => new ArchiveEntryRow(e.Name, e.Path, e.Size,
                    e.Links?.FirstOrDefault(l => l.Rel == "download")?.Href?.TrimStart('/') ?? ""))
                .ToList();
            _archiveDocument = zip;
        }
        catch (Exception)
        {
            Snackbar.Add(string.Format(Strings.Get("StErrReadZip"), zip.Name), Severity.Error);
        }
    }

    private void ExitArchiveAsync()
    {
        _archiveDocument = null;
        _archiveEntries = [];
    }

    // Download one archive entry: the Api proxies the bytes (entries aren't storage objects), so fetch with
    // the authenticated client and hand the blob to the browser to save.
    private async Task DownloadArchiveEntryAsync(ArchiveEntryRow entry)
    {
        try
        {
            var bytes = await Http.GetByteArrayAsync(entry.DownloadHref);
            using var stream = new MemoryStream(bytes);
            using var streamRef = new DotNetStreamReference(stream);
            await JS.InvokeVoidAsync("downloadFileFromStream", entry.Name, streamRef);
        }
        catch (Exception)
        {
            Snackbar.Add(string.Format(Strings.Get("StErrDownloadEntry"), entry.Name), Severity.Error);
        }
    }

    // Select a folder shown in the contents list without opening it: highlight it and show its comment
    // thread, but leave the current listing (_selectedFolder/_folderContents) in place, and clear any
    // document detail so the index/preview panes fall back to their placeholder.
    private async Task SelectContentFolderAsync(BrowseNode folder)
    {
        ClearDetail();
        _commentTarget = folder;
        // The selected folder WINS over the open one: the pane follows the selection exactly as it does for a
        // document row, so a child folder's metadata is editable without navigating into it (issue #408).
        await LoadDetailForAsync(folder);
        await LoadFolderSubscriptionAsync(folder);
        await LoadCommentsAsync(folder);
    }

    private async Task SelectItemAsync(BrowseNode item)
    {
        ClearDetail();
        _selectedItem = item;
        _commentTarget = item;
        await LoadDetailForAsync(item);
    }

    // Fills the detail pane for whatever it is describing — a document row, a folder row, or the open folder.
    // ONE loader for all three, because they now render one pane (issue #408): a folder IS a Document with a mask,
    // so every endpoint below applies to it unchanged. It was the pane, not the data, that used to differ.
    private async Task LoadDetailForAsync(BrowseNode item)
    {
        _detailNode = item;

        // A drag of the detail pane lasts only until the SELECTION changes (ADR 0550) — which is now, and is
        // exactly when the fitted height would move anyway. Wrapped like every other interop here: a stale
        // cached module must degrade quietly rather than take the pane down with it (ADR 0500).
        if (_layoutModule is not null)
        {
            try { await _layoutModule.InvokeVoidAsync("resetIndexSizing"); }
            catch (JSException) { }
            catch (JSDisconnectedException) { }
        }

        // Set unconditionally, unlike the version-derived fields: a folder has a name to show but no version to
        // derive one from, which is exactly why it used to fall out of this pane entirely.
        _sysName = _origName = item.Name;

        try
        {
            // The document resource first: it carries the computed retention schedule (ADR "Retention policies"),
            // the sensitivity label (ADR "Data classification"), AND the rels for everything else this pane
            // loads — so the calls below follow advertised addresses instead of composing them (ADR 0543, #416).
            // Fetched before the others rather than after, which is the only change needed to make them follow.
            // DocumentAddress, not `self`: on a REPOSITORY row `self` is the repository view, whose rels are a
            // different set — reading it here silently cost the pane its document rels (contents-sort-order
            // among them). ADR 0200 says a repository IS a document; only the server can say at which address.
            if (DocumentActions.DocumentAddress(item) is not { } detailSelfHref)
            {
                return;
            }

            var detail = await Http.GetFromJsonAsync<DocumentDetailResponse>(detailSelfHref);
            _detailLinks = Links.RelMap(detail?.Links);

            _detailMaskId = null;
            // mask + index-data come from the ROW's own rels — the listing advertises them, so no second fetch.
            var mask = await Http.GetFromJsonAsync<MaskResponse>(RowOrDetailHref(item, "mask"));
            _detailMaskName = mask?.Name;
            _detailMaskId = mask?.MaskId;
            _detailVersionNumber = mask?.VersionNumber;

            var index = await Http.GetFromJsonAsync<IndexDataResponse>(RowOrDetailHref(item, "index-data"));
            _detailIndexData = index?.Fields ?? [];

            // Free-form tags (ADR "Document tags") — advertised on the resource, not on a listing row.
            _detailTags = (await Http.GetFromJsonAsync<TagsResponse>(DetailHref("tags")))?.Tags ?? [];
            _detailRetention = detail?.Retention;
            _detailSensitivityId = detail?.SensitivityLabelId;
            _detailSensitivityName = detail?.SensitivityLabelName ?? "";
            _detailSensitivityColor = detail?.SensitivityLabelColor;
            _detailSensitivityWatermark = detail?.SensitivityWatermark ?? false;
            _detailCanManagePermissions = detail?.CanManagePermissions ?? false;
            _detailBreaksInheritance = detail?.BreaksInheritance ?? false;
            // A FOLDER's own contents order, which now travels with its details — the pane for a child folder is
            // opened from its parent's listing, where the child's setting was never fetched (issue #408).
            _detailSortOrder = detail?.ContentsSortOrder ?? FolderContentsSortOrder.Name;
            // Captured from the resource's own rel (ADR 0543/0546) — the external-links dialog takes the href
            // rather than composing one, and its absence simply means the affordance isn't offered.
            _detailExternalLinksHref = Links.Href(detail?.Links, "external-links");
            if (_sensitivityLabels.Count == 0)
            {
                await LoadSensitivityLabelsAsync();
            }

            // Whether the current user follows this document (ADR "Document subscriptions").
            var sub = await Http.GetFromJsonAsync<SubscriptionResponse>(DetailHref("subscription"));
            _detailSubscribed = sub?.Subscribed ?? false;

            var versions = await Http.GetFromJsonAsync<VersionListResponse>(DetailHref("versions"));
            var confirmed = versions?.Versions?.Where(v => v.Status == "Confirmed").ToList() ?? [];
            var latest = VersionListResponse.PickCurrent(confirmed, versions?.CurrentVersionId);
            string? textLayoutUrl = null;
            string? previewUrl = null;
            var converted = false;
            if (latest is not null)
            {
                previewUrl = Http.Absolute(Links.Href(latest.Links, "preview"));
                _downloadUrl = Http.Absolute(Links.Href(latest.Links, "download"));
                converted = latest.PreviewConverted;
                textLayoutUrl = Links.Href(latest.Links, "text-layout");
                _pvAnnotationsUrl = Links.Href(latest.Links, "annotations");
            }

            DeriveSystemFields(item, confirmed, versions?.CurrentVersionId);
            // The pane may not EXIST yet: @ref is assigned after a render, and the two ways a document is
            // opened from elsewhere — a search hit, a notification — call SetTab(Repositories) and select in the
            // same synchronous run, with no render in between. Rendering straight into a null ref would lose the
            // preview silently on exactly those paths, so defer to OnAfterRenderAsync when it is not there yet.
            await ShowPreviewAsync(previewUrl, textLayoutUrl, converted, latest is not null);
        }
        catch (HttpRequestException)
        {
            _detailIndexData ??= [];
        }
        catch (InvalidOperationException)
        {
            // A rel this pane expected was not advertised. Degrade the PANE — never let it escape: this runs on
            // a render path, so an unhandled exception blanks the whole workbench, list and tree included, not
            // just the part that could not load. That is exactly what happened when tree roots were built
            // without their links (#416): one missing rel took the entire page down.
            _detailIndexData ??= [];
        }

        await LoadCommentsAsync(item);
    }

    private void ClearDetail()
    {
        _selectedItem = null;
        _detailNode = null;
        _detailMaskName = null;
        _detailVersionNumber = null;
        _detailIndexData = null;
        _detailTags = null;
        _downloadUrl = null;
        ClearPreviewPane();
        _commentTarget = null;
        _comments = [];
        _replyingTo = null;
        _newComment = "";
        _replyText = "";

        _isEditing = false;
        _sysHasVersion = false;
        _sysCurrentVersionId = Guid.Empty;
        _sysCurrentVersion = null;
        _detailVersionCount = 0;
        _sysName = "";
        _sysFileExtension = "";
        _sysDocumentDate = null;
        _sysCreated = "";
        _sysCreatedBy = "";
        _sysHasTiff = false;
        _sysOcrCodes = [];
        _detailRetention = null;
        _detailSubscribed = false;
        _editFields.Clear();
        _availableMasks = [];
    }

    // Open the reminder (Wiedervorlage) dialog for the selected document (ADR "Document reminders").
    private string? _detailExternalLinksHref;

    // External links (ADR 0546) — sharing this document with someone who has no account. Offered only when the
    // server advertised the rel; a document that cannot be shared simply has no link to follow.
    private async Task OpenExternalLinksDialogAsync()
    {
        if (_selectedItem is not { } item || _detailExternalLinksHref is not { } href)
        {
            return;
        }

        var parameters = new DialogParameters
        {
            ["DocumentId"] = item.Id,
            ["DocumentName"] = _sysName,
            ["LinksHref"] = href,
        };
        await DialogService.ShowAsync<Dialogs.ExternalLinksDialog>(Strings.Get("ExtLinkTitle"), parameters);
    }

    // The cross-document list, reached from the ribbon. Its href comes from the API ROOT rather than a document —
    // "everything I have shared" is not a property of whatever happens to be selected (ADR 0543/0546). The rel's
    // ABSENCE is meaningful: it means the feature is not available here, so the ribbon button is not drawn.
    private async Task LoadMyExternalLinksHrefAsync()
    {
        try
        {
            var root = await Http.GetFromJsonAsync<RootResponse>("api");
            _myExternalLinksHref = Links.Href(root?.Links, "externalLinks");
        }
        catch (Exception)
        {
            _myExternalLinksHref = null;
        }
    }

    private sealed record RootResponse { public List<LinkResponse> Links { get; set; } = []; }
    // The cross-document list, reached from the ribbon. Its href comes from the API ROOT rather than a document —
    // "everything I have shared" is not a property of whatever happens to be selected (ADR 0543/0546).
    private string? _myExternalLinksHref;

    private async Task OpenMyExternalLinksAsync()
    {
        if (_myExternalLinksHref is not { } href)
        {
            return;
        }

        // The directory the dialog's admin filters need. Read here, when the dialog is opened, rather than
        // borrowed from the Users & groups tab's cache: that tab owns its own state now (ADR 0558), and the
        // old arrangement meant the filters appeared only if the admin happened to have visited it first —
        // order dependence dressed up as a saved request. Two reads on a deliberate user action; empty is
        // still fine, because the server refuses the cross-user query regardless of what this list contains.
        var (users, groups) = await LoadPrincipalDirectoryAsync();

        var parameters = new DialogParameters
        {
            ["LinksHref"] = href,
            ["Users"] = users,
            ["Groups"] = groups,
        };

        // Wide enough for four data columns plus three row actions (issue #410). Without this the DIALOG is the
        // clipping box — the content can be as wide as it likes and Revoke still falls off its right edge.
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<Dialogs.MyExternalLinksDialog>(Strings.Get("ExtLinkMyLinks"), parameters, options);

        // "Go to" closes the dialog and hands back a document: navigating belongs to the workbench, which owns the
        // tree and list panes, not to a dialog that cannot see them.
        if ((await dialog.Result)?.Data is Dialogs.MyExternalLinksDialog.GoToDocument target)
        {
            await NavigateToDocumentAsync(target.DocumentId, target.ParentId);
        }
    }

    private async Task OpenReminderDialogAsync()
    {
        if (_selectedItem is not { } item)
        {
            return;
        }

        var parameters = new DialogParameters
        {
            ["DocumentId"] = item.Id,
            ["DocumentName"] = _sysName,
            ["RemindersHref"] = _detailLinks?.GetValueOrDefault("reminders"),
        };
        await DialogService.ShowAsync<Dialogs.ReminderDialog>(Strings.Get("RemTitle"), parameters);
    }

    // Whether the current user follows the selected document (ADR "Document subscriptions").
    private bool _detailSubscribed;

    private async Task ToggleSubscriptionAsync()
    {
        if (_selectedItem is not { } item)
        {
            return;
        }

        try
        {
            var target = _detailSubscribed;
            using var response = target
                ? await Http.DeleteAsync(DetailHref("subscription"))
                : await Http.PutAsync(DetailHref("subscription"), null);
            response.EnsureSuccessStatusCode();
            _detailSubscribed = !target;
            Snackbar.Add(_detailSubscribed ? "Following this document." : "Unfollowed.", Severity.Success);
        }
        catch (Exception)
        {
            Snackbar.Add(Strings.Get("StErrSubscription"), Severity.Error);
        }
    }

    private record SubscriptionResponse { public bool Subscribed { get; set; } }

    // Folder / subtree subscriptions (ADR "Folder / subtree subscriptions"): following a folder notifies of any
    // change within its subtree. State for the currently-selected folder (the chat-header bell).
    private bool _folderSubscribed;

    private async Task LoadFolderSubscriptionAsync(BrowseNode folder)
    {
        try
        {
            var sub = await Http.GetFromJsonAsync<SubscriptionResponse>(await FetchDocumentRelAsync(folder.Id, "subscription"));
            _folderSubscribed = sub?.Subscribed ?? false;
        }
        catch (Exception)
        {
            _folderSubscribed = false;
        }
    }

    private async Task ToggleFolderSubscriptionAsync()
    {
        if (_commentTarget is not { IsFolder: true } folder)
        {
            return;
        }

        try
        {
            var target = _folderSubscribed;
            var href = await FetchDocumentRelAsync(folder.Id, "subscription");
            using var response = target
                ? await Http.DeleteAsync(href)
                : await Http.PutAsync(href, null);
            response.EnsureSuccessStatusCode();
            _folderSubscribed = !target;
            Snackbar.Add(_folderSubscribed ? "Following this folder and everything in it." : "Unfollowed folder.", Severity.Success);
        }
        catch (Exception)
        {
            Snackbar.Add(Strings.Get("StErrSubscription"), Severity.Error);
        }
    }

    private DetailRetentionDto? _detailRetention;
    // Manage-access affordance (ADR "Manage-access UI for document/folder ACLs"): the caller's own
    // CanManagePermissions on the selected item gates the button; BreaksInheritance is shown in the dialog.
    private bool _detailCanManagePermissions;
    private bool _detailBreaksInheritance;
    // Sensitivity label (ADR "Data classification / sensitivity labels"): current value + the staged edit value.
    // The selected document's sensitivity (ADR "Configurable sensitivity labels + upload defaults") — the per-
    // tenant label id/name/colour + whether it watermarks; _edit* is the pending picker value.
    private Guid? _detailSensitivityId;
    private string _detailSensitivityName = "";
    private string? _detailSensitivityColor;
    private bool _detailSensitivityWatermark;
    private Guid? _editSensitivityId;
    private List<SensitivityLabel> _sensitivityLabels = [];
    private bool _canManageSensitivity;


    // The tenant's sensitivity labels for the picker + admin (loaded once, refreshable). Best-effort.
    // Delegates to the shared catalogue so the Users & groups tab reads the same list through the same loader
    // (ADR 0558) — the page keeps local copies only because its markup binds to them.
    private async Task LoadSensitivityLabelsAsync()
    {
        _sensitivityLabels = [.. await SensitivityLabels.GetAsync()];
        _canManageSensitivity = SensitivityLabels.CanManage;
    }

    // A repeating diagonal SVG-background watermark of "<LABEL> · <viewer>" (ADR "Document watermarking"),
    // shown over the preview when the label's watermark flag is set. Client-side only (a screenshot deterrent /
    // classification reminder — bypassable, server-stamped downloads deferred).
    private string WatermarkStyle()
    {
        var text = System.Net.WebUtility.HtmlEncode($"{_detailSensitivityName} · {_viewerName}");
        var svg = $"<svg xmlns='http://www.w3.org/2000/svg' width='360' height='200'><text x='10' y='150' fill='rgba(130,130,130,0.20)' font-size='20' font-family='sans-serif' transform='rotate(-28 10 150)'>{text}</text></svg>";
        return $"background-image:url(\"data:image/svg+xml,{Uri.EscapeDataString(svg)}\");";
    }
    private record DocumentDetailResponse { public List<LinkResponse> Links { get; set; } = []; public DetailRetentionDto? Retention { get; set; } public Guid? SensitivityLabelId { get; set; } public string SensitivityLabelName { get; set; } = ""; public string? SensitivityLabelColor { get; set; } public bool SensitivityWatermark { get; set; } public bool CanManagePermissions { get; set; } public bool BreaksInheritance { get; set; } public FolderContentsSortOrder ContentsSortOrder { get; set; } }
    private record DetailRetentionDto { public int RetentionYears { get; set; } public string DispositionDate { get; set; } = ""; public bool SuspendedByHold { get; set; } }

    // Derives the always-shown system fields from the confirmed versions (ADR 0273): the current version's
    // Created/Created-by/Document-date/File-extension, and the OCR override + TIFF-source from the latest TIFF.
    private void DeriveSystemFields(BrowseNode item, List<VersionResponse> confirmed, Guid? currentVersionId)
    {
        var current = VersionListResponse.PickCurrent(confirmed, currentVersionId);
        if (current is null)
        {
            return; // a folder or a document with no confirmed version yet
        }

        static bool IsTiff(string? key) => key is not null && (key.EndsWith(".tif", StringComparison.OrdinalIgnoreCase) || key.EndsWith(".tiff", StringComparison.OrdinalIgnoreCase));
        var tiff = confirmed.Where(v => IsTiff(v.ObjectKey)).OrderByDescending(v => v.VersionNumber ?? 0).FirstOrDefault();

        _sysHasVersion = true;
        _sysCurrentVersionId = current.Id;
        _sysCurrentVersion = current.VersionNumber;
        _detailVersionCount = confirmed.Count;
        _sysName = item.Name;
        _sysFileExtension = current.FileExtension ?? "";
        _sysDocumentDate = DateTime.TryParse(current.DocumentDate, out var d) ? d.Date : null;
        _sysCreated = current.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm");
        _sysCreatedBy = current.CreatedByName ?? "";
        _sysHasTiff = tiff is not null;
        _sysOcrCodes = string.IsNullOrWhiteSpace(tiff?.OcrLanguages) ? [] : tiff!.OcrLanguages!.Split('+', StringSplitOptions.RemoveEmptyEntries).ToList();
    }

    // ---- Single pane-level edit (ADR 0278): Name/date/OCR/mask/index-data all editable at once -----------

    // The SUBJECT is what gets edited — a selected row or the open folder — so a folder's metadata is editable
    // from wherever you reached it (issue #408).
    private bool CanEditDetail => _detailNode is not null && !_isEditing;

    // The edited contents order, staged like every other field so Cancel discards it.
    private FolderContentsSortOrder _editSortOrder = FolderContentsSortOrder.Name;

    private async Task BeginEditAsync()
    {
        if (_detailNode is null)
        {
            return;
        }

        // One pencil commits everything the pane shows, so a folder's contents order is staged alongside its mask
        // and index fields rather than hiding behind an Edit button of its own.
        _editSortOrder = _detailSortOrder;

        _detailBusy = true;
        try
        {
            // Snapshot originals for change detection + cancel.
            _editName = _origName = _sysName;
            _editDocumentDate = _origDocumentDate = _sysDocumentDate;
            _editOcrCodes = [.. _sysOcrCodes];
            _origOcrCodes = [.. _sysOcrCodes];
            _editMaskId = _origMaskId = _detailMaskId;
            _editSensitivityId = _detailSensitivityId;
            _editTags = [.. (_detailTags ?? [])];
            _origTags = [.. (_detailTags ?? [])];
            _newTag = null;
            if (_tagColors.Count == 0)
            {
                await LoadTagCatalogAsync(); // names for autocomplete + colours for the chips
            }

            _availableMasks = (await Http.GetFromJsonAsync<MaskListResponse>(await ApiRoot.RequireAsync("masks")))?.Masks ?? [];
            if (_sysHasTiff && _ocrCatalog.Count == 0)
            {
                _ocrCatalog = await OcrLanguages.GetAsync();
            }

            await LoadEditFieldsAsync(_editMaskId, useCurrentValues: true);
            _isEditing = true;
        }
        catch (HttpRequestException e)
        {
            Snackbar.Add(string.Format(Strings.Get("StErrStartEdit"), e.Message), Severity.Error);
        }
        finally
        {
            _detailBusy = false;
        }
    }

    // Compare two versions of the selected document as an inline text diff (ADR "Document version comparison").
    // Versions dialog (ADR "Versions dialog") — list versions with Open/Download/Make-current + a Compare
    // launcher. A make-current there returns true, so reselect the document to reflect the new current version.
    private async Task OpenVersionsAsync(BrowseNode item)
    {
        var parameters = new DialogParameters { ["DocumentId"] = item.Id, ["DocumentName"] = item.Name, ["VersionsHref"] = item.Links?.GetValueOrDefault("versions") };
        var dialog = await DialogService.ShowAsync<Dialogs.VersionsDialog>(Strings.Get("RibbonVersions"), parameters, new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        if ((await dialog.Result) is { Canceled: false, Data: true } && _selectedItem?.Id == item.Id)
        {
            await SelectItemAsync(item);
        }
    }

    private async Task OpenCompareVersionsAsync()
    {
        if (_selectedItem is not { } item)
        {
            return;
        }

        var parameters = new DialogParameters { ["DocumentId"] = item.Id, ["DocumentName"] = item.Name, ["VersionsHref"] = item.Links?.GetValueOrDefault("versions") };
        var dialog = await DialogService.ShowAsync<Dialogs.CompareVersionsDialog>(Strings.Get("CvTitle"), parameters, new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        // A restore (ADR "Version restore") closes the dialog with true — reselect the document so the detail
        // pane + preview reflect the new current version.
        if ((await dialog.Result) is { Canceled: false, Data: true })
        {
            await SelectItemAsync(item);
        }
    }

    private async Task LoadEditFieldsAsync(Guid? maskId, bool useCurrentValues)
    {
        _editFields.Clear();
        if (maskId is not { } id)
        {
            return;
        }

        var fields = await Http.GetFromJsonAsync<MaskFieldsResponse>($"api/masks/{id}");
        var valuesByName = useCurrentValues
            ? (_detailIndexData ?? []).ToDictionary(f => f.FieldName, f => f.Values)
            : new Dictionary<string, List<string>>();

        foreach (var f in fields?.Fields ?? [])
        {
            var values = valuesByName.TryGetValue(f.Name, out var v) ? v : [];
            _editFields.Add(EditField.Create(f, values));
        }
    }

    private async Task OnEditMaskChanged(Guid? maskId)
    {
        _editMaskId = maskId;
        await LoadEditFieldsAsync(maskId, useCurrentValues: false);
    }

