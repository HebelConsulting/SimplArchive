    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Import the JS modules up front (no DOM dependency). The DOM-dependent wiring below must NOT
            // live here: the workbench markup is inside <Authorized>, so on a page reload (auth resolving
            // asynchronously) the elements don't exist yet at firstRender — wiring them here would throw and
            // abort this block before the second import even ran.
            _selfRef = DotNetObjectReference.Create(this);
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./dropUpload.js");
            try
            {
                _layoutModule = await JS.InvokeAsync<IJSObjectReference>("import", "./wbLayout.js");
            }
            catch (JSException ex)
            {
                // A missing wbLayout.js must not crash the workbench — the panes just stay at their CSS defaults
                // (issue #267). Leaving _layoutModule null makes the interop below no-op.
                Console.Error.WriteLine($"wbLayout.js failed to load: {ex.Message}");
            }
        }

        // Wire the drop root and the resizable/collapsible panes on whichever render first has the real
        // elements. Both JS sides return false (no-op) until their root is a real element and true once
        // wired, so we simply retry until each succeeds; the flags reset on a tab switch (SetTab) so we
        // re-wire the freshly-recreated DOM when returning to the Repositories tab.
        if (_activeTab == Tab.Repositories)
        {
            if (!_dropRootWired && _module is not null)
            {
                _dropRootWired = await _module.InvokeAsync<bool>("initDropRoot", _dropRoot, _selfRef);
            }
            // Both wbLayout.js calls are wrapped so a stale cached copy missing an export (e.g. watchViewport,
            // added in ADR "responsive web workbench") degrades quietly to the CSS-default layout instead of
            // triggering the Blazor error UI, and stops retrying so it can't spam every render (issue #267).
            if (!_panesWired && _layoutModule is not null)
            {
                try
                {
                    _panesWired = await _layoutModule.InvokeAsync<bool>("attach", _layoutRoot);
                }
                catch (JSException ex)
                {
                    _panesWired = true; // give up rather than retry-spam a broken/stale module
                    Console.Error.WriteLine($"wbLayout.js attach failed (stale cache?): {ex.Message}");
                }
            }
            if (!_viewportWatched && _layoutModule is not null)
            {
                try
                {
                    await _layoutModule.InvokeVoidAsync("watchViewport", _selfRef);
                }
                catch (JSException ex)
                {
                    Console.Error.WriteLine($"wbLayout.js watchViewport failed (stale cache?): {ex.Message}");
                }
                finally
                {
                    _viewportWatched = true;
                }
            }
        }

        // Wire the inbox file-list drop-zone when the Inbox tab is shown (the DOM is recreated on each visit, so
        // re-wire after re-entry — the flag is reset in SetTab). ADR "Inbox file-list drop-zone".
        if (_activeTab == Tab.Inbox && !_inboxDropWired && _module is not null)
        {
            _inboxDropWired = await _module.InvokeAsync<bool>("initInboxDrop", _inboxDropZone, _selfRef);
        }
    }

    private async Task SetTab(Tab tab)
    {
        // Leaving Repositories tears down the workbench DOM; clear the wired flags so returning re-wires the
        // freshly-recreated drop root and panes.
        if (tab != Tab.Repositories)
        {
            _dropRootWired = false;
            _panesWired = false;
        }
        // Leaving the Inbox tears down its DOM too; re-wire the drop-zone on re-entry.
        if (tab != Tab.Inbox)
        {
            _inboxDropWired = false;
        }
        // The Repositories and Inbox preview panes share _pvHost/_pv* (mutually exclusive in the DOM); reset so a
        // stale kind from the previous tab doesn't render the fresh, empty host as if it had pages.
        ClearPreviewPane();
        _activeTab = tab;

        // Returning to Repositories: refresh the folder-contents list pane so newly-filed documents appear, and
        // — keeping focus on the selected document — re-render its detail so a version filed elsewhere (e.g.
        // from the Inbox) shows. See the "refresh list pane on return" requirement.
        if (tab == Tab.Repositories && _selectedFolder is { } folder)
        {
            _folderContents = await LoadContentsAsync(folder.Id, folder.RepositoryId, trackAsCurrentFolder: true);
            if (_selectedItem is { } sel && _folderContents.FirstOrDefault(n => n.Id == sel.Id) is { } fresh)
            {
                await SelectItemAsync(fresh);
            }
        }

        if (tab == Tab.Search && !_searchMetadataLoaded)
        {
            await LoadSearchMetadataAsync();
        }

        if (tab == Tab.Search)
        {
            await LoadSavedSearchesAsync();
        }

        if (tab == Tab.Inbox)
        {
            await LoadInboxAsync();
        }

        if (tab == Tab.Checkout)
        {
            await LoadCheckoutsAsync();
        }

        if (tab == Tab.Tenant)
        {
            await LoadTenantSettingsAsync();
        }

        if (tab == Tab.Tags)
        {
            await LoadTagCatalogAsync();
        }

        if (tab == Tab.Tasks)
        {
            await LoadTasksAsync();
        }

        if (tab == Tab.MyWork)
        {
            await LoadMyWorkAsync();
        }

        if (tab == Tab.UsersGroups)
        {
            await LoadPrincipalsAsync();
            // The clearance dropdown maps ranks to sensitivity-label names (ADR "Sensitivity clearance enforcement").
            await LoadSensitivityLabelsAsync();
        }

        if (tab == Tab.Audit)
        {
            await LoadRetentionAsync();
            if (_auditEvents.Count == 0)
            {
                await RunAuditSearchAsync();
            }
        }

        if (tab == Tab.LegalHolds)
        {
            await LoadLegalHoldsAsync();
        }

        if (tab == Tab.Retention)
        {
            await LoadRetentionScheduleAsync();
        }

        if (tab == Tab.RecycleBin)
        {
            ClearRbPreview();
            await LoadRecycleBinAsync();
        }
    }

    // ---- Recycle bin tab (ADR "Recycle bin tab") — tenant-wide list + isolated detail/preview/chat ----
    private readonly List<RecycleBinDto> _recycleBinItems = new();
    // Multi-select for bulk restore (ADR "Bulk restore from the recycle bin").
    private readonly HashSet<Guid> _rbChecked = new();
    private RecycleBinDto? _rbSelected;
    private string? _rbMaskName;
    private List<FieldGroup>? _rbIndexData;
    private List<CommentResponse> _rbComments = new();
    // A dedicated preview host + state, completely separate from the Repositories/Inbox _pv/_pvHost so the
    // recycle-bin preview is never entangled with the others.
    private readonly PreviewPaneState _rbPv = new();
    private ElementReference _rbPvHost;

    private async Task LoadRecycleBinAsync()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<RecycleBinResponse>("api/recycle-bin");
            _recycleBinItems.Clear();
            if (response?.Items is { } items)
            {
                _recycleBinItems.AddRange(items);
            }
            // Drop the selection if the selected item is gone.
            if (_rbSelected is { } sel && _recycleBinItems.All(i => i.Id != sel.Id))
            {
                _rbSelected = null;
                ClearRbPreview();
            }
            // Prune checked ids that are no longer present (restored/purged).
            _rbChecked.RemoveWhere(id => _recycleBinItems.All(i => i.Id != id));
        }
        catch (Exception)
        {
            Snackbar.Add("Could not load the recycle bin.", Severity.Error);
        }
        StateHasChanged();
    }

    private async Task SelectRecycleBinItemAsync(RecycleBinDto item)
    {
        _rbSelected = item;
        _rbMaskName = null;
        _rbIndexData = null;
        _rbComments = new();
        ClearRbPreview();
        StateHasChanged();

        try
        {
            _rbMaskName = (await Http.GetFromJsonAsync<MaskResponse>($"api/documents/{item.Id}/mask"))?.Name;
            _rbIndexData = (await Http.GetFromJsonAsync<IndexDataResponse>($"api/documents/{item.Id}/index-data"))?.Fields ?? [];
            _rbComments = (await Http.GetFromJsonAsync<CommentListResponse>($"api/documents/{item.Id}/comments"))?.Comments ?? new();

            var versions = await Http.GetFromJsonAsync<VersionListResponse>($"api/documents/{item.Id}/versions");
            var latest = PickCurrent(versions?.Versions?.Where(v => v.Status == "Confirmed").ToList() ?? [], versions?.CurrentVersionId);
            var previewUrl = latest is null ? null : RelativeToAbsolute(RelativeHref(latest.Links, "preview"));
            var textLayoutUrl = latest is null ? null : RelativeHref(latest.Links, "text-layout");
            _rbPv.Converted = latest?.PreviewConverted ?? false;
            await RenderRbPreviewAsync(previewUrl, textLayoutUrl);
        }
        catch (Exception)
        {
            // best-effort — a partial detail is fine
        }
        StateHasChanged();
    }

    // Renders into the recycle bin's OWN host (_rbPvHost) with its own state (_rbPv), sharing only the stateless
    // preview.js module. Only one tab is ever active, so the module's single active preview is this one.
    private async Task RenderRbPreviewAsync(string? previewUrl, string? textLayoutUrl)
    {
        _rbPv.Kind = "";
        _rbPv.Text = null;
        if (previewUrl is null)
        {
            _rbPv.Kind = "unsupported";
            return;
        }

        List<TextLayoutPage>? layout = null;
        if (textLayoutUrl is not null)
        {
            try
            {
                using var r = await Http.GetAsync(textLayoutUrl.TrimStart('/'));
                if (r.IsSuccessStatusCode && r.StatusCode != HttpStatusCode.NoContent)
                {
                    layout = (await r.Content.ReadFromJsonAsync<TextLayoutResponse>())?.Pages;
                }
            }
            catch (Exception) { }
        }

        _previewModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./preview.js");
        _pvSelfRef ??= DotNetObjectReference.Create(this);
        StateHasChanged();
        try
        {
            var result = await _previewModule.InvokeAsync<PvResult>("load", _rbPvHost, previewUrl, layout, _pvSelfRef);
            _rbPv.Kind = result.Kind;
            _rbPv.Text = result.Text;
        }
        catch (Exception)
        {
            _rbPv.Kind = "error";
        }
    }

    private void ClearRbPreview()
    {
        _rbPv.Clear();
    }

    private async Task RestoreRecycleBinItemAsync(RecycleBinDto item)
    {
        var response = await Http.PostAsync($"api/documents/{item.Id}/restore", null);
        if (response.IsSuccessStatusCode)
        {
            Snackbar.Add($"Restored '{item.Name}'.", Severity.Success);
            if (_rbSelected?.Id == item.Id) { _rbSelected = null; ClearRbPreview(); }
            await LoadRecycleBinAsync();
        }
        else
        {
            Snackbar.Add("Could not restore the item.", Severity.Warning);
        }
    }

    // ---- Bulk restore (ADR "Bulk restore from the recycle bin") ----
    private bool AllRbChecked => _recycleBinItems.Count > 0 && _rbChecked.Count == _recycleBinItems.Count;

