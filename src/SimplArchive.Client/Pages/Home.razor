                    </span>
                    <span class="wb-tab-label">@Strings.Get("TabCheckout")</span>
                </div>
                <div class="wb-tab @(_activeTab == Tab.Search ? "wb-tab-active" : "")" title="@Strings.Get("TabSearch")" aria-label="@Strings.Get("TabSearch")" @onclick="() => SetTab(Tab.Search)">
                    <span class="wb-tab-ico"><MudIcon Icon="@Icons.Material.Filled.Search" Size="Size.Small" /></span>
                    <span class="wb-tab-label">@Strings.Get("TabSearch")</span>
