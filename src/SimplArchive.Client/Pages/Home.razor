                                <span class="mud-text-secondary" style="font-size:.8em; margin-left:auto;">@string.Format(Strings.Get("AuditRetainedFrom"), rt.ChainStartSequence)@(rt.LastPurgedAt is { } lp ? string.Format(Strings.Get("AuditLastPurged"), lp.ToLocalTime().ToString("yyyy-MM-dd")) : "")</span>
