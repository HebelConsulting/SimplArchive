# The version of every third-party service image this project runs. THE SOURCE OF TRUTH.
#
# These images are named in four places — docker-compose.yaml, tools/kiosk/docker-compose.yml,
# charts/simplarchive/values.yaml, and the two E2E fixtures that stand the same services up with
# Testcontainers. Measured on 2026-09-15, all four disagreed: Postgres was 16.15-alpine / 16.14-alpine /
# 16-alpine / 16-alpine, and `apache/tika:latest-full` FLOATED in both fixtures — on the component that
# extracts the text search depends on. A floating tag in a fixture means the suite is not testing the version
# that ships, which is how a green build goes red on somebody else's release with no commit here.
#
# HOW EACH PLACE USES THIS FILE, and why they differ:
#
#   docker-compose.yaml       `${POSTGRES_TAG:-16.15-alpine}` — an inline default, so `docker compose up
#                             --build` still works with no flags, which the README documents and which must
#                             keep working. Compose only auto-reads `.env`, and `.env` is gitignored here
#                             because it is the local-override file (PROXY_HOST and friends) — so this file
#                             cannot be the one compose loads by itself.
#   the E2E fixtures          read this file at startup, so the suite runs exactly what ships.
#   charts/.../values.yaml    a literal. Helm charts are self-contained: values.yaml cannot include another
#                             file, and `-f extra.yaml` is an install-time override, not chart authoring.
#
# BECAUSE THREE OF THEM CARRY A COPY, the copies are checked rather than trusted: PinnedImageLockstepTests
# fails the build when any of them disagrees with this file or when any tag floats. So a bump is: edit this
# file, run the tests, and fix exactly what they name.
#
# The KIOSK lags on purpose — it is the outward-facing demo and moves at rollout (docs/deploy/release.md), so
# it is reported by scripts/check-pinned-images.sh rather than gated. Its drift is a decision, not a defect.

POSTGRES_TAG=16.15-alpine
OPENSEARCH_TAG=2.19.6
TIKA_TAG=3.3.1.0-full
GOTENBERG_TAG=8.37
VALKEY_TAG=8.1.10-alpine
MAILPIT_TAG=v1.31.1
PGADMIN_TAG=9.17
OPENBAO_TAG=2.6.2
# Caddy is BUILT here rather than pulled (docker/caddy-l4/Dockerfile) — the layer-4 app it needs for IMAP is a
# plugin and is not in the official image. The version is the base image both build stages use, so it is the
# one number to bump.
CADDY_VERSION=2.11.4
AWSCLI_TAG=2.36.45

# Pinned by DIGEST rather than tag: SeaweedFS publishes a moving `latest` and no stable per-release tag we can
# rely on, so the digest is the only exact pin available (ADR 0507).
SEAWEEDFS_DIGEST=sha256:c7d6c721b30ae711db766bbbfd40192776e263d4e51e22f57baef7bef93c12c6

# The base image modules-init runs in — see docker-compose.yaml. Pinned to a PATCH, not `3.22`, which
# floats within its minor.
ALPINE_TAG=3.22.5
